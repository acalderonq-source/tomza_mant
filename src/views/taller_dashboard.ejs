<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard Taller - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #eaf0f8;
      --card: #fff;
      --ink: #10213f;
      --muted: #5d6b85;
      --line: #cbd7ea;
      --dark: #061638;
      --blue: #07358f;
      --blue-2: #0b4fb8;
      --green: #16a34a;
      --red: #e2232a;
      --amber: #ffd400;
    }
    body {
      background:
        radial-gradient(circle at top left, rgba(255, 212, 0, .18), transparent 28rem),
        linear-gradient(135deg, #eef4fb 0%, #dce7f6 100%);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .95rem;
      overflow: auto;
    }
    .topbar {
      background: linear-gradient(120deg, #061638 0%, #07358f 58%, #e2232a 59%, #ffd400 68%, #374151 68%);
      border-bottom: 3px solid #ffd400;
      box-shadow: 0 8px 18px rgba(6, 22, 56, .14);
      min-height: 44px;
    }
    .brand-logo {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 10px 20px rgba(0,0,0,.16);
      height: 30px;
      object-fit: contain;
      padding: .25rem .45rem;
      width: 102px;
    }
    .tv-title {
      color: #fff;
      font-size: clamp(.95rem, 1.7vw, 1.45rem);
      font-weight: 950;
      letter-spacing: .04em;
      line-height: 1;
      text-transform: uppercase;
    }
    .clock-box {
      color: #fff;
      font-size: .68rem;
      font-weight: 800;
      min-width: 125px;
      text-align: right;
    }
    .clock-time {
      font-size: .9rem;
      font-weight: 950;
      line-height: 1.05;
    }
    .shell { max-width: 1780px; }
    .hero, .panel, .kpi-card, .unit-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: 0 14px 28px rgba(16, 33, 63, .08);
    }
    .hero { display: none; padding: .35rem .5rem; }
    .page-title { font-size: 1rem; font-weight: 900; margin: 0; }
    .muted { color: var(--muted); }
    .kpi-grid { display: grid; gap: .45rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .kpi-card {
      align-items: center;
      display: flex;
      gap: .55rem;
      min-height: 50px;
      padding: .42rem .55rem;
    }
    .kpi-icon {
      align-items: center;
      background: linear-gradient(145deg, #07358f, #0b4fb8);
      border-radius: 50%;
      color: #fff;
      display: inline-flex;
      flex: 0 0 34px;
      font-size: 1rem;
      height: 34px;
      justify-content: center;
      width: 34px;
    }
    .kpi-card.danger .kpi-icon { background: linear-gradient(145deg, #991b1b, #e2232a); }
    .kpi-card.ok .kpi-icon { background: linear-gradient(145deg, #166534, #16a34a); }
    .kpi-card.warn .kpi-icon { background: linear-gradient(145deg, #92400e, #ffd400); color: #10213f; }
    .kpi-label { color: var(--ink); font-size: .72rem; font-weight: 850; }
    .kpi-value { color: #07183d; font-size: 1.28rem; font-weight: 950; line-height: 1; }
    .section-title { font-size: .85rem; font-weight: 900; margin: 0; }
    .latest-strip { display: grid; gap: .7rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .latest-card {
      background: #fff;
      border: 1px solid var(--line);
      border-left: 5px solid var(--blue);
      border-radius: 10px;
      padding: .85rem;
    }
    .latest-plate { font-size: 1.05rem; font-weight: 950; }
    .latest-work {
      display: -webkit-box;
      font-weight: 750;
      line-height: 1.25;
      margin-top: .35rem;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
    .latest-pending {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 8px;
      color: #9a3412;
      font-size: .82rem;
      font-weight: 750;
      margin-top: .55rem;
      padding: .45rem;
    }
    .dashboard-layout { display: grid; gap: .75rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .left-stack { display: grid; gap: .45rem; }
    .right-stack { display: grid; gap: .75rem; }
    .board-grid { display: grid; gap: .5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .unit-card { border-left: 4px solid var(--green); overflow: hidden; }
    .unit-card.in-shop { border-left-color: var(--red); }
    .unit-head { align-items: flex-start; display: flex; justify-content: space-between; gap: .45rem; padding: .5rem .6rem .25rem; }
    .plate { font-size: .98rem; font-weight: 950; letter-spacing: .02em; }
    .badge-soft { border-radius: 999px; font-size: .58rem; font-weight: 850; padding: .22rem .38rem; white-space: nowrap; }
    .badge-shop { background: #fee2e2; color: #991b1b; }
    .badge-ready { background: #dcfce7; color: #166534; }
    .unit-body { display: grid; gap: .35rem; padding: 0 .6rem .6rem; }
    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 7px; padding: .42rem; }
    .info-label { color: var(--muted); font-size: .58rem; font-weight: 850; text-transform: uppercase; }
    .info-value { font-size: .78rem; font-weight: 750; line-height: 1.2; margin-top: .08rem; max-height: 2.4em; overflow: hidden; white-space: pre-wrap; }
    .actions { background: #f8fafc; border-top: 1px solid #e2e8f0; padding: .5rem .6rem; }
    .actions .btn,
    .actions .form-control {
      font-size: .76rem;
      min-height: 32px;
      padding: .25rem .45rem;
    }
    .filter-label { color: #475569; font-size: .64rem; font-weight: 850; text-transform: uppercase; }
    .empty-state { color: var(--muted); font-weight: 800; padding: .85rem; text-align: center; }
    .tv-panel-title {
      background: linear-gradient(90deg, #07358f, #061638);
      border-radius: 8px 8px 0 0;
      color: #fff;
      font-size: 1.15rem;
      font-weight: 950;
      padding: .7rem .85rem;
    }
    .tv-table { margin: 0; }
    .tv-table thead th {
      background: #08275e;
      color: #fff;
      font-size: .85rem;
      font-weight: 900;
      text-transform: uppercase;
    }
    .tv-table td {
      color: #172b4d;
      font-size: 1rem;
      line-height: 1.25;
      padding: .58rem .65rem;
      vertical-align: middle;
    }
    .status-dot {
      background: #22c55e;
      border-radius: 50%;
      display: inline-block;
      height: 8px;
      margin-right: .45rem;
      width: 8px;
    }
    .status-dot.warn { background: #f59e0b; }
    .work-cell { max-width: 420px; white-space: normal; }
    .work-list {
      display: grid;
      gap: .35rem;
    }
    .work-line {
      align-items: flex-start;
      display: flex;
      gap: .45rem;
      line-height: 1.15;
    }
    .work-type {
      border-radius: 999px;
      flex: 0 0 auto;
      font-size: .72rem;
      font-weight: 950;
      padding: .22rem .42rem;
      text-transform: uppercase;
    }
    .work-type.correctivo { background: #fee2e2; color: #991b1b; }
    .work-type.preventivo { background: #dbeafe; color: #1e3a8a; }
    .priority-panel {
      border-top: 5px solid var(--red);
    }
    .priority-title {
      background: linear-gradient(90deg, #e2232a, #991b1b);
    }
    .priority-form {
      background: #fff8e1;
      border-bottom: 1px solid #facc15;
      padding: .55rem .65rem;
    }
    .priority-note {
      color: #991b1b;
      font-size: 1.08rem;
      line-height: 1.25;
      font-weight: 900;
      max-width: none;
      overflow-wrap: anywhere;
      white-space: normal;
    }
    .priority-badge {
      background: #fee2e2;
      border-radius: 999px;
      color: #991b1b;
      display: inline-block;
      font-size: .78rem;
      font-weight: 900;
      padding: .2rem .38rem;
      text-transform: uppercase;
    }
    .priority-panel .tv-panel-title {
      font-size: 1.25rem;
      padding: .72rem .85rem;
    }
    .priority-panel .tv-table thead th {
      font-size: .85rem;
    }
    .priority-panel .tv-table td {
      font-size: 1rem;
      padding: .58rem .65rem;
      white-space: normal;
    }
    .priority-plate {
      font-size: 1.18rem;
      font-weight: 950;
      overflow-wrap: normal;
      white-space: nowrap;
      word-break: keep-all;
    }
    .priority-table {
      table-layout: fixed;
      width: 100%;
    }
    .priority-table th:nth-child(1),
    .priority-table td:nth-child(1) {
      width: 26%;
    }
    .priority-table th:nth-child(2),
    .priority-table td:nth-child(2) {
      width: 45%;
    }
    .priority-table th:nth-child(3),
    .priority-table td:nth-child(3) {
      width: 20%;
    }
    .priority-table th:nth-child(4),
    .priority-table td:nth-child(4) {
      text-align: center;
      width: 9%;
    }
    .priority-meta {
      overflow-wrap: anywhere;
      white-space: normal;
    }
    .priority-groups {
      display: grid;
      gap: .55rem;
    }
    .priority-group-title {
      align-items: center;
      background: #fff7ed;
      border-bottom: 1px solid #fed7aa;
      color: #7c2d12;
      display: flex;
      font-size: .9rem;
      font-weight: 950;
      justify-content: space-between;
      padding: .45rem .65rem;
      text-transform: uppercase;
    }
    .priority-group {
      border-top: 1px solid #fed7aa;
    }
    .priority-card-grid {
      display: grid;
      gap: .35rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: .45rem;
    }
    .priority-card {
      align-items: stretch;
      background: #fff;
      border: 1px solid #dbe3ef;
      border-left: 4px solid #e2232a;
      border-radius: 8px;
      display: grid;
      gap: .4rem;
      grid-template-columns: minmax(95px, 28%) minmax(0, 1fr) auto;
      min-height: 48px;
      padding: .42rem .5rem;
    }
    .priority-card .priority-plate {
      display: block;
      font-size: 1.02rem;
      line-height: 1.05;
    }
    .priority-card .priority-note {
      color: #07183d;
      font-size: .9rem;
      line-height: 1.12;
    }
    .priority-card .priority-meta {
      font-size: .7rem;
      line-height: 1.1;
    }
    .priority-card .btn {
      min-width: 30px;
    }
    .priority-modal .modal-content {
      border: 0;
      border-radius: 14px;
      overflow: hidden;
    }
    .priority-modal .modal-header {
      background: linear-gradient(90deg, #e2232a, #991b1b);
      color: #fff;
    }
    .priority-modal .btn-close {
      filter: invert(1);
      opacity: .95;
    }
    .compact-panel-body { max-height: calc(100vh - 185px); overflow: auto; }
    .priority-panel .compact-panel-body {
      overflow-x: hidden;
      overflow-y: auto;
    }
    .parts-panel .tv-panel-title {
      background: linear-gradient(90deg, #0f6684, #07358f);
      font-size: 1.25rem;
      padding: .72rem .85rem;
    }
    .parts-panel .compact-panel-body { max-height: calc(100vh - 185px); }
    .parts-panel .compact-panel-body {
      overflow-x: hidden;
      overflow-y: auto;
    }
    .parts-table {
      table-layout: fixed;
      width: 100%;
    }
    .parts-table th:nth-child(1),
    .parts-table td:nth-child(1) {
      width: 25%;
    }
    .parts-table th:nth-child(2),
    .parts-table td:nth-child(2) {
      width: 55%;
    }
    .parts-table th:nth-child(3),
    .parts-table td:nth-child(3) {
      width: 20%;
    }
    .parts-table td,
    .parts-table thead th {
      font-size: 1rem;
      padding: .58rem .65rem;
      white-space: normal;
    }
    .parts-plate {
      color: #07183d;
      font-size: 1.18rem;
      font-weight: 950;
      white-space: nowrap;
    }
    .parts-text {
      display: block;
      font-weight: 850;
      overflow: visible;
      overflow-wrap: anywhere;
      white-space: normal;
    }
    .parts-status {
      border-radius: 999px;
      display: inline-block;
      font-size: .68rem;
      font-weight: 950;
      padding: .2rem .42rem;
      white-space: nowrap;
    }
    .parts-status.pendiente_comprar { background: #e5e7eb; color: #111827; }
    .parts-status.pedido { background: #ccfbf1; color: #115e59; }
    .parts-status.en_transito { background: #fef08a; color: #854d0e; }
    .parts-priority {
      border-radius: 999px;
      display: inline-block;
      font-size: .62rem;
      font-weight: 950;
      margin-top: .2rem;
      padding: .14rem .35rem;
      text-transform: uppercase;
    }
    .parts-priority.alta { background: #fee2e2; color: #991b1b; }
    .parts-priority.media { background: #fef9c3; color: #854d0e; }
    .parts-priority.baja { background: #dcfce7; color: #166534; }
    @media (max-width: 1180px) {
      .kpi-grid,
      .board-grid,
      .dashboard-layout { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .latest-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .priority-card-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 720px) {
      .kpi-grid, .board-grid, .latest-strip, .dashboard-layout { grid-template-columns: 1fr; }
      .topbar { background: linear-gradient(135deg, #061638, #07358f); }
      .topbar .btn { width: 100%; }
      .brand-logo { width: 145px; }
      .clock-box { min-width: 0; text-align: left; }
      .clock-time { font-size: 1.45rem; }
      .unit-head { align-items: stretch; flex-direction: column; }
      .actions .d-flex { align-items: stretch !important; flex-direction: column; }
      .actions .btn, .actions input { width: 100%; }
    }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(unidades) ? unidades : [];
  const ultimos = Array.isArray(ultimosCorrectivos) ? ultimosCorrectivos : [];
  const puedeAccionar = Boolean(puedeGestionar);
  const puedeEditarPrioridades = Boolean(puedeGestionarPrioridades);
  const prioridadesLista = Array.isArray(prioridades) ? prioridades : [];
  const usuarioDashboard = String(user.usuario || '').trim().toLowerCase();
  const rolDashboard = String(user.rol || '').trim().toUpperCase();
  const esPantallaPesados = usuarioDashboard.includes('pesado') || rolDashboard === 'SUPERVISOR_PESADO';
  const esPantallaMecanico = !esPantallaPesados && (usuarioDashboard === 'mecanico' || rolDashboard === 'MECANICO');
  const prioridadesPesadosBase = Array.isArray(prioridadesPesados) ? prioridadesPesados : [];
  const prioridadesMecanicoBase = Array.isArray(prioridadesMecanico) ? prioridadesMecanico : [];
  const prioridadesPesadosLista = esPantallaPesados && !prioridadesPesadosBase.length
    ? prioridadesLista
    : prioridadesPesadosBase;
  const prioridadesMecanicoLista = esPantallaMecanico && !prioridadesMecanicoBase.length
    ? prioridadesLista
    : prioridadesMecanicoBase;
  const mostrarPrioridadesPesados = esPantallaPesados || (!esPantallaPesados && !esPantallaMecanico);
  const mostrarPrioridadesMecanico = esPantallaMecanico || (!esPantallaPesados && !esPantallaMecanico);
  const prioridadesVisiblesLista = [
    ...(mostrarPrioridadesPesados ? prioridadesPesadosLista : []),
    ...(mostrarPrioridadesMecanico ? prioridadesMecanicoLista : [])
  ];
  const repuestosLista = Array.isArray(solicitudesRepuestos) ? solicitudesRepuestos : [];
  const fechaPrioridadModal = typeof fechaPrioridadDefault !== 'undefined' && fechaPrioridadDefault ? fechaPrioridadDefault : '';
  const fechaPrioridadActual = typeof fechaPrioridadHoy !== 'undefined' && fechaPrioridadHoy ? fechaPrioridadHoy : '';
  const preventivosAbiertos = lista.filter(u => u.preventivo_plan).length;
  const fechaCorta = value => {
    if (!value) return '—';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('es-CR');
  };
  const fechaHora = value => {
    if (!value) return '—';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString('es-CR');
  };
%>

<nav class="navbar navbar-dark topbar px-2 py-1">
  <div class="container-fluid shell d-flex align-items-center justify-content-between gap-3 flex-wrap">
    <img src="/img/logo_tomza.jpg" alt="Gas Tomza" class="brand-logo">
    <div class="tv-title text-center flex-grow-1">Control de Taller</div>
    <div class="clock-box">
      <div><i class="bi bi-clock me-1"></i><span id="fechaActual">--/--/----</span></div>
      <div id="horaActual" class="clock-time">--:--</div>
    </div>
  </div>
</nav>

<main class="container-fluid shell py-1">
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <section class="hero mb-1">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Panel operativo</h1>
        <div class="muted">Sede: <strong><%= sedeSeleccionada %></strong> · Se actualiza automáticamente cada 45 segundos · <%= user.usuario %> (<%= user.rol %>)</div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if (puedeAccionar) { %>
          <a href="/mantenimientos/correctivos/nuevo" class="btn btn-danger btn-sm"><i class="bi bi-plus-circle"></i> Registrar trabajo</a>
        <% } %>
        <a href="/unidades?varado=1" class="btn btn-outline-dark btn-sm"><i class="bi bi-truck-front"></i> Ver unidades</a>
        <a href="/dashboard" class="btn btn-outline-primary btn-sm"><i class="bi bi-house"></i> Inicio</a>
      </div>
    </div>
  </section>

  <section class="kpi-grid mb-2">
    <div class="kpi-card">
      <span class="kpi-icon"><i class="bi bi-tools"></i></span>
      <div>
        <div class="kpi-label">Repuestos</div>
        <div class="kpi-value"><%= repuestosLista.length %></div>
      </div>
    </div>
    <div class="kpi-card danger">
      <span class="kpi-icon"><i class="bi bi-gear"></i></span>
      <div>
        <div class="kpi-label">En proceso</div>
        <div class="kpi-value"><%= resumen.enTaller %></div>
      </div>
    </div>
    <div class="kpi-card ok">
      <span class="kpi-icon"><i class="bi bi-car-front"></i></span>
      <div>
        <div class="kpi-label">Listas</div>
        <div class="kpi-value"><%= resumen.disponibles %></div>
      </div>
    </div>
    <div class="kpi-card warn">
      <span class="kpi-icon"><i class="bi bi-clipboard2-pulse"></i></span>
      <div>
        <div class="kpi-label">Preventivos</div>
        <div class="kpi-value"><%= preventivosAbiertos %></div>
      </div>
    </div>
  </section>

  <section class="dashboard-layout">
      <section class="panel priority-panel">
        <div class="tv-panel-title priority-title d-flex justify-content-between align-items-center gap-2 flex-wrap">
          <span><i class="bi bi-exclamation-octagon me-1"></i> Prioridades</span>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge text-bg-light text-dark"><%= fechaPrioridadActual || 'Hoy' %> · <%= prioridadesVisiblesLista.length %></span>
            <% if (puedeEditarPrioridades) { %>
              <button type="button" class="btn btn-sm btn-light fw-bold py-0" data-bs-toggle="modal" data-bs-target="#agregarPrioridadModal">
                <i class="bi bi-plus-circle"></i> Agregar
              </button>
            <% } %>
          </div>
        </div>

        <% if (!prioridadesVisiblesLista.length) { %>
          <div class="empty-state">No hay prioridades pendientes.</div>
        <% } else { %>
          <div class="compact-panel-body priority-groups">
            <% if (mostrarPrioridadesPesados) { %>
              <div class="priority-group">
                <div class="priority-group-title">
                  <span>Pesados · Granel + Transportadora</span>
                  <span><%= prioridadesPesadosLista.length %></span>
                </div>
                <% if (!prioridadesPesadosLista.length) { %>
                  <div class="empty-state py-2">Sin prioridades de pesados.</div>
                <% } else { %>
                  <div class="priority-card-grid">
                    <% prioridadesPesadosLista.forEach(p => { %>
                      <article class="priority-card">
                        <div>
                          <span class="priority-plate"><%= p.placa %></span>
                          <div class="muted priority-meta"><%= p.sede || 'Sin sede' %></div>
                        </div>
                        <div>
                          <div class="priority-note"><%= p.observacion %></div>
                          <div class="muted priority-meta"><%= p.creado_por_nombre || 'Taller' %> · <%= fechaCorta(p.creado_en) %></div>
                        </div>
                        <% if (puedeEditarPrioridades) { %>
                          <form method="POST" action="/taller/prioridades/<%= p.id %>/atendida">
                            <button class="btn btn-sm btn-success py-0 px-2" onclick="return confirm('¿Marcar esta prioridad como atendida?')">
                              <i class="bi bi-check"></i>
                            </button>
                          </form>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% } %>

            <% if (mostrarPrioridadesMecanico) { %>
              <div class="priority-group">
                <div class="priority-group-title">
                  <span>Mecánico / Taller</span>
                  <span><%= prioridadesMecanicoLista.length %></span>
                </div>
                <% if (!prioridadesMecanicoLista.length) { %>
                  <div class="empty-state py-2">Sin prioridades de mecánico.</div>
                <% } else { %>
                  <div class="priority-card-grid">
                    <% prioridadesMecanicoLista.forEach(p => { %>
                      <article class="priority-card">
                        <div>
                          <span class="priority-plate"><%= p.placa %></span>
                          <div class="muted priority-meta"><%= p.sede || 'Sin sede' %></div>
                        </div>
                        <div>
                          <div class="priority-note"><%= p.observacion %></div>
                          <div class="muted priority-meta"><%= p.creado_por_nombre || 'Taller' %> · <%= fechaCorta(p.creado_en) %></div>
                        </div>
                        <% if (puedeEditarPrioridades) { %>
                          <form method="POST" action="/taller/prioridades/<%= p.id %>/atendida">
                            <button class="btn btn-sm btn-success py-0 px-2" onclick="return confirm('¿Marcar esta prioridad como atendida?')">
                              <i class="bi bi-check"></i>
                            </button>
                          </form>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>

      <section class="panel parts-panel">
        <div class="tv-panel-title d-flex justify-content-between align-items-center gap-2 flex-wrap">
          <span><i class="bi bi-box-seam me-1"></i> Repuestos solicitados</span>
          <a href="/repuestos" class="btn btn-sm btn-light py-0">Abrir</a>
        </div>
        <% if (!repuestosLista.length) { %>
          <div class="empty-state">No hay repuestos pendientes.</div>
        <% } else { %>
          <div class="table-responsive compact-panel-body">
            <table class="table table-bordered tv-table parts-table">
              <thead>
                <tr>
                  <th>Placa</th>
                  <th>Repuesto</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% repuestosLista.forEach(r => { %>
                  <tr>
                    <td>
                      <span class="parts-plate"><%= r.placa %></span>
                      <div class="muted small"><%= r.sede || '-' %></div>
                    </td>
                    <td class="work-cell">
                      <div class="parts-text"><%= r.repuesto_solicitado %></div>
                      <div class="muted small">Cant. <%= Number(r.cantidad || 0).toLocaleString('es-CR') %> · <%= r.proveedor || 'Sin proveedor' %></div>
                    </td>
                    <td>
                      <span class="parts-status <%= String(r.estado || '').toLowerCase() %>"><%= etiquetaEstadoRepuesto(r.estado) %></span>
                      <div><span class="parts-priority <%= String(r.prioridad || '').toLowerCase() %>"><%= r.prioridad || 'MEDIA' %></span></div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
  </section>
</main>

<% if (puedeEditarPrioridades) { %>
  <div class="modal fade priority-modal" id="agregarPrioridadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" action="/taller/prioridades">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold mb-0"><i class="bi bi-exclamation-octagon me-1"></i> Agregar prioridad</h5>
              <div class="small opacity-75">Seleccione la fecha para que aparezca en pantalla.</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-bold">Fecha de prioridad</label>
              <input type="date" name="fecha_prioridad" class="form-control" value="<%= fechaPrioridadModal %>" required>
              <div class="form-text">Por defecto queda para mañana, útil cuando se cargan prioridades en la noche.</div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Placa</label>
              <input type="text" name="placa" class="form-control text-uppercase" placeholder="C173368" required>
            </div>
            <div>
              <label class="form-label fw-bold">Observación</label>
              <textarea name="observacion" class="form-control" rows="3" placeholder="Prioridad para el día programado" required></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-danger"><i class="bi bi-save"></i> Guardar prioridad</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<script>
  function actualizarRelojTaller() {
    const ahora = new Date();
    const fecha = new Intl.DateTimeFormat('es-CR', {
      timeZone: 'America/Costa_Rica',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    }).format(ahora);
    const hora = new Intl.DateTimeFormat('es-CR', {
      timeZone: 'America/Costa_Rica',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true
    }).format(ahora);

    const fechaEl = document.getElementById('fechaActual');
    const horaEl = document.getElementById('horaActual');
    if (fechaEl) fechaEl.textContent = fecha;
    if (horaEl) horaEl.textContent = hora;
  }

  actualizarRelojTaller();
  setInterval(actualizarRelojTaller, 1000);

  setTimeout(() => {
    if (!document.hidden) window.location.reload();
  }, 45000);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
