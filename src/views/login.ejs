<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ingreso | Tomza Taller</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>

<main class="login-shell">
  <section class="brand-panel">
    <div class="brand-mark">
      <img src="/img/logo_tomza.jpg" alt="Gas Tomza">
      <div>
        <div class="brand-kicker">Sistema interno</div>
        <div class="brand-name">Tomza Taller</div>
      </div>
    </div>

    <h1 class="hero-title">Control del taller, agenda y compras.</h1>
    <p class="hero-copy">
      Ingresá para revisar mantenimientos, unidades, agenda, trámites, compras y reportes operativos.
    </p>

    <div class="feature-row">
      <span class="feature-pill">Mantenimientos</span>
      <span class="feature-pill">Agenda</span>
      <span class="feature-pill">Compras</span>
      <span class="feature-pill">Reportes</span>
    </div>
  </section>

  <section class="login-card">
    <div class="login-card-header">
      <h2 class="login-title">Ingreso al sistema</h2>
      <p class="login-subtitle">Usá tus credenciales asignadas.</p>
    </div>

    <div class="login-card-body">
      <% if (error) { %>
        <div class="alert alert-danger rounded-4"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="d-grid gap-3">
        <div>
          <label class="form-label">Usuario</label>
          <input class="form-control" name="usuario" placeholder="Ingrese su usuario" autocomplete="username" required>
        </div>
        <div>
          <label class="form-label">Contraseña</label>
          <input class="form-control" type="password" name="password" placeholder="Ingrese su contraseña" autocomplete="current-password" required>
        </div>
        <button class="btn btn-login">Entrar</button>
      </form>
    </div>

    <div class="login-footer">
      Aplicación instalable para uso interno de Gas Tomza.
    </div>
  </section>
</main>

<script>
  if (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) {
    document.body.classList.add("standalone-app");
  }
</script>

</body>
</html>
