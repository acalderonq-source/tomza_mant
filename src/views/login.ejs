<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ingreso | Sistema Empresarial Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
<header class="login-topbar"><a href="/" class="login-wordmark">Gas Tomza <span>Sistema empresarial</span></a><a href="/portal-proveedores/login">Portal de proveedores <span aria-hidden="true">↗</span></a></header>

<main class="login-shell">
  <section class="brand-panel">
    <div class="brand-mark">
      <img src="/img/logo_tomza.jpg" alt="Gas Tomza">
      <div>
        <div class="brand-kicker">Sistema interno</div>
        <div class="brand-name">Sistema Empresarial</div>
      </div>
    </div>

    <h1 class="hero-title">Tu equipo.<br>Tus procesos.<br><span>Todo conectado.</span></h1>
    <p class="hero-copy">
      Ingresá al área asignada para consultar las herramientas y procesos de tu departamento.
    </p>

    <div class="feature-row">
      <span class="feature-pill">Acceso interno</span>
      <span class="feature-pill">Herramientas de tu departamento</span>
      <span class="feature-pill">Gas Tomza</span>
    </div>
  </section>

  <section class="login-card">
    <div class="login-card-header">
      <div class="access-label">ACCESO INTERNO</div><h2 class="login-title">Bienvenido de nuevo</h2>
      <p class="login-subtitle">Ingresá para acceder a tus departamentos autorizados.</p>
    </div>

    <div class="login-card-body">
      <% if (error) { %>
        <div class="alert alert-danger rounded-4" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="d-grid gap-3">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
        <div>
          <label class="form-label" for="login-identidad"><%= departamento==='ADMINISTRACION'?'Usuario':'Cédula o usuario' %></label>
          <input class="form-control" id="login-identidad" name="cedula" placeholder="<%= departamento==='ADMINISTRACION'?'Ingrese su usuario':'Ingrese su cédula o usuario' %>" autocomplete="username" required>
        </div>
        <div>
          <label class="form-label" for="login-clave"><%= departamento==='ADMINISTRACION'?'Contraseña':'PIN o contraseña' %></label>
          <div class="password-field"><input class="form-control" id="login-clave" type="password" name="pin" placeholder="Ingrese su clave de acceso" autocomplete="current-password" required><button type="button" data-toggle-password="login-clave" aria-label="Mostrar contraseña" aria-pressed="false">Mostrar</button></div>
        </div>
        <button class="btn btn-login">Ingresar al sistema <span aria-hidden="true">→</span></button>
      </form>
      <p class="mt-3"><a href="/solicitar-ingreso">Soy trabajador y necesito solicitar ingreso</a></p>
      <% if (!departamento || departamento === 'TALLER') { %>
        <details class="screen-access"><summary>Acceso para pantallas de taller</summary><div class="my-4 d-flex align-items-center gap-3 text-secondary" aria-hidden="true">
          <hr class="flex-grow-1 my-0"><span class="small">o</span><hr class="flex-grow-1 my-0">
        </div>
        <form method="POST" action="/login" class="d-grid gap-3">
          <input type="hidden" name="departamento" value="TALLER">
          <div>
            <label class="form-label" for="pantalla-usuario">Acceso de pantalla</label>
            <select class="form-select" id="pantalla-usuario" name="usuario" required>
              <option value="pantalla_mecanicos">Pantalla de Mecánicos</option>
              <option value="pantalla_pesados">Pantalla de Pesados</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="pantalla-clave">Clave de pantalla</label>
            <input class="form-control" id="pantalla-clave" type="password" name="password" placeholder="Ingrese la clave numérica" inputmode="numeric" pattern="[0-9]*" autocomplete="current-password" required>
          </div>
          <button class="btn btn-outline-primary" type="submit">Ingresar a la pantalla</button>
        </form>
      </details><% } %>
      <% if (typeof perfiles !== 'undefined' && perfiles.length) { %>
        <div class="mt-4">
          <p class="mb-2">La cédula tiene acceso a más de un perfil. Seleccione dónde desea ingresar:</p>
          <% perfiles.forEach(perfil => { %>
            <form method="POST" action="/login/perfil" class="mb-2">
              <input type="hidden" name="usuarioId" value="<%= perfil.id %>">
              <button class="btn btn-outline-primary w-100" type="submit"><%= perfil.nombre %></button>
            </form>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="login-footer">
      ¿Necesitás ayuda para ingresar? Contactá a Administración.
    </div>
  </section>
</main>

<script>
  if (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) {
    document.body.classList.add("standalone-app");
  }
</script>

<script src="/js/login.js" defer></script>
</body>
</html>
