<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Resumen Ejecutivo - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --navy: #071a44;
      --blue: #0b3b82;
      --red: #ef233c;
      --gold: #f8b400;
      --ink: #0f172a;
      --muted: #64748b;
      --line: #dbe4f0;
      --soft: #f6f8fc;
      --card: #ffffff;
    }

    body {
      background:
        radial-gradient(circle at top left, rgba(11, 59, 130, .12), transparent 32rem),
        linear-gradient(135deg, #f7f9fd 0%, #eef3f9 100%);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .topbar {
      background: linear-gradient(90deg, var(--navy), var(--blue) 72%, #111827);
      border-bottom: 3px solid var(--gold);
      box-shadow: 0 8px 24px rgba(7, 26, 68, .2);
    }

    .shell { max-width: 1580px; }

    .hero {
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(112deg, transparent 0 68%, rgba(248,180,0,.86) 68% 76%, transparent 76%),
        linear-gradient(135deg, var(--navy), var(--blue) 62%, var(--red));
      border-radius: 22px;
      padding: 1.35rem 1.5rem;
      box-shadow: 0 18px 42px rgba(7, 26, 68, .2);
    }

    .eyebrow {
      color: rgba(255,255,255,.82);
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .page-title {
      font-size: clamp(1.45rem, 2.4vw, 2.25rem);
      font-weight: 950;
      line-height: 1.05;
      margin: .35rem 0 .25rem;
      text-transform: uppercase;
    }

    .hero-subtitle {
      color: rgba(255,255,255,.78);
      font-weight: 650;
      margin: 0;
    }

    .panel,
    .metric-card,
    .chart-card,
    .table-card,
    .conclusion-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, .065);
    }

    .panel { padding: 1rem; }

    .panel label {
      color: #475569;
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    .panel .form-control,
    .panel .form-select {
      border-color: #cfd9e8;
      border-radius: 12px;
      min-height: 38px;
    }

    .metric-card {
      position: relative;
      overflow: hidden;
      min-height: 108px;
      padding: 1rem;
    }

    .metric-card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: var(--accent, var(--blue));
    }

    .metric-label {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 950;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .metric-value {
      color: #10213f;
      font-size: 1.65rem;
      font-weight: 950;
      line-height: 1.1;
      margin-top: .3rem;
    }

    .metric-foot {
      color: var(--muted);
      font-size: .78rem;
      font-weight: 750;
      margin-top: .25rem;
    }

    .section-label {
      align-items: center;
      color: #172554;
      display: flex;
      font-size: .78rem;
      font-weight: 950;
      gap: .5rem;
      letter-spacing: .06em;
      margin: 1.15rem 0 .65rem;
      text-transform: uppercase;
    }

    .section-label::after {
      background: #dbe4f0;
      content: "";
      flex: 1;
      height: 1px;
    }

    .manager-grid {
      display: grid;
      gap: .9rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .manager-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, .065);
      overflow: hidden;
    }

    .manager-card.manager-wide {
      grid-column: span 2;
    }

    .manager-head {
      align-items: center;
      background: linear-gradient(90deg, #0b2f6b, #123f91);
      color: #fff;
      display: flex;
      gap: .8rem;
      justify-content: space-between;
      padding: .85rem 1rem;
    }

    .manager-title {
      font-size: .98rem;
      font-weight: 950;
      margin: 0;
    }

    .manager-subtitle {
      color: rgba(255,255,255,.76);
      font-size: .72rem;
      font-weight: 800;
      margin-top: .12rem;
    }

    .manager-body {
      padding: .85rem 1rem 1rem;
    }

    .manager-row {
      align-items: center;
      border-bottom: 1px solid #e6edf6;
      display: grid;
      gap: .7rem;
      grid-template-columns: minmax(0, 1fr) auto;
      padding: .64rem 0;
    }

    .manager-row:last-child {
      border-bottom: 0;
    }

    button.manager-row {
      background: transparent;
      border: 0;
      cursor: pointer;
      font: inherit;
      text-align: left;
      width: 100%;
    }

    button.manager-row:hover,
    button.manager-row.active {
      background: #f8fafc;
      border-radius: 10px;
      padding-left: .45rem;
      padding-right: .45rem;
    }

    .manager-row-wrap {
      border-bottom: 1px solid #e6edf6;
    }

    .manager-row-wrap:last-child {
      border-bottom: 0;
    }

    .manager-row-wrap > .manager-row {
      border-bottom: 0;
    }

    .manager-name {
      color: #0f172a;
      font-size: .86rem;
      font-weight: 950;
      line-height: 1.15;
    }

    .manager-meta {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      margin-top: .18rem;
    }

    .manager-amount {
      color: #0f172a;
      font-size: .92rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .manager-bar {
      background: #edf2f7;
      border-radius: 999px;
      height: 7px;
      margin-top: .35rem;
      overflow: hidden;
      width: 100%;
    }

    .manager-bar span {
      background: var(--bar-color, var(--blue));
      display: block;
      height: 100%;
      min-width: 4px;
    }

    .manager-matrix {
      display: grid;
      gap: .8rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .matrix-block {
      border: 1px solid #dbe4f0;
      border-left: 5px solid var(--matrix-color, var(--blue));
      border-radius: 14px;
      padding: .75rem;
    }

    .matrix-title {
      color: #0f172a;
      display: flex;
      font-size: .88rem;
      font-weight: 950;
      gap: .55rem;
      justify-content: space-between;
      line-height: 1.2;
      margin-bottom: .55rem;
    }

    .matrix-lines {
      display: grid;
      gap: .42rem;
    }

    .matrix-line {
      align-items: center;
      display: grid;
      gap: .55rem;
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    button.matrix-line {
      background: transparent;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      padding: .2rem .25rem;
      text-align: left;
      width: 100%;
    }

    button.matrix-line:hover,
    button.matrix-line.active {
      background: #f1f5f9;
    }

    .matrix-line-sede {
      margin-left: .65rem;
    }

    .matrix-nested {
      border-left: 2px solid #dbe4f0;
      display: grid;
      gap: .32rem;
      margin: .2rem 0 .3rem .35rem;
      padding-left: .55rem;
    }

    .matrix-plate-list {
      background: #f8fafc;
      border: 1px solid #e6edf6;
      border-radius: 12px;
      display: grid;
      gap: .25rem;
      margin: .15rem 0 .35rem 1.1rem;
      padding: .45rem;
    }

    .matrix-plate-row {
      align-items: center;
      display: grid;
      gap: .5rem;
      grid-template-columns: minmax(0, 1fr) auto auto;
      padding: .18rem .1rem;
    }

    .matrix-plate-name {
      color: #0f172a;
      font-size: .76rem;
      font-weight: 950;
    }

    .matrix-line-name {
      color: #334155;
      font-size: .77rem;
      font-weight: 850;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .matrix-line-money {
      color: #0f172a;
      font-size: .78rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .matrix-line-pct {
      background: #edf2f7;
      border-radius: 999px;
      color: #334155;
      font-size: .68rem;
      font-weight: 950;
      min-width: 38px;
      padding: .15rem .35rem;
      text-align: center;
    }

    .matrix-detail,
    .matrix-plate-detail {
      display: block;
    }

    .matrix-detail > summary,
    .matrix-plate-detail > summary {
      list-style: none;
    }

    .matrix-detail > summary::-webkit-details-marker,
    .matrix-plate-detail > summary::-webkit-details-marker {
      display: none;
    }

    .matrix-detail > summary.matrix-line {
      border-radius: 10px;
      cursor: pointer;
      padding: .28rem .32rem;
    }

    .matrix-detail > summary.matrix-line:hover,
    .matrix-detail[open] > summary.matrix-line {
      background: #f1f5f9;
    }

    .matrix-detail > summary.matrix-line::after {
      color: var(--muted);
      content: "Ver placas";
      font-size: .66rem;
      font-weight: 950;
      grid-column: 1 / -1;
    }

    .matrix-detail[open] > summary.matrix-line::after {
      content: "Ocultar placas";
    }

    .matrix-plate-detail > summary.matrix-plate-row {
      border-radius: 10px;
      cursor: pointer;
      padding: .32rem .35rem;
    }

    .matrix-plate-detail > summary.matrix-plate-row:hover,
    .matrix-plate-detail[open] > summary.matrix-plate-row {
      background: #fff;
    }

    .matrix-plate-meta {
      color: var(--muted);
      display: block;
      font-size: .68rem;
      font-weight: 800;
      margin-top: .08rem;
    }

    .matrix-movement-list {
      display: grid;
      gap: .35rem;
      margin: .2rem 0 .45rem;
    }

    .business-accordion {
      display: grid;
      gap: .65rem;
      padding: 1rem;
    }

    .business-node {
      background: #fff;
      border: 1px solid #dbe4f0;
      border-left: 6px solid var(--business-color, var(--blue));
      border-radius: 16px;
      overflow: hidden;
    }

    .business-toggle,
    .sede-toggle {
      align-items: center;
      background: transparent;
      border: 0;
      color: #0f172a;
      cursor: pointer;
      display: flex;
      gap: .75rem;
      justify-content: space-between;
      padding: .85rem .95rem;
      text-align: left;
      width: 100%;
    }

    .business-toggle:hover,
    .sede-toggle:hover {
      background: #f8fafc;
    }

    .business-toggle::after,
    .sede-toggle::after {
      color: var(--muted);
      content: "Abrir";
      font-size: .72rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .business-node.open > .business-toggle::after,
    .sede-node.open > .sede-toggle::after {
      content: "Cerrar";
    }

    .business-main,
    .sede-main,
    .placa-main {
      min-width: 0;
    }

    .business-title,
    .sede-title,
    .placa-title {
      color: #0f172a;
      font-size: .94rem;
      font-weight: 950;
      line-height: 1.18;
      word-break: break-word;
    }

    .business-meta,
    .sede-meta,
    .placa-meta {
      color: var(--muted);
      font-size: .73rem;
      font-weight: 800;
      margin-top: .25rem;
    }

    .business-money,
    .sede-money,
    .placa-money {
      color: #0f172a;
      font-size: .92rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .business-body {
      background: #f8fafc;
      border-top: 1px solid #dbe4f0;
      display: none;
      padding: .75rem;
    }

    .business-node.open > .business-body {
      display: block;
    }

    .sede-node {
      background: #fff;
      border: 1px solid #dbe4f0;
      border-radius: 13px;
      overflow: hidden;
    }

    .sede-node + .sede-node {
      margin-top: .55rem;
    }

    .sede-body {
      background: #f8fafc;
      border-top: 1px solid #e6edf6;
      display: none;
      max-height: 250px;
      overflow: auto;
      padding: .55rem .75rem;
    }

    .sede-node.open > .sede-body {
      display: block;
    }

    .placa-row {
      align-items: center;
      background: #fff;
      border: 1px solid #e6edf6;
      border-radius: 11px;
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding: .58rem .65rem;
    }

    .placa-row + .placa-row {
      margin-top: .45rem;
    }

    .compra-row {
      background: #fff;
      border: 1px solid #e6edf6;
      border-radius: 11px;
      overflow: hidden;
    }

    .compra-row + .compra-row {
      margin-top: .45rem;
    }

    .compra-summary {
      align-items: center;
      cursor: pointer;
      display: grid;
      gap: .75rem;
      grid-template-columns: minmax(0, 1fr) auto;
      list-style: none;
      padding: .58rem .65rem;
    }

    .compra-summary::-webkit-details-marker {
      display: none;
    }

    .compra-summary::after {
      color: var(--muted);
      content: "Ver movimientos";
      font-size: .68rem;
      font-weight: 950;
      grid-column: 1 / -1;
      justify-self: start;
    }

    .compra-row[open] .compra-summary {
      border-bottom: 1px solid #e6edf6;
    }

    .compra-row[open] .compra-summary::after {
      content: "Ocultar movimientos";
    }

    .compra-title {
      color: #0f172a;
      font-size: .86rem;
      font-weight: 950;
      line-height: 1.18;
      word-break: break-word;
    }

    .compra-meta {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      margin-top: .2rem;
    }

    .compra-details {
      background: #f8fafc;
      display: grid;
      gap: .45rem;
      max-height: 360px;
      overflow: auto;
      padding: .55rem;
    }

    .movimiento-row {
      background: #fff;
      border: 1px solid #e6edf6;
      border-radius: 10px;
      display: grid;
      gap: .55rem;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) auto;
      padding: .55rem;
    }

    .movimiento-title {
      color: #0f172a;
      font-size: .78rem;
      font-weight: 950;
      line-height: 1.2;
    }

    .movimiento-meta,
    .movimiento-desc {
      color: #64748b;
      font-size: .7rem;
      font-weight: 800;
      line-height: 1.25;
    }

    .movimiento-desc {
      color: #334155;
    }

    .movimiento-actions {
      align-items: flex-end;
      display: flex;
      flex-direction: column;
      gap: .35rem;
    }

    .movimiento-link {
      background: #071a44;
      border-radius: 999px;
      color: #fff;
      font-size: .68rem;
      font-weight: 950;
      padding: .3rem .55rem;
      text-decoration: none;
      white-space: nowrap;
    }

    .movimiento-link:hover {
      color: #fff;
      background: #0b3b82;
    }

    .business-empty {
      color: var(--muted);
      font-weight: 850;
      padding: 1rem;
      text-align: center;
    }

    .spend-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
      padding: .9rem 1rem .35rem;
    }

    .spend-tab {
      background: #eef2f7;
      border: 1px solid #dbe4f0;
      border-radius: 999px;
      color: #334155;
      font-size: .76rem;
      font-weight: 950;
      padding: .42rem .8rem;
    }

    .spend-tab.active {
      background: #071a44;
      border-color: #071a44;
      color: #fff;
    }

    .spend-summary {
      align-items: center;
      background: #f8fafc;
      border: 1px solid #e6edf6;
      border-radius: 14px;
      display: flex;
      gap: .75rem;
      justify-content: space-between;
      margin: .5rem 1rem .85rem;
      padding: .75rem .85rem;
    }

    .spend-summary-title {
      color: #0f172a;
      font-size: .92rem;
      font-weight: 950;
      line-height: 1.15;
    }

    .spend-summary-meta {
      color: var(--muted);
      font-size: .73rem;
      font-weight: 800;
      margin-top: .15rem;
    }

    .spend-summary-money {
      color: #0f172a;
      font-size: 1.05rem;
      font-weight: 950;
      white-space: nowrap;
    }

    .spend-table-wrap {
      padding: 0 1rem 1rem;
    }

    .spend-table {
      margin: 0;
    }

    .spend-table th {
      background: #071a44;
      color: #fff;
      font-size: .68rem;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .spend-table td {
      color: #0f172a;
      font-size: .82rem;
      vertical-align: middle;
    }

    .spend-concept {
      font-weight: 950;
      line-height: 1.16;
    }

    .spend-detail {
      color: #64748b;
      font-size: .72rem;
      font-weight: 800;
      margin-top: .15rem;
    }

    .spend-total-row td {
      background: #f8fafc;
      border-top: 2px solid #dbeafe;
      font-weight: 950;
    }

    .detail-hub {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, .065);
      overflow: hidden;
    }

    .detail-hub-head {
      align-items: center;
      background: linear-gradient(90deg, var(--navy), var(--blue));
      color: #fff;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.15rem;
    }

    .detail-hub-title {
      font-size: 1rem;
      font-weight: 950;
      margin: 0;
    }

    .detail-hub-subtitle {
      color: rgba(255,255,255,.74);
      font-size: .78rem;
      font-weight: 750;
      margin-top: .15rem;
    }

    .detail-tabs {
      background: #f8fafc;
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: .5rem;
      overflow-x: auto;
      padding: .75rem;
    }

    .detail-tab {
      background: #fff;
      border: 1px solid #dbe4f0;
      border-radius: 999px;
      color: #334155;
      cursor: pointer;
      flex: 0 0 auto;
      font-size: .76rem;
      font-weight: 950;
      padding: .55rem .85rem;
      white-space: nowrap;
    }

    .detail-tab.active {
      background: var(--blue);
      border-color: var(--blue);
      color: #fff;
      box-shadow: 0 8px 18px rgba(11, 59, 130, .18);
    }

    .detail-panel {
      display: none;
      padding: 1rem;
    }

    .detail-panel.active {
      display: block;
    }

    .detail-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .detail-block {
      border: 1px solid #dbe4f0;
      border-radius: 15px;
      overflow: hidden;
    }

    .detail-block-head {
      align-items: center;
      background: #f8fafc;
      border-bottom: 1px solid #dbe4f0;
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding: .8rem .9rem;
    }

    .detail-block-title {
      color: #0f172a;
      font-size: .88rem;
      font-weight: 950;
      margin: 0;
    }

    .detail-block-subtitle {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 800;
      margin-top: .12rem;
    }

    .detail-table {
      margin: 0;
    }

    .detail-table thead th {
      background: #eef4fb;
      color: #334155;
      font-size: .68rem;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    .detail-table td,
    .detail-table th {
      padding: .65rem .75rem;
      vertical-align: middle;
    }

    .detail-scroll {
      max-height: 430px;
      overflow: auto;
    }

    .chart-card { overflow: hidden; height: 100%; }

    .card-head {
      align-items: center;
      background: linear-gradient(90deg, rgba(11,59,130,.08), transparent 62%), #f8fafc;
      border-bottom: 1px solid #e6edf6;
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding: .9rem 1rem;
    }

    .card-title {
      color: #172554;
      font-size: 1rem;
      font-weight: 950;
      margin: 0;
    }

    .card-subtitle {
      color: var(--muted);
      font-size: .74rem;
      font-weight: 750;
    }

    .chart-body {
      min-height: 320px;
      padding: 1rem;
    }

    canvas {
      width: 100% !important;
      max-height: 330px;
    }

    .conclusion-list {
      display: grid;
      gap: .65rem;
    }

    .formula-box {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 14px;
      color: #172554;
      font-size: .86rem;
      font-weight: 750;
      line-height: 1.35;
      margin-bottom: .8rem;
      padding: .8rem .9rem;
    }

    .formula-box strong {
      font-weight: 950;
    }

    .conclusion-item {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-left: 5px solid var(--red);
      border-radius: 14px;
      color: #1f2937;
      font-weight: 800;
      line-height: 1.3;
      padding: .75rem .85rem;
    }

    .table-card { overflow: hidden; height: 100%; }

    .table {
      font-size: .86rem;
      margin: 0;
    }

    .table thead th {
      background: #eef4fb;
      color: #243b64;
      font-size: .68rem;
      font-weight: 950;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    .table td { vertical-align: middle; }

    .financial-card .table-responsive { overflow-x: hidden; }

    .finance-table { table-layout: fixed; }

    .finance-table th:nth-child(1),
    .finance-table td:nth-child(1) { width: 48%; }

    .finance-table th:nth-child(2),
    .finance-table td:nth-child(2) {
      text-align: center;
      width: 14%;
    }

    .finance-table th:nth-child(3),
    .finance-table td:nth-child(3) { width: 27%; }

    .finance-table th:nth-child(4),
    .finance-table td:nth-child(4) { width: 11%; }

    .finance-table td {
      padding: .72rem .55rem;
    }

    .finance-total td {
      background: #f8fafc;
      border-bottom: 2px solid #dbeafe;
      font-weight: 950;
    }

    .rank {
      align-items: center;
      background: #eaf1ff;
      border-radius: 999px;
      color: var(--blue);
      display: inline-flex;
      font-size: .75rem;
      font-weight: 950;
      height: 26px;
      justify-content: center;
      width: 26px;
    }

    .money {
      color: #0f172a;
      font-weight: 950;
      white-space: nowrap;
    }

    .finance-table .money {
      font-size: .82rem;
      letter-spacing: -.01em;
    }

    .pill {
      border-radius: 999px;
      display: inline-flex;
      font-size: .72rem;
      font-weight: 950;
      padding: .25rem .55rem;
      white-space: nowrap;
    }

    .pill-soft { background: #eef2f7; color: #334155; }
    .pill-blue { background: #dbeafe; color: #1e3a8a; }
    .pill-red { background: #fee2e2; color: #991b1b; }

    .live-badge {
      align-items: center;
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .28);
      border-radius: 999px;
      color: #fff;
      display: inline-flex;
      font-size: .76rem;
      font-weight: 850;
      gap: .35rem;
      padding: .32rem .7rem;
    }

    .live-dot {
      background: #22c55e;
      border-radius: 999px;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, .22);
      height: .48rem;
      width: .48rem;
    }

    .work-sede-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .work-sede-card {
      background: #fff;
      border: 1px solid #dbe4f0;
      border-radius: 14px;
      overflow: hidden;
    }

    .work-sede-head {
      align-items: center;
      background: #f8fafc;
      border-bottom: 1px solid #e6edf6;
      display: flex;
      justify-content: space-between;
      padding: .75rem .85rem;
    }

    .work-row {
      display: grid;
      gap: .5rem;
      grid-template-columns: minmax(0, 1fr) 4.25rem;
      padding: .62rem .85rem;
    }

    .work-row + .work-row {
      border-top: 1px dashed #dbe4f0;
    }

    .work-bar {
      background: #eaf1ff;
      border-radius: 999px;
      height: .44rem;
      margin-top: .35rem;
      overflow: hidden;
    }

    .work-bar-fill {
      background: var(--bar-color, #0b3b82);
      border-radius: inherit;
      height: 100%;
    }

    .empty-state {
      color: var(--muted);
      font-weight: 800;
      padding: 1.4rem;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero { padding: 1rem; }
      .metric-value { font-size: 1.35rem; }
      .chart-body { min-height: 260px; }
      .manager-grid,
      .manager-matrix { grid-template-columns: 1fr; }
      .manager-card.manager-wide { grid-column: auto; }
      .movimiento-row { grid-template-columns: 1fr; }
      .movimiento-actions { align-items: flex-start; flex-direction: row; justify-content: space-between; }
      .spend-summary { align-items: flex-start; flex-direction: column; }
      .detail-hub-head { align-items: flex-start; flex-direction: column; }
      .detail-grid { grid-template-columns: 1fr; }
      canvas { max-height: 280px; }
    }

    @media (min-width: 769px) and (max-width: 1180px) {
      .manager-grid,
      .manager-matrix { grid-template-columns: 1fr; }
      .manager-card.manager-wide { grid-column: auto; }
    }

    @media print {
      body { background: #fff; }
      .topbar,
      .panel,
      .live-badge,
      #printExecutive { display: none !important; }
      .shell { max-width: none; padding: 0 !important; }
      .hero,
      .metric-card,
      .chart-card,
      .table-card,
      .conclusion-card,
      .manager-card {
        box-shadow: none !important;
        break-inside: avoid;
      }
      .manager-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .manager-card.manager-wide { grid-column: span 2; }
    }
  </style>
</head>
<body>
<%
  const data = resumen || {};
  const money = (value) => Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 });
  const pct = (value, total) => total ? Math.round((Number(value || 0) / Number(total || 1)) * 100) : 0;
  const fecha = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value).slice(0, 10) : date.toLocaleDateString('es-CR');
  };
  const safe = (arr) => Array.isArray(arr) ? arr : [];
  const contieneCategoriaOculta = (texto) => {
    const value = String(texto || '').toLowerCase();
    return value.includes('otros por revisar') ||
      value.includes('cabezales, carretas y cisternas') ||
      value.includes('pago de proveedor');
  };
  const categorias = safe(data.categorias).filter(item => !contieneCategoriaOculta(item.nombre));
  const totalCategoriasOperativas = categorias.reduce((sum, item) => sum + Number(item.total || 0), 0);
  const fuentes = safe(data.fuentes);
  const productosServicios = safe(data.productosServicios);
  const proveedores = safe(data.proveedores);
  const sedesGasto = safe(data.sedes);
  const placasGasto = safe(data.placas);
  const negociosGasto = safe(data.negociosGasto);
  const rubrosPorNegocio = safe(data.rubrosPorNegocio)
    .map(negocio => ({
      ...negocio,
      rubros: safe(negocio.rubros).filter(item => !contieneCategoriaOculta(item.nombre))
    }));
  const mantenimientosPorSedeRubro = safe(data.mantenimientosPorSedeRubro)
    .map(sede => ({
      ...sede,
      rubros: safe(sede.rubros).filter(item => !contieneCategoriaOculta(item.nombre))
    }))
    .filter(sede => sede.rubros.length);
  const meses = safe(data.meses);
  const familiasMant = safe(data.familiasMant).filter(item => !contieneCategoriaOculta(item.nombre));
  const sedesMant = safe(data.sedesMant);
  const placasMant = safe(data.placasMant);
  const trabajosPorSede = safe(data.trabajosPorSede)
    .map(sede => ({
      ...sede,
      trabajos: safe(sede.trabajos).filter(item => !contieneCategoriaOculta(item.nombre))
    }))
    .filter(sede => sede.trabajos.length);
  const tiposMant = safe(data.tiposMant);
  const gastosMantenimientoPorTipo = safe(data.gastosMantenimientoPorTipo);
  const gastoPorTipo = (tipo) => gastosMantenimientoPorTipo.find(item => item.tipo === tipo) || { total: 0, registros: 0 };
  const conclusiones = safe(data.conclusiones).filter(item => !contieneCategoriaOculta(item));
  const costoUnidad = data.costoUnidad || {};
  const resumenFinanciero = data.resumenFinanciero || {};
  const horaActualizacion = new Intl.DateTimeFormat('es-CR', {
    timeZone: 'America/Costa_Rica',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  }).format(new Date());
  const totalGastosNumero = Number(data.totalGastos || 0);
%>

<nav class="navbar navbar-dark topbar px-4 py-3">
  <span class="navbar-brand fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Resumen ejecutivo</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="live-badge" title="La página se actualiza automáticamente">
      <span class="live-dot"></span>
      En vivo · <span id="refreshCountdown">60</span>s
    </span>
    <span class="text-white small">Actualizado <span id="lastUpdated"><%= horaActualizacion %></span></span>
    <span class="text-white small"><%= user.usuario %> · <%= user.rol %></span>
    <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-bold" id="printExecutive">
      <i class="bi bi-printer me-1"></i>Imprimir
    </button>
    <a href="/dashboard" class="btn btn-sm btn-outline-light rounded-pill px-3">Inicio</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <div class="eyebrow"><i class="bi bi-cash-coin me-1"></i> Dinero · Taller · Conclusiones</div>
        <h1 class="page-title">Resumen total</h1>
        <p class="hero-subtitle">Vista gerencial de gasto, pagos, flota y mantenimiento. Muestra qué se pagó, dónde se concentró el gasto y qué requiere seguimiento.</p>
      </div>
      <div class="text-white text-end">
        <div class="small opacity-75 fw-bold">Sede actual</div>
        <div class="h5 fw-black mb-0"><%= sedeSeleccionada || 'TODAS' %></div>
      </div>
    </div>
  </section>

  <section class="panel mb-4">
    <form method="GET" action="/dashboard/resumen-ejecutivo" class="row g-3 align-items-end">
      <div class="col-lg-3 col-md-6">
        <label class="form-label">Sede</label>
        <input
          type="text"
          name="sede"
          class="form-control form-control-sm"
          list="sedesResumenList"
          placeholder="Escriba o seleccione sede"
          value="<%= filtros.sede || '' %>"
        >
        <datalist id="sedesResumenList">
          <% if (usuarioTodasSedes) { %>
            <option value="TODAS">Todas</option>
          <% } %>
          <% safe(sedes).forEach(s => { %>
            <option value="<%= s %>"><%= typeof etiquetaSede === 'function' ? etiquetaSede(s) : s %></option>
          <% }) %>
        </datalist>
      </div>
      <div class="col-lg-2 col-md-6">
        <label class="form-label">Desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-lg-2 col-md-6">
        <label class="form-label">Hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-lg-2 col-md-6">
        <label class="form-label">Periodo cierre</label>
        <input type="month" name="periodo_cierre" class="form-control form-control-sm" value="<%= filtros.periodo_cierre || '' %>">
      </div>
      <div class="col-lg-2 col-md-6">
        <button class="btn btn-primary btn-sm rounded-pill w-100 fw-bold">Filtrar</button>
      </div>
      <div class="col-lg-2 col-md-6">
        <a href="/dashboard/resumen-ejecutivo" class="btn btn-secondary btn-sm rounded-pill w-100 fw-bold">Limpiar</a>
      </div>
    </form>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#0b3b82">
        <div class="metric-label">Total gastado</div>
        <div class="metric-value" id="kpiTotalGastado">₡<%= money(data.totalGastos) %></div>
        <div class="metric-foot" id="kpiTotalGastadoFoot"><%= Number(data.totalRegistrosGasto || 0).toLocaleString('es-CR') %> movimientos de dinero</div>
      </div>
    </div>
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#198754">
        <div class="metric-label">Total pagado</div>
        <div class="metric-value" id="kpiTotalPagado">₡<%= money(resumenFinanciero.totalPagado || 0) %></div>
        <div class="metric-foot">
          Facturas, órdenes motor pagadas, proveedores pagados y caja chica
        </div>
      </div>
    </div>
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#ef233c">
        <div class="metric-label">Mayor tipo de gasto</div>
        <div class="metric-value" id="kpiMayorTipo"><%= categorias[0]?.nombre || '-' %></div>
        <div class="metric-foot" id="kpiMayorTipoFoot">₡<%= money(categorias[0]?.total || 0) %> · <%= pct(categorias[0]?.total, totalCategoriasOperativas) %>% del gasto operativo</div>
      </div>
    </div>
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#7c3aed">
        <div class="metric-label">Costo promedio por unidad</div>
        <div class="metric-value" id="kpiCostoUnidad">₡<%= money(costoUnidad.costoPromedioPorUnidad || 0) %></div>
        <div class="metric-foot" id="kpiCostoUnidadFoot">
          <%= Number(costoUnidad.unidadesConGasto || 0).toLocaleString('es-CR') %> placa(s) con gasto ·
          <%= Number(costoUnidad.totalUnidadesFlota || 0).toLocaleString('es-CR') %> en flota
        </div>
      </div>
    </div>
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#f8b400">
        <div class="metric-label">Mantenimientos</div>
        <div class="metric-value" id="kpiMantenimientos"><%= Number(data.totalMantenimientos || 0).toLocaleString('es-CR') %></div>
        <div class="metric-foot" id="kpiMantenimientosFoot"><%= familiasMant[0]?.nombre || '-' %> es lo más repetido</div>
      </div>
    </div>
    <div class="col-xl col-md-6">
      <div class="metric-card" style="--accent:#0f766e">
        <div class="metric-label">Placa con más gasto</div>
        <div class="metric-value" id="kpiPlacaGasto"><%= placasGasto[0]?.nombre || '-' %></div>
        <div class="metric-foot" id="kpiPlacaGastoFoot">₡<%= money(placasGasto[0]?.total || 0) %> · <%= placasGasto[0]?.sede || '-' %></div>
      </div>
    </div>
  </section>

  <div class="section-label"><span>Vista solicitada por gerencia</span></div>
  <section class="manager-grid mb-4" id="managerGrid">
    <article class="manager-card">
      <div class="manager-head">
        <div>
          <h2 class="manager-title">General por negocio</h2>
          <div class="manager-subtitle">Total gasto del mes: crédito, contado, pagos y caja chica.</div>
        </div>
        <span class="pill pill-blue">₡<%= money(totalGastosNumero) %></span>
      </div>
      <div class="manager-body">
        <% if (!negociosGasto.length) { %>
          <div class="empty-state">No hay gasto por negocio para este filtro.</div>
        <% } %>
        <% negociosGasto.forEach(item => { %>
          <div class="manager-row">
            <div>
              <div class="manager-name"><%= item.nombre %></div>
              <div class="manager-meta"><%= Number(item.registros || 0).toLocaleString('es-CR') %> movimiento(s) · <%= pct(item.total, totalGastosNumero) %>% del gasto</div>
              <div class="manager-bar" style="--bar-color:<%= item.color || '#0b3b82' %>"><span style="width:<%= Math.max(4, pct(item.total, totalGastosNumero)) %>%"></span></div>
            </div>
            <div class="manager-amount">₡<%= money(item.total || 0) %></div>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="manager-card">
      <div class="manager-head">
        <div>
          <h2 class="manager-title">Por rubro del mantenimiento</h2>
          <div class="manager-subtitle">Familias de gasto del periodo.</div>
        </div>
        <span class="pill pill-blue"><%= categorias.length %> rubros</span>
      </div>
      <div class="manager-body">
        <% if (!categorias.length) { %>
          <div class="empty-state">No hay rubros para este filtro.</div>
        <% } %>
        <% categorias.slice(0, 8).forEach(item => { %>
          <div class="manager-row">
            <div>
              <div class="manager-name"><%= item.nombre %></div>
              <div class="manager-meta"><%= Number(item.registros || 0).toLocaleString('es-CR') %> movimiento(s) · <%= pct(item.total, totalCategoriasOperativas) %>% del rubro operativo</div>
              <div class="manager-bar" style="--bar-color:<%= item.color || '#0b3b82' %>"><span style="width:<%= Math.max(4, pct(item.total, totalCategoriasOperativas)) %>%"></span></div>
            </div>
            <div class="manager-amount">₡<%= money(item.total || 0) %></div>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="manager-card manager-wide">
      <div class="manager-head">
        <div>
          <h2 class="manager-title">General por rubro del mantenimiento</h2>
          <div class="manager-subtitle">Cada negocio dividido por frenos, motor, llantas, eléctrico y demás rubros.</div>
        </div>
        <span class="pill pill-blue">Negocio -> rubro</span>
      </div>
      <div class="manager-body">
        <div class="manager-matrix">
          <% rubrosPorNegocio.forEach(negocio => { %>
            <div class="matrix-block" style="--matrix-color:<%= negocio.color || '#0b3b82' %>">
              <div class="matrix-title">
                <span><%= negocio.nombre %></span>
                <span>₡<%= money(negocio.total || 0) %></span>
              </div>
              <div class="matrix-lines">
                <% if (!safe(negocio.rubros).length) { %>
                  <div class="empty-state py-2">Sin movimiento.</div>
                <% } %>
                <% safe(negocio.rubros).slice(0, 7).forEach(rubro => { %>
                  <div class="matrix-line">
                    <span class="matrix-line-name"><%= rubro.nombre %></span>
                    <span class="matrix-line-money">₡<%= money(rubro.total || 0) %></span>
                    <span class="matrix-line-pct"><%= rubro.porcentaje || 0 %>%</span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </article>

    <article class="manager-card manager-wide">
      <div class="manager-head">
        <div>
          <h2 class="manager-title">Mantenimientos realizados por sede</h2>
          <div class="manager-subtitle">Abra una sede, luego un rubro; al tocar la placa verá de dónde salió el gasto.</div>
        </div>
        <span class="pill pill-blue">Sede -> rubro -> placa</span>
      </div>
      <div class="manager-body">
        <div class="manager-matrix">
          <% if (!mantenimientosPorSedeRubro.length) { %>
            <div class="empty-state">No hay sedes con gasto para este filtro.</div>
          <% } %>
          <% mantenimientosPorSedeRubro.forEach(sede => { %>
            <div class="matrix-block" style="--matrix-color:#0b3b82">
              <div class="matrix-title">
                <span><%= sede.nombre %></span>
                <span>₡<%= money(sede.total || 0) %></span>
              </div>
              <div class="matrix-lines">
                <% safe(sede.rubros).forEach(rubro => { %>
                  <details class="matrix-detail">
                    <summary class="matrix-line">
                      <span class="matrix-line-name"><%= rubro.nombre %></span>
                      <span class="matrix-line-money">₡<%= money(rubro.total || 0) %></span>
                      <span class="matrix-line-pct"><%= rubro.porcentaje || 0 %>%</span>
                    </summary>
                    <div class="matrix-plate-list">
                      <% if (!safe(rubro.placas).length) { %>
                        <div class="empty-state py-2">No hay placas para este rubro.</div>
                      <% } %>
                      <% safe(rubro.placas).forEach(placa => { %>
                        <details class="matrix-plate-detail">
                          <summary class="matrix-plate-row">
                            <span class="matrix-plate-name">
                              <%= placa.nombre || '-' %>
                              <span class="matrix-plate-meta"><%= placa.sede || '-' %> · <%= Number(placa.registros || 0).toLocaleString('es-CR') %> mov.</span>
                            </span>
                            <span class="matrix-line-money">₡<%= money(placa.total || 0) %></span>
                            <span class="matrix-line-pct"><%= placa.porcentaje || 0 %>%</span>
                          </summary>
                          <div class="matrix-movement-list">
                            <% safe(placa.movimientos).forEach(mov => { %>
                              <div class="movimiento-row">
                                <div>
                                  <div class="movimiento-title"><%= mov.fuente_nombre || 'Movimiento' %> <%= mov.po_numero && mov.po_numero !== '-' ? `· ${mov.po_numero}` : '' %></div>
                                  <div class="movimiento-meta"><%= fecha(mov.fecha) %> · <%= mov.proveedor || '-' %></div>
                                </div>
                                <div class="movimiento-desc"><%= mov.descripcion || mov.observaciones || '-' %></div>
                                <div class="movimiento-actions">
                                  <span class="matrix-line-money">₡<%= money(mov.monto || 0) %></span>
                                  <% if (mov.url) { %><a class="movimiento-link" href="<%= mov.url %>">Abrir</a><% } %>
                                </div>
                              </div>
                            <% }) %>
                          </div>
                        </details>
                      <% }) %>
                    </div>
                  </details>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </article>
  </section>

  <div class="section-label"><span>1. Tabla de gasto por negocio</span></div>
  <section class="table-card mb-4">
    <div class="card-head">
      <div>
        <h2 class="card-title"><i class="bi bi-table me-1"></i>Gasto operativo por negocio</h2>
        <div class="card-subtitle">Seleccione arriba el negocio para ver el detalle por rubro; en Todos se compara cada negocio completo.</div>
      </div>
      <span class="pill pill-blue">Tabla gerencial</span>
    </div>
    <div class="spend-tabs" id="spendBusinessTabs"></div>
    <div class="spend-summary" id="spendBusinessSummary"></div>
    <div class="table-responsive spend-table-wrap">
      <table class="table table-hover align-middle spend-table">
        <thead>
          <tr>
            <th>Concepto</th>
            <th>Detalle</th>
            <th class="text-end">Mov.</th>
            <th class="text-end">Monto</th>
            <th class="text-end">%</th>
          </tr>
        </thead>
        <tbody id="spendBusinessRows"></tbody>
        <tfoot id="spendBusinessFoot"></tfoot>
      </table>
    </div>
  </section>

  <div class="section-label"><span>2. Detalle por negocio, sede y placa</span></div>
  <section class="table-card mb-4">
    <div class="card-head">
      <div>
        <h2 class="card-title"><i class="bi bi-diagram-3-fill me-1"></i>Gasto por negocio, sede y placa</h2>
        <div class="card-subtitle">Aprete un negocio para ver sedes; luego aprete una sede para ver placas.</div>
      </div>
      <span class="pill pill-blue">Acordeón ejecutivo</span>
    </div>
    <div class="business-accordion" id="negocioAccordion"></div>
  </section>

  <div class="section-label"><span>3. Resumen financiero y flota</span></div>
  <section class="row g-3 mb-4">
    <div class="col-lg-4">
      <div class="table-card financial-card">
        <div class="card-head">
          <div>
            <h2 class="card-title">Resumen financiero</h2>
            <div class="card-subtitle">Pagos y pendientes del periodo.</div>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle finance-table">
            <thead><tr><th>Origen</th><th>Mov.</th><th class="text-end">Monto</th><th class="text-end">%</th></tr></thead>
            <tbody>
              <tr class="finance-total">
                <td><strong>Total pagado</strong></td>
                <td><span class="pill pill-blue"><%= Number(resumenFinanciero.movimientosTotalPagado || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalPagado || 0) %></td>
                <td class="text-end">100%</td>
              </tr>
              <tr>
                <td>
                  <strong>Facturas pagadas</strong>
                </td>
                <td><span class="pill pill-soft"><%= Number(resumenFinanciero.movimientosFacturasPagadas || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalFacturasPagadas || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalFacturasPagadas, resumenFinanciero.totalPagado) %>%</td>
              </tr>
              <tr>
                <td><strong>Órdenes motor</strong></td>
                <td><span class="pill pill-soft"><%= Number(resumenFinanciero.movimientosOrdenesMotorPagadas || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalOrdenesMotorPagadas || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalOrdenesMotorPagadas, resumenFinanciero.totalPagado) %>%</td>
              </tr>
              <tr>
                <td><strong>Gasto correctivo</strong></td>
                <td><span class="pill pill-soft"><%= Number(resumenFinanciero.movimientosGastoCorrectivo || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalGastoCorrectivo || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalGastoCorrectivo, data.totalGastos) %>%</td>
              </tr>
              <tr>
                <td><strong>Gasto preventivo</strong></td>
                <td><span class="pill pill-soft"><%= Number(resumenFinanciero.movimientosGastoPreventivo || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalGastoPreventivo || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalGastoPreventivo, data.totalGastos) %>%</td>
              </tr>
              <tr>
                <td><strong>Pago proveedor pagado</strong></td>
                <td><span class="pill pill-blue"><%= Number(resumenFinanciero.movimientosPagosProveedorPagados || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalPagosProveedorPagados || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalPagosProveedorPagados, resumenFinanciero.totalPagado) %>%</td>
              </tr>
              <tr>
                <td><strong>Pago proveedor pendiente</strong></td>
                <td><span class="pill pill-red"><%= Number(resumenFinanciero.movimientosPagosProveedorPendientes || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalPagosProveedorPendientes || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalPagosProveedorPendientes, resumenFinanciero.totalPagosProveedor || 0) %>%</td>
              </tr>
              <tr>
                <td><strong>Caja chica</strong></td>
                <td><span class="pill pill-soft"><%= Number(resumenFinanciero.movimientosCajaChica || 0).toLocaleString('es-CR') %></span></td>
                <td class="text-end money">₡<%= money(resumenFinanciero.totalCajaChica || 0) %></td>
                <td class="text-end"><%= pct(resumenFinanciero.totalCajaChica, resumenFinanciero.totalPagado) %>%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="table-card">
        <div class="card-head">
          <div>
            <h2 class="card-title"><i class="bi bi-truck-front-fill me-1"></i>Flota del filtro</h2>
            <div class="card-subtitle">Unidades registradas contra gasto real por placa.</div>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <tbody>
              <tr><td>Total unidades</td><td class="text-end money"><%= Number(costoUnidad.totalUnidadesFlota || 0).toLocaleString('es-CR') %></td></tr>
              <tr><td>Activas</td><td class="text-end money"><%= Number(costoUnidad.unidadesActivasFlota || 0).toLocaleString('es-CR') %></td></tr>
              <tr><td>Varadas</td><td class="text-end money"><%= Number(costoUnidad.unidadesVaradasFlota || 0).toLocaleString('es-CR') %></td></tr>
              <tr><td>Placas con gasto</td><td class="text-end money"><%= Number(costoUnidad.unidadesConGasto || 0).toLocaleString('es-CR') %></td></tr>
              <tr><td>Gasto con placa real</td><td class="text-end money">₡<%= money(costoUnidad.totalGastoConUnidad || 0) %></td></tr>
              <tr><td>Fuera del promedio</td><td class="text-end money">₡<%= money(costoUnidad.totalGastoSinUnidad || 0) %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="table-card">
        <div class="card-head">
          <div>
            <h2 class="card-title"><i class="bi bi-clipboard2-pulse-fill me-1"></i>Mantenimiento operativo</h2>
            <div class="card-subtitle">Correctivos y preventivos del periodo.</div>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>Tipo</th><th class="text-end">Registros</th><th class="text-end">Monto órdenes</th></tr></thead>
            <tbody>
              <% if (!tiposMant.length) { %><tr><td colspan="3" class="empty-state">No hay mantenimientos para este filtro.</td></tr><% } %>
              <% tiposMant.forEach(item => { %>
                <% const montoTipo = gastoPorTipo(String(item.nombre || '').toUpperCase()); %>
                <tr>
                  <td><strong><%= item.nombre %></strong></td>
                  <td class="text-end money"><%= Number(item.registros || 0).toLocaleString('es-CR') %></td>
                  <td class="text-end money">₡<%= money(montoTipo.total || 0) %></td>
                </tr>
              <% }) %>
              <% gastosMantenimientoPorTipo.filter(item => !tiposMant.some(t => String(t.nombre || '').toUpperCase() === item.tipo)).forEach(item => { %>
                <tr>
                  <td><strong><%= item.nombre %></strong></td>
                  <td class="text-end money">0</td>
                  <td class="text-end money">₡<%= money(item.total || 0) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <div class="section-label"><span>3. Tendencias y mantenimiento</span></div>
  <section class="row g-3 mb-4">
    <div class="col-lg-8">
      <div class="chart-card">
        <div class="card-head">
          <div>
            <h2 class="card-title"><i class="bi bi-bar-chart-fill me-1"></i>Tendencia mensual</h2>
            <div class="card-subtitle">Tendencia general del dinero registrado.</div>
          </div>
        </div>
        <div class="chart-body"><canvas id="chartMeses"></canvas></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="chart-card">
        <div class="card-head">
          <div>
            <h2 class="card-title"><i class="bi bi-bar-chart-fill me-1"></i>Composición del gasto</h2>
            <div class="card-subtitle">Resumen ejecutivo por familia de gasto.</div>
          </div>
        </div>
        <div class="chart-body"><canvas id="chartCategorias"></canvas></div>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-lg-5">
      <div class="conclusion-card p-3 h-100">
        <div class="card-title mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Conclusiones automáticas</div>
        <div class="formula-box">
          <strong>Cómo se saca el costo por unidad:</strong><br>
          ₡<%= money(costoUnidad.totalGastoConUnidad || 0) %> en gastos con placa real del periodo ÷
          <%= Number(costoUnidad.unidadesConGasto || 0).toLocaleString('es-CR') %> placa(s) con gasto =
          <strong>₡<%= money(costoUnidad.costoPromedioPorUnidad || 0) %></strong>.
          <div class="mt-1 text-muted">
            La flota total del filtro es <%= Number(costoUnidad.totalUnidadesFlota || 0).toLocaleString('es-CR') %> unidad(es).
            Si se divide contra toda la flota, da ₡<%= money(costoUnidad.costoPromedioPorUnidadFlota || 0) %>.
          </div>
          <% if (Number(costoUnidad.totalGastoSinUnidad || 0) > 0) { %>
            <div class="mt-1 text-muted">
              ₡<%= money(costoUnidad.totalGastoSinUnidad || 0) %> queda fuera de este promedio porque no tiene placa real registrada.
            </div>
          <% } %>
        </div>
        <% if (!conclusiones.length) { %>
          <div class="empty-state">No hay suficientes datos para generar conclusiones.</div>
        <% } else { %>
          <div class="conclusion-list">
            <% conclusiones.forEach(item => { %>
              <div class="conclusion-item"><%= item %></div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="chart-card">
        <div class="card-head">
          <div>
            <h2 class="card-title"><i class="bi bi-tools me-1"></i>Mantenimientos por familia</h2>
            <div class="card-subtitle">Preventivos y correctivos clasificados por tipo de trabajo.</div>
          </div>
        </div>
        <div class="chart-body"><canvas id="chartMantenimientos"></canvas></div>
      </div>
    </div>
  </section>

  <div class="section-label"><span>4. Panel de respaldo</span></div>
  <section class="detail-hub mb-4">
    <div class="detail-hub-head">
      <div>
        <h2 class="detail-hub-title"><i class="bi bi-folder2-open me-1"></i>Detalle ejecutivo ordenado</h2>
        <div class="detail-hub-subtitle">Use las pestañas para revisar dinero, unidades, mantenimiento y movimientos recientes sin llenar la pantalla.</div>
      </div>
      <span class="pill pill-blue"><%= Number(categorias.length + proveedores.length + placasGasto.length + familiasMant.length).toLocaleString('es-CR') %> datos</span>
    </div>

    <div class="detail-tabs" role="tablist" aria-label="Detalle ejecutivo">
      <button type="button" class="detail-tab active" data-detail-tab="dinero">Dinero</button>
      <button type="button" class="detail-tab" data-detail-tab="unidades">Unidades</button>
      <button type="button" class="detail-tab" data-detail-tab="mantenimiento">Mantenimiento</button>
      <button type="button" class="detail-tab" data-detail-tab="recientes">Recientes</button>
    </div>

    <div class="detail-panel active" data-detail-panel="dinero">
      <div class="detail-grid">
        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Gasto por tipo operativo</h3>
              <div class="detail-block-subtitle">Monto y peso del gasto visible.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>Categoría</th><th>Mov.</th><th class="text-end">Monto</th><th class="text-end">%</th></tr></thead>
              <tbody>
                <% if (!categorias.length) { %><tr><td colspan="4" class="empty-state">No hay categorías para este filtro.</td></tr><% } %>
                <% categorias.forEach(item => { %>
                  <tr>
                    <td><span class="pill" style="background:<%= item.color || '#eef2f7' %>22;color:<%= item.color || '#334155' %>"><%= item.nombre %></span></td>
                    <td><span class="pill pill-soft"><%= Number(item.registros || 0).toLocaleString('es-CR') %></span></td>
                    <td class="text-end money">₡<%= money(item.total) %></td>
                    <td class="text-end"><%= pct(item.total, totalCategoriasOperativas) %>%</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Proveedores con mayor gasto</h3>
              <div class="detail-block-subtitle">Ordenado de mayor a menor monto.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>#</th><th>Proveedor</th><th>Mov.</th><th class="text-end">Monto</th></tr></thead>
              <tbody>
                <% if (!proveedores.length) { %><tr><td colspan="4" class="empty-state">No hay registros para este filtro.</td></tr><% } %>
                <% proveedores.forEach((item, i) => { %>
                  <tr><td><span class="rank"><%= i + 1 %></span></td><td><strong><%= item.nombre %></strong></td><td><span class="pill pill-soft"><%= item.registros %></span></td><td class="text-end money">₡<%= money(item.total) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="detail-panel" data-detail-panel="unidades">
      <div class="detail-grid">
        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Costo por unidad</h3>
              <div class="detail-block-subtitle">Monto acumulado por placa real.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>#</th><th>Placa</th><th>Sede</th><th>Mov.</th><th class="text-end">Monto</th></tr></thead>
              <tbody>
                <% if (!placasGasto.length) { %><tr><td colspan="5" class="empty-state">No hay placas reales con monto en este filtro.</td></tr><% } %>
                <% placasGasto.forEach((item, i) => { %>
                  <tr><td><span class="rank"><%= i + 1 %></span></td><td><strong><%= item.nombre %></strong></td><td><%= item.sede || '-' %></td><td><span class="pill pill-blue"><%= item.registros %></span></td><td class="text-end money">₡<%= money(item.total) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Gasto por sede</h3>
              <div class="detail-block-subtitle">Calculado desde placas registradas.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>Sede</th><th>Mov.</th><th class="text-end">Monto</th></tr></thead>
              <tbody>
                <% if (!sedesGasto.length) { %><tr><td colspan="3" class="empty-state">No hay sedes con placas reales en este filtro.</td></tr><% } %>
                <% sedesGasto.forEach(item => { %>
                  <tr><td><strong><%= item.nombre %></strong></td><td><span class="pill pill-soft"><%= item.registros %></span></td><td class="text-end money">₡<%= money(item.total) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="detail-panel" data-detail-panel="mantenimiento">
      <div class="detail-grid">
        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Familias de mantenimiento</h3>
              <div class="detail-block-subtitle">Motor, frenos, transmisión, dirección, llantas y eléctrico.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>Familia</th><th class="text-end">Registros</th></tr></thead>
              <tbody>
                <% if (!familiasMant.length) { %><tr><td colspan="2" class="empty-state">No hay registros para este filtro.</td></tr><% } %>
                <% familiasMant.forEach(item => { %>
                  <tr><td><span class="pill" style="background:<%= item.color || '#eef2f7' %>22;color:<%= item.color || '#334155' %>"><%= item.nombre %></span></td><td class="text-end money"><%= Number(item.registros || 0).toLocaleString('es-CR') %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Trabajo más realizado por sede</h3>
              <div class="detail-block-subtitle">Ranking interno de cada sede.</div>
            </div>
          </div>
          <div class="p-3 detail-scroll">
            <% if (!trabajosPorSede.length) { %>
              <div class="empty-state">No hay trabajos por sede para este filtro.</div>
            <% } else { %>
              <div class="work-sede-grid">
                <% trabajosPorSede.forEach(sede => { %>
                  <div class="work-sede-card">
                    <div class="work-sede-head">
                      <strong><%= sede.nombre %></strong>
                      <span class="pill pill-soft"><%= Number(sede.registros || 0).toLocaleString('es-CR') %> registros</span>
                    </div>
                    <% safe(sede.trabajos).forEach(trabajo => { %>
                      <div class="work-row">
                        <div>
                          <div class="d-flex justify-content-between gap-2">
                            <strong><%= trabajo.nombre %></strong>
                            <span class="small text-muted"><%= Number(trabajo.porcentaje || 0).toLocaleString('es-CR') %>%</span>
                          </div>
                          <div class="work-bar">
                            <div class="work-bar-fill" style="--bar-color:<%= trabajo.color || '#0b3b82' %>;width:<%= Math.min(Number(trabajo.porcentaje || 0), 100) %>%"></div>
                          </div>
                        </div>
                        <div class="text-end money"><%= Number(trabajo.registros || 0).toLocaleString('es-CR') %></div>
                      </div>
                    <% }) %>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Sedes con más mantenimiento</h3>
              <div class="detail-block-subtitle">Movimiento operativo por sede.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>#</th><th>Sede</th><th class="text-end">Registros</th></tr></thead>
              <tbody>
                <% if (!sedesMant.length) { %><tr><td colspan="3" class="empty-state">No hay registros para este filtro.</td></tr><% } %>
                <% sedesMant.forEach((item, i) => { %>
                  <tr><td><span class="rank"><%= i + 1 %></span></td><td><strong><%= item.nombre %></strong></td><td class="text-end money"><%= Number(item.registros || 0).toLocaleString('es-CR') %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Placas con más mantenimiento</h3>
              <div class="detail-block-subtitle">Unidades con más movimiento operativo.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>#</th><th>Placa</th><th>Sede</th><th class="text-end">Registros</th></tr></thead>
              <tbody>
                <% if (!placasMant.length) { %><tr><td colspan="4" class="empty-state">No hay placas para este filtro.</td></tr><% } %>
                <% placasMant.forEach((item, i) => { %>
                  <tr><td><span class="rank"><%= i + 1 %></span></td><td><strong><%= item.nombre %></strong></td><td><%= item.sede || '-' %></td><td class="text-end money"><%= Number(item.registros || 0).toLocaleString('es-CR') %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="detail-panel" data-detail-panel="recientes">
      <div class="detail-grid">
        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Últimos movimientos de dinero</h3>
              <div class="detail-block-subtitle">Órdenes, pagos y caja chica.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>Fecha</th><th>Fuente</th><th>Detalle</th><th class="text-end">Monto</th></tr></thead>
              <tbody>
                <% safe(data.recientesGasto).forEach(item => { %>
                  <tr>
                    <td><%= fecha(item.fecha) %></td>
                    <td><span class="pill pill-soft"><%= item.fuente === 'ORDEN' ? 'Orden' : item.fuente === 'PAGO_PROVEEDOR' ? 'Pago proveedor' : 'Caja chica' %></span></td>
                    <td><strong><%= item.proveedor || '-' %></strong><div class="small text-muted"><%= item.placa %> · <%= item.sede %> · <%= item.descripcion || '-' %></div></td>
                    <td class="text-end money">₡<%= money(item.monto) %></td>
                  </tr>
                <% }) %>
                <% if (!safe(data.recientesGasto).length) { %><tr><td colspan="4" class="empty-state">No hay movimientos con placa registrada para este filtro.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="detail-block">
          <div class="detail-block-head">
            <div>
              <h3 class="detail-block-title">Últimos mantenimientos</h3>
              <div class="detail-block-subtitle">Preventivos y correctivos.</div>
            </div>
          </div>
          <div class="table-responsive detail-scroll">
            <table class="table table-hover align-middle detail-table">
              <thead><tr><th>Fecha</th><th>Placa</th><th>Tipo</th><th>Detalle</th></tr></thead>
              <tbody>
                <% safe(data.recientesMantenimiento).forEach(item => { %>
                  <tr>
                    <td><%= fecha(item.fecha) %></td>
                    <td><strong><%= item.placa %></strong><div class="small text-muted"><%= item.sede || '-' %></div></td>
                    <td><span class="pill <%= item.tipo_registro === 'CORRECTIVO' ? 'pill-red' : 'pill-blue' %>"><%= item.tipo_registro %></span></td>
                    <td><%= item.detalle || '-' %></td>
                  </tr>
                <% }) %>
                <% if (!safe(data.recientesMantenimiento).length) { %><tr><td colspan="4" class="empty-state">No hay mantenimientos para este filtro.</td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script type="application/json" id="json-categorias"><%- JSON.stringify(categorias) %></script>
<script type="application/json" id="json-meses"><%- JSON.stringify(meses) %></script>
<script type="application/json" id="json-mantenimientos"><%- JSON.stringify(familiasMant) %></script>
<script type="application/json" id="json-negocios"><%- JSON.stringify(negociosGasto) %></script>
<script type="application/json" id="json-resumen"><%- JSON.stringify(data) %></script>
<script>
  const readJson = (id) => {
    try { return JSON.parse(document.getElementById(id)?.textContent || '[]'); }
    catch (_) { return []; }
  };
  const formatMoney = (value) => `₡${Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 })}`;
  const formatNumber = (value) => Number(value || 0).toLocaleString('es-CR');
  const formatDate = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value).slice(0, 10) : date.toLocaleDateString('es-CR');
  };
  const percent = (value, total) => total ? Math.round((Number(value || 0) / Number(total || 1)) * 100) : 0;
  const isHiddenCategory = (name) => {
    const value = String(name || '').toLowerCase();
    return value.includes('otros por revisar') ||
      value.includes('cabezales, carretas y cisternas') ||
      value.includes('pago de proveedor');
  };
  const escapeHtml = (value) => String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
  let categoriasData = readJson('json-categorias');
  let mesesData = readJson('json-meses');
  let mantenimientosData = readJson('json-mantenimientos');
  let negociosData = readJson('json-negocios');
  let resumenData = readJson('json-resumen');
  const managerState = {
    rubro: {},
    sede: {},
    rubroGeneral: {},
    sedeGeneral: {}
  };
  let spendBusinessActive = 'TODOS';
  let chartMeses = null;
  let chartCategorias = null;
  let chartMantenimientos = null;

  const setText = (id, value) => {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  };

  const businessDetailLabel = (negocio) => {
    if (negocio?.clave === 'transportadora') return 'Dividido en cabezales, cisternas, carretas y tándem';
    if (negocio?.clave === 'cilindreros') return 'Camiones Hino / cilindreros';
    if (negocio?.clave === 'granel') return 'Unidades graneleras por sede';
    if (negocio?.clave === 'comodines') return 'Taller, técnicos y comodines';
    if (negocio?.clave === 'aceites') return 'Aceites, filtros y fluidos';
    if (negocio?.clave === 'generales') return 'Compras generales sin placa';
    return 'Gasto operativo';
  };

  const renderSpendBusinessTable = (data) => {
    const tabs = document.getElementById('spendBusinessTabs');
    const summary = document.getElementById('spendBusinessSummary');
    const rowsBody = document.getElementById('spendBusinessRows');
    const foot = document.getElementById('spendBusinessFoot');
    if (!tabs || !summary || !rowsBody || !foot) return;

    const negocioDetalle = new Map((data.negociosGasto || []).map(negocio => [negocio.clave, negocio]));
    const negocios = (data.rubrosPorNegocio || [])
      .map(negocio => {
        const detalle = negocioDetalle.get(negocio.clave) || {};
        return {
          ...negocio,
          subnegocios: detalle.subnegocios || [],
          compras: detalle.compras || [],
          sedes: detalle.sedes || negocio.sedes || [],
          placas: detalle.placas || negocio.placas || [],
          rubros: (negocio.rubros || []).filter(rubro => !isHiddenCategory(rubro.nombre))
        };
      })
      .filter(negocio => Number(negocio.total || 0) > 0);

    const opciones = [{ clave: 'TODOS', nombre: 'Todos' }, ...negocios.map(negocio => ({ clave: negocio.clave, nombre: negocio.nombre }))];
    if (!opciones.some(item => item.clave === spendBusinessActive)) spendBusinessActive = 'TODOS';

    tabs.innerHTML = opciones.map(item => `
      <button type="button" class="spend-tab ${item.clave === spendBusinessActive ? 'active' : ''}" data-spend-business="${escapeHtml(item.clave)}">
        ${escapeHtml(item.nombre)}
      </button>
    `).join('');

    tabs.querySelectorAll('[data-spend-business]').forEach(button => {
      button.addEventListener('click', () => {
        spendBusinessActive = button.dataset.spendBusiness || 'TODOS';
        renderSpendBusinessTable(data);
      });
    });

    const totalPeriodo = negocios.reduce((sum, item) => sum + Number(item.total || 0), 0);
    let titulo = 'Todos los negocios';
    let meta = 'Comparativo general: cilindreros, transportadora, graneleras, comodines, aceites y generales.';
    let totalTabla = totalPeriodo;
    let registrosTabla = negocios.reduce((sum, item) => sum + Number(item.registros || 0), 0);
    let rows = [];

    if (spendBusinessActive === 'TODOS') {
      rows = negocios
        .map(negocio => ({
          concepto: negocio.nombre,
          detalle: negocio.clave === 'transportadora' && negocio.subnegocios?.length
            ? negocio.subnegocios.map(sub => `${sub.nombre}: ${formatMoney(sub.total || 0)}`).join(' · ')
            : businessDetailLabel(negocio),
          registros: negocio.registros,
          total: negocio.total,
          porcentaje: percent(negocio.total, totalPeriodo)
        }))
        .sort((a, b) => Number(b.total || 0) - Number(a.total || 0));
    } else {
      const negocio = negocios.find(item => item.clave === spendBusinessActive);
      titulo = negocio?.nombre || 'Negocio';
      meta = negocio ? businessDetailLabel(negocio) : 'Sin información para este filtro.';
      totalTabla = Number(negocio?.total || 0);
      registrosTabla = Number(negocio?.registros || 0);

      if (negocio?.clave === 'transportadora' && negocio.subnegocios?.length) {
        rows = negocio.subnegocios
          .map(subnegocio => ({
            concepto: subnegocio.nombre,
            detalle: [
              ...(subnegocio.sedes || []).slice(0, 3).map(sede => `${sede.nombre}: ${formatMoney(sede.total || 0)}`),
              ...(subnegocio.rubros || []).slice(0, 3).map(rubro => `${rubro.nombre}: ${formatMoney(rubro.total || 0)}`)
            ].slice(0, 5).join(' · ') || 'Sin detalle registrado',
            registros: subnegocio.registros,
            total: subnegocio.total,
            porcentaje: percent(subnegocio.total, totalTabla)
          }))
          .sort((a, b) => Number(b.total || 0) - Number(a.total || 0));
      } else {
        rows = (negocio?.rubros || [])
          .map(rubro => ({
            concepto: rubro.nombre,
            detalle: (rubro.sedes || []).slice(0, 4).map(sede => `${sede.nombre}: ${formatMoney(sede.total || 0)}`).join(' · ') || 'Sin sedes registradas',
            registros: rubro.registros,
            total: rubro.total,
            porcentaje: percent(rubro.total, totalTabla)
          }))
          .sort((a, b) => Number(b.total || 0) - Number(a.total || 0));
      }
    }

    summary.innerHTML = `
      <div>
        <div class="spend-summary-title">${escapeHtml(titulo)}</div>
        <div class="spend-summary-meta">${formatNumber(registrosTabla)} movimiento(s) · ${escapeHtml(meta)}</div>
      </div>
      <div class="spend-summary-money">${formatMoney(totalTabla)}</div>
    `;

    rowsBody.innerHTML = rows.length ? rows.map(row => `
      <tr>
        <td>
          <div class="spend-concept">${escapeHtml(row.concepto || '-')}</div>
        </td>
        <td><div class="spend-detail">${escapeHtml(row.detalle || '-')}</div></td>
        <td class="text-end"><span class="pill pill-soft">${formatNumber(row.registros || 0)}</span></td>
        <td class="text-end money">${formatMoney(row.total || 0)}</td>
        <td class="text-end">${formatNumber(row.porcentaje || 0)}%</td>
      </tr>
    `).join('') : '<tr><td colspan="5" class="empty-state">No hay gasto para este negocio con los filtros seleccionados.</td></tr>';

    foot.innerHTML = `
      <tr class="spend-total-row">
        <td colspan="2">Total visible</td>
        <td class="text-end">${formatNumber(registrosTabla)}</td>
        <td class="text-end money">${formatMoney(totalTabla)}</td>
        <td class="text-end">100%</td>
      </tr>
    `;
  };

  const renderManagerGrid = (data) => {
    const grid = document.getElementById('managerGrid');
    if (!grid) return;

    const categorias = (data.categorias || []).filter(item => !isHiddenCategory(item.nombre));
    const negocios = (data.negociosGasto || []).filter(item => Number(item.total || 0) > 0);
    const rubrosPorNegocio = (data.rubrosPorNegocio || []).map(negocio => ({
      ...negocio,
      rubros: (negocio.rubros || []).filter(item => !isHiddenCategory(item.nombre))
    })).filter(negocio => Number(negocio.total || 0) > 0 || (negocio.rubros || []).length);
    const mantenimientosPorSedeRubro = (data.mantenimientosPorSedeRubro || []).map(sede => ({
      ...sede,
      rubros: (sede.rubros || []).filter(item => !isHiddenCategory(item.nombre))
    })).filter(sede => Number(sede.total || 0) > 0 && (sede.rubros || []).length);
    const totalGastos = Number(data.totalGastos || 0);
    const totalCategorias = categorias.reduce((sum, item) => sum + Number(item.total || 0), 0);

    const keyOf = (value) => String(value || '-').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    const mergePlacas = (targetMap, placas = []) => {
      placas.forEach(placa => {
        const nombre = placa.nombre || '-';
        const key = keyOf(nombre);
        const actual = targetMap.get(key) || {
          nombre,
          sede: placa.sede || '',
          total: 0,
          registros: 0
        };
        actual.total += Number(placa.total || 0);
        actual.registros += Number(placa.registros || 0);
        if (!actual.sede && placa.sede) actual.sede = placa.sede;
        targetMap.set(key, actual);
      });
    };

    const rubrosConSedesMap = new Map();
    rubrosPorNegocio.forEach(negocio => {
      (negocio.rubros || []).forEach(rubro => {
        const rubroKey = keyOf(rubro.nombre);
        const actualRubro = rubrosConSedesMap.get(rubroKey) || {
          nombre: rubro.nombre || '-',
          color: rubro.color || negocio.color || '#0b3b82',
          total: 0,
          registros: 0,
          sedes: new Map()
        };
        actualRubro.total += Number(rubro.total || 0);
        actualRubro.registros += Number(rubro.registros || 0);

        (rubro.sedes || []).forEach(sede => {
          const sedeKey = keyOf(sede.nombre);
          const actualSede = actualRubro.sedes.get(sedeKey) || {
            nombre: sede.nombre || '-',
            total: 0,
            registros: 0,
            placas: new Map()
          };
          actualSede.total += Number(sede.total || 0);
          actualSede.registros += Number(sede.registros || 0);
          mergePlacas(actualSede.placas, sede.placas || []);
          actualRubro.sedes.set(sedeKey, actualSede);
        });

        if (!(rubro.sedes || []).length && (rubro.placas || []).length) {
          const sedeGeneral = actualRubro.sedes.get('todas-las-sedes') || {
            nombre: 'Todas las sedes',
            total: 0,
            registros: 0,
            placas: new Map()
          };
          sedeGeneral.total += Number(rubro.total || 0);
          sedeGeneral.registros += Number(rubro.registros || 0);
          mergePlacas(sedeGeneral.placas, rubro.placas || []);
          actualRubro.sedes.set('todas-las-sedes', sedeGeneral);
        }

        rubrosConSedesMap.set(rubroKey, actualRubro);
      });
    });

    const rubrosConSedes = categorias
      .map(categoria => {
        const agregado = rubrosConSedesMap.get(keyOf(categoria.nombre));
        const totalRubro = Number(agregado?.total || categoria.total || 0);
        const sedes = Array.from((agregado?.sedes || new Map()).values())
          .map(sede => {
            const totalSede = Number(sede.total || 0);
            return {
              ...sede,
              porcentaje: totalRubro ? Math.round((totalSede / totalRubro) * 100) : 0,
              placas: Array.from((sede.placas || new Map()).values())
                .map(placa => ({
                  ...placa,
                  porcentaje: totalSede ? Math.round((Number(placa.total || 0) / totalSede) * 100) : 0
                }))
                .sort((a, b) => Number(b.total || 0) - Number(a.total || 0))
                .slice(0, 15)
            };
          })
          .sort((a, b) => Number(b.total || 0) - Number(a.total || 0))
          .slice(0, 12);
        return {
          ...categoria,
          total: totalRubro,
          registros: Number(agregado?.registros || categoria.registros || 0),
          color: categoria.color || agregado?.color,
          sedes
        };
      })
      .filter(rubro => Number(rubro.total || 0) > 0);

    const managerRow = (item, total, metaLabel = 'movimiento(s)') => `
      <div class="manager-row">
        <div>
          <div class="manager-name">${escapeHtml(item.nombre || '-')}</div>
          <div class="manager-meta">${formatNumber(item.registros || 0)} ${metaLabel} · ${percent(item.total, total)}% del gasto</div>
          <div class="manager-bar" style="--bar-color:${escapeHtml(item.color || '#0b3b82')}"><span style="width:${Math.max(4, percent(item.total, total))}%"></span></div>
        </div>
        <div class="manager-amount">${formatMoney(item.total || 0)}</div>
      </div>
    `;

    const managerRubroGeneralRow = (item, index) => {
      const rubroKey = `${index}:${keyOf(item.nombre)}`;
      const open = managerState.rubroGeneral[rubroKey];
      return `
        <div class="manager-row-wrap">
          <button type="button" class="manager-row ${open ? 'active' : ''}" data-manager-rubro-general="${escapeHtml(rubroKey)}">
            <div>
              <div class="manager-name">${escapeHtml(item.nombre || '-')}</div>
              <div class="manager-meta">${formatNumber(item.registros || 0)} movimiento(s) · ${percent(item.total, totalCategorias)}% del gasto operativo · tocar para ver sedes</div>
              <div class="manager-bar" style="--bar-color:${escapeHtml(item.color || '#0b3b82')}"><span style="width:${Math.max(4, percent(item.total, totalCategorias))}%"></span></div>
            </div>
            <div class="manager-amount">${formatMoney(item.total || 0)}</div>
          </button>
          ${open ? renderSedesRubroGeneral(rubroKey, item.sedes || []) : ''}
        </div>
      `;
    };

    const renderPlateRows = (placas = []) => {
      if (!placas.length) return '<div class="empty-state py-2">No hay placas para esta sede.</div>';

      return `
        <div class="matrix-plate-list">
          ${placas.map(placa => `
            <div class="matrix-plate-row">
              <span class="matrix-plate-name">${escapeHtml(placa.nombre || '-')}</span>
              <span class="matrix-line-money">${formatMoney(placa.total || 0)}</span>
              <span class="matrix-line-pct">${formatNumber(placa.porcentaje || 0)}%</span>
            </div>
          `).join('')}
        </div>
      `;
    };

    const renderSedesRubroGeneral = (rubroKey, sedes = []) => {
      if (!sedes.length) return '<div class="matrix-nested"><div class="empty-state py-2">No hay sedes para este rubro.</div></div>';

      return `
        <div class="matrix-nested">
          ${sedes.map((sede, sedeIndex) => {
            const sedeKey = `${rubroKey}:${sedeIndex}:${keyOf(sede.nombre)}`;
            const open = managerState.sedeGeneral[sedeKey];
            return `
              <button type="button" class="matrix-line matrix-line-sede ${open ? 'active' : ''}" data-manager-sede-general="${escapeHtml(sedeKey)}">
                <span class="matrix-line-name">${escapeHtml(sede.nombre || '-')}</span>
                <span class="matrix-line-money">${formatMoney(sede.total || 0)}</span>
                <span class="matrix-line-pct">${formatNumber(sede.porcentaje || 0)}%</span>
              </button>
              ${open ? renderPlateRows(sede.placas || []) : ''}
            `;
          }).join('')}
        </div>
      `;
    };

    const renderSedesRubro = (negocioIndex, rubroIndex, sedes = []) => {
      if (!sedes.length) return '<div class="matrix-nested"><div class="empty-state py-2">No hay sedes para este rubro.</div></div>';

      return `
        <div class="matrix-nested">
          ${sedes.map((sede, sedeIndex) => {
            const sedeKey = `${negocioIndex}:${rubroIndex}:${sedeIndex}`;
            const open = managerState.sede[sedeKey];
            return `
              <button type="button" class="matrix-line matrix-line-sede ${open ? 'active' : ''}" data-manager-sede="${sedeKey}">
                <span class="matrix-line-name">${escapeHtml(sede.nombre || '-')}</span>
                <span class="matrix-line-money">${formatMoney(sede.total || 0)}</span>
                <span class="matrix-line-pct">${formatNumber(sede.porcentaje || 0)}%</span>
              </button>
              ${open ? renderPlateRows(sede.placas || []) : ''}
            `;
          }).join('')}
        </div>
      `;
    };

    const managerRubroBlock = (negocio, negocioIndex) => `
      <div class="matrix-block" style="--matrix-color:${escapeHtml(negocio.color || '#0b3b82')}">
        <div class="matrix-title">
          <span>${escapeHtml(negocio.nombre || '-')}</span>
          <span>${formatMoney(negocio.total || 0)}</span>
        </div>
        <div class="matrix-lines">
          ${(negocio.rubros || []).length ? (negocio.rubros || []).slice(0, 7).map((rubro, rubroIndex) => {
            const rubroKey = `${negocioIndex}:${rubroIndex}`;
            const open = managerState.rubro[rubroKey];
            return `
              <button type="button" class="matrix-line ${open ? 'active' : ''}" data-manager-rubro="${rubroKey}">
                <span class="matrix-line-name">${escapeHtml(rubro.nombre || '-')}</span>
                <span class="matrix-line-money">${formatMoney(rubro.total || 0)}</span>
                <span class="matrix-line-pct">${formatNumber(rubro.porcentaje || 0)}%</span>
              </button>
              ${open ? renderSedesRubro(negocioIndex, rubroIndex, rubro.sedes || []) : ''}
            `;
          }).join('') : '<div class="empty-state py-2">Sin movimiento.</div>'}
        </div>
      </div>
    `;

    const renderMovimientoRows = (movimientos = []) => {
      if (!movimientos.length) return '<div class="empty-state py-2">No hay detalle para esta placa.</div>';

      return movimientos.map(mov => `
        <div class="movimiento-row">
          <div>
            <div class="movimiento-title">${escapeHtml(mov.fuente_nombre || 'Movimiento')}${mov.po_numero && mov.po_numero !== '-' ? ` · ${escapeHtml(mov.po_numero)}` : ''}</div>
            <div class="movimiento-meta">${escapeHtml(formatDate(mov.fecha))} · ${escapeHtml(mov.proveedor || '-')}</div>
          </div>
          <div class="movimiento-desc">${escapeHtml(mov.descripcion || mov.observaciones || '-')}</div>
          <div class="movimiento-actions">
            <span class="matrix-line-money">${formatMoney(mov.monto || 0)}</span>
            ${mov.url ? `<a class="movimiento-link" href="${escapeHtml(mov.url)}">Abrir</a>` : ''}
          </div>
        </div>
      `).join('');
    };

    const renderSedeMantenimientoBlock = (sede) => `
      <div class="matrix-block" style="--matrix-color:#0b3b82">
        <div class="matrix-title">
          <span>${escapeHtml(sede.nombre || '-')}</span>
          <span>${formatMoney(sede.total || 0)}</span>
        </div>
        <div class="matrix-lines">
          ${(sede.rubros || []).length ? (sede.rubros || []).map(rubro => `
            <details class="matrix-detail">
              <summary class="matrix-line">
                <span class="matrix-line-name">${escapeHtml(rubro.nombre || '-')}</span>
                <span class="matrix-line-money">${formatMoney(rubro.total || 0)}</span>
                <span class="matrix-line-pct">${formatNumber(rubro.porcentaje || 0)}%</span>
              </summary>
              <div class="matrix-plate-list">
                ${(rubro.placas || []).length ? (rubro.placas || []).map(placa => `
                  <details class="matrix-plate-detail">
                    <summary class="matrix-plate-row">
                      <span class="matrix-plate-name">
                        ${escapeHtml(placa.nombre || '-')}
                        <span class="matrix-plate-meta">${escapeHtml(placa.sede || '-')} · ${formatNumber(placa.registros || 0)} mov.</span>
                      </span>
                      <span class="matrix-line-money">${formatMoney(placa.total || 0)}</span>
                      <span class="matrix-line-pct">${formatNumber(placa.porcentaje || 0)}%</span>
                    </summary>
                    <div class="matrix-movement-list">${renderMovimientoRows(placa.movimientos || [])}</div>
                  </details>
                `).join('') : '<div class="empty-state py-2">No hay placas para este rubro.</div>'}
              </div>
            </details>
          `).join('') : '<div class="empty-state py-2">Sin movimiento.</div>'}
        </div>
      </div>
    `;

    grid.innerHTML = `
      <article class="manager-card">
        <div class="manager-head">
          <div>
            <h2 class="manager-title">General por negocio</h2>
            <div class="manager-subtitle">Total gasto del mes: crédito, contado, pagos y caja chica.</div>
          </div>
          <span class="pill pill-blue">${formatMoney(totalGastos)}</span>
        </div>
        <div class="manager-body">
          ${negocios.length ? negocios.map(item => managerRow(item, totalGastos)).join('') : '<div class="empty-state">No hay gasto por negocio para este filtro.</div>'}
        </div>
      </article>
      <article class="manager-card">
        <div class="manager-head">
          <div>
            <h2 class="manager-title">Por rubro del mantenimiento</h2>
            <div class="manager-subtitle">Familias de gasto del periodo.</div>
          </div>
          <span class="pill pill-blue">${formatNumber(categorias.length)} rubros</span>
        </div>
        <div class="manager-body">
          ${rubrosConSedes.length ? rubrosConSedes.slice(0, 8).map((item, index) => managerRubroGeneralRow(item, index)).join('') : '<div class="empty-state">No hay rubros para este filtro.</div>'}
        </div>
      </article>
      <article class="manager-card manager-wide">
        <div class="manager-head">
          <div>
            <h2 class="manager-title">General por rubro del mantenimiento</h2>
            <div class="manager-subtitle">Cada negocio dividido por frenos, motor, llantas, eléctrico y demás rubros.</div>
          </div>
          <span class="pill pill-blue">Negocio -> rubro</span>
        </div>
        <div class="manager-body"><div class="manager-matrix">
          ${rubrosPorNegocio.length ? rubrosPorNegocio.map((negocio, negocioIndex) => managerRubroBlock(negocio, negocioIndex)).join('') : '<div class="empty-state">No hay datos por negocio para este filtro.</div>'}
        </div></div>
      </article>
      <article class="manager-card manager-wide">
        <div class="manager-head">
          <div>
            <h2 class="manager-title">Mantenimientos realizados por sede</h2>
            <div class="manager-subtitle">Abra una sede, luego un rubro; al tocar la placa verá de dónde salió el gasto.</div>
          </div>
          <span class="pill pill-blue">Sede -> rubro -> placa</span>
        </div>
        <div class="manager-body"><div class="manager-matrix">
          ${mantenimientosPorSedeRubro.length ? mantenimientosPorSedeRubro.map(renderSedeMantenimientoBlock).join('') : '<div class="empty-state">No hay sedes con gasto para este filtro.</div>'}
        </div></div>
      </article>
    `;

    grid.querySelectorAll('[data-manager-rubro]').forEach(button => {
      button.addEventListener('click', () => {
        const key = button.dataset.managerRubro;
        managerState.rubro[key] = !managerState.rubro[key];
        renderManagerGrid(data);
      });
    });

    grid.querySelectorAll('[data-manager-rubro-general]').forEach(button => {
      button.addEventListener('click', () => {
        const key = button.dataset.managerRubroGeneral;
        managerState.rubroGeneral[key] = !managerState.rubroGeneral[key];
        renderManagerGrid(data);
      });
    });

    grid.querySelectorAll('[data-manager-sede]').forEach(button => {
      button.addEventListener('click', () => {
        const key = button.dataset.managerSede;
        managerState.sede[key] = !managerState.sede[key];
        renderManagerGrid(data);
      });
    });

    grid.querySelectorAll('[data-manager-sede-general]').forEach(button => {
      button.addEventListener('click', () => {
        const key = button.dataset.managerSedeGeneral;
        managerState.sedeGeneral[key] = !managerState.sedeGeneral[key];
        renderManagerGrid(data);
      });
    });
  };

  const updateKpis = (data) => {
    const resumenFinanciero = data.resumenFinanciero || {};
    const costoUnidad = data.costoUnidad || {};
    const categorias = (data.categorias || []).filter(item => !isHiddenCategory(item.nombre));
    const totalCategorias = categorias.reduce((sum, item) => sum + Number(item.total || 0), 0);
    const familiasMant = (data.familiasMant || []).filter(item => !isHiddenCategory(item.nombre));
    const placas = data.placas || [];

    setText('kpiTotalGastado', formatMoney(data.totalGastos || 0));
    setText('kpiTotalGastadoFoot', `${formatNumber(data.totalRegistrosGasto || 0)} movimientos de dinero`);
    setText('kpiTotalPagado', formatMoney(resumenFinanciero.totalPagado || 0));
    setText('kpiMayorTipo', categorias[0]?.nombre || '-');
    setText('kpiMayorTipoFoot', `${formatMoney(categorias[0]?.total || 0)} · ${percent(categorias[0]?.total, totalCategorias)}% del gasto operativo`);
    setText('kpiCostoUnidad', formatMoney(costoUnidad.costoPromedioPorUnidad || 0));
    setText('kpiCostoUnidadFoot', `${formatNumber(costoUnidad.unidadesConGasto || 0)} placa(s) con gasto · ${formatNumber(costoUnidad.totalUnidadesFlota || 0)} en flota`);
    setText('kpiMantenimientos', formatNumber(data.totalMantenimientos || 0));
    setText('kpiMantenimientosFoot', `${familiasMant[0]?.nombre || '-'} es lo más repetido`);
    setText('kpiPlacaGasto', placas[0]?.nombre || '-');
    setText('kpiPlacaGastoFoot', `${formatMoney(placas[0]?.total || 0)} · ${placas[0]?.sede || '-'}`);
  };

  renderManagerGrid(resumenData || {});
  renderSpendBusinessTable(resumenData || {});

  const chartOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'bottom', labels: { usePointStyle: true, font: { weight: 'bold' } } },
      tooltip: { callbacks: { label: ctx => `${ctx.dataset.label || ctx.label}: ${formatMoney(ctx.raw)}` } }
    },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#334155', font: { weight: 'bold' } } },
      y: { beginAtZero: true, ticks: { callback: formatMoney, color: '#64748b' }, grid: { color: '#e5edf7' } }
    }
  };

  const renderChartMeses = () => {
    const canvas = document.getElementById('chartMeses');
    if (!canvas || !mesesData.length) return;
    if (chartMeses) {
      chartMeses.data.labels = mesesData.map(item => item.nombre);
      chartMeses.data.datasets[0].data = mesesData.map(item => Number(item.total || 0));
      chartMeses.update();
      return;
    }
    chartMeses = new Chart(canvas, {
      type: 'bar',
      data: {
        labels: mesesData.map(item => item.nombre),
        datasets: [{ label: 'Gasto', data: mesesData.map(item => Number(item.total || 0)), backgroundColor: '#0b3b82', borderRadius: 10 }]
      },
      options: chartOptions
    });
  };

  const renderChartCategorias = () => {
    const canvas = document.getElementById('chartCategorias');
    if (!canvas || !categoriasData.length) return;
    if (chartCategorias) {
      chartCategorias.data.labels = categoriasData.map(item => item.nombre);
      chartCategorias.data.datasets[0].data = categoriasData.map(item => Number(item.total || 0));
      chartCategorias.data.datasets[0].backgroundColor = categoriasData.map(item => item.color || '#64748b');
      chartCategorias.update();
      return;
    }
    chartCategorias = new Chart(canvas, {
      type: 'doughnut',
      data: {
        labels: categoriasData.map(item => item.nombre),
        datasets: [{ data: categoriasData.map(item => Number(item.total || 0)), backgroundColor: categoriasData.map(item => item.color || '#64748b'), borderWidth: 0 }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, font: { weight: 'bold' } } }, tooltip: { callbacks: { label: ctx => `${ctx.label}: ${formatMoney(ctx.raw)}` } } } }
    });
  };

  renderChartMeses();
  renderChartCategorias();

  (() => {
    const accordion = document.getElementById('negocioAccordion');
    if (!accordion) return;

    let negocioActivo = null;
    const sedeActivaPorNegocio = {};
    const subnegocioActivoPorNegocio = {};

    const porcentaje = (value, total) => total ? Math.round((Number(value || 0) / Number(total || 1)) * 100) : 0;
    const renderPlacas = (placas = []) => {
      if (!placas.length) return '<div class="business-empty">No hay placas para esta sede.</div>';

      return placas.map(placa => `
        <div class="placa-row">
          <div class="placa-main">
            <div class="placa-title">${escapeHtml(placa.nombre || '-')}</div>
            <div class="placa-meta">${Number(placa.registros || 0).toLocaleString('es-CR')} movimiento(s)</div>
          </div>
          <div class="placa-money">${formatMoney(placa.total || 0)}</div>
        </div>
      `).join('');
    };

    const renderCompras = (compras = []) => {
      if (!compras.length) return '<div class="business-empty">No hay compras generales para este filtro.</div>';

      return compras.map(compra => {
        const movimientos = Array.isArray(compra.movimientos) ? compra.movimientos : [];
        return `
          <details class="compra-row">
            <summary class="compra-summary">
              <div>
                <div class="compra-title">${escapeHtml(compra.nombre || '-')}</div>
                <div class="compra-meta">
                  ${formatNumber(compra.registros || 0)} movimiento(s) · ${escapeHtml(compra.categoria || 'Sin categoría')}
                  ${Number(compra.movimientos_total || 0) > movimientos.length ? ` · mostrando ${formatNumber(movimientos.length)} de ${formatNumber(compra.movimientos_total)}` : ''}
                </div>
              </div>
              <div class="placa-money">${formatMoney(compra.total || 0)}</div>
            </summary>
            <div class="compra-details">
              ${movimientos.length ? movimientos.map(mov => {
                const referencia = mov.po_numero && mov.po_numero !== '-' ? mov.po_numero : `${mov.fuente_nombre || 'Movimiento'} #${mov.id || '-'}`;
                return `
                  <div class="movimiento-row">
                    <div>
                      <div class="movimiento-title">${escapeHtml(referencia)}</div>
                      <div class="movimiento-meta">${escapeHtml(mov.fuente_nombre || 'Movimiento')} · ${formatDate(mov.fecha)}</div>
                      <div class="movimiento-meta">Placa actual: ${escapeHtml(mov.placa || 'GENERAL')} · ${escapeHtml(mov.sede || 'Sin sede asignada')}</div>
                    </div>
                    <div>
                      <div class="movimiento-title">${escapeHtml(mov.proveedor || 'No registrado')}</div>
                      <div class="movimiento-desc">${escapeHtml(mov.descripcion || mov.observaciones || '-')}</div>
                    </div>
                    <div class="movimiento-actions">
                      <div class="placa-money">${formatMoney(mov.monto || 0)}</div>
                      ${mov.url ? `<a class="movimiento-link" href="${escapeHtml(mov.url)}">Editar</a>` : ''}
                    </div>
                  </div>
                `;
              }).join('') : '<div class="business-empty py-2">No hay movimientos detallados para este grupo.</div>'}
            </div>
          </details>
        `;
      }).join('');
    };

    const renderSedes = (negocio, negocioIndex) => {
      const sedes = negocio.sedes || [];
      if (!sedes.length) return '<div class="business-empty">No hay sedes para este negocio.</div>';
      const sedeActiva = sedeActivaPorNegocio[negocioIndex];

      return sedes.map((sede, sedeIndex) => {
        const open = sedeActiva === sedeIndex;
        return `
          <div class="sede-node ${open ? 'open' : ''}">
            <button type="button" class="sede-toggle" data-negocio-index="${negocioIndex}" data-sede-index="${sedeIndex}">
              <div class="sede-main">
                <div class="sede-title">${escapeHtml(sede.nombre || '-')}</div>
                <div class="sede-meta">${Number(sede.registros || 0).toLocaleString('es-CR')} movimiento(s) · ${porcentaje(sede.total, negocio.total)}% del negocio</div>
              </div>
              <div class="sede-money">${formatMoney(sede.total || 0)}</div>
            </button>
            <div class="sede-body">${renderPlacas(sede.placas || [])}</div>
          </div>
        `;
      }).join('');
    };

    const renderSubnegociosTransportadora = (negocio, negocioIndex) => {
      const subnegocios = negocio.subnegocios || [];
      if (!subnegocios.length) return renderSedes(negocio, negocioIndex);
      const subActivo = subnegocioActivoPorNegocio[negocioIndex] ?? 0;

      return subnegocios.map((subnegocio, subIndex) => {
        const open = subActivo === subIndex;
        const sedeKey = `${negocioIndex}-${subIndex}`;
        if (open && sedeActivaPorNegocio[sedeKey] === undefined) sedeActivaPorNegocio[sedeKey] = 0;
        const detalle = (subnegocio.sedes || [])
          .slice(0, 3)
          .map(sede => `${sede.nombre}: ${formatMoney(sede.total || 0)}`)
          .join(' · ');

        return `
          <div class="sede-node ${open ? 'open' : ''}">
            <button type="button" class="sede-toggle subnegocio-toggle" data-negocio-index="${negocioIndex}" data-subnegocio-index="${subIndex}">
              <div class="sede-main">
                <div class="sede-title">${escapeHtml(subnegocio.nombre || '-')}</div>
                <div class="sede-meta">${Number(subnegocio.registros || 0).toLocaleString('es-CR')} movimiento(s) · ${porcentaje(subnegocio.total, negocio.total)}% de Transportadora${detalle ? ` · ${escapeHtml(detalle)}` : ''}</div>
              </div>
              <div class="sede-money">${formatMoney(subnegocio.total || 0)}</div>
            </button>
            <div class="sede-body">${renderSedes({ sedes: subnegocio.sedes || [], total: subnegocio.total || 0 }, sedeKey)}</div>
          </div>
        `;
      }).join('');
    };

    const renderAccordion = () => {
      const totalPeriodo = negociosData.reduce((sum, item) => sum + Number(item.total || 0), 0);
      if (!negociosData.length) {
        accordion.innerHTML = '<div class="business-empty">No hay gasto por negocio para este filtro.</div>';
        return;
      }

      accordion.innerHTML = negociosData.map((negocio, negocioIndex) => {
        const open = negocioActivo === negocioIndex;
        return `
          <article class="business-node ${open ? 'open' : ''}" style="--business-color:${negocio.color || '#0b3b82'}">
            <button type="button" class="business-toggle" data-negocio-index="${negocioIndex}">
              <div class="business-main">
                <div class="business-title">${escapeHtml(negocio.nombre || '-')}</div>
                <div class="business-meta">${Number(negocio.registros || 0).toLocaleString('es-CR')} movimiento(s) · ${porcentaje(negocio.total, totalPeriodo)}% del periodo</div>
              </div>
              <div class="business-money">${formatMoney(negocio.total || 0)}</div>
            </button>
            <div class="business-body">${
              ['generales', 'aceites'].includes(negocio.clave)
                ? renderCompras(negocio.compras || [])
                : negocio.clave === 'transportadora'
                ? renderSubnegociosTransportadora(negocio, negocioIndex)
                : renderSedes(negocio, negocioIndex)
            }</div>
          </article>
        `;
      }).join('');

      accordion.querySelectorAll('.business-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = Number(btn.dataset.negocioIndex || 0);
          negocioActivo = negocioActivo === index ? null : index;
          if (negocioActivo !== null && sedeActivaPorNegocio[negocioActivo] === undefined) {
            sedeActivaPorNegocio[negocioActivo] = 0;
          }
          renderAccordion();
        });
      });

      accordion.querySelectorAll('.sede-toggle').forEach(btn => {
        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          if (btn.classList.contains('subnegocio-toggle')) return;
          const negocioIndex = btn.dataset.negocioIndex || '0';
          const sedeIndex = Number(btn.dataset.sedeIndex || 0);
          sedeActivaPorNegocio[negocioIndex] = sedeActivaPorNegocio[negocioIndex] === sedeIndex ? null : sedeIndex;
          renderAccordion();
        });
      });

      accordion.querySelectorAll('.subnegocio-toggle').forEach(btn => {
        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          const negocioIndex = Number(btn.dataset.negocioIndex || 0);
          const subIndex = Number(btn.dataset.subnegocioIndex || 0);
          subnegocioActivoPorNegocio[negocioIndex] = subnegocioActivoPorNegocio[negocioIndex] === subIndex ? null : subIndex;
          if (subnegocioActivoPorNegocio[negocioIndex] !== null && sedeActivaPorNegocio[`${negocioIndex}-${subIndex}`] === undefined) {
            sedeActivaPorNegocio[`${negocioIndex}-${subIndex}`] = 0;
          }
          renderAccordion();
        });
      });
    };

    renderAccordion();
    window.renderNegocioAccordion = (nextData) => {
      negociosData = Array.isArray(nextData) ? nextData : [];
      if (negocioActivo !== null && !negociosData[negocioActivo]) negocioActivo = null;
      renderAccordion();
    };
  })();

  const renderChartMantenimientos = () => {
    const canvas = document.getElementById('chartMantenimientos');
    if (!canvas || !mantenimientosData.length) return;
    if (chartMantenimientos) {
      chartMantenimientos.data.labels = mantenimientosData.map(item => item.nombre);
      chartMantenimientos.data.datasets[0].data = mantenimientosData.map(item => Number(item.registros || 0));
      chartMantenimientos.data.datasets[0].backgroundColor = mantenimientosData.map(item => item.color || '#0b3b82');
      chartMantenimientos.update();
      return;
    }
    chartMantenimientos = new Chart(canvas, {
      type: 'bar',
      data: {
        labels: mantenimientosData.map(item => item.nombre),
        datasets: [{ label: 'Registros', data: mantenimientosData.map(item => Number(item.registros || 0)), backgroundColor: mantenimientosData.map(item => item.color || '#0b3b82'), borderRadius: 10 }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { color: '#334155', font: { weight: 'bold' } } },
          y: { beginAtZero: true, ticks: { precision: 0, color: '#64748b' }, grid: { color: '#e5edf7' } }
        }
      }
    });
  };

  renderChartMantenimientos();

  (() => {
    const tabs = Array.from(document.querySelectorAll('[data-detail-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-detail-panel]'));
    if (!tabs.length || !panels.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.detailTab;
        tabs.forEach(item => item.classList.toggle('active', item === tab));
        panels.forEach(panel => panel.classList.toggle('active', panel.dataset.detailPanel === target));
      });
    });
  })();

  (() => {
    document.getElementById('printExecutive')?.addEventListener('click', () => window.print());

    const refreshSeconds = 60;
    const counter = document.getElementById('refreshCountdown');
    let remaining = refreshSeconds;
    let editing = false;
    let refreshing = false;

    const setEditing = (value) => {
      editing = value;
      remaining = refreshSeconds;
      if (counter) counter.textContent = String(remaining);
    };

    document.querySelectorAll('input, select, textarea').forEach(control => {
      control.addEventListener('focus', () => setEditing(true));
      control.addEventListener('blur', () => setEditing(false));
      control.addEventListener('change', () => setEditing(false));
    });

    const buildDataUrl = () => {
      const url = new URL(window.location.href);
      url.pathname = '/dashboard/resumen-ejecutivo/datos';
      return url;
    };

    const softRefresh = async () => {
      if (refreshing) return;
      refreshing = true;
      try {
        const response = await fetch(buildDataUrl(), {
          headers: { Accept: 'application/json' },
          cache: 'no-store'
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        if (!payload.ok || !payload.resumen) throw new Error(payload.message || 'Respuesta inválida');

        const next = payload.resumen;
        resumenData = next;
        categoriasData = (next.categorias || []).filter(item => !isHiddenCategory(item.nombre));
        mesesData = next.meses || [];
        mantenimientosData = (next.familiasMant || []).filter(item => !isHiddenCategory(item.nombre));
        negociosData = next.negociosGasto || [];

        updateKpis(next);
        renderManagerGrid(next);
        renderSpendBusinessTable(next);
        if (typeof window.renderNegocioAccordion === 'function') {
          window.renderNegocioAccordion(negociosData);
        }
        renderChartMeses();
        renderChartCategorias();
        renderChartMantenimientos();
        if (payload.actualizado) setText('lastUpdated', payload.actualizado);
      } catch (error) {
        console.warn('No se pudo actualizar resumen ejecutivo sin recargar:', error.message);
      } finally {
        refreshing = false;
        remaining = refreshSeconds;
        if (counter) counter.textContent = String(remaining);
      }
    };

    window.setInterval(() => {
      if (document.hidden || editing) return;
      remaining -= 1;
      if (counter) counter.textContent = String(Math.max(remaining, 0));
      if (remaining <= 0) softRefresh();
    }, 1000);
  })();
</script>
</body>
</html>
