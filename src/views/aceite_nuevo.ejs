<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Cambio de Aceite</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza | Nuevo Cambio de Aceite</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/aceite" class="btn btn-secondary btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">

  <div class="card p-3">
    <form method="POST" action="/aceite">

      <label class="form-label">Placa</label>
      <select name="unidad_id" class="form-select" required>
        <% unidades.forEach(u => { %>
          <option value="<%= u.id %>"><%= u.placa %></option>
        <% }) %>
      </select>

      <label class="form-label mt-3">KM actual</label>
      <input type="number" name="km_actual" class="form-control" required>

      <label class="form-label mt-3">Galones de aceite</label>
      <input type="number" step="0.01" name="galones" class="form-control" required>

      <label class="form-label mt-3">Próximo cambio (KM)</label>
      <input type="number" name="proximo_km" class="form-control" required>

      <label class="form-label mt-3">Observaciones</label>
      <textarea name="observaciones" class="form-control" rows="3"></textarea>

      <button class="btn btn-success mt-3">Guardar</button>

    </form>
  </div>

</div>
</body>
</html>
