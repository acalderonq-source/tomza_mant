<section class="erp-launchpad">
<div class="erp-welcome"><div><div class="erp-eyebrow">FINANZAS / CONTABILIDAD</div><h2>Centro de trabajo</h2><p>Consultá la información de tus empresas y gestioná cada operación desde su módulo.</p></div><label class="erp-search">Buscar módulo<input type="search" id="erp-module-search" placeholder="Nombre del módulo…" autocomplete="off"></label></div>
<% const grupos=[
['Visión financiera','Presupuesto y documentos de respaldo',[
['/contabilidad/presupuestos/resumen-ejecutivo','Resumen ejecutivo','Indicadores, empresas, rubros y evolución del presupuesto.','bi-speedometer2'],
['/contabilidad/presupuestos','Presupuesto y ejecución','Comparar presupuesto, compromisos y ejecución.','bi-bar-chart'],
['/contabilidad/documentos?tipo=orden','Todas las órdenes','Consultar órdenes de Taller, Proveeduría, Carburación y motor.','bi-cart-check'],
['/contabilidad/documentos?tipo=factura','Todas las facturas','Consultar documentos, pagos y vencimientos de todas las fuentes.','bi-receipt'],
['/contabilidad/documentos','Cuentas por pagar','Saldos pendientes por moneda y exportación consolidada.','bi-journal-check'],
['/proveeduria/portal-proveedores/facturas','Revisión del portal','Aprobar o devolver facturas del portal y verificar Hacienda y órdenes.','bi-receipt-cutoff'],
['/compras/facturas/asientos','Asientos de pasivos','Preparar asientos y consultar el historial.','bi-journal-check'],
['/contabilidad/documentos/descargas-pdf','Descargas PDF y XML','Descargar facturas PDF y XML del correo Outlook por período.','bi-file-earmark-pdf']]]];
grupos.forEach(([titulo,subtitulo,items])=>{ %><section class="erp-module-group"><div class="erp-group-heading"><h3><%= titulo %></h3><span><%= subtitulo %></span></div><div class="erp-tiles"><% items.forEach(([url,nombre,descripcion,icono])=>{ %><a class="erp-tile" href="<%= url.startsWith('/')?url:'/contabilidad/presupuestos/modulos/'+url %>"><i class="bi <%= icono %>" aria-hidden="true"></i><div><h4><%= nombre %></h4><p><%= descripcion %></p></div><span class="erp-tile-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% }) %>
<p id="erp-search-empty" hidden>No hay módulos con ese nombre.</p></section>
