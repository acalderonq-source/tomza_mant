  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
      --red: #dc2626;
      --blue: #2563eb;
      --green: #16a34a;
      --amber: #d97706;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .92rem;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid var(--red);
    }

    .brand-box {
      align-items: center;
      background: #fff;
      border-radius: 8px;
      color: var(--red);
      display: inline-flex;
      height: 32px;
      justify-content: center;
      margin-right: .45rem;
      width: 32px;
    }

    .shell {
      max-width: 1540px;
    }

    .simple-hero {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: .7rem .85rem;
    }

    .page-title {
      font-size: 1.2rem;
      font-weight: 900;
      margin: 0;
    }

    .page-subtitle,
    .small-muted {
      color: var(--muted);
    }

    .section-title {
      font-size: .9rem;
      font-weight: 900;
      margin: 0 0 .45rem;
    }

    .sede-selector {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }

    .sede-selector .btn {
      border-radius: 999px;
      font-size: .8rem;
      font-weight: 750;
    }

    .summary-grid {
      display: grid;
      gap: .55rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .summary-card,
    .module-card,
    .plain-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .summary-card {
      padding: .65rem .75rem;
    }

    .summary-label {
      color: var(--muted);
      font-size: .68rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .summary-value {
      font-size: 1.35rem;
      font-weight: 900;
      line-height: 1.1;
      margin-top: .1rem;
    }

    .summary-foot {
      color: var(--muted);
      font-size: .74rem;
      margin-top: .15rem;
    }

    .module-grid {
      display: grid;
      gap: .55rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .module-card {
      color: var(--ink);
      display: flex;
      gap: .55rem;
      min-height: 66px;
      padding: .65rem;
      text-decoration: none;
      transition: border-color .12s ease, transform .12s ease;
    }

    .module-card:hover {
      border-color: #94a3b8;
      color: var(--ink);
      transform: translateY(-1px);
    }

    .module-icon {
      align-items: center;
      border-radius: 10px;
      display: inline-flex;
      flex: 0 0 34px;
      font-size: 1rem;
      height: 34px;
      justify-content: center;
      width: 34px;
    }

    .icon-blue { background: #dbeafe; color: #1d4ed8; }
    .icon-green { background: #dcfce7; color: #166534; }
    .icon-amber { background: #fef3c7; color: #92400e; }
    .icon-red { background: #fee2e2; color: #991b1b; }
    .icon-dark { background: #e5e7eb; color: #111827; }

    .module-title {
      font-size: .9rem;
      font-weight: 900;
    }

    .module-copy {
      color: var(--muted);
      font-size: .74rem;
      line-height: 1.2;
      margin: .1rem 0 0;
    }

    .top-info-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: 1fr;
    }

    .priority-panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      min-height: 100%;
      padding: .75rem;
    }

    .priority-list {
      display: grid;
      gap: .45rem;
      max-height: 245px;
      overflow: auto;
      padding-right: .15rem;
    }

    .priority-item {
      align-items: start;
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-left: 5px solid var(--red);
      border-radius: 9px;
      display: grid;
      gap: .4rem;
      grid-template-columns: 110px minmax(0, 1fr) auto;
      padding: .5rem .6rem;
    }

    .priority-plate {
      color: #111827;
      font-size: .95rem;
      font-weight: 900;
      line-height: 1.1;
    }

    .priority-note {
      color: #1f2937;
      font-size: .82rem;
      line-height: 1.25;
    }

    .priority-meta {
      color: var(--muted);
      font-size: .7rem;
      white-space: nowrap;
    }

    .table thead th {
      background: #f8fafc;
      color: #475569;
      font-size: .68rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .table-sm {
      font-size: .82rem;
    }

    .empty-state {
      color: var(--muted);
      font-weight: 700;
      padding: .8rem;
      text-align: center;
    }

    @media (max-width: 1180px) {
      .module-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 960px) {
      .summary-grid,
      .module-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .summary-grid,
      .module-grid,
      .top-info-grid {
        grid-template-columns: 1fr;
      }
      .priority-item {
        grid-template-columns: 1fr;
      }
    }

    .plan-red {
      color: #dc2626;
      font-weight: 900;
    }
  </style>
