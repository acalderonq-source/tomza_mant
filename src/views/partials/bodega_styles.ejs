  <style>
    :root {
      --navy: #0b1733;
      --blue: #123f86;
      --red: #dc2626;
      --green: #16a34a;
      --amber: #d97706;
      --line: #d7e2f0;
      --bg: #edf2f8;
      --muted: #64748b;
      --soft: #f8fafc;
      --ink: #08172f;
    }

    body {
      background:
        linear-gradient(180deg, #eef3f9 0, #f7f9fc 340px),
        var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .9rem;
    }

    .topbar {
      background: var(--navy);
      border-bottom: 3px solid var(--red);
      box-shadow: 0 10px 26px rgba(8, 23, 47, .18);
    }

    .shell { max-width: 1580px; }

    .brand-mark {
      align-items: center;
      background: #fff;
      border-radius: 8px;
      color: var(--red);
      display: inline-flex;
      height: 32px;
      justify-content: center;
      margin-right: .5rem;
      width: 32px;
    }

    .hero {
      background: linear-gradient(135deg, #0d3777, #0b1733 70%);
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 10px;
      box-shadow: 0 16px 34px rgba(8, 23, 47, .18);
      color: #fff;
      overflow: hidden;
      padding: 1rem 1.1rem;
      position: relative;
    }

    .hero::after {
      background: linear-gradient(135deg, #f4b000, #e4262d);
      content: "";
      height: 160%;
      opacity: .95;
      position: absolute;
      right: 7%;
      top: -30%;
      transform: skewX(-18deg);
      width: 8rem;
    }

    .hero > * { position: relative; z-index: 1; }
    .page-kicker {
      color: #bfdbfe;
      font-size: .72rem;
      font-weight: 950;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .page-title { font-size: 1.5rem; font-weight: 950; letter-spacing: -.01em; margin: .1rem 0 0; }
    .page-copy { color: #dbeafe; margin: .15rem 0 0; max-width: 720px; }
    .page-chip {
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .2);
      border-radius: 999px;
      color: #fff;
      font-weight: 900;
      padding: .35rem .7rem;
      white-space: nowrap;
    }

    .kpi-grid {
      display: grid;
      gap: .7rem;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    }

    .kpi-card,
    .panel {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    }

    .kpi-card {
      border-top: 4px solid var(--blue);
      display: grid;
      gap: .45rem;
      grid-template-columns: minmax(0, 1fr) 38px;
      padding: .9rem;
    }
    .kpi-card.is-warning { border-top-color: var(--amber); }
    .kpi-card.is-danger { border-top-color: var(--red); }
    .kpi-card.is-success { border-top-color: var(--green); }
    .kpi-label { color: #52627a; font-size: .68rem; font-weight: 950; letter-spacing: .04em; text-transform: uppercase; }
    .kpi-value { color: #061a40; font-size: 1.55rem; font-weight: 950; line-height: 1; margin-top: .2rem; }
    .kpi-note { color: var(--muted); font-size: .72rem; font-weight: 750; margin-top: .2rem; }
    .kpi-icon {
      align-items: center;
      background: #eff6ff;
      border-radius: 8px;
      color: var(--blue);
      display: inline-flex;
      font-size: 1.05rem;
      height: 38px;
      justify-content: center;
      width: 38px;
    }
    .panel-head {
      align-items: center;
      background: linear-gradient(180deg, #ffffff, #f8fafc);
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: .75rem;
      justify-content: space-between;
      padding: .8rem 1rem;
    }

    .panel-title { font-size: 1rem; font-weight: 950; margin: 0; }
    .panel-copy { color: var(--muted); font-size: .8rem; margin: .1rem 0 0; }
    .panel-body { padding: 1rem; }

    .quick-actions {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    }

    .quick-btn {
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 10px;
      color: var(--ink);
      display: flex;
      font-weight: 950;
      gap: .7rem;
      justify-content: flex-start;
      min-height: 4.6rem;
      padding: .75rem;
      text-decoration: none;
      transition: border-color .12s ease, box-shadow .12s ease, transform .12s ease;
    }

    .quick-btn:hover {
      border-color: #93a4bb;
      box-shadow: 0 12px 26px rgba(15, 23, 42, .08);
      color: var(--ink);
      transform: translateY(-1px);
    }

    .quick-btn i {
      align-items: center;
      border-radius: 999px;
      color: #fff;
      display: inline-flex;
      height: 2rem;
      justify-content: center;
      width: 2rem;
    }

    .quick-btn strong {
      display: block;
      line-height: 1.1;
    }

    .quick-btn small {
      color: var(--muted);
      display: block;
      font-weight: 750;
      line-height: 1.2;
      margin-top: .15rem;
    }

    .btn-blue i { background: var(--blue); }
    .btn-green i { background: var(--green); }
    .btn-amber i { background: var(--amber); }
    .btn-red i { background: var(--red); }
    .btn-darkx i { background: var(--navy); }

    .module-tabs {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
      padding: .45rem;
    }

    .module-tab {
      background: transparent;
      border: 1px solid transparent;
      border-radius: 8px;
      color: #0f274d;
      font-weight: 900;
      padding: .5rem .75rem;
      text-decoration: none;
    }

    .module-tab.active {
      background: var(--blue);
      border-color: var(--blue);
      color: #fff;
    }

    .form-card {
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: .85rem;
    }

    .form-label { color: #334155; font-size: .75rem; font-weight: 900; margin-bottom: .25rem; }
    .form-control, .form-select {
      border-color: #cbd8ea;
      border-radius: 8px;
      min-height: 2.35rem;
    }

    .articulo-picker {
      background: #fff;
      border: 1px solid #dbe6f3;
      border-radius: 10px;
      padding: .55rem;
    }

    .articulo-search-status {
      color: #64748b;
      font-size: .72rem;
      font-weight: 800;
      min-height: 1rem;
    }

    .placa-picker { position: relative; flex: 1 1 auto; min-width: 0; }
    .placa-picker > .form-control { width: 100%; }
    .input-group > .placa-picker .form-control { border-top-right-radius: 0; border-bottom-right-radius: 0; }
    .placa-options {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 6px;
      box-shadow: 0 12px 24px rgba(8, 23, 47, .16);
      left: 0;
      max-height: 250px;
      overflow-y: auto;
      position: absolute;
      right: 0;
      top: calc(100% + 3px);
      z-index: 30;
    }
    .placa-options[hidden] { display: none; }
    .placa-option {
      background: #fff;
      border: 0;
      border-bottom: 1px solid #e5edf7;
      color: var(--ink);
      display: block;
      padding: .5rem .65rem;
      text-align: left;
      width: 100%;
    }
    .placa-option:hover, .placa-option.active { background: #eef4ff; }
    .placa-option small { color: var(--muted); display: block; }
    .placa-empty { color: var(--muted); padding: .55rem .65rem; }

    .table-responsive {
      border-radius: 0 0 10px 10px;
    }

    .table-modern {
      margin: 0;
    }

    .table thead th {
      background: #f8fafc;
      border-bottom: 1px solid var(--line);
      color: #475569;
      font-size: .72rem;
      letter-spacing: .03em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .table td {
      border-color: #e5edf7;
      vertical-align: middle;
    }

    .table tbody tr:hover {
      background: #f8fbff;
    }

    .code-badge {
      background: #0b1733;
      border-radius: 6px;
      color: #fff;
      display: inline-flex;
      font-weight: 950;
      letter-spacing: .04em;
      min-width: 44px;
      padding: .22rem .4rem;
      justify-content: center;
    }

    .stock-badge {
      border-radius: 999px;
      display: inline-flex;
      font-size: .72rem;
      font-weight: 950;
      padding: .22rem .55rem;
      white-space: nowrap;
    }
    .stock-ok { background: #dcfce7; color: #166534; }
    .stock-low { background: #fef3c7; color: #92400e; }
    .stock-out { background: #fee2e2; color: #991b1b; }
    .stock-neutral { background: #eef2f7; color: #475569; }
    .pill { background: #eef4ff; border-radius: 999px; color: #1e3a8a; font-size: .72rem; font-weight: 900; padding: .2rem .5rem; }
    .pill-consignacion { background: #fff7ed; color: #9a3412; }
    .pill-propio { background: #dcfce7; color: #166534; }
    .money { font-variant-numeric: tabular-nums; font-weight: 850; }
    .muted { color: var(--muted); }
    .line-row {
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 10px;
      margin-bottom: .55rem;
      padding: .7rem;
    }

    .empty-row {
      color: var(--muted);
      font-weight: 800;
      padding: 1rem;
      text-align: center;
    }

    @media (max-width: 1100px) {
      .kpi-grid, .quick-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 700px) {
      .kpi-grid, .quick-actions { grid-template-columns: 1fr; }
      .hero::after { display: none; }
    }
  </style>
