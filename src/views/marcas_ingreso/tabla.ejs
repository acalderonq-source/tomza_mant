<% const formatoFecha=new Intl.DateTimeFormat('es-CR',{timeZone:'America/Costa_Rica',dateStyle:'short'}); const formatoHora=new Intl.DateTimeFormat('es-CR',{timeZone:'America/Costa_Rica',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}); %>
<% if(!historial.length){ %><p class="marcas-vacio">No hay marcas en esta vista.</p><% }else{ %><div class="marcas-tabla"><table><thead><tr><th>Fecha</th><th>Hora</th><th>Colaborador</th><th>Marca</th><th>Fotografía</th></tr></thead><tbody><% historial.forEach(m=>{ const fecha=new Date(m.fecha_utc); %><tr><td><%= formatoFecha.format(fecha) %></td><td><%= formatoHora.format(fecha) %></td><td><%= m.nombre %></td><td><span class="marca-tipo <%= m.tipo==='ENTRADA'?'entrada':'salida' %>"><%= m.tipo==='ENTRADA'?'Entrada':'Salida' %></span></td><td><a href="/marcas-ingreso/foto/<%= m.id %>" target="_blank" rel="noopener">Ver foto</a></td></tr><% }); %></tbody></table></div><% } %>
