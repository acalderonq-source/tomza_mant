<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agregar más - Correctivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
</head>
<body>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-plus-circle"></i> Agregar información</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos/correctivos" class="btn btn-outline-light btn-sm ms-2">Cancelar</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Agregar trabajos / repuestos</h1>
      <p class="page-subtitle">Correctivo de la unidad <strong><%= correctivo.placa %></strong>.</p>
    </div>
  </div>

  <div class="surface-card p-3 mb-3">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-label">Placa</div>
        <div class="detail-value"><%= correctivo.placa %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Trabajo principal registrado</div>
        <div class="detail-value"><%= correctivo.trabajo_realizado %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Pendiente</div>
        <div class="detail-value"><%= correctivo.pendiente || '—' %></div>
      </div>
    </div>
  </div>

  <div class="surface-card p-3 p-md-4">
    <form method="POST" action="/mantenimientos/correctivos/<%= correctivo.id %>/agregar">
      <h2 class="page-title fs-5 mb-3"><i class="bi bi-person-gear"></i> Información adicional</h2>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width: 90px;">Seleccionar</th>
              <th>Mecánico</th>
              <th>Trabajo adicional</th>
              <th>Repuestos adicionales</th>
            </tr>
          </thead>
          <tbody>
            <% mecanicosDisponibles.forEach(m => { %>
              <tr>
                <td class="text-center" data-label="Seleccionar">
                  <input type="checkbox" class="form-check-input" name="mecanicos[]" value="<%= m.id %>">
                </td>
                <td data-label="Mecánico"><strong><%= m.nombre %></strong></td>
                <td data-label="Trabajo adicional">
                  <textarea name="trabajos[<%= m.id %>]" class="form-control" rows="2" placeholder="Ej: Ajuste de frenos..."></textarea>
                </td>
                <td data-label="Repuestos adicionales">
                  <input type="text" name="repuestos[<%= m.id %>]" class="form-control" placeholder="Ej: Pastillas, tornillos...">
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar información adicional</button>
        <a href="/mantenimientos/correctivos" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
