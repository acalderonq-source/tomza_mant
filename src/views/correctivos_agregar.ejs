<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Agregar más - Correctivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @media (max-width: 768px) {
      .btn-sm { font-size: 0.8rem; }
      .table thead { display: none; }
      .table, .table tbody, .table tr, .table td {
        display: block;
        width: 100%;
      }
      .table tr {
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem;
        background: white;
      }
      .table td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border: none;
        border-bottom: 1px solid #eee;
      }
      .table td::before {
        content: attr(data-label);
        position: absolute;
        left: 1rem;
        width: 45%;
        font-weight: bold;
        text-align: left;
      }
    }
  </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza - Agregar más información</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos/correctivos" class="btn btn-secondary btn-sm ms-2">Cancelar</a>
  </div>
</nav>

<div class="container mt-4">
  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5>➕ Agregar más trabajos / repuestos</h5>
    </div>
    <div class="card-body">
      <p><strong>Placa:</strong> <%= correctivo.placa %></p>
      <p><strong>Trabajo principal ya registrado:</strong> <%= correctivo.trabajo_realizado %></p>
      <hr>

      <form method="POST" action="/mantenimientos/correctivos/<%= correctivo.id %>/agregar">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead class="table-dark">
              <tr>
                <th style="width: 30px;">✔</th>
                <th>Mecánico</th>
                <th>Trabajo adicional</th>
                <th>Repuestos adicionales</th>
              </tr>
            </thead>
            <tbody>
              <% mecanicosDisponibles.forEach(m => { %>
              <tr>
                <td class="text-center" data-label="Seleccionar">
                  <input type="checkbox" name="mecanicos[]" value="<%= m.id %>">
                </td>
                <td data-label="Mecánico"><strong><%= m.nombre %></strong></td>
                <td data-label="Trabajo adicional">
                  <textarea name="trabajos[<%= m.id %>]" class="form-control" rows="2" placeholder="Ej: Ajuste de frenos..."></textarea>
                </td>
                <td data-label="Repuestos adicionales">
                  <input type="text" name="repuestos[<%= m.id %>]" class="form-control" placeholder="Ej: Pastillas de freno, tornillos...">
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
          <button type="submit" class="btn btn-success">💾 Guardar información adicional</button>
          <a href="/mantenimientos/correctivos" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
</body>
</html>