<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unidades</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #eef2f7; color: #0f172a; font-family: "Segoe UI", Roboto, Arial, sans-serif; }
    .navbar { background: #101827; border-bottom: 3px solid #2563eb; }
    .shell { max-width: 1440px; }
    .hero, .panel, .kpi-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 8px;
      box-shadow: 0 10px 22px rgba(15,23,42,.05);
    }
    .hero { background: linear-gradient(135deg, #101827, #1e3a8a); color: #fff; padding: 1rem 1.15rem; }
    .hero-title { font-size: 1.45rem; font-weight: 850; margin: 0; }
    .hero-copy { color: #cbd5e1; margin: .25rem 0 0; }
    .kpi-grid { display: grid; gap: .75rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .kpi-card { border-top: 4px solid #2563eb; padding: .85rem; }
    .kpi-green { border-top-color: #16a34a; }
    .kpi-red { border-top-color: #dc2626; }
    .kpi-amber { border-top-color: #d97706; }
    .kpi-label { color: #64748b; font-size: .72rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
    .kpi-value { font-size: 1.65rem; font-weight: 900; line-height: 1.1; margin-top: .25rem; }
    .kpi-foot { color: #64748b; font-size: .8rem; }
    .filter-label { color: #475569; font-size: .75rem; font-weight: 800; text-transform: uppercase; }
    .table thead th { background: #f8fafc; color: #475569; font-size: .74rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
    .table tbody td { vertical-align: middle; }
    .status-pill { border-radius: 999px; font-size: .74rem; font-weight: 850; padding: .35rem .65rem; white-space: nowrap; }
    .status-active { background: #dcfce7; color: #166534; }
    .status-inactive { background: #e2e8f0; color: #475569; }
    .status-stopped { background: #fee2e2; color: #991b1b; }
    .status-ok { background: #dbeafe; color: #1d4ed8; }
    .reason-box { min-width: 260px; }
    .sede-form { min-width: 230px; }
    .bulk-actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      justify-content: flex-end;
    }
    .bulk-edit-form .form-select,
    .bulk-edit-form .form-control {
      min-width: 120px;
    }
    .bulk-placa {
      font-weight: 850;
      max-width: 110px;
      min-width: 95px;
    }
    .plate-edit {
      display: flex;
      gap: .35rem;
      min-width: 170px;
    }
    .plate-prefix {
      flex: 0 0 70px;
    }
    .bulk-sede { min-width: 210px; }
    .bulk-reason { min-width: 240px; }
    .bulk-brand { min-width: 130px; }
    .bulk-model { min-width: 150px; }
    .bulk-year { min-width: 90px; }
    .dirty-row { --bs-table-bg: #fff7ed; }
    .empty-state { color: #64748b; font-weight: 700; padding: 1.5rem; text-align: center; }
    .business-grid { display: grid; gap: .75rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .business-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-left: 5px solid #2563eb;
      border-radius: 8px;
      padding: .85rem;
    }
    .business-card.negocio-cilindreros { border-left-color: #2563eb; }
    .business-card.negocio-graneles { border-left-color: #dc2626; }
    .business-card.negocio-transportadora { border-left-color: #7c3aed; }
    .business-card.negocio-otros { border-left-color: #64748b; }
    .business-name { font-size: .9rem; font-weight: 900; letter-spacing: .03em; }
    .business-total { font-size: 1.45rem; font-weight: 950; line-height: 1.1; }
    .business-meta { color: #64748b; font-size: .78rem; }
    .business-section { border: 1px solid #dbe3ef; border-radius: 8px; overflow: hidden; }
    .business-toggle {
      align-items: center;
      background: #f8fafc;
      border: 0;
      border-bottom: 1px solid #dbe3ef;
      display: flex;
      gap: .75rem;
      justify-content: space-between;
      padding: .85rem 1rem;
      text-align: left;
      width: 100%;
    }
    .business-toggle:hover { background: #eef4ff; }
    .subgroup-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .subgroup-head {
      background: #102a56;
      color: #fff;
      font-size: .82rem;
      font-weight: 900;
      padding: .55rem .7rem;
    }
    .plate-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    }
    .plate-cell {
      border-bottom: 1px solid #edf2f7;
      border-right: 1px solid #edf2f7;
      padding: .5rem .55rem;
      min-height: 58px;
    }
    .plate-cell strong { display: block; font-size: .92rem; }
    .plate-flags { color: #64748b; font-size: .72rem; }
    .mini-pill {
      border-radius: 999px;
      display: inline-block;
      font-size: .65rem;
      font-weight: 900;
      margin-top: .18rem;
      padding: .12rem .35rem;
    }
    .mini-ok { background: #dcfce7; color: #166534; }
    .mini-off { background: #e2e8f0; color: #475569; }
    .mini-stop { background: #fee2e2; color: #991b1b; }
    @media (max-width: 1180px) { .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 1180px) { .business-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 680px) { .kpi-grid, .business-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<%
  const sedes = sedesFormulario || [];
  const sedesCambio = Array.isArray(sedesEditables) ? sedesEditables : sedes;
  const negociosUnidades = Array.isArray(unidadesPorNegocio) ? unidadesPorNegocio : [];
  const mostrarSede = typeof etiquetaSede === 'function' ? etiquetaSede : (sede) => sede;
  const negocioClase = nombre => `negocio-${String(nombre || 'otros').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
  const collapseId = nombre => `negocio-${String(nombre || 'otros').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
  const separarPlaca = placa => {
    const limpia = String(placa || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
    const match = limpia.match(/^(CL|C|S)?(.+)$/);
    return {
      prefijo: match?.[1] || '',
      numero: match?.[2] || limpia
    };
  };
%>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-truck-front me-1"></i> Unidades</span>
  <a href="/dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
</nav>

<div class="container-fluid shell py-4">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <h1 class="hero-title">Control de unidades</h1>
        <p class="hero-copy">Sede actual: <strong><%= sedeSeleccionada %></strong> · Activas, inactivas y unidades varadas.</p>
      </div>
      <span class="badge text-bg-light text-dark"><%= user.usuario || user.rol %> · <%= user.rol %></span>
    </div>
  </section>

  <% if (success) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
  <% } %>

  <section class="kpi-grid mb-3">
    <div class="kpi-card">
      <div class="kpi-label">Total</div>
      <div class="kpi-value"><%= resumen.total %></div>
      <div class="kpi-foot">Unidades registradas</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-label">Activas</div>
      <div class="kpi-value"><%= resumen.activas %></div>
      <div class="kpi-foot">Disponibles en operación</div>
    </div>
    <div class="kpi-card kpi-red">
      <div class="kpi-label">Varadas</div>
      <div class="kpi-value"><%= resumen.varadas %></div>
      <div class="kpi-foot">Con razón registrada</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-label">Inactivas</div>
      <div class="kpi-value"><%= resumen.inactivas %></div>
      <div class="kpi-foot">Fuera del listado activo</div>
    </div>
  </section>

  <section class="panel p-3 mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
      <div>
        <h2 class="h5 fw-bold mb-0">Unidades por negocio</h2>
        <div class="text-muted small">Vista agrupada por negocio, sede o tipo de unidad con los filtros actuales.</div>
      </div>
      <span class="badge text-bg-primary"><%= resumen.total %> unidad<%= resumen.total === 1 ? '' : 'es' %></span>
    </div>

    <div class="business-grid mb-3">
      <% negociosUnidades.forEach(negocio => { %>
        <div class="business-card <%= negocioClase(negocio.nombre) %>">
          <div class="d-flex justify-content-between gap-2">
            <div class="business-name"><%= negocio.nombre %></div>
            <div class="business-total"><%= negocio.total %></div>
          </div>
          <div class="business-meta">
            <%= negocio.activas %> activas · <%= negocio.varadas %> varadas · <%= negocio.inactivas %> inactivas
          </div>
        </div>
      <% }) %>
    </div>

    <div class="d-grid gap-3">
      <% negociosUnidades.filter(n => n.total > 0).forEach((negocio, index) => { %>
        <% const idNegocio = collapseId(negocio.nombre); %>
        <div class="business-section">
          <button class="business-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#<%= idNegocio %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
            <div>
              <strong><%= negocio.nombre %></strong>
              <div class="text-muted small"><%= negocio.subgrupos.length %> grupo<%= negocio.subgrupos.length === 1 ? '' : 's' %> · <%= negocio.total %> unidad<%= negocio.total === 1 ? '' : 'es' %></div>
            </div>
            <span class="badge text-bg-dark"><%= negocio.activas %> activas</span>
          </button>
          <div class="collapse <%= index === 0 ? 'show' : '' %>" id="<%= idNegocio %>">
            <div class="p-3">
              <div class="row g-3">
                <% negocio.subgrupos.forEach(subgrupo => { %>
                  <div class="col-lg-6 col-xl-4">
                    <div class="subgroup-card">
                      <div class="subgroup-head d-flex justify-content-between gap-2">
                        <span><%= subgrupo.nombre %></span>
                        <span><%= subgrupo.total %></span>
                      </div>
                      <div class="plate-grid">
                        <% subgrupo.unidades.forEach(unidad => { %>
                          <div class="plate-cell">
                            <strong><%= unidad.placa %></strong>
                            <div class="plate-flags"><%= mostrarSede(unidad.sede) %></div>
                            <% if (unidad.marca || unidad.modelo || unidad.anio) { %>
                              <div class="plate-flags"><%= [unidad.marca, unidad.modelo, unidad.anio].filter(Boolean).join(' · ') %></div>
                            <% } %>
                            <% if (Number(unidad.varada) === 1) { %>
                              <span class="mini-pill mini-stop">Varada</span>
                            <% } else if (Number(unidad.activa) === 1) { %>
                              <span class="mini-pill mini-ok">Activa</span>
                            <% } else { %>
                              <span class="mini-pill mini-off">Inactiva</span>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="panel p-3 mb-3">
    <form method="GET" action="/unidades" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label class="filter-label">Placa</label>
        <input type="text" name="placa" class="form-control form-control-sm" value="<%= filtros.placa || '' %>" placeholder="Buscar placa">
      </div>
      <div class="col-md-3">
        <label class="filter-label">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="activas" <%= filtros.estado === 'activas' ? 'selected' : '' %>>Solo activas</option>
          <option value="todas" <%= filtros.estado === 'todas' ? 'selected' : '' %>>Todas</option>
          <option value="inactivas" <%= filtros.estado === 'inactivas' ? 'selected' : '' %>>Solo inactivas</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="filter-label">Varadas</label>
        <select name="varado" class="form-select form-select-sm">
          <option value="" <%= filtros.varado === '' ? 'selected' : '' %>>Todas</option>
          <option value="1" <%= filtros.varado === '1' ? 'selected' : '' %>>Solo varadas</option>
          <option value="0" <%= filtros.varado === '0' ? 'selected' : '' %>>Sin varar</option>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-dark btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
      </div>
      <div class="col-md-1">
        <a href="/unidades" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </section>

  <% if (puedeEditar) { %>
    <section class="panel p-3 mb-3">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
          <h2 class="h5 fw-bold mb-0">Agregar unidad</h2>
          <div class="text-muted small">Se crea activa y sin estado de varada.</div>
        </div>
      </div>
      <form method="POST" action="/unidades/agregar" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="filter-label">Placa</label>
          <div class="plate-edit">
            <select name="placa_prefijo" class="form-select plate-prefix">
              <option value="C">C</option>
              <option value="CL">CL</option>
              <option value="S">S</option>
              <option value="">Sin</option>
            </select>
            <input type="text" name="placa_numero" class="form-control" placeholder="Ej: 173136" required>
          </div>
        </div>
        <div class="col-md-2">
          <label class="filter-label">Marca</label>
          <input type="text" name="marca" class="form-control" placeholder="Ej: Hino">
        </div>
        <div class="col-md-2">
          <label class="filter-label">Modelo</label>
          <input type="text" name="modelo" class="form-control" placeholder="Ej: Hino 500">
        </div>
        <div class="col-md-1">
          <label class="filter-label">Año</label>
          <input type="number" name="anio" class="form-control" min="1980" max="2100" placeholder="2024">
        </div>
        <% if (['ADMIN', 'TALLER', 'TRAMITES', 'PROVEEDURIA', 'PROVEEDURIA_TALLER'].includes(user.rol)) { %>
          <div class="col-md-2">
            <label class="filter-label">Sede</label>
            <select name="sede" class="form-select" required>
              <option value="">Seleccione sede</option>
              <% sedes.forEach(sede => { %>
                <option value="<%= sede %>" <%= sedeSeleccionada === sede ? 'selected' : '' %>><%= mostrarSede(sede) %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-1"></i>Agregar unidad
          </button>
        </div>
      </form>
    </section>
  <% } %>

  <section class="panel">
    <% if (puedeEditar) { %>
      <form method="POST" action="/unidades/guardar-masivo" class="bulk-edit-form" id="bulkUnitsForm">
    <% } %>
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="h5 fw-bold mb-0">Listado de unidades</h2>
          <div class="text-muted small">Edite las unidades visibles y guarde todos los cambios con un solo botón.</div>
        </div>
        <div class="bulk-actions">
          <span class="badge text-bg-dark"><%= unidades.length %> resultado<%= unidades.length === 1 ? '' : 's' %></span>
          <% if (puedeEditar) { %>
            <button type="submit" class="btn btn-primary btn-sm fw-bold" <%= unidades.length ? '' : 'disabled' %>>
              <i class="bi bi-save me-1"></i>Guardar cambios
            </button>
          <% } %>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Placa</th>
              <th>Sede</th>
              <th>Marca</th>
              <th>Modelo</th>
              <th>Año</th>
              <th>Estado</th>
              <th>Condición</th>
              <th>Razón varada</th>
            </tr>
          </thead>
          <tbody>
            <% if (unidades.length === 0) { %>
              <tr>
                <td colspan="8" class="empty-state">No hay unidades con los filtros seleccionados.</td>
              </tr>
            <% } %>

            <% unidades.forEach(u => { %>
              <% const placaPartes = separarPlaca(u.placa); %>
              <tr>
                <td>
                  <% if (puedeEditar) { %>
                    <input type="hidden" name="unidades[<%= u.id %>][id]" value="<%= u.id %>">
                    <div class="plate-edit">
                      <select name="unidades[<%= u.id %>][placa_prefijo]" class="form-select form-select-sm plate-prefix" aria-label="Inicial de placa">
                        <option value="" <%= placaPartes.prefijo === '' ? 'selected' : '' %>>Sin</option>
                        <option value="C" <%= placaPartes.prefijo === 'C' ? 'selected' : '' %>>C</option>
                        <option value="CL" <%= placaPartes.prefijo === 'CL' ? 'selected' : '' %>>CL</option>
                        <option value="S" <%= placaPartes.prefijo === 'S' ? 'selected' : '' %>>S</option>
                      </select>
                      <input
                        type="text"
                        name="unidades[<%= u.id %>][placa_numero]"
                        class="form-control form-control-sm bulk-placa"
                        value="<%= placaPartes.numero || '' %>"
                        aria-label="Número de placa"
                        required
                      >
                    </div>
                  <% } else { %>
                    <strong><%= u.placa %></strong>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <select name="unidades[<%= u.id %>][sede]" class="form-select form-select-sm bulk-sede" aria-label="Sede de <%= u.placa %>">
                      <% if (u.sede && !sedesCambio.includes(u.sede)) { %>
                        <option value="<%= u.sede %>" selected><%= mostrarSede(u.sede) %></option>
                      <% } %>
                      <% sedesCambio.forEach(sede => { %>
                        <option value="<%= sede %>" <%= u.sede === sede ? 'selected' : '' %>><%= mostrarSede(sede) %></option>
                      <% }) %>
                    </select>
                  <% } else { %>
                    <%= mostrarSede(u.sede) %>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <input
                      type="text"
                      name="unidades[<%= u.id %>][marca]"
                      class="form-control form-control-sm bulk-brand"
                      value="<%= u.marca || '' %>"
                      placeholder="Marca"
                    >
                  <% } else { %>
                    <%= u.marca || '-' %>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <input
                      type="text"
                      name="unidades[<%= u.id %>][modelo]"
                      class="form-control form-control-sm bulk-model"
                      value="<%= u.modelo || '' %>"
                      placeholder="Modelo"
                    >
                  <% } else { %>
                    <%= u.modelo || '-' %>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <input
                      type="number"
                      name="unidades[<%= u.id %>][anio]"
                      class="form-control form-control-sm bulk-year"
                      value="<%= u.anio || '' %>"
                      min="1980"
                      max="2100"
                      placeholder="Año"
                    >
                  <% } else { %>
                    <%= u.anio || '-' %>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <select name="unidades[<%= u.id %>][activa]" class="form-select form-select-sm">
                      <option value="1" <%= Number(u.activa) === 1 ? 'selected' : '' %>>Activa</option>
                      <option value="0" <%= Number(u.activa) === 0 ? 'selected' : '' %>>Inactiva</option>
                    </select>
                  <% } else if (Number(u.activa) === 1) { %>
                    <span class="status-pill status-active">Activa</span>
                  <% } else { %>
                    <span class="status-pill status-inactive">Inactiva</span>
                  <% } %>
                </td>
                <td>
                  <% if (puedeEditar) { %>
                    <select name="unidades[<%= u.id %>][varada]" class="form-select form-select-sm">
                      <option value="0" <%= Number(u.varada) === 0 ? 'selected' : '' %>>Sin varar</option>
                      <option value="1" <%= Number(u.varada) === 1 ? 'selected' : '' %>>Varada</option>
                    </select>
                  <% } else if (Number(u.varada) === 1) { %>
                    <span class="status-pill status-stopped"><i class="bi bi-exclamation-triangle me-1"></i>Varada</span>
                  <% } else { %>
                    <span class="status-pill status-ok">Sin varar</span>
                  <% } %>
                </td>
                <td class="reason-box">
                  <% if (puedeEditar) { %>
                    <input
                      type="text"
                      name="unidades[<%= u.id %>][razon_varada]"
                      class="form-control form-control-sm bulk-reason"
                      value="<%= u.razon_varada || '' %>"
                      placeholder="Razón si está varada"
                    >
                  <% } else { %>
                    <div class="<%= Number(u.varada) === 1 ? 'fw-semibold text-danger' : 'text-muted' %>">
                      <%= u.razon_varada || 'Sin razón registrada' %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% if (puedeEditar) { %>
      </form>
    <% } %>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (() => {
    const form = document.getElementById('bulkUnitsForm');
    if (!form) return;

    form.querySelectorAll('select, input').forEach(control => {
      control.dataset.initialValue = control.value;
      control.addEventListener('change', () => {
        const row = control.closest('tr');
        if (!row) return;
        const changed = [...row.querySelectorAll('select, input')]
          .some(item => item.value !== item.dataset.initialValue);
        row.classList.toggle('dirty-row', changed);
      });
    });

    form.addEventListener('submit', () => {
      const button = form.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
      }
    });
  })();
</script>
</body>
</html>
