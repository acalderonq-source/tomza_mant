<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Unidades</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<!-- NAVBAR -->
<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Gas Tomza</span>
  <a href="/dashboard" class="btn btn-secondary btn-sm">Volver</a>
</nav>

<div class="container mt-4">

  <!-- TÍTULO -->
  <h3 class="mb-3">
    Unidades – <strong><%= user.sede || 'Todas' %></strong>
  </h3>

  <!-- MENSAJE DE ERROR -->
  <% if (typeof error !== 'undefined') { %>
    <div class="alert alert-danger">
      <%= error %>
    </div>
  <% } %>

  <!-- FORMULARIO -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      Agregar unidad
    </div>
    <div class="card-body">

      <form method="POST" action="/unidades" class="row g-2 align-items-end">

        <!-- PLACA -->
        <div class="col-md-4">
          <label class="form-label">Placa</label>
          <input
            type="text"
            name="placa"
            class="form-control"
            placeholder="Ej: C173136"
            required
          >
        </div>

        <!-- SEDE -->
        <% if (user.rol === 'ADMIN') { %>
          <div class="col-md-4">
            <label class="form-label">Sede</label>
            <select name="sede" class="form-select" required>
              <option value="">Seleccione sede</option>
              <option value="Cartago">Cartago</option>
              <option value="La Cruz">La Cruz</option>
            </select>
          </div>
        <% } else { %>
          <input type="hidden" name="sede" value="<%= user.sede %>">
        <% } %>

        <!-- BOTÓN -->
        <div class="col-md-4">
          <button type="submit" class="btn btn-success w-100">
            Agregar unidad
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- TABLA -->
  <div class="card">
    <div class="card-header bg-dark text-white">
      Listado de unidades
    </div>
    <div class="card-body p-0">

      <table class="table table-striped mb-0">
        <thead class="table-light">
          <tr>
            <th>Placa</th>
            <th>Sede</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>

          <% if (unidades.length === 0) { %>
            <tr>
              <td colspan="3" class="text-center text-muted">
                No hay unidades registradas
              </td>
            </tr>
          <% } %>

          <% unidades.forEach(u => { %>
            <tr>
              <td><strong><%= u.placa %></strong></td>
              <td><%= u.sede %></td>
              <td>
                <span class="badge bg-success">Activa</span>
              </td>
            </tr>
          <% }) %>

        </tbody>
      </table>

    </div>
  </div>

</div>

</body>
</html>
