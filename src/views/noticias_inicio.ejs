<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Noticias del inicio | Gas Tomza</title>
<link rel="stylesheet" href="/css/noticias-inicio.css?v=1"><script src="/js/noticias-admin.js?v=1" defer></script></head><body class="noticias-admin">
<header class="noticias-top"><a href="/administracion">Administración</a><strong>Gas Tomza</strong><a href="/inicio">Ir a inicio</a></header>
<main><header class="noticias-heading"><div><h1>Noticias del inicio</h1><p>Imágenes que alternan con el mapa en la bienvenida.</p></div><a href="/inicio">Ver carrusel</a></header>
<form id="noticia-subir" class="noticia-upload"><label>Imágenes <input type="file" name="archivos" accept="image/png,image/jpeg,image/webp" multiple required></label><label>Título <input name="titulo" maxlength="120" placeholder="Opcional; se utiliza el nombre del archivo"></label><label>Orden <input type="number" name="orden" min="0" max="9999" value="0" required></label><button type="submit">Subir imágenes</button><small>PNG, JPG o WebP. Máximo 4 MB por imagen.</small></form>
<p id="noticias-mensaje" role="status" aria-live="polite"></p><noscript>Active JavaScript para administrar las noticias.</noscript>
<% if(!noticias.length){ %><p class="noticias-empty">Todavía no hay noticias. El inicio muestra únicamente el mapa.</p><% } %>
<section class="noticias-grid" aria-label="Noticias cargadas"><% noticias.forEach(n=>{ %><article class="noticia-card"><img src="/admin/noticias/<%= n.id %>/imagen" alt="<%= n.titulo %>" loading="lazy">
<form class="noticia-editar" action="/admin/noticias/<%= n.id %>/editar" method="post"><label>Título<input name="titulo" maxlength="120" value="<%= n.titulo %>" required></label><div class="noticia-options"><label>Orden<input type="number" name="orden" min="0" max="9999" value="<%= n.orden %>" required></label><label class="noticia-switch"><input type="checkbox" name="activa" value="1" <%= n.activa?'checked':'' %>> Publicada</label></div><div class="noticia-actions"><button type="submit">Guardar</button><button type="button" class="noticia-eliminar" data-id="<%= n.id %>">Eliminar</button></div></form></article><% }); %></section>
</main></body></html>
