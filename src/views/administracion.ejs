<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administración · Gas Tomza</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="/css/portal-proveedores.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-dark bg-dark px-4"><span class="navbar-brand">Gas Tomza · Administración</span><div class="d-flex gap-3 align-items-center"><a class="btn btn-outline-light btn-sm" href="/inicio">Inicio empresarial</a><span class="text-white"><%= user.usuario %></span><a class="btn btn-outline-light btn-sm" href="/logout">Cerrar sesión</a></div></nav>
<main class="container portal-shell"><header class="mb-4"><span class="text-primary fw-semibold"><i class="bi bi-shield-lock"></i> ACCESO PRIVADO</span><h1 class="mt-2">Administración</h1><p class="text-secondary">Configuración del portal y accesos de proveedores.</p></header>
<%- include("partials/administracion_finanzas") %>
<section class="row g-4"><div class="col-md-6"><a href="/administracion/portal-proveedores" class="card p-4 h-100 text-decoration-none text-dark"><i class="bi bi-person-lock text-primary fs-2"></i><h2 class="h4 mt-3">Portal de proveedores</h2><p class="text-secondary mb-0">Crear cuentas, habilitar accesos, restablecer contraseñas y configurar empresas receptoras.</p></a></div><div class="col-md-6"><a href="/proveeduria/portal-proveedores/facturas" class="card p-4 h-100 text-decoration-none text-dark"><i class="bi bi-receipt text-primary fs-2"></i><h2 class="h4 mt-3">Facturas recibidas</h2><p class="text-secondary mb-0">Consultar validación en Hacienda, revisión interna, cuentas por pagar y pagos.</p></a></div><div class="col-md-6"><a href="/compras/facturas/correo" class="card p-4 h-100 text-decoration-none text-dark"><i class="bi bi-envelope text-primary fs-2"></i><h2 class="h4 mt-3">Conexión Outlook</h2><p class="text-secondary mb-0">Autorizar el buzón receptor y consultar los XML y PDF recibidos.</p></a></div></section>
<% if (user.departamentoActivo === 'ADMINISTRACION') { %>
<section class="mt-4"><a href="/admin/ciberseguridad" class="card p-4 text-decoration-none text-dark"><div><span class="badge bg-dark mb-2">Eventos reales</span><h2 class="h4"><i class="bi bi-shield-lock"></i> Centro de ciberseguridad</h2><p class="text-secondary mb-0">Ingresos fallidos, bloqueos por intentos repetidos y accesos denegados. Gráficos y seguimiento de incidentes reales del sistema.</p></div></a></section>
<section class="row g-4 mt-1">
<div class="col-md-6"><a href="/marcas-ingreso/historial" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Historial de marcas</h2><p class="text-secondary mb-0">Consultar entradas, salidas y fotografías de Taller.</p></a></div>
<div class="col-md-6"><a href="/admin/noticias" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Noticias del inicio</h2><p class="text-secondary mb-0">Subir imágenes, ordenarlas y publicarlas junto al mapa de sedes.</p></a></div>
<div class="col-md-6"><a href="/admin/perfiles" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Perfiles de acceso</h2><p class="text-secondary mb-0">Editar nombres, sedes, departamentos y permisos.</p></a></div>
<div class="col-md-6"><a href="/admin/ingresos" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Registro de ingresos</h2><p class="text-secondary mb-0">Inicios de sesión, avisos y correos de trabajadores.</p></a></div>
<div class="col-md-6"><a href="/admin/solicitudes-trabajadores" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Solicitudes de trabajadores</h2><p class="text-secondary mb-0">Revisar y autorizar nuevos ingresos.</p></a></div>
<div class="col-md-6"><a href="/control-empresa" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Centro de control</h2><p class="text-secondary mb-0">Bitácora, alertas y respaldos.</p></a></div>
<div class="col-md-6"><a href="/control-empresa/unidades" class="card p-4 h-100 text-decoration-none text-dark"><h2 class="h4">Expediente por placa</h2><p class="text-secondary mb-0">Historial consolidado de la unidad.</p></a></div>
</section><% } %>
<form method="POST" action="/departamento/activo" class="d-flex flex-wrap gap-2 mt-4 align-items-center"><label for="area">Cambiar departamento</label><select class="form-select w-auto" id="area" name="departamento"><% (user.departamentos||[]).forEach(key=>{ %><option value="<%= key %>" <%= key==='ADMINISTRACION'?'selected':'' %>><%= departamentos.find(d=>d.key===key)?.nombre||key %></option><% }) %></select><button class="btn btn-outline-primary">Ingresar</button></form></main></body></html>
