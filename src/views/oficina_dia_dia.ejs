<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Oficina día a día - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
      --red: #dc2626;
      --blue: #1d4ed8;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid var(--red);
    }

    .shell {
      max-width: 1120px;
    }

    .hero {
      background: linear-gradient(135deg, #111827 0%, #1d4ed8 72%, #dc2626 100%);
      border-radius: 12px;
      color: #fff;
      padding: 1.15rem;
    }

    .hero h1 {
      font-size: 1.45rem;
      font-weight: 900;
      margin: 0;
    }

    .hero p {
      color: rgba(255,255,255,.82);
      margin: .2rem 0 0;
    }

    .panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }

    .panel-head {
      border-bottom: 1px solid var(--line);
      padding: 1rem;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 900;
      margin: 0;
    }

    .activity-form {
      display: grid;
      gap: .75rem;
      grid-template-columns: 160px 260px 1fr auto;
      padding: 1rem;
    }

    .activity-form label {
      color: #334155;
      font-size: .74rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .activity-list {
      display: grid;
      gap: .75rem;
      padding: 1rem;
    }

    .person-picker {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 1rem;
    }

    .person-btn {
      align-items: center;
      background: #f8fafc;
      border: 1px solid #dbe3ef;
      border-radius: 10px;
      color: var(--ink);
      display: flex;
      font-weight: 900;
      gap: .55rem;
      justify-content: flex-start;
      padding: .75rem;
      text-align: left;
      transition: border-color .12s ease, background .12s ease, transform .12s ease;
    }

    .person-btn:hover,
    .person-btn.is-active {
      background: #dbeafe;
      border-color: var(--blue);
      transform: translateY(-1px);
    }

    .person-avatar {
      align-items: center;
      background: var(--dark);
      border-radius: 999px;
      color: #fff;
      display: inline-flex;
      flex: 0 0 34px;
      font-size: .82rem;
      height: 34px;
      justify-content: center;
      width: 34px;
    }

    .activity-item {
      border: 1px solid #e2e8f0;
      border-left: 5px solid var(--blue);
      border-radius: 10px;
      padding: .85rem;
    }

    .activity-person {
      font-size: 1rem;
      font-weight: 900;
    }

    .activity-meta {
      color: var(--muted);
      font-size: .8rem;
      font-weight: 700;
      margin-top: .2rem;
    }

    .activity-text {
      color: #1f2937;
      margin-top: .55rem;
      white-space: pre-wrap;
    }

    .empty-state {
      color: var(--muted);
      font-weight: 700;
      padding: 2rem;
      text-align: center;
    }

    @media (max-width: 760px) {
      .activity-form,
      .person-picker {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(registros) ? registros : [];
  const personas = Array.isArray(personasOficina) ? personasOficina : [];
  const iniciales = (nombre) => String(nombre || '').split(/\s+/).filter(Boolean).slice(0, 2).map(p => p[0]).join('').toUpperCase();
%>

<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-person-workspace me-2"></i>Oficina día a día</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Dashboard</a>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1>Oficina día a día</h1>
        <p>Sede actual: <strong><%= sedeActual %></strong>. Cada persona registra qué realizó y queda visible para el equipo autorizado.</p>
      </div>
      <span class="badge text-bg-light text-dark"><%= lista.length %> registros</span>
    </div>
  </section>

  <section class="panel mb-3">
    <div class="panel-head">
      <h2 class="section-title">Agregar actividad</h2>
      <div class="text-muted small">Seleccione su nombre y escriba lo que hizo.</div>
    </div>

    <div class="person-picker">
      <% personas.forEach(persona => { %>
        <button type="button" class="person-btn js-person-btn" data-persona="<%= persona %>">
          <span class="person-avatar"><%= iniciales(persona) %></span>
          <span><%= persona %></span>
        </button>
      <% }) %>
    </div>

    <form method="POST" action="/oficina-dia-dia" class="activity-form">
      <div>
        <label class="form-label mb-1">Fecha</label>
        <input type="date" name="fecha" class="form-control form-control-sm" value="<%= fechaHoy || '' %>">
      </div>
      <div>
        <label class="form-label mb-1">Persona</label>
        <select name="nombre_persona" id="personaSelect" class="form-select form-select-sm" required>
          <option value="">Seleccione persona</option>
          <% personas.forEach(persona => { %>
            <option value="<%= persona %>"><%= persona %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Qué hace</label>
        <input type="text" name="actividad" class="form-control form-control-sm" placeholder="Ej: Revisar facturas, órdenes, llamadas..." required>
      </div>
      <div class="d-flex align-items-end">
        <button class="btn btn-dark btn-sm w-100"><i class="bi bi-plus-circle"></i> Agregar</button>
      </div>
    </form>
    <% if (error) { %>
      <div class="alert alert-warning mx-3 mb-3">Debe seleccionar una persona autorizada y colocar actividad.</div>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <div>
        <h2 class="section-title">Historial de oficina</h2>
        <div class="text-muted small">Últimos registros guardados por el equipo.</div>
      </div>
    </div>

    <div class="activity-list">
      <% if (!lista.length) { %>
        <div class="empty-state">Todavía no hay registros de oficina.</div>
      <% } %>
      <% lista.forEach(item => { %>
        <article class="activity-item">
          <div class="d-flex justify-content-between gap-2 flex-wrap">
            <div>
              <div class="activity-person"><%= item.nombre_persona %></div>
              <div class="activity-meta">
                <%= item.fecha_formato || item.fecha || '-' %> · <%= item.sede || 'General' %> · Registrado por <%= item.registrado_por || 'sistema' %>
              </div>
            </div>
            <form method="POST" action="/oficina-dia-dia/<%= item.id %>/eliminar" onsubmit="return confirm('¿Eliminar este registro?');">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </div>
          <div class="activity-text"><%= item.actividad %></div>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<script>
  const personaSelect = document.getElementById('personaSelect');
  const personButtons = document.querySelectorAll('.js-person-btn');

  personButtons.forEach(button => {
    button.addEventListener('click', () => {
      const persona = button.dataset.persona || '';
      if (personaSelect) personaSelect.value = persona;
      personButtons.forEach(item => item.classList.toggle('is-active', item === button));
    });
  });

  personaSelect?.addEventListener('change', () => {
    personButtons.forEach(item => {
      item.classList.toggle('is-active', item.dataset.persona === personaSelect.value);
    });
  });
</script>
</body>
</html>
