<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Resumen ejecutivo de presupuesto</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/contabilidad-erp.css" rel="stylesheet"><link href="/css/dashboard-presupuesto.css" rel="stylesheet"><script src="/js/contabilidad-erp.js" defer></script><link href="/css/contabilidad-taller.css" rel="stylesheet"></head><body class="erp-accounting">
<nav class="navbar navbar-dark px-3"><span class="navbar-brand">Contabilidad · Resumen ejecutivo</span><a href="/dashboard" class="btn btn-sm btn-outline-light">Inicio</a></nav><%- include("../partials/contabilidad_navegacion") %><main>
<% const dinero=n=>(n/100).toLocaleString('es-CR',{style:'currency',currency:f.moneda});const pct=(n,d)=>d?(n/d*100).toLocaleString('es-CR',{maximumFractionDigits:1})+' %':'—';const link=(path,extra={})=>path+'?'+new URLSearchParams({...f,...extra});const badge=s=>s==='Excedido'||s==='Sin presupuesto'?'danger':s==='Por revisar'?'warning':s==='Sin gasto registrado'?'secondary':'success';const maxRubro=Math.max(1,...rubros.map(r=>Math.max(r.presupuesto,r.facturado+r.compromiso)));const maxMes=Math.max(1,...tendencia.flatMap(r=>[r.presupuesto,r.facturado,r.pagado])); %>
<header class="budget-heading"><div><div class="erp-eyebrow">CONTROL DE GESTIÓN</div><h1>Resumen ejecutivo de presupuesto</h1><p class="text-secondary mb-0"><%= f.empresa||'Todas las empresas' %> · <%= f.periodo %> · <%= f.moneda %></p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-primary" href="<%= link('/contabilidad/presupuestos/reporte.csv') %>">Exportar resumen</a><a class="btn btn-primary" href="<%= link('/contabilidad/presupuestos') %>">Gestionar presupuesto</a></div></header>
<section class="panel"><form method="get" class="budget-filters"><label>Período<input type="month" required name="periodo" value="<%= f.periodo %>" class="form-control"></label><label>Empresa<select name="empresa" class="form-select"><option value="">Todas las empresas</option><% empresas.forEach(e=>{ %><option value="<%= e %>" <%= f.empresa===e?'selected':'' %>><%= e %></option><% }) %><option value="__SIN_EMPRESA__" <%= f.empresa==='__SIN_EMPRESA__'?'selected':'' %>>Sin empresa asignada</option></select></label><label>Sede<select name="sede" class="form-select"><option value="">Todas</option><% sedes.forEach(s=>{ %><option <%= f.sede===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Departamento<select name="departamento" class="form-select"><option value="">Todos</option><% departamentos.forEach(d=>{ %><option value="<%= d.key %>" <%= f.departamento===d.key?'selected':'' %>><%= d.nombre %></option><% }) %></select></label><label>Moneda<select name="moneda" class="form-select"><% ['CRC','USD'].forEach(m=>{ %><option <%= m===f.moneda?'selected':'' %>><%= m %></option><% }) %></select></label><button class="btn btn-primary">Consultar</button></form></section>
<div class="budget-kpis"><% [['Presupuesto',totales.presupuesto,'Importe aprobado para el período'],['Ejecutado / facturado',totales.facturado,pct(totales.facturado,totales.presupuesto)+' del presupuesto'],['Por facturar',totales.compromiso,'Compromisos de órdenes del período'],['Pagado en el mes',totales.pagado,'Según la fecha efectiva del pago'],['Disponible',totales.disponible,'Presupuesto − ejecución − compromisos']].forEach(([label,value,note])=>{ %><section class="panel budget-kpi"><span><%= label %></span><strong class="<%= value<0?'text-danger':'' %>"><%= label==='Ejecutado / facturado'&&!registros?'Sin gasto registrado':dinero(value) %></strong><small><%= note %></small></section><% }) %></div>
<% if(!registros&&totales.presupuesto){ %><div class="alert alert-info"><strong>Hay presupuesto cargado, pero no hay gastos confirmados incluidos en este resumen.</strong> Los importes por empresa representan lo presupuestado. Abra un rubro para consultar los conceptos y registrar los gastos reales; los documentos sin clasificación se revisan desde Presupuestos.</div><% } %>
<% if(!totales.presupuesto&&!totales.facturado&&!totales.compromiso&&!totales.pagado){ %><div class="alert alert-info">No hay importes para estos filtros. Seleccione otro período o empresa, o registre un presupuesto.</div><% } %>
<% if(pendientes||alertas.length||advertencias.length){ %><section class="panel budget-alerts"><h2 class="h5">Atención del período</h2><% if(pendientes){ %><p><strong><%= pendientes %> documentos pendientes de clasificación o excluidos.</strong> Revise su empresa, moneda, rubro y posibles duplicados en <a href="<%= link('/contabilidad/presupuestos') %>">Presupuestos</a>.</p><% } %><% alertas.forEach(r=>{ %><p><span class="badge text-bg-<%= badge(r.estado) %>"><%= r.estado %></span> <% if(user.rol==='ADMIN'){ %><a href="<%= link('/contabilidad/presupuestos/'+(r.key==='PLANILLA'?'planilla':'rubros/'+r.key)) %>"><%= r.nombre %></a><% } %> · Disponible: <%= dinero(r.disponible) %></p><% }) %><% advertencias.forEach(a=>{ %><p class="text-danger"><%= a %></p><% }) %></section><% } %>
<div class="budget-chart-grid"><section class="panel"><h2 class="h5">Presupuesto y ejecución por rubro</h2><p class="text-secondary small">La ejecución incluye importes registrados y facturas confirmadas.</p><div class="budget-legend"><span class="legend-budget">Presupuesto</span><span class="legend-actual">Ejecutado</span></div><p class="small text-secondary">Abra un rubro para ver su distribución entre empresas y entrar al detalle de conceptos.</p>
<% rubros.forEach(r=>{ %><details class="budget-rubro budget-drilldown" id="rubro-<%= r.key %>"><summary><span class="budget-rubro-title"><strong><%= r.nombre %></strong><span><%= dinero(r.presupuesto) %></span></span><span class="budget-rubro-status"><%= r.registros?'Gasto registrado: '+dinero(r.facturado):'Sin gasto registrado' %> · <%= r.empresas.length %> empresas</span><span class="budget-track"><span class="bar-budget" style="width:<%= r.presupuesto/maxRubro*100 %>%"></span></span><span class="budget-track"><span class="bar-actual" style="width:<%= r.facturado/maxRubro*100 %>%"></span></span></summary>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Empresa</th><th>Presupuesto</th><th>Gasto registrado</th><th>Pagos</th><th>Detalle</th></tr></thead><tbody><% r.empresas.forEach(e=>{ %><tr><td><strong><%= e.empresa %></strong></td><td class="budget-number"><%= dinero(e.presupuesto) %></td><td class="budget-number"><%= e.registros?dinero(e.facturado):'Sin registrar' %></td><td class="budget-number"><%= dinero(e.pagado) %></td><td><% if(user.rol==='ADMIN'){ %><a href="<%= link('/contabilidad/presupuestos/'+(r.key==='PLANILLA'?'planilla':'rubros/'+r.key),{empresa:e.empresa}) %>">Ver conceptos / registrar gasto</a><% } %></td></tr><% }) %><% if(!r.empresas.length){ %><tr><td colspan="5">Sin presupuesto ni movimientos en este rubro para los filtros seleccionados.</td></tr><% } %></tbody></table></div><% if(user.rol==='ADMIN'){ %><a class="btn btn-sm btn-outline-primary" href="<%= link('/contabilidad/presupuestos/'+(r.key==='PLANILLA'?'planilla':'rubros/'+r.key)) %>">Abrir control completo</a><% } %></details><% }) %></section>
<section class="panel"><h2 class="h5">Evolución de seis meses</h2><p class="text-secondary small">Misma empresa, sede, departamento y moneda seleccionados.</p><div class="budget-legend"><span class="legend-budget">Presupuesto</span><span class="legend-actual">Ejecutado</span><span class="legend-paid">Pagado</span></div><div class="budget-trend" role="img" aria-label="Comparación mensual; los importes se detallan en la tabla siguiente."><% tendencia.forEach(m=>{ %><div class="trend-month"><div class="trend-bars"><% [['presupuesto','bar-budget'],['facturado','bar-actual'],['pagado','bar-paid']].forEach(([key,color])=>{ %><span class="<%= color %>" style="height:<%= m[key]/maxMes*100 %>%" title="<%= key %>: <%= dinero(m[key]) %>"></span><% }) %></div><span><%= m.periodo.slice(5) %>/<%= m.periodo.slice(2,4) %></span></div><% }) %></div><div class="table-responsive"><table class="table"><thead><tr><th>Mes</th><th class="text-end">Presupuesto</th><th class="text-end">Ejecutado</th><th class="text-end">Pagado</th></tr></thead><tbody><% tendencia.forEach(m=>{ %><tr><td><%= m.periodo %></td><td class="text-end"><%= dinero(m.presupuesto) %></td><td class="text-end"><%= dinero(m.facturado) %></td><td class="text-end"><%= dinero(m.pagado) %></td></tr><% }) %></tbody></table></div></section></div>
<section class="panel"><h2 class="h5">Comparación por empresa</h2><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Empresa</th><th>Presupuesto</th><th>Ejecutado</th><th>Por facturar</th><th>Pagado</th><th>Disponible</th><th>Ejecución</th><th>Estado</th></tr></thead><tbody><% porEmpresa.forEach(e=>{ %><tr><td><a href="<%= link('/contabilidad/presupuestos/resumen-ejecutivo',{empresa:e.empresa}) %>"><%= e.empresa %></a></td><% ['presupuesto','facturado','compromiso','pagado','disponible'].forEach(k=>{ %><td class="budget-number <%= e[k]<0?'text-danger':'' %>"><%= k==='facturado'&&!e.registros?'Sin registrar':dinero(e[k]) %></td><% }) %><td><%= e.registros?pct(e.facturado,e.presupuesto):'Pendiente' %></td><td><span class="badge text-bg-<%= badge(e.estado) %>"><%= e.estado %></span></td></tr><% }) %><% if(!porEmpresa.length){ %><tr><td colspan="8">Sin importes por empresa para estos filtros.</td></tr><% } %></tbody></table></div></section>
<section class="panel"><h2 class="h5">Detalle ejecutivo por rubro</h2><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Rubro</th><th>Presupuesto</th><th>Ejecutado</th><th>Por facturar</th><th>Pagado</th><th>Disponible</th><th>Estado</th></tr></thead><tbody><% rubros.forEach(r=>{ %><tr><td><a href="<%= '#rubro-'+r.key %>"><%= r.nombre %></a></td><% ['presupuesto','facturado','compromiso','pagado','disponible'].forEach(k=>{ %><td class="budget-number <%= r[k]<0?'text-danger':'' %>"><%= k==='facturado'&&!r.registros?'Sin registrar':dinero(r[k]) %></td><% }) %><td><span class="badge text-bg-<%= badge(r.estado) %>"><%= r.estado %></span></td></tr><% }) %></tbody></table></div></section>
<p class="small text-secondary">Los pagos se muestran por su fecha y no se descuentan nuevamente del disponible. Las referencias de Excel no se contabilizan como gastos reales. “Por revisar” indica ejecución más compromisos de al menos 90 % del presupuesto. Los meses sin datos muestran cero; no representan una carga completa confirmada. <%= documentos %> documentos consultados en el período.</p>
</main></body></html>
