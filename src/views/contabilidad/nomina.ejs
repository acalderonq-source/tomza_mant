<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Planilla · Contabilidad</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f4f6fa;color:#18263b}.nomina{max-width:1300px;margin:auto;padding:24px}.panel{background:white;border:1px solid #dce2ec;border-radius:14px;padding:20px;margin-bottom:20px}.importe{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}td{vertical-align:middle}label{display:block}</style><link href="/css/contabilidad-erp.css" rel="stylesheet"><script src="/js/contabilidad-erp.js" defer></script><link href="/css/contabilidad-taller.css" rel="stylesheet"></head><body class="erp-accounting">
<nav class="navbar navbar-dark bg-dark px-3"><span class="navbar-brand">Administración · Planilla</span><a href="/administracion" class="btn btn-outline-light btn-sm">Inicio</a></nav><%- include("../partials/administracion_finanzas_navegacion") %>
<main class="nomina"><h1>Planilla</h1><p class="text-secondary">Todas las personas, su empresa y salario del período seleccionado.</p>
<form class="panel row g-3" method="get"><div class="col-md-2"><label>Período<select name="periodo" class="form-select"><% periodos.forEach(p=>{ %><option value="<%= p %>" <%= p===f.periodo?'selected':'' %>><%= p %></option><% }) %></select></label></div><div class="col-md-4"><label>Empresa<select name="empresa" class="form-select"><option value="">Todas las empresas</option><% empresas.forEach(e=>{ %><option value="<%= e %>" <%= e===f.empresa?'selected':'' %>><%= e %></option><% }) %></select></label></div><div class="col-md-2"><label>Moneda<select name="moneda" class="form-select"><option value="">Todas</option><% ['CRC','USD'].forEach(m=>{ %><option <%= m===f.moneda?'selected':'' %>><%= m %></option><% }) %></select></label></div><div class="col-md-4"><label>Buscar persona, empresa o puesto<input name="buscar" value="<%= f.buscar %>" maxlength="180" class="form-control"></label></div><div><button class="btn btn-primary">Consultar</button></div></form>
<div class="row g-3 mb-3"><% [['Personas / conceptos',resumen.cantidad],['Empresas',resumen.empresas],['Salarios registrados',resumen.registrados],['Pendientes de registrar',resumen.pendientes]].forEach(([label,value])=>{ %><div class="col-md-3"><div class="panel h-100 mb-0"><span class="text-secondary small"><%= label %></span><div class="plan-stat"><%= value %></div></div></div><% }) %></div>
<section class="panel"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h2 class="h5 mb-0">Personal y conceptos de planilla (<%= resumen.cantidad %>)</h2><a href="/contabilidad/presupuestos/planilla?<%= new URLSearchParams({periodo:f.periodo,empresa:f.empresa,moneda:f.moneda||'CRC'}) %>" class="btn btn-outline-primary btn-sm">Gestionar salarios y pagos</a></div>
<p class="small text-secondary">Salario registrado muestra el importe confirmado en el sistema. Salario de referencia conserva el dato del archivo; los importes sin confirmar aparecen como pendientes. Los conceptos adicionales del origen se identifican por su puesto.</p>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nombre / concepto</th><th>Empresa</th><th>Puesto</th><th>Moneda</th><th class="importe">Salario registrado</th><th class="importe">Salario de referencia</th><th></th></tr></thead><tbody>
<% personas.forEach(p=>{ const dinero=v=>Number(v).toLocaleString('es-CR',{style:'currency',currency:p.moneda}); %><tr><td><strong><%= p.nombre %></strong></td><td><%= p.empresa %></td><td><%= p.puesto||'—' %></td><td><%= p.moneda %></td><td class="importe"><%= p.salario==null?'Pendiente':dinero(p.salario) %></td><td class="importe"><%= p.presupuesto==null?'Sin dato':dinero(p.presupuesto) %></td><td><a href="/contabilidad/presupuestos/planilla?<%= new URLSearchParams({periodo:f.periodo,empresa:p.empresa,moneda:p.moneda,buscar:p.nombre}) %>">Ver / editar</a></td></tr><% }) %>
<% if(!personas.length){ %><tr><td colspan="7" class="text-center py-4">No hay personas para estos filtros.</td></tr><% } %>
</tbody></table></div><nav class="d-flex align-items-center gap-3 flex-wrap" aria-label="Páginas del personal"><% if(pagina>1){ %><a class="btn btn-outline-primary" href="?<%= new URLSearchParams({...f,pagina:pagina-1}) %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %> · <%= resumen.cantidad %> registros</span><% if(pagina<paginas){ %><a class="btn btn-outline-primary" href="?<%= new URLSearchParams({...f,pagina:pagina+1}) %>">Siguiente</a><% } %></nav></section></main></body></html>
