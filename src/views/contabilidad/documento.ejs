<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Consultar documento</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/contabilidad-erp.css" rel="stylesheet"><link href="/css/contabilidad-taller.css" rel="stylesheet"></head><body class="erp-accounting"><%- include('../partials/contabilidad_navegacion') %><main class="container py-4">
<a href="/contabilidad/documentos">Volver a todos los documentos</a><h1 class="mt-3"><%= d.tipo==='factura'?'Factura':'Orden' %> <%= d.numero||d.referencia %></h1>
<div class="card p-3 mb-3"><p><strong>Origen:</strong> <%= d.origen %> · <strong>Fecha:</strong> <%= d.fecha %> · <strong>Estado de origen:</strong> <%= d.estadoOrigen||'Registrada' %></p><p><strong>Proveedor:</strong> <%= d.proveedor %> · <strong>Empresa:</strong> <%= d.empresa||'Pendiente' %></p><p><strong>Moneda:</strong> <%= d.moneda||'Pendiente' %> · <strong>Total neto:</strong> <%= (d.total/100).toLocaleString('es-CR',{minimumFractionDigits:2}) %> · <strong>Pagado:</strong> <%= (d.pagado/100).toLocaleString('es-CR',{minimumFractionDigits:2}) %> · <strong>Saldo actual:</strong> <%= (d.saldo/100).toLocaleString('es-CR',{minimumFractionDigits:2}) %></p><p><strong>OC:</strong> <%= d.referencia||'Sin orden asociada' %> · <strong>Vencimiento:</strong> <%= d.vencimiento||'Sin fecha' %></p><p class="text-break"><strong>Clave:</strong> <%= d.clave||'Sin clave registrada' %> · <strong>Hacienda:</strong> <%= d.hacienda||'Sin validación electrónica registrada' %></p><% if(d.url){ %><a href="<%= d.url %>">Ver documentos y gestión en el módulo de origen</a><% } %></div>
<% if(d.lineas?.length){ %><div class="table-responsive"><table class="table"><thead><tr><th>Código</th><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th></tr></thead><tbody><% d.lineas.forEach(l=>{ %><tr><td><%= l.codigo||l.codigo_producto||'' %></td><td><%= l.descripcion||'' %></td><td><%= l.cantidad||'' %></td><td><%= l.precio_unitario??'' %></td></tr><% }) %></tbody></table></div><% } %>
<% if(d.tipo==='factura'){ %><h2 class="h4">Estado: <%= d.estado %> · <%= d.estadoPago %></h2>
<% d.motivos.forEach(m=>{ %><div class="alert alert-warning"><%= m %></div><% }) %>
<p><strong>Antigüedad:</strong> <%= d.tramoVencimiento %> · <strong>Inclusión en cuentas por pagar:</strong> <%= d.incluido?'Incluida':'Excluida: consulte los motivos' %></p>
<% if(d.portal){ %><div class="card p-3 mb-3"><h3 class="h5">Revisión de factura del portal</h3><p>La aceptación se registra desde Cuentas por pagar con los controles originales del portal. Al aprobar, la factura queda disponible para Asientos.</p><% if(d.estado==='PENDIENTE'){ %><form method="post" action="/contabilidad/documentos/portal/<%= d.id %>/aceptar"><input type="hidden" name="versionPortal" value="<%= d.versionPortal %>"><button class="btn btn-success mb-2" <%= d.hacienda==='ACEPTADA'&&d.ambienteHacienda==='produccion'?'':'disabled' %>>Aceptar y pasar a cuentas por pagar</button></form><% }else if(d.estado==='ACEPTADA'){ %><a class="btn btn-success mb-2 align-self-start" href="/compras/facturas/asientos?q=<%= encodeURIComponent(d.numero) %>">Ver en Asientos</a><% } %><a class="btn btn-primary align-self-start" href="/proveeduria/portal-proveedores/facturas#portal-factura-<%= d.id %>">Revisar en el portal</a></div>
<h2 class="h4 mt-4">Historial del portal</h2><ul class="list-group"><% historial.forEach(h=>{ %><li class="list-group-item"><strong><%= h.estado %></strong> · <%= h.actor_nombre||h.actor %> · <%= h.creado_en %></li><% }) %><% if(!historial.length){ %><li class="list-group-item">Sin eventos registrados.</li><% } %></ul>
<% }else{ %><p>Documento de consulta. Los importes, pagos y correcciones se administran en su módulo de origen; no requiere una nueva aceptación en Contabilidad.</p><% } %>
<% }else{ %><p>Orden disponible para consulta. Su importe es un compromiso; no se contabiliza como saldo de una factura.</p><% } %>
</main></body></html>
