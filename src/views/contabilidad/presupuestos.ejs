<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Presupuestos · Contabilidad</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/compras.css" rel="stylesheet"><script src="/js/presupuestos.js" defer></script>
<style>body{background:#f4f6fa;color:#18263b}.fin-wrap{max-width:1500px}.fin-card{background:white;border:1px solid #dce2ec;border-radius:14px;padding:22px;margin-bottom:20px}.fin-table th{font-size:.8rem;color:#52617a;white-space:nowrap}.fin-table td{vertical-align:middle}.fin-number{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}summary{font-weight:600;cursor:pointer}.fin-muted{color:#52617a}.fin-classify{min-width:260px}.fin-classify .form-select,.fin-classify .form-control{margin-bottom:5px}.fin-stat{font-size:1.45rem;font-weight:700}label{font-size:.85rem;font-weight:600}</style><link href="/css/contabilidad-erp.css" rel="stylesheet"><script src="/js/contabilidad-erp.js" defer></script><link href="/css/contabilidad-taller.css" rel="stylesheet"></head><body class="erp-accounting">
<nav class="navbar navbar-dark bg-dark px-3"><span class="navbar-brand">Contabilidad · Presupuestos</span><div class="text-white"><%= user.usuario %> <a href="/dashboard" class="btn btn-outline-light btn-sm ms-2">Inicio</a></div></nav><%- include("../partials/contabilidad_navegacion") %>
<main class="container-fluid fin-wrap py-4">
<% const dinero=n=>(n/100).toLocaleString('es-CR',{style:'currency',currency:f.moneda}); const nombreRubro=k=>rubros.find(r=>r.key===k)?.nombre||k; const nombreDept=k=>departamentos.find(d=>d.key===k)?.nombre||k; const nombreFuente=k=>({CONTROL_RUBRO:'Control del rubro',PLANILLA:'Gasto de planilla',TALLER_ORDEN:'Orden de Taller',TALLER_FACTURA:'Factura de Taller',PROVEEDURIA:'Proveeduría / portal',CARBURACION_ORDEN:'Orden de Carburación',CARBURACION_FACTURA:'Factura de Carburación'})[k]||k;
const partidaVisible=b=>b.moneda===f.moneda&&(!f.sede||b.sede===f.sede)&&(!f.departamento||b.departamento===f.departamento)&&(!f.empresa||(f.empresa==='__SIN_EMPRESA__'?!b.empresa:b.empresa===f.empresa)); const empresaActual=f.empresa==='__SIN_EMPRESA__'?'':f.empresa; const total=filas.reduce((a,r)=>{for(const k of ['presupuesto','facturado','pagado','compromiso','disponible'])a[k]=(a[k]||0)+r[k];return a;},{});
%>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h1 class="h2 mb-1">Presupuesto y ejecución mensual</h1><a class="btn btn-outline-primary" href="/contabilidad/presupuestos/reporte.csv?<%= new URLSearchParams(f) %>">Exportar CSV para Excel</a></div><p class="fin-muted">Consulta por empresa, sede, departamento y moneda. Cada importe conserva su documento de origen.</p>
<% if(mensaje){ %><div class="alert alert-success" role="status"><%= mensaje %></div><% } %>
<section class="fin-card"><form method="get" class="row g-3 align-items-end">
<div class="col-md-2"><label for="mes" class="form-label">Mes</label><input id="mes" name="periodo" type="month" required class="form-control" value="<%= f.periodo %>"></div>
<div class="col-md-3"><label for="empresaFiltro" class="form-label">Empresa</label><select id="empresaFiltro" name="empresa" class="form-select"><option value="">Todas las empresas</option><option value="__SIN_EMPRESA__" <%= f.empresa==='__SIN_EMPRESA__'?'selected':'' %>>Sin empresa asignada</option><% empresas.forEach(e=>{ %><option <%= f.empresa===e?'selected':'' %>><%= e %></option><% }) %></select></div>
<div class="col-md-2"><label for="sedeFiltro" class="form-label">Sede</label><select id="sedeFiltro" name="sede" class="form-select"><option value="">Todas</option><% sedes.forEach(s=>{ %><option <%= f.sede===s?'selected':'' %>><%= s %></option><% }) %></select></div>
<div class="col-md-2"><label for="deptoFiltro" class="form-label">Departamento</label><select id="deptoFiltro" name="departamento" class="form-select"><option value="">Todos</option><% departamentos.forEach(d=>{ %><option value="<%= d.key %>" <%= f.departamento===d.key?'selected':'' %>><%= d.nombre %></option><% }) %></select></div>
<div class="col-md-1"><label for="monedaFiltro" class="form-label">Moneda</label><select id="monedaFiltro" name="moneda" class="form-select"><% ['CRC','USD'].forEach(m=>{ %><option <%= f.moneda===m?'selected':'' %>><%= m %></option><% }) %></select></div>
<div class="col-md-2"><button class="btn btn-primary w-100">Consultar</button></div></form></section>
<% if(user.rol==='ADMIN'&&archivos.length){ %><section class="fin-card"><h2 class="h5">Datos de los Excel de <%= f.periodo %></h2><p class="small fin-muted">Presupuestos generales por empresa. Consulte todas las hojas de cada archivo, incluido el detalle de planilla, servicios, gastos y mantenimiento. El presupuesto se suma una sola vez desde las partidas de Ordinarios.</p><div class="table-responsive"><table class="table fin-table"><thead><tr><th>Empresa / unidad</th><th>Hojas</th><th class="text-end">Presupuesto CRC</th><th>Datos originales</th></tr></thead><tbody><% archivos.forEach(a=>{ %><tr><td><%= a.empresa %></td><td><%= a.hojas %></td><td class="fin-number"><%= Number(a.total_crc).toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %></td><td><a class="btn btn-sm btn-outline-primary" href="/contabilidad/presupuestos/archivos/<%= a.id %>">Ver todas las hojas</a></td></tr><% }) %></tbody></table></div></section><% } %>
<% if(presupuestos.some(b=>!b.empresa)){ %><div class="alert alert-warning">Hay partidas anteriores sin empresa asignada. Se conservan y quedan fuera del resumen hasta que indique la empresa en <strong>Partidas registradas del mes</strong>. <a href="?<%= new URLSearchParams({periodo:f.periodo,moneda:f.moneda,empresa:'__SIN_EMPRESA__'}) %>">Revisar partidas sin empresa</a>.</div><% } %>
<% if(advertencias.length){ %><div class="alert alert-warning"><strong>Datos que requieren revisión</strong><ul class="mb-0"><% advertencias.forEach(a=>{ %><li><%= a %></li><% }) %></ul></div><% } %>
<% if(pendientesGlobales>pendientes){ %><div class="alert alert-info">Hay <%= pendientesGlobales %> documentos pendientes en el mes, considerando todas las sedes y departamentos. <a href="?<%= new URLSearchParams({periodo:f.periodo,moneda:f.moneda}) %>">Ver todas las asignaciones pendientes</a>.</div><% } %>
<% if(pendientes){ %><div class="alert alert-warning"><strong><%= pendientes %> documentos pendientes de clasificación o conciliación.</strong> Sus importes no se incluyen en los totales. La empresa debe estar confirmada. Las facturas antiguas sin moneda requieren confirmación al clasificarlas. Quite los filtros de sede y departamento para localizar documentos sin asignar.</div><% } %>
<div class="row g-3 mb-4"><% [['Presupuesto','presupuesto'],['Ejecutado / facturado del mes','facturado'],['Órdenes por facturar del mes','compromiso'],['Pagado del mes','pagado']].forEach(([label,key])=>{ %><div class="col-md-3"><div class="fin-card h-100 mb-0"><div class="fin-muted"><%= label %></div><div class="fin-stat"><%= dinero(total[key]) %></div></div></div><% }) %></div>
<% if(resumenEmpresas.length){ %><section class="fin-card"><h2 class="h5">Resumen por empresa / unidad de presupuesto · <%= f.moneda %></h2><div class="table-responsive"><table class="table fin-table"><thead><tr><th>Empresa</th><th class="text-end">Presupuesto</th><th class="text-end">Ejecutado / facturado</th><th class="text-end">Pagado</th><th class="text-end">Disponible</th><th class="text-end">Pendientes</th></tr></thead><tbody><% resumenEmpresas.forEach(e=>{ %><tr><td><a href="?<%= new URLSearchParams({...f,empresa:e.empresa}) %>"><%= e.empresa %></a></td><% ['presupuesto','facturado','pagado','disponible'].forEach(k=>{ %><td class="fin-number"><%= dinero(e[k]) %></td><% }) %><td class="fin-number"><%= e.pendientes %></td></tr><% }) %></tbody></table></div></section><% } %>
<section class="fin-card"><h2 class="h5">Ejecución por rubro · <%= f.moneda %></h2><p class="small fin-muted">Disponible = presupuesto − ejecutado / facturado − órdenes del mes pendientes de factura al cierre. Pagos y facturas se muestran por separado. No se convierten ni se suman monedas diferentes.</p>
<div class="table-responsive"><table class="table fin-table"><thead><tr><th>Rubro</th><th class="text-end">Presupuesto</th><th class="text-end">Ordenado</th><th class="text-end">Por facturar</th><th class="text-end">Ejecutado / facturado</th><th class="text-end">Pagado</th><th class="text-end">Disponible</th></tr></thead><tbody>
<% filas.forEach(r=>{ %><tr><td><% if(user.rol!=='ADMIN'){ %><%= r.nombre %><% }else if(r.key==='PLANILLA'){ %><a href="/contabilidad/presupuestos/planilla?<%= new URLSearchParams(f) %>" class="fw-semibold">Planilla <span aria-hidden="true">→</span></a><% }else{ %><a href="/contabilidad/presupuestos/rubros/<%= r.key %>?<%= new URLSearchParams(f) %>" class="fw-semibold"><%= r.nombre %> <span aria-hidden="true">→</span></a><% } %></td><% ['presupuesto','ordenado','compromiso','facturado','pagado','disponible'].forEach(k=>{ %><td class="fin-number <%= k==='disponible'&&r[k]<0?'text-danger fw-bold':'' %>"><%= dinero(r[k]) %></td><% }) %></tr><% }) %>
</tbody></table></div><p class="small fin-muted mb-0">Los importes de documentos incluyen impuestos y ajustes registrados en su origen. Esta versión clasifica el documento completo en un rubro.</p></section>
<section class="fin-card"><details><summary>Registrar o ajustar presupuesto</summary><p class="small fin-muted mt-2">Para ajustar una partida existente utilice su formulario de abajo. Guardar cero conserva la partida y su historial.</p>
<form method="post" action="/contabilidad/presupuestos/guardar" class="row g-2 mt-2"><input type="hidden" name="version" value="0"><input type="hidden" name="periodo" value="<%= f.periodo %>">
<div class="col-md-3"><label class="w-100">Empresa<input name="empresa" list="empresas" value="<%= empresaActual %>" class="form-control" required maxlength="120" placeholder="Seleccione o escriba la empresa"></label></div>
<div class="col-md-3"><label>Sede<input name="sede" list="sedes" value="<%= f.sede %>" class="form-control" required maxlength="120"></label></div>
<div class="col-md-3"><label>Departamento<select name="departamento" class="form-select" required><% departamentos.forEach(d=>{ %><option value="<%= d.key %>" <%= f.departamento===d.key?'selected':'' %>><%= d.nombre %></option><% }) %></select></label></div>
<div class="col-md-2"><label>Moneda<select name="moneda" class="form-select"><% ['CRC','USD'].forEach(m=>{ %><option <%= f.moneda===m?'selected':'' %>><%= m %></option><% }) %></select></label></div>
<div class="col-md-2"><label>Rubro<select name="rubro" class="form-select"><% rubros.forEach(r=>{ %><option value="<%= r.key %>"><%= r.nombre %></option><% }) %></select></label></div>
<div class="col-md-2"><label>Monto<input name="monto" type="number" min="0" max="999999999999.99" step="0.01" class="form-control" required></label></div><div class="col-md-9"><label class="w-100">Observación<input name="observacion" maxlength="500" class="form-control"></label></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary">Guardar partida</button></div></form></details></section>
<datalist id="empresas"><% empresas.forEach(e=>{ %><option value="<%= e %>"><% }) %></datalist>
<datalist id="sedes"><% sedes.forEach(s=>{ %><option value="<%= s %>"><% }) %></datalist>
<section class="fin-card"><details><summary>Partidas registradas del mes (<%= presupuestos.filter(partidaVisible).length %>)</summary>
<% presupuestos.filter(partidaVisible).forEach(b=>{ %>
<form method="post" action="/contabilidad/presupuestos/guardar" class="row g-2 border-top mt-3 pt-3"><% ['id','periodo','sede','departamento','moneda','rubro','version'].forEach(k=>{ %><input type="hidden" name="<%= k %>" value="<%= b[k] %>"><% }) %><div class="col-md-3"><label class="w-100">Empresa<input class="form-control" name="empresa" list="empresas" required maxlength="120" value="<%= b.empresa||'' %>" placeholder="Asignar empresa"></label></div><div class="col-md-4"><strong><%= b.sede %> · <%= nombreDept(b.departamento) %></strong><div><%= nombreRubro(b.rubro) %> · <%= b.moneda %> · versión <%= b.version %></div></div><div class="col-md-2"><label>Monto<input class="form-control" name="monto" type="number" min="0" step="0.01" required value="<%= b.monto %>"></label></div><div class="col-md-4"><label class="w-100">Observación<input class="form-control" name="observacion" maxlength="500" value="<%= b.observacion %>"></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary">Guardar ajuste</button></div></form><% }) %></details></section>
<section class="fin-card"><details><summary>Copiar presupuesto de otro mes</summary><form method="post" action="/contabilidad/presupuestos/copiar" class="d-flex gap-3 align-items-end mt-3 flex-wrap"><% Object.entries(f).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><label>Mes de origen<input class="form-control" name="origen" type="month" required></label><button class="btn btn-outline-primary">Copiar a <%= f.periodo %></button></form><p class="small fin-muted mt-2 mb-0">Se aplican los filtros actuales. Se conservan las partidas que ya existen en el destino.</p></details></section>
<section class="fin-card"><details <%= importacion?'open':'' %>><summary>Importar presupuesto de Excel</summary><p class="small fin-muted mt-2">Presupuesto individual con una hoja Ordinarios. Se lee la columna D (colones), se excluyen subtotales y se agrupan partidas por rubro. Elija manualmente el mes y la sede correctos: los nombres de archivo pueden indicar otro período. Esta opción no importa el consolidado, planillas individuales ni pagos.</p>
<form method="post" action="/contabilidad/presupuestos/importar/preview" data-excel-form class="row g-2"><input type="hidden" name="archivo"><input type="hidden" name="moneda" value="CRC"><div class="col-md-3"><label class="w-100">Empresa<input name="empresa" list="empresas" required class="form-control" maxlength="120" value="<%= empresaActual %>" placeholder="Seleccione o escriba la empresa"></label></div><div class="col-md-2"><label>Mes<input type="month" name="periodo" required class="form-control" value="<%= f.periodo %>"></label></div><div class="col-md-3"><label>Sede<input name="sede" list="sedes" required class="form-control" maxlength="120" value="<%= f.sede %>"></label></div><div class="col-md-3"><label>Departamento<select name="departamento" class="form-select"><% departamentos.forEach(d=>{ %><option value="<%= d.key %>" <%= f.departamento===d.key?'selected':'' %>><%= d.nombre %></option><% }) %></select></label></div><div class="col-md-4"><label>Archivo .xlsx<input type="file" accept=".xlsx" required class="form-control"></label></div><div><button class="btn btn-outline-primary" type="submit">Preparar vista previa</button> <span role="status"></span></div></form>
<% if(importacion){ %><hr><h3 class="h6">Vista previa: <%= importacion.hoja %> · <%= importacion.empresa||'Empresa pendiente' %> · <%= importacion.periodo %> · <%= importacion.sede %> · <%= nombreDept(importacion.departamento) %> · CRC</h3><p><strong>Total leído: <%= importacion.totalImportado.toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %>. Total de control: <%= Number(importacion.totalControl).toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %>.</strong></p><p>No se ha guardado todavía. Los valores son los resultados almacenados por Excel; no se recalcularon vínculos externos.</p><% if(importacion.errores.length){ %><div class="alert alert-warning">Corrija los errores y vuelva a cargar: <%= importacion.errores.join('; ') %></div><% } %><div class="table-responsive" style="max-height:350px"><table class="table"><thead><tr><th>Celda</th><th>Concepto</th><th>Rubro</th><th>Monto CRC</th></tr></thead><tbody><% importacion.filas.forEach(r=>{ %><tr><td><%= r.celda %></td><td><%= r.concepto %></td><td><%= nombreRubro(r.rubro) %></td><td><%= r.monto.toLocaleString('es-CR',{minimumFractionDigits:2}) %></td></tr><% }) %></tbody></table></div><div class="d-flex gap-2"><form method="post" action="/contabilidad/presupuestos/importar/confirmar"><input name="token" type="hidden" value="<%= importacion.token %>"><button class="btn btn-primary" <%= importacion.errores.length?'disabled':'' %>>Confirmar importación</button></form><form method="post" action="/contabilidad/presupuestos/importar/cancelar"><% Object.entries(f).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><button class="btn btn-outline-secondary">Cancelar vista previa</button></form></div><% } %></details></section>
<section class="fin-card"><h2 class="h5" id="documentos">Documentos del mes (<%= documentos.length %> de <%= documentosTotal %>)</h2>
<form method="get" class="row g-3 align-items-end mb-3"><% Object.entries(f).filter(([k])=>!['estado_documento','fuente_documento'].includes(k)).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><div class="col-md-4"><label class="w-100">Estado<select name="estado_documento" class="form-select"><% [['todos','Todos'],['pendientes','Pendientes / excluidos'],['incluidos','Incluidos en el resumen']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= f.estado_documento===key?'selected':'' %>><%= label %></option><% }) %></select></label></div><div class="col-md-4"><label class="w-100">Origen<select name="fuente_documento" class="form-select"><option value="">Todos los orígenes</option><% ['TALLER_ORDEN','TALLER_FACTURA','PROVEEDURIA','CARBURACION_ORDEN','CARBURACION_FACTURA','PLANILLA','CONTROL_RUBRO'].forEach(key=>{ %><option value="<%= key %>" <%= f.fuente_documento===key?'selected':'' %>><%= nombreFuente(key) %></option><% }) %></select></label></div><div class="col-md-4"><button class="btn btn-primary">Filtrar documentos</button></div></form><p class="small fin-muted">El filtro de documentos solo cambia esta lista; los indicadores conservan el total del período, empresa y moneda seleccionados.</p><p class="small fin-muted">Las operaciones sin empresa asignada se consultan con el filtro correspondiente. Las operaciones sin moneda confirmada aparecen para revisión tanto en CRC como en USD y se excluyen del resumen. La clasificación se conserva al cambiar de mes.</p>
<div class="table-responsive"><table class="table fin-table"><thead><tr><th>Documento y origen</th><th>Ordenado</th><th>Ejecutado / facturado</th><th>Pagado</th><th>Clasificación</th></tr></thead><tbody>
<% if(!documentos.length){ %><tr><td colspan="5" class="text-center py-4">No hay documentos para estos filtros.</td></tr><% } %>
<% if(!documentos.length){ %><tr><td colspan="5" class="text-center py-4 text-secondary">No hay documentos para estos filtros.</td></tr><% } %>
<% documentos.slice((pagina-1)*50,pagina*50).forEach(d=>{ %><tr><td><strong><%= d.referencia %></strong><div><%= d.proveedor %></div><% if(d.empresaOrigen&&d.empresaOrigen!==d.empresa){ %><div class="small fin-muted">Empresa del documento: <%= d.empresaOrigen %></div><% } %><div class="small"><%= d.esGasto?'Gasto registrado:':d.esRegistro?'Movimiento registrado:':'Factura:' %> <%= d.numeroFactura||(d.esGasto?'Planilla':d.esRegistro?nombreRubro(d.rubro):'Pendiente') %><% if(d.fechaFactura){ %> · <%= d.fechaFactura %><% } %></div><small class="fin-muted"><%= d.empresa||'Empresa por asignar' %> · <%= nombreFuente(d.fuente) %> · <%= d.moneda||'Moneda por confirmar' %></small><% if(d.fechaEstimada){ %><div class="small text-warning">Fecha de recepción usada para la factura.</div><% } %><% if(d.tieneFactura&&!d.fechaFactura){ %><div class="small text-danger">Factura sin fecha: excluida de facturación mensual.</div><% } %><% if(d.duplicado){ %><div class="small text-danger">Clave repetida: requiere conciliación.</div><% } %><% if(d.motivoExclusion){ %><div class="small text-danger"><%= d.motivoExclusion %></div><% }else{ %><div class="badge text-bg-success">Incluido en el resumen</div><% } %></td><td class="fin-number"><%= dinero(d.ordenMes) %></td><td class="fin-number"><%= dinero(d.facturaMes) %></td><td class="fin-number"><%= dinero(d.pagoMes) %></td><td class="fin-classify"><% if(d.fuente==='PLANILLA'){ %><a class="btn btn-sm btn-outline-primary" href="/contabilidad/presupuestos/planilla?<%= new URLSearchParams({...f,empresa:d.empresa}) %>">Ver control de planilla</a><% }else if(d.fuente==='CONTROL_RUBRO'){ %><a class="btn btn-sm btn-outline-primary" href="/contabilidad/presupuestos/rubros/<%= d.rubro %>?<%= new URLSearchParams({...f,empresa:d.empresa}) %>">Ver control del rubro</a><% }else{ %><details><summary><%= d.clasificado?nombreRubro(d.rubro):'Clasificar documento' %></summary><form method="post" action="/contabilidad/presupuestos/clasificar" class="mt-2"><% Object.entries(f).filter(([k])=>!['empresa','sede','departamento','moneda'].includes(k)).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><input type="hidden" name="fuente" value="<%= d.fuente %>"><input type="hidden" name="documento_id" value="<%= d.id %>"><label class="w-100">Empresa<input name="empresa" list="empresas" class="form-control form-control-sm" required maxlength="120" value="<%= d.empresa||empresaActual %>" ></label><label class="w-100">Sede<input name="sede" list="sedes" class="form-control form-control-sm" required maxlength="120" value="<%= d.sede||f.sede %>"></label><label class="w-100">Departamento<select name="departamento" class="form-select form-select-sm"><% departamentos.forEach(a=>{ %><option value="<%= a.key %>" <%= d.departamento===a.key?'selected':'' %>><%= a.nombre %></option><% }) %></select></label><label class="w-100">Moneda<select name="moneda" class="form-select form-select-sm" required><option value="">Confirmar moneda</option><% ['CRC','USD'].forEach(m=>{ %><option <%= d.moneda===m?'selected':'' %>><%= m %></option><% }) %></select></label><label class="w-100">Rubro<select name="rubro" class="form-select form-select-sm" required><option value="">Seleccionar rubro</option><% rubros.forEach(r=>{ %><option value="<%= r.key %>" <%= d.rubro===r.key?'selected':'' %>><%= r.nombre %></option><% }) %></select></label><button class="btn btn-sm btn-primary">Guardar clasificación</button></form></details><% } %></td></tr><% }) %></tbody></table></div><% if(documentos.length>50){const paginas=Math.ceil(documentos.length/50); %><nav aria-label="Páginas de documentos" class="d-flex gap-3 align-items-center"><% if(pagina>1){ %><a class="btn btn-outline-primary" href="?<%= new URLSearchParams({...f,pagina:pagina-1}) %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if(pagina<paginas){ %><a class="btn btn-outline-primary" href="?<%= new URLSearchParams({...f,pagina:pagina+1}) %>">Siguiente</a><% } %></nav><% } %></section>
<p class="small fin-muted">Fuentes de esta etapa: órdenes y facturas de Taller, Proveeduría, portal de proveedores y Carburación, con sus pagos asociados, y registros reales de Planilla y los controles por rubro. Caja chica, órdenes de motor y registros independientes de pagos a proveedores requieren conciliación antes de incorporarse.</p>
<section class="fin-card"><details><summary>Historial de cambios recientes</summary><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Referencia</th></tr></thead><tbody><% historial.forEach(h=>{ %><tr><td><%= new Date(h.creado_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %></td><td><%= h.usuario||(Number(h.actor)===0?'Importación del sistema':h.actor) %></td><td><%= h.accion %></td><td><%= h.referencia %></td></tr><% }) %></tbody></table></div></details></section>
</main></body></html>
