<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= archivo.empresa %> · Excel de <%= archivo.periodo %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/compras.css" rel="stylesheet"><style>body{background:#f4f6fa;color:#18263b}.excel-panel{background:white;border:1px solid #dce2ec;border-radius:14px;padding:20px;margin-bottom:20px}.excel-scroll{max-height:72vh;overflow:auto}.excel-table{font-size:.85rem;width:max-content;min-width:100%}.excel-table th{position:sticky;top:0;background:#edf2f8;z-index:1}.excel-table td{min-width:100px;max-width:320px;white-space:normal;overflow-wrap:anywhere}.excel-table td.numero{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.excel-table details{white-space:normal;max-width:260px}.excel-table code{white-space:pre-wrap}.sheet-link{display:inline-block;margin:3px;padding:7px 12px;border:1px solid #cbd6e6;border-radius:8px;text-decoration:none}.sheet-link.active{background:#245ff0;color:white}</style><link href="/css/contabilidad-erp.css" rel="stylesheet"><script src="/js/contabilidad-erp.js" defer></script><link href="/css/contabilidad-taller.css" rel="stylesheet"></head><body class="erp-accounting">
<nav class="navbar navbar-dark bg-dark px-3"><span class="navbar-brand">Contabilidad · Datos del Excel</span><span class="text-white"><%= user.usuario %></span></nav><%- include("../partials/contabilidad_navegacion") %><main class="container-fluid py-4">
<div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><div><h1 class="h3"><%= archivo.empresa %> · <%= archivo.periodo %></h1><p class="text-secondary mb-0"><%= archivo.nombre %></p></div><div><a class="btn btn-outline-primary" href="/contabilidad/presupuestos?periodo=<%= archivo.periodo %>&empresa=<%= encodeURIComponent(archivo.empresa) %>">Volver al presupuesto</a> <a class="btn btn-outline-secondary" href="/contabilidad/presupuestos/archivos/<%= archivo.id %>/original">Descargar Excel original</a></div></div>
<div class="excel-panel"><p class="mb-2"><strong><%= datos.hojas.length %> hojas guardadas</strong>, incluidas las ocultas. Período de la hoja principal: <%= datos.periodoOriginal %>. Los valores y las fórmulas corresponden al archivo recibido.</p><p class="small text-secondary mb-0">El presupuesto usa las partidas de <strong><%= datos.hojaPresupuesto %></strong>. Las otras hojas aportan detalle y controles; sus subtotales no se vuelven a sumar. No se recalcularon vínculos externos ni se registraron estos datos como pagos o gastos reales.</p></div>
<% if(datos.errores||datos.sinResultado){ %><div class="alert alert-warning">El libro conserva <%= datos.errores %> celdas con errores de referencia o cálculo y <%= datos.sinResultado %> fórmulas sin resultado guardado. Se muestran como pendientes, sin reemplazarlas por cero. Las partidas del presupuesto fueron comprobadas por separado contra su total de control.</div><% } %>
<section class="excel-panel"><h2 class="h5">Hojas del archivo</h2><nav aria-label="Hojas del Excel"><% datos.hojas.forEach((h,i)=>{ %><a class="sheet-link <%= i===indice?'active':'' %>" href="<%= urlHoja(h,i) %>"><%= h.nombre %><%= h.oculta?' (oculta en Excel)':'' %></a><% }) %></nav></section>
<section class="excel-panel"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h2 class="h5"><%= hoja.nombre %></h2><span class="small text-secondary"><%= hoja.filas.length %> filas con datos · <%= hoja.errores %> errores · <%= hoja.sinResultado %> resultados pendientes</span></div>
<% const mostrar=c=>{if(c.valor===null)return 'Sin resultado guardado';if(c.esFecha){const d=new Date((c.valor-25569)*86400000);return Number.isNaN(d.getTime())?String(c.valor):d.toLocaleDateString('es-CR',{timeZone:'UTC'});}return typeof c.valor==='number'?c.valor.toLocaleString('es-CR',{maximumSignificantDigits:15}):String(c.valor);}; %>
<div class="excel-scroll mt-3"><table class="table table-bordered excel-table"><thead><tr><th>Fila</th><% columnas.forEach(c=>{ %><th><%= c %></th><% }) %></tr></thead><tbody><% filas.forEach(r=>{const mapa=new Map(r.celdas.map(c=>[c.direccion.replace(/\d/g,''),c])); %><tr><th scope="row"><%= r.numero %></th><% columnas.forEach(col=>{const c=mapa.get(col); %><td class="<%= c?.tipo==='numero'?'numero':'' %> <%= c?.tipo==='error'||c?.valor===null?'table-warning':'' %>"><% if(c){ %><span title="<%= c.direccion %>"><%= mostrar(c) %></span><% if(Object.hasOwn(c,'formula')){ %><details class="small text-secondary"><summary>Fórmula</summary><code><%= c.formula||('Compartida: '+(c.formulaCompartida??'')) %></code></details><% } %><% } %></td><% }) %></tr><% }) %></tbody></table></div>
<nav aria-label="Filas de la hoja" class="d-flex align-items-center gap-3 mt-3"><% if(pagina>1){ %><a class="btn btn-outline-primary" href="?hoja=<%= indice %>&pagina=<%= pagina-1 %>">Anterior</a><% } %><span>Página <%= pagina %> de <%= paginas %></span><% if(pagina<paginas){ %><a class="btn btn-outline-primary" href="?hoja=<%= indice %>&pagina=<%= pagina+1 %>">Siguiente</a><% } %></nav></section>
<section class="excel-panel"><details><summary class="fw-semibold">Partidas que forman el presupuesto (<%= datos.partidas.length %>)</summary><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Hoja</th><th>Celda</th><th>Concepto</th><th>Rubro</th><th>CRC</th></tr></thead><tbody><% datos.partidas.forEach(p=>{ %><tr><td><%= datos.hojaPresupuesto %></td><td><%= p.celda %></td><td><%= p.concepto %></td><td><%= p.rubro %></td><td><%= p.monto.toLocaleString('es-CR',{minimumFractionDigits:2}) %></td></tr><% }) %></tbody></table></div><p class="mb-0">Total importado: <strong><%= Number(archivo.total_crc).toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %></strong>. Total de control del Excel: <%= Number(datos.totalControl).toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %>.</p></details></section>
</main></body></html>
