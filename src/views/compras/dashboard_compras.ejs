<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard de Compras</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      background: linear-gradient(135deg, #f5f7fc 0%, #eef2f6 100%);
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      padding-bottom: 2rem;
    }

    .navbar {
      box-shadow: 0 4px 14px rgba(0,0,0,.15);
    }

    .stat-card {
      background: white;
      border-radius: 24px;
      padding: 1.2rem;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
      height: 100%;
      border: none;
    }

    .stat-number {
      font-size: 1.8rem;
      font-weight: 800;
      color: #1e293b;
      line-height: 1.2;
      word-break: break-word;
    }

    .stat-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      font-weight: 700;
      color: #64748b;
      letter-spacing: .5px;
    }

    .stat-icon {
      font-size: 2rem;
      background: rgba(31, 41, 55, 0.08);
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 18px;
      flex-shrink: 0;
    }

    .chart-card {
      background: white;
      border-radius: 24px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
      border: none;
      overflow: hidden;
      height: 100%;
    }

    .chart-card .card-header {
      background: transparent;
      border-bottom: 1px solid #eef2f6;
      padding: 1.2rem 1.5rem;
      font-weight: 800;
      font-size: 1.05rem;
      color: #1f2937;
    }

    .chart-card .card-body {
      padding: 1.2rem;
    }

    canvas {
      width: 100% !important;
      max-height: 290px;
    }

    .empty-msg {
      text-align: center;
      color: #64748b;
      padding: 2rem;
      font-weight: 600;
    }

    /* Filtros card */
    .filtros-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.03);
      padding: 1.2rem 1.5rem;
      margin-bottom: 1.8rem;
    }

    @media (max-width: 768px) {
      .stat-number { font-size: 1.4rem; }
      .navbar .text-white {
        flex-direction: column;
        align-items: flex-start !important;
        gap: .5rem !important;
      }
    }
  </style>
</head>

<body>

<%
  const safeUser = user || {};
  const safeTotalGasto = Number(totalGasto || 0);

  const safeTopProveedores = Array.isArray(topProveedores) ? topProveedores : [];
  const safeGastoMensual = Array.isArray(gastoMensual) ? gastoMensual : [];
  const safeTopProductos = Array.isArray(topProductos) ? topProductos : [];
  const safeOrdenesPorEstado = Array.isArray(ordenesPorEstado) ? ordenesPorEstado : [];
  const safeTodosProveedores = Array.isArray(todosProveedoresGasto) ? todosProveedoresGasto : [];

  const proveedorTop = safeTopProveedores[0] || {};
  const productoTop = safeTopProductos[0] || {};

  const gastoProveedorTop = Number(proveedorTop.total_gastado || 0);
  const vecesProveedorTop = gastoProveedorTop > 0 ? (safeTotalGasto / gastoProveedorTop).toFixed(1) : '0.0';

  // Proveedores para el selector de filtros
  const proveedoresList = Array.isArray(proveedores) ? proveedores : [];
  const estadosList = Array.isArray(estados) ? estados : ['BORRADOR', 'ENVIADA', 'RECIBIDA_PARCIAL', 'RECIBIDA_TOTAL'];
  const filtrosActuales = filtros || {};
%>

<nav class="navbar navbar-dark bg-dark px-4 py-3">
  <span class="navbar-brand fw-semibold fs-5">
    <i class="bi bi-graph-up"></i> Dashboard de Compras
  </span>
  <div class="text-white d-flex align-items-center gap-3">
    <span><i class="bi bi-person-circle me-1"></i> <%= safeUser.usuario || 'Usuario' %> (<%= safeUser.rol || 'Sin rol' %>)</span>
    <a href="/compras/ordenes" class="btn btn-sm btn-outline-light rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>
</nav>

<div class="container py-4">

  <!-- Formulario de filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar dashboard</h5>
    <form method="GET" action="/compras/dashboard" class="row g-3">
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedoresList.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtrosActuales.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estadosList.forEach(est => { %>
            <option value="<%= est %>" <%= filtrosActuales.estado === est ? 'selected' : '' %>><%= est.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/dashboard" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <!-- KPIs -->
  <div class="row g-4 mb-5">
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number">₡<%= safeTotalGasto.toLocaleString('es-CR') %></div>
          <div class="stat-label mt-1">Gasto total</div>
        </div>
        <div class="stat-icon"><i class="bi bi-cash-stack text-success"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= proveedorTop.nombre || '—' %></div>
          <div class="stat-label mt-1">Principal proveedor</div>
        </div>
        <div class="stat-icon"><i class="bi bi-building text-primary"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= Number(productoTop.total_cantidad || 0).toLocaleString('es-CR') %></div>
          <div class="stat-label mt-1">Unidades del artículo top</div>
        </div>
        <div class="stat-icon"><i class="bi bi-box-seam text-warning"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= vecesProveedorTop %>x</div>
          <div class="stat-label mt-1">Veces al proveedor top</div>
        </div>
        <div class="stat-icon"><i class="bi bi-receipt text-info"></i></div>
      </div>
    </div>
  </div>

  <!-- Gráficos fila 1 -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-bar-chart-steps me-2"></i> Top 5 proveedores por gasto</div>
        <div class="card-body">
          <% if (safeTopProveedores.length) { %>
            <canvas id="chartProveedores"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de proveedores.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-calendar-week me-2"></i> Evolución mensual del gasto</div>
        <div class="card-body">
          <% if (safeGastoMensual.length) { %>
            <canvas id="chartMensual"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos mensuales.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráficos fila 2 -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-box me-2"></i> Top 5 productos más comprados</div>
        <div class="card-body">
          <% if (safeTopProductos.length) { %>
            <canvas id="chartProductos"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de productos.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-pie-chart me-2"></i> Órdenes por estado</div>
        <div class="card-body">
          <% if (safeOrdenesPorEstado.length) { %>
            <canvas id="chartEstados"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de estados.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== NUEVA SECCIÓN: TODOS LOS PROVEEDORES Y GASTO ===================== -->
  <div class="row g-4 mt-2">
    <div class="col-12">
      <div class="chart-card">
        <div class="card-header">
          <i class="bi bi-bar-chart-steps me-2"></i> Todos los proveedores por gasto (gráfico)
        </div>
        <div class="card-body">
          <% if (safeTodosProveedores.length) { %>
            <canvas id="chartTodosProveedores" style="max-height: 400px;"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de proveedores.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-12">
      <div class="chart-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-table me-2"></i> Detalle de gasto por proveedor</span>
          <a href="/compras/dashboard/proveedores/pdf?proveedor_id=<%= encodeURIComponent(filtrosActuales.proveedor_id || '') %>&fecha_desde=<%= encodeURIComponent(filtrosActuales.fecha_desde || '') %>&fecha_hasta=<%= encodeURIComponent(filtrosActuales.fecha_hasta || '') %>&estado=<%= encodeURIComponent(filtrosActuales.estado || '') %>" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-download"></i> Descargar PDF
          </a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Proveedor</th>
                  <th class="text-end">Total gastado (₡)</th>
                </tr>
              </thead>
              <tbody>
                <% safeTodosProveedores.forEach(p => { %>
                  <tr>
                    <td><%= p.nombre %></td>
                    <td class="text-end"><%= parseFloat(p.total_gastado).toLocaleString('es-CR') %></td>
                  </tr>
                <% }) %>
                <% if (safeTodosProveedores.length === 0) { %>
                  <tr><td colspan="2" class="text-center">No hay datos de proveedores</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script type="application/json" id="data-top-proveedores"><%- JSON.stringify(safeTopProveedores) %></script>
<script type="application/json" id="data-gasto-mensual"><%- JSON.stringify(safeGastoMensual) %></script>
<script type="application/json" id="data-top-productos"><%- JSON.stringify(safeTopProductos) %></script>
<script type="application/json" id="data-ordenes-estado"><%- JSON.stringify(safeOrdenesPorEstado) %></script>
<script type="application/json" id="data-todos-proveedores"><%- JSON.stringify(safeTodosProveedores) %></script>

<script>
  const leerJSON = (id) => {
    const elemento = document.getElementById(id);
    if (!elemento) return [];
    try {
      return JSON.parse(elemento.textContent || '[]');
    } catch (error) {
      console.error('Error leyendo JSON:', id, error);
      return [];
    }
  };

  const topProveedores = leerJSON('data-top-proveedores');
  const gastoMensual = leerJSON('data-gasto-mensual');
  const topProductos = leerJSON('data-top-productos');
  const ordenesPorEstado = leerJSON('data-ordenes-estado');
  const todosProveedores = leerJSON('data-todos-proveedores');

  const formatCurrency = (value) => {
    const number = Number(value || 0);
    return '₡ ' + number.toLocaleString('es-CR');
  };

  const cortaTexto = (texto, largo) => {
    texto = String(texto || '');
    return texto.length > largo ? texto.substring(0, largo - 3) + '...' : texto;
  };

  // Gráfico: Top proveedores
  const canvasProveedores = document.getElementById('chartProveedores');
  if (canvasProveedores && topProveedores.length) {
    new Chart(canvasProveedores, {
      type: 'bar',
      data: {
        labels: topProveedores.map(p => cortaTexto(p.nombre, 25)),
        datasets: [{
          label: 'Monto gastado',
          data: topProveedores.map(p => Number(p.total_gastado || 0)),
          backgroundColor: '#1f2937',
          borderRadius: 12
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } } },
        scales: { y: { ticks: { callback: value => formatCurrency(value) } } }
      }
    });
  }

  // Gráfico: Evolución mensual
  const canvasMensual = document.getElementById('chartMensual');
  if (canvasMensual && gastoMensual.length) {
    new Chart(canvasMensual, {
      type: 'line',
      data: {
        labels: gastoMensual.map(g => g.mes || 'Sin mes'),
        datasets: [{
          label: 'Gasto',
          data: gastoMensual.map(g => Number(g.total || 0)),
          borderColor: '#1f2937',
          backgroundColor: 'rgba(31,41,55,0.08)',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } } },
        scales: { y: { ticks: { callback: value => formatCurrency(value) } } }
      }
    });
  }

  // Gráfico: Top productos
  const canvasProductos = document.getElementById('chartProductos');
  if (canvasProductos && topProductos.length) {
    new Chart(canvasProductos, {
      type: 'bar',
      data: {
        labels: topProductos.map(p => cortaTexto(p.descripcion, 35)),
        datasets: [{
          label: 'Cantidad comprada',
          data: topProductos.map(p => Number(p.total_cantidad || 0)),
          backgroundColor: '#2d6a4f',
          borderRadius: 10
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => `${ctx.raw} unidades` } } }
      }
    });
  }

  // Gráfico: Órdenes por estado
  const canvasEstados = document.getElementById('chartEstados');
  if (canvasEstados && ordenesPorEstado.length) {
    const colores = {
      BORRADOR: '#6c757d',
      ENVIADA: '#0dcaf0',
      RECIBIDA_PARCIAL: '#ffc107',
      RECIBIDA_TOTAL: '#198754',
      ANULADA: '#dc3545'
    };
    new Chart(canvasEstados, {
      type: 'pie',
      data: {
        labels: ordenesPorEstado.map(e => String(e.estado || 'SIN ESTADO').replaceAll('_', ' ')),
        datasets: [{
          data: ordenesPorEstado.map(e => Number(e.cantidad || 0)),
          backgroundColor: ordenesPorEstado.map(e => colores[e.estado] || '#adb5bd'),
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'right' },
          tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.raw} órdenes` } }
        }
      }
    });
  }

  // ========== NUEVO GRÁFICO: Todos los proveedores (barras horizontales) ==========
  const canvasTodos = document.getElementById('chartTodosProveedores');
  if (canvasTodos && todosProveedores.length) {
    // Mostramos solo los primeros 20 para no saturar el gráfico
    const datosGrafico = todosProveedores.slice(0, 20);
    new Chart(canvasTodos, {
      type: 'bar',
      data: {
        labels: datosGrafico.map(p => cortaTexto(p.nombre, 30)),
        datasets: [{
          label: 'Monto gastado (₡)',
          data: datosGrafico.map(p => Number(p.total_gastado || 0)),
          backgroundColor: '#1f2937',
          borderRadius: 8
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { position: 'top' },
          tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } }
        },
        scales: {
          x: { ticks: { callback: val => formatCurrency(val) } }
        }
      }
    });
  }
</script>

</body>
</html>