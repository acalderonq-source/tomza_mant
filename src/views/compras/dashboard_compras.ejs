<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard de Compras</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      background: linear-gradient(135deg, #f5f7fc 0%, #eef2f6 100%);
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      padding-bottom: 2rem;
    }

    .navbar {
      box-shadow: 0 4px 14px rgba(0,0,0,.15);
    }

    .stat-card {
      background: white;
      border-radius: 24px;
      padding: 1.2rem;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
      height: 100%;
      border: none;
    }

    .stat-number {
      font-size: 1.8rem;
      font-weight: 800;
      color: #1e293b;
      line-height: 1.2;
      word-break: break-word;
    }

    .stat-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      font-weight: 700;
      color: #64748b;
      letter-spacing: .5px;
    }

    .stat-icon {
      font-size: 2rem;
      background: rgba(31, 41, 55, 0.08);
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 18px;
      flex-shrink: 0;
    }

    .chart-card {
      background: white;
      border-radius: 24px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
      border: none;
      overflow: hidden;
      height: 100%;
    }

    .chart-card .card-header {
      background: transparent;
      border-bottom: 1px solid #eef2f6;
      padding: 1.2rem 1.5rem;
      font-weight: 800;
      font-size: 1.05rem;
      color: #1f2937;
    }

    .chart-card .card-body {
      padding: 1.2rem;
    }

    canvas {
      width: 100% !important;
      max-height: 290px;
    }

    .empty-msg {
      text-align: center;
      color: #64748b;
      padding: 2rem;
      font-weight: 600;
    }

    .placa-node {
      background: linear-gradient(135deg, #081f55 0%, #0b3b82 58%, #ef233c 100%);
      color: white;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 18px 36px rgba(8, 31, 85, 0.18);
    }

    .placa-node-header {
      padding: 1.35rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }

    .placa-node-title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 900;
    }

    .placa-node-subtitle {
      margin: .25rem 0 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: .9rem;
    }

    .placa-node-body {
      background: rgba(255, 255, 255, 0.96);
      color: #0f172a;
      padding: 1.25rem;
    }

    .placa-chip {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .45rem .75rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
      color: white;
      font-size: .8rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .placa-table th {
      font-size: .72rem;
      text-transform: uppercase;
      color: #475569;
      letter-spacing: .04em;
    }

    .placa-table td {
      vertical-align: middle;
      font-weight: 600;
    }

    .placa-link {
      border: 0;
      border-radius: 999px;
      background: #0f172a;
      color: #fff;
      font-size: .78rem;
      font-weight: 900;
      padding: .28rem .65rem;
      line-height: 1;
      transition: transform .15s ease, background .15s ease;
    }

    .placa-link:hover {
      background: #ef233c;
      transform: translateY(-1px);
    }

    .placa-drilldown {
      display: grid;
      gap: .75rem;
      max-height: 440px;
      overflow: auto;
      padding-right: .35rem;
    }

    .drill-card {
      border: 1px solid #dbe4f0;
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
    }

    .drill-row {
      width: 100%;
      border: 0;
      background: #fff;
      color: #0f172a;
      padding: .72rem .85rem;
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: .75rem;
      align-items: center;
      text-align: left;
      font-weight: 900;
    }

    .drill-row:hover {
      background: #f8fafc;
    }

    .drill-row-main {
      min-width: 0;
    }

    .drill-row-title {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .drill-row-sub {
      display: block;
      margin-top: .12rem;
      color: #64748b;
      font-size: .75rem;
      font-weight: 700;
    }

    .drill-amount {
      white-space: nowrap;
      color: #0b3b82;
      font-weight: 950;
    }

    .drill-caret {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #eef2ff;
      color: #0b3b82;
      font-size: .9rem;
      transition: transform .15s ease;
    }

    .drill-row[aria-expanded="true"] .drill-caret {
      transform: rotate(90deg);
    }

    .drill-row-category {
      background: #0f2f70;
      color: #fff;
    }

    .drill-row-category:hover {
      background: #143a86;
    }

    .drill-row-category .drill-row-sub,
    .drill-row-category .drill-amount {
      color: rgba(255,255,255,.82);
    }

    .drill-row-category .drill-caret {
      background: rgba(255,255,255,.18);
      color: #fff;
    }

    .drill-panel {
      display: none;
      border-top: 1px solid #e5edf7;
    }

    .drill-panel.is-open {
      display: block;
    }

    .drill-sede-block {
      border-top: 1px solid #e5edf7;
    }

    .drill-sede-block:first-child {
      border-top: 0;
    }

    .drill-placas {
      width: 100%;
      border-collapse: collapse;
      font-size: .86rem;
      background: #fbfdff;
    }

    .drill-placas td {
      padding: .55rem .85rem .55rem 1.25rem;
      border-top: 1px solid #edf2f7;
      vertical-align: middle;
    }

    .drill-placas td:last-child {
      text-align: right;
      white-space: nowrap;
      font-weight: 900;
    }

    .placa-detail-backdrop {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(15, 23, 42, .62);
      backdrop-filter: blur(4px);
    }

    .placa-detail-backdrop.is-open {
      display: flex;
    }

    .placa-detail-modal {
      width: min(980px, 100%);
      max-height: 88vh;
      overflow: hidden;
      background: #fff;
      color: #0f172a;
      border-radius: 22px;
      box-shadow: 0 24px 70px rgba(0, 0, 0, .28);
      display: flex;
      flex-direction: column;
    }

    .placa-detail-head {
      background: linear-gradient(135deg, #071a44 0%, #0b3b82 65%, #ef233c 100%);
      color: #fff;
      padding: 1.1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
    }

    .placa-detail-body {
      padding: 1rem 1.25rem 1.25rem;
      overflow: auto;
    }

    .placa-detail-close {
      border: 1px solid rgba(255,255,255,.35);
      background: rgba(255,255,255,.12);
      color: #fff;
      border-radius: 999px;
      width: 38px;
      height: 38px;
      font-size: 1.2rem;
      line-height: 1;
    }

    .orden-detail-card {
      border: 1px solid #dbe4f0;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 1rem;
      background: #fff;
    }

    .orden-detail-top {
      background: #f8fafc;
      padding: .85rem 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .75rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .orden-detail-meta {
      color: #475569;
      font-size: .86rem;
      font-weight: 600;
    }

    .orden-observacion {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 12px;
      padding: .65rem .8rem;
      color: #7c2d12;
      font-size: .88rem;
      margin: .75rem 1rem 0;
    }

    /* Filtros card */
    .filtros-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.03);
      padding: 1.2rem 1.5rem;
      margin-bottom: 1.8rem;
    }

    @media (max-width: 768px) {
      .stat-number { font-size: 1.4rem; }
      .navbar .text-white {
        flex-direction: column;
        align-items: flex-start !important;
        gap: .5rem !important;
      }
      .placa-node-header {
        align-items: flex-start;
        flex-direction: column;
      }
      .orden-detail-top {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>

<body>

<%
  const safeUser = user || {};
  const safeTotalGasto = Number(totalGasto || 0);

  const safeTopProveedores = Array.isArray(topProveedores) ? topProveedores : [];
  const safeGastoMensual = Array.isArray(gastoMensual) ? gastoMensual : [];
  const safeTopProductos = Array.isArray(topProductos) ? topProductos : [];
  const safeOrdenesPorEstado = Array.isArray(ordenesPorEstado) ? ordenesPorEstado : [];
  const safeTodosProveedores = Array.isArray(todosProveedoresGasto) ? todosProveedoresGasto : [];
  const safeGastosPorPlaca = Array.isArray(gastosPorPlaca) ? gastosPorPlaca : [];
  const safeGastosPorPlacaAgrupados = Array.isArray(gastosPorPlacaAgrupados) ? gastosPorPlacaAgrupados : [];
  const safeComprasPorPlaca = comprasPorPlaca && typeof comprasPorPlaca === 'object' ? comprasPorPlaca : {};

  const proveedorTop = safeTopProveedores[0] || {};
  const productoTop = safeTopProductos[0] || {};
  const placaTop = safeGastosPorPlaca[0] || {};

  const gastoProveedorTop = Number(proveedorTop.total_gastado || 0);
  const vecesProveedorTop = gastoProveedorTop > 0 ? (safeTotalGasto / gastoProveedorTop).toFixed(1) : '0.0';
  const totalGastoPlacas = safeGastosPorPlaca.reduce((total, item) => total + Number(item.total_gastado || 0), 0);

  // Proveedores para el selector de filtros
  const proveedoresList = Array.isArray(proveedores) ? proveedores : [];
  const estadosList = Array.isArray(estados) ? estados : ['BORRADOR', 'ENVIADA', 'RECIBIDA_PARCIAL', 'RECIBIDA_TOTAL'];
  const filtrosActuales = filtros || {};
%>

<nav class="navbar navbar-dark bg-dark px-4 py-3">
  <span class="navbar-brand fw-semibold fs-5">
    <i class="bi bi-graph-up"></i> Dashboard de Compras
  </span>
  <div class="text-white d-flex align-items-center gap-3">
    <span><i class="bi bi-person-circle me-1"></i> <%= safeUser.usuario || 'Usuario' %> (<%= safeUser.rol || 'Sin rol' %>)</span>
    <a href="/compras/ordenes" class="btn btn-sm btn-outline-light rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Dashboard de compras</h1>
      <p class="page-subtitle">Indicadores, proveedores y consumo mensual según los filtros aplicados.</p>
    </div>
  </div>

  <!-- Formulario de filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar dashboard</h5>
    <form method="GET" action="/compras/dashboard" class="row g-3">
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedoresList.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtrosActuales.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estadosList.forEach(est => { %>
            <option value="<%= est %>" <%= filtrosActuales.estado === est ? 'selected' : '' %>><%= est.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/dashboard" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <!-- KPIs -->
  <div class="row g-4 mb-5">
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number">₡<%= safeTotalGasto.toLocaleString('es-CR') %></div>
          <div class="stat-label mt-1">Gasto total</div>
        </div>
        <div class="stat-icon"><i class="bi bi-cash-stack text-success"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= proveedorTop.nombre || '—' %></div>
          <div class="stat-label mt-1">Principal proveedor</div>
        </div>
        <div class="stat-icon"><i class="bi bi-building text-primary"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= Number(productoTop.total_cantidad || 0).toLocaleString('es-CR') %></div>
          <div class="stat-label mt-1">Unidades del artículo top</div>
        </div>
        <div class="stat-icon"><i class="bi bi-box-seam text-warning"></i></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="stat-card d-flex align-items-center justify-content-between gap-3">
        <div>
          <div class="stat-number"><%= vecesProveedorTop %>x</div>
          <div class="stat-label mt-1">Veces al proveedor top</div>
        </div>
        <div class="stat-icon"><i class="bi bi-receipt text-info"></i></div>
      </div>
    </div>
  </div>

  <!-- Nodo independiente: gastos por placa -->
  <div class="placa-node mb-4">
    <div class="placa-node-header">
      <div>
        <h2 class="placa-node-title"><i class="bi bi-truck-front me-2"></i>Gastos por placa</h2>
        <p class="placa-node-subtitle">Calculado desde las órdenes de compra, respetando proveedor, fecha y estado filtrados.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <span class="placa-chip"><i class="bi bi-cash-coin"></i> ₡<%= totalGastoPlacas.toLocaleString('es-CR') %></span>
        <span class="placa-chip"><i class="bi bi-star-fill"></i> Top: <%= placaTop.placa || '—' %></span>
      </div>
    </div>
    <div class="placa-node-body">
      <% if (safeGastosPorPlaca.length) { %>
        <div class="row g-3 align-items-stretch">
          <div class="col-lg-7">
            <canvas id="chartGastosPlaca" style="max-height: 380px;"></canvas>
          </div>
          <div class="col-lg-5">
            <div class="placa-drilldown">
              <% safeGastosPorPlacaAgrupados.filter(grupo => Number(grupo.total || 0) > 0).forEach(grupo => { %>
                <% const grupoId = `grupo-${String(grupo.nombre || '').replace(/[^a-z0-9]/gi, '-').toLowerCase()}`; %>
                <section class="drill-card">
                  <button type="button" class="drill-row drill-row-category js-drill-toggle" data-target="<%= grupoId %>" aria-expanded="false">
                    <span class="drill-row-main">
                      <span class="drill-row-title"><%= grupo.nombre %></span>
                      <span class="drill-row-sub"><%= Number(grupo.sedes?.length || 0).toLocaleString('es-CR') %> sede(s) · <%= Number(grupo.ordenes || 0).toLocaleString('es-CR') %> orden(es)</span>
                    </span>
                    <span class="drill-amount">₡<%= Number(grupo.total || 0).toLocaleString('es-CR') %></span>
                    <span class="drill-caret"><i class="bi bi-chevron-right"></i></span>
                  </button>

                  <div class="drill-panel" id="<%= grupoId %>">
                    <% grupo.sedes.forEach((sedeGrupo, sedeIndex) => { %>
                      <% const sedeId = `${grupoId}-sede-${sedeIndex}`; %>
                      <div class="drill-sede-block">
                        <button type="button" class="drill-row js-drill-toggle" data-target="<%= sedeId %>" aria-expanded="false">
                          <span class="drill-row-main">
                            <span class="drill-row-title"><%= sedeGrupo.nombre || 'Por revisar' %></span>
                            <span class="drill-row-sub"><%= Number(sedeGrupo.placas?.length || 0).toLocaleString('es-CR') %> placa(s) · <%= Number(sedeGrupo.ordenes || 0).toLocaleString('es-CR') %> orden(es)</span>
                          </span>
                          <span class="drill-amount">₡<%= Number(sedeGrupo.total || 0).toLocaleString('es-CR') %></span>
                          <span class="drill-caret"><i class="bi bi-chevron-right"></i></span>
                        </button>

                        <div class="drill-panel" id="<%= sedeId %>">
                          <table class="drill-placas">
                            <tbody>
                              <% sedeGrupo.placas.forEach(item => { %>
                                <tr>
                                  <td>
                                    <button type="button" class="placa-link js-placa-detail" data-placa="<%= item.placa %>">
                                      <%= item.placa %>
                                    </button>
                                    <div class="small text-muted mt-1"><%= Number(item.ordenes || 0).toLocaleString('es-CR') %> orden(es)</div>
                                  </td>
                                  <td>₡<%= Number(item.total_gastado || 0).toLocaleString('es-CR') %></td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="empty-msg">No hay órdenes con placa para mostrar en este filtro.</div>
      <% } %>
    </div>
  </div>

  <!-- Gráficos fila 1 -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-bar-chart-steps me-2"></i> Top 5 proveedores por gasto</div>
        <div class="card-body">
          <% if (safeTopProveedores.length) { %>
            <canvas id="chartProveedores"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de proveedores.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-calendar-week me-2"></i> Evolución mensual del gasto</div>
        <div class="card-body">
          <% if (safeGastoMensual.length) { %>
            <canvas id="chartMensual"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos mensuales.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráficos fila 2 -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-box me-2"></i> Top 5 productos más comprados</div>
        <div class="card-body">
          <% if (safeTopProductos.length) { %>
            <canvas id="chartProductos"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de productos.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="chart-card">
        <div class="card-header"><i class="bi bi-pie-chart me-2"></i> Órdenes por estado</div>
        <div class="card-body">
          <% if (safeOrdenesPorEstado.length) { %>
            <canvas id="chartEstados"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de estados.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== NUEVA SECCIÓN: TODOS LOS PROVEEDORES Y GASTO ===================== -->
  <div class="row g-4 mt-2">
    <div class="col-12">
      <div class="chart-card">
        <div class="card-header">
          <i class="bi bi-bar-chart-steps me-2"></i> Todos los proveedores por gasto (gráfico)
        </div>
        <div class="card-body">
          <% if (safeTodosProveedores.length) { %>
            <canvas id="chartTodosProveedores" style="max-height: 400px;"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de proveedores.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-12">
      <div class="chart-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-table me-2"></i> Detalle de gasto por proveedor</span>
          <a href="/compras/dashboard/proveedores/pdf?proveedor_id=<%= encodeURIComponent(filtrosActuales.proveedor_id || '') %>&fecha_desde=<%= encodeURIComponent(filtrosActuales.fecha_desde || '') %>&fecha_hasta=<%= encodeURIComponent(filtrosActuales.fecha_hasta || '') %>&estado=<%= encodeURIComponent(filtrosActuales.estado || '') %>" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-download"></i> Descargar PDF
          </a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Proveedor</th>
                  <th class="text-end">Total gastado (₡)</th>
                </tr>
              </thead>
              <tbody>
                <% safeTodosProveedores.forEach(p => { %>
                  <tr>
                    <td><%= p.nombre %></td>
                    <td class="text-end"><%= parseFloat(p.total_gastado).toLocaleString('es-CR') %></td>
                  </tr>
                <% }) %>
                <% if (safeTodosProveedores.length === 0) { %>
                  <tr><td colspan="2" class="text-center">No hay datos de proveedores</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<div class="placa-detail-backdrop" id="placaDetailBackdrop" aria-hidden="true">
  <div class="placa-detail-modal" role="dialog" aria-modal="true" aria-labelledby="placaDetailTitle">
    <div class="placa-detail-head">
      <div>
        <div class="small text-white-50 fw-bold text-uppercase">Compras por placa</div>
        <h3 class="h5 fw-black mb-0" id="placaDetailTitle">Placa</h3>
      </div>
      <button type="button" class="placa-detail-close" id="placaDetailClose" aria-label="Cerrar">&times;</button>
    </div>
    <div class="placa-detail-body" id="placaDetailBody"></div>
  </div>
</div>

<script type="application/json" id="data-top-proveedores"><%- JSON.stringify(safeTopProveedores) %></script>
<script type="application/json" id="data-gasto-mensual"><%- JSON.stringify(safeGastoMensual) %></script>
<script type="application/json" id="data-top-productos"><%- JSON.stringify(safeTopProductos) %></script>
<script type="application/json" id="data-ordenes-estado"><%- JSON.stringify(safeOrdenesPorEstado) %></script>
<script type="application/json" id="data-todos-proveedores"><%- JSON.stringify(safeTodosProveedores) %></script>
<script type="application/json" id="data-gastos-placa"><%- JSON.stringify(safeGastosPorPlaca) %></script>
<script type="application/json" id="data-compras-placa"><%- JSON.stringify(safeComprasPorPlaca) %></script>

<script>
  const leerJSON = (id) => {
    const elemento = document.getElementById(id);
    if (!elemento) return [];
    try {
      return JSON.parse(elemento.textContent || '[]');
    } catch (error) {
      console.error('Error leyendo JSON:', id, error);
      return [];
    }
  };

  const topProveedores = leerJSON('data-top-proveedores');
  const gastoMensual = leerJSON('data-gasto-mensual');
  const topProductos = leerJSON('data-top-productos');
  const ordenesPorEstado = leerJSON('data-ordenes-estado');
  const todosProveedores = leerJSON('data-todos-proveedores');
  const gastosPorPlaca = leerJSON('data-gastos-placa');
  const comprasPorPlaca = leerJSON('data-compras-placa');

  const formatCurrency = (value) => {
    const number = Number(value || 0);
    return '₡ ' + number.toLocaleString('es-CR');
  };

  const escapeHtml = (value) => String(value || '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const formatDate = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value).slice(0, 10);
    return date.toLocaleDateString('es-CR');
  };

  const cortaTexto = (texto, largo) => {
    texto = String(texto || '');
    return texto.length > largo ? texto.substring(0, largo - 3) + '...' : texto;
  };

  const abrirDetallePlaca = (placa) => {
    const backdrop = document.getElementById('placaDetailBackdrop');
    const title = document.getElementById('placaDetailTitle');
    const body = document.getElementById('placaDetailBody');
    if (!backdrop || !title || !body) return;

    const ordenes = comprasPorPlaca[placa] || [];
    const total = ordenes.reduce((sum, orden) => sum + Number(orden.total || 0), 0);
    title.textContent = `${placa} · ${ordenes.length} orden(es) · ${formatCurrency(total)}`;

    if (!ordenes.length) {
      body.innerHTML = '<div class="empty-msg">No hay detalle de compras para esta placa.</div>';
    } else {
      body.innerHTML = ordenes.map(orden => {
        const lineas = Array.isArray(orden.lineas) ? orden.lineas : [];
        const filas = lineas.length
          ? lineas.map(linea => `
              <tr>
                <td>${escapeHtml(linea.codigo || '-')}</td>
                <td>${escapeHtml(linea.codigo_producto || '-')}</td>
                <td>${escapeHtml(linea.descripcion || '-')}</td>
                <td class="text-center">${Number(linea.cantidad || 0).toLocaleString('es-CR')}</td>
                <td class="text-end">${formatCurrency(linea.precio_unitario || 0)}</td>
                <td class="text-end">${formatCurrency(linea.subtotal || 0)}</td>
              </tr>
            `).join('')
          : '<tr><td colspan="6" class="text-center text-muted">Sin líneas registradas</td></tr>';

        const observacion = orden.observaciones
          ? `<div class="orden-observacion"><strong>Observación:</strong> ${escapeHtml(orden.observaciones)}</div>`
          : '';

        return `
          <section class="orden-detail-card">
            <div class="orden-detail-top">
              <div>
                <div class="fw-black">PO ${escapeHtml(orden.po_numero || orden.id)}</div>
                <div class="orden-detail-meta">
                  ${escapeHtml(orden.proveedor || 'Sin proveedor')} · ${formatDate(orden.fecha)} · ${escapeHtml(String(orden.estado || '').replaceAll('_', ' ') || 'Sin estado')}
                </div>
              </div>
              <div class="text-end fw-black">${formatCurrency(orden.total || 0)}</div>
            </div>
            ${observacion}
            <div class="table-responsive p-3">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Placa</th>
                    <th>Código</th>
                    <th>Compra</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Subtotal</th>
                  </tr>
                </thead>
                <tbody>${filas}</tbody>
              </table>
            </div>
          </section>
        `;
      }).join('');
    }

    backdrop.classList.add('is-open');
    backdrop.setAttribute('aria-hidden', 'false');
  };

  const cerrarDetallePlaca = () => {
    const backdrop = document.getElementById('placaDetailBackdrop');
    if (!backdrop) return;
    backdrop.classList.remove('is-open');
    backdrop.setAttribute('aria-hidden', 'true');
  };

  document.querySelectorAll('.js-placa-detail').forEach(btn => {
    btn.addEventListener('click', () => abrirDetallePlaca(btn.dataset.placa));
  });

  document.querySelectorAll('.js-drill-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.dataset.target);
      if (!panel) return;

      const isOpen = panel.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  document.getElementById('placaDetailClose')?.addEventListener('click', cerrarDetallePlaca);
  document.getElementById('placaDetailBackdrop')?.addEventListener('click', (event) => {
    if (event.target.id === 'placaDetailBackdrop') cerrarDetallePlaca();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') cerrarDetallePlaca();
  });

  const canvasGastosPlaca = document.getElementById('chartGastosPlaca');
  if (canvasGastosPlaca && gastosPorPlaca.length) {
    const datosPlaca = gastosPorPlaca.slice(0, 12);
    new Chart(canvasGastosPlaca, {
      type: 'bar',
      data: {
        labels: datosPlaca.map(item => `${item.placa || 'POR REVISAR'} · ${item.sede || 'Por revisar'}`),
        datasets: [{
          label: 'Gasto por placa',
          data: datosPlaca.map(item => Number(item.total_gastado || 0)),
          backgroundColor: datosPlaca.map((_, index) => index === 0 ? '#ef233c' : '#0b3b82'),
          borderRadius: 10
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        onClick: (_, elements) => {
          if (!elements.length) return;
          const item = datosPlaca[elements[0].index];
          if (item?.placa) abrirDetallePlaca(item.placa);
        },
        onHover: (event, elements) => {
          if (event?.native?.target) {
            event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
          }
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => {
                const item = datosPlaca[ctx.dataIndex] || {};
                return `${formatCurrency(ctx.raw)} · ${Number(item.ordenes || 0)} orden(es)`;
              }
            }
          }
        },
        scales: {
          x: { ticks: { callback: value => formatCurrency(value) } }
        }
      }
    });
  }

  // Gráfico: Top proveedores
  const canvasProveedores = document.getElementById('chartProveedores');
  if (canvasProveedores && topProveedores.length) {
    new Chart(canvasProveedores, {
      type: 'bar',
      data: {
        labels: topProveedores.map(p => cortaTexto(p.nombre, 25)),
        datasets: [{
          label: 'Monto gastado',
          data: topProveedores.map(p => Number(p.total_gastado || 0)),
          backgroundColor: '#1f2937',
          borderRadius: 12
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } } },
        scales: { y: { ticks: { callback: value => formatCurrency(value) } } }
      }
    });
  }

  // Gráfico: Evolución mensual
  const canvasMensual = document.getElementById('chartMensual');
  if (canvasMensual && gastoMensual.length) {
    new Chart(canvasMensual, {
      type: 'line',
      data: {
        labels: gastoMensual.map(g => g.mes || 'Sin mes'),
        datasets: [{
          label: 'Gasto',
          data: gastoMensual.map(g => Number(g.total || 0)),
          borderColor: '#1f2937',
          backgroundColor: 'rgba(31,41,55,0.08)',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } } },
        scales: { y: { ticks: { callback: value => formatCurrency(value) } } }
      }
    });
  }

  // Gráfico: Top productos
  const canvasProductos = document.getElementById('chartProductos');
  if (canvasProductos && topProductos.length) {
    new Chart(canvasProductos, {
      type: 'bar',
      data: {
        labels: topProductos.map(p => cortaTexto(p.descripcion, 35)),
        datasets: [{
          label: 'Cantidad comprada',
          data: topProductos.map(p => Number(p.total_cantidad || 0)),
          backgroundColor: '#2d6a4f',
          borderRadius: 10
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => `${ctx.raw} unidades` } } }
      }
    });
  }

  // Gráfico: Órdenes por estado
  const canvasEstados = document.getElementById('chartEstados');
  if (canvasEstados && ordenesPorEstado.length) {
    const colores = {
      BORRADOR: '#6c757d',
      ENVIADA: '#0dcaf0',
      RECIBIDA_PARCIAL: '#ffc107',
      RECIBIDA_TOTAL: '#198754',
      ANULADA: '#dc3545'
    };
    new Chart(canvasEstados, {
      type: 'pie',
      data: {
        labels: ordenesPorEstado.map(e => String(e.estado || 'SIN ESTADO').replaceAll('_', ' ')),
        datasets: [{
          data: ordenesPorEstado.map(e => Number(e.cantidad || 0)),
          backgroundColor: ordenesPorEstado.map(e => colores[e.estado] || '#adb5bd'),
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'right' },
          tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.raw} órdenes` } }
        }
      }
    });
  }

  // ========== NUEVO GRÁFICO: Todos los proveedores (barras horizontales) ==========
  const canvasTodos = document.getElementById('chartTodosProveedores');
  if (canvasTodos && todosProveedores.length) {
    // Mostramos solo los primeros 20 para no saturar el gráfico
    const datosGrafico = todosProveedores.slice(0, 20);
    new Chart(canvasTodos, {
      type: 'bar',
      data: {
        labels: datosGrafico.map(p => cortaTexto(p.nombre, 30)),
        datasets: [{
          label: 'Monto gastado (₡)',
          data: datosGrafico.map(p => Number(p.total_gastado || 0)),
          backgroundColor: '#1f2937',
          borderRadius: 8
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { position: 'top' },
          tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } }
        },
        scales: {
          x: { ticks: { callback: val => formatCurrency(val) } }
        }
      }
    });
  }
</script>

</body>
</html>
