<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Correos de pagos a proveedores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">Correos de pagos a proveedores</span>
    <a href="/compras/facturas" class="btn btn-outline-light btn-sm">Volver a facturas</a>
  </nav>
  <main class="container py-4" style="max-width:760px">
    <header class="mb-4">
      <h1 class="h3">Copias internas de colillas</h1>
      <p class="text-secondary mb-0">Cada pago o abono se enviará al correo del proveedor con una copia a estas tres direcciones de Gas Tomza.</p>
    </header>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (smtpConfigurado) { %>
      <div class="alert alert-success">Remitente configurado: <strong><%= remitente %></strong></div>
    <% } else { %>
      <div class="alert alert-warning">Falta configurar EMAIL_USER_FACTURAS y EMAIL_PASS_FACTURAS en las variables del servidor. Los pagos se guardarán y los correos quedarán pendientes hasta configurar el remitente.</div>
    <% } %>
    <form method="POST" action="/compras/facturas/configuracion-correo" class="bg-white border rounded-3 p-4">
      <% [1, 2, 3].forEach(numero => { const campo = `copia_${numero}`; %>
        <div class="mb-3">
          <label for="<%= campo %>" class="form-label">Correo interno <%= numero %></label>
          <input type="email" class="form-control" id="<%= campo %>" name="<%= campo %>" value="<%= config[campo] || '' %>" autocomplete="email" required>
        </div>
      <% }) %>
      <div class="alert alert-info small">Las tres direcciones deben ser diferentes. El correo del proveedor aparece como destinatario principal; estas direcciones se copian en CC y serán visibles para el proveedor.</div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar correos</button>
        <a class="btn btn-outline-secondary" href="/compras/facturas">Cancelar</a>
      </div>
    </form>
  </main>
</body>
</html>
