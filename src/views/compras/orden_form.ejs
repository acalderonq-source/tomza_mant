<!DOCTYPE html>
<html>
<head>
  <title><%= (typeof tituloOrden !== 'undefined' ? tituloOrden : null) || (orden ? 'Editar Orden de Compra' : 'Nueva Orden de Compra') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>
    body { background: #f4f6f9; }
    .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .table thead th { background: #1f2937; color: white; }
    .quote-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      padding: .9rem;
    }
    .order-lines-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: visible;
      padding: .85rem;
      background: #f8fafc;
    }
    .order-lines-table {
      border-collapse: separate;
      border-spacing: 0 .8rem;
      margin-bottom: 0;
      min-width: 0;
      width: 100%;
    }
    .order-lines-table thead {
      display: none;
    }
    .order-lines-table,
    .order-lines-table tbody,
    .order-lines-table tr,
    .order-lines-table td {
      display: block;
      width: 100%;
    }
    .order-lines-table tr {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 10px;
      box-shadow: 0 8px 18px rgba(15,23,42,.04);
      display: grid;
      gap: .75rem;
      grid-template-columns: minmax(170px, .85fr) minmax(280px, 1.8fr) minmax(95px, .45fr) minmax(140px, .7fr) minmax(140px, .7fr) 46px;
      margin-bottom: .8rem;
      padding: .85rem;
    }
    .order-lines-table td {
      border: 0 !important;
      padding: 0 !important;
      vertical-align: top;
    }
    .order-lines-table td::before {
      content: attr(data-label);
      display: block;
      color: #475569;
      font-size: .72rem;
      font-weight: 850;
      letter-spacing: .03em;
      margin-bottom: .25rem;
      text-transform: uppercase;
    }
    .order-lines-table td[data-label="Descripción"] {
      grid-column: auto;
    }
    .order-lines-table td[data-label="Quitar"] {
      align-items: end;
      display: flex;
      justify-content: flex-end;
    }
    .order-lines-table td[data-label="Quitar"]::before {
      display: none;
    }
    .order-lines-table textarea {
      min-height: 88px;
      resize: vertical;
    }
    .order-lines-table .removeRow {
      height: 38px;
      min-width: 38px;
      padding: 0;
      width: 38px;
    }
    .order-lines-table .tomza-plate-results {
      min-width: 260px;
    }
    .order-totals {
      display: grid;
      gap: .65rem;
      margin-left: auto;
      max-width: 420px;
      padding-top: 1rem;
    }
    .order-total-row {
      align-items: center;
      display: grid;
      grid-template-columns: 1fr 180px;
      gap: .75rem;
    }
    .order-total-row label {
      color: #111827;
      font-weight: 800;
      margin: 0;
      text-align: right;
    }
    .order-total-row.total {
      border-top: 1px solid #e2e8f0;
      margin-top: .25rem;
      padding-top: .65rem;
    }
    .order-actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
    }
    @media (max-width: 1180px) {
      .order-lines-table tr {
        grid-template-columns: minmax(180px, 1fr) minmax(260px, 1.5fr);
      }
      .order-lines-table td[data-label="Descripción"] {
        grid-column: 1 / -1;
      }
      .order-lines-table td[data-label="Quitar"] {
        justify-content: flex-start;
      }
      .order-lines-table .removeRow {
        min-width: 120px;
        width: auto;
      }
    }
    @media (max-width: 768px) {
      .order-lines-table tr {
        grid-template-columns: 1fr;
      }
      .order-total-row {
        grid-template-columns: 1fr;
        gap: .25rem;
      }
      .order-total-row label {
        text-align: left;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>
<%
  const esEdicion = !!orden;
  const safeOrden = orden || {};
  const lineasIniciales = Array.isArray(lineas) ? lineas : [];
  const fechaOrden = safeOrden.fecha ? new Date(safeOrden.fecha).toLocaleDateString('es-CR') : new Date().toLocaleDateString('es-CR');
  const tituloPantalla = (typeof tituloOrden !== 'undefined' ? tituloOrden : null) || (esEdicion ? 'Editar orden de compra' : 'Nueva orden de compra');
  const subtituloPantalla = (typeof subtituloOrden !== 'undefined' ? subtituloOrden : null) || 'Completa el encabezado, líneas y totales de la orden.';
  const urlVolver = (typeof volverUrl !== 'undefined' ? volverUrl : null) || '/compras/ordenes';
  const urlCancelar = (typeof cancelarUrl !== 'undefined' ? cancelarUrl : null) || '/compras/ordenes';
  const accionFormulario = (typeof formAction !== 'undefined' ? formAction : null) || (esEdicion ? `/compras/ordenes/${safeOrden.id}/editar` : '/compras/ordenes');
  const textoBotonGuardar = (typeof textoGuardar !== 'undefined' ? textoGuardar : null) || (esEdicion ? 'Actualizar orden' : 'Guardar orden');
%>
<div class="container mt-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title"><%= tituloPantalla %></h1>
      <p class="page-subtitle"><%= subtituloPantalla %></p>
    </div>
    <a href="<%= urlVolver %>" class="btn btn-secondary btn-sm">Volver al listado</a>
  </div>

  <div class="form-card">
    <form id="ordenForm" method="POST" action="<%= accionFormulario %>">
      <div class="row">
        <div class="col-md-3">
          <label>N° PO <%= esEdicion ? '' : '(se genera automático)' %></label>
          <input type="text" class="form-control" value="<%= siguientePO %>" disabled>
        </div>
        <div class="col-md-3">
          <label>Fecha</label>
          <input type="text" class="form-control" value="<%= fechaOrden %>" disabled>
        </div>
        <div class="col-md-3">
          <label>Proveedor</label>
          <select name="proveedor_id" class="form-select" required>
            <option value="">Seleccione</option>
            <% proveedores.forEach(p => { %>
              <option value="<%= p.id %>" <%= safeOrden.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label>Forma de pago</label>
          <input type="text" name="forma_pago" class="form-control" placeholder="crédito, contado, etc." value="<%= safeOrden.forma_pago || '' %>">
        </div>
      </div>
      <div class="row mt-3">
        <div class="col-md-2">
          <label>Moneda</label>
          <select name="moneda" class="form-select">
            <option value="CRC" <%= (safeOrden.moneda || 'CRC') === 'CRC' ? 'selected' : '' %>>Colones (CRC)</option>
            <option value="USD" <%= safeOrden.moneda === 'USD' ? 'selected' : '' %>>Dólares (USD)</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>Empresa destinataria</label>
          <select name="empresa_destino" class="form-select" required>
            <option value="GAS TOMZA" <%= (safeOrden.empresa_destino || 'GAS TOMZA') === 'GAS TOMZA' ? 'selected' : '' %>>Gas Tomza de Costa Rica S.A.</option>
            <option value="SUPER GAS" <%= safeOrden.empresa_destino === 'SUPER GAS' ? 'selected' : '' %>>Envasadora Super Gas GLP S.A.</option>
            <option value="GRANEL" <%= safeOrden.empresa_destino === 'GRANEL' ? 'selected' : '' %>>Granel</option>
          </select>
        </div>
        <div class="col-md-3">
          <label>Placa / general de orden</label>
          <input
            type="text"
            name="placa_unidad"
            class="form-control text-uppercase"
            placeholder="Placa o GENERAL"
            value="<%= safeOrden.placa_unidad || '' %>"
            data-placa-autocomplete
            data-placa-mode="placa"
            data-placa-allow-free="true"
            data-placa-allow-general="true"
          >
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <div class="small text-muted">
            Use una placa para compras de unidad, o <strong>GENERAL</strong> cuando no corresponde a una placa.
          </div>
        </div>
      </div>

      <hr>
      <h4 class="page-title fs-5 mb-3">Detalle de productos/servicios</h4>
      <div class="order-lines-wrap">
        <table class="table table-bordered order-lines-table" id="itemsTable">
          <colgroup>
            <col class="col-placa">
            <col class="col-descripcion">
            <col class="col-cantidad">
            <col class="col-precio">
            <col class="col-subtotal">
            <col class="col-accion">
          </colgroup>
          <thead>
            <tr><th>Placa</th><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th><th></th></tr>
          </thead>
          <tbody>
            <!-- Las filas se agregarán dinámicamente -->
          </tbody>
        </table>
      </div>

      <div class="order-totals">
        <div class="order-total-row">
          <label for="subtotal">Subtotal</label>
          <input type="text" id="subtotal" name="subtotal" readonly class="form-control-plaintext money" value="<%= safeOrden.subtotal || '' %>">
        </div>
        <div class="order-total-row">
          <label for="descuento">Descuento monto</label>
          <input type="number" id="descuento" name="descuento" step="0.01" min="0" value="<%= safeOrden.descuento ?? 0 %>" class="form-control">
        </div>
        <div class="order-total-row">
          <label for="transporte">Transporte</label>
          <input type="number" id="transporte" name="transporte" step="0.01" value="<%= safeOrden.transporte ?? 0 %>" class="form-control">
        </div>
        <div class="order-total-row">
          <label for="iva">IVA (%)</label>
          <input type="number" id="iva" name="iva" step="0.01" value="<%= safeOrden.iva ?? 13 %>" class="form-control">
        </div>
        <div class="order-total-row total">
          <label for="total">Total</label>
          <input type="text" id="total" name="total" readonly class="form-control-plaintext fw-bold money" value="<%= safeOrden.total || '' %>">
        </div>
      </div>

      <div class="mb-3">
        <label>Observaciones</label>
        <textarea name="observaciones" class="form-control" rows="2"><%= safeOrden.observaciones || '' %></textarea>
      </div>

      <div class="mb-3 quote-box">
        <label class="form-label fw-semibold">Cotización adjunta</label>
        <% if (safeOrden.cotizacion_archivo) { %>
          <div class="mb-2">
            <a href="<%= safeOrden.cotizacion_archivo %>" target="_blank" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-paperclip"></i> Ver cotización actual
            </a>
            <span class="text-muted small ms-2"><%= safeOrden.cotizacion_nombre || 'Cotización adjunta' %></span>
          </div>
        <% } %>
        <input type="file" id="cotizacionInput" class="form-control" accept="application/pdf,image/*">
        <input type="hidden" name="cotizacion_data" id="cotizacionData">
        <input type="hidden" name="cotizacion_nombre" id="cotizacionNombre">
        <input type="hidden" name="cotizacion_tipo" id="cotizacionTipo">
        <div class="d-flex gap-2 flex-wrap mt-2">
          <button type="button" class="btn btn-sm btn-outline-dark" id="analizarCotizacionBtn" disabled>
            <i class="bi bi-magic"></i> Llenar orden desde cotización
          </button>
        </div>
        <div id="cotizacionPreview" class="small text-muted mt-2">
          <%= safeOrden.cotizacion_archivo ? 'Si selecciona otro archivo, reemplaza la cotización actual. También puede usarlo para llenar la orden.' : 'Opcional. Adjunte PDF o imagen y use el botón para llenar la orden automáticamente.' %>
        </div>
      </div>

      <div class="order-actions">
        <button type="button" class="btn btn-secondary" id="addRowBtn"><i class="bi bi-plus-circle"></i> Agregar línea</button>
        <button type="submit" class="btn btn-primary"><%= textoBotonGuardar %></button>
        <a href="<%= urlCancelar %>" class="btn btn-danger">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script src="/js/placa-search.js?v=20260811-3"></script>
<script>
  let rowIndex = 0;
  const lineasIniciales = <%- JSON.stringify(lineasIniciales) %>;

  function addRow(linea = {}) {
    const tbody = document.querySelector("#itemsTable tbody");
    const newRow = document.createElement("tr");
    newRow.innerHTML = `
      <td data-label="Placa"><input type="text" name="lineas[${rowIndex}][codigo]" class="form-control text-uppercase" placeholder="Placa o GENERAL" data-placa-autocomplete data-placa-mode="placa" data-placa-allow-free="true" data-placa-allow-general="true"></td>
      <td data-label="Descripción"><textarea name="lineas[${rowIndex}][descripcion]" class="form-control" rows="3" required></textarea></td>
      <td data-label="Cantidad"><input type="number" name="lineas[${rowIndex}][cantidad]" class="form-control cantidad" value="1" step="0.01"></td>
      <td data-label="Precio unitario"><input type="number" name="lineas[${rowIndex}][precio_unitario]" class="form-control precio" step="0.01"></td>
      <td data-label="Subtotal"><input type="text" name="lineas[${rowIndex}][subtotal]" class="form-control subtotal money" readonly></td>
      <td data-label="Quitar"><button type="button" class="btn btn-danger btn-sm removeRow" title="Quitar línea"><i class="bi bi-x-lg"></i></button></td>
    `;
    tbody.appendChild(newRow);
    newRow.querySelector(`[name="lineas[${rowIndex}][codigo]"]`).value = linea.codigo || '';
    newRow.querySelector(`[name="lineas[${rowIndex}][descripcion]"]`).value = linea.descripcion || '';
    newRow.querySelector(`[name="lineas[${rowIndex}][cantidad]"]`).value = linea.cantidad ?? 1;
    newRow.querySelector(`[name="lineas[${rowIndex}][precio_unitario]"]`).value = linea.precio_unitario ?? '';
    newRow.querySelector(`[name="lineas[${rowIndex}][subtotal]"]`).value = linea.subtotal ?? '';
    rowIndex++;
    attachEventsToRow(newRow);
    window.TomzaPlacaSearch?.initAll(newRow);
    updateTotals();
  }

  function attachEventsToRow(row) {
    const cantidadInput = row.querySelector(".cantidad");
    const precioInput = row.querySelector(".precio");
    const subtotalInput = row.querySelector(".subtotal");
    const removeBtn = row.querySelector(".removeRow");
    const updateSubtotal = () => {
      const cant = parseFloat(cantidadInput.value) || 0;
      const precio = parseFloat(precioInput.value) || 0;
      subtotalInput.value = (cant * precio).toFixed(2);
      updateTotals();
    };
    cantidadInput.addEventListener("input", updateSubtotal);
    precioInput.addEventListener("input", updateSubtotal);
    removeBtn.addEventListener("click", () => {
      row.remove();
      updateTotals();
    });
  }

  function updateTotals() {
    let subtotal = 0;
    document.querySelectorAll(".subtotal").forEach(el => {
      subtotal += parseFloat(el.value) || 0;
    });
    const descuento = Math.max(parseFloat(document.getElementById("descuento").value) || 0, 0);
    const transporte = parseFloat(document.getElementById("transporte").value) || 0;
    const ivaPorc = parseFloat(document.getElementById("iva").value) || 0;
    const subtotalDespuesDescuento = Math.max(subtotal - descuento, 0);
    const totalConTransporte = subtotalDespuesDescuento + transporte;
    const iva = totalConTransporte * ivaPorc / 100;
    const total = totalConTransporte + iva;
    document.getElementById("subtotal").value = subtotal.toFixed(2);
    document.getElementById("total").value = total.toFixed(2);
  }

  document.getElementById("addRowBtn").addEventListener("click", addRow);
  document.getElementById("descuento").addEventListener("input", updateTotals);
  document.getElementById("transporte").addEventListener("input", updateTotals);
  document.getElementById("iva").addEventListener("input", updateTotals);

  const cotizacionInput = document.getElementById("cotizacionInput");
  const cotizacionData = document.getElementById("cotizacionData");
  const cotizacionNombre = document.getElementById("cotizacionNombre");
  const cotizacionTipo = document.getElementById("cotizacionTipo");
  const cotizacionPreview = document.getElementById("cotizacionPreview");
  const analizarCotizacionBtn = document.getElementById("analizarCotizacionBtn");

  function hayLineasConDatos() {
    return Array.from(document.querySelectorAll("#itemsTable tbody tr")).some(row => {
      const descripcion = row.querySelector("textarea[name*='[descripcion]']");
      const precio = row.querySelector("input[name*='[precio_unitario]']");
      return (descripcion && descripcion.value.trim()) || (precio && precio.value.trim());
    });
  }

  function limpiarLineas() {
    document.querySelector("#itemsTable tbody").innerHTML = "";
    rowIndex = 0;
  }

  function setSelectValue(selector, value) {
    const select = document.querySelector(selector);
    if (!select || value === null || value === undefined || value === "") return false;
    const wanted = String(value);
    const option = Array.from(select.options).find(opt => String(opt.value) === wanted);
    if (!option) return false;
    select.value = wanted;
    return true;
  }

  function llenarOrdenDesdeCotizacion(orden) {
    const proveedorAsignado = setSelectValue('select[name="proveedor_id"]', orden.proveedor_id);
    if (orden.forma_pago) document.querySelector('[name="forma_pago"]').value = orden.forma_pago;
    if (orden.moneda) setSelectValue('select[name="moneda"]', orden.moneda);
    document.getElementById("descuento").value = orden.descuento ?? 0;
    document.getElementById("transporte").value = orden.transporte ?? 0;
    document.getElementById("iva").value = orden.iva ?? 13;

    const obs = document.querySelector('[name="observaciones"]');
    if (orden.observaciones && !obs.value.trim()) {
      obs.value = orden.observaciones;
    }

    limpiarLineas();
    (orden.lineas || []).forEach(linea => {
      addRow({
        codigo: linea.codigo || orden.placa_unidad || '',
        descripcion: linea.descripcion || '',
        cantidad: linea.cantidad || 1,
        precio_unitario: linea.precio_unitario || 0,
        subtotal: linea.subtotal || 0
      });
    });
    if (!(orden.lineas || []).length) addRow();
    updateTotals();

    let mensaje = '<span class="text-success fw-semibold">Orden llenada desde la cotización.</span> Revise y corrija antes de guardar.';
    if (!proveedorAsignado && orden.proveedor_nombre) {
      mensaje += ` <span class="text-warning">Proveedor detectado: ${orden.proveedor_nombre}, pero no existe igual en la lista.</span>`;
    }
    cotizacionPreview.innerHTML = mensaje;
  }

  if (cotizacionInput) {
    cotizacionInput.addEventListener("change", () => {
      const file = cotizacionInput.files && cotizacionInput.files[0];
      cotizacionData.value = "";
      cotizacionNombre.value = "";
      cotizacionTipo.value = "";
      if (!file) return;

      const tiposValidos = ["application/pdf", "image/jpeg", "image/jpg", "image/png", "image/webp"];
      if (!tiposValidos.includes(file.type)) {
        alert("La cotización debe ser PDF, JPG, PNG o WEBP.");
        cotizacionInput.value = "";
        analizarCotizacionBtn.disabled = true;
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        alert("La cotización no puede superar 5 MB.");
        cotizacionInput.value = "";
        analizarCotizacionBtn.disabled = true;
        return;
      }

      const reader = new FileReader();
      reader.onload = event => {
        cotizacionData.value = event.target.result;
        cotizacionNombre.value = file.name;
        cotizacionTipo.value = file.type;
        cotizacionPreview.innerHTML = `<span class="text-success fw-semibold">Archivo listo:</span> ${file.name}`;
        analizarCotizacionBtn.disabled = false;
      };
      reader.readAsDataURL(file);
    });
  }

  if (analizarCotizacionBtn) {
    analizarCotizacionBtn.addEventListener("click", async () => {
      if (!cotizacionData.value) {
        alert("Primero adjunte una cotización.");
        return;
      }

      if (hayLineasConDatos() && !confirm("Esto reemplazará las líneas actuales con lo detectado en la cotización. ¿Continuar?")) {
        return;
      }

      analizarCotizacionBtn.disabled = true;
      const textoOriginal = analizarCotizacionBtn.innerHTML;
      analizarCotizacionBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Leyendo cotización...';
      cotizacionPreview.innerHTML = '<span class="text-muted">Analizando cotización con IA...</span>';

      try {
        const response = await fetch("/compras/cotizacion/analizar", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            archivo_data: cotizacionData.value,
            archivo_nombre: cotizacionNombre.value,
            archivo_tipo: cotizacionTipo.value
          })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) {
          throw new Error(data.error || "No se pudo analizar la cotización.");
        }
        llenarOrdenDesdeCotizacion(data.orden);
      } catch (error) {
        cotizacionPreview.innerHTML = `<span class="text-danger fw-semibold">${error.message || 'No se pudo analizar la cotización.'}</span>`;
      } finally {
        analizarCotizacionBtn.innerHTML = textoOriginal;
        analizarCotizacionBtn.disabled = !cotizacionData.value;
      }
    });
  }

  if (lineasIniciales.length) {
    lineasIniciales.forEach(addRow);
  } else {
    addRow();
  }
</script>
</body>
</html>
