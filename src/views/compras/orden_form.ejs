<!DOCTYPE html>
<html>
<head>
  <title><%= orden ? 'Editar Orden de Compra' : 'Nueva Orden de Compra' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>
    body { background: #f4f6f9; }
    .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .table thead th { background: #1f2937; color: white; }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>
<%
  const esEdicion = !!orden;
  const safeOrden = orden || {};
  const lineasIniciales = Array.isArray(lineas) ? lineas : [];
  const fechaOrden = safeOrden.fecha ? new Date(safeOrden.fecha).toLocaleDateString('es-CR') : new Date().toLocaleDateString('es-CR');
%>
<div class="container mt-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title"><%= esEdicion ? 'Editar orden de compra' : 'Nueva orden de compra' %></h1>
      <p class="page-subtitle">Completa el encabezado, líneas y totales de la orden.</p>
    </div>
    <a href="/compras/ordenes" class="btn btn-secondary btn-sm">Volver al listado</a>
  </div>

  <div class="form-card">
    <form id="ordenForm" method="POST" action="<%= esEdicion ? `/compras/ordenes/${safeOrden.id}/editar` : '/compras/ordenes' %>">
      <div class="row">
        <div class="col-md-3">
          <label>N° PO <%= esEdicion ? '' : '(se genera automático)' %></label>
          <input type="text" class="form-control" value="<%= siguientePO %>" disabled>
        </div>
        <div class="col-md-3">
          <label>Fecha</label>
          <input type="text" class="form-control" value="<%= fechaOrden %>" disabled>
        </div>
        <div class="col-md-3">
          <label>Proveedor</label>
          <select name="proveedor_id" class="form-select" required>
            <option value="">Seleccione</option>
            <% proveedores.forEach(p => { %>
              <option value="<%= p.id %>" <%= safeOrden.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label>Forma de pago</label>
          <input type="text" name="forma_pago" class="form-control" placeholder="crédito, contado, etc." value="<%= safeOrden.forma_pago || '' %>">
        </div>
      </div>
      <div class="row mt-3">
        <div class="col-md-2">
          <label>Moneda</label>
          <select name="moneda" class="form-select">
            <option value="CRC" <%= (safeOrden.moneda || 'CRC') === 'CRC' ? 'selected' : '' %>>Colones (CRC)</option>
            <option value="USD" <%= safeOrden.moneda === 'USD' ? 'selected' : '' %>>Dólares (USD)</option>
          </select>
        </div>
        <div class="col-md-4">
          <label>🏢 Empresa destinataria</label>
          <select name="empresa_destino" class="form-select" required>
            <option value="GAS TOMZA" <%= (safeOrden.empresa_destino || 'GAS TOMZA') === 'GAS TOMZA' ? 'selected' : '' %>>Gas Tomza de Costa Rica S.A.</option>
            <option value="SUPER GAS" <%= safeOrden.empresa_destino === 'SUPER GAS' ? 'selected' : '' %>>Envasadora Super Gas GLP S.A.</option>
          </select>
        </div>
      </div>

      <hr>
      <h4 class="page-title fs-5 mb-3">Detalle de productos/servicios</h4>
      <div class="table-responsive">
        <table class="table table-bordered" id="itemsTable">
          <thead>
            <tr><th>Código</th><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th><th></th></tr>
          </thead>
          <tbody>
            <!-- Las filas se agregarán dinámicamente -->
          </tbody>
          <tfoot>
            <tr><td colspan="4" class="text-end"><strong>Subtotal</strong></td><td><input type="text" id="subtotal" name="subtotal" readonly class="form-control-plaintext money" value="<%= safeOrden.subtotal || '' %>"></td><td></td></tr>
            <tr><td colspan="4" class="text-end"><strong>Descuento (%)</strong></td><td><input type="number" id="descuento" name="descuento" step="0.01" value="<%= safeOrden.descuento ?? 0 %>" class="form-control"></td><td></td></tr>
            <tr><td colspan="4" class="text-end"><strong>Transporte</strong></td><td><input type="number" id="transporte" name="transporte" step="0.01" value="<%= safeOrden.transporte ?? 0 %>" class="form-control"></td><td></td></tr>
            <tr><td colspan="4" class="text-end"><strong>IVA (%)</strong></td><td><input type="number" id="iva" name="iva" step="0.01" value="<%= safeOrden.iva ?? 13 %>" class="form-control"></td><td></td></tr>
            <tr><td colspan="4" class="text-end"><strong>Total</strong></td><td><input type="text" id="total" name="total" readonly class="form-control-plaintext fw-bold money" value="<%= safeOrden.total || '' %>"></td><td></td></tr>
          </tfoot>
        </table>
      </div>

      <div class="mb-3">
        <label>Observaciones</label>
        <textarea name="observaciones" class="form-control" rows="2"><%= safeOrden.observaciones || '' %></textarea>
      </div>

      <button type="button" class="btn btn-secondary" id="addRowBtn">➕ Agregar línea</button>
      <button type="submit" class="btn btn-primary"><%= esEdicion ? 'Actualizar orden' : 'Guardar orden' %></button>
      <a href="/compras/ordenes" class="btn btn-danger">Cancelar</a>
    </form>
  </div>
</div>

<script>
  let rowIndex = 0;
  const lineasIniciales = <%- JSON.stringify(lineasIniciales) %>;

  function addRow(linea = {}) {
    const tbody = document.querySelector("#itemsTable tbody");
    const newRow = document.createElement("tr");
    newRow.innerHTML = `
      <td><input type="text" name="lineas[${rowIndex}][codigo]" class="form-control"></td>
      <td><textarea name="lineas[${rowIndex}][descripcion]" class="form-control" rows="2" required></textarea></td>
      <td><input type="number" name="lineas[${rowIndex}][cantidad]" class="form-control cantidad" value="1" step="0.01"></td>
      <td><input type="number" name="lineas[${rowIndex}][precio_unitario]" class="form-control precio" step="0.01"></td>
      <td><input type="text" name="lineas[${rowIndex}][subtotal]" class="form-control subtotal" readonly></td>
      <td><button type="button" class="btn btn-danger btn-sm removeRow">X</button></td>
    `;
    tbody.appendChild(newRow);
    newRow.querySelector(`[name="lineas[${rowIndex}][codigo]"]`).value = linea.codigo || '';
    newRow.querySelector(`[name="lineas[${rowIndex}][descripcion]"]`).value = linea.descripcion || '';
    newRow.querySelector(`[name="lineas[${rowIndex}][cantidad]"]`).value = linea.cantidad ?? 1;
    newRow.querySelector(`[name="lineas[${rowIndex}][precio_unitario]"]`).value = linea.precio_unitario ?? '';
    newRow.querySelector(`[name="lineas[${rowIndex}][subtotal]"]`).value = linea.subtotal ?? '';
    rowIndex++;
    attachEventsToRow(newRow);
    updateTotals();
  }

  function attachEventsToRow(row) {
    const cantidadInput = row.querySelector(".cantidad");
    const precioInput = row.querySelector(".precio");
    const subtotalInput = row.querySelector(".subtotal");
    const removeBtn = row.querySelector(".removeRow");
    const updateSubtotal = () => {
      const cant = parseFloat(cantidadInput.value) || 0;
      const precio = parseFloat(precioInput.value) || 0;
      subtotalInput.value = (cant * precio).toFixed(2);
      updateTotals();
    };
    cantidadInput.addEventListener("input", updateSubtotal);
    precioInput.addEventListener("input", updateSubtotal);
    removeBtn.addEventListener("click", () => {
      row.remove();
      updateTotals();
    });
  }

  function updateTotals() {
    let subtotal = 0;
    document.querySelectorAll(".subtotal").forEach(el => {
      subtotal += parseFloat(el.value) || 0;
    });
    const descuento = parseFloat(document.getElementById("descuento").value) || 0;
    const transporte = parseFloat(document.getElementById("transporte").value) || 0;
    const ivaPorc = parseFloat(document.getElementById("iva").value) || 0;
    const subtotalDespuesDescuento = subtotal - (subtotal * descuento / 100);
    const totalConTransporte = subtotalDespuesDescuento + transporte;
    const iva = totalConTransporte * ivaPorc / 100;
    const total = totalConTransporte + iva;
    document.getElementById("subtotal").value = subtotal.toFixed(2);
    document.getElementById("total").value = total.toFixed(2);
  }

  document.getElementById("addRowBtn").addEventListener("click", addRow);
  document.getElementById("descuento").addEventListener("input", updateTotals);
  document.getElementById("transporte").addEventListener("input", updateTotals);
  document.getElementById("iva").addEventListener("input", updateTotals);

  if (lineasIniciales.length) {
    lineasIniciales.forEach(addRow);
  } else {
    addRow();
  }
</script>
</body>
</html>
