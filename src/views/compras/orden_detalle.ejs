<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Detalle Orden - <%= orden.po_numero %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f4f6f9; }
    .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); margin-bottom: 1.5rem; }
    .card-header { background: #1f2937; color: white; border-radius: 14px 14px 0 0; }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">🛒 Detalle de Orden</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/compras/ordenes" class="btn btn-secondary btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Orden <%= orden.po_numero %></h1>
      <p class="page-subtitle">Detalle de encabezado, productos y resumen financiero.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/compras/ordenes/<%= orden.id %>/editar" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil"></i> Editar</a>
      <a href="/compras/ordenes/<%= orden.id %>/pdf" class="btn btn-primary btn-sm"><i class="bi bi-file-pdf"></i> PDF</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-white text-dark">
      <h4 class="page-title fs-5">Información general</h4>
    </div>
    <div class="card-body">
      <div class="detail-grid">
        <div class="detail-item">
          <div class="detail-label">Fecha</div>
          <div class="detail-value"><%= new Date(orden.fecha).toLocaleDateString('es-CR') %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Proveedor</div>
          <div class="detail-value"><%= proveedor.nombre %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Forma de pago</div>
          <div class="detail-value"><%= orden.forma_pago || '—' %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Moneda</div>
          <div class="detail-value"><%= orden.moneda %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Empresa destinataria</div>
          <div class="detail-value"><%= orden.empresa_destino === 'SUPER GAS' ? 'Envasadora Super Gas GLP S.A.' : 'Gas Tomza de Costa Rica S.A.' %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Estado</div>
          <div class="detail-value">
            <span class="badge <%= 
              orden.estado === 'BORRADOR' ? 'bg-secondary' :
              orden.estado === 'ENVIADA' ? 'bg-info' :
              orden.estado === 'RECIBIDA_PARCIAL' ? 'bg-warning' :
              orden.estado === 'RECIBIDA_TOTAL' ? 'bg-success' : 'bg-danger'
            %>"><%= orden.estado %></span>
          </div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Observaciones</div>
          <div class="detail-value"><%= orden.observaciones || '—' %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla de líneas (igual que antes) -->
  <div class="card">
    <div class="card-header bg-white text-dark"><span class="page-title fs-5">Detalle de productos / servicios</span></div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered mb-0">
          <thead><tr><th>Código</th><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
          <tbody>
            <% lineas.forEach(lin => { %>
              <tr><td data-label="Código"><%= lin.codigo || '-' %></td><td data-label="Descripción"><%= lin.descripcion %></td><td data-label="Cantidad"><%= lin.cantidad %></td><td data-label="Precio unitario" class="money"><%= parseFloat(lin.precio_unitario).toLocaleString('es-CR') %></td><td data-label="Subtotal" class="money"><%= parseFloat(lin.subtotal).toLocaleString('es-CR') %></td></tr>
            <% }) %>
            <% if (lineas.length === 0) { %><tr><td colspan="5" class="text-center">Sin líneas registradas</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Totales -->
  <div class="card">
    <div class="card-header bg-white text-dark"><span class="page-title fs-5">Resumen financiero</span></div>
    <div class="card-body">
      <div class="row justify-content-end">
        <div class="col-md-4">
          <table class="table table-sm table-borderless">
            <tr><td><strong>Subtotal</strong></td><td class="money"><%= parseFloat(orden.subtotal).toLocaleString('es-CR') %></td></tr>
            <tr><td><strong>Descuento</strong></td><td class="text-end"><%= orden.descuento %>%</td></tr>
            <tr><td><strong>Transporte</strong></td><td class="money"><%= parseFloat(orden.transporte).toLocaleString('es-CR') %></td></tr>
            <tr><td><strong>IVA</strong></td><td class="text-end"><%= orden.iva %>%</td></tr>
            <tr class="bg-light"><td><strong>TOTAL</strong></td><td class="money fw-bold"><%= parseFloat(orden.total).toLocaleString('es-CR') %></td></tr>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

</body>
</html>
