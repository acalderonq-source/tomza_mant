<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Recibo de Pago</title>
<style>
  * { box-sizing: border-box; }
  @page { size: Letter; margin: 0; }
  body {
    margin: 0;
    background: #fff;
    color: #111827;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9px;
  }
  .page {
    background: #fff;
    margin: 0;
    min-height: 100%;
    padding: 0;
    width: 100%;
  }
  .top-band {
    background: #10213f;
    border-bottom: 3px solid #f2c200;
    color: #fff;
    padding: 10px 12px;
  }
  .header-table { width: 100%; border-collapse: collapse; }
  .header-table td { vertical-align: middle; }
  .logo-box {
    background: #fff;
    border-radius: 5px;
    padding: 4px;
    width: 154px;
  }
  .logo { display: block; height: 48px; object-fit: contain; width: 146px; }
  .title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: .4px;
    text-align: right;
    text-transform: uppercase;
  }
  .subtitle {
    color: #dbeafe;
    font-size: 9px;
    margin-top: 3px;
    text-align: right;
  }
  .document-card {
    border: 1px solid #d7e2ef;
    border-top: 0;
    padding: 10px 12px 12px;
  }
  .meta-table {
    border-collapse: collapse;
    margin-top: 10px;
    width: 100%;
  }
  .meta-table td {
    border: 1px solid #d7e2ef;
    padding: 6px 7px;
    vertical-align: top;
  }
  .label {
    color: #475569;
    display: block;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .3px;
    margin-bottom: 3px;
    text-transform: uppercase;
  }
  .value {
    color: #111827;
    font-size: 10px;
    font-weight: 700;
  }
  .value-big {
    color: #10213f;
    font-size: 16px;
    font-weight: 900;
  }
  .summary-cards {
    border-collapse: separate;
    border-spacing: 6px 0;
    margin-top: 10px;
    width: 100%;
  }
  .summary-cards td {
    background: #f8fafc;
    border: 1px solid #dbe3ef;
    border-radius: 6px;
    padding: 8px;
    width: 33.33%;
  }
  .summary-number {
    color: #10213f;
    display: block;
    font-size: 15px;
    font-weight: 900;
    margin-top: 2px;
  }
  .section-title {
    background: #10213f;
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .2px;
    margin-top: 12px;
    padding: 6px 8px;
    text-transform: uppercase;
  }
  .summary-table,
  .items-table,
  .totals-table {
    border-collapse: collapse;
    width: 100%;
  }
  .summary-table th,
  .items-table th {
    background: #eaf1fb;
    border: 1px solid #cbd5e1;
    color: #1f2937;
    font-size: 7px;
    font-weight: 800;
    padding: 5px 4px;
    text-align: left;
    text-transform: uppercase;
  }
  .summary-table td,
  .items-table td {
    border: 1px solid #dbe3ef;
    padding: 5px 4px;
    vertical-align: top;
  }
  .items-table {
    table-layout: fixed;
  }
  .items-table th,
  .items-table td {
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .items-table tbody tr:nth-child(even) td { background: #f8fafc; }
  .items-table thead { display: table-header-group; }
  .items-table tr { page-break-inside: avoid; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .nowrap { white-space: nowrap; }
  .muted { color: #64748b; }
  .badge {
    background: #dcfce7;
    border: 1px solid #86efac;
    border-radius: 999px;
    color: #166534;
    display: inline-block;
    font-size: 7px;
    font-weight: 800;
    padding: 3px 6px;
    text-transform: uppercase;
  }
  .note {
    color: #334155;
    font-size: 8px;
    line-height: 1.25;
    margin-top: 2px;
    word-break: break-word;
  }
  .adjustment {
    color: #334155;
    font-size: 8px;
    line-height: 1.3;
  }
  .adjustment strong { color: #111827; }
  .totals-wrap {
    margin-left: auto;
    margin-top: 10px;
    width: 280px;
  }
  .totals-table td {
    border: 1px solid #d1d5db;
    padding: 6px 7px;
  }
  .total-row td {
    background: #10213f;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
  }
  .signatures {
    border-collapse: collapse;
    margin-top: 26px;
    width: 100%;
  }
  .signatures td {
    padding: 0 16px;
    text-align: center;
    width: 50%;
  }
  .line {
    border-top: 1px solid #111827;
    margin: 22px auto 6px;
    width: 200px;
  }
  .footer {
    border-top: 1px solid #e5e7eb;
    color: #64748b;
    font-size: 7px;
    line-height: 1.35;
    margin-top: 18px;
    padding-top: 7px;
    text-align: center;
  }
</style>
</head>
<body>
<%
  const safeFacturas = Array.isArray(facturas) ? facturas : [];
  const money = value => Number(value || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dateFmt = value => {
    if (!value) return '-';
    const raw = String(value);
    const fecha = /^\d{4}-\d{2}-\d{2}$/.test(raw) ? new Date(`${raw}T12:00:00`) : new Date(value);
    return Number.isNaN(fecha.getTime()) ? '-' : fecha.toLocaleDateString('es-CR');
  };
  const proveedoresMap = new Map();
  let totalNotasCredito = 0;
  let totalAbonosPrevios = 0;
  safeFacturas.forEach(f => {
    const proveedor = f.proveedor_nombre || 'Sin proveedor';
    const monto = Number(f.total || 0);
    totalNotasCredito += Number(f.nota_credito_monto || 0);
    totalAbonosPrevios += Number(f.abono_monto || 0);
    if (!proveedoresMap.has(proveedor)) {
      proveedoresMap.set(proveedor, { proveedor, facturas: 0, total: 0 });
    }
    const item = proveedoresMap.get(proveedor);
    item.facturas += 1;
    item.total += monto;
  });
  const resumenProveedores = Array.from(proveedoresMap.values()).sort((a, b) => b.total - a.total);
  const totalAjustes = totalNotasCredito + totalAbonosPrevios;
%>
<div class="page">
  <div class="top-band">
    <table class="header-table">
      <tr>
        <td style="width:190px;">
          <div class="logo-box">
            <% if (logoDataUri) { %>
              <img src="<%= logoDataUri %>" class="logo">
            <% } else { %>
              <div class="value" style="height:58px; padding-top:20px; text-align:center;">GAS TOMZA</div>
            <% } %>
          </div>
        </td>
        <td>
          <div class="title">Recibo de pago</div>
          <div class="subtitle">Control de facturas pagadas - Departamento de compras</div>
        </td>
      </tr>
    </table>
  </div>

  <div class="document-card">
  <table class="meta-table">
    <tr>
      <td style="width:25%;">
        <span class="label">Recibo No.</span>
        <span class="value"><%= reciboNumero || '-' %></span>
      </td>
      <td style="width:25%;">
        <span class="label">Fecha de pago</span>
        <span class="value"><%= dateFmt(fechaPago) %></span>
      </td>
      <td style="width:25%;">
        <span class="label">Generado por</span>
        <span class="value"><%= generadoPor || 'Sistema' %></span>
      </td>
      <td style="width:25%;">
        <span class="label">Estado</span>
        <span class="badge">Pagado</span>
      </td>
    </tr>
    <tr>
      <td colspan="2">
        <span class="label">Empresa</span>
        <span class="value">Gas Tomza de Costa Rica S.A.</span>
      </td>
      <td>
        <span class="label">Facturas incluidas</span>
        <span class="value"><%= safeFacturas.length %></span>
      </td>
      <td>
        <span class="label">Total pagado</span>
        <span class="value-big nowrap">CRC <%= money(totalPagado) %></span>
      </td>
    </tr>
  </table>

  <table class="summary-cards">
    <tr>
      <td>
        <span class="label">Total pagado</span>
        <span class="summary-number nowrap">CRC <%= money(totalPagado) %></span>
      </td>
      <td>
        <span class="label">Ajustes aplicados</span>
        <span class="summary-number nowrap">CRC <%= money(totalAjustes) %></span>
      </td>
      <td>
        <span class="label">Proveedores</span>
        <span class="summary-number"><%= resumenProveedores.length %></span>
      </td>
    </tr>
  </table>

  <div class="section-title">Resumen por proveedor</div>
  <table class="summary-table">
    <thead>
      <tr>
        <th>Proveedor</th>
        <th class="text-center" style="width:90px;">Facturas</th>
        <th class="text-right" style="width:150px;">Monto pagado</th>
      </tr>
    </thead>
    <tbody>
      <% if (!resumenProveedores.length) { %>
        <tr><td colspan="3" class="text-center muted">No hay facturas en este recibo.</td></tr>
      <% } %>
      <% resumenProveedores.forEach(item => { %>
        <tr>
          <td><strong><%= item.proveedor %></strong></td>
          <td class="text-center"><%= item.facturas %></td>
          <td class="text-right"><strong>CRC <%= money(item.total) %></strong></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="section-title">Detalle de facturas pagadas</div>
  <table class="items-table">
    <thead>
      <tr>
        <th style="width:10%;">PO</th>
        <th style="width:31%;">Proveedor / observación</th>
        <th style="width:13%;">Factura</th>
        <th style="width:12%;">Vence</th>
        <th style="width:16%;" class="text-right">Ajustes</th>
        <th style="width:18%;" class="text-right">Pagado</th>
      </tr>
    </thead>
    <tbody>
      <% safeFacturas.forEach(f => { %>
        <tr>
          <td><strong><%= f.po_numero || '-' %></strong></td>
          <td>
            <strong><%= f.proveedor_nombre || '-' %></strong>
            <% const observacion = f.observacion || f.factura_observacion || f.abono_observacion || f.nota_credito_motivo || ''; %>
            <% if (observacion) { %>
              <div class="note"><span class="muted">Obs.:</span> <%= observacion %></div>
            <% } %>
          </td>
          <td><%= f.factura || '-' %></td>
          <td><%= dateFmt(f.fecha_vencimiento_factura) %></td>
          <td class="text-right adjustment">
            <div><strong>NC:</strong> CRC <%= money(f.nota_credito_monto) %></div>
            <div><strong>Abono:</strong> CRC <%= money(f.abono_monto) %></div>
          </td>
          <td class="text-right nowrap"><strong>CRC <%= money(f.total) %></strong></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="totals-wrap">
    <table class="totals-table">
      <tr>
        <td>Notas de crédito aplicadas</td>
        <td class="text-right">CRC <%= money(totalNotasCredito) %></td>
      </tr>
      <tr>
        <td>Abonos previos aplicados</td>
        <td class="text-right">CRC <%= money(totalAbonosPrevios) %></td>
      </tr>
      <tr class="total-row">
        <td>Total pagado</td>
        <td class="text-right">CRC <%= money(totalPagado) %></td>
      </tr>
    </table>
  </div>

  <table class="signatures">
    <tr>
      <td>
        <div class="line"></div>
        <strong>Preparado por</strong><br>
        <span class="muted">Compras / Proveeduría</span>
      </td>
      <td>
        <div class="line"></div>
        <strong>Revisado por</strong><br>
        <span class="muted">Administración / Contabilidad</span>
      </td>
    </tr>
  </table>

  <div class="footer">
    Documento generado automáticamente por el sistema interno de Gas Tomza. Este recibo respalda el pago de las facturas indicadas y debe conservarse junto con los comprobantes bancarios correspondientes.
  </div>
  </div>
</div>
</body>
</html>
