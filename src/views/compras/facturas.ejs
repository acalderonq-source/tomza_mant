  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="notaCreditoFacturaForm">
        <div class="modal-header">
          <div>
            <h5 class="modal-title"><i class="bi bi-journal-minus me-1"></i> Nota de crédito</h5>
