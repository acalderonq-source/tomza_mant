<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Gestión de Facturas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f0f2f5; font-family: 'Segoe UI', Roboto, sans-serif; }
    .card { border: none; border-radius: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.04); }
    .filtros-card { background: white; border-radius: 20px; padding: 1.5rem; margin-bottom: 1.8rem; }
    .table-facturas th { background: #f8fafc; }
    .badge-vencida { background-color: #dc3545; color: white; }
    .badge-pagada { background-color: #198754; }
    .badge-pendiente { background-color: #ffc107; color: #000; }
    .badge-nc { background-color: #0ea5e9; color: #fff; }
    .total-seleccion { font-size: 1.2rem; font-weight: bold; margin-top: 1rem; text-align: right; }
    .amount-stack { display: grid; gap: .2rem; }
    .amount-original { color: #64748b; font-size: .78rem; text-decoration: line-through; }
    .amount-credit { color: #0369a1; font-size: .8rem; font-weight: 700; }
    .amount-balance { color: #111827; font-size: .98rem; font-weight: 800; }
    .nc-note {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      color: #1e3a8a;
      display: inline-grid;
      gap: .1rem;
      padding: .4rem .55rem;
      text-align: left;
    }
    .nc-note strong { font-size: .8rem; }
    .nc-note small { color: #1d4ed8; }
    @media (max-width: 768px) {
      .table-facturas thead { display: none; }
      .table-facturas, .table-facturas tbody, .table-facturas tr, .table-facturas td {
        display: block;
        width: 100%;
      }
      .table-facturas tr { margin-bottom: 1rem; border: 1px solid #dee2e6; border-radius: 16px; padding: 0.8rem; background: white; }
      .table-facturas td { text-align: right; padding-left: 50%; position: relative; border-bottom: 1px solid #eee; }
      .table-facturas td::before { content: attr(data-label); position: absolute; left: 0.8rem; width: 45%; font-weight: 600; text-align: left; }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-receipt"></i> Gestión de Facturas</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/compras/ordenes" class="btn btn-sm btn-outline-light ms-2">← Órdenes</a>
    <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Dashboard</a>
  </div>
</nav>

<div class="container py-4">
  <% const puedeModificarCompras = user.rol !== 'CONTABILIDAD'; %>
  <div class="page-heading">
    <div>
      <h1 class="page-title">Facturas de compras</h1>
      <p class="page-subtitle">Controla facturas pendientes, vencidas y pagos múltiples.</p>
    </div>
    <% if (puedeModificarCompras) { %>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFacturaModal">
        <i class="bi bi-plus-circle"></i> Agregar factura
      </button>
    <% } %>
  </div>

  <!-- Mensajes flash -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar facturas</h5>
    <form method="GET" action="/compras/facturas" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtros.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Estado de pago</label>
        <select name="pagada" class="form-select form-select-sm">
          <option value="">Todos</option>
          <option value="1" <%= filtros.pagada == '1' ? 'selected' : '' %>>Pagadas</option>
          <option value="0" <%= filtros.pagada == '0' ? 'selected' : '' %>>Pendientes</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Solo vencidas</label>
        <select name="vencida" class="form-select form-select-sm">
          <option value="">No</option>
          <option value="1" <%= filtros.vencida == '1' ? 'selected' : '' %>>Sí</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Orden</label>
        <select name="orden" class="form-select form-select-sm">
          <option value="asc" <%= filtros.orden === 'asc' ? 'selected' : '' %>>Más antigua primero</option>
          <option value="desc" <%= filtros.orden === 'desc' || !filtros.orden ? 'selected' : '' %>>Más reciente primero</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/facturas" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <%
    const totalFacturas = facturas.reduce((sum, f) => sum + (parseFloat(f.monto_original ?? f.monto) || 0), 0);
    const totalNotasCredito = facturas.reduce((sum, f) => sum + (parseFloat(f.nota_credito_monto) || 0), 0);
    const totalSaldo = facturas.reduce((sum, f) => {
      if (f.pagada || f.cubierta_por_nc) return sum;
      return sum + (parseFloat(f.saldo ?? f.monto) || 0);
    }, 0);
    const facturasPagadas = facturas.filter(f => f.pagada || f.cubierta_por_nc).length;
    const facturasPendientes = facturas.filter(f => !f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)).length;
    const facturasVencidas = facturas.filter(f => f.vencida).length;
  %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Facturas</div>
      <div class="summary-value"><%= facturas.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Monto original</div>
      <div class="summary-value">₡<%= totalFacturas.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Notas crédito</div>
      <div class="summary-value">₡<%= totalNotasCredito.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Saldo pendiente</div>
      <div class="summary-value">₡<%= totalSaldo.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
  </div>

  <!-- Botón para agregar factura manual y listado -->
  <div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="page-title fs-5">Listado de facturas</h3>
        <p class="page-subtitle">Pagadas/cubiertas: <%= facturasPagadas %> · Pendientes: <%= facturasPendientes %> · Vencidas: <%= facturasVencidas %></p>
      </div>
    </div>

    <form method="POST" action="/compras/facturas/pagar-multiple" id="multiplePagoForm">
      <div class="table-responsive">
        <table class="table table-bordered table-hover table-facturas">
          <thead class="table-light">
            <tr>
              <% if (puedeModificarCompras) { %>
                <th style="width: 40px;"><input type="checkbox" id="seleccionarTodos"></th>
              <% } %>
              <th>PO Número</th>
              <th>Proveedor</th>
              <th>Fecha</th>
              <th>N° Factura</th>
              <th>Monto</th>
              <th>Fecha Vencimiento</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% facturas.forEach(f => { %>
              <tr class="<%= f.vencida ? 'table-danger' : '' %>">
                <% if (puedeModificarCompras) { %>
                  <td class="text-center">
                    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                      <input type="checkbox" name="facturas_ids" value="<%= f.tipo %>:<%= f.id %>" class="check-factura" data-monto="<%= f.saldo ?? f.monto %>">
                    <% } %>
                  </td>
                <% } %>
                <td data-label="PO Número"><%= f.po_numero ? f.po_numero : '—' %></td>
                <td data-label="Proveedor"><%= f.proveedor_nombre %></td>
                <td data-label="Fecha"><%= new Date(f.fecha).toLocaleDateString('es-CR') %></td>
                <td data-label="N° Factura"><%= f.numero_factura %></td>
                <td data-label="Monto" class="monto-factura money" data-val="<%= f.saldo ?? f.monto %>">
                  <div class="amount-stack">
                    <% if (f.tiene_nc) { %>
                      <span class="amount-original">Factura: ₡<%= parseFloat(f.monto_original ?? f.monto).toLocaleString('es-CR') %></span>
                      <span class="amount-credit">NC: -₡<%= parseFloat(f.nota_credito_monto || 0).toLocaleString('es-CR') %></span>
                      <span class="amount-balance">Saldo: ₡<%= parseFloat(f.saldo || 0).toLocaleString('es-CR') %></span>
                    <% } else { %>
                      <span class="amount-balance">₡<%= parseFloat(f.monto).toLocaleString('es-CR') %></span>
                    <% } %>
                  </div>
                </td>
                <td data-label="Fecha Vencimiento">
                  <%= f.fecha_vencimiento_factura ? new Date(f.fecha_vencimiento_factura).toLocaleDateString('es-CR') : '—' %>
                  <% if (f.vencida) { %>
                    <span class="badge badge-vencida ms-1">Vencida</span>
                  <% } %>
                </td>
                <td data-label="Estado">
                  <% if (f.cubierta_por_nc) { %>
                    <span class="badge badge-nc">Cubierta por NC</span>
                  <% } else if (f.pagada) { %>
                    <span class="badge badge-pagada">Pagada el <%= new Date(f.fecha_pago).toLocaleDateString('es-CR') %></span>
                  <% } else { %>
                    <span class="badge badge-pendiente">Pendiente</span>
                  <% } %>
                  <% if (f.tiene_nc && !f.cubierta_por_nc) { %>
                    <div class="mt-2">
                      <span class="badge badge-nc">NC aplicada</span>
                    </div>
                  <% } %>
                </td>
                <td data-label="Acciones">
                  <% if (puedeModificarCompras) { %>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-primary mb-1"
                      data-bs-toggle="modal"
                      data-bs-target="#nc-<%= f.tipo %>-<%= f.id %>">
                      <i class="bi bi-journal-minus"></i> NC
                    </button>
                    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                      <button
                        type="submit"
                        form="pagar-factura-<%= f.tipo %>-<%= f.id %>"
                        class="btn btn-sm btn-success"
                        onclick="return confirm('¿Marcar esta factura como pagada?')">
                        <i class="bi bi-check-circle"></i> Pagar
                      </button>
                    <% } else { %>
                      <span class="text-muted d-block"><%= f.cubierta_por_nc ? 'Sin saldo' : 'Pagada' %></span>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-secondary">Solo lectura</span>
                  <% } %>
                  <% if (f.tiene_nc) { %>
                    <div class="nc-note mt-2">
                      <strong>NC <%= f.nota_credito_numero || 'registrada' %></strong>
                      <small><%= f.nota_credito_fecha ? new Date(f.nota_credito_fecha).toLocaleDateString('es-CR') : 'Sin fecha' %></small>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (facturas.length === 0) { %>
              <tr><td colspan="<%= puedeModificarCompras ? 9 : 8 %>" class="text-center py-4">No hay facturas con los filtros seleccionados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (puedeModificarCompras) { %>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <div>
            <button type="submit" class="btn btn-success" id="btnPagarSeleccionadas" disabled>
              <i class="bi bi-check2-circle"></i> Pagar seleccionadas
            </button>
          </div>
          <div class="total-seleccion">
            <strong>Total seleccionado:</strong> <span id="totalSeleccionado">₡0,00</span>
          </div>
        </div>
      <% } %>
    </form>

    <% if (puedeModificarCompras) { %>
      <% facturas.forEach(f => { %>
        <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
          <form
            id="pagar-factura-<%= f.tipo %>-<%= f.id %>"
            method="POST"
            action="/compras/facturas/<%= f.id %>/pagar"
            class="d-none">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
          </form>
        <% } %>
      <% }) %>
    <% } %>
  </div>
</div>

<% if (puedeModificarCompras) { %>
  <% facturas.forEach(f => { %>
    <div class="modal fade" id="nc-<%= f.tipo %>-<%= f.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/compras/facturas/<%= f.id %>/nota-credito">
          <div class="modal-header">
            <div>
              <h5 class="modal-title"><i class="bi bi-journal-minus me-1"></i> Nota de crédito</h5>
              <small class="text-muted">Factura <%= f.numero_factura %> · <%= f.proveedor_nombre %></small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
            <div class="alert alert-info py-2">
              Monto factura: <strong>₡<%= parseFloat(f.monto_original ?? f.monto).toLocaleString('es-CR') %></strong>
              <% if (f.tiene_nc) { %>
                <br>NC actual: <strong>₡<%= parseFloat(f.nota_credito_monto || 0).toLocaleString('es-CR') %></strong>
              <% } %>
            </div>
            <div class="mb-3">
              <label class="form-label">Número de NC</label>
              <input type="text" name="numero_nc" class="form-control" value="<%= f.nota_credito_numero || '' %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Fecha de NC</label>
              <input type="date" name="fecha_nc" class="form-control" value="<%= f.nota_credito_fecha ? new Date(f.nota_credito_fecha).toISOString().slice(0, 10) : hoy %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Monto de NC</label>
              <input type="number" step="0.01" min="0.01" max="<%= f.monto_original ?? f.monto %>" name="monto_nc" class="form-control" value="<%= f.nota_credito_monto || '' %>" required>
              <small class="text-muted">Si cubre todo el monto, la factura queda liquidada por NC.</small>
            </div>
            <div class="mb-3">
              <label class="form-label">Motivo / detalle</label>
              <textarea name="motivo_nc" class="form-control" rows="3" placeholder="Ej: devolución, diferencia de precio, anulación parcial..."><%= f.nota_credito_motivo || '' %></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-primary">Guardar NC</button>
          </div>
        </form>
      </div>
    </div>
    </div>
  <% }) %>
<% } %>

<!-- Modal para agregar factura manualmente (PO opcional, proveedor desde selector) -->
<% if (puedeModificarCompras) { %>
  <div class="modal fade" id="agregarFacturaModal" tabindex="-1" aria-labelledby="agregarFacturaModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="agregarFacturaModalLabel">➕ Agregar nueva factura</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/compras/facturas/agregar">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Número de PO (opcional)</label>
            <input type="text" name="po_numero" class="form-control" placeholder="Ej: 2026-381">
            <small class="text-muted">Si tiene orden de compra, ingrésela; si no, deje vacío.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Número de Factura</label>
            <input type="text" name="factura" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Fecha de la Factura</label>
            <input type="date" name="fecha_factura" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Proveedor</label>
            <select name="proveedor_id" class="form-select" required>
              <option value="">Seleccione un proveedor</option>
              <% proveedores.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.nombre %></option>
              <% }) %>
            </select>
            <small class="text-muted">Obligatorio si no ingresa PO.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Monto (opcional)</label>
            <input type="number" step="0.01" name="monto" class="form-control" placeholder="0.00">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar Factura</button>
        </div>
      </form>
    </div>
  </div>
  </div>
<% } %>

<script>
  const checkboxes = document.querySelectorAll('.check-factura');
  const btnPagar = document.getElementById('btnPagarSeleccionadas');
  const totalSpan = document.getElementById('totalSeleccionado');
  const selectTodos = document.getElementById('seleccionarTodos');

  function actualizarTotal() {
    if (!btnPagar || !totalSpan) return;
    let total = 0;
    let seleccionadas = 0;
    checkboxes.forEach(cb => {
      if (cb.checked) {
        seleccionadas += 1;
        total += parseFloat(cb.dataset.monto || 0);
      }
    });
    totalSpan.innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    btnPagar.disabled = (seleccionadas === 0);
  }

  function marcarTodos() {
    const checked = selectTodos.checked;
    checkboxes.forEach(cb => {
      cb.checked = checked;
    });
    actualizarTotal();
  }

  if (selectTodos) {
    selectTodos.addEventListener('change', marcarTodos);
  }
  checkboxes.forEach(cb => {
    cb.addEventListener('change', actualizarTotal);
  });
  actualizarTotal();
</script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
