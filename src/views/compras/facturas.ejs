          <div class="mb-3">
            <label class="form-label">Motivo / detalle</label>
            <textarea name="motivo_nc" id="notaCreditoMotivo" class="form-control" rows="3" placeholder="Ej: devolución, diferencia de precio, anulación parcial..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary">Guardar NC</button>
        </div>
      </form>
    </div>
  </div>
  </div>

  <div class="modal fade" id="abonoFacturaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" id="abonoFacturaForm">
        <div class="modal-header">
          <div>
            <h5 class="modal-title"><i class="bi bi-cash-coin me-1"></i> Registrar abono</h5>
            <small class="text-muted" id="abonoSubtitulo"></small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="tipo" id="abonoTipo">
          <div class="alert alert-success py-2">
            Saldo pendiente: <strong id="abonoSaldoTexto">₡0</strong>
            <span id="abonoActualTexto" class="d-block"></span>
          </div>
          <div class="mb-3">
            <label class="form-label">Fecha del abono</label>
            <input type="date" name="fecha_abono" id="abonoFecha" class="form-control" value="<%= hoy %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Monto del abono</label>
            <input type="number" step="0.01" min="0.01" name="monto_abono" id="abonoMonto" class="form-control" required>
            <small class="text-muted">Si el abono cubre todo el saldo, la factura queda pagada.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Periodo de cierre si queda pagada</label>
            <input type="month" name="periodo_cierre" id="abonoPeriodo" class="form-control" value="<%= hoy.slice(0, 7) %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Observación</label>
            <textarea name="observacion_abono" id="abonoObservacion" class="form-control" rows="3" placeholder="Ej: transferencia parcial, pago programado, abono de caja..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-success">Guardar abono</button>
        </div>
      </form>
    </div>
  </div>
  </div>
<% } %>

<!-- Modal para recepción de factura ligada a orden de compra -->
<% if (puedeRecibirFacturas) { %>
  <div class="modal fade" id="agregarFacturaModal" tabindex="-1" aria-labelledby="agregarFacturaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg receipt-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="agregarFacturaModalLabel"><i class="bi bi-box-seam me-1"></i> Recepción de factura</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/compras/facturas/agregar" id="recepcionFacturaForm">
        <div class="modal-body">
          <div class="alert alert-info receipt-help">
            Seleccione la orden de compra y registre la factura recibida.
          </div>

          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Orden de compra</label>
              <input type="text" class="form-control provider-search mb-1" data-provider-target="ordenFacturaSelect" placeholder="Buscar por proveedor o PO, ej: L">
              <select name="orden_id" id="ordenFacturaSelect" class="form-select">
                <option value=""><%= modoMensajero ? 'Seleccione una orden de compra' : 'Sin orden de compra / factura independiente' %></option>
                <% ordenesDisponibles.forEach(o => { %>
                  <option value="<%= o.id %>" data-provider-name="<%= o.proveedor_nombre %>" data-search-extra="<%= o.po_numero %>">
                    <%= o.po_numero %> · <%= o.proveedor_nombre %> · ₡<%= parseFloat(o.total || 0).toLocaleString('es-CR') %> · <%= o.estado.replace('_', ' ') %>
                  </option>
                <% }) %>
              </select>
              <small class="text-muted">Solo aparecen órdenes que aún no están facturadas.</small>
            </div>
            <div class="col-md-4">
              <label class="form-label">PO manual</label>
              <input type="text" name="po_numero" class="form-control" placeholder="Ej: 2026-381">
              <small class="text-muted">Úselo solo si no encuentra la orden arriba.</small>
            </div>
          </div>

          <hr>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Número de factura</label>
              <input type="text" name="factura" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Fecha de factura</label>
              <input type="date" name="fecha_factura" class="form-control" value="<%= hoy %>" required>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <% if (!modoMensajero) { %>
              <div class="col-md-4">
                <label class="form-label">Proveedor independiente</label>
                <input type="text" class="form-control provider-search mb-1" data-provider-target="proveedorIndependienteSelect" placeholder="Buscar por letra, ej: L">
                <select name="proveedor_id" id="proveedorIndependienteSelect" class="form-select">
                  <option value="">Solo si no hay PO</option>
                  <% proveedores.forEach(p => { %>
                    <option value="<%= p.id %>" data-provider-name="<%= p.nombre %>"><%= p.nombre %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Monto independiente</label>
                <input type="number" step="0.01" name="monto" class="form-control" placeholder="0.00">
                <small class="text-muted">En PO se usa el total de la orden.</small>
              </div>
            <% } %>
          </div>

          <div class="mt-3 camera-box">
            <label class="form-label">Foto del producto</label>
            <input type="file" id="fotoProductoInput" class="form-control" accept="image/*" capture="environment">
            <input type="hidden" name="foto_producto_data" id="fotoProductoData">
            <small class="text-muted">Opcional. Se guarda como evidencia de lo recibido.</small>
            <div id="fotoProductoPreview" class="mt-2"></div>
          </div>

          <div class="mt-3">
            <label class="form-label">Observación de recepción</label>
            <textarea name="observacion_recepcion" rows="3" class="form-control" placeholder="Ej: foto de respaldo, pendiente revisar cantidad..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar recepción</button>
        </div>
      </form>
    </div>
  </div>
  </div>
<% } %>

<script>
  function normalizarBusqueda(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function formatoColones(value) {
    return '₡' + (parseFloat(value || 0) || 0).toLocaleString('es-CR', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function setValue(id, value) {
    const element = document.getElementById(id);
    if (element) element.value = value || '';
  }

  function setText(id, value) {
    const element = document.getElementById(id);
    if (element) element.textContent = value || '';
  }

  function periodoDesdeFecha(fecha) {
    return /^\d{4}-\d{2}-\d{2}$/.test(String(fecha || '')) ? fecha.slice(0, 7) : '<%= hoy.slice(0, 7) %>';
  }

  document.querySelectorAll('.btn-editar-factura').forEach(button => {
    button.addEventListener('click', () => {
      const data = button.dataset;
      const form = document.getElementById('editarFacturaForm');
      if (!form) return;

      const esIndependiente = data.tipo === 'independiente';
      form.action = `/compras/facturas/${data.id}/editar`;
      setText('editarFacturaSubtitulo', `${data.proveedorNombre || 'Sin proveedor'} · ${data.po || 'Factura independiente'}`);
      setValue('editarTipoFactura', data.tipo);
      setValue('editarProveedorReadonly', data.proveedorNombre);
      setValue('editarNumeroFactura', data.numero);
      setValue('editarFechaFactura', data.fecha);
      setValue('editarMontoFactura', data.monto);
      setValue('editarPagadaFactura', data.pagada);
      setValue('editarFechaPagoFactura', data.fechaPago);
      setValue('editarPeriodoCierreFactura', data.periodoCierre || periodoDesdeFecha(data.fechaPago || data.fecha));
      setValue('editarVencimientoFactura', data.vencimiento);
      setValue('editarNumeroNc', data.numeroNc);
      setValue('editarFechaNc', data.fechaNc);
      setValue('editarMontoNc', data.montoNc || 0);
      setValue('editarMotivoNc', data.motivoNc);
      setValue('editarMontoAbono', data.montoAbono || 0);
      setValue('editarFechaAbono', data.fechaAbono);
      setValue('editarObservacionAbono', data.observacionAbono);
      setValue('editarFechaRecepcion', data.fechaRecepcion);
      setValue('editarTipoEntrega', data.tipoEntrega);
      setValue('editarEntregadoPor', data.entregadoPor);
      setValue('editarRecibidoPor', data.recibidoPor);
      setValue('editarProductoRecibido', data.productoRecibido || '0');
      setValue('editarPlacaProducto', data.placaProducto);
      setValue('editarObservacionRecepcion', data.observacionRecepcion);

      document.getElementById('editarProveedorReadonlyWrap')?.classList.toggle('d-none', esIndependiente);
      document.getElementById('editarProveedorSelectWrap')?.classList.toggle('d-none', !esIndependiente);
      document.getElementById('editarVencimientoWrap')?.classList.toggle('d-none', data.tipo !== 'orden');
      const proveedorSelect = document.getElementById('proveedorEditarGlobal');
      if (proveedorSelect) {
        proveedorSelect.required = esIndependiente;
        proveedorSelect.value = data.proveedorId || '';
      }

      const fotoActual = document.getElementById('fotoEditarActual');
      const fotoData = document.getElementById('fotoEditarDataGlobal');
      const fotoPreview = document.getElementById('fotoEditarPreviewGlobal');
      const fotoInput = document.querySelector('#editarFacturaModal .foto-producto-input');
      if (fotoData) fotoData.value = '';
      if (fotoPreview) fotoPreview.innerHTML = '';
      if (fotoInput) fotoInput.value = '';
      if (fotoActual) {
        fotoActual.innerHTML = data.fotoProducto
          ? `<a href="${data.fotoProducto}" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-image"></i> Ver foto actual</a>`
          : '<small class="text-muted">Sin foto actual.</small>';
      }
    });
  });

  document.querySelectorAll('.btn-nc-factura').forEach(button => {
    button.addEventListener('click', () => {
      const data = button.dataset;
      const form = document.getElementById('notaCreditoFacturaForm');
      if (!form) return;

      form.action = `/compras/facturas/${data.id}/nota-credito`;
      setValue('notaCreditoTipo', data.tipo);
      setText('notaCreditoSubtitulo', `Factura ${data.numero || '-'} · ${data.proveedorNombre || 'Sin proveedor'}`);
      setText('notaCreditoMontoTexto', formatoColones(data.monto));
      setValue('notaCreditoNumero', data.numeroNc);
      setValue('notaCreditoFecha', data.fechaNc || '<%= hoy %>');
      setValue('notaCreditoMonto', data.montoNc);
      setValue('notaCreditoMotivo', data.motivoNc);
      const montoInput = document.getElementById('notaCreditoMonto');
      if (montoInput) montoInput.max = data.monto || '';
    });
  });

  document.querySelectorAll('.btn-abono-factura').forEach(button => {
    button.addEventListener('click', () => {
      const data = button.dataset;
      const form = document.getElementById('abonoFacturaForm');
      if (!form) return;

      form.action = `/compras/facturas/${data.id}/abono`;
      setValue('abonoTipo', data.tipo);
      setText('abonoSubtitulo', `Factura ${data.numero || '-'} · ${data.proveedorNombre || 'Sin proveedor'}`);
      setText('abonoSaldoTexto', formatoColones(data.saldo));
      setText('abonoActualTexto', data.abonado && parseFloat(data.abonado) > 0 ? `Abonado actualmente: ${formatoColones(data.abonado)}` : '');
      setValue('abonoFecha', '<%= hoy %>');
      setValue('abonoPeriodo', '<%= hoy.slice(0, 7) %>');
      setValue('abonoMonto', '');
      setValue('abonoObservacion', data.observacionAbono);
      const montoInput = document.getElementById('abonoMonto');
      if (montoInput) montoInput.max = data.saldo || '';
    });
  });

  document.querySelectorAll('.btn-pagar-factura').forEach(button => {
    button.addEventListener('click', () => {
      const data = button.dataset;
      const form = document.getElementById('pagarFacturaForm');
      if (!form) return;

      form.action = `/compras/facturas/${data.id}/pagar`;
      setValue('pagarFacturaTipo', data.tipo);
      setValue('pagarFacturaFecha', '<%= hoy %>');
      setValue('pagarFacturaPeriodo', '<%= hoy.slice(0, 7) %>');
      setText('pagarFacturaSubtitulo', `Factura ${data.numero || '-'} · ${data.proveedorNombre || 'Sin proveedor'}`);
      setText('pagarFacturaSaldoTexto', formatoColones(data.saldo));
    });
  });

  [
    ['pagarFacturaFecha', 'pagarFacturaPeriodo'],
    ['pagarMultipleFecha', 'pagarMultiplePeriodo'],
    ['editarFechaPagoFactura', 'editarPeriodoCierreFactura'],
    ['abonoFecha', 'abonoPeriodo']
  ].forEach(([fechaId, periodoId]) => {
    const fechaInput = document.getElementById(fechaId);
    const periodoInput = document.getElementById(periodoId);
    if (!fechaInput || !periodoInput) return;
    fechaInput.addEventListener('change', () => {
      if (!periodoInput.value) periodoInput.value = periodoDesdeFecha(fechaInput.value);
    });
  });

  document.querySelectorAll('.provider-search').forEach(input => {
    input.addEventListener('input', () => {
      const target = document.getElementById(input.dataset.providerTarget);
      if (!target) return;

      const term = normalizarBusqueda(input.value);
      let selectedVisible = true;

      Array.from(target.options).forEach(option => {
        if (!option.value) {
          option.hidden = false;
          return;
        }

        const name = normalizarBusqueda(option.dataset.providerName || option.textContent);
        const extra = normalizarBusqueda(option.dataset.searchExtra || '');
        const visible = !term || name.startsWith(term) || extra.includes(term);
        option.hidden = !visible;

        if (option.selected && !visible) {
          selectedVisible = false;
        }
      });

      if (!selectedVisible) {
        target.value = '';
      }
    });
  });

  const fotoProductoInput = document.getElementById('fotoProductoInput');
  const fotoProductoData = document.getElementById('fotoProductoData');
  const fotoProductoPreview = document.getElementById('fotoProductoPreview');

  function comprimirFoto(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = () => reject(new Error('No se pudo leer la foto.'));
      reader.onload = () => {
        const img = new Image();
        img.onerror = () => reject(new Error('No se pudo procesar la foto.'));
        img.onload = () => {
          const maxSize = 1280;
          let { width, height } = img;

          if (width > height && width > maxSize) {
            height = Math.round((height * maxSize) / width);
            width = maxSize;
          } else if (height > maxSize) {
            width = Math.round((width * maxSize) / height);
            height = maxSize;
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL('image/jpeg', 0.78));
        };
        img.src = reader.result;
      };
      reader.readAsDataURL(file);
    });
  }

  function conectarFotoProducto(input, hidden, preview) {
    if (!input || !hidden) return;
    input.addEventListener('change', async () => {
      const file = input.files && input.files[0];
      hidden.value = '';
      if (preview) preview.innerHTML = '';
      if (!file) return;

      try {
        const dataUrl = await comprimirFoto(file);
        hidden.value = dataUrl;
        if (preview) {
          preview.innerHTML = `
            <div class="photo-preview-card">
              <img src="${dataUrl}" alt="Vista previa">
              <div class="small text-muted mt-1">Foto lista para guardar</div>
            </div>`;
        }
      } catch (error) {
        alert(error.message || 'No se pudo preparar la foto.');
        input.value = '';
      }
    });
  }

  conectarFotoProducto(fotoProductoInput, fotoProductoData, fotoProductoPreview);

  document.querySelectorAll('.foto-producto-input').forEach(input => {
    const hidden = document.getElementById(input.dataset.fotoTarget);
    const preview = document.getElementById(input.dataset.previewTarget);
    conectarFotoProducto(input, hidden, preview);
  });

  const checkboxes = document.querySelectorAll('.check-factura');
  const btnPagar = document.getElementById('btnPagarSeleccionadas');
  const totalSpan = document.getElementById('totalSeleccionado');
  const totalMultipleTexto = document.getElementById('pagarMultipleTotalTexto');
  const selectTodos = document.getElementById('seleccionarTodos');

  function actualizarTotal() {
    if (!btnPagar || !totalSpan) return;
    let total = 0;
    let seleccionadas = 0;
    checkboxes.forEach(cb => {
      if (cb.checked) {
        seleccionadas += 1;
        total += parseFloat(cb.dataset.monto || 0);
      }
    });
    totalSpan.innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (totalMultipleTexto) {
      totalMultipleTexto.innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    btnPagar.disabled = (seleccionadas === 0);
  }

  function marcarTodos() {
    const checked = selectTodos.checked;
    checkboxes.forEach(cb => {
      cb.checked = checked;
    });
    actualizarTotal();
  }

  if (selectTodos) {
    selectTodos.addEventListener('change', marcarTodos);
  }
  checkboxes.forEach(cb => {
    cb.addEventListener('change', actualizarTotal);
  });
  actualizarTotal();
</script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
