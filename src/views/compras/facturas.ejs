        <div class="mb-3">
          <label class="form-label">Fecha en que se pagaron</label>
          <input type="date" name="fecha_pago" id="pagarMultipleFecha" class="form-control" value="<%= hoy %>" form="multiplePagoForm" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Periodo de cierre</label>
          <input type="month" name="periodo_cierre" id="pagarMultiplePeriodo" class="form-control" value="<%= hoy.slice(0, 7) %>" form="multiplePagoForm">
        </div>
        <small class="text-muted">La misma fecha y periodo se aplicará a todas las facturas seleccionadas.</small>
