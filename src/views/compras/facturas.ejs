<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Gestión de Facturas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #eef2f7; font-family: 'Segoe UI', Roboto, sans-serif; }
    .container-facturas { max-width: 1480px; }
    .card { border: 1px solid #dbe3ef; border-radius: 18px; box-shadow: 0 8px 20px rgba(15,23,42,0.05); }
    .filtros-card {
      background: white;
      border: 1px solid #dbe3ef;
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(15,23,42,0.04);
      padding: 1.1rem;
      margin-bottom: 1.25rem;
    }
    .facturas-list-card { overflow: hidden; }
    .facturas-list-toolbar {
      border-bottom: 1px solid #e2e8f0;
      margin: -1rem -1rem 1rem;
      padding: 1rem;
    }
    .table-scroll {
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      max-height: calc(100vh - 330px);
      overflow: auto;
    }
    .table-facturas { font-size: .9rem; }
    .table-facturas th {
      background: #f8fafc;
      color: #334155;
      font-size: .72rem;
      letter-spacing: .02em;
      position: sticky;
      text-transform: uppercase;
      top: 0;
      z-index: 2;
    }
    .table-facturas td { vertical-align: middle; }
    .table-facturas tbody tr:hover { background: #f8fafc; }
    .badge-vencida { background-color: #dc3545; color: white; }
    .badge-pagada { background-color: #198754; }
    .badge-pendiente { background-color: #ffc107; color: #000; }
    .badge-nc { background-color: #0ea5e9; color: #fff; }
    .total-seleccion { font-size: 1.2rem; font-weight: bold; margin-top: 1rem; text-align: right; }
    .amount-stack { display: grid; gap: .2rem; }
    .amount-original { color: #64748b; font-size: .78rem; text-decoration: line-through; }
    .amount-credit { color: #0369a1; font-size: .8rem; font-weight: 700; }
    .amount-payment { color: #15803d; font-size: .8rem; font-weight: 700; }
    .amount-paid { color: #166534; font-size: .85rem; font-weight: 800; }
    .amount-balance { color: #111827; font-size: .98rem; font-weight: 800; }
    .provider-search {
      border-color: #bfdbfe;
      background: #f8fafc;
    }
    .messenger-card {
      background: linear-gradient(135deg, #ffffff, #f8fafc);
      border: 1px solid #dbe3ef;
    }
    .mobile-action {
      min-height: 44px;
    }
    .acciones-factura {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      min-width: 260px;
    }
    .acciones-factura .btn {
      border-radius: 999px;
      font-weight: 700;
    }
    .bulk-pay-bar {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: .8rem;
    }
    .receipt-modal .modal-content {
      border: 0;
      border-radius: 18px;
      overflow: hidden;
    }
    .receipt-modal .modal-header {
      background: #111827;
      color: #fff;
    }
    .receipt-modal .btn-close {
      filter: invert(1);
      opacity: .9;
    }
    .receipt-help {
      border-radius: 14px;
      margin-bottom: 1rem;
    }
    .camera-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 14px;
      padding: .9rem;
    }
    .photo-preview-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 14px;
      display: inline-block;
      padding: .6rem;
    }
    .photo-preview-card img {
      border-radius: 10px;
      max-height: 180px;
      max-width: 220px;
      object-fit: cover;
      width: 100%;
    }
    .nc-note {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      color: #1e3a8a;
      display: inline-grid;
      gap: .1rem;
      padding: .4rem .55rem;
      text-align: left;
    }
    .nc-note strong { font-size: .8rem; }
    .nc-note small { color: #1d4ed8; }
    .provider-pay-node {
      background: #ffffff;
      border: 1px solid #dbe3ef;
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(15,23,42,0.05);
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .provider-pay-head {
      align-items: center;
      background: linear-gradient(135deg, #0f172a, #1e40af);
      color: #fff;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 1rem 1.15rem;
    }
    .provider-pay-title {
      font-size: 1.05rem;
      font-weight: 900;
      margin: 0;
    }
    .provider-pay-body { padding: 1rem 1.15rem 1.15rem; }
    .pay-company-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      margin-bottom: 1rem;
    }
    .pay-company-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: .85rem;
    }
    .pay-company-card strong {
      color: #0f172a;
      display: block;
      font-size: .78rem;
      text-transform: uppercase;
    }
    .pay-company-card span {
      color: #111827;
      display: block;
      font-size: 1.25rem;
      font-weight: 900;
    }
    .pay-table-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      max-height: 300px;
      overflow: auto;
    }
    .pay-table {
      font-size: .84rem;
      margin: 0;
    }
    .pay-table th {
      background: #f8fafc;
      color: #334155;
      font-size: .72rem;
      position: sticky;
      text-transform: uppercase;
      top: 0;
      z-index: 1;
    }
    .pay-upload-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 14px;
      padding: .9rem;
    }
    @media (max-width: 576px) {
      body { background: #eef2f7; }
      .navbar {
        align-items: flex-start;
        gap: .6rem;
      }
      .navbar .navbar-brand {
        font-size: 1rem;
        white-space: normal;
      }
      .navbar .text-white {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        width: 100%;
      }
      .navbar .text-white .btn {
        margin-left: 0 !important;
      }
      .container {
        padding-left: .85rem;
        padding-right: .85rem;
      }
      .page-heading {
        align-items: stretch !important;
        gap: .8rem;
      }
      .page-heading .btn,
      .messenger-card .btn {
        min-height: 48px;
        width: 100%;
      }
      .page-title {
        font-size: 1.35rem;
        line-height: 1.15;
      }
      .page-subtitle {
        font-size: .92rem;
      }
      .messenger-card {
        border-radius: 16px;
        padding: 1rem !important;
      }
      .messenger-card .alert {
        border-radius: 14px;
        font-size: .9rem;
      }
      .receipt-modal {
        margin: 0;
        max-width: 100%;
      }
      .receipt-modal .modal-content {
        border-radius: 0;
        min-height: 100vh;
      }
      .receipt-modal .modal-header,
      .receipt-modal .modal-footer {
        position: sticky;
        z-index: 3;
      }
      .receipt-modal .modal-header {
        top: 0;
      }
      .receipt-modal .modal-footer {
        background: #fff;
        border-top: 1px solid #e2e8f0;
        bottom: 0;
        display: grid;
        gap: .55rem;
      }
      .receipt-modal .modal-footer .btn {
        margin: 0;
        min-height: 48px;
        width: 100%;
      }
      .receipt-modal .form-control,
      .receipt-modal .form-select {
        font-size: 1rem;
        min-height: 46px;
      }
      .receipt-modal textarea.form-control {
        min-height: 104px;
      }
      .receipt-help {
        font-size: .92rem;
      }
      .camera-box {
        padding: .8rem;
      }
      .photo-preview-card {
        display: block;
      }
      .photo-preview-card img {
        max-height: 260px;
        max-width: 100%;
      }
    }
    @media (max-width: 768px) {
      .table-scroll {
        border: 0;
        max-height: none;
        overflow: visible;
      }
      .table-facturas thead { display: none; }
      .table-facturas, .table-facturas tbody, .table-facturas tr, .table-facturas td {
        display: block;
        width: 100%;
      }
      .table-facturas tr { margin-bottom: 1rem; border: 1px solid #dee2e6; border-radius: 16px; padding: 0.8rem; background: white; }
      .table-facturas td { text-align: right; padding-left: 50%; position: relative; border-bottom: 1px solid #eee; }
      .table-facturas td::before { content: attr(data-label); position: absolute; left: 0.8rem; width: 45%; font-weight: 600; text-align: left; }
      .acciones-factura {
        justify-content: flex-end;
        min-width: 0;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-receipt"></i> Gestión de Facturas</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <% if (!['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol)) { %>
      <a href="/compras/ordenes" class="btn btn-sm btn-outline-light ms-2">← Órdenes</a>
      <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Dashboard</a>
    <% } %>
    <a href="/logout" class="btn btn-sm btn-warning ms-2">Salir</a>
  </div>
</nav>

<div class="container-fluid container-facturas py-4">
  <%
    const rolesGestionFacturas = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'];
    const rolesMensajeroFacturas = ['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'];
    const puedeGestionarFacturas = rolesGestionFacturas.includes(user.rol);
    const puedeRecibirFacturas = puedeGestionarFacturas || rolesMensajeroFacturas.includes(user.rol);
    const modoMensajero = rolesMensajeroFacturas.includes(user.rol);
    const puedeModificarCompras = puedeGestionarFacturas;
    const fechaInput = (value) => {
      if (!value) return '';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '' : date.toISOString().slice(0, 10);
    };
  %>
  <div class="page-heading">
    <div>
      <h1 class="page-title"><%= modoMensajero ? 'Recepción de facturas' : 'Facturas de compras' %></h1>
      <p class="page-subtitle">
        <%= modoMensajero ? 'Seleccione la orden de compra, registre la factura y adjunte la foto si aplica.' : 'Controla facturas pendientes, vencidas y pagos múltiples.' %>
      </p>
    </div>
    <% if (puedeRecibirFacturas) { %>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFacturaModal">
        <i class="bi bi-plus-circle"></i> Recibir factura
      </button>
    <% } %>
  </div>

  <!-- Mensajes flash -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (modoMensajero) { %>
    <div class="card p-4 messenger-card">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h3 class="page-title fs-5">Registrar recepción</h3>
          <p class="page-subtitle mb-0">
            Use el botón <strong>Recibir factura</strong>, seleccione la orden de compra y registre la factura recibida.
          </p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFacturaModal">
          <i class="bi bi-receipt"></i> Recibir factura
        </button>
      </div>
      <div class="alert alert-warning mt-3 mb-0">
        Su usuario solo puede registrar recepción de facturas ligadas a órdenes de compra. No puede pagar, editar órdenes, registrar NC ni ver otros módulos de compras.
      </div>
    </div>
  <% } else { %>

  <!-- Filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar facturas</h5>
    <form method="GET" action="/compras/facturas" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Proveedor</label>
        <input type="text" class="form-control form-control-sm provider-search mb-1" data-provider-target="proveedorFiltroSelect" placeholder="Buscar por letra, ej: L">
        <select name="proveedor_id" id="proveedorFiltroSelect" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" data-provider-name="<%= p.nombre %>" <%= filtros.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Estado de pago</label>
        <select name="pagada" class="form-select form-select-sm">
          <option value="">Todos</option>
          <option value="1" <%= filtros.pagada == '1' ? 'selected' : '' %>>Pagadas</option>
          <option value="0" <%= filtros.pagada == '0' ? 'selected' : '' %>>Pendientes</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Periodo cierre</label>
        <input type="month" name="periodo_cierre" class="form-control form-control-sm" value="<%= filtros.periodo_cierre || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Solo vencidas</label>
        <select name="vencida" class="form-select form-select-sm">
          <option value="">No</option>
          <option value="1" <%= filtros.vencida == '1' ? 'selected' : '' %>>Sí</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Orden</label>
        <select name="orden" class="form-select form-select-sm">
          <option value="asc" <%= filtros.orden === 'asc' ? 'selected' : '' %>>Más antigua primero</option>
          <option value="desc" <%= filtros.orden === 'desc' || !filtros.orden ? 'selected' : '' %>>Más reciente primero</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/facturas" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <%
    const totalFacturas = facturas.reduce((sum, f) => sum + (parseFloat(f.monto_original ?? f.monto) || 0), 0);
    const totalNotasCredito = facturas.reduce((sum, f) => sum + (parseFloat(f.nota_credito_monto) || 0), 0);
    const totalAbonos = facturas.reduce((sum, f) => sum + (parseFloat(f.abono_monto) || 0), 0);
    const totalPagado = facturas.reduce((sum, f) => sum + (parseFloat(f.monto_pagado) || 0), 0);
    const totalSaldo = facturas.reduce((sum, f) => {
      if (f.pagada || f.cubierta_por_nc) return sum;
      return sum + (parseFloat(f.saldo ?? f.monto) || 0);
    }, 0);
    const facturasPagadas = facturas.filter(f => f.pagada || f.cubierta_por_nc).length;
    const facturasPendientes = facturas.filter(f => !f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)).length;
    const facturasVencidas = facturas.filter(f => f.vencida).length;
    const reporteParams = new URLSearchParams();
    if (filtros.proveedor_id) reporteParams.set('proveedor_id', filtros.proveedor_id);
    if (filtros.fecha_desde) reporteParams.set('fecha_desde', filtros.fecha_desde);
    if (filtros.fecha_hasta) reporteParams.set('fecha_hasta', filtros.fecha_hasta);
    if (filtros.pagada) reporteParams.set('pagada', filtros.pagada);
    if (filtros.periodo_cierre) reporteParams.set('periodo_cierre', filtros.periodo_cierre);
    if (filtros.vencida) reporteParams.set('vencida', filtros.vencida);
    if (filtros.orden) reporteParams.set('orden', filtros.orden);
    const reporteFacturasUrl = '/compras/facturas/reporte/pdf' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const reporteFacturasExcelUrl = '/compras/facturas/reporte/excel' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const listaParams = new URLSearchParams(reporteParams);
    if (filtros.pagada) listaParams.set('pagada', filtros.pagada);
    const dashboardFacturasUrl = '/compras/facturas/dashboard' + (listaParams.toString() ? `?${listaParams.toString()}` : '');
    var returnToFacturas = '/compras/facturas' + (listaParams.toString() ? `?${listaParams.toString()}` : '');
  %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Facturas</div>
      <div class="summary-value"><%= facturas.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Monto original</div>
      <div class="summary-value">₡<%= totalFacturas.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Notas crédito</div>
      <div class="summary-value">₡<%= totalNotasCredito.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Abonos</div>
      <div class="summary-value">₡<%= totalAbonos.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Pagado</div>
      <div class="summary-value">₡<%= totalPagado.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Saldo pendiente</div>
      <div class="summary-value">₡<%= totalSaldo.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
  </div>

  <!-- Botón para agregar factura manual y listado -->
  <div class="card facturas-list-card p-3 p-lg-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 facturas-list-toolbar">
      <div>
        <h3 class="page-title fs-5">Listado de facturas</h3>
        <p class="page-subtitle">Pagadas/cubiertas: <%= facturasPagadas %> · Pendientes: <%= facturasPendientes %> · Vencidas: <%= facturasVencidas %></p>
      </div>
      <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a href="<%= dashboardFacturasUrl %>" class="btn btn-dark btn-sm">
          <i class="bi bi-bar-chart-line"></i> Dashboard facturas
        </a>
        <a href="/compras/facturas/pagos-proveedor" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-bank"></i> Pago proveedor
        </a>
        <a href="/compras/facturas/caja-chica" class="btn btn-outline-warning btn-sm">
          <i class="bi bi-wallet2"></i> Caja chica
        </a>
        <a href="/compras/facturas/reintegro-gastos" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-cash-stack"></i> Reintegro gastos
        </a>
        <a href="/compras/facturas/recibo-preview" target="_blank" class="btn btn-outline-dark btn-sm">
          <i class="bi bi-receipt"></i> Vista recibo
        </a>
        <a href="<%= reporteFacturasUrl %>" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-file-earmark-pdf"></i> PDF facturas
        </a>
        <a href="<%= reporteFacturasExcelUrl %>" class="btn btn-outline-success btn-sm">
          <i class="bi bi-file-earmark-excel"></i> Excel facturas
        </a>
      </div>
    </div>

    <form method="POST" action="/compras/facturas/pagar-multiple" id="multiplePagoForm">
      <div class="table-scroll">
        <table class="table table-hover align-middle table-facturas mb-0">
          <thead class="table-light">
            <tr>
              <% if (puedeModificarCompras) { %>
                <th style="width: 40px;"><input type="checkbox" id="seleccionarTodos"></th>
              <% } %>
              <th>PO Número</th>
              <th>Proveedor</th>
              <th>Fecha</th>
              <th>Recepción</th>
              <th>N° Factura</th>
              <th>Monto</th>
              <th>Fecha Vencimiento</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% facturas.forEach(f => { %>
              <tr class="<%= f.vencida ? 'table-danger' : '' %>">
                <% if (puedeModificarCompras) { %>
                  <td class="text-center">
                    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                      <input type="checkbox" name="facturas_ids" value="<%= f.tipo %>:<%= f.id %>" class="check-factura" data-monto="<%= f.saldo ?? f.monto %>">
                    <% } %>
                  </td>
                <% } %>
                <td data-label="PO Número"><%= f.po_numero ? f.po_numero : '—' %></td>
                <td data-label="Proveedor"><%= f.proveedor_nombre %></td>
                <td data-label="Fecha"><%= new Date(f.fecha).toLocaleDateString('es-CR') %></td>
                <td data-label="Recepción">
                  <div class="small">
                    <% if (f.factura_foto_producto) { %>
                      <div>
                        <a href="<%= f.factura_foto_producto %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-image"></i> Ver foto
                        </a>
                      </div>
                    <% } %>
                    <% if (f.factura_observacion) { %>
                      <div class="text-muted mt-1"><%= f.factura_observacion %></div>
                    <% } %>
                    <% if (!f.factura_foto_producto && !f.factura_observacion) { %>
                      <span class="text-muted">Sin evidencia</span>
                    <% } %>
                  </div>
                </td>
                <td data-label="N° Factura">
                  <strong><%= f.numero_factura %></strong>
                </td>
                <td data-label="Monto" class="monto-factura money" data-val="<%= f.saldo ?? f.monto %>">
                  <div class="amount-stack">
                    <% const montoPagadoFactura = parseFloat(f.monto_pagado || 0); %>
                    <% if (f.tiene_nc || f.tiene_abono || montoPagadoFactura > 0) { %>
                      <span class="amount-original">Factura: ₡<%= parseFloat(f.monto_original ?? f.monto).toLocaleString('es-CR') %></span>
                      <% if (f.tiene_nc) { %>
                        <span class="amount-credit">NC: -₡<%= parseFloat(f.nota_credito_monto || 0).toLocaleString('es-CR') %></span>
                      <% } %>
                      <% if (f.tiene_abono) { %>
                        <span class="amount-payment">Abonos: -₡<%= parseFloat(f.abono_monto || 0).toLocaleString('es-CR') %></span>
                      <% } %>
                      <% if (montoPagadoFactura > 0) { %>
                        <span class="amount-paid">Pagado: ₡<%= montoPagadoFactura.toLocaleString('es-CR') %></span>
                      <% } %>
                      <span class="amount-balance">Saldo: ₡<%= parseFloat(f.saldo || 0).toLocaleString('es-CR') %></span>
                    <% } else { %>
                      <span class="amount-balance">₡<%= parseFloat(f.monto).toLocaleString('es-CR') %></span>
                    <% } %>
                  </div>
                </td>
                <td data-label="Fecha Vencimiento">
                  <%= f.fecha_vencimiento_factura ? new Date(f.fecha_vencimiento_factura).toLocaleDateString('es-CR') : '—' %>
                  <% if (f.vencida) { %>
                    <span class="badge badge-vencida ms-1">Vencida</span>
                  <% } %>
                </td>
                <td data-label="Estado">
                  <% if (f.cubierta_por_nc) { %>
                    <span class="badge badge-nc">Cubierta por NC</span>
                  <% } else if (f.pagada) { %>
                    <span class="badge badge-pagada">Pagada el <%= new Date(f.fecha_pago).toLocaleDateString('es-CR') %></span>
                    <% if (f.periodo_cierre) { %>
                      <div class="small text-muted mt-1">Cierre <%= f.periodo_cierre %></div>
                    <% } %>
                  <% } else { %>
                    <span class="badge badge-pendiente">Pendiente</span>
                  <% } %>
                  <% if (f.tiene_nc && !f.cubierta_por_nc) { %>
                    <div class="mt-2">
                      <span class="badge badge-nc">NC aplicada</span>
                    </div>
                  <% } %>
                  <% if (f.tiene_abono && !f.pagada) { %>
                    <div class="mt-2">
                      <span class="badge bg-success">Con abono</span>
                    </div>
                  <% } %>
                </td>
                <td data-label="Acciones">
                  <% if (puedeModificarCompras) { %>
                    <div class="acciones-factura">
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-dark btn-editar-factura"
                        data-bs-toggle="modal"
                        data-bs-target="#editarFacturaModal"
                        data-id="<%= f.id %>"
                        data-tipo="<%= f.tipo %>"
                        data-proveedor-id="<%= f.proveedor_id || '' %>"
                        data-proveedor-nombre="<%= f.proveedor_nombre || '' %>"
                        data-po="<%= f.po_numero || '' %>"
                        data-numero="<%= f.numero_factura || '' %>"
                        data-fecha="<%= fechaInput(f.fecha) || hoy %>"
                        data-monto="<%= f.monto_original ?? f.monto %>"
                        data-pagada="<%= f.pagada ? '1' : '0' %>"
                        data-fecha-pago="<%= fechaInput(f.fecha_pago) %>"
                        data-periodo-cierre="<%= f.periodo_cierre || '' %>"
                        data-vencimiento="<%= fechaInput(f.fecha_vencimiento_factura) %>"
                        data-numero-nc="<%= f.nota_credito_numero || '' %>"
                        data-fecha-nc="<%= fechaInput(f.nota_credito_fecha) %>"
                        data-monto-nc="<%= f.nota_credito_monto || 0 %>"
                        data-motivo-nc="<%= f.nota_credito_motivo || '' %>"
                        data-monto-abono="<%= f.abono_monto || 0 %>"
                        data-fecha-abono="<%= fechaInput(f.abono_fecha) %>"
                        data-observacion-abono="<%= f.abono_observacion || '' %>"
                        data-fecha-recepcion="<%= fechaInput(f.factura_fecha_recepcion || f.fecha_recepcion) %>"
                        data-tipo-entrega="<%= f.factura_tipo_entrega || '' %>"
                        data-entregado-por="<%= f.factura_entregado_por || '' %>"
                        data-recibido-por="<%= f.factura_recibido_por || '' %>"
                        data-producto-recibido="<%= f.factura_producto_recibido ? '1' : '0' %>"
                        data-placa-producto="<%= f.factura_placa_producto || '' %>"
                        data-observacion-recepcion="<%= f.factura_observacion || '' %>"
                        data-foto-producto="<%= f.factura_foto_producto || '' %>">
                        <i class="bi bi-pencil-square"></i> Editar
                      </button>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-primary btn-nc-factura"
                        data-bs-toggle="modal"
                        data-bs-target="#notaCreditoFacturaModal"
                        data-id="<%= f.id %>"
                        data-tipo="<%= f.tipo %>"
                        data-numero="<%= f.numero_factura || '' %>"
                        data-proveedor-nombre="<%= f.proveedor_nombre || '' %>"
                        data-monto="<%= f.monto_original ?? f.monto %>"
                        data-numero-nc="<%= f.nota_credito_numero || '' %>"
                        data-fecha-nc="<%= fechaInput(f.nota_credito_fecha) || hoy %>"
                        data-monto-nc="<%= f.nota_credito_monto || '' %>"
                        data-motivo-nc="<%= f.nota_credito_motivo || '' %>">
                        <i class="bi bi-journal-minus"></i> NC
                      </button>
                      <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-success btn-abono-factura"
                          data-bs-toggle="modal"
                          data-bs-target="#abonoFacturaModal"
                          data-id="<%= f.id %>"
                          data-tipo="<%= f.tipo %>"
                          data-numero="<%= f.numero_factura || '' %>"
                          data-proveedor-nombre="<%= f.proveedor_nombre || '' %>"
                          data-saldo="<%= f.saldo || 0 %>"
                          data-abonado="<%= f.abono_monto || 0 %>"
                          data-observacion-abono="<%= f.abono_observacion || '' %>">
                          <i class="bi bi-cash-coin"></i> Abonar
                        </button>
                        <button
                          type="button"
                          class="btn btn-sm btn-success btn-pagar-factura"
                          data-bs-toggle="modal"
                          data-bs-target="#pagarFacturaModal"
                          data-id="<%= f.id %>"
                          data-tipo="<%= f.tipo %>"
                          data-numero="<%= f.numero_factura || '' %>"
                          data-proveedor-nombre="<%= f.proveedor_nombre || '' %>"
                          data-saldo="<%= f.saldo || 0 %>">
                          <i class="bi bi-check-circle"></i> Pagar
                        </button>
                      <% } else { %>
                        <span class="badge bg-secondary align-self-center"><%= f.cubierta_por_nc ? 'Sin saldo' : 'Pagada' %></span>
                      <% } %>
                      <button
                        type="submit"
                        form="eliminar-factura-<%= f.tipo %>-<%= f.id %>"
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('<%= f.tipo === 'orden' ? '¿Eliminar esta factura? La orden de compra no se elimina, solo se quita la factura ligada.' : '¿Eliminar esta factura independiente? Esta acción no se puede deshacer.' %>')">
                        <i class="bi bi-trash"></i> Eliminar
                      </button>
                    </div>
                  <% } else { %>
                    <span class="badge bg-secondary">Solo lectura</span>
                  <% } %>
                  <% if (f.tiene_nc) { %>
                    <div class="nc-note mt-2">
                      <strong>NC <%= f.nota_credito_numero || 'registrada' %></strong>
                      <small><%= f.nota_credito_fecha ? new Date(f.nota_credito_fecha).toLocaleDateString('es-CR') : 'Sin fecha' %></small>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (facturas.length === 0) { %>
              <tr><td colspan="<%= puedeModificarCompras ? 10 : 9 %>" class="text-center py-4">No hay facturas con los filtros seleccionados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (puedeModificarCompras) { %>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 bulk-pay-bar">
          <div>
            <button
              type="button"
              class="btn btn-success"
              id="btnPagarSeleccionadas"
              data-bs-toggle="modal"
              data-bs-target="#pagarMultipleModal"
              disabled>
              <i class="bi bi-check2-circle"></i> Pagar seleccionadas
            </button>
          </div>
          <div class="total-seleccion">
            <strong>Total seleccionado:</strong> <span id="totalSeleccionado">₡0,00</span>
          </div>
        </div>
      <% } %>
    </form>

    <% if (puedeModificarCompras) { %>
      <% facturas.forEach(f => { %>
        <form
          id="eliminar-factura-<%= f.tipo %>-<%= f.id %>"
          method="POST"
          action="/compras/facturas/<%= f.id %>/eliminar"
          class="d-none">
          <input type="hidden" name="tipo" value="<%= f.tipo %>">
          <input type="hidden" name="return_to" value="<%= returnToFacturas %>">
        </form>
        <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
          <form
            id="pagar-factura-<%= f.tipo %>-<%= f.id %>"
            method="POST"
            action="/compras/facturas/<%= f.id %>/pagar"
            class="d-none">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
          </form>
        <% } %>
      <% }) %>
    <% } %>
  </div>

  <% } %>
</div>

<% if (puedeModificarCompras) { %>
