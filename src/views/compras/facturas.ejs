<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Gestión de Facturas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f0f2f5; font-family: 'Segoe UI', Roboto, sans-serif; }
    .card { border: none; border-radius: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.04); }
    .filtros-card { background: white; border-radius: 20px; padding: 1.5rem; margin-bottom: 1.8rem; }
    .table-facturas th { background: #f8fafc; }
    .badge-vencida { background-color: #dc3545; color: white; }
    .badge-pagada { background-color: #198754; }
    .badge-pendiente { background-color: #ffc107; color: #000; }
    .badge-nc { background-color: #0ea5e9; color: #fff; }
    .total-seleccion { font-size: 1.2rem; font-weight: bold; margin-top: 1rem; text-align: right; }
    .amount-stack { display: grid; gap: .2rem; }
    .amount-original { color: #64748b; font-size: .78rem; text-decoration: line-through; }
    .amount-credit { color: #0369a1; font-size: .8rem; font-weight: 700; }
    .amount-payment { color: #15803d; font-size: .8rem; font-weight: 700; }
    .amount-balance { color: #111827; font-size: .98rem; font-weight: 800; }
    .provider-search {
      border-color: #bfdbfe;
      background: #f8fafc;
    }
    .messenger-card {
      background: linear-gradient(135deg, #ffffff, #f8fafc);
      border: 1px solid #dbe3ef;
    }
    .mobile-action {
      min-height: 44px;
    }
    .receipt-modal .modal-content {
      border: 0;
      border-radius: 18px;
      overflow: hidden;
    }
    .receipt-modal .modal-header {
      background: #111827;
      color: #fff;
    }
    .receipt-modal .btn-close {
      filter: invert(1);
      opacity: .9;
    }
    .receipt-help {
      border-radius: 14px;
      margin-bottom: 1rem;
    }
    .camera-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 14px;
      padding: .9rem;
    }
    .photo-preview-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 14px;
      display: inline-block;
      padding: .6rem;
    }
    .photo-preview-card img {
      border-radius: 10px;
      max-height: 180px;
      max-width: 220px;
      object-fit: cover;
      width: 100%;
    }
    .nc-note {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      color: #1e3a8a;
      display: inline-grid;
      gap: .1rem;
      padding: .4rem .55rem;
      text-align: left;
    }
    .nc-note strong { font-size: .8rem; }
    .nc-note small { color: #1d4ed8; }
    @media (max-width: 576px) {
      body { background: #eef2f7; }
      .navbar {
        align-items: flex-start;
        gap: .6rem;
      }
      .navbar .navbar-brand {
        font-size: 1rem;
        white-space: normal;
      }
      .navbar .text-white {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        width: 100%;
      }
      .navbar .text-white .btn {
        margin-left: 0 !important;
      }
      .container {
        padding-left: .85rem;
        padding-right: .85rem;
      }
      .page-heading {
        align-items: stretch !important;
        gap: .8rem;
      }
      .page-heading .btn,
      .messenger-card .btn {
        min-height: 48px;
        width: 100%;
      }
      .page-title {
        font-size: 1.35rem;
        line-height: 1.15;
      }
      .page-subtitle {
        font-size: .92rem;
      }
      .messenger-card {
        border-radius: 16px;
        padding: 1rem !important;
      }
      .messenger-card .alert {
        border-radius: 14px;
        font-size: .9rem;
      }
      .receipt-modal {
        margin: 0;
        max-width: 100%;
      }
      .receipt-modal .modal-content {
        border-radius: 0;
        min-height: 100vh;
      }
      .receipt-modal .modal-header,
      .receipt-modal .modal-footer {
        position: sticky;
        z-index: 3;
      }
      .receipt-modal .modal-header {
        top: 0;
      }
      .receipt-modal .modal-footer {
        background: #fff;
        border-top: 1px solid #e2e8f0;
        bottom: 0;
        display: grid;
        gap: .55rem;
      }
      .receipt-modal .modal-footer .btn {
        margin: 0;
        min-height: 48px;
        width: 100%;
      }
      .receipt-modal .form-control,
      .receipt-modal .form-select {
        font-size: 1rem;
        min-height: 46px;
      }
      .receipt-modal textarea.form-control {
        min-height: 104px;
      }
      .receipt-help {
        font-size: .92rem;
      }
      .camera-box {
        padding: .8rem;
      }
      .photo-preview-card {
        display: block;
      }
      .photo-preview-card img {
        max-height: 260px;
        max-width: 100%;
      }
    }
    @media (max-width: 768px) {
      .table-facturas thead { display: none; }
      .table-facturas, .table-facturas tbody, .table-facturas tr, .table-facturas td {
        display: block;
        width: 100%;
      }
      .table-facturas tr { margin-bottom: 1rem; border: 1px solid #dee2e6; border-radius: 16px; padding: 0.8rem; background: white; }
      .table-facturas td { text-align: right; padding-left: 50%; position: relative; border-bottom: 1px solid #eee; }
      .table-facturas td::before { content: attr(data-label); position: absolute; left: 0.8rem; width: 45%; font-weight: 600; text-align: left; }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-receipt"></i> Gestión de Facturas</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <% if (!['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol)) { %>
      <a href="/compras/ordenes" class="btn btn-sm btn-outline-light ms-2">← Órdenes</a>
      <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Dashboard</a>
    <% } %>
    <a href="/logout" class="btn btn-sm btn-warning ms-2">Salir</a>
  </div>
</nav>

<div class="container py-4">
  <%
    const rolesGestionFacturas = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'];
    const rolesMensajeroFacturas = ['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'];
    const puedeGestionarFacturas = rolesGestionFacturas.includes(user.rol);
    const puedeRecibirFacturas = puedeGestionarFacturas || rolesMensajeroFacturas.includes(user.rol);
    const modoMensajero = rolesMensajeroFacturas.includes(user.rol);
    const puedeModificarCompras = puedeGestionarFacturas;
  %>
  <div class="page-heading">
    <div>
      <h1 class="page-title"><%= modoMensajero ? 'Recepción de facturas' : 'Facturas de compras' %></h1>
      <p class="page-subtitle">
        <%= modoMensajero ? 'Seleccione la orden de compra, registre la factura y adjunte la foto si aplica.' : 'Controla facturas pendientes, vencidas y pagos múltiples.' %>
      </p>
    </div>
    <% if (puedeRecibirFacturas) { %>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFacturaModal">
        <i class="bi bi-plus-circle"></i> Recibir factura
      </button>
    <% } %>
  </div>

  <!-- Mensajes flash -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (modoMensajero) { %>
    <div class="card p-4 messenger-card">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h3 class="page-title fs-5">Registrar recepción</h3>
          <p class="page-subtitle mb-0">
            Use el botón <strong>Recibir factura</strong>, seleccione la orden de compra y registre la factura recibida.
          </p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFacturaModal">
          <i class="bi bi-receipt"></i> Recibir factura
        </button>
      </div>
      <div class="alert alert-warning mt-3 mb-0">
        Su usuario solo puede registrar recepción de facturas ligadas a órdenes de compra. No puede pagar, editar órdenes, registrar NC ni ver otros módulos de compras.
      </div>
    </div>
  <% } else { %>

  <!-- Filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar facturas</h5>
    <form method="GET" action="/compras/facturas" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Proveedor</label>
        <input type="text" class="form-control form-control-sm provider-search mb-1" data-provider-target="proveedorFiltroSelect" placeholder="Buscar por letra, ej: L">
        <select name="proveedor_id" id="proveedorFiltroSelect" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" data-provider-name="<%= p.nombre %>" <%= filtros.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Estado de pago</label>
        <select name="pagada" class="form-select form-select-sm">
          <option value="">Todos</option>
          <option value="1" <%= filtros.pagada == '1' ? 'selected' : '' %>>Pagadas</option>
          <option value="0" <%= filtros.pagada == '0' ? 'selected' : '' %>>Pendientes</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Solo vencidas</label>
        <select name="vencida" class="form-select form-select-sm">
          <option value="">No</option>
          <option value="1" <%= filtros.vencida == '1' ? 'selected' : '' %>>Sí</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold">Orden</label>
        <select name="orden" class="form-select form-select-sm">
          <option value="asc" <%= filtros.orden === 'asc' ? 'selected' : '' %>>Más antigua primero</option>
          <option value="desc" <%= filtros.orden === 'desc' || !filtros.orden ? 'selected' : '' %>>Más reciente primero</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/facturas" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <%
    const totalFacturas = facturas.reduce((sum, f) => sum + (parseFloat(f.monto_original ?? f.monto) || 0), 0);
    const totalNotasCredito = facturas.reduce((sum, f) => sum + (parseFloat(f.nota_credito_monto) || 0), 0);
    const totalAbonos = facturas.reduce((sum, f) => sum + (parseFloat(f.abono_monto) || 0), 0);
    const totalSaldo = facturas.reduce((sum, f) => {
      if (f.pagada || f.cubierta_por_nc) return sum;
      return sum + (parseFloat(f.saldo ?? f.monto) || 0);
    }, 0);
    const facturasPagadas = facturas.filter(f => f.pagada || f.cubierta_por_nc).length;
    const facturasPendientes = facturas.filter(f => !f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)).length;
    const facturasVencidas = facturas.filter(f => f.vencida).length;
    const reporteParams = new URLSearchParams();
    if (filtros.proveedor_id) reporteParams.set('proveedor_id', filtros.proveedor_id);
    if (filtros.fecha_desde) reporteParams.set('fecha_desde', filtros.fecha_desde);
    if (filtros.fecha_hasta) reporteParams.set('fecha_hasta', filtros.fecha_hasta);
    if (filtros.vencida) reporteParams.set('vencida', filtros.vencida);
    if (filtros.orden) reporteParams.set('orden', filtros.orden);
    const reportePendientesUrl = '/compras/facturas/reporte/pdf' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const reportePendientesExcelUrl = '/compras/facturas/reporte/excel' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const listaParams = new URLSearchParams(reporteParams);
    if (filtros.pagada) listaParams.set('pagada', filtros.pagada);
    var returnToFacturas = '/compras/facturas' + (listaParams.toString() ? `?${listaParams.toString()}` : '');
  %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Facturas</div>
      <div class="summary-value"><%= facturas.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Monto original</div>
      <div class="summary-value">₡<%= totalFacturas.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Notas crédito</div>
      <div class="summary-value">₡<%= totalNotasCredito.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Abonos</div>
      <div class="summary-value">₡<%= totalAbonos.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Saldo pendiente</div>
      <div class="summary-value">₡<%= totalSaldo.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div>
    </div>
  </div>

  <!-- Botón para agregar factura manual y listado -->
  <div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="page-title fs-5">Listado de facturas</h3>
        <p class="page-subtitle">Pagadas/cubiertas: <%= facturasPagadas %> · Pendientes: <%= facturasPendientes %> · Vencidas: <%= facturasVencidas %></p>
      </div>
      <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a href="<%= reportePendientesUrl %>" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-file-earmark-pdf"></i> PDF pendientes
        </a>
        <a href="<%= reportePendientesExcelUrl %>" class="btn btn-outline-success btn-sm">
          <i class="bi bi-file-earmark-excel"></i> Excel pendientes
        </a>
      </div>
    </div>

    <form method="POST" action="/compras/facturas/pagar-multiple" id="multiplePagoForm">
      <div class="table-responsive">
        <table class="table table-bordered table-hover table-facturas">
          <thead class="table-light">
            <tr>
              <% if (puedeModificarCompras) { %>
                <th style="width: 40px;"><input type="checkbox" id="seleccionarTodos"></th>
              <% } %>
              <th>PO Número</th>
              <th>Proveedor</th>
              <th>Fecha</th>
              <th>Recepción</th>
              <th>N° Factura</th>
              <th>Monto</th>
              <th>Fecha Vencimiento</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% facturas.forEach(f => { %>
              <tr class="<%= f.vencida ? 'table-danger' : '' %>">
                <% if (puedeModificarCompras) { %>
                  <td class="text-center">
                    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                      <input type="checkbox" name="facturas_ids" value="<%= f.tipo %>:<%= f.id %>" class="check-factura" data-monto="<%= f.saldo ?? f.monto %>">
                    <% } %>
                  </td>
                <% } %>
                <td data-label="PO Número"><%= f.po_numero ? f.po_numero : '—' %></td>
                <td data-label="Proveedor"><%= f.proveedor_nombre %></td>
                <td data-label="Fecha"><%= new Date(f.fecha).toLocaleDateString('es-CR') %></td>
                <td data-label="Recepción">
                  <div class="small">
                    <% if (f.factura_foto_producto) { %>
                      <div>
                        <a href="<%= f.factura_foto_producto %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                          <i class="bi bi-image"></i> Ver foto
                        </a>
                      </div>
                    <% } %>
                    <% if (f.factura_observacion) { %>
                      <div class="text-muted mt-1"><%= f.factura_observacion %></div>
                    <% } %>
                    <% if (!f.factura_foto_producto && !f.factura_observacion) { %>
                      <span class="text-muted">Sin evidencia</span>
                    <% } %>
                  </div>
                </td>
                <td data-label="N° Factura">
                  <strong><%= f.numero_factura %></strong>
                  <% if (puedeModificarCompras) { %>
                    <button
                      type="button"
                      class="btn btn-link btn-sm p-0 ms-1 align-baseline"
                      data-bs-toggle="modal"
                      data-bs-target="#editar-numero-<%= f.tipo %>-<%= f.id %>">
                      Editar
                    </button>
                  <% } %>
                </td>
                <td data-label="Monto" class="monto-factura money" data-val="<%= f.saldo ?? f.monto %>">
                  <div class="amount-stack">
                    <% if (f.tiene_nc || f.tiene_abono) { %>
                      <span class="amount-original">Factura: ₡<%= parseFloat(f.monto_original ?? f.monto).toLocaleString('es-CR') %></span>
                      <% if (f.tiene_nc) { %>
                        <span class="amount-credit">NC: -₡<%= parseFloat(f.nota_credito_monto || 0).toLocaleString('es-CR') %></span>
                      <% } %>
                      <% if (f.tiene_abono) { %>
                        <span class="amount-payment">Abonos: -₡<%= parseFloat(f.abono_monto || 0).toLocaleString('es-CR') %></span>
                      <% } %>
                      <span class="amount-balance">Saldo: ₡<%= parseFloat(f.saldo || 0).toLocaleString('es-CR') %></span>
                    <% } else { %>
                      <span class="amount-balance">₡<%= parseFloat(f.monto).toLocaleString('es-CR') %></span>
                    <% } %>
                  </div>
                </td>
                <td data-label="Fecha Vencimiento">
                  <%= f.fecha_vencimiento_factura ? new Date(f.fecha_vencimiento_factura).toLocaleDateString('es-CR') : '—' %>
                  <% if (f.vencida) { %>
                    <span class="badge badge-vencida ms-1">Vencida</span>
                  <% } %>
                </td>
                <td data-label="Estado">
                  <% if (f.cubierta_por_nc) { %>
                    <span class="badge badge-nc">Cubierta por NC</span>
                  <% } else if (f.pagada) { %>
                    <span class="badge badge-pagada">Pagada el <%= new Date(f.fecha_pago).toLocaleDateString('es-CR') %></span>
                  <% } else { %>
                    <span class="badge badge-pendiente">Pendiente</span>
                  <% } %>
                  <% if (f.tiene_nc && !f.cubierta_por_nc) { %>
                    <div class="mt-2">
                      <span class="badge badge-nc">NC aplicada</span>
                    </div>
                  <% } %>
                  <% if (f.tiene_abono && !f.pagada) { %>
                    <div class="mt-2">
                      <span class="badge bg-success">Con abono</span>
                    </div>
                  <% } %>
                </td>
                <td data-label="Acciones">
                  <% if (puedeModificarCompras) { %>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-dark mb-1"
                      data-bs-toggle="modal"
                      data-bs-target="#editar-numero-<%= f.tipo %>-<%= f.id %>">
                      <i class="bi bi-pencil-square"></i> N°
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-primary mb-1"
                      data-bs-toggle="modal"
                      data-bs-target="#nc-<%= f.tipo %>-<%= f.id %>">
                      <i class="bi bi-journal-minus"></i> NC
                    </button>
                    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-success mb-1"
                        data-bs-toggle="modal"
                        data-bs-target="#abono-<%= f.tipo %>-<%= f.id %>">
                        <i class="bi bi-cash-coin"></i> Abonar
                      </button>
                      <button
                        type="submit"
                        form="pagar-factura-<%= f.tipo %>-<%= f.id %>"
                        class="btn btn-sm btn-success"
                        onclick="return confirm('¿Marcar esta factura como pagada?')">
                        <i class="bi bi-check-circle"></i> Pagar
                      </button>
                    <% } else { %>
                      <span class="text-muted d-block"><%= f.cubierta_por_nc ? 'Sin saldo' : 'Pagada' %></span>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-secondary">Solo lectura</span>
                  <% } %>
                  <% if (f.tiene_nc) { %>
                    <div class="nc-note mt-2">
                      <strong>NC <%= f.nota_credito_numero || 'registrada' %></strong>
                      <small><%= f.nota_credito_fecha ? new Date(f.nota_credito_fecha).toLocaleDateString('es-CR') : 'Sin fecha' %></small>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (facturas.length === 0) { %>
              <tr><td colspan="<%= puedeModificarCompras ? 10 : 9 %>" class="text-center py-4">No hay facturas con los filtros seleccionados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (puedeModificarCompras) { %>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <div>
            <button type="submit" class="btn btn-success" id="btnPagarSeleccionadas" disabled>
              <i class="bi bi-check2-circle"></i> Pagar seleccionadas
            </button>
          </div>
          <div class="total-seleccion">
            <strong>Total seleccionado:</strong> <span id="totalSeleccionado">₡0,00</span>
          </div>
        </div>
      <% } %>
    </form>

    <% if (puedeModificarCompras) { %>
      <% facturas.forEach(f => { %>
        <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
          <form
            id="pagar-factura-<%= f.tipo %>-<%= f.id %>"
            method="POST"
            action="/compras/facturas/<%= f.id %>/pagar"
            class="d-none">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
          </form>
        <% } %>
      <% }) %>
    <% } %>
  </div>

  <% } %>
</div>

<% if (puedeModificarCompras) { %>
  <% facturas.forEach(f => { %>
    <div class="modal fade" id="editar-numero-<%= f.tipo %>-<%= f.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/compras/facturas/<%= f.id %>/numero">
          <div class="modal-header">
            <div>
              <h5 class="modal-title"><i class="bi bi-pencil-square me-1"></i> Editar número de factura</h5>
              <small class="text-muted"><%= f.proveedor_nombre %> · <%= f.po_numero || 'Factura independiente' %></small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
            <input type="hidden" name="return_to" value="<%= returnToFacturas %>">
            <label class="form-label">Número de factura</label>
            <input type="text" name="numero_factura" class="form-control" value="<%= f.numero_factura || '' %>" required>
            <small class="text-muted">Solo se cambiará el número de factura. No modifica monto, proveedor, fecha, pago, NC ni abonos.</small>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-dark">Guardar número</button>
          </div>
        </form>
      </div>
    </div>
    </div>

    <div class="modal fade" id="nc-<%= f.tipo %>-<%= f.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/compras/facturas/<%= f.id %>/nota-credito">
          <div class="modal-header">
            <div>
              <h5 class="modal-title"><i class="bi bi-journal-minus me-1"></i> Nota de crédito</h5>
              <small class="text-muted">Factura <%= f.numero_factura %> · <%= f.proveedor_nombre %></small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="tipo" value="<%= f.tipo %>">
            <div class="alert alert-info py-2">
              Monto factura: <strong>₡<%= parseFloat(f.monto_original ?? f.monto).toLocaleString('es-CR') %></strong>
              <% if (f.tiene_nc) { %>
                <br>NC actual: <strong>₡<%= parseFloat(f.nota_credito_monto || 0).toLocaleString('es-CR') %></strong>
              <% } %>
            </div>
            <div class="mb-3">
              <label class="form-label">Número de NC</label>
              <input type="text" name="numero_nc" class="form-control" value="<%= f.nota_credito_numero || '' %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Fecha de NC</label>
              <input type="date" name="fecha_nc" class="form-control" value="<%= f.nota_credito_fecha ? new Date(f.nota_credito_fecha).toISOString().slice(0, 10) : hoy %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Monto de NC</label>
              <input type="number" step="0.01" min="0.01" max="<%= f.monto_original ?? f.monto %>" name="monto_nc" class="form-control" value="<%= f.nota_credito_monto || '' %>" required>
              <small class="text-muted">Si cubre todo el monto, la factura queda liquidada por NC.</small>
            </div>
            <div class="mb-3">
              <label class="form-label">Motivo / detalle</label>
              <textarea name="motivo_nc" class="form-control" rows="3" placeholder="Ej: devolución, diferencia de precio, anulación parcial..."><%= f.nota_credito_motivo || '' %></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-primary">Guardar NC</button>
          </div>
        </form>
      </div>
    </div>
    </div>
    <% if (!f.pagada && (parseFloat(f.saldo ?? f.monto) > 0)) { %>
      <div class="modal fade" id="abono-<%= f.tipo %>-<%= f.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form method="POST" action="/compras/facturas/<%= f.id %>/abono">
            <div class="modal-header">
              <div>
                <h5 class="modal-title"><i class="bi bi-cash-coin me-1"></i> Registrar abono</h5>
                <small class="text-muted">Factura <%= f.numero_factura %> · <%= f.proveedor_nombre %></small>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="tipo" value="<%= f.tipo %>">
              <div class="alert alert-success py-2">
                Saldo pendiente: <strong>₡<%= parseFloat(f.saldo || 0).toLocaleString('es-CR') %></strong>
                <% if (f.tiene_abono) { %>
                  <br>Abonado actualmente: <strong>₡<%= parseFloat(f.abono_monto || 0).toLocaleString('es-CR') %></strong>
                <% } %>
              </div>
              <div class="mb-3">
                <label class="form-label">Fecha del abono</label>
                <input type="date" name="fecha_abono" class="form-control" value="<%= hoy %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Monto del abono</label>
                <input type="number" step="0.01" min="0.01" max="<%= f.saldo || 0 %>" name="monto_abono" class="form-control" required>
                <small class="text-muted">Si el abono cubre todo el saldo, la factura queda pagada.</small>
              </div>
              <div class="mb-3">
                <label class="form-label">Observación</label>
                <textarea name="observacion_abono" class="form-control" rows="3" placeholder="Ej: transferencia parcial, pago programado, abono de caja..."><%= f.abono_observacion || '' %></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button class="btn btn-success">Guardar abono</button>
            </div>
          </form>
        </div>
      </div>
      </div>
    <% } %>
  <% }) %>
<% } %>

<!-- Modal para recepción de factura ligada a orden de compra -->
<% if (puedeRecibirFacturas) { %>
  <div class="modal fade" id="agregarFacturaModal" tabindex="-1" aria-labelledby="agregarFacturaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg receipt-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="agregarFacturaModalLabel"><i class="bi bi-box-seam me-1"></i> Recepción de factura</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/compras/facturas/agregar" id="recepcionFacturaForm">
        <div class="modal-body">
          <div class="alert alert-info receipt-help">
            Seleccione la orden de compra y registre la factura recibida.
          </div>

          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Orden de compra</label>
              <input type="text" class="form-control provider-search mb-1" data-provider-target="ordenFacturaSelect" placeholder="Buscar por proveedor o PO, ej: L">
              <select name="orden_id" id="ordenFacturaSelect" class="form-select">
                <option value=""><%= modoMensajero ? 'Seleccione una orden de compra' : 'Sin orden de compra / factura independiente' %></option>
                <% ordenesDisponibles.forEach(o => { %>
                  <option value="<%= o.id %>" data-provider-name="<%= o.proveedor_nombre %>" data-search-extra="<%= o.po_numero %>">
                    <%= o.po_numero %> · <%= o.proveedor_nombre %> · ₡<%= parseFloat(o.total || 0).toLocaleString('es-CR') %> · <%= o.estado.replace('_', ' ') %>
                  </option>
                <% }) %>
              </select>
              <small class="text-muted">Solo aparecen órdenes que aún no están facturadas.</small>
            </div>
            <div class="col-md-4">
              <label class="form-label">PO manual</label>
              <input type="text" name="po_numero" class="form-control" placeholder="Ej: 2026-381">
              <small class="text-muted">Úselo solo si no encuentra la orden arriba.</small>
            </div>
          </div>

          <hr>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Número de factura</label>
              <input type="text" name="factura" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Fecha de factura</label>
              <input type="date" name="fecha_factura" class="form-control" value="<%= hoy %>" required>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <% if (!modoMensajero) { %>
              <div class="col-md-4">
                <label class="form-label">Proveedor independiente</label>
                <input type="text" class="form-control provider-search mb-1" data-provider-target="proveedorIndependienteSelect" placeholder="Buscar por letra, ej: L">
                <select name="proveedor_id" id="proveedorIndependienteSelect" class="form-select">
                  <option value="">Solo si no hay PO</option>
                  <% proveedores.forEach(p => { %>
                    <option value="<%= p.id %>" data-provider-name="<%= p.nombre %>"><%= p.nombre %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Monto independiente</label>
                <input type="number" step="0.01" name="monto" class="form-control" placeholder="0.00">
                <small class="text-muted">En PO se usa el total de la orden.</small>
              </div>
            <% } %>
          </div>

          <div class="mt-3 camera-box">
            <label class="form-label">Foto del producto</label>
            <input type="file" id="fotoProductoInput" class="form-control" accept="image/*" capture="environment">
            <input type="hidden" name="foto_producto_data" id="fotoProductoData">
            <small class="text-muted">Opcional. Se guarda como evidencia de lo recibido.</small>
            <div id="fotoProductoPreview" class="mt-2"></div>
          </div>

          <div class="mt-3">
            <label class="form-label">Observación de recepción</label>
            <textarea name="observacion_recepcion" rows="3" class="form-control" placeholder="Ej: foto de respaldo, pendiente revisar cantidad..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar recepción</button>
        </div>
      </form>
    </div>
  </div>
  </div>
<% } %>

<script>
  function normalizarBusqueda(value) {
    return String(value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  document.querySelectorAll('.provider-search').forEach(input => {
    input.addEventListener('input', () => {
      const target = document.getElementById(input.dataset.providerTarget);
      if (!target) return;

      const term = normalizarBusqueda(input.value);
      let selectedVisible = true;

      Array.from(target.options).forEach(option => {
        if (!option.value) {
          option.hidden = false;
          return;
        }

        const name = normalizarBusqueda(option.dataset.providerName || option.textContent);
        const extra = normalizarBusqueda(option.dataset.searchExtra || '');
        const visible = !term || name.startsWith(term) || extra.includes(term);
        option.hidden = !visible;

        if (option.selected && !visible) {
          selectedVisible = false;
        }
      });

      if (!selectedVisible) {
        target.value = '';
      }
    });
  });

  const fotoProductoInput = document.getElementById('fotoProductoInput');
  const fotoProductoData = document.getElementById('fotoProductoData');
  const fotoProductoPreview = document.getElementById('fotoProductoPreview');

  function comprimirFoto(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = () => reject(new Error('No se pudo leer la foto.'));
      reader.onload = () => {
        const img = new Image();
        img.onerror = () => reject(new Error('No se pudo procesar la foto.'));
        img.onload = () => {
          const maxSize = 1280;
          let { width, height } = img;

          if (width > height && width > maxSize) {
            height = Math.round((height * maxSize) / width);
            width = maxSize;
          } else if (height > maxSize) {
            width = Math.round((width * maxSize) / height);
            height = maxSize;
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL('image/jpeg', 0.78));
        };
        img.src = reader.result;
      };
      reader.readAsDataURL(file);
    });
  }

  if (fotoProductoInput && fotoProductoData) {
    fotoProductoInput.addEventListener('change', async () => {
      const file = fotoProductoInput.files && fotoProductoInput.files[0];
      fotoProductoData.value = '';
      if (fotoProductoPreview) fotoProductoPreview.innerHTML = '';
      if (!file) return;

      try {
        const dataUrl = await comprimirFoto(file);
        fotoProductoData.value = dataUrl;
        if (fotoProductoPreview) {
          fotoProductoPreview.innerHTML = `
            <div class="photo-preview-card">
              <img src="${dataUrl}" alt="Vista previa">
              <div class="small text-muted mt-1">Foto lista para guardar</div>
            </div>`;
        }
      } catch (error) {
        alert(error.message || 'No se pudo preparar la foto.');
        fotoProductoInput.value = '';
      }
    });
  }

  const checkboxes = document.querySelectorAll('.check-factura');
  const btnPagar = document.getElementById('btnPagarSeleccionadas');
  const totalSpan = document.getElementById('totalSeleccionado');
  const selectTodos = document.getElementById('seleccionarTodos');

  function actualizarTotal() {
    if (!btnPagar || !totalSpan) return;
    let total = 0;
    let seleccionadas = 0;
    checkboxes.forEach(cb => {
      if (cb.checked) {
        seleccionadas += 1;
        total += parseFloat(cb.dataset.monto || 0);
      }
    });
    totalSpan.innerText = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    btnPagar.disabled = (seleccionadas === 0);
  }

  function marcarTodos() {
    const checked = selectTodos.checked;
    checkboxes.forEach(cb => {
      cb.checked = checked;
    });
    actualizarTotal();
  }

  if (selectTodos) {
    selectTodos.addEventListener('change', marcarTodos);
  }
  checkboxes.forEach(cb => {
    cb.addEventListener('change', actualizarTotal);
  });
  actualizarTotal();
</script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
