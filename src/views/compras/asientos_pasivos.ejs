<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Asientos de pasivos | Tomza Taller</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #eef2f7; color: #17243a; font-family: 'Segoe UI', Roboto, sans-serif; }
    .shell { max-width: 1500px; }
    .topbar { background: #123872; color: white; }
    .panel { background: white; border: 1px solid #d9e2ef; border-radius: 8px; overflow: hidden; }
    .table-wrap { max-height: 62vh; overflow: auto; border: 1px solid #e2e8f0; border-radius: 8px; margin: 1rem; }
    .table-facturas { font-size: .9rem; min-width: 1220px; }
    .table-facturas th { background: #f8fafc; color: #334155; font-size: .72rem; letter-spacing: .02em; position: sticky; text-transform: uppercase; top: 0; z-index: 1; }
    .table-facturas td { vertical-align: middle; }
    .invoice-included { background: #f4f7fb; color: #657387; }
    .code { font-weight: 700; white-space: nowrap; }
    .amount { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .selection-bar { background: #eaf2ff; border-top: 1px solid #cfdef4; }
    .badge-negocio { border-radius: 999px; display: inline-flex; font-size: .68rem; font-weight: 800; padding: .28rem .55rem; text-transform: uppercase; }
    .badge-negocio.cilindrero { background: #dbeafe; color: #1e40af; }
    .badge-negocio.transportadora { background: #ede9fe; color: #6d28d9; }
    .badge-negocio.granel { background: #dcfce7; color: #166534; }
    .badge-negocio.otros { background: #f1f5f9; color: #475569; }
    .badge-electronica { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }
    .badge-electronica-ok { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .badge-pagada { background: #198754; }
    .badge-pendiente { background: #fff3cd; color: #78350f; }
    @media (max-width: 700px) { .table-wrap { max-height: 58vh; } }
  </style>
</head>
<body>
  <header class="topbar py-3">
    <div class="container-fluid shell d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div><div class="small opacity-75">FACTURAS</div><h1 class="h4 mb-0">Asientos de pasivos</h1></div>
      <a href="/compras/facturas" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Facturas</a>
    </div>
  </header>
  <main class="container-fluid shell py-3">
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (!plantillaDisponible) { %><div class="alert alert-warning">La plantilla contable no está configurada en este servidor. El Excel se generará con las columnas de la hoja 01, pero las cuentas y contrapartidas automáticas quedarán vacías.</div><% } %>
    <% if (descargarCreado) { %>
      <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span>Asiento #<%= descargarCreado %> guardado. La descarga se iniciará ahora.</span>
        <a class="btn btn-primary btn-sm" id="descargar-creado" href="/compras/facturas/asientos/<%= descargarCreado %>/excel"><i class="bi bi-download"></i> Descargar Excel</a>
      </div>
    <% } %>

    <section class="panel mb-3">
      <div class="p-3 border-bottom d-flex justify-content-between flex-wrap gap-2 align-items-center">
        <div><h2 class="h6 fw-bold mb-1">Seleccionar facturas</h2><div class="small text-muted"><%= facturas.length %> factura(s) con los filtros actuales. Las ya incluidas permanecen visibles en el historial.</div></div>
      </div>
      <form method="GET" action="/compras/facturas/asientos" class="row g-2 p-3 border-bottom align-items-end">
        <div class="col-lg-3 col-md-6"><label class="form-label small fw-semibold">Buscar</label><input name="q" class="form-control form-control-sm" value="<%= filtros.q %>" placeholder="Factura, proveedor, PO o placa"></div>
        <div class="col-lg-2 col-md-6"><label class="form-label small fw-semibold">Proveedor</label><select name="proveedor_id" class="form-select form-select-sm"><option value="">Todos</option><% proveedores.forEach(p => { %><option value="<%= p.id %>" <%= String(filtros.proveedor_id) === String(p.id) ? 'selected' : '' %>><%= p.nombre %></option><% }) %></select></div>
        <div class="col-lg-2 col-md-4"><label class="form-label small fw-semibold">Desde</label><input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde %>"></div>
        <div class="col-lg-2 col-md-4"><label class="form-label small fw-semibold">Hasta</label><input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta %>"></div>
        <div class="col-lg-2 col-md-4"><label class="form-label small fw-semibold">Estado</label><select name="estado" class="form-select form-select-sm"><option value="todos" <%= filtros.estado === 'todos' ? 'selected' : '' %>>Todas</option><option value="pendiente" <%= filtros.estado === 'pendiente' ? 'selected' : '' %>>Sin asiento</option><option value="incluida" <%= filtros.estado === 'incluida' ? 'selected' : '' %>>Ya incluidas</option></select></div>
        <div class="col-lg-1 col-md-12 d-grid"><button class="btn btn-primary btn-sm">Filtrar</button></div>
      </form>
      <form method="POST" action="/compras/facturas/asientos" id="crear-asiento">
        <div class="table-wrap">
          <table class="table table-hover align-middle table-facturas mb-0">
            <thead><tr><th class="ps-2"><input type="checkbox" id="seleccionar-todas" title="Seleccionar facturas disponibles" aria-label="Seleccionar facturas disponibles"></th><th>PO Número</th><th>Proveedor</th><th>Fecha</th><th>Recepción</th><th>N° Factura</th><th>Factura electrónica</th><th class="text-end">Monto</th><th>Fecha Vencimiento</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
              <% if (!facturas.length) { %><tr><td colspan="11" class="text-center text-muted py-4">No hay facturas con esos filtros.</td></tr><% } %>
              <% facturas.forEach(f => { const monto = montoAsientoFactura(f); const enColones = ['CRC', 'COLONES', 'COLON', '₡'].includes(String(f.moneda || 'CRC').trim().toUpperCase()); const disponible = !f.lote_asiento_id && monto > 0 && enColones; const negocio = String(f.negocio_recepcion || '').toLowerCase(); const claseNegocio = negocio.includes('cilindrero') ? 'cilindrero' : negocio.includes('transportadora') ? 'transportadora' : negocio.includes('granel') ? 'granel' : 'otros'; %>
                <tr class="<%= f.lote_asiento_id ? 'invoice-included' : '' %>">
                  <td class="ps-2"><input type="checkbox" class="factura-check" name="factura_ref" value="<%= f.tipo %>:<%= f.id %>" data-monto="<%= monto %>" aria-label="Seleccionar factura <%= f.numero_factura || f.po_numero || f.id %>" <%= disponible ? '' : 'disabled' %>></td>
                  <td><%= f.po_numero || '—' %></td>
                  <td><%= f.proveedor_nombre || '—' %></td>
                  <td class="text-nowrap"><%= f.fecha ? new Date(f.fecha).toLocaleDateString('es-CR', { timeZone: 'UTC' }) : '—' %></td>
                  <td class="small">
                    <span class="badge-negocio <%= claseNegocio %>"><%= f.negocio_recepcion || 'Por clasificar' %></span>
                    <% if (f.placa_recepcion || f.sede_recepcion) { %><div class="text-muted mt-1"><%= f.placa_recepcion || 'Sin placa' %><% if (f.sede_recepcion) { %> · <%= f.sede_recepcion %><% } %></div><% } %>
                    <% if (f.factura_foto_producto) { %><div class="mt-1"><a href="<%= f.factura_foto_producto %>" target="_blank" rel="noopener noreferrer">Ver foto</a></div><% } %>
                    <% if (f.factura_observacion) { %><div class="text-muted mt-1"><%= f.factura_observacion %></div><% } %>
                    <% if (!f.factura_foto_producto && !f.factura_observacion) { %><div class="text-muted mt-1">Sin evidencia</div><% } %>
                  </td>
                  <td class="code"><%= f.numero_factura || '—' %></td>
                  <td><% if (f.clave_electronica || f.consecutivo_electronico) { %>
                    <span class="badge <%= f.estado_hacienda === 'ACEPTADA' ? 'badge-electronica-ok' : 'badge-electronica' %>"><%= f.estado_hacienda || 'PENDIENTE' %></span>
                    <div class="small fw-semibold mt-1"><%= f.consecutivo_electronico || '—' %></div>
                    <div class="small text-muted text-truncate" style="max-width: 180px" title="<%= f.clave_electronica || '' %>"><%= f.clave_electronica || '—' %></div>
                  <% } else { %><span class="badge badge-electronica">Sin cruce</span><% } %></td>
                  <td class="text-end amount fw-bold"><%= enColones ? '₡' : String(f.moneda).toUpperCase() + ' ' %><%= monto.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %><% if (Number(f.nota_credito_monto || 0) > 0) { %><div class="small fw-normal text-muted">NC aplicada</div><% } %></td>
                  <td class="text-nowrap"><%= f.fecha_vencimiento_factura ? new Date(f.fecha_vencimiento_factura).toLocaleDateString('es-CR', { timeZone: 'UTC' }) : '—' %><% if (f.vencida) { %><div><span class="badge text-bg-danger">Vencida</span></div><% } %></td>
                  <td><% if (f.cubierta_por_nc) { %><span class="badge badge-electronica">Cubierta por NC</span><% } else if (f.pagada) { %><span class="badge badge-pagada">Pagada</span><% } else { %><span class="badge badge-pendiente">Pendiente</span><% } %></td>
                  <td class="text-nowrap"><% if (f.lote_asiento_id) { %><a href="/compras/facturas/asientos/<%= f.lote_asiento_id %>" class="btn btn-outline-secondary btn-sm">Asiento #<%= f.lote_asiento_id %></a><% } else if (monto <= 0) { %><span class="badge text-bg-warning">Sin monto neto</span><% } else if (!enColones) { %><span class="badge text-bg-warning">Requiere conversión</span><% } else { %><span class="badge text-bg-success">Sin asiento</span><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="selection-bar p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="fw-semibold"><span id="cantidad-seleccionada">0</span> seleccionada(s) · ₡<span id="monto-seleccionado">0,00</span></div>
          <button class="btn btn-primary" id="generar-asiento" disabled><i class="bi bi-file-earmark-excel"></i> Guardar y descargar asiento 01</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2"><h2 class="h6 fw-bold mb-0">Historial de asientos</h2><span class="small text-muted"><%= totalHistorial %> asiento(s)</span></div>
      <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
          <thead class="table-light"><tr><th class="ps-3">Asiento</th><th>Generado</th><th>Usuario</th><th>Facturas</th><th class="text-end">Monto</th><th>Archivo</th></tr></thead>
          <tbody>
            <% if (!historial.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Todavía no se han generado asientos desde este nodo.</td></tr><% } %>
            <% historial.forEach(lote => { %><tr>
              <td class="ps-3"><a class="fw-bold" href="/compras/facturas/asientos/<%= lote.id %>">#<%= lote.id %></a></td>
              <td class="text-nowrap"><%= new Date(lote.creado_en).toLocaleString('es-CR') %></td>
              <td><%= lote.creado_por_usuario || '-' %></td>
              <td><%= lote.cantidad_facturas %></td>
              <td class="text-end amount">₡<%= Number(lote.monto_total).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              <td><a class="btn btn-outline-primary btn-sm" href="/compras/facturas/asientos/<%= lote.id %>/excel"><i class="bi bi-download"></i> Excel</a></td>
            </tr><% }) %>
          </tbody>
        </table>
      </div>
      <% if (totalPaginas > 1) { %><div class="p-3 border-top d-flex justify-content-between align-items-center">
        <% const pageParams = new URLSearchParams(filtros); %>
        <% pageParams.set('pagina_historial', Math.max(paginaHistorial - 1, 1)); %><a class="btn btn-outline-secondary btn-sm <%= paginaHistorial === 1 ? 'disabled' : '' %>" href="/compras/facturas/asientos?<%= pageParams %>">Anterior</a>
        <span class="small">Página <%= paginaHistorial %> de <%= totalPaginas %></span>
        <% pageParams.set('pagina_historial', Math.min(paginaHistorial + 1, totalPaginas)); %><a class="btn btn-outline-secondary btn-sm <%= paginaHistorial === totalPaginas ? 'disabled' : '' %>" href="/compras/facturas/asientos?<%= pageParams %>">Siguiente</a>
      </div><% } %>
    </section>
  </main>
  <script>
    const checks = Array.from(document.querySelectorAll('.factura-check:not(:disabled)'));
    const all = document.getElementById('seleccionar-todas');
    const selectedCount = document.getElementById('cantidad-seleccionada');
    const selectedAmount = document.getElementById('monto-seleccionado');
    const submit = document.getElementById('generar-asiento');
    function updateSelection() {
      const selected = checks.filter(check => check.checked);
      selectedCount.textContent = selected.length;
      selectedAmount.textContent = selected.reduce((sum, check) => sum + Number(check.dataset.monto || 0), 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      submit.disabled = selected.length === 0 || selected.length > 1000;
      all.checked = checks.length > 0 && selected.length === checks.length;
      all.indeterminate = selected.length > 0 && selected.length < checks.length;
    }
    all.addEventListener('change', () => { checks.forEach(check => { check.checked = all.checked; }); updateSelection(); });
    checks.forEach(check => check.addEventListener('change', updateSelection));
    document.getElementById('crear-asiento').addEventListener('submit', event => {
      if (!checks.some(check => check.checked) || !confirm('¿Guardar este asiento con las facturas seleccionadas?')) event.preventDefault();
      else submit.disabled = true;
    });
    <% if (descargarCreado) { %>
    window.addEventListener('load', () => document.getElementById('descargar-creado').click(), { once: true });
    <% } %>
  </script>
</body>
</html>
