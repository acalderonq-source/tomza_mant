<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard de Facturas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    body {
      background: linear-gradient(135deg, #f5f7fc 0%, #eef2f6 100%);
      color: #0f172a;
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      padding-bottom: 2rem;
    }
    .navbar { box-shadow: 0 4px 14px rgba(0,0,0,.15); }
    .page-title { font-size: 1.55rem; font-weight: 900; margin: 0; }
    .page-subtitle { color: #64748b; margin: .2rem 0 0; }
    .filtros-card,
    .stat-card,
    .chart-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 14px;
      box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
    }
    .filtros-card { padding: 1rem; }
    .stat-grid {
      display: grid;
      gap: .85rem;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    }
    .stat-card { padding: 1rem; }
    .stat-label {
      color: #64748b;
      font-size: .74rem;
      font-weight: 900;
      text-transform: uppercase;
    }
    .stat-value {
      font-size: 1.45rem;
      font-weight: 900;
      line-height: 1.15;
      margin-top: .25rem;
      word-break: break-word;
    }
    .stat-foot { color: #64748b; font-size: .82rem; margin-top: .2rem; }
    .chart-card { overflow: hidden; }
    .finance-hero {
      background: linear-gradient(135deg, #0b1f4d 0%, #123f91 58%, #e2262a 100%);
      border-radius: 18px;
      box-shadow: 0 16px 35px rgba(15, 23, 42, .18);
      color: #fff;
      overflow: hidden;
      padding: 1.1rem;
      position: relative;
    }
    .finance-hero::after {
      background: linear-gradient(135deg, rgba(255, 214, 10, .95), rgba(255, 214, 10, .2));
      content: "";
      height: 180px;
      position: absolute;
      right: 145px;
      top: -60px;
      transform: skewX(-22deg);
      width: 80px;
    }
    .finance-hero > * { position: relative; z-index: 1; }
    .finance-label {
      color: rgba(255,255,255,.72);
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .03em;
      text-transform: uppercase;
    }
    .finance-total {
      font-size: clamp(1.8rem, 4vw, 3.2rem);
      font-weight: 950;
      line-height: 1;
      margin-top: .35rem;
    }
    .finance-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 1rem;
    }
    .finance-pill {
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 14px;
      padding: .85rem;
    }
    .finance-pill strong {
      display: block;
      font-size: 1.15rem;
      font-weight: 950;
      margin-top: .2rem;
      word-break: break-word;
    }
    .closing-card {
      background: #ffffff;
      border: 1px solid #bfdbfe;
      border-radius: 16px;
      box-shadow: 0 12px 26px rgba(15, 23, 42, .07);
      overflow: hidden;
    }
    .closing-head {
      background: linear-gradient(135deg, #0b3b82, #174ea6);
      color: #ffffff;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 1rem 1.15rem;
    }
    .closing-title {
      font-size: 1.15rem;
      font-weight: 950;
      margin: 0;
      text-transform: uppercase;
    }
    .closing-total {
      font-size: clamp(1.65rem, 4vw, 2.8rem);
      font-weight: 950;
      line-height: 1;
    }
    .closing-status {
      border-radius: 999px;
      display: inline-flex;
      font-size: .75rem;
      font-weight: 900;
      padding: .35rem .7rem;
    }
    .closing-status.ok { background: #dcfce7; color: #14532d; }
    .closing-status.diff { background: #fee2e2; color: #991b1b; }
    .closing-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr);
      padding: 1rem;
    }
    .closing-table-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      max-height: 360px;
      overflow: auto;
    }
    .debt-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
      overflow: hidden;
    }
    .debt-head {
      align-items: center;
      background: linear-gradient(135deg, #111827, #1d4ed8);
      color: #fff;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 1rem 1.15rem;
    }
    .debt-title {
      font-size: 1.08rem;
      font-weight: 900;
      margin: 0;
    }
    .debt-subtitle {
      color: rgba(255,255,255,.76);
      font-size: .86rem;
      margin: .2rem 0 0;
    }
    .debt-table-wrap {
      max-height: 430px;
      overflow: auto;
    }
    .debt-table-wrap thead th {
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .chart-head {
      border-bottom: 1px solid #e2e8f0;
      font-weight: 900;
      padding: 1rem 1.15rem;
    }
    .chart-body { padding: 1rem; }
    canvas { max-height: 320px; width: 100% !important; }
    .table thead th {
      background: #f8fafc;
      color: #475569;
      font-size: .75rem;
      font-weight: 900;
      text-transform: uppercase;
    }
    .empty-msg {
      color: #64748b;
      font-weight: 700;
      padding: 2rem;
      text-align: center;
    }
    @media (max-width: 980px) {
      .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .finance-grid { grid-template-columns: 1fr; }
      .closing-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .stat-grid { grid-template-columns: 1fr; }
      .debt-head { align-items: stretch; flex-direction: column; }
      .navbar .text-white {
        align-items: flex-start !important;
        flex-direction: column;
        gap: .5rem !important;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>
<%
  const safeUser = user || {};
  const safeResumen = resumen || {};
  const safeProveedores = Array.isArray(proveedores) ? proveedores : [];
  const safePorProveedor = Array.isArray(porProveedor) ? porProveedor : [];
  const safePorMes = Array.isArray(porMes) ? porMes : [];
  const safePorEstado = Array.isArray(porEstado) ? porEstado : [];
  const safeRecientes = Array.isArray(facturasRecientes) ? facturasRecientes : [];
  const safeDeudaPorProveedor = Array.isArray(deudaPorProveedor) ? deudaPorProveedor : [];
  const safeResumenDeuda = resumenDeuda || {};
  const safeFinanciero = financiero || {};
  const safeFinResumen = safeFinanciero.resumen || {};
  const safeFinPorTipo = Array.isArray(safeFinanciero.porTipo) ? safeFinanciero.porTipo : [];
  const safeFinPorMes = Array.isArray(safeFinanciero.porMes) ? safeFinanciero.porMes : [];
  const safeCierre = cierrePagos || {};
  const safeCierreProveedores = Array.isArray(safeCierre.proveedores) ? safeCierre.proveedores : [];
  const safeCierreDetalles = Array.isArray(safeCierre.detalles) ? safeCierre.detalles : [];
  const filtrosActuales = filtros || {};
  const money = (value) => Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 });
  const money2 = (value) => Number(value || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fecha = value => {
    if (!value) return '—';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('es-CR');
  };
  const pdfDeudaUrl = '/compras/facturas/reporte/pdf?pagada=0&orden=asc';
  const listaDeudaUrl = '/compras/facturas?pagada=0&orden=asc';
  const cierreUrlParams = new URLSearchParams();
  if (safeCierre.periodo) cierreUrlParams.set('periodo_cierre', safeCierre.periodo);
  const cierreExcelUrl = '/compras/facturas/pagos-proveedor/reporte/excel' + (cierreUrlParams.toString() ? `?${cierreUrlParams.toString()}` : '');
  const cierreDetalleUrl = '/compras/facturas/pagos-proveedor' + (cierreUrlParams.toString() ? `?${cierreUrlParams.toString()}` : '');
%>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-receipt-cutoff me-2"></i>Dashboard de Facturas</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= safeUser.usuario || 'Usuario' %> · <%= safeUser.rol || 'Sin rol' %></span>
    <a href="/compras/facturas" class="btn btn-sm btn-outline-light rounded-pill px-3">Facturas</a>
    <a href="/compras/ordenes" class="btn btn-sm btn-outline-light rounded-pill px-3">Órdenes</a>
  </div>
</nav>

<main class="container-fluid py-4" style="max-width: 1220px;">
  <section class="mb-3">
    <h1 class="page-title">Facturas de compras</h1>
    <p class="page-subtitle">Vista ejecutiva de facturas pagadas, pendientes, vencidas, abonos y notas de crédito.</p>
  </section>

  <section class="filtros-card mb-3">
    <form method="GET" action="/compras/facturas/dashboard" class="row g-2">
      <div class="col-md-3">
        <label class="form-label small fw-bold">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% safeProveedores.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtrosActuales.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Estado pago</label>
        <select name="pagada" class="form-select form-select-sm">
          <option value="">Todos</option>
          <option value="1" <%= filtrosActuales.pagada == '1' ? 'selected' : '' %>>Pagadas</option>
          <option value="0" <%= filtrosActuales.pagada == '0' ? 'selected' : '' %>>Pendientes</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Periodo cierre</label>
        <input type="month" name="periodo_cierre" class="form-control form-control-sm" value="<%= filtrosActuales.periodo_cierre || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Vencidas</label>
        <select name="vencida" class="form-select form-select-sm">
          <option value="">Todas</option>
          <option value="1" <%= filtrosActuales.vencida == '1' ? 'selected' : '' %>>Solo vencidas</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button class="btn btn-dark btn-sm w-100">Filtrar</button>
      </div>
    </form>
  </section>

  <% if (safeCierre.periodo) { %>
    <section class="closing-card mb-3">
      <div class="closing-head flex-wrap">
        <div>
          <div class="finance-label">Cierre de pagos</div>
          <h2 class="closing-title mb-1"><%= safeCierre.titulo %></h2>
          <div class="small opacity-75">Calculado desde facturas pagadas con periodo de cierre <%= safeCierre.periodo %>.</div>
          <div class="d-flex gap-2 flex-wrap mt-3">
            <a href="<%= cierreExcelUrl %>" class="btn btn-light btn-sm rounded-pill px-3">
              <i class="bi bi-file-earmark-excel"></i> Descargar Excel del cierre
            </a>
            <a href="<%= cierreDetalleUrl %>" class="btn btn-outline-light btn-sm rounded-pill px-3">
              Ver pagos del cierre
            </a>
          </div>
        </div>
        <div class="text-end">
          <div class="finance-label">Total general</div>
          <div class="closing-total">₡<%= money2(safeCierre.totalGeneral) %></div>
          <% if (safeCierre.totalOficial !== null && safeCierre.totalOficial !== undefined) { %>
            <% const diferenciaCierre = Number(safeCierre.diferencia || 0); %>
            <div class="mt-2">
              <span class="closing-status <%= Math.abs(diferenciaCierre) < 0.01 ? 'ok' : 'diff' %>">
                <%= Math.abs(diferenciaCierre) < 0.01 ? 'Cuadra con Emily' : `Diferencia: ₡${money2(diferenciaCierre)}` %>
              </span>
            </div>
            <div class="small opacity-75 mt-1">Oficial Emily: ₡<%= money2(safeCierre.totalOficial) %></div>
          <% } %>
        </div>
      </div>
      <div class="closing-grid">
        <div>
          <h3 class="fs-6 fw-black mb-2">Por proveedor</h3>
          <div class="closing-table-wrap">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Proveedor</th>
                  <th class="text-center">Mov.</th>
                  <th class="text-end">Pagado</th>
                </tr>
              </thead>
              <tbody>
                <% if (!safeCierreProveedores.length) { %>
                  <tr><td colspan="3" class="text-center text-muted py-4">No hay pagos en este cierre.</td></tr>
                <% } %>
                <% safeCierreProveedores.forEach(item => { %>
                  <tr>
                    <td class="fw-bold"><%= item.proveedor %></td>
                    <td class="text-center"><%= item.movimientos %></td>
                    <td class="text-end fw-bold">₡<%= money2(item.total) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <h3 class="fs-6 fw-black mb-2">Detalle para revisar diferencias</h3>
          <div class="closing-table-wrap">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Proveedor</th>
                  <th>Factura</th>
                  <th>Fecha factura</th>
                  <th>Fecha pago</th>
                  <th class="text-end">Original</th>
                  <th class="text-end">Pagado</th>
                </tr>
              </thead>
              <tbody>
                <% if (!safeCierreDetalles.length) { %>
                  <tr><td colspan="6" class="text-center text-muted py-4">Seleccione un periodo con pagos registrados.</td></tr>
                <% } %>
                <% safeCierreDetalles.forEach(item => { %>
                  <tr>
                    <td><strong><%= item.proveedor_nombre || 'Sin proveedor' %></strong><div class="small text-muted"><%= item.concepto || '—' %></div></td>
                    <td><%= item.numero_factura || '—' %></td>
                    <td><%= fecha(item.fecha_factura) %></td>
                    <td><%= fecha(item.fecha_pago || item.fecha_solicitud) %></td>
                    <td class="text-end">₡<%= money2(item.monto_original) %></td>
                    <td class="text-end fw-bold">₡<%= money2(item.monto_pagado) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <section class="finance-hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <div class="finance-label">Dashboard financiero de facturas</div>
        <div class="finance-total">₡<%= money(safeFinResumen.totalGeneral) %></div>
        <div class="small mt-2" style="color: rgba(255,255,255,.78);">
          Suma de órdenes de compra, órdenes motor, pagos de proveedor, caja chica y reintegros de gastos
          <% if (filtrosActuales.fecha_desde || filtrosActuales.fecha_hasta) { %>
            · Rango filtrado
          <% } else { %>
            · Histórico completo
          <% } %>
        </div>
      </div>
      <div class="text-end">
        <div class="finance-label">Movimientos</div>
        <div class="fs-2 fw-black"><%= safeFinResumen.registros || 0 %></div>
      </div>
    </div>
    <div class="finance-grid">
      <div class="finance-pill">
        <div class="finance-label">Total pagado</div>
        <strong>₡<%= money(safeFinResumen.totalPagado) %></strong>
      </div>
      <div class="finance-pill">
        <div class="finance-label">Órdenes de compra</div>
        <strong>₡<%= money(safeFinResumen.totalOrdenes) %></strong>
      </div>
      <div class="finance-pill">
        <div class="finance-label">Órdenes motor</div>
        <strong>₡<%= money(safeFinResumen.totalOrdenesMotor) %></strong>
      </div>
      <div class="finance-pill">
        <div class="finance-label">Pago proveedor</div>
        <strong>₡<%= money(safeFinResumen.totalPagosProveedor) %></strong>
      </div>
      <div class="finance-pill">
        <div class="finance-label">Caja chica</div>
        <strong>₡<%= money(safeFinResumen.totalCajaChica) %></strong>
      </div>
      <div class="finance-pill">
        <div class="finance-label">Reintegro gastos</div>
        <strong>₡<%= money(safeFinResumen.totalReintegrosGastos) %></strong>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-3">
    <div class="col-lg-5">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-bar-chart-fill me-1"></i> Montos por tipo</div>
        <div class="chart-body">
          <% if (safeFinPorTipo.some(item => Number(item.total || 0) > 0)) { %>
            <canvas id="chartFinTipo"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay movimientos financieros todavía.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-graph-up-arrow me-1"></i> Montos por mes</div>
        <div class="chart-body">
          <% if (safeFinPorMes.length) { %>
            <canvas id="chartFinMes"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos mensuales financieros.</div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="stat-grid mb-3">
    <div class="stat-card">
      <div class="stat-label">Facturas</div>
      <div class="stat-value"><%= safeResumen.totalFacturas || 0 %></div>
      <div class="stat-foot"><%= safeResumen.pagadas || 0 %> pagadas · <%= safeResumen.pendientes || 0 %> pendientes</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Monto original</div>
      <div class="stat-value">₡<%= money(safeResumen.montoOriginal) %></div>
      <div class="stat-foot">Antes de NC y abonos</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Saldo pendiente</div>
      <div class="stat-value">₡<%= money(safeResumen.saldo) %></div>
      <div class="stat-foot"><%= safeResumen.vencidas || 0 %> vencidas</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Notas de crédito</div>
      <div class="stat-value">₡<%= money(safeResumen.notasCredito) %></div>
      <div class="stat-foot"><%= safeResumen.conNotaCredito || 0 %> facturas con NC</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Abonos</div>
      <div class="stat-value">₡<%= money(safeResumen.abonos) %></div>
      <div class="stat-foot"><%= safeResumen.conAbono || 0 %> facturas abonadas</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Pagado real</div>
      <div class="stat-value">₡<%= money(safeResumen.pagado) %></div>
      <div class="stat-foot">Usa abono real cuando existe</div>
    </div>
  </section>

  <section class="debt-card mb-3">
    <div class="debt-head">
      <div>
        <h2 class="debt-title"><i class="bi bi-cash-coin me-1"></i> Cuentas por pagar de todos los proveedores</h2>
        <p class="debt-subtitle">Muestra toda la deuda pendiente, sin filtros de fecha, agrupada por proveedor y ordenada alfabéticamente.</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="<%= pdfDeudaUrl %>" class="btn btn-light btn-sm rounded-pill px-3">
          <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
        </a>
        <a href="<%= listaDeudaUrl %>" class="btn btn-outline-light btn-sm rounded-pill px-3">
          Ver facturas pendientes
        </a>
      </div>
    </div>
    <div class="debt-table-wrap">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th>Proveedor</th>
            <th class="text-end">Saldo</th>
          </tr>
        </thead>
        <tbody>
          <% if (!safeDeudaPorProveedor.length) { %>
            <tr><td colspan="2" class="text-center text-muted py-4">No hay cuentas pendientes por pagar.</td></tr>
          <% } %>
          <% safeDeudaPorProveedor.forEach(item => { %>
            <tr>
              <td><strong><%= item.proveedor %></strong></td>
              <td class="text-end fw-bold">₡<%= money(item.saldo) %></td>
            </tr>
          <% }) %>
        </tbody>
        <% if (safeDeudaPorProveedor.length) { %>
          <tfoot>
            <tr>
              <th>Total general</th>
              <th class="text-end">₡<%= money(safeResumenDeuda.saldo) %></th>
            </tr>
          </tfoot>
        <% } %>
      </table>
    </div>
  </section>

  <section class="row g-3 mb-3">
    <div class="col-lg-5">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-pie-chart me-1"></i> Estado de facturas</div>
        <div class="chart-body">
          <% if (safePorEstado.length) { %>
            <canvas id="chartEstados"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos de estado.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-calendar3 me-1"></i> Evolución mensual</div>
        <div class="chart-body">
          <% if (safePorMes.length) { %>
            <canvas id="chartMes"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos mensuales.</div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-3">
    <div class="col-lg-7">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-building me-1"></i> Proveedores con mayor saldo</div>
        <div class="chart-body">
          <% if (safePorProveedor.length) { %>
            <canvas id="chartProveedor"></canvas>
          <% } else { %>
            <div class="empty-msg">No hay datos por proveedor.</div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="chart-card h-100">
        <div class="chart-head"><i class="bi bi-table me-1"></i> Top proveedores</div>
        <div class="chart-body p-0">
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Proveedor</th><th class="text-center">Pend.</th><th class="text-end">Saldo</th></tr></thead>
              <tbody>
                <% if (!safePorProveedor.length) { %>
                  <tr><td colspan="3" class="text-center text-muted py-3">Sin datos</td></tr>
                <% } %>
                <% safePorProveedor.slice(0, 10).forEach(item => { %>
                  <tr>
                    <td><strong><%= item.proveedor %></strong><div class="text-muted small"><%= item.facturas %> factura(s)</div></td>
                    <td class="text-center"><%= item.pendientes %></td>
                    <td class="text-end">₡<%= money(item.saldo) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="chart-card">
    <div class="chart-head d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <span><i class="bi bi-clock-history me-1"></i> Facturas recientes</span>
      <a href="/compras/facturas" class="btn btn-sm btn-outline-dark">Ver listado</a>
    </div>
    <div class="chart-body p-0">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Factura</th>
              <th>PO</th>
              <th>Proveedor</th>
              <th>Fecha</th>
              <th class="text-end">Monto</th>
              <th class="text-end">Saldo</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% if (!safeRecientes.length) { %>
              <tr><td colspan="7" class="text-center text-muted py-3">No hay facturas.</td></tr>
            <% } %>
            <% safeRecientes.forEach(f => { %>
              <tr>
                <td><strong><%= f.numero_factura || '-' %></strong></td>
                <td><%= f.po_numero || '-' %></td>
                <td><%= f.proveedor_nombre || '-' %></td>
                <td><%= f.fecha ? new Date(f.fecha).toLocaleDateString('es-CR') : '-' %></td>
                <td class="text-end">₡<%= money(f.monto_original ?? f.monto) %></td>
                <td class="text-end">₡<%= money((f.pagada || f.cubierta_por_nc) ? 0 : (f.saldo ?? f.monto)) %></td>
                <td>
                  <% if (f.pagada || f.cubierta_por_nc) { %>
                    <span class="badge text-bg-success">Pagada</span>
                  <% } else if (f.vencida) { %>
                    <span class="badge text-bg-danger">Vencida</span>
                  <% } else { %>
                    <span class="badge text-bg-warning">Pendiente</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<script type="application/json" id="data-estados"><%- JSON.stringify(safePorEstado) %></script>
<script type="application/json" id="data-mes"><%- JSON.stringify(safePorMes) %></script>
<script type="application/json" id="data-proveedor"><%- JSON.stringify(safePorProveedor) %></script>
<script type="application/json" id="data-fin-tipo"><%- JSON.stringify(safeFinPorTipo) %></script>
<script type="application/json" id="data-fin-mes"><%- JSON.stringify(safeFinPorMes) %></script>
<script>
  const leerJSON = id => {
    try { return JSON.parse(document.getElementById(id)?.textContent || '[]'); }
    catch (_) { return []; }
  };
  const formatCurrency = value => '₡ ' + Number(value || 0).toLocaleString('es-CR');
  const corta = (txt, max) => String(txt || '').length > max ? String(txt).slice(0, max - 3) + '...' : String(txt || '');
  const estados = leerJSON('data-estados');
  const meses = leerJSON('data-mes');
  const proveedoresData = leerJSON('data-proveedor');
  const finTipo = leerJSON('data-fin-tipo');
  const finMes = leerJSON('data-fin-mes');

  if (document.getElementById('chartFinTipo') && finTipo.length) {
    new Chart(document.getElementById('chartFinTipo'), {
      type: 'bar',
      data: {
        labels: finTipo.map(item => item.tipo),
        datasets: [{
          label: 'Monto',
          data: finTipo.map(item => Number(item.total || 0)),
          backgroundColor: finTipo.map(item => item.color || '#1d4ed8'),
          borderRadius: 10,
          maxBarThickness: 58
        }]
      },
      options: {
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } }
        },
        scales: { y: { ticks: { callback: v => formatCurrency(v) } } }
      }
    });
  }

  if (document.getElementById('chartFinMes') && finMes.length) {
    new Chart(document.getElementById('chartFinMes'), {
      type: 'bar',
      data: {
        labels: finMes.map(item => item.mes),
        datasets: [
          { label: 'Órdenes', data: finMes.map(item => Number(item.ordenes || 0)), backgroundColor: '#0f3b82', borderRadius: 7 },
          { label: 'Órdenes motor', data: finMes.map(item => Number(item.ordenesMotor || 0)), backgroundColor: '#ea580c', borderRadius: 7 },
          { label: 'Pago proveedor', data: finMes.map(item => Number(item.pagosProveedor || 0)), backgroundColor: '#0ea5e9', borderRadius: 7 },
          { label: 'Caja chica', data: finMes.map(item => Number(item.cajaChica || 0)), backgroundColor: '#f59e0b', borderRadius: 7 },
          { label: 'Reintegro gastos', data: finMes.map(item => Number(item.reintegrosGastos || 0)), backgroundColor: '#7c3aed', borderRadius: 7 }
        ]
      },
      options: {
        plugins: { tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${formatCurrency(ctx.raw)}` } } },
        scales: {
          x: { stacked: false },
          y: { ticks: { callback: v => formatCurrency(v) } }
        }
      }
    });
  }

  if (document.getElementById('chartEstados') && estados.length) {
    new Chart(document.getElementById('chartEstados'), {
      type: 'doughnut',
      data: {
        labels: estados.map(e => e.estado),
        datasets: [{
          data: estados.map(e => Number(e.cantidad || 0)),
          backgroundColor: ['#198754', '#ffc107', '#dc3545', '#0ea5e9', '#2563eb']
        }]
      },
      options: { plugins: { tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.raw}` } } } }
    });
  }

  if (document.getElementById('chartMes') && meses.length) {
    new Chart(document.getElementById('chartMes'), {
      type: 'line',
      data: {
        labels: meses.map(m => m.mes),
        datasets: [
          { label: 'Monto original', data: meses.map(m => Number(m.montoOriginal || 0)), borderColor: '#111827', backgroundColor: 'rgba(17,24,39,.08)', fill: true, tension: .3 },
          { label: 'Saldo', data: meses.map(m => Number(m.saldo || 0)), borderColor: '#dc2626', backgroundColor: 'rgba(220,38,38,.08)', fill: true, tension: .3 }
        ]
      },
      options: { plugins: { tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${formatCurrency(ctx.raw)}` } } }, scales: { y: { ticks: { callback: v => formatCurrency(v) } } } }
    });
  }

  if (document.getElementById('chartProveedor') && proveedoresData.length) {
    const top = proveedoresData.slice(0, 12);
    new Chart(document.getElementById('chartProveedor'), {
      type: 'bar',
      data: {
        labels: top.map(p => corta(p.proveedor, 28)),
        datasets: [{
          label: 'Saldo pendiente',
          data: top.map(p => Number(p.saldo || 0)),
          backgroundColor: '#1d4ed8',
          borderRadius: 9
        }]
      },
      options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => formatCurrency(ctx.raw) } } }, scales: { x: { ticks: { callback: v => formatCurrency(v) } } } }
    });
  }
</script>
</body>
</html>
