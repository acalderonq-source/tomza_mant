<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Facturas por correo | Tomza Taller</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background:#eef2f7; color:#17243a; font-family:'Segoe UI',Roboto,sans-serif; }
    .shell { max-width:1500px; }
    .topbar { background:#123872; color:white; }
    .panel { background:white; border:1px solid #d9e2ef; border-radius:8px; overflow:hidden; }
    .table-wrap { max-height:68vh; overflow:auto; }
    th { background:#f8fafc !important; color:#46566f !important; font-size:.72rem; position:sticky; text-transform:uppercase; top:0; z-index:1; }
    td { vertical-align:middle; }
    .amount { font-variant-numeric:tabular-nums; white-space:nowrap; }
    .meta { color:#65748a; font-size:.88rem; }
  </style>
</head>
<body>
  <header class="topbar py-3">
    <div class="container-fluid shell d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div><div class="small opacity-75">FACTURAS</div><h1 class="h4 mb-0">Bandeja del correo corporativo</h1></div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/compras/facturas" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Volver a facturas</a>
        <a href="/dashboard" class="btn btn-outline-light btn-sm">Inicio</a>
      </div>
    </div>
  </header>
  <main class="container-fluid shell py-3">
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <% if (!configured) { %>
      <div class="alert alert-warning"><strong>Conexión pendiente de configuración.</strong> Agregue las credenciales de Microsoft Entra y la clave de cifrado en Render para habilitar el botón de conexión.</div>
    <% } %>
    <section class="panel mb-3">
      <div class="p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h2 class="h6 fw-bold mb-1">Conexión Microsoft 365</h2>
          <% if (connection) { %>
            <div class="meta"><i class="bi bi-check-circle-fill text-success me-1"></i> Conectado: <strong><%= connection.correo %></strong></div>
            <div class="meta">Última sincronización: <%= connection.sincronizado_en ? new Date(connection.sincronizado_en).toLocaleString('es-CR') : 'Aún no se sincroniza' %></div>
          <% } else { %>
            <div class="meta">Conecte su cuenta corporativa personal para probar la lectura delegada.</div>
          <% } %>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <% if (connection) { %>
            <form method="post" action="/compras/facturas/correo/sincronizar"><button class="btn btn-primary btn-sm" <%= configured ? '' : 'disabled' %>><i class="bi bi-arrow-repeat"></i> Sincronizar ahora</button></form>
            <form method="post" action="/compras/facturas/correo/desconectar" onsubmit="return confirm('¿Desconectar la cuenta? Los documentos ya descargados se conservarán.');"><button class="btn btn-outline-danger btn-sm">Desconectar</button></form>
          <% } else { %>
            <a class="btn btn-primary btn-sm <%= configured ? '' : 'disabled' %>" href="/compras/facturas/correo/oauth/iniciar"><i class="bi bi-microsoft"></i> Conectar correo corporativo</a>
          <% } %>
        </div>
      </div>
      <div class="px-3 pb-3 meta">Solo lectura de Entrada, últimos 30 días (hasta 500 correos por sincronización). Se descargan adjuntos XML y PDF (máximo 8 MB por archivo, 100 archivos y 50 MB por sincronización). Los documentos quedan pendientes de revisión; no se registran automáticamente en Facturas ni en Asientos.</div>
    </section>

    <section class="panel">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div><h2 class="h6 fw-bold mb-1">Documentos recibidos</h2><div class="meta">Últimos 200 adjuntos guardados de forma privada</div></div>
        <span class="badge text-bg-light"><%= documents.length %> documento(s)</span>
      </div>
      <div class="table-wrap">
        <table class="table table-hover table-sm mb-0 align-middle">
          <thead><tr><th class="ps-3">Recibido</th><th>Emisor / remitente</th><th>Asunto</th><th>Archivo</th><th>Clave / consecutivo</th><th class="text-end">Monto XML</th><th></th></tr></thead>
          <tbody>
            <% if (!documents.length) { %><tr><td colspan="7" class="text-center text-muted py-5">Todavía no hay documentos. Conecte el correo y pulse “Sincronizar ahora”.</td></tr><% } %>
            <% documents.forEach(document => { %>
              <tr>
                <td class="ps-3 text-nowrap"><%= document.recibido_en ? new Date(document.recibido_en).toLocaleString('es-CR') : '—' %></td>
                <td><div><%= document.emisor || document.remitente || '—' %></div><% if (document.emisor && document.remitente) { %><div class="meta"><%= document.remitente %></div><% } %></td>
                <td style="min-width:180px;max-width:320px"><%= document.asunto || '—' %></td>
                <td><span class="badge <%= document.tipo_documento === 'XML' ? 'text-bg-success' : 'text-bg-danger' %> me-1"><%= document.tipo_documento %></span><%= document.nombre_archivo %></td>
                <td class="small"><%= document.clave_electronica || document.consecutivo || '—' %></td>
                <td class="text-end amount"><%= document.monto == null ? '—' : '₡' + Number(document.monto).toLocaleString('es-CR', { minimumFractionDigits:2, maximumFractionDigits:2 }) %></td>
                <td class="text-end pe-3"><a class="btn btn-outline-primary btn-sm" href="/compras/facturas/correo/documento/<%= document.id %>"><i class="bi bi-download"></i> Descargar</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
