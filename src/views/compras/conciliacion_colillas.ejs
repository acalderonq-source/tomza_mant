<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Conciliación de colillas · Gas Tomza</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/taller-empresa.css"><script src="/js/taller-empresa.js" defer></script></head><body class="<%= user.rol === 'CONTABILIDAD' ? '' : 'taller-empresa' %>">
<nav class="navbar px-3"><strong>Gas Tomza · Control financiero</strong><a href="/compras/facturas" class="btn btn-outline-primary btn-sm">Facturas</a></nav>
<main class="container-fluid shell"><h1 class="page-title">Conciliación de colillas</h1><p class="text-muted">Alcance global de Taller, por fecha de pago. Solo colillas de origen actual; no incluye caja chica, órdenes de motor ni pagos históricos sin colilla. No equivale a conciliación bancaria ni al saldo pendiente de facturas.</p>
<form class="d-flex flex-wrap gap-2 align-items-end mb-3" method="get"><label>Mes<input class="form-control" type="month" name="periodo" value="<%= periodo %>" required></label><button class="btn btn-primary">Consultar</button></form>
<div class="summary-grid"><% informe.totales.forEach(t=>{ %><div class="summary-card"><div class="summary-label">Aplicaciones verificadas · <%= t.moneda %></div><div class="summary-value"><%= t.monto.toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div></div><% }) %><div class="summary-card"><div class="summary-label">Colillas consultadas</div><div class="summary-value"><%= colillas %></div></div><div class="summary-card"><div class="summary-label">Casos por revisar · excluidos del total</div><div class="summary-value"><%= informe.alertas.length %></div></div></div>
<% if(informe.alertas.length){ %><section class="mb-4"><h2 class="section-title">Casos por revisar</h2><ul><% informe.alertas.forEach(a=>{ %><li>Colilla #<%= a.id %>: <%= a.motivo %></li><% }) %></ul></section><% } %>
<section class="surface-card table-responsive"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Colilla</th><th>Factura / referencia</th><th>Proveedor</th><th>Tipo</th><th>Moneda</th><th class="text-end">Importe aplicado</th></tr></thead><tbody>
<% if(!informe.movimientos.length){ %><tr><td colspan="7" class="text-center py-4">No hay aplicaciones verificadas en este mes.</td></tr><% } %>
<% informe.movimientos.forEach(p=>{ %><tr><td><%= p.fecha.split('-').reverse().join('/') %></td><td><a href="/compras/facturas/colillas/<%= p.colilla %>/descargar"><%= p.recibo %></a></td><td><%= p.factura || p.referencia %></td><td><%= p.proveedor || 'Sin proveedor registrado' %></td><td><%= p.tipo %></td><td><%= p.moneda %></td><td class="text-end"><%= (p.centavos/100).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td></tr><% }) %>
</tbody></table></section></main></body></html>
