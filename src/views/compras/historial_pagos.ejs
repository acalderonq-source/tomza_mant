<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Historial de pagos | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f1f5f9; color: #172033; font-family: 'Segoe UI', sans-serif; }
    .page { max-width: 1440px; }
    .panel { background: #fff; border: 1px solid #dce4ee; border-radius: 12px; }
    .table th { background: #f8fafc; color: #475569; font-size: .75rem; text-transform: uppercase; white-space: nowrap; }
    .table td { vertical-align: middle; }
    .amount { white-space: nowrap; font-weight: 750; }
    .receipt { font-weight: 750; color: #12366e; }
    .delivery-row { min-width: 230px; }
  </style>
</head>
<body>
  <main class="container-fluid page py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <div>
        <a href="/compras/facturas" class="link-secondary text-decoration-none small"><i class="bi bi-arrow-left"></i> Facturas</a>
        <h1 class="h3 fw-bold mt-2 mb-1">Historial de pagos</h1>
        <p class="text-secondary mb-0">Consulte cada pago o abono y vuelva a descargar su colilla.</p>
      </div>
      <div class="d-flex gap-2">
        <% if (user.rol === 'ADMIN') { %><a href="/compras/facturas/configuracion-correo" class="btn btn-outline-secondary"><i class="bi bi-envelope-gear me-1"></i> Configurar copias</a><% } %>
        <a href="/compras/facturas" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i> Volver a facturas</a>
      </div>
    </div>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form method="GET" class="panel p-3 mb-3">
      <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-lg-3">
          <label class="form-label small fw-semibold" for="desde">Desde</label>
          <input class="form-control" type="date" id="desde" name="desde" value="<%= filtros.desde %>">
        </div>
        <div class="col-sm-6 col-lg-3">
          <label class="form-label small fw-semibold" for="hasta">Hasta</label>
          <input class="form-control" type="date" id="hasta" name="hasta" value="<%= filtros.hasta %>">
        </div>
        <div class="col-sm-6 col-lg-3">
          <label class="form-label small fw-semibold" for="tipo">Movimiento</label>
          <select class="form-select" id="tipo" name="tipo">
            <option value="">Todos</option>
            <option value="pago" <%= filtros.tipo === 'pago' ? 'selected' : '' %>>Pago individual</option>
            <option value="pago_multiple" <%= filtros.tipo === 'pago_multiple' ? 'selected' : '' %>>Pago de varias facturas</option>
            <option value="abono" <%= filtros.tipo === 'abono' ? 'selected' : '' %>>Abono</option>
          </select>
        </div>
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
          <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filtrar</button>
          <a class="btn btn-outline-secondary" href="/compras/facturas/historial-pagos" aria-label="Limpiar filtros" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </div>
      </div>
    </form>

    <section class="panel overflow-hidden">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 border-bottom">
        <div class="fw-bold">Colillas registradas</div>
        <div class="small text-secondary"><%= colillas.length %> resultado(s)<% if (colillas.length === limite) { %> · mostrando los últimos <%= limite %><% } %></div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Colilla</th><th>Fecha de pago</th><th>Tipo</th><th>Proveedor(es)</th>
              <th>Facturas</th><th class="text-end">Monto</th><th>Registrado por</th><th>Correo proveedor</th><th>Documento</th>
            </tr>
          </thead>
          <tbody>
            <% if (!colillas.length) { %>
              <tr><td colspan="9" class="text-center text-secondary py-5">No hay pagos para los filtros seleccionados.</td></tr>
            <% } %>
            <% colillas.forEach(colilla => { %>
              <tr>
                <td>
                  <div class="receipt"><%= colilla.recibo_numero %></div>
                  <% if (colilla.origen === 'reconstruido') { %><span class="badge text-bg-warning">Histórico reconstruido</span><% } %>
                </td>
                <td><%= String(colilla.fecha_pago || '').slice(0, 10) %></td>
                <td>
                  <% if (colilla.tipo_pago === 'abono') { %>
                    <span class="badge text-bg-info">Abono</span>
                  <% } else if (colilla.tipo_pago === 'pago_multiple') { %>
                    <span class="badge text-bg-primary">Pago múltiple</span>
                  <% } else { %>
                    <span class="badge text-bg-success">Pago</span>
                  <% } %>
                </td>
                <td><%= colilla.proveedores || 'Sin proveedor' %></td>
                <td>
                  <div><%= colilla.facturas.length %> factura(s)</div>
                  <% if (colilla.numerosFactura) { %><small class="text-secondary"><%= colilla.numerosFactura %></small><% } %>
                </td>
                <td class="text-end amount">₡<%= Number(colilla.total_pagado || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                <td><%= colilla.generado_por || 'Sistema' %></td>
                <td class="delivery-row">
                  <% const envios = enviosCorreo.get(Number(colilla.id)) || []; %>
                  <% if (!envios.length) { %>
                    <span class="text-secondary small">Sin envío automático</span>
                  <% } %>
                  <% envios.forEach(envio => { %>
                    <% const claseEstado = envio.estado === 'ENVIADO' ? 'success' : envio.estado === 'ERROR' || envio.estado === 'SIN_CORREO' ? 'danger' : 'warning'; %>
                    <div class="mb-2">
                      <div><span class="badge text-bg-<%= claseEstado %>"><%= envio.estado %></span> <small><%= envio.proveedor_nombre %></small></div>
                      <div class="small text-secondary"><%= envio.correo_destino || 'Sin correo de proveedor' %></div>
                      <% if (envio.error) { %><div class="small text-danger"><%= envio.error %></div><% } %>
                      <% if (envio.estado !== 'ENVIANDO') { %>
                        <form method="POST" action="/compras/facturas/envios/<%= envio.id %>/reintentar" class="mt-1">
                          <button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-envelope-arrow-up me-1"></i><%= envio.estado === 'ENVIADO' ? 'Reenviar' : 'Reintentar envío' %></button>
                          <% if (envio.estado === 'SIN_CORREO') { %><a class="btn btn-sm btn-link" href="<%= envio.proveedor_id ? `/compras/proveedores/editar/${envio.proveedor_id}` : '/compras/proveedores' %>">Revisar proveedor</a><% } %>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                </td>
                <td>
                  <a class="btn btn-sm btn-outline-primary" href="/compras/facturas/colillas/<%= colilla.id %>/descargar">
                    <i class="bi bi-download me-1"></i> Descargar PDF
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
