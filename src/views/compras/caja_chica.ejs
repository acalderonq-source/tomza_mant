<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Caja chica</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #eef2f7; color: #0f172a; font-family: 'Segoe UI', Roboto, sans-serif; }
    .page-wrap { max-width: 1300px; }
    .topbar {
      background: linear-gradient(135deg, #0f172a, #123b80);
      border-bottom: 4px solid #f59e0b;
      color: #fff;
    }
    .hero {
      background: linear-gradient(135deg, #111827, #f59e0b);
      border-radius: 18px;
      color: #fff;
      padding: 1.2rem;
    }
    .hero h1 { font-size: 1.6rem; font-weight: 900; margin: 0; }
    .hero p { color: rgba(255,255,255,.84); margin: .35rem 0 0; }
    .stat-grid {
      display: grid;
      gap: .85rem;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      margin: 1rem 0;
    }
    .stat-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 14px;
      box-shadow: 0 8px 18px rgba(15,23,42,.05);
      padding: .95rem;
    }
    .stat-label { color: #64748b; font-size: .76rem; font-weight: 900; text-transform: uppercase; }
    .stat-value { font-size: 1.55rem; font-weight: 900; line-height: 1.1; }
    .panel {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(15,23,42,.05);
      overflow: hidden;
    }
    .panel-head {
      align-items: center;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 1rem;
    }
    .panel-title { font-size: 1rem; font-weight: 900; margin: 0; }
    .form-box {
      background: #fffbeb;
      border: 1px dashed #f59e0b;
      border-radius: 16px;
      padding: 1rem;
    }
    .month-chart {
      display: grid;
      gap: .55rem;
    }
    .month-row {
      display: grid;
      gap: .35rem;
    }
    .month-row-head {
      display: flex;
      font-size: .82rem;
      justify-content: space-between;
    }
    .month-track {
      background: #e2e8f0;
      border-radius: 999px;
      height: 14px;
      overflow: hidden;
    }
    .month-bar {
      background: linear-gradient(90deg, #f59e0b, #dc2626);
      border-radius: 999px;
      height: 100%;
      min-width: 4%;
    }
    .table-wrap {
      max-height: calc(100vh - 360px);
      overflow: auto;
    }
    .history-table { font-size: .9rem; margin: 0; }
    .history-table th {
      background: #f8fafc;
      color: #334155;
      font-size: .72rem;
      position: sticky;
      text-transform: uppercase;
      top: 0;
      z-index: 1;
    }
    @media (max-width: 768px) {
      .hero h1 { font-size: 1.3rem; }
      .panel-head { align-items: stretch; flex-direction: column; }
      .table-wrap { max-height: none; }
    }
  </style>
</head>
<body>
<nav class="topbar px-3 py-2">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="fw-black"><i class="bi bi-wallet2 me-2"></i>Caja chica</div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="small"><%= user.usuario %> (<%= user.rol %>)</span>
      <a href="/compras/facturas" class="btn btn-sm btn-outline-light">Facturas</a>
      <a href="/compras/facturas/pagos-proveedor" class="btn btn-sm btn-outline-light">Pago proveedor</a>
      <a href="/compras/facturas/dashboard" class="btn btn-sm btn-outline-light">Dashboard facturas</a>
      <a href="/dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
      <a href="/logout" class="btn btn-sm btn-warning">Salir</a>
    </div>
  </div>
</nav>

<main class="container-fluid page-wrap py-4">
  <%
    const data = cajaChica || { resumen: {}, porMes: [], historial: [] };
    const puedeRegistrar = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
    const moneda = value => `₡${Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 })}`;
    const fecha = value => {
      if (!value) return '—';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('es-CR');
    };
    const maxMes = Math.max(...data.porMes.map(item => Number(item.total || 0)), 1);
  %>

  <section class="hero">
    <div class="d-flex justify-content-between gap-3 flex-wrap">
      <div>
        <h1>Reintegros de caja chica</h1>
        <p>Registra manualmente la fecha y el monto del reintegro. Todo queda guardado como historial.</p>
      </div>
      <div class="text-end">
        <div class="small text-white-50">Total histórico</div>
        <div class="fs-3 fw-black"><%= moneda(data.resumen.total) %></div>
      </div>
    </div>
  </section>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show mt-3">
      <%= success %>
      <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show mt-3">
      <%= error %>
      <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Registros</div>
      <div class="stat-value"><%= Number(data.resumen.registros || 0).toLocaleString('es-CR') %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total mes actual</div>
      <div class="stat-value"><%= moneda(data.resumen.total_mes) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total histórico</div>
      <div class="stat-value"><%= moneda(data.resumen.total) %></div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-4">
      <section class="panel">
        <div class="panel-head">
          <h2 class="panel-title">Nuevo reintegro</h2>
        </div>
        <div class="p-3">
          <% if (puedeRegistrar) { %>
            <form method="POST" action="/compras/facturas/caja-chica" class="form-box">
              <div class="mb-3">
                <label class="form-label fw-bold">Fecha</label>
                <input type="date" name="fecha" class="form-control" value="<%= hoy %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Monto del reintegro</label>
                <input type="number" name="monto" class="form-control" min="1" step="0.01" placeholder="Ej: 50000" required>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Observación</label>
                <textarea name="observacion" class="form-control" rows="3" placeholder="Opcional"></textarea>
              </div>
              <button class="btn btn-warning w-100 fw-bold">
                <i class="bi bi-check2-circle"></i> Guardar reintegro
              </button>
            </form>
          <% } else { %>
            <div class="alert alert-info mb-0">Contabilidad puede ver caja chica, pero no registrar reintegros.</div>
          <% } %>
        </div>
      </section>

      <section class="panel mt-3">
        <div class="panel-head">
          <h2 class="panel-title">Por mes</h2>
        </div>
        <div class="p-3 month-chart">
          <% if (data.porMes.length) { %>
            <% data.porMes.forEach(item => { %>
              <div class="month-row">
                <div class="month-row-head">
                  <strong><%= item.mes %></strong>
                  <span><%= moneda(item.total) %></span>
                </div>
                <div class="month-track">
                  <div class="month-bar" style="width: <%= Math.max(4, Math.round((Number(item.total || 0) / maxMes) * 100)) %>%"></div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-muted">Sin reintegros registrados.</div>
          <% } %>
        </div>
      </section>
    </div>

    <div class="col-lg-8">
      <section class="panel">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">Historial de caja chica</h2>
            <div class="small text-muted">Últimos 300 reintegros registrados.</div>
          </div>
          <a href="/compras/facturas" class="btn btn-sm btn-outline-secondary">Volver a facturas</a>
        </div>
        <div class="table-wrap">
          <table class="table table-hover align-middle history-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Observación</th>
                <th>Registrado por</th>
              </tr>
            </thead>
            <tbody>
              <% if (data.historial.length) { %>
                <% data.historial.forEach(item => { %>
                  <tr>
                    <td><strong><%= fecha(item.fecha) %></strong></td>
                    <td class="fw-bold"><%= moneda(item.monto) %></td>
                    <td><%= item.observacion || '—' %></td>
                    <td><%= item.creado_por_usuario || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">Todavía no hay reintegros registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
