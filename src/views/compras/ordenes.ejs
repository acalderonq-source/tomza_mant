<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Órdenes de Compra</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background: #f0f2f5;
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }
    .card-modern {
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      background: white;
    }
    .card-header-modern {
      background: white;
      border-bottom: 1px solid #eef2f6;
      padding: 1.2rem 1.5rem;
      font-weight: 600;
      font-size: 1.2rem;
      border-radius: 20px 20px 0 0;
    }
    .filtros-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.03);
      padding: 1.5rem;
      margin-bottom: 1.8rem;
    }
    .btn-filtrar {
      background: #1f2937;
      border: none;
      font-weight: 500;
    }
    .btn-filtrar:hover {
      background: #2d3a4f;
    }
    .btn-limpiar {
      background: #6c757d;
      border: none;
      color: white;
    }
    .table-responsive {
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
    }
    .table-ordenes {
      margin-bottom: 0;
      min-width: 920px;
    }
    .table-ordenes th,
    .table-ordenes td {
      white-space: nowrap;
      vertical-align: middle;
    }
    .table-ordenes thead th {
      background: #f8fafc;
      border-bottom: 2px solid #e2e8f0;
      color: #1e293b;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      padding: 0.8rem 0.6rem;
    }
    .table-ordenes tbody td {
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid #edf2f7;
      font-size: 0.85rem;
    }
    .badge-estado {
      font-size: 0.7rem;
      font-weight: 500;
      padding: 0.3em 0.6em;
      border-radius: 30px;
    }
    .acciones-col {
      width: 1%;
      text-align: right;
    }
    .action-menu-btn {
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      font-size: 0.78rem;
    }
    .acciones-menu {
      min-width: 240px;
      border: none;
      border-radius: 14px;
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.16);
      font-size: 0.85rem;
    }
    .acciones-menu .dropdown-item {
      border-radius: 10px;
      padding: 0.45rem 0.6rem;
    }
    .acciones-menu .dropdown-item i {
      width: 1.15rem;
      margin-right: 0.35rem;
    }
    .factura-mini label {
      font-size: 0.72rem;
      color: #64748b;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .input-factura {
      font-size: 0.78rem;
    }
    @media (max-width: 768px) {
      .table-ordenes {
        min-width: auto;
      }
      .table-ordenes thead {
        display: none;
      }
      .table-ordenes, .table-ordenes tbody, .table-ordenes tr, .table-ordenes td {
        display: block;
        width: 100%;
      }
      .table-ordenes tr {
        margin-bottom: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 0.8rem;
        background: white;
      }
      .table-ordenes td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border-bottom: 1px solid #eef2f6;
        white-space: normal;
      }
      .table-ordenes td::before {
        content: attr(data-label);
        position: absolute;
        left: 0.8rem;
        width: 45%;
        font-weight: 600;
        text-align: left;
        color: #1e293b;
      }
      .input-factura {
        width: 70px;
      }
      .acciones-col {
        width: 100%;
      }
      .acciones-menu {
        width: min(260px, 90vw);
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold">🛒 Órdenes de Compra</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Volver</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Órdenes de compra</h1>
      <p class="page-subtitle">Consulta, factura y da seguimiento a las órdenes registradas.</p>
    </div>
    <a href="/compras/ordenes/nueva" class="btn btn-dark btn-sm">
      <i class="bi bi-plus-lg"></i> Nueva orden
    </a>
  </div>

  <!-- Filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar órdenes</h5>
    <form method="GET" action="/compras/ordenes" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtros.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">PO Número</label>
        <input type="text" name="po_numero" class="form-control form-control-sm" placeholder="Ej: 2026-260" value="<%= filtros.po_numero || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estados.forEach(est => { %>
            <option value="<%= est %>" <%= filtros.estado === est ? 'selected' : '' %>><%= est.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Facturada</label>
        <select name="facturada" class="form-select form-select-sm">
          <option value="">Todas</option>
          <option value="1" <%= filtros.facturada == '1' ? 'selected' : '' %>>Facturadas</option>
          <option value="0" <%= filtros.facturada == '0' ? 'selected' : '' %>>No facturadas</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-filtrar btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/ordenes" class="btn btn-limpiar btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <%
    const ordenesFacturadas = ordenes.filter(o => o.facturada || o.factura).length;
    const ordenesRecibidas = ordenes.filter(o => o.estado === 'RECIBIDA_TOTAL' || o.estado === 'RECIBIDA_PARCIAL').length;
  %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Órdenes</div>
      <div class="summary-value"><%= ordenes.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Total filtrado</div>
      <div class="summary-value">₡<%= typeof totalFiltrado !== 'undefined' ? parseFloat(totalFiltrado).toLocaleString('es-CR', { maximumFractionDigits: 0 }) : '0' %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Facturadas</div>
      <div class="summary-value"><%= ordenesFacturadas %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Recibidas</div>
      <div class="summary-value"><%= ordenesRecibidas %></div>
    </div>
  </div>

  <!-- Listado de órdenes -->
  <div class="card-modern">
    <div class="card-header-modern d-flex justify-content-between align-items-center flex-wrap">
      <span><i class="bi bi-receipt me-2"></i>Listado de Órdenes</span>
      <div>
        <a href="/compras/dashboard" class="btn btn-outline-dark btn-sm me-2">
          <i class="bi bi-graph-up"></i> Dashboard
        </a>
        <a href="/compras/facturas" class="btn btn-outline-info btn-sm me-2">
          <i class="bi bi-receipt"></i> Facturas
        </a>
        <% if (user.rol === 'ADMIN' || user.rol === 'PROVEEDURIA_TALLER') { %>
          <a href="/compras/proveedores" class="btn btn-outline-secondary btn-sm me-2">
            <i class="bi bi-building"></i> Gestionar Proveedores
          </a>
        <% } %>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-ordenes">
        <thead>
          <tr>
            <th>PO Número</th>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th>Moneda</th>
            <th>Total</th>
            <th>Factura</th>
            <th>Estado</th>
            <th class="acciones-col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% ordenes.forEach(orden => { %>
            <%
              const filtrosActuales = filtros || {};
              const proveedor_id = filtrosActuales.proveedor_id || '';
              const fecha_desde = filtrosActuales.fecha_desde || '';
              const fecha_hasta = filtrosActuales.fecha_hasta || '';
              const po_numero = filtrosActuales.po_numero || '';
              const estado = filtrosActuales.estado || '';
              const facturada = filtrosActuales.facturada || '';
            %>
            <tr>
              <td data-label="PO Número"><strong><%= orden.po_numero %></strong></td>
              <td data-label="Fecha"><%= new Date(orden.fecha).toLocaleDateString('es-CR') %></td>
              <td data-label="Proveedor"><%= orden.proveedor_nombre %></td>
              <td data-label="Moneda"><%= orden.moneda %></td>
              <td data-label="Total" class="money"><%= parseFloat(orden.total).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              <td data-label="Factura"><%= orden.factura || '—' %></td>
              <td data-label="Estado">
                <span class="badge badge-estado <%= 
                  orden.estado === 'BORRADOR' ? 'bg-secondary' :
                  orden.estado === 'ENVIADA' ? 'bg-info' :
                  orden.estado === 'RECIBIDA_PARCIAL' ? 'bg-warning' :
                  orden.estado === 'RECIBIDA_TOTAL' ? 'bg-success' : 'bg-danger'
                %>">
                  <%= orden.estado.replace('_', ' ') %>
                </span>
              </td>
              <td data-label="Acciones" class="acciones-col">
                <div class="dropdown">
                  <button class="btn btn-dark btn-sm dropdown-toggle action-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    Acciones
                  </button>
                  <div class="dropdown-menu dropdown-menu-end acciones-menu p-2">
                    <a href="/compras/ordenes/<%= orden.id %>/detalle" class="dropdown-item"><i class="bi bi-eye"></i> Ver detalle</a>
                    <a href="/compras/ordenes/<%= orden.id %>/editar" class="dropdown-item"><i class="bi bi-pencil"></i> Editar orden</a>
                    <a href="/compras/ordenes/<%= orden.id %>/pdf" class="dropdown-item"><i class="bi bi-file-pdf"></i> Descargar PDF</a>

                    <div class="dropdown-divider"></div>

                    <% if (!orden.facturada) { %>
                      <form method="POST" action="/compras/ordenes/<%= orden.id %>/factura" class="factura-mini px-2 py-1">
                        <label>Número de factura</label>
                        <div class="input-group input-group-sm">
                          <input type="text" name="factura" class="form-control input-factura" placeholder="N°" required>
                          <button type="submit" class="btn btn-primary"><i class="bi bi-receipt"></i></button>
                        </div>
                        <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                        <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                        <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                        <input type="hidden" name="po_numero" value="<%= po_numero %>">
                        <input type="hidden" name="estado" value="<%= estado %>">
                        <input type="hidden" name="facturada" value="<%= facturada %>">
                      </form>
                    <% } else { %>
                      <div class="px-2 py-1"><span class="badge bg-success">Facturada</span></div>
                    <% } %>

                    <div class="dropdown-divider"></div>

                    <% if (orden.estado !== 'RECIBIDA_TOTAL' && orden.estado !== 'RECIBIDA_PARCIAL') { %>
                      <form method="POST" action="/compras/ordenes/<%= orden.id %>/recibir">
                        <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                        <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                        <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                        <input type="hidden" name="po_numero" value="<%= po_numero %>">
                        <input type="hidden" name="estado" value="<%= estado %>">
                        <input type="hidden" name="facturada" value="<%= facturada %>">
                        <button type="submit" class="dropdown-item text-success" onclick="return confirm('¿Marcar esta orden como recibida?')">
                          <i class="bi bi-check-circle"></i> Marcar recibido
                        </button>
                      </form>

                      <form method="POST" action="/compras/ordenes/<%= orden.id %>/eliminar">
                        <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                        <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                        <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                        <input type="hidden" name="po_numero" value="<%= po_numero %>">
                        <input type="hidden" name="estado" value="<%= estado %>">
                        <input type="hidden" name="facturada" value="<%= facturada %>">
                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('¿Eliminar esta orden permanentemente?')">
                          <i class="bi bi-trash"></i> Eliminar orden
                        </button>
                      </form>
                    <% } else { %>
                      <div class="px-2 py-1"><span class="badge bg-success">Recibido</span></div>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (ordenes.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No hay órdenes con los filtros seleccionados</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
