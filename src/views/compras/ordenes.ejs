<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Órdenes de Compra</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background: #f0f2f5;
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }
    .card-modern {
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      background: white;
    }
    .card-header-modern {
      background: white;
      border-bottom: 1px solid #eef2f6;
      padding: 1.2rem 1.5rem;
      font-weight: 600;
      font-size: 1.2rem;
      border-radius: 20px 20px 0 0;
    }
    .filtros-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.03);
      padding: 1.5rem;
      margin-bottom: 1.8rem;
    }
    .btn-filtrar {
      background: #1f2937;
      border: none;
      font-weight: 500;
    }
    .btn-filtrar:hover {
      background: #2d3a4f;
    }
    .btn-limpiar {
      background: #6c757d;
      border: none;
      color: white;
    }
    .table-responsive {
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
    }
    .table-ordenes {
      margin-bottom: 0;
      min-width: 980px;
    }
    .table-ordenes th,
    .table-ordenes td {
      white-space: nowrap;
      vertical-align: middle;
    }
    .table-ordenes thead th {
      background: #f8fafc;
      border-bottom: 2px solid #e2e8f0;
      color: #1e293b;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      padding: 0.8rem 0.6rem;
    }
    .table-ordenes tbody td {
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid #edf2f7;
      font-size: 0.85rem;
    }
    .badge-estado {
      font-size: 0.7rem;
      font-weight: 500;
      padding: 0.3em 0.6em;
      border-radius: 30px;
    }
    .badge-fe {
      background: #e0f2fe;
      border: 1px solid #bae6fd;
      color: #075985;
      font-size: 0.68rem;
      font-weight: 700;
    }
    .badge-fe-ok {
      background: #dcfce7;
      border-color: #bbf7d0;
      color: #166534;
    }
    .acciones-col {
      width: 1%;
      text-align: right;
    }
    .action-menu-btn {
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      font-size: 0.78rem;
    }
    .acciones-menu {
      min-width: 240px;
      border: none;
      border-radius: 14px;
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.16);
      font-size: 0.85rem;
    }
    .acciones-menu .dropdown-item {
      border-radius: 10px;
      padding: 0.45rem 0.6rem;
    }
    .acciones-menu .dropdown-item i {
      width: 1.15rem;
      margin-right: 0.35rem;
    }
    .factura-mini label {
      font-size: 0.72rem;
      color: #64748b;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .input-factura {
      font-size: 0.78rem;
    }
    .electronica-panel {
      border: 1px solid #bae6fd;
      border-radius: 18px;
      background: #f8fcff;
      box-shadow: 0 12px 28px rgba(14, 165, 233, 0.08);
      margin-bottom: 1.6rem;
      overflow: hidden;
    }
    .electronica-head {
      background: linear-gradient(135deg, #0f172a, #075985);
      color: white;
      padding: 1rem 1.25rem;
    }
    .electronica-head h5 {
      margin: 0;
      font-weight: 800;
    }
    .electronica-head p {
      margin: 0.25rem 0 0;
      color: #dbeafe;
      font-size: 0.86rem;
    }
    .electronica-body {
      padding: 1.25rem;
    }
    .electronica-textarea {
      min-height: 210px;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 0.78rem;
      white-space: pre;
    }
    .electronica-stat {
      border: 1px solid #dbeafe;
      border-radius: 14px;
      background: white;
      padding: 0.85rem;
    }
    .electronica-stat span {
      display: block;
      color: #64748b;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
    }
    .electronica-stat strong {
      color: #0f172a;
      font-size: 1.35rem;
    }
    @media (max-width: 768px) {
      .table-ordenes {
        min-width: auto;
      }
      .table-ordenes thead {
        display: none;
      }
      .table-ordenes, .table-ordenes tbody, .table-ordenes tr, .table-ordenes td {
        display: block;
        width: 100%;
      }
      .table-ordenes tr {
        margin-bottom: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 0.8rem;
        background: white;
      }
      .table-ordenes td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border-bottom: 1px solid #eef2f6;
        white-space: normal;
      }
      .table-ordenes td::before {
        content: attr(data-label);
        position: absolute;
        left: 0.8rem;
        width: 45%;
        font-weight: 600;
        text-align: left;
        color: #1e293b;
      }
      .input-factura {
        width: 70px;
      }
      .acciones-col {
        width: 100%;
      }
      .acciones-menu {
        width: min(260px, 90vw);
      }
    }
  </style>
  <link rel="stylesheet" href="/css/compras.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <span class="navbar-brand fw-semibold">🛒 Órdenes de Compra</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Volver</a>
  </div>
</nav>

<div class="container py-4">
  <%
    const rolesGestionCompras = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'];
    const rolesMensajeroFacturas = ['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'];
    const puedeModificarCompras = rolesGestionCompras.includes(user.rol);
    const esMensajero = rolesMensajeroFacturas.includes(user.rol);
    const puedeRegistrarFacturaOrden = puedeModificarCompras || esMensajero;
    const puedeVerFacturas = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'CONTABILIDAD'].includes(user.rol);
    const puedeDescargarReporte = !esMensajero;
    const reporteParams = new URLSearchParams();
    if (filtros.proveedor_id) reporteParams.set('proveedor_id', filtros.proveedor_id);
    if (filtros.fecha_desde) reporteParams.set('fecha_desde', filtros.fecha_desde);
    if (filtros.fecha_hasta) reporteParams.set('fecha_hasta', filtros.fecha_hasta);
    if (filtros.po_numero) reporteParams.set('po_numero', filtros.po_numero);
    if (filtros.placa_unidad) reporteParams.set('placa_unidad', filtros.placa_unidad);
    if (filtros.estado) reporteParams.set('estado', filtros.estado);
    if (filtros.facturada !== undefined && filtros.facturada !== '') reporteParams.set('facturada', filtros.facturada);
    const reporteOrdenesUrl = '/compras/ordenes/reporte/pdf' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const reporteOrdenesExcelUrl = '/compras/ordenes/reporte/excel' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
    const returnToOrdenes = '/compras/ordenes' + (reporteParams.toString() ? `?${reporteParams.toString()}` : '');
  %>
  <div class="page-heading">
    <div>
      <h1 class="page-title">Órdenes de compra</h1>
      <p class="page-subtitle"><%= esMensajero ? 'Registre facturas recibidas directamente desde la orden de compra.' : 'Consulta, factura y da seguimiento a las órdenes registradas.' %></p>
    </div>
    <% if (puedeModificarCompras) { %>
      <a href="/compras/ordenes/nueva" class="btn btn-dark btn-sm">
        <i class="bi bi-plus-lg"></i> Nueva orden
      </a>
      <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="collapse" data-bs-target="#panelFacturacionElectronica" aria-expanded="false" aria-controls="panelFacturacionElectronica">
        <i class="bi bi-shuffle"></i> Cruzar facturación electrónica
      </button>
      <a href="/ordenes-motor" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-gear-wide-connected"></i> Órdenes motor
      </a>
    <% } %>
  </div>

  <% if (success) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
  <% } %>

  <!-- Filtros -->
  <div class="filtros-card">
    <h5 class="mb-3 fw-semibold"><i class="bi bi-funnel me-2"></i>Filtrar órdenes</h5>
    <form method="GET" action="/compras/ordenes" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtros.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Fecha desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Fecha hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">PO Número</label>
        <input type="text" name="po_numero" class="form-control form-control-sm" placeholder="Ej: 2026-260" value="<%= filtros.po_numero || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Placa</label>
        <input type="text" name="placa_unidad" class="form-control form-control-sm text-uppercase" placeholder="Ej: CL279463" value="<%= filtros.placa_unidad || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estados.forEach(est => { %>
            <option value="<%= est %>" <%= filtros.estado === est ? 'selected' : '' %>><%= est.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-secondary">Facturada</label>
        <select name="facturada" class="form-select form-select-sm">
          <option value="">Todas</option>
          <option value="1" <%= filtros.facturada == '1' ? 'selected' : '' %>>Facturadas</option>
          <option value="0" <%= filtros.facturada == '0' ? 'selected' : '' %>>No facturadas</option>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-filtrar btn-sm w-100">Filtrar</button>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <a href="/compras/ordenes" class="btn btn-limpiar btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <% if (puedeModificarCompras) { %>
    <%
      const electronicasRecientes = Array.isArray(facturasElectronicasRecientes) ? facturasElectronicasRecientes : [];
      const resumenFE = resumenElectronico || { total: 0, enlazadas: 0, aceptadas: 0, pendientes: 0 };
    %>
    <div class="collapse" id="panelFacturacionElectronica">
      <div class="electronica-panel">
        <div class="electronica-head d-flex justify-content-between align-items-start gap-3 flex-wrap">
          <div>
            <h5><i class="bi bi-shuffle me-2"></i>Cruce contra órdenes de compra</h5>
            <p>Pegue el reporte del otro sistema. Se compara proveedor, fecha, monto y códigos para colocar el consecutivo en N° Factura.</p>
          </div>
          <span class="badge bg-light text-dark">Órdenes</span>
        </div>
        <div class="electronica-body">
          <div class="row g-3 mb-3">
            <div class="col-md-3">
              <div class="electronica-stat">
                <span>Documentos cargados</span>
                <strong><%= Number(resumenFE.total || 0).toLocaleString('es-CR') %></strong>
              </div>
            </div>
            <div class="col-md-3">
              <div class="electronica-stat">
                <span>Enlazados</span>
                <strong><%= Number(resumenFE.enlazadas || 0).toLocaleString('es-CR') %></strong>
              </div>
            </div>
            <div class="col-md-3">
              <div class="electronica-stat">
                <span>Aceptados Hacienda</span>
                <strong><%= Number(resumenFE.aceptadas || 0).toLocaleString('es-CR') %></strong>
              </div>
            </div>
            <div class="col-md-3">
              <div class="electronica-stat">
                <span>Pendientes de revisar</span>
                <strong><%= Number(resumenFE.pendientes || 0).toLocaleString('es-CR') %></strong>
              </div>
            </div>
          </div>

          <form method="POST" action="/compras/ordenes/electronicas/importar" class="mb-4">
            <input type="hidden" name="return_to" value="<%= returnToOrdenes %>">
            <div class="row g-3">
              <div class="col-lg-8">
                <label class="form-label small fw-semibold text-secondary">Datos del otro sistema</label>
                <textarea name="facturas_electronicas_texto" class="form-control electronica-textarea" placeholder="Pegue aquí las filas con Fecha, Clave, Consecutivo, Nombre emisor, Código Comercial, Detalle, Monto total línea..." required></textarea>
              </div>
              <div class="col-lg-4">
                <label class="form-label small fw-semibold text-secondary">Nombre del archivo o referencia</label>
                <input type="text" name="fuente_archivo" class="form-control form-control-sm mb-3" placeholder="Ej: Reporte Creatica septiembre">

                <label class="form-label small fw-semibold text-secondary">Estado Hacienda por defecto</label>
                <select name="estado_default" class="form-select form-select-sm mb-3">
                  <option value="ACEPTADA">ACEPTADA</option>
                  <option value="PENDIENTE">PENDIENTE</option>
                  <option value="RECHAZADA">RECHAZADA</option>
                  <option value="ANULADA">ANULADA</option>
                </select>

                <div class="alert alert-info small mb-3">
                  El consecutivo se guarda como <strong>N° Factura</strong> de la orden. La clave queda guardada aparte para trazabilidad.
                </div>

                <button type="submit" class="btn btn-primary w-100">
                  <i class="bi bi-lightning-charge"></i> Cruzar y actualizar órdenes
                </button>
              </div>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Proveedor otro sistema</th>
                  <th>Orden interna</th>
                  <th>N° Factura</th>
                  <th>Consecutivo</th>
                  <th>Criterio</th>
                  <th>Estado</th>
                  <th class="text-end">Monto</th>
                </tr>
              </thead>
              <tbody>
                <% electronicasRecientes.forEach(fe => { %>
                  <tr>
                    <td><%= fe.fecha_emision ? new Date(fe.fecha_emision).toLocaleDateString('es-CR') : '—' %></td>
                    <td>
                      <strong><%= fe.nombre_emisor || 'Sin proveedor' %></strong>
                      <% if (fe.cedula_emisor) { %>
                        <div class="small text-muted"><%= fe.cedula_emisor %></div>
                      <% } %>
                    </td>
                    <td><%= fe.po_numero || 'Sin cruce' %></td>
                    <td><%= fe.factura_interna || fe.numero_factura || '—' %></td>
                    <td class="small"><%= fe.consecutivo || '—' %></td>
                    <td><span class="badge bg-light text-dark"><%= fe.criterio_cruce || (fe.orden_compra_id ? 'CRUCE' : 'PENDIENTE') %></span></td>
                    <td>
                      <span class="badge <%= fe.estado_hacienda === 'ACEPTADA' ? 'bg-success' : fe.estado_hacienda === 'RECHAZADA' ? 'bg-danger' : 'bg-secondary' %>">
                        <%= fe.estado_hacienda || 'PENDIENTE' %>
                      </span>
                    </td>
                    <td class="text-end fw-semibold">₡<%= parseFloat(fe.monto_total || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                  </tr>
                <% }) %>
                <% if (!electronicasRecientes.length) { %>
                  <tr>
                    <td colspan="8" class="text-center text-muted py-3">Todavía no hay cruces de facturación electrónica.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <%
    const ordenesFacturadas = ordenes.filter(o => o.facturada || o.factura).length;
    const ordenesRecibidas = ordenes.filter(o => o.estado === 'RECIBIDA_TOTAL' || o.estado === 'RECIBIDA_PARCIAL').length;
  %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Órdenes</div>
      <div class="summary-value"><%= ordenes.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Total filtrado</div>
      <div class="summary-value">₡<%= typeof totalFiltrado !== 'undefined' ? parseFloat(totalFiltrado).toLocaleString('es-CR', { maximumFractionDigits: 0 }) : '0' %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Facturadas</div>
      <div class="summary-value"><%= ordenesFacturadas %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Recibidas</div>
      <div class="summary-value"><%= ordenesRecibidas %></div>
    </div>
  </div>

  <!-- Listado de órdenes -->
  <div class="card-modern">
    <div class="card-header-modern d-flex justify-content-between align-items-center flex-wrap">
      <span><i class="bi bi-receipt me-2"></i>Listado de Órdenes</span>
      <div>
        <% if (puedeDescargarReporte) { %>
          <a href="<%= reporteOrdenesUrl %>" class="btn btn-outline-success btn-sm me-2">
            <i class="bi bi-file-earmark-pdf"></i> PDF
          </a>
          <a href="<%= reporteOrdenesExcelUrl %>" class="btn btn-success btn-sm me-2">
            <i class="bi bi-file-earmark-excel"></i> Excel completo
          </a>
        <% } %>
        <% if (puedeModificarCompras) { %>
          <a href="/compras/dashboard" class="btn btn-outline-dark btn-sm me-2">
            <i class="bi bi-graph-up"></i> Dashboard
          </a>
          <a href="/ordenes-motor" class="btn btn-outline-danger btn-sm me-2">
            <i class="bi bi-gear-wide-connected"></i> Motor
          </a>
        <% } %>
        <% if (puedeVerFacturas) { %>
          <a href="/compras/facturas" class="btn btn-outline-info btn-sm me-2">
            <i class="bi bi-receipt"></i> Facturas
          </a>
        <% } %>
        <% if (user.rol === 'ADMIN' || user.rol === 'PROVEEDURIA_TALLER') { %>
          <a href="/compras/proveedores" class="btn btn-outline-secondary btn-sm me-2">
            <i class="bi bi-building"></i> Gestionar Proveedores
          </a>
        <% } %>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-ordenes">
        <thead>
          <tr>
            <th>PO Número</th>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th>Placa</th>
            <th>Moneda</th>
            <th>Total</th>
            <th>Cotización</th>
            <th>Factura</th>
            <th>FE</th>
            <th>Estado</th>
            <th class="acciones-col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% ordenes.forEach(orden => { %>
            <%
              const filtrosActuales = filtros || {};
              const proveedor_id = filtrosActuales.proveedor_id || '';
              const fecha_desde = filtrosActuales.fecha_desde || '';
              const fecha_hasta = filtrosActuales.fecha_hasta || '';
              const po_numero = filtrosActuales.po_numero || '';
              const placa_unidad = filtrosActuales.placa_unidad || '';
              const estado = filtrosActuales.estado || '';
              const facturada = filtrosActuales.facturada || '';
            %>
            <tr>
              <td data-label="PO Número"><strong><%= orden.po_numero %></strong></td>
              <td data-label="Fecha"><%= new Date(orden.fecha).toLocaleDateString('es-CR') %></td>
              <td data-label="Proveedor"><%= orden.proveedor_nombre %></td>
              <td data-label="Placa"><%= orden.placa_visual || orden.placa_unidad || '—' %></td>
              <td data-label="Moneda"><%= orden.moneda %></td>
              <td data-label="Total" class="money"><%= parseFloat(orden.total).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
              <td data-label="Cotización">
                <% if (orden.cotizacion_archivo) { %>
                  <a href="<%= orden.cotizacion_archivo %>" target="_blank" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-paperclip"></i> Ver
                  </a>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td data-label="Factura"><%= orden.factura || '—' %></td>
              <td data-label="FE">
                <% if (orden.factura_clave_electronica || orden.factura_consecutivo_electronico) { %>
                  <span class="badge badge-fe <%= orden.factura_estado_hacienda === 'ACEPTADA' ? 'badge-fe-ok' : '' %>"><%= orden.factura_estado_hacienda || 'PENDIENTE' %></span>
                  <div class="small text-muted"><%= orden.factura_consecutivo_electronico || '' %></div>
                <% } else { %>
                  <span class="badge badge-fe">Sin cruce</span>
                <% } %>
              </td>
              <td data-label="Estado">
                <span class="badge badge-estado <%= 
                  orden.estado === 'BORRADOR' ? 'bg-secondary' :
                  orden.estado === 'ENVIADA' ? 'bg-info' :
                  orden.estado === 'RECIBIDA_PARCIAL' ? 'bg-warning' :
                  orden.estado === 'RECIBIDA_TOTAL' ? 'bg-success' : 'bg-danger'
                %>">
                  <%= orden.estado.replace('_', ' ') %>
                </span>
              </td>
              <td data-label="Acciones" class="acciones-col">
                <div class="dropdown">
                  <button class="btn btn-dark btn-sm dropdown-toggle action-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    Acciones
                  </button>
                  <div class="dropdown-menu dropdown-menu-end acciones-menu p-2">
                    <a href="/compras/ordenes/<%= orden.id %>/detalle" class="dropdown-item"><i class="bi bi-eye"></i> Ver detalle</a>
                    <% if (!esMensajero) { %>
                      <a href="/compras/ordenes/<%= orden.id %>/pdf" class="dropdown-item"><i class="bi bi-file-pdf"></i> Descargar PDF</a>
                    <% } %>

                    <% if (puedeModificarCompras) { %>
                      <a href="/compras/ordenes/<%= orden.id %>/editar" class="dropdown-item"><i class="bi bi-pencil"></i> Editar orden</a>
                    <% } %>

                    <% if (puedeRegistrarFacturaOrden) { %>
                      <div class="dropdown-divider"></div>

                      <% if (!orden.facturada) { %>
                        <form method="POST" action="/compras/ordenes/<%= orden.id %>/factura" class="factura-mini px-2 py-1">
                          <label>Número de factura</label>
                          <input type="text" name="factura" class="form-control form-control-sm input-factura mb-2" placeholder="N° factura" required>
                          <label>Fecha de factura</label>
                          <input type="date" name="fecha_factura" class="form-control form-control-sm mb-2" value="<%= hoy || '' %>" required>
                          <label>Clave electrónica</label>
                          <input type="text" name="clave_electronica" class="form-control form-control-sm input-factura mb-2" placeholder="Opcional">
                          <label>Consecutivo</label>
                          <input type="text" name="consecutivo_electronico" class="form-control form-control-sm input-factura mb-2" placeholder="Opcional">
                          <label>Estado Hacienda</label>
                          <select name="estado_hacienda" class="form-select form-select-sm mb-2">
                            <option value="PENDIENTE">PENDIENTE</option>
                            <option value="ACEPTADA">ACEPTADA</option>
                            <option value="RECHAZADA">RECHAZADA</option>
                            <option value="ANULADA">ANULADA</option>
                          </select>
                          <label>Observación</label>
                          <textarea name="observacion_recepcion" class="form-control form-control-sm mb-2" rows="2" placeholder="Opcional"></textarea>
                          <input type="hidden" name="fecha_recepcion" value="<%= hoy || '' %>">
                          <input type="hidden" name="producto_recibido" value="1">
                          <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                          <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                          <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                          <input type="hidden" name="po_numero" value="<%= po_numero %>">
                          <input type="hidden" name="placa_unidad" value="<%= placa_unidad %>">
                          <input type="hidden" name="estado" value="<%= estado %>">
                          <input type="hidden" name="facturada" value="<%= facturada %>">
                          <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-receipt"></i> Registrar factura
                          </button>
                        </form>
                      <% } else { %>
                        <div class="px-2 py-1"><span class="badge bg-success">Facturada</span></div>
                      <% } %>
                    <% } %>

                    <% if (puedeModificarCompras) { %>
                      <div class="dropdown-divider"></div>

                      <% if (orden.estado !== 'RECIBIDA_TOTAL' && orden.estado !== 'RECIBIDA_PARCIAL') { %>
                        <form method="POST" action="/compras/ordenes/<%= orden.id %>/recibir">
                          <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                          <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                          <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                          <input type="hidden" name="po_numero" value="<%= po_numero %>">
                          <input type="hidden" name="placa_unidad" value="<%= placa_unidad %>">
                          <input type="hidden" name="estado" value="<%= estado %>">
                          <input type="hidden" name="facturada" value="<%= facturada %>">
                          <button type="submit" class="dropdown-item text-success" onclick="return confirm('¿Marcar esta orden como recibida?')">
                            <i class="bi bi-check-circle"></i> Marcar recibido
                          </button>
                        </form>
                      <% } else { %>
                        <div class="px-2 py-1"><span class="badge bg-success">Recibido</span></div>
                      <% } %>

                      <form method="POST" action="/compras/ordenes/<%= orden.id %>/eliminar">
                        <input type="hidden" name="proveedor_id" value="<%= proveedor_id %>">
                        <input type="hidden" name="fecha_desde" value="<%= fecha_desde %>">
                        <input type="hidden" name="fecha_hasta" value="<%= fecha_hasta %>">
                        <input type="hidden" name="po_numero" value="<%= po_numero %>">
                        <input type="hidden" name="placa_unidad" value="<%= placa_unidad %>">
                        <input type="hidden" name="estado" value="<%= estado %>">
                        <input type="hidden" name="facturada" value="<%= facturada %>">
                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('¿Eliminar esta orden permanentemente? Si tiene factura ligada también se quitará de compras.')">
                          <i class="bi bi-trash"></i> Eliminar orden
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (ordenes.length === 0) { %>
            <tr><td colspan="11" class="text-center text-muted py-4">No hay órdenes con los filtros seleccionados</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
