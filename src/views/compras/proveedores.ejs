<!DOCTYPE html>
<html>
<head>
  <title>Proveedores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
  <div class="d-flex justify-content-between mb-3">
    <h2>Proveedores</h2>
    <a href="/compras/proveedores/nuevo" class="btn btn-primary">➕ Nuevo proveedor</a>
  </div>
  <table class="table table-bordered">
    <thead>
      <tr><th>ID</th><th>Nombre</th><th>Teléfono</th><th>Email</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% proveedores.forEach(p => { %>
      <tr>
        <td><%= p.id %></td>
        <td><%= p.nombre %></td>
        <td><%= p.telefono || '-' %></td>
        <td><%= p.email || '-' %></td>
        <td>
          <a href="/compras/proveedores/editar/<%= p.id %>" class="btn btn-sm btn-warning">Editar</a>
          <a href="/compras/proveedores/eliminar/<%= p.id %>" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar?')">Eliminar</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>