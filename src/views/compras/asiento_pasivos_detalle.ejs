<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Asiento #<%= lote.id %> | Tomza Taller</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>body { background: #f3f6fb; color: #17243a; } .shell { max-width: 1200px; } .panel { background: white; border: 1px solid #d9e2ef; border-radius: 8px; overflow: hidden; } .amount { font-variant-numeric: tabular-nums; white-space: nowrap; }</style>
</head>
<body>
  <header class="py-3" style="background:#123872;color:white"><div class="container-fluid shell d-flex justify-content-between align-items-center flex-wrap gap-2"><h1 class="h4 mb-0">Asiento #<%= lote.id %></h1><a href="/compras/facturas/asientos" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Asientos</a></div></header>
  <main class="container-fluid shell py-3">
    <section class="panel mb-3 p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div><div class="small text-muted">Generado <%= new Date(lote.creado_en).toLocaleString('es-CR') %> · <%= lote.creado_por_usuario || 'Usuario no disponible' %></div><div class="fw-bold"><%= lote.cantidad_facturas %> factura(s) · ₡<%= Number(lote.monto_total).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
      <a href="/compras/facturas/asientos/<%= lote.id %>/excel" class="btn btn-primary"><i class="bi bi-download"></i> Descargar Excel original</a>
    </section>
    <section class="panel"><div class="p-3 border-bottom fw-bold">Facturas incluidas</div><div class="table-responsive"><table class="table table-sm mb-0 align-middle"><thead class="table-light"><tr><th class="ps-3">Tipo</th><th>N. factura</th><th>Proveedor</th><th>Fecha</th><th class="text-end pe-3">Monto incluido</th></tr></thead><tbody>
      <% facturas.forEach(f => { %><tr><td class="ps-3"><%= f.factura_tipo === 'orden' ? 'Orden' : 'Independiente' %></td><td><%= f.numero_factura || '-' %></td><td><%= f.proveedor_nombre || '-' %></td><td><%= f.fecha_factura ? new Date(f.fecha_factura).toLocaleDateString('es-CR', { timeZone: 'UTC' }) : '-' %></td><td class="text-end pe-3 amount">₡<%= Number(f.monto_asiento).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td></tr><% }) %>
    </tbody></table></div></section>
  </main>
</body>
</html>
