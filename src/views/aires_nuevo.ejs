<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nuevo aire acondicionado - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
      --blue: #2563eb;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid var(--blue);
    }

    .shell {
      max-width: 900px;
    }

    .panel,
    .hero {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .hero {
      padding: 1rem;
    }

    .page-title {
      font-size: 1.45rem;
      font-weight: 900;
      margin: 0;
    }

    .small-muted {
      color: var(--muted);
    }

    .form-label {
      color: #334155;
      font-size: .84rem;
      font-weight: 850;
    }

    .work-options {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .work-option {
      border: 1px solid var(--line);
      border-radius: 10px;
      cursor: pointer;
      padding: .85rem;
    }

    .work-option input {
      margin-right: .4rem;
    }

    .work-title {
      font-weight: 900;
    }

    .sticky-actions {
      background: rgba(243, 246, 250, .96);
      border-top: 1px solid var(--line);
      bottom: 0;
      padding: .8rem 0;
      position: sticky;
    }

    @media (max-width: 680px) {
      .work-options {
        grid-template-columns: 1fr;
      }

      .action-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-snow2 me-2"></i>Nuevo registro de aire</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/aires" class="btn btn-secondary btn-sm rounded-pill px-3">Volver</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <h1 class="page-title">Registrar trabajo de aire acondicionado</h1>
    <div class="small-muted">Selecciona la placa, el trabajo realizado, fecha, responsable y próximo mantenimiento.</div>
  </section>

  <section class="panel p-3">
    <form method="POST" action="/aires">
      <div class="row g-3">
        <div class="col-12 col-md-7">
          <label class="form-label">Unidad / placa</label>
          <div data-placa-search data-placa-mode="unidad" data-placa-target="#unidadAireId">
            <input type="text" class="form-control" data-placa-input data-placa-autocomplete placeholder="Escriba la placa" required>
            <input type="hidden" name="unidad_id" id="unidadAireId" required>
            <div data-placa-results></div>
            <div data-placa-selected></div>
          </div>
        </div>
        <div class="col-12 col-md-5">
          <label class="form-label">Fecha del trabajo</label>
          <input type="date" name="fecha" class="form-control" value="<%= hoy %>" required>
        </div>
      </div>

      <div class="mt-3">
        <label class="form-label">Trabajo realizado</label>
        <div class="work-options">
          <label class="work-option">
            <input type="radio" name="tipo_trabajo" value="REPARACION" required>
            <span class="work-title">Reparación</span>
            <div class="small-muted">Fuga, compresor, manguera, eléctrico.</div>
          </label>
          <label class="work-option">
            <input type="radio" name="tipo_trabajo" value="CARGA" required>
            <span class="work-title">Carga</span>
            <div class="small-muted">Carga de gas o revisión de presión.</div>
          </label>
          <label class="work-option">
            <input type="radio" name="tipo_trabajo" value="MANTENIMIENTO" required>
            <span class="work-title">Mantenimiento</span>
            <div class="small-muted">Limpieza, revisión y servicio preventivo.</div>
          </label>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-12 col-md-6">
          <label class="form-label">Quién lo hizo</label>
          <input list="mecanicosAire" name="realizado_por" class="form-control" placeholder="Nombre del mecánico o proveedor" required>
          <datalist id="mecanicosAire">
            <% mecanicos.forEach(m => { %>
              <option value="<%= m.nombre %>"></option>
            <% }) %>
          </datalist>
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label">Próximo mantenimiento</label>
          <input type="date" name="proximo_mantenimiento" class="form-control">
        </div>
        <div class="col-12">
          <label class="form-label">Observaciones</label>
          <textarea name="observaciones" class="form-control" rows="4" placeholder="Detalle del trabajo, repuestos, falla encontrada..."></textarea>
        </div>
      </div>

      <div class="sticky-actions mt-4">
        <div class="d-flex gap-2 justify-content-end flex-wrap">
          <a href="/aires" class="btn btn-outline-secondary action-btn">Cancelar</a>
          <button class="btn btn-success action-btn"><i class="bi bi-check-circle"></i> Guardar registro</button>
        </div>
      </div>
    </form>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
