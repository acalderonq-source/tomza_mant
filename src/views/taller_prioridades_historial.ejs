<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Historial de prioridades - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --blue: #07358f;
      --dark: #07183d;
      --green: #0f766e;
      --red: #e2232a;
      --muted: #5d6b85;
      --line: #d7e1ef;
      --soft: #f4f7fb;
    }
    body {
      background: linear-gradient(135deg, #eef4fb 0%, #dfe9f7 100%);
      color: var(--dark);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .92rem;
    }
    .navbar {
      background: linear-gradient(120deg, #061638 0%, #07358f 62%, #e2232a 62%, #ffd400 72%, #374151 72%);
      border-bottom: 3px solid #ffd400;
    }
    .shell { max-width: 1320px; }
    .hero,
    .card-soft {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      box-shadow: 0 12px 26px rgba(7, 24, 61, .08);
    }
    .hero {
      padding: 1rem;
    }
    .page-title {
      font-size: 1.45rem;
      font-weight: 950;
      margin: 0;
    }
    .page-copy,
    .muted {
      color: var(--muted);
    }
    .kpi-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .kpi-card {
      background: #fff;
      border: 1px solid var(--line);
      border-left: 5px solid var(--blue);
      border-radius: 10px;
      padding: .9rem;
    }
    .kpi-card.green { border-left-color: var(--green); }
    .kpi-card.red { border-left-color: var(--red); }
    .kpi-label {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 900;
      text-transform: uppercase;
    }
    .kpi-value {
      font-size: 1.45rem;
      font-weight: 950;
      line-height: 1;
    }
    .filters {
      padding: .85rem;
    }
    .history-card {
      background: #fff;
      border: 1px solid var(--line);
      border-left: 5px solid var(--green);
      border-radius: 10px;
      margin-bottom: .75rem;
      overflow: hidden;
    }
    .history-summary {
      cursor: pointer;
      display: grid;
      gap: .75rem;
      grid-template-columns: minmax(120px, 160px) minmax(0, 1fr) auto;
      list-style: none;
      padding: .85rem 1rem;
    }
    .history-summary::-webkit-details-marker { display: none; }
    .plate {
      color: #001f52;
      font-size: 1.2rem;
      font-weight: 950;
    }
    .badge-days {
      background: #e0f2fe;
      border-radius: 999px;
      color: #075985;
      display: inline-block;
      font-weight: 950;
      padding: .35rem .6rem;
      white-space: nowrap;
    }
    .history-body {
      background: var(--soft);
      border-top: 1px solid var(--line);
      padding: .85rem 1rem 1rem;
    }
    .section-title {
      color: var(--blue);
      font-size: .86rem;
      font-weight: 950;
      margin: .15rem 0 .55rem;
      text-transform: uppercase;
    }
    .mini-table {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }
    .mini-table table {
      margin: 0;
    }
    .mini-table th {
      background: #eaf1fb;
      color: #1f365c;
      font-size: .72rem;
      text-transform: uppercase;
    }
    .mini-table td {
      vertical-align: top;
    }
    .empty-state {
      color: var(--muted);
      font-weight: 800;
      padding: 1.25rem;
      text-align: center;
    }
    @media (max-width: 860px) {
      .kpi-grid,
      .history-summary {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(historiales) ? historiales : [];
  const stats = resumen || {};
  const filtrosActuales = filtros || {};
  const promedioDias = Number(stats.salidas || 0) ? Number(stats.dias || 0) / Number(stats.salidas || 1) : 0;
  const estadoRepuesto = typeof etiquetaEstadoRepuesto === 'function' ? etiquetaEstadoRepuesto : (estado) => estado || '-';
%>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-bold"><i class="bi bi-clock-history me-1"></i> Historial de prioridades</span>
  <div class="d-flex gap-2">
    <a href="/taller/dashboard" class="btn btn-outline-light btn-sm">Dashboard taller</a>
    <a href="/dashboard" class="btn btn-warning btn-sm">Inicio</a>
  </div>
</nav>

<main class="container-fluid shell py-3">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Salidas de taller</h1>
        <div class="page-copy">Cada prioridad cerrada muestra cuántos días estuvo activa y qué trabajos o repuestos se movieron para esa placa.</div>
      </div>
      <div class="text-end">
        <div class="kpi-label">Usuario</div>
        <div class="fw-bold"><%= user.usuario %> (<%= user.rol %>)</div>
      </div>
    </div>
  </section>

  <section class="kpi-grid mb-3">
    <div class="kpi-card">
      <div class="kpi-label">Salidas registradas</div>
      <div class="kpi-value"><%= Number(stats.salidas || 0).toLocaleString('es-CR') %></div>
    </div>
    <div class="kpi-card green">
      <div class="kpi-label">Promedio en taller</div>
      <div class="kpi-value"><%= promedioDias.toLocaleString('es-CR', { maximumFractionDigits: 1 }) %></div>
      <div class="muted small">día(s) por salida</div>
    </div>
    <div class="kpi-card red">
      <div class="kpi-label">Mantenimientos ligados</div>
      <div class="kpi-value"><%= Number(stats.mantenimientos || 0).toLocaleString('es-CR') %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Repuestos ligados</div>
      <div class="kpi-value"><%= Number(stats.repuestos || 0).toLocaleString('es-CR') %></div>
    </div>
  </section>

  <section class="card-soft filters mb-3">
    <form method="GET" action="/taller/prioridades-historial" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small fw-bold">Placa</label>
        <input type="text" name="placa" class="form-control text-uppercase" value="<%= filtrosActuales.placa || '' %>" placeholder="Buscar placa">
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-bold">Salida desde</label>
        <input type="date" name="fecha_desde" class="form-control" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-bold">Salida hasta</label>
        <input type="date" name="fecha_hasta" class="form-control" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-fill"><i class="bi bi-search"></i> Filtrar</button>
        <a href="/taller/prioridades-historial" class="btn btn-outline-secondary">Limpiar</a>
      </div>
    </form>
  </section>

  <% if (!lista.length) { %>
    <section class="card-soft empty-state">Todavía no hay prioridades cerradas con esos filtros.</section>
  <% } else { %>
    <% lista.forEach((item, index) => { %>
      <details class="history-card" <%= index === 0 ? 'open' : '' %>>
        <summary class="history-summary">
          <div>
            <div class="plate"><%= item.placa %></div>
            <div class="muted"><%= item.sede || 'Sin sede' %></div>
          </div>
          <div>
            <div class="fw-bold"><%= item.observacion %></div>
            <div class="muted small">
              Entrada: <%= item.entrada_formato || '-' %> · Salida: <%= item.salida_formato || '-' %> · Cerrado por <%= item.atendido_por_nombre || 'Taller' %>
            </div>
          </div>
          <div class="text-end">
            <span class="badge-days"><%= Number(item.dias_taller || 1).toLocaleString('es-CR') %> día(s)</span>
            <div class="muted small mt-1"><%= item.mantenimientos.length %> trabajo(s) · <%= item.repuestos.length %> repuesto(s)</div>
          </div>
        </summary>

        <div class="history-body">
          <div class="row g-3">
            <div class="col-lg-7">
              <h2 class="section-title">Mantenimientos realizados en ese tiempo</h2>
              <% if (!item.mantenimientos.length) { %>
                <div class="mini-table empty-state">No hay mantenimientos registrados para esa placa dentro del rango.</div>
              <% } else { %>
                <div class="mini-table table-responsive">
                  <table class="table table-sm table-bordered">
                    <thead>
                      <tr>
                        <th>Fecha</th>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Detalle</th>
                        <th>Mecánicos</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% item.mantenimientos.forEach(m => { %>
                        <tr>
                          <td><%= m.fecha_formato || '-' %></td>
                          <td>
                            <%= m.numero || '-' %>
                            <% if (Number(m.registros_agrupados || 0) > 1) { %>
                              <div class="muted small"><%= Number(m.registros_agrupados).toLocaleString('es-CR') %> registros agrupados</div>
                            <% } %>
                          </td>
                          <td><span class="badge text-bg-dark"><%= m.tipo || '-' %></span></td>
                          <td>
                            <div><%= m.detalle || '-' %></div>
                            <% if (m.pendiente) { %>
                              <div class="text-danger small fw-bold">Pendiente: <%= m.pendiente %></div>
                            <% } %>
                          </td>
                          <td><%= m.mecanicos || '-' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>

            <div class="col-lg-5">
              <h2 class="section-title">Repuestos solicitados en ese tiempo</h2>
              <% if (!item.repuestos.length) { %>
                <div class="mini-table empty-state">No hay repuestos solicitados para esa placa dentro del rango.</div>
              <% } else { %>
                <div class="mini-table table-responsive">
                  <table class="table table-sm table-bordered">
                    <thead>
                      <tr>
                        <th>Fecha</th>
                        <th>Repuesto</th>
                        <th>Cant.</th>
                        <th>Estado</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% item.repuestos.forEach(r => { %>
                        <tr>
                          <td><%= r.fecha_formato || '-' %></td>
                          <td>
                            <div class="fw-bold"><%= r.repuesto_solicitado || '-' %></div>
                            <div class="muted small"><%= r.proveedor || 'Sin proveedor' %></div>
                            <% if (Number(r.registros_agrupados || 0) > 1) { %>
                              <div class="muted small"><%= Number(r.registros_agrupados).toLocaleString('es-CR') %> registros agrupados</div>
                            <% } %>
                          </td>
                          <td><%= Number(r.cantidad || 0).toLocaleString('es-CR') %></td>
                          <td><%= estadoRepuesto(r.estado) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </details>
    <% }) %>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
