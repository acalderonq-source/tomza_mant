<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Gas Tomza</span>
  <a href="/logout" class="btn btn-warning btn-sm">Salir</a>
</nav>

<div class="container mt-4">

 <!-- ================== SELECTOR DE SEDE ADMIN ================== -->
<% if (user.rol === 'ADMIN') { %>

<div class="mb-3">

  <span class="me-2 fw-bold">
    Sede actual:
    <%= sedeSeleccionada || user.sede || 'TODAS' %>
  </span>

  <!-- CARTAGO -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-primary" name="sede" value="Cartago">
      Cartago
    </button>
  </form>

  <!-- GUAPILES -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-primary" name="sede" value="Guapiles">
      Guápiles
    </button>
  </form>

  <!-- LA CRUZ -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-success" name="sede" value="La Cruz">
      La Cruz
    </button>
  </form>

  <!-- ALAJUELA -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-success" name="sede" value="Alajuela">
      Alajuela
    </button>
  </form>

  <!-- SAN CARLOS -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-warning text-dark" name="sede" value="San Carlos">
      San Carlos
    </button>
  </form>

  <!-- RIO CLARO -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-secondary" name="sede" value="Rio Claro">
      Río Claro
    </button>
  </form>

  <!-- PEREZ ZELEDON -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-info text-white" name="sede" value="Perez Zeledon">
      Pérez Zeledón
    </button>
  </form>

  <!-- NICOYA -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-danger" name="sede" value="Nicoya">
      Nicoya
    </button>
  </form>

  <!-- TECNICOS -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-dark" name="sede" value="Tecnicos">
      Técnicos
    </button>
  </form>

  <!-- TALLER -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-outline-dark" name="sede" value="Taller">
      Taller
    </button>
  </form>

  <!-- TRANSPORTADORA -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-outline-primary" name="sede" value="Transportadora">
      Transportadora
    </button>
  </form>

  <!-- GRANEL -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-outline-success" name="sede" value="Granel">
      Granel
    </button>
  </form>

  <!-- TODAS -->
  <form method="POST" action="/cambiar-sede" class="d-inline">
    <button class="btn btn-sm btn-dark" name="sede" value="TODAS">
      Todo
    </button>
  </form>

</div>

<% } %>