<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Gas Tomza</span>
  <a href="/logout" class="btn btn-warning btn-sm">Salir</a>
</nav>

<div class="container mt-4">

  <!-- ================== SELECTOR ADMIN ================== -->

<% if (user.rol === 'ADMIN') { %>

<div class="mb-3">

  <span class="me-2 fw-bold">
    Sede actual:
    <%= sedeSeleccionada || user.sede || 'TODAS' %>
  </span>

  <% [
    'Cartago',
    'Guapiles',
    'La Cruz',
    'Alajuela',
    'San Carlos',
    'Rio Claro',
    'Perez Zeledon',
    'Nicoya',
    'Tecnicos',
    'Taller',
    'Transportadora',
    'Granel'
  ].forEach(sede => { %>

    <form method="POST" action="/cambiar-sede" class="d-inline">

      <button
        class="btn btn-sm btn-outline-primary"
        name="sede"
        value="<%= sede %>">

        <%= sede %>

      </button>

    </form>

  <% }) %>

  <form method="POST" action="/cambiar-sede" class="d-inline">

    <button
      class="btn btn-sm btn-dark"
      name="sede"
      value="TODAS">

      TODAS

    </button>

  </form>

</div>

<% } %>


<!-- ================== MULTI-SEDE ================== -->

<% if (
  user.rol !== 'ADMIN' &&
  sedesMultiples &&
  sedesMultiples.length > 1
) { %>

<div class="mb-3">

  <span class="badge bg-secondary me-2">

    Vista actual:
    <%= sedeSeleccionada || sedesMultiples[0] %>

  </span>

  <% sedesMultiples.forEach(sede => { %>

    <form method="POST" action="/cambiar-sede" class="d-inline">

      <button
        class="btn btn-sm btn-outline-primary"
        name="sede"
        value="<%= sede %>">

        <%= sede %>

      </button>

    </form>

  <% }) %>

</div>

<% } %>
  <!-- ================== BIENVENIDA ================== -->
  <h3>Bienvenido, <strong><%= user.usuario %></strong></h3>
  <p>Rol: <strong><%= user.rol %></strong></p>

  <hr>

  <!-- ================== BOTONES PRINCIPALES ================== -->
  <div class="d-grid gap-2 col-md-4">

    <a href="/mantenimientos" class="btn btn-primary">
      🔧 Ir a mantenimientos
    </a>

    <a href="/agenda" class="btn btn-secondary">
      📅 Ir a agenda
    </a>

    <a href="/unidades" class="btn btn-info text-white">
      🚛 Ir a unidades
    </a>

    <% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
      <a href="/aceite" class="btn btn-success">
        🛢️ Cambios de Aceite
      </a>
    <% } %>

    <% if (user.rol === 'ADMIN') { %>
      <a href="/kpis/mecanicos" class="btn btn-dark">
        📊 KPIs Mecánicos
      </a>
    <% } %>
    
      <a href="/dekra" class="btn w-100 mb-2" style="background:#8e44ad; color:white;">
  📋 Control DEKRA
</a>
  </div>

</div>

</body>
</html>