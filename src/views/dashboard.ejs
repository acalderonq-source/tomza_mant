<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Gas Tomza</span>
  <a href="/logout" class="btn btn-warning btn-sm">Salir</a>
</nav>

<div class="container mt-4">

  <!-- Selector de sede solo para ADMIN, pequeño y arriba -->
  <% if (user.rol === 'ADMIN') { %>
    <div class="mb-3">
      <form method="POST" action="/cambiar-sede" style="display:inline;">
        <button class="btn btn-sm btn-primary" name="sede" value="Cartago">Cartago</button>
      </form>

      <form method="POST" action="/cambiar-sede" style="display:inline;">
        <button class="btn btn-sm btn-success" name="sede" value="La Cruz">La Cruz</button>
      </form>

      <form method="POST" action="/cambiar-sede" style="display:inline;">
        <button class="btn btn-sm btn-dark" name="sede" value="">Todo</button>
      </form>
    </div>
  <% } %>
<% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
  <a href="/aceite" class="btn btn-success">
    🛢️ Cambios de Aceite
  </a>
<% } %>

  <!-- MISMO DASHBOARD DE ANTES -->
  <h3>Bienvenido, <strong><%= user.usuario %></strong></h3>
  <p>Rol: <strong><%= user.rol %></strong></p>

  <hr>

  <div class="d-grid gap-2 col-4">

    <a href="/mantenimientos" class="btn btn-primary">
      Ir a mantenimientos
    </a>

    <a href="/agenda" class="btn btn-secondary">
      Ir a agenda
    </a>

    <a href="/unidades" class="btn btn-info text-white">
      Ir a unidades
    </a>

    <% if (user.rol === 'ADMIN') { %>
      <a href="/kpis/mecanicos" class="btn btn-dark">
        📊 Ver KPIs de Mecánicos
      </a>
    <% } %>

  </div>

</div>

</body>
</html>
