<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .card-stats { border-radius: 12px; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .stat-number { font-size: 2.2rem; font-weight: bold; }
  </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Gas Tomza</span>
  <a href="/logout" class="btn btn-warning btn-sm">Salir</a>
</nav>

<div class="container mt-4">

  <!-- ================== SELECTOR DE SEDE (solo ADMIN) ================== -->
  <% if (user.rol === 'ADMIN') { %>
    <div class="mb-3">
      <span class="me-2 fw-bold">Sede actual: <%= sedeSeleccionada || user.sede || 'TODAS' %></span>
      <% ['Cartago', 'Guapiles', 'La Cruz', 'Alajuela', 'San Carlos', 'Rio Claro', 'Perez Zeledon', 'Nicoya', 'Tecnicos', 'Taller', 'Transportadora', 'Granel'].forEach(sede => { %>
        <form method="POST" action="/cambiar-sede" class="d-inline">
          <button class="btn btn-sm btn-outline-primary" name="sede" value="<%= sede %>"><%= sede %></button>
        </form>
      <% }) %>
      <form method="POST" action="/cambiar-sede" class="d-inline">
        <button class="btn btn-sm btn-dark" name="sede" value="TODAS">TODAS</button>
      </form>
    </div>
  <% } %>

  <!-- ================== SELECTOR MULTI-SEDE (usuarios con varias sedes) ================== -->
  <% if (user.rol !== 'ADMIN' && sedesMultiples && sedesMultiples.length > 1) { %>
    <div class="mb-3">
      <span class="badge bg-secondary me-2">Vista actual: <%= sedeSeleccionada || sedesMultiples[0] %></span>
      <% sedesMultiples.forEach(sede => { %>
        <form method="POST" action="/cambiar-sede" class="d-inline">
          <button class="btn btn-sm btn-outline-primary" name="sede" value="<%= sede %>"><%= sede %></button>
        </form>
      <% }) %>
    </div>
  <% } %>

  <!-- ================== BIENVENIDA ================== -->
  <h3>Bienvenido, <strong><%= user.usuario %></strong></h3>
  <p>Rol: <strong><%= user.rol %></strong></p>
  <hr>

  <!-- ================== CONTENIDO SEGÚN ROL ================== -->

  <% if (user.rol === 'TRAMITES') { %>
    <!-- DASHBOARD PARA TRAMITES: estadísticas y opciones MINAE -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card card-stats bg-primary text-white">
          <div class="card-body">
            <h5 class="card-title">📋 Trámites pendientes</h5>
            <p class="stat-number"><%= totalPendientes %></p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card card-stats bg-warning text-dark">
          <div class="card-body">
            <h5 class="card-title">⚠️ Por vencer (15 días)</h5>
            <p class="stat-number"><%= porVencer %></p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card card-stats bg-info text-white">
          <div class="card-body">
            <h5 class="card-title">📅 Citas próximas</h5>
            <p class="stat-number"><%= citasProximas.length %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Botones principales para trámites -->
    <div class="d-grid gap-2 col-md-4 mb-4">
      <a href="/minae" class="btn btn-warning">🏛️ Control MINAE</a>
      <a href="/minae/nuevo" class="btn btn-success">➕ Nuevo trámite</a>
    </div>

    <!-- Tabla de citas próximas -->
    <div class="card mt-4">
      <div class="card-header bg-dark text-white">📅 Próximas citas MINAE</div>
      <div class="card-body">
        <table class="table table-sm table-striped">
          <thead>
            <tr><th>Placa</th><th>CR#</th><th>Fecha cita</th><th>Lugar</th></tr>
          </thead>
          <tbody>
            <% citasProximas.forEach(c => { %>
              <tr>
                <td><%= c.placa %></td>
                <td><%= c.cr || '-' %></td>
                <td><%= c.fecha_cita %></td>
                <td><%= c.lugar_cita || '-' %></td>
              </tr>
            <% }); %>
            <% if (citasProximas.length === 0) { %>
              <tr><td colspan="4" class="text-center">No hay citas próximas</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tabla de últimos trámites -->
    <div class="card mt-4">
      <div class="card-header bg-dark text-white">🕒 Últimos trámites ingresados</div>
      <div class="card-body">
        <table class="table table-sm table-striped">
          <thead><tr><th>Placa</th><th>CR#</th><th>Estado</th></tr></thead>
          <tbody>
            <% ultimosTramites.forEach(t => { %>
              <tr>
                <td><%= t.placa %></td>
                <td><%= t.cr || '-' %></td>
                <td><%= t.estado %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  <% } else { %>
    <!-- DASHBOARD PARA ADMIN, MECANICO, TALLER (contenido original) -->

    <!-- KPIs de mantenimientos -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="card text-white bg-success">
          <div class="card-body">
            <h5 class="card-title">✅ Mantenimientos realizados</h5>
            <p class="card-text display-4"><%= stats.realizados %></p>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card text-white bg-danger">
          <div class="card-body">
            <h5 class="card-title">⏳ Mantenimientos pendientes</h5>
            <p class="card-text display-4"><%= stats.pendientes %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Lista de mantenimientos de hoy -->
    <div class="card mb-4">
      <div class="card-header bg-dark text-white">🔧 Mantenimientos programados para hoy</div>
      <div class="card-body">
        <% if (hoy.length === 0) { %>
          <p class="text-muted">No hay mantenimientos programados para hoy.</p>
        <% } else { %>
          <table class="table table-sm">
            <thead><tr><th>Placa</th><th>Sede</th><th>Tipo</th><th>Estado</th><th>Plan</th></tr></thead>
            <tbody>
              <% hoy.forEach(m => { %>
                <tr>
                  <td><%= m.placa %></td>
                  <td><%= m.sede %></td>
                  <td><%= m.tipo %></td>
                  <td><%= m.estado %></td>
                  <td><%= m.plan || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <!-- Botones de acceso a módulos -->
    <div class="d-grid gap-2 col-md-4">
      <a href="/mantenimientos" class="btn btn-primary">🔧 Ir a mantenimientos</a>
      <a href="/agenda" class="btn btn-secondary">📅 Ir a agenda</a>
      <a href="/unidades" class="btn btn-info text-white">🚛 Ir a unidades</a>
      <% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
        <a href="/aceite" class="btn btn-success">🛢️ Cambios de Aceite</a>
      <% } %>
      <% if (user.rol === 'ADMIN') { %>
        <a href="/kpis/mecanicos" class="btn btn-dark">📊 KPIs Mecánicos</a>
      <% } %>
      <a href="/dekra" class="btn" style="background:#8e44ad; color:white;">📋 Control DEKRA</a>
      <a href="/minae" class="btn btn-warning">🏛️ Control MINAE</a>
    </div>

  <% } %>

</div>

</body>
</html>