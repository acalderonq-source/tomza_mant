<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Dashboard - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('partials/dashboard_styles') %>
  <link rel="stylesheet" href="/css/taller-empresa.css">
  <script src="/js/taller-empresa.js" defer></script>
<% if(user.rol === "CONTABILIDAD" || (user.rol === "ADMIN" && user.departamentoActivo === "CONTABILIDAD")){ %><link href="/css/contabilidad-erp.css" rel="stylesheet"><link href="/css/contabilidad-taller.css" rel="stylesheet"><script src="/js/contabilidad-erp.js" defer></script><% } %></head>
<body class="<%= user.rol === "CONTABILIDAD" || (user.rol === "ADMIN" && user.departamentoActivo === "CONTABILIDAD") ? "erp-accounting" : (user.departamentoActivo || 'TALLER') === 'TALLER' ? 'taller-empresa' : '' %>">

<%
  const safeStats = stats || {};
  const exec = ejecutivo || {};
  const mantenimientosHoy = Array.isArray(hoy) ? hoy : [];
  const mostrarOficinaDiaDia = typeof puedeVerOficinaDiaDia !== 'undefined'
    ? puedeVerOficinaDiaDia
    : ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
  const sedeActual = sedeSeleccionada || user.sede || 'TODAS';
  const mostrarSede = typeof etiquetaSede === 'function' ? etiquetaSede : (sede) => sede;
  const rolesTodasSedes = ['ADMIN', 'TALLER', 'TRAMITES', 'PROVEEDURIA', 'PROVEEDURIA_TALLER'];
  const usuarioTodasSedes = rolesTodasSedes.includes(user.rol);
  const usuarioPesadosDashboard = typeof usuarioPesados !== 'undefined'
    ? usuarioPesados
    : user.rol === 'SUPERVISOR_PESADO' || String(user.usuario || '').trim().toLowerCase() === 'pesados';
  const puedeSeleccionarTodas = usuarioTodasSedes || usuarioPesadosDashboard;
  const sedes = usuarioTodasSedes
    ? (Array.isArray(sedesDashboard) ? sedesDashboard : [])
    : (Array.isArray(sedesMultiples) ? sedesMultiples : []);
  const money = (value) => Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 });
  const esMensajeroDashboard = ['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol);
  const esBodegaDashboard = ['BODEGA', 'BODEGUERO'].includes(user.rol);
  const sedeActualVista = esBodegaDashboard ? 'TODAS' : sedeActual;
  const usuarioDashboardLower = String(user.usuario || '').trim().toLowerCase();
  const departamentoActivo = user.departamentoActivo || 'TALLER';
  const esAdminDashboard = user.rol === 'ADMIN';
  const areaTaller = departamentoActivo === 'TALLER' || user.rol === 'PROVEEDURIA_TALLER';
  const adminEnTaller = esAdminDashboard && areaTaller;
  const areaOperaciones = departamentoActivo === 'OPERACIONES' || adminEnTaller || (!esAdminDashboard && ['SUPERVISOR', 'SUPERVISOR_PESADO', 'TRAMITES'].includes(user.rol));
  const areaContabilidad = departamentoActivo === 'CONTABILIDAD' || adminEnTaller || (!esAdminDashboard && user.rol === 'CONTABILIDAD');
  const areaProveeduria = departamentoActivo === 'PROVEEDURIA' || adminEnTaller || (!esAdminDashboard && ['TALLER', 'PROVEEDURIA', 'PROVEEDURIA_TALLER', 'BODEGA', 'BODEGUERO'].includes(user.rol));
  const esMecanicoLimitado = user.rol === 'MECANICO';
  const puedeVerCompras = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'CONTABILIDAD'].includes(user.rol) && (areaContabilidad || areaProveeduria);
  const puedeVerOrdenesCompra = (puedeVerCompras || user.rol === 'BODEGUERO') && (areaContabilidad || areaProveeduria);
  const puedeVerOperaciones = user.rol !== 'CONTABILIDAD' && !esMensajeroDashboard && !esBodegaDashboard && areaTaller;
  const puedeVerReportesSupervisores = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol) && (esAdminDashboard ? areaOperaciones : (areaTaller || areaOperaciones));
  const puedeVerAceite = (esMecanicoLimitado || ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'MECANICO', 'BODEGA', 'BODEGUERO'].includes(user.rol)
    || usuarioDashboardLower === 'supervisor_rio_claro') && (areaTaller || areaProveeduria);
  const puedeVerControlCambiosAceite = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol) && areaTaller;
  const puedeVerAires = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'MECANICO'].includes(user.rol) && areaTaller;
  const puedeVerRevisionRuta = (esMecanicoLimitado || ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol)) && (esAdminDashboard ? areaOperaciones : (areaTaller || areaOperaciones));
  const puedeVerGiras = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol) && (esAdminDashboard ? areaOperaciones : (areaTaller || areaOperaciones));
  const puedeVerDashboardTaller = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol) && areaTaller;
  const puedeVerLogisticaTaller = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'MECANICO', 'PROVEEDURIA_TALLER'].includes(user.rol) && areaTaller;
  const puedeVerLavadoUnidades = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol) && (esAdminDashboard ? areaOperaciones : (areaTaller || areaOperaciones));
  const puedeVerKpisMecanicos = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol) && areaTaller;
  const puedeVerOrdenesMotor = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol) && areaTaller;
  const puedeVerResumenEjecutivo = !esMecanicoLimitado && areaTaller && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
  const puedeVerRepuestos = !esMecanicoLimitado && (
    ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'PROVEEDURIA', 'SUPERVISOR_PESADO', 'BODEGUERO', 'BODEGA', 'MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol)
    || usuarioDashboardLower === 'pesados'
  ) && (esAdminDashboard ? (areaTaller || areaProveeduria) : (areaTaller || areaProveeduria || areaOperaciones));
  const puedeVerRepuestosSemanales = (puedeVerRepuestos && user.rol !== 'BODEGA') || user.rol === 'BODEGUERO';
  const puedeVerBodega = !esMecanicoLimitado && ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'BODEGA', 'BODEGUERO'].includes(user.rol) && (areaTaller || areaProveeduria);
  const prioridadesLista = Array.isArray(prioridadesTaller) ? prioridadesTaller : [];
  const llantasEnProceso = Number(exec.llantasSolicitadas || 0) + Number(exec.llantasCotizadas || 0) + Number(exec.llantasCompradas || 0);
  const unidadesActivas = Number(exec.unidadesActivas ?? exec.unidades ?? 0);
  const unidadesVaradas = Number(exec.unidadesVaradas || 0);
  const mantenimientosPendientes = Number(safeStats.pendientes || 0);
  const mantenimientosAtrasados = Number(exec.mantenimientosVencidos || 0);
  const facturasPendientes = Number(exec.facturasPendientes || 0);
  const facturasVencidas = Number(exec.facturasVencidas || 0);
  const fechaHoraCorta = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '-' : date.toLocaleTimeString('es-CR', { hour: '2-digit', minute: '2-digit' });
  };
  const renderPlanHtml = (value) => {
    const raw = String(value || '').trim();
    if (!raw) return '-';
    const openToken = '__PLAN_RED_OPEN__';
    const closeToken = '__PLAN_RED_CLOSE__';
    return raw
      .replace(/<span\s+class=["']plan-red["'][^>]*>/gi, openToken)
      .replace(/<\/span>/gi, closeToken)
      .replace(/<[^>]*>/g, '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replaceAll(openToken, '<span class="plan-red">')
      .replaceAll(closeToken, '</span>')
      .replace(/\n/g, '<br>');
  };
%>

<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><span class="brand-box"><i class="bi bi-house"></i></span>Gas Tomza</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <a href="/inicio" class="btn btn-outline-light btn-sm">Inicio empresarial</a>
    <% if (Array.isArray(user.departamentos) && user.departamentos.length > 1) { %>
      <form method="POST" action="/departamento/activo" class="d-flex align-items-center gap-2">
        <label for="departamento-activo" class="small">Área</label>
        <select id="departamento-activo" name="departamento" class="form-select form-select-sm" onchange="this.form.submit()">
          <% user.departamentos.forEach(key => { const area = ['TALLER','OPERACIONES','CONTABILIDAD','ADMINISTRACION','SEGURIDAD_OCUPACIONAL','LOGISTICA','PROVEEDURIA','RECURSOS_HUMANOS','CARBURACION'].find(item => item === key); const nombres = { TALLER: 'Taller', OPERACIONES: 'Operaciones', CONTABILIDAD: 'Contabilidad', ADMINISTRACION: 'Administración', SEGURIDAD_OCUPACIONAL: 'Seguridad Ocupacional', LOGISTICA: 'Logística', PROVEEDURIA: 'Proveeduría', RECURSOS_HUMANOS: 'Recursos Humanos', CARBURACION: 'Carburación' }; %>
            <option value="<%= area %>" <%= area === departamentoActivo ? 'selected' : '' %>><%= nombres[area] || area %></option>
          <% }) %>
        </select>
      </form>
    <% } %>
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <% if (user.rol === 'ADMIN') { %><a href="/admin/informes-junta" class="btn btn-outline-light btn-sm">Informes de junta · Pruebas</a><a href="/admin/departamentos" class="btn btn-outline-light btn-sm">Accesos por área</a><a href="/admin/carnets-trabajadores" class="btn btn-outline-light btn-sm">Accesos y carnets</a><% } %>
    <% if (typeof puedeVerCarnetsMecanicos !== 'undefined' && puedeVerCarnetsMecanicos) { %><a href="/taller/carnets" class="btn btn-outline-light btn-sm">Carnets de mecánicos</a><% } %>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>
<% if(user.rol === "CONTABILIDAD" || (user.rol === "ADMIN" && user.departamentoActivo === "CONTABILIDAD")){ %><%- include("partials/contabilidad_navegacion") %><% } %>

<main class="container-fluid shell py-3">
  <section class="simple-hero mb-2">
    <% if(user.esPropietarioAdministracion){ %><a class="btn btn-primary mb-2" href="/administracion">Administración · Portal de proveedores</a><% } %>
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Inicio</h1>
        <div class="page-subtitle">Departamento: <strong><%= { TALLER: 'Taller', OPERACIONES: 'Operaciones', CONTABILIDAD: 'Contabilidad', ADMINISTRACION: 'Administración', SEGURIDAD_OCUPACIONAL: 'Seguridad Ocupacional', LOGISTICA: 'Logística', PROVEEDURIA: 'Proveeduría', RECURSOS_HUMANOS: 'Recursos Humanos', CARBURACION: 'Carburación' }[departamentoActivo] || departamentoActivo %></strong> · Sede: <strong><%= sedeActualVista %></strong> · <%= new Date().toLocaleDateString('es-CR') %></div>
      </div>
      <% if (!esMecanicoLimitado && areaTaller && (areaContabilidad || areaProveeduria)) { %>
        <a href="/ia" class="btn btn-dark btn-sm rounded-pill px-3"><i class="bi bi-stars"></i> IA Tomza</a>
      <% } %>
    </div>
  </section>

  <% if (departamentoActivo !== 'SEGURIDAD_OCUPACIONAL') { %>
    <%- include('partials/solicitudes_proveeduria_acceso') %>
  <% } %>
  <% if (!esBodegaDashboard && !esMecanicoLimitado && (usuarioTodasSedes || sedes.length > 1) && sedes.length) { %>
    <section class="plain-card p-2 mb-2">
      <h2 class="section-title">Cambiar sede</h2>
      <div class="sede-selector">
        <% sedes.forEach(sede => { %>
          <form method="POST" action="/cambiar-sede">
            <button class="btn btn-sm <%= sedeActual === sede ? 'btn-dark' : 'btn-outline-primary' %>" name="sede" value="<%= sede %>"><%= mostrarSede(sede) %></button>
          </form>
        <% }) %>
        <% if (puedeSeleccionarTodas) { %>
          <form method="POST" action="/cambiar-sede">
            <button class="btn btn-sm <%= sedeActual === 'TODAS' ? 'btn-dark' : 'btn-outline-dark' %>" name="sede" value="TODAS">TODAS</button>
          </form>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (areaTaller) { %>
  <section class="summary-grid mb-2">
    <% if ((areaTaller || areaOperaciones) && (!esAdminDashboard || areaTaller)) { %>
      <div class="summary-card">
        <div class="summary-label">Mantenimientos</div>
        <div class="summary-value"><%= mantenimientosPendientes %></div>
        <div class="summary-foot"><%= mantenimientosAtrasados %> atrasados · <%= mantenimientosHoy.length %> hoy</div>
      </div>
    <% } %>
      <% if (areaTaller || areaOperaciones) { %>
      <div class="summary-card">
        <div class="summary-label">Unidades</div>
        <div class="summary-value"><%= exec.unidades || 0 %></div>
        <div class="summary-foot"><%= unidadesActivas %> activas · <%= unidadesVaradas %> varadas</div>
      </div>
    <% } %>
    <% if (!esMecanicoLimitado && (areaContabilidad || areaProveeduria)) { %>
      <div class="summary-card">
        <div class="summary-label">Facturas</div>
        <div class="summary-value"><%= facturasPendientes %></div>
        <div class="summary-foot"><%= facturasVencidas %> vencidas · CRC <%= money(exec.montoPendiente) %></div>
      </div>
    <% } %>
      <% if (!esMecanicoLimitado && areaTaller) { %>
      <div class="summary-card">
        <div class="summary-label">Llantas</div>
        <div class="summary-value"><%= llantasEnProceso %></div>
        <div class="summary-foot"><%= exec.llantasCompradas || 0 %> compradas sin recibir</div>
      </div>
    <% } %>
  </section>
  <% } %>

  <% if (puedeVerOperaciones && areaTaller) { %>
    <section class="top-info-grid mb-2">
      <div class="priority-panel">
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
          <h2 class="section-title mb-0"><i class="bi bi-exclamation-octagon text-danger"></i> Prioridades activas de taller</h2>
          <% if (puedeVerDashboardTaller) { %><a href="/taller/dashboard" class="btn btn-sm btn-outline-dark py-0">Abrir panel</a><% } %>
        </div>
        <% if (!prioridadesLista.length) { %>
          <div class="empty-state">No hay prioridades pendientes activas para hoy.</div>
        <% } else { %>
          <div class="priority-list">
            <% prioridadesLista.forEach(p => { %>
              <div class="priority-item">
                <div>
                  <div class="priority-plate"><%= p.placa %></div>
                  <div class="small-muted"><%= p.sede || 'Sin sede' %></div>
                  <% if (user.rol === 'ADMIN' && !Number(p.mostrar_operativos)) { %><span class="badge text-bg-secondary">Solo ADMIN</span><% } %>
                </div>
                <div class="priority-note"><%= p.observacion %></div>
                <div class="priority-meta"><%= Number(p.dias_pendiente || 1) %> día(s)<br><%= p.creado_por_nombre || 'Taller' %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </section>
  <% } %>

  <% if (departamentoActivo === 'SEGURIDAD_OCUPACIONAL') { %>
  <section class="mb-2">
    <h2 class="section-title legacy-modules-title">Módulos</h2>
    <div class="module-grid">
      <a href="/proveeduria/mis-solicitudes" class="module-card">
        <span class="module-icon icon-blue"><i class="bi bi-cart-plus"></i></span>
        <div><div class="module-title">Solicitud de suministros</div><p class="module-copy">Solicite equipo de protección personal, materiales y suministros a Proveeduría. Consulte sus pedidos y confirme la entrega.</p></div>
      </a>
    </div>
  </section>
  <% } %>

  <% if (areaTaller || areaContabilidad || areaProveeduria) { %>
  <section class="mb-2">
    <% if(user.rol === "CONTABILIDAD" || (user.rol === "ADMIN" && departamentoActivo === "CONTABILIDAD")){ %><%- include("partials/contabilidad_inicio") %><% } %>
    <h2 class="section-title legacy-modules-title">Módulos</h2>
    <div class="module-grid">
      <% if (areaTaller && typeof marcasTaller!=='undefined' && (marcasTaller.marcar || marcasTaller.consultar)) { %>
        <a href="/marcas-ingreso" class="module-card"><span class="module-icon icon-green"><i class="bi bi-clock-history"></i></span><div><div class="module-title"><%= marcasTaller.marcar?'Marcas de ingreso':'Historial de marcas' %></div><p class="module-copy"><%= marcasTaller.marcar?'Registrar entrada y salida con foto de camara.':'Consultar entradas, salidas y fotografias.' %></p></div></a>
      <% } %>
      <% if (puedeVerResumenEjecutivo && (areaTaller || areaOperaciones || areaProveeduria)) { %>
        <a href="/dashboard/resumen-ejecutivo" class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-graph-up-arrow"></i></span>
          <div><div class="module-title">Resumen ejecutivo</div><p class="module-copy">Gastos, proveedores, placas y mantenimientos.</p></div>
        </a>
      <% } %>
      <% if (puedeVerOperaciones) { %>
        <% if (!esAdminDashboard || areaTaller) { %><a href="/mantenimientos" class="module-card">
          <span class="module-icon icon-amber"><i class="bi bi-tools"></i></span>
          <div><div class="module-title">Mantenimientos</div><p class="module-copy">Pendientes, correctivos y cierres.</p></div>
        </a><% } %>
        <% if (areaTaller && ['ADMIN','TALLER','PROVEEDURIA_TALLER'].includes(user.rol)) { %>
          <a href="/mantenimientos/semana" class="module-card">
            <span class="module-icon icon-green"><i class="bi bi-calendar-week"></i></span>
            <div><div class="module-title">Preventivos por semana</div><p class="module-copy">Frecuencias automáticas y programación por unidad.</p></div>
          </a>
        <% } %>
        <% if (puedeVerKpisMecanicos) { %>
          <a href="/kpis/mecanicos" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-speedometer2"></i></span>
            <div><div class="module-title">KPIs mecánicos</div><p class="module-copy">Productividad y especialidad por trabajo.</p></div>
          </a>
        <% } %>
        <% if (puedeVerReportesSupervisores) { %>
          <a href="/reportes-supervisores" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-clipboard-pulse"></i></span>
            <div><div class="module-title">Reportes supervisores</div><p class="module-copy">Fallas reportadas por unidad.</p></div>
          </a>
          <% if (['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol) && (!esAdminDashboard || areaOperaciones)) { %>
            <a href="/reportes-supervisores/rutas" class="module-card">
              <span class="module-icon icon-green"><i class="bi bi-signpost-split"></i></span>
              <div><div class="module-title">Rutas y choferes</div><p class="module-copy">Asignación semanal e historial de cambios.</p></div>
            </a>
          <% } %>
        <% } %>
        <% if (!esMecanicoLimitado && (!esAdminDashboard || areaOperaciones)) { %>
          <a href="/unidades" class="module-card">
            <span class="module-icon icon-green"><i class="bi bi-truck-front"></i></span>
            <div><div class="module-title">Unidades</div><p class="module-copy">Activas, inactivas y varadas.</p></div>
          </a>
        <% } %>
        <% if (puedeVerDashboardTaller) { %>
          <a href="/taller/dashboard" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-display"></i></span>
            <div><div class="module-title">Dashboard taller</div><p class="module-copy">Unidades en taller y listas para ruta.</p></div>
          </a>
          <% if (!esMecanicoLimitado) { %>
            <a href="/taller/prioridades-historial" class="module-card">
              <span class="module-icon icon-green"><i class="bi bi-clock-history"></i></span>
              <div><div class="module-title">Historial de prioridades</div><p class="module-copy">Salidas de taller, días, trabajos y repuestos.</p></div>
            </a>
          <% } %>
        <% } %>
        <% if (puedeVerLogisticaTaller) { %>
          <a href="/logistica-taller" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-diagram-3"></i></span>
            <div><div class="module-title">Logística Taller</div><p class="module-copy">Prioridades diarias por correctivo y preventivo.</p></div>
          </a>
        <% } %>
        <% if (puedeVerLavadoUnidades) { %>
          <a href="/lavado-unidades" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-droplet"></i></span>
            <div><div class="module-title">Lavado semanal</div><p class="module-copy">Evidencia fotográfica, cumplimiento y unidades pendientes.</p></div>
          </a>
        <% } %>
        <% if (puedeVerRevisionRuta) { %>
          <a href="/revision-ruta" class="module-card">
            <span class="module-icon icon-green"><i class="bi bi-clipboard-check"></i></span>
            <div><div class="module-title">Salida a ruta</div><p class="module-copy">Revisión diaria de camiones.</p></div>
          </a>
        <% } %>
        <% if (puedeVerGiras) { %>
          <a href="/giras" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-geo-alt"></i></span>
            <div><div class="module-title">Giras de taller</div><p class="module-copy">Inspecciones y observaciones por sede.</p></div>
          </a>
        <% } %>
        <% if (!esMecanicoLimitado && (!esAdminDashboard || areaTaller)) { %>
          <a href="/llantas" class="module-card">
            <span class="module-icon icon-dark"><i class="bi bi-circle"></i></span>
            <div><div class="module-title">Llantas</div><p class="module-copy">Solicitudes, compras y llegadas.</p></div>
          </a>
        <% } %>
        <% if (puedeVerRepuestos) { %>
          <a href="/repuestos" class="module-card">
            <span class="module-icon icon-amber"><i class="bi bi-box-seam"></i></span>
            <div><div class="module-title">Solicitud de repuestos</div><p class="module-copy">Placa, cantidad, estado y proveedor.</p></div>
          </a>
        <% } %>
        <% if (puedeVerRepuestosSemanales) { %>
          <a href="/repuestos-semanales" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-calendar-week"></i></span>
            <div><div class="module-title">Repuestos semanales</div><p class="module-copy">Formato semanal por sede, tipo Excel.</p></div>
          </a>
        <% } %>
        <% if (puedeVerBodega) { %>
          <a href="/bodega" class="module-card">
            <span class="module-icon icon-green"><i class="bi bi-boxes"></i></span>
            <div><div class="module-title">Bodega taller</div><p class="module-copy">Inventario, entregas, entradas y herramientas.</p></div>
          </a>
        <% } %>
        <% if (puedeVerOrdenesMotor) { %>
          <a href="/ordenes-motor" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-gear-wide-connected"></i></span>
            <div><div class="module-title">Órdenes Motor</div><p class="module-copy">Presupuesto separado de compras.</p></div>
          </a>
        <% } %>
        <% if (mostrarOficinaDiaDia && (areaTaller || areaOperaciones) && (!esAdminDashboard || areaTaller)) { %>
          <a href="/oficina-dia-dia" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-person-workspace"></i></span>
            <div><div class="module-title">Oficina día a día</div><p class="module-copy">Registro diario de tareas de oficina.</p></div>
          </a>
        <% } %>
        <% if ((areaOperaciones || areaTaller) && (!esAdminDashboard || areaOperaciones)) { %><a href="/dekra" class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-clipboard-check"></i></span>
          <div><div class="module-title">DEKRA</div><p class="module-copy">Revisión técnica y vencimientos.</p></div>
        </a><% } %>
        <% if (!esMecanicoLimitado && (areaTaller || areaOperaciones)) { %>
          <a href="/minae" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-bank"></i></span>
            <div><div class="module-title">MINAE</div><p class="module-copy">Trámites y permisos.</p></div>
          </a>
        <% } %>
        <% if (puedeVerAceite) { %>
          <a href="/aceite" class="module-card">
            <span class="module-icon icon-amber"><i class="bi bi-droplet-half"></i></span>
            <div><div class="module-title">Aceite</div><p class="module-copy">Estañones, litros por sede y cambios.</p></div>
          </a>
        <% } %>
        <% if (puedeVerControlCambiosAceite) { %>
          <a href="/control-cambios-aceite" class="module-card">
            <span class="module-icon icon-amber"><i class="bi bi-calendar2-check"></i></span>
            <div><div class="module-title">Programación de cambios de aceite</div><p class="module-copy">Proyección y avisos de Transportadora.</p></div>
          </a>
        <% } %>
        <% if (puedeVerAires) { %>
          <a href="/aires" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-snow2"></i></span>
            <div><div class="module-title">Aires acondicionados</div><p class="module-copy">Reparación, carga y mantenimiento.</p></div>
          </a>
        <% } %>
      <% } %>
      <% if (!esMecanicoLimitado && ['ADMIN', 'CONTABILIDAD', 'TRAMITES'].includes(user.rol) && areaContabilidad) { %>
        <a href="/aresep" class="module-card">
          <span class="module-icon icon-green"><i class="bi bi-clipboard-data"></i></span>
          <div><div class="module-title">ARESEP</div><p class="module-copy">Unidades A7, costos, planillas y control mensual.</p></div>
        </a>
      <% } %>
      <% if (puedeVerBodega && !puedeVerOperaciones) { %>
        <a href="/bodega" class="module-card">
          <span class="module-icon icon-green"><i class="bi bi-boxes"></i></span>
          <div><div class="module-title">Bodega taller</div><p class="module-copy">Inventario, entregas, entradas y herramientas.</p></div>
        </a>
      <% } %>
      <% if (puedeVerRepuestosSemanales && !puedeVerOperaciones) { %>
        <a href="/repuestos-semanales" class="module-card">
          <span class="module-icon icon-red"><i class="bi bi-calendar-week"></i></span>
          <div><div class="module-title">Repuestos semanales</div><p class="module-copy">Consultar solicitudes y marcar lo que va llegando.</p></div>
        </a>
      <% } %>
      <% if (puedeVerAceite && !puedeVerOperaciones) { %>
        <a href="/aceite" class="module-card">
          <span class="module-icon icon-amber"><i class="bi bi-droplet-half"></i></span>
          <div><div class="module-title">Aceite</div><p class="module-copy">Estañones, galones por sede y cambios.</p></div>
        </a>
      <% } %>
      <% if (puedeVerRepuestos && !puedeVerOperaciones) { %>
        <a href="/repuestos" class="module-card">
          <span class="module-icon icon-amber"><i class="bi bi-box-seam"></i></span>
          <div><div class="module-title">Solicitud de repuestos</div><p class="module-copy">Ver repuestos y marcar entregas.</p></div>
        </a>
      <% } %>
      <% if (puedeVerOrdenesCompra) { %>
        <a href="/compras/ordenes" class="module-card">
          <span class="module-icon icon-dark"><i class="bi bi-cart-check"></i></span>
          <div><div class="module-title">Órdenes</div><p class="module-copy">Órdenes de compra.</p></div>
        </a>
      <% } %>
      <% if (puedeVerCompras) { %>
        <a href="/compras/facturas" class="module-card">
          <span class="module-icon icon-red"><i class="bi bi-receipt"></i></span>
          <div><div class="module-title">Facturas</div><p class="module-copy">Pendientes, pagos y reportes.</p></div>
        </a>
        <% if (['ADMIN', 'CONTABILIDAD'].includes(user.rol) && areaContabilidad) { %>
          <a href="/proveeduria/portal-proveedores/facturas" class="module-card"><span class="module-icon icon-blue"><i class="bi bi-receipt-cutoff"></i></span><div><div class="module-title">Facturas de proveedores</div><p class="module-copy">Facturas del portal, órdenes vinculadas y cuentas por pagar.</p></div></a>
          <a href="/contabilidad/presupuestos" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-calculator"></i></span>
            <div><div class="module-title">Presupuestos</div><p class="module-copy">Por empresa, sede y departamento. Órdenes, facturas y pagos.</p></div>
          </a>
          <a href="/compras/facturas/asientos" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-journal-check"></i></span>
            <div><div class="module-title">Asientos de pasivos</div><p class="module-copy">Seleccionar facturas, generar el Excel y consultar el historial.</p></div>
          </a>
        <% } %>
          <a href="/compras/dashboard" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-bar-chart"></i></span>
            <div><div class="module-title">Compras</div><p class="module-copy">Resumen del área.</p></div>
          </a>
      <% } %>
      <% if (['LOGISTICA', 'RECURSOS_HUMANOS', 'CARBURACION'].includes(departamentoActivo)) { %>
        <div class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-cone-striped"></i></span>
          <div><div class="module-title">Área en preparación</div><p class="module-copy">El acceso ya está organizado. Los módulos de este departamento se habilitarán conforme se incorporen sus procesos y permisos.</p></div>
        </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (puedeVerOperaciones && areaTaller) { %>
    <section class="plain-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div>
          <h2 class="section-title mb-1">Mantenimientos de hoy</h2>
          <div class="small-muted">Trabajos programados para la sede actual.</div>
        </div>
        <a href="/mantenimientos" class="btn btn-sm btn-outline-dark">Ver todos</a>
      </div>
      <div class="table-responsive">
        <% if (!mantenimientosHoy.length) { %>
          <div class="empty-state">No hay mantenimientos programados para hoy.</div>
        <% } else { %>
          <table class="table table-sm mb-0 align-middle">
            <thead>
              <tr>
                <th>N°</th>
                <th>Placa</th>
                <th>Sede</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Plan</th>
                <th class="text-end">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% mantenimientosHoy.forEach(m => { %>
                <tr>
                  <td><strong><%= m.numero_mantenimiento || ('MANT-' + m.id) %></strong></td>
                  <td><strong><%= m.placa %></strong></td>
                  <td><%= m.sede %></td>
                  <td><%= m.tipo %></td>
                  <td><span class="badge <%= m.estado === 'CERRADO' ? 'text-bg-success' : 'text-bg-warning' %>"><%= m.estado %></span></td>
                  <td><%- renderPlanHtml(m.plan) %></td>
                  <td class="text-end"><a href="/mantenimientos/<%= m.id %>" class="btn btn-sm btn-dark">Abrir</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
