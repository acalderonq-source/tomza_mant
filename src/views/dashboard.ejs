<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Dashboard - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
      --red: #dc2626;
      --blue: #2563eb;
      --green: #16a34a;
      --amber: #d97706;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .92rem;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid var(--red);
    }

    .brand-box {
      align-items: center;
      background: #fff;
      border-radius: 8px;
      color: var(--red);
      display: inline-flex;
      height: 32px;
      justify-content: center;
      margin-right: .45rem;
      width: 32px;
    }

    .shell {
      max-width: 1540px;
    }

    .simple-hero {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: .7rem .85rem;
    }

    .page-title {
      font-size: 1.2rem;
      font-weight: 900;
      margin: 0;
    }

    .page-subtitle,
    .small-muted {
      color: var(--muted);
    }

    .section-title {
      font-size: .9rem;
      font-weight: 900;
      margin: 0 0 .45rem;
    }

    .sede-selector {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }

    .sede-selector .btn {
      border-radius: 999px;
      font-size: .8rem;
      font-weight: 750;
    }

    .summary-grid {
      display: grid;
      gap: .55rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .summary-card,
    .module-card,
    .plain-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .summary-card {
      padding: .65rem .75rem;
    }

    .summary-label {
      color: var(--muted);
      font-size: .68rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .summary-value {
      font-size: 1.35rem;
      font-weight: 900;
      line-height: 1.1;
      margin-top: .1rem;
    }

    .summary-foot {
      color: var(--muted);
      font-size: .74rem;
      margin-top: .15rem;
    }

    .module-grid {
      display: grid;
      gap: .55rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .module-card {
      color: var(--ink);
      display: flex;
      gap: .55rem;
      min-height: 66px;
      padding: .65rem;
      text-decoration: none;
      transition: border-color .12s ease, transform .12s ease;
    }

    .module-card:hover {
      border-color: #94a3b8;
      color: var(--ink);
      transform: translateY(-1px);
    }

    .module-icon {
      align-items: center;
      border-radius: 10px;
      display: inline-flex;
      flex: 0 0 34px;
      font-size: 1rem;
      height: 34px;
      justify-content: center;
      width: 34px;
    }

    .icon-blue { background: #dbeafe; color: #1d4ed8; }
    .icon-green { background: #dcfce7; color: #166534; }
    .icon-amber { background: #fef3c7; color: #92400e; }
    .icon-red { background: #fee2e2; color: #991b1b; }
    .icon-dark { background: #e5e7eb; color: #111827; }

    .module-title {
      font-size: .9rem;
      font-weight: 900;
    }

    .module-copy {
      color: var(--muted);
      font-size: .74rem;
      line-height: 1.2;
      margin: .1rem 0 0;
    }

    .top-info-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: 1fr;
    }

    .priority-panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      min-height: 100%;
      padding: .75rem;
    }

    .priority-list {
      display: grid;
      gap: .45rem;
      max-height: 245px;
      overflow: auto;
      padding-right: .15rem;
    }

    .priority-item {
      align-items: start;
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-left: 5px solid var(--red);
      border-radius: 9px;
      display: grid;
      gap: .4rem;
      grid-template-columns: 110px minmax(0, 1fr) auto;
      padding: .5rem .6rem;
    }

    .priority-plate {
      color: #111827;
      font-size: .95rem;
      font-weight: 900;
      line-height: 1.1;
    }

    .priority-note {
      color: #1f2937;
      font-size: .82rem;
      line-height: 1.25;
    }

    .priority-meta {
      color: var(--muted);
      font-size: .7rem;
      white-space: nowrap;
    }

    .table thead th {
      background: #f8fafc;
      color: #475569;
      font-size: .68rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .table-sm {
      font-size: .82rem;
    }

    .empty-state {
      color: var(--muted);
      font-weight: 700;
      padding: .8rem;
      text-align: center;
    }

    @media (max-width: 1180px) {
      .module-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 960px) {
      .summary-grid,
      .module-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .summary-grid,
      .module-grid,
      .top-info-grid {
        grid-template-columns: 1fr;
      }
      .priority-item {
        grid-template-columns: 1fr;
      }
    }

    .plan-red {
      color: #dc2626;
      font-weight: 900;
    }
  </style>
</head>
<body>
<%
  const safeStats = stats || {};
  const exec = ejecutivo || {};
  const mantenimientosHoy = Array.isArray(hoy) ? hoy : [];
  const mostrarOficinaDiaDia = typeof puedeVerOficinaDiaDia !== 'undefined'
    ? puedeVerOficinaDiaDia
    : ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
  const sedeActual = sedeSeleccionada || user.sede || 'TODAS';
  const mostrarSede = typeof etiquetaSede === 'function' ? etiquetaSede : (sede) => sede;
  const rolesTodasSedes = ['ADMIN', 'TALLER', 'TRAMITES', 'PROVEEDURIA', 'PROVEEDURIA_TALLER'];
  const usuarioTodasSedes = rolesTodasSedes.includes(user.rol);
  const sedes = usuarioTodasSedes
    ? (Array.isArray(sedesDashboard) ? sedesDashboard : [])
    : (Array.isArray(sedesMultiples) ? sedesMultiples : []);
  const money = (value) => Number(value || 0).toLocaleString('es-CR', { maximumFractionDigits: 0 });
  const esMensajeroDashboard = ['MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol);
  const puedeVerCompras = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'CONTABILIDAD'].includes(user.rol);
  const puedeVerOperaciones = user.rol !== 'CONTABILIDAD' && !esMensajeroDashboard;
  const puedeVerReportesSupervisores = ['ADMIN', 'TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol);
  const puedeVerAceite = ['ADMIN', 'MECANICO'].includes(user.rol)
    || String(user.usuario || '').trim().toLowerCase() === 'supervisor_rio_claro';
  const puedeVerAires = ['ADMIN', 'TALLER', 'MECANICO'].includes(user.rol);
  const puedeVerRevisionRuta = ['ADMIN', 'TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol);
  const puedeVerGiras = ['ADMIN', 'TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol);
  const puedeVerDashboardTaller = ['ADMIN', 'TALLER', 'MECANICO', 'SUPERVISOR', 'SUPERVISOR_PESADO'].includes(user.rol);
  const puedeVerKpisMecanicos = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
  const puedeVerOrdenesMotor = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER'].includes(user.rol);
  const puedeVerResumenEjecutivo = ['ADMIN', 'TALLER', 'PROVEEDURIA', 'PROVEEDURIA_TALLER', 'TRAMITES'].includes(user.rol);
  const puedeVerRepuestos = ['ADMIN', 'TALLER', 'PROVEEDURIA_TALLER', 'PROVEEDURIA', 'SUPERVISOR_PESADO', 'MENSAJERO', 'MENSAJERIA', 'MENSAJERO_FACTURAS'].includes(user.rol)
    || String(user.usuario || '').trim().toLowerCase() === 'pesados';
  const prioridadesLista = Array.isArray(prioridadesTaller) ? prioridadesTaller : [];
  const llantasEnProceso = Number(exec.llantasSolicitadas || 0) + Number(exec.llantasCotizadas || 0) + Number(exec.llantasCompradas || 0);
  const unidadesActivas = Number(exec.unidadesActivas ?? exec.unidades ?? 0);
  const unidadesVaradas = Number(exec.unidadesVaradas || 0);
  const mantenimientosPendientes = Number(safeStats.pendientes || 0);
  const mantenimientosAtrasados = Number(exec.mantenimientosVencidos || 0);
  const facturasPendientes = Number(exec.facturasPendientes || 0);
  const facturasVencidas = Number(exec.facturasVencidas || 0);
  const fechaHoraCorta = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '-' : date.toLocaleTimeString('es-CR', { hour: '2-digit', minute: '2-digit' });
  };
  const renderPlanHtml = (value) => {
    const raw = String(value || '').trim();
    if (!raw) return '-';
    const openToken = '__PLAN_RED_OPEN__';
    const closeToken = '__PLAN_RED_CLOSE__';
    return raw
      .replace(/<span\s+class=["']plan-red["'][^>]*>/gi, openToken)
      .replace(/<\/span>/gi, closeToken)
      .replace(/<[^>]*>/g, '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replaceAll(openToken, '<span class="plan-red">')
      .replaceAll(closeToken, '</span>')
      .replace(/\n/g, '<br>');
  };
%>

<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><span class="brand-box"><i class="bi bi-house"></i></span>Gas Tomza</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>

<main class="container-fluid shell py-3">
  <section class="simple-hero mb-2">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Inicio</h1>
        <div class="page-subtitle">Sede actual: <strong><%= sedeActual %></strong> · <%= new Date().toLocaleDateString('es-CR') %></div>
      </div>
      <a href="/ia" class="btn btn-dark btn-sm rounded-pill px-3"><i class="bi bi-stars"></i> IA Tomza</a>
    </div>
  </section>

  <% if ((usuarioTodasSedes || sedes.length > 1) && sedes.length) { %>
    <section class="plain-card p-2 mb-2">
      <h2 class="section-title">Cambiar sede</h2>
      <div class="sede-selector">
        <% sedes.forEach(sede => { %>
          <form method="POST" action="/cambiar-sede">
            <button class="btn btn-sm <%= sedeActual === sede ? 'btn-dark' : 'btn-outline-primary' %>" name="sede" value="<%= sede %>"><%= mostrarSede(sede) %></button>
          </form>
        <% }) %>
        <% if (usuarioTodasSedes) { %>
          <form method="POST" action="/cambiar-sede">
            <button class="btn btn-sm <%= sedeActual === 'TODAS' ? 'btn-dark' : 'btn-outline-dark' %>" name="sede" value="TODAS">TODAS</button>
          </form>
        <% } %>
      </div>
    </section>
  <% } %>

  <section class="summary-grid mb-2">
    <div class="summary-card">
      <div class="summary-label">Mantenimientos</div>
      <div class="summary-value"><%= mantenimientosPendientes %></div>
      <div class="summary-foot"><%= mantenimientosAtrasados %> atrasados · <%= mantenimientosHoy.length %> hoy</div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Unidades</div>
      <div class="summary-value"><%= exec.unidades || 0 %></div>
      <div class="summary-foot"><%= unidadesActivas %> activas · <%= unidadesVaradas %> varadas</div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Facturas</div>
      <div class="summary-value"><%= facturasPendientes %></div>
      <div class="summary-foot"><%= facturasVencidas %> vencidas · CRC <%= money(exec.montoPendiente) %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Llantas</div>
      <div class="summary-value"><%= llantasEnProceso %></div>
      <div class="summary-foot"><%= exec.llantasCompradas || 0 %> compradas sin recibir</div>
    </div>
  </section>

  <% if (puedeVerOperaciones) { %>
    <section class="top-info-grid mb-2">
      <div class="priority-panel">
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
          <h2 class="section-title mb-0"><i class="bi bi-exclamation-octagon text-danger"></i> Prioridades de taller</h2>
          <a href="/taller/dashboard" class="btn btn-sm btn-outline-dark py-0">Abrir panel</a>
        </div>
        <% if (!prioridadesLista.length) { %>
          <div class="empty-state">No hay prioridades pendientes de hoy.</div>
        <% } else { %>
          <div class="priority-list">
            <% prioridadesLista.forEach(p => { %>
              <div class="priority-item">
                <div>
                  <div class="priority-plate"><%= p.placa %></div>
                  <div class="small-muted"><%= p.sede || 'Sin sede' %></div>
                </div>
                <div class="priority-note"><%= p.observacion %></div>
                <div class="priority-meta"><%= fechaHoraCorta(p.creado_en) %><br><%= p.creado_por_nombre || 'Taller' %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </section>
  <% } %>

  <section class="mb-2">
    <h2 class="section-title">Módulos</h2>
    <div class="module-grid">
      <% if (puedeVerResumenEjecutivo) { %>
        <a href="/dashboard/resumen-ejecutivo" class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-graph-up-arrow"></i></span>
          <div><div class="module-title">Resumen ejecutivo</div><p class="module-copy">Gastos, proveedores, placas y mantenimientos.</p></div>
        </a>
      <% } %>
      <% if (puedeVerOperaciones) { %>
        <a href="/mantenimientos" class="module-card">
          <span class="module-icon icon-amber"><i class="bi bi-tools"></i></span>
          <div><div class="module-title">Mantenimientos</div><p class="module-copy">Pendientes, correctivos y cierres.</p></div>
        </a>
        <% if (puedeVerKpisMecanicos) { %>
          <a href="/kpis/mecanicos" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-speedometer2"></i></span>
            <div><div class="module-title">KPIs mecánicos</div><p class="module-copy">Productividad y especialidad por trabajo.</p></div>
          </a>
        <% } %>
        <% if (puedeVerReportesSupervisores) { %>
          <a href="/reportes-supervisores" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-clipboard-pulse"></i></span>
            <div><div class="module-title">Reportes supervisores</div><p class="module-copy">Fallas reportadas por unidad.</p></div>
          </a>
        <% } %>
        <a href="/unidades" class="module-card">
          <span class="module-icon icon-green"><i class="bi bi-truck-front"></i></span>
          <div><div class="module-title">Unidades</div><p class="module-copy">Activas, inactivas y varadas.</p></div>
        </a>
        <% if (puedeVerDashboardTaller) { %>
          <a href="/taller/dashboard" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-display"></i></span>
            <div><div class="module-title">Dashboard taller</div><p class="module-copy">Unidades en taller y listas para ruta.</p></div>
          </a>
        <% } %>
        <% if (puedeVerRevisionRuta) { %>
          <a href="/revision-ruta" class="module-card">
            <span class="module-icon icon-green"><i class="bi bi-clipboard-check"></i></span>
            <div><div class="module-title">Salida a ruta</div><p class="module-copy">Revisión diaria de camiones.</p></div>
          </a>
        <% } %>
        <% if (puedeVerGiras) { %>
          <a href="/giras" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-geo-alt"></i></span>
            <div><div class="module-title">Giras de taller</div><p class="module-copy">Inspecciones y observaciones por sede.</p></div>
          </a>
        <% } %>
        <a href="/llantas" class="module-card">
          <span class="module-icon icon-dark"><i class="bi bi-circle"></i></span>
          <div><div class="module-title">Llantas</div><p class="module-copy">Solicitudes, compras y llegadas.</p></div>
        </a>
        <% if (puedeVerRepuestos) { %>
          <a href="/repuestos" class="module-card">
            <span class="module-icon icon-amber"><i class="bi bi-box-seam"></i></span>
            <div><div class="module-title">Solicitud de repuestos</div><p class="module-copy">Placa, cantidad, estado y proveedor.</p></div>
          </a>
          <a href="/repuestos-semanales" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-calendar-week"></i></span>
            <div><div class="module-title">Repuestos semanales</div><p class="module-copy">Formato semanal por sede, tipo Excel.</p></div>
          </a>
        <% } %>
        <% if (puedeVerOrdenesMotor) { %>
          <a href="/ordenes-motor" class="module-card">
            <span class="module-icon icon-red"><i class="bi bi-gear-wide-connected"></i></span>
            <div><div class="module-title">Órdenes Motor</div><p class="module-copy">Presupuesto separado de compras.</p></div>
          </a>
        <% } %>
        <% if (mostrarOficinaDiaDia) { %>
          <a href="/oficina-dia-dia" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-person-workspace"></i></span>
            <div><div class="module-title">Oficina día a día</div><p class="module-copy">Registro diario de tareas de oficina.</p></div>
          </a>
        <% } %>
        <a href="/dekra" class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-clipboard-check"></i></span>
          <div><div class="module-title">DEKRA</div><p class="module-copy">Revisión técnica y vencimientos.</p></div>
        </a>
        <a href="/minae" class="module-card">
          <span class="module-icon icon-blue"><i class="bi bi-bank"></i></span>
          <div><div class="module-title">MINAE</div><p class="module-copy">Trámites y permisos.</p></div>
        </a>
        <% if (puedeVerAceite) { %>
          <a href="/aceite" class="module-card">
            <span class="module-icon icon-amber"><i class="bi bi-droplet-half"></i></span>
            <div><div class="module-title">Aceite</div><p class="module-copy">Cambios y control.</p></div>
          </a>
        <% } %>
        <% if (puedeVerAires) { %>
          <a href="/aires" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-snow2"></i></span>
            <div><div class="module-title">Aires acondicionados</div><p class="module-copy">Reparación, carga y mantenimiento.</p></div>
          </a>
        <% } %>
      <% } %>
      <% if (puedeVerRepuestos && !puedeVerOperaciones) { %>
        <a href="/repuestos" class="module-card">
          <span class="module-icon icon-amber"><i class="bi bi-box-seam"></i></span>
          <div><div class="module-title">Solicitud de repuestos</div><p class="module-copy">Ver repuestos y marcar entregas.</p></div>
        </a>
      <% } %>
      <% if (puedeVerCompras) { %>
        <a href="/compras/ordenes" class="module-card">
          <span class="module-icon icon-dark"><i class="bi bi-cart-check"></i></span>
          <div><div class="module-title">Órdenes</div><p class="module-copy">Órdenes de compra.</p></div>
        </a>
        <a href="/compras/facturas" class="module-card">
          <span class="module-icon icon-red"><i class="bi bi-receipt"></i></span>
          <div><div class="module-title">Facturas</div><p class="module-copy">Pendientes, pagos y reportes.</p></div>
        </a>
        <% if (user.rol !== 'CONTABILIDAD') { %>
          <a href="/compras/dashboard" class="module-card">
            <span class="module-icon icon-blue"><i class="bi bi-bar-chart"></i></span>
            <div><div class="module-title">Compras</div><p class="module-copy">Resumen del área.</p></div>
          </a>
        <% } %>
      <% } %>
    </div>
  </section>

  <% if (puedeVerOperaciones) { %>
    <section class="plain-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div>
          <h2 class="section-title mb-1">Mantenimientos de hoy</h2>
          <div class="small-muted">Trabajos programados para la sede actual.</div>
        </div>
        <a href="/mantenimientos" class="btn btn-sm btn-outline-dark">Ver todos</a>
      </div>
      <div class="table-responsive">
        <% if (!mantenimientosHoy.length) { %>
          <div class="empty-state">No hay mantenimientos programados para hoy.</div>
        <% } else { %>
          <table class="table table-sm mb-0 align-middle">
            <thead>
              <tr>
                <th>Placa</th>
                <th>Sede</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Plan</th>
                <th class="text-end">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% mantenimientosHoy.forEach(m => { %>
                <tr>
                  <td><strong><%= m.placa %></strong></td>
                  <td><%= m.sede %></td>
                  <td><%= m.tipo %></td>
                  <td><span class="badge <%= m.estado === 'CERRADO' ? 'text-bg-success' : 'text-bg-warning' %>"><%= m.estado %></span></td>
                  <td><%- renderPlanHtml(m.plan) %></td>
                  <td class="text-end"><a href="/mantenimientos/<%= m.id %>" class="btn btn-sm btn-dark">Abrir</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
