<%- include('estaciones_header',{titulo:registro?'Actualizar estación':'Nuevo registro de estación',volverEstaciones:registro?'/carburacion/estaciones/'+registro.id:'/carburacion/estaciones?categoria='+config.key}) %>
<% const r=registro || {estacion:'',cliente_id:null,ejecutivo:'',prioridad:'SIN_DEFINIR',estado:'PENDIENTE',detalle:'',campos:{}}; %>
<section class="plain-card p-3 station-form"><h2 class="section-title"><%= config.nombre %></h2><form method="POST" action="<%= registro?'/carburacion/estaciones/'+registro.id+'/editar':'/carburacion/estaciones' %>"><input type="hidden" name="categoria" value="<%= config.key %>"><% if(registro){ %><input type="hidden" name="version" value="<%= registro.version %>"><% } %>
<div class="row g-3"><div class="col-12"><label class="form-label" for="cliente_id">Estación del catálogo de clientes</label><select class="form-select" id="cliente_id" name="cliente_id" required><option value="">Seleccione una estación</option><% clientes.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(r.cliente_id)===c.id?'selected':'' %>><%= c.nombre %></option><% }) %></select><div class="form-text">Seleccione un cliente existente. Si falta, agréguelo primero en Clientes.<% if(registro && !r.cliente_id){ %> Nombre anterior: <%= r.estacion %>.<% } %></div></div>
<div class="col-md-4"><label class="form-label" for="ejecutivo">Ejecutivo</label><input class="form-control" id="ejecutivo" name="ejecutivo" maxlength="120" value="<%= r.ejecutivo || '' %>"></div><div class="col-md-4"><label class="form-label" for="prioridad">Prioridad</label><select class="form-select" id="prioridad" name="prioridad"><% prioridades.forEach(p=>{ %><option value="<%= p %>" <%= r.prioridad===p?'selected':'' %>><%= etiqueta(p) %></option><% }) %></select></div><div class="col-md-4"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado"><% estados.forEach(e=>{ %><option value="<%= e %>" <%= r.estado===e?'selected':'' %>><%= etiqueta(e) %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label" for="proveedor_ids">Proveedor(es)</label><select class="form-select" id="proveedor_ids" name="proveedor_ids" multiple size="3"><% proveedores.forEach(p=>{ %><option value="<%= p.id %>" <%= proveedorIds.includes(p.id)?'selected':'' %>><%= p.nombre %></option><% }) %></select><div class="form-text">Puede seleccionar varios proveedores.</div></div><div class="col-md-6"><label class="form-label" for="detalle">Estatus / avance / observaciones</label><textarea class="form-control" id="detalle" name="detalle" rows="4" maxlength="15000"><%= r.detalle || '' %></textarea></div>
<% config.campos.forEach(([key,label,type])=>{ %><div class="<%= type==='textarea'?'col-12':'col-md-6' %>"><label class="form-label" for="campo_<%= key %>"><%= label %></label><% if(type==='textarea'){ %><textarea class="form-control" id="campo_<%= key %>" name="campos[<%= key %>]" rows="3" maxlength="5000"><%= r.campos[key] || '' %></textarea><% }else{ %><input class="form-control" type="<%= type %>" id="campo_<%= key %>" name="campos[<%= key %>]" value="<%= r.campos[key] || '' %>" <%= type==='text'?'maxlength=5000':'' %>><% } %></div><% }) %>
<% if(config.key==='mantenimientos'){ %><div class="col-md-6"><label class="form-label" for="calculo_proximo">Cálculo del próximo mantenimiento</label><select class="form-select" id="calculo_proximo" name="campos[calculo_proximo]"><option value="manual" <%= r.campos.calculo_proximo!=='dias'?'selected':'' %>>Fecha manual</option><option value="dias" <%= r.campos.calculo_proximo==='dias'?'selected':'' %>>Último mantenimiento + frecuencia</option></select></div><div class="col-md-6"><label class="form-label" for="frecuencia_dias">Frecuencia (días)</label><input class="form-control" type="number" min="1" max="3650" id="frecuencia_dias" name="campos[frecuencia_dias]" value="<%= r.campos.frecuencia_dias || 90 %>"></div><div class="col-12"><div class="alert alert-info mb-0">Si selecciona cálculo por frecuencia, el sistema calcula la próxima fecha al guardar. Las fechas manuales se conservan.</div></div><% } %>
<div class="col-12"><label class="form-label" for="motivo">Nota de esta actualización (opcional)</label><textarea class="form-control" id="motivo" name="motivo" rows="2" maxlength="1000"></textarea></div></div>
<div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Guardar e incorporar al historial</button><a class="btn btn-secondary" href="<%= registro?'/carburacion/estaciones/'+registro.id:'/carburacion/estaciones?categoria='+config.key %>">Cancelar</a></div></form></section></main></body></html>
