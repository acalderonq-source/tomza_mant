<%- include('header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Proveedores de Carburación</h1><a class="btn btn-primary" href="/carburacion/proveedores/nuevo">Nuevo proveedor</a></div>
<div class="table-responsive"><table class="table table-striped bg-white"><thead><tr><th>Nombre</th><th>Identificación</th><th>Teléfono</th><th>Correo</th><th></th></tr></thead><tbody>
<% proveedores.forEach(p => { %><tr><td><%= p.nombre %></td><td><%= p.cedula_juridica %></td><td><%= p.telefono %></td><td><%= p.email %></td><td><a href="/carburacion/proveedores/editar/<%= p.id %>">Editar</a></td></tr><% }) %>
<% if (!proveedores.length) { %><tr><td colspan="5">Registre los proveedores de Carburación.</td></tr><% } %>
</tbody></table></div></main></body></html>
