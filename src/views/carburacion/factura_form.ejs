<%- include('finanzas_header',{titulo:orden?'Colocar factura a la orden':'Agregar factura sin orden'}) %>
<% if(orden){ %>
<section class="card p-4 mb-3"><h2 class="h5"><%= orden.po_numero %> · <%= orden.proveedor %></h2><p class="text-secondary mb-0">Cliente: <%= orden.placa_unidad || 'Sin cliente' %> · Total de la orden: <%= money(orden.total,orden.moneda) %></p></section>
<% } %>
<form method="POST" action="<%= orden?'/carburacion/ordenes/'+orden.id+'/factura':'/carburacion/facturas/agregar' %>" class="card p-4" data-archivo-form><input type="hidden" name="return_to" value="<%= volverUrl %>">
<% if(!orden){ %><div class="row g-3 mb-3"><div class="col-md-4"><label class="form-label" for="proveedor_id">Proveedor</label><select class="form-select" name="proveedor_id" id="proveedor_id" required><option value="">Seleccione un proveedor</option><% proveedores.forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %></option><% }) %></select></div><div class="col-md-4"><label class="form-label" for="cliente_id">Cliente (opcional)</label><select class="form-select" id="cliente_id" name="cliente_id"><option value="">Seleccione un cliente</option><% clientes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.nombre %></option><% }) %></select></div><div class="col-md-4"><label class="form-label" for="moneda">Moneda</label><select class="form-select" name="moneda" id="moneda" required><option value="CRC">Colones (CRC)</option><option value="USD">Dólares (USD)</option></select></div></div><% } %>
<div class="row g-3"><div class="col-md-4"><label class="form-label" for="numero">Número de factura</label><input class="form-control" id="numero" name="numero" maxlength="100" required></div>
<div class="col-md-4"><label class="form-label" for="fecha">Fecha de factura</label><input class="form-control" id="fecha" name="fecha" type="date" value="<%= hoy %>" required></div>
<div class="col-md-4"><label class="form-label" for="vencimiento">Vencimiento</label><input class="form-control" id="vencimiento" name="vencimiento" type="date" value="<%= vencimiento %>" required></div>
<div class="col-md-4"><label class="form-label" for="total">Monto de factura<%= orden?' ('+orden.moneda+')':'' %></label><input class="form-control" id="total" name="total" type="number" min="0.01" max="99999999999999.99" step="0.01" value="<%= orden?orden.total:'' %>" required></div>
<div class="col-md-8"><label class="form-label" for="archivo">Adjuntar factura (opcional)</label><input class="form-control" id="archivo" type="file" accept="application/pdf,image/png,image/jpeg" data-archivo-input><div class="form-text">PDF, PNG o JPG, máximo 5 MB. El archivo queda disponible únicamente dentro de Carburación.</div><input type="hidden" name="archivo_data" data-archivo-data><input type="hidden" name="archivo_nombre" data-archivo-nombre></div>
<div class="col-12"><label class="form-label" for="observacion">Observaciones</label><textarea class="form-control" id="observacion" name="observacion" maxlength="5000" rows="2"></textarea></div></div>
<% if(orden){ %><p class="text-secondary small mt-3">Al registrar la factura, la orden queda facturada y se bloquea su edición para conservar los datos de la compra.</p><% } %>
<div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Guardar factura</button><a class="btn btn-secondary" href="<%= volverUrl %>">Cancelar</a></div>
<p class="text-danger mt-2 mb-0" data-archivo-error role="alert"></p></form>
</main></body></html>
