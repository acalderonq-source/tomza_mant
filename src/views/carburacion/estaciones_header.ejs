<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= titulo %> | Carburación</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<%- include('../partials/dashboard_styles') %>
<style>.station-notes{white-space:pre-wrap;min-width:240px;max-width:520px}.station-name{min-width:160px}.station-tabs{display:flex;gap:.45rem;flex-wrap:wrap}.station-tabs a{font-size:.8rem}.station-badge{font-size:.7rem}.station-form{max-width:1080px}.station-history{border-left:3px solid #dbe3ef;padding-left:1rem}.station-fields dt{font-size:.8rem;color:#64748b}.station-fields dd{white-space:pre-wrap;overflow-wrap:anywhere}.station-summary{font-size:.76rem;color:#64748b}@media(max-width:620px){.station-notes{min-width:180px}}</style>
</head><body><nav class="navbar navbar-dark topbar px-3 py-2"><span class="navbar-brand fw-semibold"><span class="brand-box"><i class="bi bi-buildings"></i></span>Estaciones · Carburación</span><div class="d-flex gap-2 align-items-center flex-wrap text-white"><span class="small"><%= user.nombre || user.usuario || 'Carburación' %></span><a href="<%= typeof volverEstaciones!=='undefined'?volverEstaciones:'/carburacion/dashboard' %>" class="btn btn-sm btn-outline-light">← Volver</a><a href="/carburacion/dashboard" class="btn btn-sm btn-outline-light">Dashboard</a><a href="/logout" class="btn btn-warning btn-sm">Salir</a></div></nav><main class="container-fluid shell py-3">
<div class="simple-hero mb-3"><h1 class="page-title"><%= titulo %></h1></div>
<% if(success){ %><div class="alert alert-success" role="status"><%= success %></div><% } %>
