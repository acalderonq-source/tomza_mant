<%- include('estaciones_header',{titulo:registro.estacion,volverEstaciones:'/carburacion/estaciones?categoria='+config.key}) %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="section-title mb-0"><%= config.nombre %></h2><a class="btn btn-primary btn-sm" href="/carburacion/estaciones/<%= registro.id %>/editar">Actualizar avance</a></div>
<% if(!registro.cliente_id){ %><div class="alert alert-warning">Esta estación aún no está vinculada al catálogo de clientes. Puede asociarla desde Actualizar avance, conservando el nombre del archivo.</div><% } %>
<section class="plain-card p-3 mb-3"><dl class="row station-fields mb-0"><dt class="col-sm-3">Cliente del catálogo</dt><dd class="col-sm-9"><%= registro.cliente_nombre || 'Sin vincular' %></dd><dt class="col-sm-3">Ejecutivo</dt><dd class="col-sm-9"><%= registro.ejecutivo || 'Sin asignar' %></dd><dt class="col-sm-3">Estado / prioridad</dt><dd class="col-sm-9"><%= etiqueta(registro.estado) %> · <%= etiqueta(registro.prioridad) %></dd><dt class="col-sm-3">Proveedor(es)</dt><dd class="col-sm-9"><%= registro.proveedores || registro.proveedor_texto || 'Sin asignar' %></dd><dt class="col-sm-3">Estatus / avance</dt><dd class="col-sm-9"><%= registro.detalle || 'Sin observaciones' %></dd>
<% config.campos.forEach(([key,label])=>{ %><dt class="col-sm-3"><%= label %></dt><dd class="col-sm-9"><%= registro.campos[key] || 'Sin dato' %></dd><% }) %>
<% if(config.key==='mantenimientos'){ %><dt class="col-sm-3">Situación por fecha</dt><dd class="col-sm-9"><%= etiqueta(mantenimientoEstado(registro.campos)) %></dd><dt class="col-sm-3">Cálculo de próxima fecha</dt><dd class="col-sm-9"><%= registro.campos.calculo_proximo==='dias'?'Último mantenimiento + '+registro.campos.frecuencia_dias+' días':'Fecha manual' %></dd><% } %></dl></section>
<% if(registro.origen){ %><details class="plain-card p-3 mb-3"><summary class="fw-semibold">Datos originales del Excel</summary><p class="small-muted mt-2"><%= registro.archivo_origen %> · <%= registro.hoja_origen %> · Fila <%= registro.fila_origen %></p><dl class="row station-fields mb-0"><% registro.origen.encabezados.forEach((label,i)=>{ %><dt class="col-sm-3"><%= label %></dt><dd class="col-sm-9"><%= registro.origen.valores[i] == null?'Sin dato':registro.origen.valores[i] %></dd><% }) %></dl></details><% } %>
<section class="plain-card p-3"><h2 class="section-title">Historial de avances</h2><% if(!historial.length){ %><p class="small-muted">No hay actualizaciones registradas.</p><% } %><% historial.forEach(h=>{ %><article class="station-history mb-3"><div class="fw-semibold"><%= {IMPORTACION:'Importación del Excel',CREACION:'Registro creado',ACTUALIZACION:'Avance actualizado'}[h.accion] || h.accion %></div><div class="small-muted"><%= new Date(h.creado_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %> · <%= h.usuario_nombre || 'Sistema' %></div><% if(h.observacion){ %><p class="mb-1 station-notes"><%= h.observacion %></p><% } %><details><summary class="small">Ver datos guardados</summary><div class="small mt-2">Estado: <%= etiqueta(h.despues.estado) %> · Prioridad: <%= etiqueta(h.despues.prioridad) %> · Ejecutivo: <%= h.despues.ejecutivo || 'Sin asignar' %></div><p class="station-notes small"><%= h.despues.detalle || '' %></p><dl class="row station-fields mb-0"><% config.campos.forEach(([key,label])=>{ %><dt class="col-sm-3"><%= label %></dt><dd class="col-sm-9"><%= h.despues.campos?.[key] || 'Sin dato' %></dd><% }) %></dl></details></article><% }) %></section></main></body></html>
