<%- include('header') %>
<div class="carb-client-breadcrumb"><a href="/carburacion/clientes">← Volver a clientes</a></div>
<section class="carb-client-heading"><div><div class="carb-client-eyebrow">FICHA DEL CLIENTE</div><h1><%= cliente.nombre %></h1><p>Información de la gasolinera y datos para notificaciones.</p></div><% if(puedeEditarClientes){ %><a class="carb-client-button is-primary" href="/carburacion/clientes/<%= cliente.id %>/editar">Editar información</a><% } %></section>
<% if(success){ %><div class="alert alert-success" role="status"><%= success %></div><% } %>
<% [['identificacion','Identificación y actividad'],['ubicacion','Ubicación de la gasolinera'],['contacto','Datos para notificar']].forEach(([grupo,titulo])=>{ %>
<section class="carb-profile-card"><h2><%= titulo %></h2><dl class="carb-profile-grid"><% camposCliente.filter(c=>c.grupo===grupo).forEach(c=>{ %><div class="<%= c.type==='textarea'?'is-wide':'' %>"><dt><%= c.label %></dt><dd class="<%= cliente[c.key]?'':'is-missing' %>"><%= cliente[c.key] || 'Sin registrar' %></dd></div><% }) %></dl></section><% }) %>
<% if(cliente.actualizado_en){ %><p class="carb-profile-meta">Última actualización: <%= new Date(cliente.actualizado_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %></p><% } %>
<nav class="carb-client-actions carb-ficha-secciones" aria-label="Secciones de la ficha"><a class="carb-client-button" href="#incidencias">Incidencias (<%= incidencias.length %>)</a><a class="carb-client-button" href="#expediente">Expediente (<%= documentos.length %>)</a></nav>
<section class="carb-profile-card" id="incidencias"><h2>Reporte de incidencias</h2>
<% if(!incidencias.length){ %><p class="carb-profile-meta">Este cliente todavía no tiene incidencias registradas.</p><% } %>
<% incidencias.forEach(i=>{ %><article class="carb-incidencia"><div class="carb-client-actions"><h3><%= i.titulo %></h3><span class="carb-estado"><%= estadosIncidencia[i.estado] || i.estado %></span></div><p class="carb-profile-meta"><%= new Date(i.fecha).toLocaleDateString('es-CR',{timeZone:'America/Costa_Rica'}) %> · Registró: <%= i.creado_nombre %></p><p class="carb-incidencia-texto"><%= i.descripcion %></p>
<% if(puedeEditarClientes){ %><form method="POST" action="/carburacion/clientes/<%= cliente.id %>/incidencias/<%= i.id %>/estado" class="carb-client-actions"><input type="hidden" name="version" value="<%= i.version %>"><label for="estado_<%= i.id %>">Estado</label><select class="form-select w-auto" id="estado_<%= i.id %>" name="estado"><% Object.entries(estadosIncidencia).forEach(([key,label])=>{ %><option value="<%= key %>" <%= i.estado===key?'selected':'' %>><%= label %></option><% }) %></select><button class="carb-client-button" type="submit">Actualizar estado</button></form><% } %></article><% }) %>
<% if(puedeEditarClientes){ %><details class="carb-ficha-agregar"><summary>Agregar incidencia</summary><form method="POST" action="/carburacion/clientes/<%= cliente.id %>/incidencias"><div class="carb-profile-grid"><div><label for="incidencia_titulo">Título</label><input id="incidencia_titulo" name="titulo" maxlength="150" required></div><div><label for="incidencia_fecha">Fecha</label><input type="date" id="incidencia_fecha" name="fecha" value="<%= hoy %>" required></div><div><label for="incidencia_estado">Estado</label><select class="form-select" id="incidencia_estado" name="estado"><% Object.entries(estadosIncidencia).forEach(([key,label])=>{ %><option value="<%= key %>"><%= label %></option><% }) %></select></div><div class="is-wide"><label for="incidencia_descripcion">Descripción de la incidencia</label><textarea id="incidencia_descripcion" name="descripcion" maxlength="10000" rows="4" required></textarea></div></div><button class="carb-client-button is-primary mt-3" type="submit">Registrar incidencia</button></form></details><% } %></section>
<section class="carb-profile-card" id="expediente"><h2>Expediente · fotos y documentos</h2><p>Documentos legales, fotografías y archivos asociados a esta gasolinera.</p>
<% if(!documentos.length){ %><p class="carb-profile-meta">Todavía no hay archivos en el expediente.</p><% } %><div class="carb-documentos-grid"><% documentos.forEach(d=>{ const url='/carburacion/clientes/'+cliente.id+'/documentos/'+d.id; %><article class="carb-documento"><% if(d.mime.startsWith('image/')){ %><a href="<%= url %>?vista=1" target="_blank" rel="noopener"><img src="<%= url %>?vista=1" alt="<%= d.nombre %>" loading="lazy"></a><% } %><span class="carb-estado"><%= tiposDocumento[d.tipo] || d.tipo %></span><h3><%= d.nombre %></h3><% if(d.representante_legal){ %><p class="carb-profile-meta">Representante: <%= d.representante_legal %></p><% } %><p class="carb-profile-meta"><%= Math.ceil(d.tamanio/1024) %> KB · <%= d.creado_nombre %> · <%= new Date(d.creado_en).toLocaleDateString('es-CR',{timeZone:'America/Costa_Rica'}) %></p><a class="carb-client-button" href="<%= url %>">Descargar archivo</a></article><% }) %></div>
<% if(puedeEditarClientes){ %><details class="carb-ficha-agregar"><summary>Agregar foto o documento</summary><form method="POST" data-archivo-form action="/carburacion/clientes/<%= cliente.id %>/documentos"><div class="carb-profile-grid"><div><label for="documento_tipo">Tipo de archivo</label><select id="documento_tipo" class="form-select" name="tipo"><% Object.entries(tiposDocumento).forEach(([key,label])=>{ %><option value="<%= key %>" <%= key==='DOCUMENTO'?'selected':'' %>><%= label %></option><% }) %></select></div><div><label for="documento_archivo">Archivo (máximo 3 MB)</label><input type="file" id="documento_archivo" data-archivo="archivo" accept="application/pdf,image/jpeg,image/png,image/webp" required></div></div><p class="carb-profile-meta">PDF, JPG, PNG o WEBP.</p><p class="alert alert-danger" role="alert" data-archivo-error hidden></p><button class="carb-client-button is-primary mt-3" type="submit">Guardar en expediente</button></form></details><% } %></section>
<script src="/js/carburacion-expediente.js" defer></script></main></body></html>
