<%- include('estaciones_header',{titulo:'Estaciones de servicio',volverEstaciones:'/carburacion/dashboard'}) %>
<%
const resumenArea=resumen.find(r=>r.categoria===config.key) || {total:0,abiertos:0,sin_vincular:0};
const params=new URLSearchParams();Object.entries(filtros).forEach(([k,v])=>{if(v)params.set(k,v);});
const paginaUrl=page=>{const p=new URLSearchParams(params);p.set('pagina',page);return '/carburacion/estaciones?'+p.toString();};
%>
<nav class="station-tabs mb-3" aria-label="Áreas de estaciones"><% categorias.forEach(c=>{const count=resumen.find(r=>r.categoria===c.key); %><a class="btn btn-sm <%= config.key===c.key?'btn-dark':'btn-outline-dark' %>" href="/carburacion/estaciones?categoria=<%= c.key %>"><%= c.nombre %> <span class="badge <%= config.key===c.key?'bg-light text-dark':'bg-secondary' %>"><%= count?.total || 0 %></span></a><% }) %></nav>
<section class="summary-grid mb-3"><% [['Registros del área',resumenArea.total],['Sin finalizar',resumenArea.abiertos],['Sin vincular al catálogo',resumenArea.sin_vincular]].forEach(item=>{ %><div class="summary-card"><div class="summary-label"><%= item[0] %></div><div class="summary-value"><%= item[1] %></div></div><% }) %></section>
<section class="plain-card p-3 mb-3"><form method="GET" class="row g-2 align-items-end"><input type="hidden" name="categoria" value="<%= config.key %>"><div class="col-md-3"><label class="form-label small" for="buscar">Estación, cliente o detalle</label><input class="form-control form-control-sm" type="search" id="buscar" name="buscar" value="<%= filtros.buscar %>"></div><div class="col-md-2"><label class="form-label small" for="estado">Estado</label><select class="form-select form-select-sm" id="estado" name="estado"><option value="">Todos</option><% estados.forEach(e=>{ %><option value="<%= e %>" <%= filtros.estado===e?'selected':'' %>><%= etiqueta(e) %></option><% }) %></select></div><div class="col-md-2"><label class="form-label small" for="prioridad">Prioridad</label><select class="form-select form-select-sm" id="prioridad" name="prioridad"><option value="">Todas</option><% prioridades.forEach(p=>{ %><option value="<%= p %>" <%= filtros.prioridad===p?'selected':'' %>><%= etiqueta(p) %></option><% }) %></select></div><div class="col-md-2"><label class="form-label small" for="ejecutivo">Ejecutivo</label><input class="form-control form-control-sm" id="ejecutivo" name="ejecutivo" value="<%= filtros.ejecutivo %>"></div><div class="col-md-3"><label class="form-label small" for="proveedor_id">Proveedor</label><select class="form-select form-select-sm" id="proveedor_id" name="proveedor_id"><option value="">Todos</option><% proveedores.forEach(p=>{ %><option value="<%= p.id %>" <%= String(p.id)===String(filtros.proveedor_id)?'selected':'' %>><%= p.nombre %></option><% }) %></select></div>
<div class="col-md-3"><label class="form-label small" for="vinculo">Vínculo al catálogo de clientes</label><select class="form-select form-select-sm" id="vinculo" name="vinculo"><option value="">Todos</option><option value="pendiente" <%= filtros.vinculo?'selected':'' %>>Sin vincular</option></select></div>
<% if(config.key==='mantenimientos'){ %><div class="col-md-3"><label class="form-label small" for="mantenimiento">Próximo mantenimiento</label><select class="form-select form-select-sm" id="mantenimiento" name="mantenimiento"><option value="">Todos</option><option value="vencidos" <%= filtros.mantenimiento==='vencidos'?'selected':'' %>>Vencidos</option><option value="proximos" <%= filtros.mantenimiento==='proximos'?'selected':'' %>>Hoy y próximos 30 días</option><option value="sinfecha" <%= filtros.mantenimiento==='sinfecha'?'selected':'' %>>Sin fecha</option></select></div><% } %><div class="col-auto"><button class="btn btn-primary btn-sm">Filtrar</button></div><div class="col-auto"><a class="btn btn-secondary btn-sm" href="/carburacion/estaciones?categoria=<%= config.key %>">Limpiar</a></div></form></section>
<section class="plain-card"><div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap"><div><h2 class="section-title mb-0"><%= config.nombre %></h2><div class="station-summary"><%= paginacion.total %> registro(s) para los filtros seleccionados</div></div><a class="btn btn-primary btn-sm" href="/carburacion/estaciones/nuevo?categoria=<%= config.key %>"><i class="bi bi-plus-circle"></i> Nuevo registro</a></div>
<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Estación</th><th>Estado / prioridad</th><% if(config.key==='mantenimientos'){ %><th>Último mantenimiento</th><th>Próximo mantenimiento</th><% }else{ %><th>Ejecutivo</th><% } %><th>Estatus / avance</th><th>Proveedor</th><th>Acciones</th></tr></thead><tbody>
<% registros.forEach(r=>{ %><tr><td class="station-name"><strong><%= r.estacion %></strong><div class="small-muted"><%= r.cliente_nombre || 'Sin vincular al catálogo' %></div></td><td><span class="badge station-badge <%= r.estado==='FINALIZADO'?'bg-success':'bg-secondary' %>"><%= etiqueta(r.estado) %></span><div class="mt-1"><span class="badge station-badge <%= r.prioridad==='ALTA'?'bg-danger':r.prioridad==='MEDIA'?'bg-warning text-dark':'bg-light text-dark border' %>"><%= etiqueta(r.prioridad) %></span></div></td>
<% if(config.key==='mantenimientos'){const situacion=mantenimientoEstado(r.campos); %><td class="text-nowrap"><%= r.campos.ultimo_mantenimiento || 'Sin fecha' %></td><td class="text-nowrap"><%= r.campos.proximo_mantenimiento || 'Sin fecha' %><div><span class="badge <%= situacion==='VENCIDO'?'bg-danger':situacion==='HOY'?'bg-warning text-dark':'bg-light text-dark border' %>"><%= etiqueta(situacion) %></span></div></td><% }else{ %><td><%= r.ejecutivo || '—' %></td><% } %>
<td class="station-notes"><%= r.detalle || r.campos.nota_mantenimiento || '—' %><% if(config.key==='minae' && r.campos.ot){ %><div class="small-muted mt-1">OT: <%= r.campos.ot %></div><% } %></td><td><%= r.proveedores || r.proveedor_texto || 'Sin proveedor' %></td><td class="text-nowrap"><a href="/carburacion/estaciones/<%= r.id %>">Ver e historial</a><br><a href="/carburacion/estaciones/<%= r.id %>/editar">Actualizar</a></td></tr><% }) %>
<% if(!registros.length){ %><tr><td colspan="8" class="empty-state">No hay registros para estos filtros.</td></tr><% } %></tbody></table></div>
<div class="p-3 d-flex justify-content-between gap-2 align-items-center flex-wrap border-top"><span class="small-muted">Página <%= paginacion.pagina %> de <%= paginacion.totalPaginas %></span><div class="btn-group"><a class="btn btn-outline-secondary btn-sm <%= paginacion.pagina<=1?'disabled':'' %>" href="<%= paginaUrl(Math.max(1,paginacion.pagina-1)) %>">Anterior</a><a class="btn btn-outline-secondary btn-sm <%= paginacion.pagina>=paginacion.totalPaginas?'disabled':'' %>" href="<%= paginaUrl(Math.min(paginacion.totalPaginas,paginacion.pagina+1)) %>">Siguiente</a></div></div></section></main></body></html>
