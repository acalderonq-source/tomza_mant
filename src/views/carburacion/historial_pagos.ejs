<% const gestionarFinanzas=typeof puedeModificarFinanzas==='undefined' || puedeModificarFinanzas; %>
<%- include('finanzas_header',{titulo:'Historial de pagos'}) %>
<p class="text-secondary">Consulte cada pago o abono, descargue su colilla y revise el envío al proveedor. Hasta 250 resultados.</p>
<form method="GET" class="filtros-card"><input type="hidden" name="return_to" value="<%= volverUrl %>"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label" for="desde">Desde</label><input class="form-control" type="date" id="desde" name="desde" value="<%= filtros.desde %>"></div><div class="col-md-4"><label class="form-label" for="hasta">Hasta</label><input class="form-control" type="date" id="hasta" name="hasta" value="<%= filtros.hasta %>"></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-primary">Filtrar</button><a class="btn btn-outline-secondary" href="/carburacion/facturas/historial-pagos?return_to=<%= encodeURIComponent(volverUrl) %>">Limpiar</a></div></div></form>
<section class="card p-3"><div class="table-responsive"><table class="table table-hover table-facturas"><thead><tr><th>Colilla</th><th>Fecha</th><th>Tipo</th><th>Proveedor</th><th>Facturas</th><th>Monto</th><th>Registrado por</th><th>Correo proveedor</th><th>Documentos</th></tr></thead><tbody>
<% pagos.forEach(p=>{ %><tr><td><strong><%= p.recibo_numero %></strong></td><td class="text-nowrap"><%= fecha(p.fecha) %></td><td><%= p.tipo==='abono'?'Abono':p.tipo==='pago_multiple'?'Pago múltiple':'Pago' %></td><td><%= p.proveedor %></td><td><%= p.facturas.map(f=>f.factura).join(', ') %></td><td class="text-nowrap fw-bold"><%= money(p.total,p.moneda) %></td><td><%= p.generado_por %></td><td style="min-width:220px"><span class="badge <%= p.correo_estado==='ENVIADO'?'bg-success':'bg-secondary' %>"><%= {ENVIADO:'Enviado',PENDIENTE:'Pendiente',ERROR:'Error de envío',SIN_CORREO:'Proveedor sin correo',PENDIENTE_CONFIG:'Falta configuración',ENVIANDO:'En proceso'}[p.correo_estado] || 'Pendiente' %></span><div class="small text-secondary"><%= p.correo_destino || '' %></div><% if(p.enviado_en){ %><div class="small text-secondary">Enviado: <%= fecha(p.enviado_en) %></div><% } %><% if(p.correo_error){ %><div class="small text-danger"><%= p.correo_error %></div><% } %><% if(gestionarFinanzas && !['ENVIADO','ENVIANDO'].includes(p.correo_estado)){ %><form method="POST" action="/carburacion/facturas/colillas/<%= p.id %>/enviar" class="mt-1"><input type="hidden" name="return_to" value="<%= volverUrl %>"><button class="btn btn-sm btn-outline-primary" type="submit"><%= p.intentos?'Reintentar correo':'Enviar correo' %></button></form><% } %><% if(p.correo_estado==='ENVIANDO'){ %><div class="small text-secondary">Si el proceso se interrumpió, verifique la entrega antes de reenviar.</div><% } %></td><td style="min-width:150px"><a class="btn btn-sm btn-outline-dark mb-1" href="/carburacion/facturas/colillas/<%= p.id %>/descargar">Colilla PDF</a><% if(p.comprobante_nombre){ %><a class="btn btn-sm btn-outline-secondary" href="/carburacion/facturas/colillas/<%= p.id %>/comprobante">Comprobante</a><% } %></td></tr><% }) %>
<% if(!pagos.length){ %><tr><td colspan="9" class="text-center text-secondary py-5">No hay pagos para los filtros seleccionados.</td></tr><% } %></tbody></table></div></section></main></body></html>
