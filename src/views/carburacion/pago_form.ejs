<%- include('finanzas_header',{titulo:'Registrar pago a proveedor'}) %>
<section class="card p-4 mb-3"><h2 class="h5"><%= facturas[0].proveedor_nombre %></h2><p class="mb-2">Saldo seleccionado: <strong><%= money(saldo,facturas[0].moneda) %></strong></p><ul class="mb-0"><% facturas.forEach(f=>{ %><li><%= f.numero %> · <%= f.po_numero || 'Sin orden' %> · Saldo: <%= money(Number(f.total)-Number(f.pagado),f.moneda) %></li><% }) %></ul></section>
<form method="POST" action="/carburacion/facturas/pagar" class="card p-4" data-archivo-form><input type="hidden" name="return_to" value="<%= volverUrl %>">
<input type="hidden" name="token" value="<%= token %>"><% facturas.forEach(f=>{ %><input type="hidden" name="facturas_ids" value="<%= f.id %>"><% }) %>
<div class="row g-3"><div class="col-md-4"><label class="form-label" for="tipo">Movimiento</label><select class="form-select" id="tipo" name="tipo" data-pago-tipo><option value="pago">Pago completo del saldo</option><% if(facturas.length===1){ %><option value="abono">Abono parcial</option><% } %></select></div>
<div class="col-md-4"><label class="form-label" for="fecha">Fecha de pago</label><input class="form-control" type="date" id="fecha" name="fecha" value="<%= hoy %>" max="<%= hoy %>" required></div>
<div class="col-md-4"><label class="form-label" for="periodo_cierre">Periodo cierre</label><input class="form-control" type="month" id="periodo_cierre" name="periodo_cierre" value="<%= hoy.slice(0,7) %>" required></div>
<div class="col-md-4" data-abono-campo hidden><label class="form-label" for="monto">Monto del abono (<%= facturas[0].moneda %>)</label><input class="form-control" type="number" id="monto" name="monto" min="0.01" max="<%= saldo %>" step="0.01"></div>
<div class="col-md-4"><label class="form-label" for="comprobante_numero">Número de comprobante</label><input class="form-control" id="comprobante_numero" name="comprobante_numero" maxlength="120"></div>
<div class="col-md-8"><label class="form-label" for="comprobante">Adjuntar comprobante (opcional)</label><input class="form-control" type="file" id="comprobante" accept="application/pdf,image/png,image/jpeg" data-archivo-input><div class="form-text">PDF, PNG o JPG, máximo 5 MB.</div><input type="hidden" name="comprobante_data" data-archivo-data><input type="hidden" name="comprobante_nombre" data-archivo-nombre></div>
<div class="col-12"><label class="form-label" for="observacion">Observaciones del pago</label><textarea class="form-control" id="observacion" name="observacion" maxlength="5000" rows="2"></textarea></div></div>
<div class="form-check my-3"><input class="form-check-input" type="checkbox" id="enviar_correo" name="enviar_correo" value="1"><label class="form-check-label" for="enviar_correo">Enviar la colilla y el comprobante al proveedor con las copias internas configuradas</label></div>
<div class="d-flex gap-2"><button class="btn btn-success" type="submit">Confirmar pago y generar colilla</button><a class="btn btn-secondary" href="<%= volverUrl %>">Cancelar</a></div><p class="text-danger mt-2 mb-0" role="alert" data-archivo-error></p>
</form></main></body></html>
