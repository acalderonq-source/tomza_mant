<%- include('header') %>
<section class="carb-client-heading"><div><div class="carb-client-eyebrow">CATÁLOGO DE CARBURACIÓN</div><h1>Clientes</h1><p>Estaciones de servicio disponibles para tus órdenes y facturas.</p></div><div class="carb-client-total"><strong><%= clientes.length %></strong><span>clientes<br>registrados</span></div></section>
<% if(typeof success!=='undefined' && success){ %><div class="alert alert-success" role="status"><%= success %></div><% } %>
<% if(typeof puedeEditarClientes!=='undefined' && puedeEditarClientes){ %><div class="carb-client-actions"><a class="carb-client-button is-primary" href="/carburacion/clientes/nuevo">+ Agregar cliente</a></div><% } %>
<section class="carb-client-panel" aria-label="Catálogo de clientes"><div class="carb-client-toolbar"><div class="carb-client-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="buscarCliente" type="search" placeholder="Buscar una estación de servicio…" aria-label="Buscar cliente"></div><span class="carb-client-count" id="contadorClientes" aria-live="polite"><%= clientes.length %> clientes</span></div>
<table class="carb-client-table"><thead><tr><th class="carb-client-number">N.º</th><th>Estación de servicio</th><th class="carb-client-type">Ficha del cliente</th></tr></thead><tbody id="listaClientes"><% clientes.forEach((c,i)=>{ %><tr data-cliente="<%= c.nombre %>" data-cliente-url="/carburacion/clientes/<%= c.id %>"><td class="carb-client-number"><%= String(i+1).padStart(2,'0') %></td><td><a class="carb-client-name carb-client-open" href="/carburacion/clientes/<%= c.id %>"><span class="carb-client-icon" aria-hidden="true"><%= Array.from(c.nombre.trim())[0] %></span><%= c.nombre %></a></td><td class="carb-client-type"><a class="carb-client-open" href="/carburacion/clientes/<%= c.id %>" aria-label="Ver ficha de <%= c.nombre %>">Ver ficha ›</a></td></tr><% }) %></tbody></table>
<div class="carb-client-empty" id="clientesVacio" <%= clientes.length?'hidden':'' %>>No se encontraron clientes.<button type="button" id="limpiarClientes">Limpiar búsqueda</button></div></section>
<script>
const buscarCliente=document.getElementById('buscarCliente');
const normalizarCliente=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('es-CR');
function filtrarClientes(){const filtro=normalizarCliente(buscarCliente.value.trim());let visibles=0;document.querySelectorAll('#listaClientes tr').forEach(row=>{row.hidden=!normalizarCliente(row.dataset.cliente).includes(filtro);if(!row.hidden)visibles++;});document.getElementById('contadorClientes').textContent=visibles+' cliente'+(visibles===1?'':'s');document.getElementById('clientesVacio').hidden=visibles>0;}
buscarCliente.addEventListener('input',filtrarClientes);document.getElementById('limpiarClientes').addEventListener('click',()=>{buscarCliente.value='';filtrarClientes();buscarCliente.focus();});
document.querySelectorAll('[data-cliente-url]').forEach(row=>row.addEventListener('click',event=>{if(!event.target.closest('a,button'))window.location.assign(row.dataset.clienteUrl);}));
</script></main></body></html>
