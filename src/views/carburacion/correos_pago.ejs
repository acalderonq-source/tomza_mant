<%- include('finanzas_header',{titulo:'Correos de pagos a proveedores'}) %>
<section class="card p-4" style="max-width:760px"><h2 class="h5">Copias internas de colillas</h2><p class="text-secondary">La colilla y el comprobante se envían al correo del proveedor con copia a las direcciones indicadas aquí. Puede configurar de una a tres copias internas de Carburación.</p>
<% if(smtpConfigurado){ %><div class="alert alert-success">Remitente configurado: <strong><%= remitente %></strong></div><% } else { %><div class="alert alert-warning">Falta configurar el remitente de pagos en el servidor. Los pagos se guardan y las colillas pueden descargarse; el correo quedará pendiente de configuración.</div><% } %>
<form method="POST" action="/carburacion/facturas/configuracion-correo"><input type="hidden" name="return_to" value="<%= volverUrl %>"><% [1,2,3].forEach(n=>{const campo=`copia_${n}`; %><div class="mb-3"><label class="form-label" for="<%= campo %>">Copia interna <%= n %><%= n===1?'':' (opcional)' %></label><input class="form-control" type="email" id="<%= campo %>" name="<%= campo %>" maxlength="200" value="<%= config[campo] || '' %>" <%= n===1?'required':'' %>></div><% }) %>
<div class="mb-3"><label class="form-label" for="correo_respuesta">Correo de respuesta (opcional)</label><input class="form-control" type="email" id="correo_respuesta" name="correo_respuesta" maxlength="200" value="<%= config.correo_respuesta || '' %>"></div><button class="btn btn-primary" type="submit">Guardar correos de Carburación</button></form></section></main></body></html>
