<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= titulo %> | Carburación</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link href="/css/compras.css" rel="stylesheet">
<%- include('../partials/facturas_styles') %>
<script src="/js/carburacion-finanzas.js" defer></script>
</head><body><% const principal=titulo==='Gestión de facturas'; %><nav class="navbar navbar-dark bg-dark px-3 py-2"><span class="navbar-brand fw-semibold"><i class="bi bi-receipt"></i> <%= titulo %></span><div class="text-white d-flex align-items-center flex-wrap gap-2"><span><%= user.nombre || user.usuario || 'Carburación' %> · Carburación</span><% if(!principal){ %><a href="<%= volverUrl %>" class="btn btn-sm btn-outline-light ms-2">← Volver a facturas</a><% } %><a href="/carburacion/ordenes" class="btn btn-sm btn-outline-light ms-2">← Órdenes</a><a href="/carburacion/dashboard" class="btn btn-sm btn-outline-light ms-2">Dashboard</a><% if(user.rol==='ADMIN'){ %><a href="/admin/carnets-trabajadores" class="btn btn-sm btn-outline-light ms-2">Carnets</a><% } %><a href="/logout" class="btn btn-sm btn-warning ms-2">Salir</a></div></nav>
<main class="container-fluid container-facturas py-4">
<div class="page-heading"><div><h1 class="page-title"><%= principal?'Facturas de compras':titulo %></h1><% if(principal){ %><p class="page-subtitle">Controla facturas pendientes, vencidas y pagos múltiples.</p><% } %></div><% if(typeof agregarUrl!=='undefined' && (typeof puedeModificarFinanzas==='undefined' || puedeModificarFinanzas)){ %><a class="btn btn-primary" href="<%= agregarUrl %>"><i class="bi bi-plus-circle"></i> Agregar factura sin orden</a><% } %></div>
<% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
