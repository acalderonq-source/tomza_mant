<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Carburación | Gas Tomza</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/compras.css" rel="stylesheet"><link href="/css/carburacion-shell.css" rel="stylesheet"><script src="/js/carburacion-shell.js" defer></script></head>
<body class="bg-light">
<%
const currentPath=typeof carburacionPath==='string'?carburacionPath:'';
const enlaces=[['Inicio','/carburacion/dashboard'],['Estaciones','/carburacion/estaciones'],['Órdenes','/carburacion/ordenes'],['Proveedores','/carburacion/proveedores'],['Clientes','/carburacion/clientes'],['Facturas','/carburacion/facturas'],['Historial de pagos','/carburacion/facturas/historial-pagos']];
if(typeof user!=='undefined' && user.rol==='ADMIN')enlaces.push(['Carnets','/admin/carnets-trabajadores']);
const activo=url=>url==='/carburacion/facturas'?currentPath.startsWith(url) && !currentPath.startsWith('/carburacion/facturas/historial-pagos'):currentPath===url || currentPath.startsWith(url+'/');
%>
<header class="carb-shell-header"><div class="carb-shell-bar"><a class="carb-shell-brand" href="/carburacion/dashboard"><span class="carb-shell-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="10" height="17" rx="2"/><path d="M7 7h4M7 10h4M3 21h12M14 10h2a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0V8l-3-3"/></svg></span><span><strong>Carburación</strong><small>GAS TOMZA</small></span></a>
<button class="carb-shell-toggle" type="button" aria-controls="carbMenu" aria-expanded="false">Menú <span aria-hidden="true">☰</span></button>
<nav class="carb-shell-links" id="carbMenu" aria-label="Navegación de Carburación"><% enlaces.forEach(([nombre,url])=>{ %><a class="carb-shell-link<%= activo(url)?' is-active':'' %>" href="<%= url %>" <%= activo(url)?'aria-current=page':'' %>><%= nombre %></a><% }) %><a class="carb-shell-exit" href="/logout">Salir <span aria-hidden="true">↗</span></a></nav></div></header>
<main class="container py-4 carb-shell-main">
