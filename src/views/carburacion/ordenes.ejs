<% const gestionarFinanzas=typeof puedeModificarFinanzas==='undefined' || puedeModificarFinanzas; %>
<%- include('header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Órdenes de compra</h1><% if(gestionarFinanzas){ %><a class="btn btn-primary" href="/carburacion/ordenes/nueva">Nueva orden</a><% }else{ %><span class="badge bg-secondary">Solo consulta</span><% } %></div>
<% if(success){ %><div class="alert alert-success" role="status"><%= success %></div><% } %>
<div class="table-responsive"><table class="table table-striped bg-white"><thead><tr><th>N° PO</th><th>Cotización</th><th>Fecha</th><th>Proveedor</th><th>Moneda</th><th>Total</th><th>Factura</th><th>Acciones</th></tr></thead><tbody>
<% ordenes.forEach(o => { %><tr><td><%= o.po_numero %></td><td><%= o.numero_cotizacion || '—' %></td><td><%= new Date(o.fecha).toLocaleDateString('es-CR') %></td><td><%= o.proveedor %></td><td><%= o.moneda %></td><td><%= Number(o.total).toLocaleString('es-CR',{minimumFractionDigits:2}) %></td><td><% if (o.factura_id) { %><a href="/carburacion/facturas?buscar=<%= encodeURIComponent(o.factura_numero) %>"><%= o.factura_numero %></a><% } else if(gestionarFinanzas) { %><a class="btn btn-sm btn-outline-primary" href="/carburacion/ordenes/<%= o.id %>/factura">Colocar factura</a><% } %></td><td><% if (gestionarFinanzas && !o.factura_id) { %><a href="/carburacion/ordenes/<%= o.id %>/editar">Editar</a> · <% } %><a href="/carburacion/ordenes/<%= o.id %>/pdf">PDF</a><% if (gestionarFinanzas && !o.factura_id) { %> <form method="POST" action="/carburacion/ordenes/<%= o.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar esta orden de Carburación?')"><button type="submit" class="btn btn-sm btn-outline-danger ms-2">Eliminar</button></form><% } %></td></tr><% }) %>
<% if (!ordenes.length) { %><tr><td colspan="8">Todavía no hay órdenes de Carburación. Registre sus proveedores para crear la primera orden.</td></tr><% } %>
</tbody></table></div></main></body></html>
