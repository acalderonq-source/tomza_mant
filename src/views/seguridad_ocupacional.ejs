<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Seguridad Ocupacional | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('partials/dashboard_styles') %>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <a class="navbar-brand" href="/seguridad-ocupacional">Gas Tomza · Seguridad Ocupacional</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <span class="small"><%= user.nombre || user.usuario %></span>
    <a href="/inicio" class="btn btn-outline-light btn-sm">Ir a inicio</a>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>
<main class="container-fluid shell py-2">
  <section class="simple-hero mb-2">
    <h1 class="page-title">Seguridad Ocupacional</h1>
    <div class="page-subtitle">Departamento: <strong>Seguridad Ocupacional</strong> · Sede: <strong><%= user.sede || 'Sin sede asignada' %></strong> · <%= new Date().toLocaleDateString('es-CR', {timeZone:'America/Costa_Rica'}) %></div>
  </section>
  <section class="mb-2">
    <h2 class="section-title legacy-modules-title">Módulos</h2>
    <div class="module-grid">
      <a href="/proveeduria/mis-solicitudes" class="module-card">
        <span class="module-icon icon-blue"><i class="bi bi-cart-plus"></i></span>
        <div><div class="module-title">Solicitud de suministros</div><p class="module-copy">Solicite equipo de protección personal, materiales y suministros a Proveeduría. Consulte sus pedidos y confirme la entrega.</p></div>
      </a>
    </div>
  </section>
</main>
</body>
</html>
