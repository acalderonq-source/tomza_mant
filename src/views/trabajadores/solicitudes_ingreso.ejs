<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solicitudes de trabajadores | Gas Tomza</title><link rel="stylesheet" href="/css/solicitudes-trabajadores.css"></head><body>
<header><a href="/dashboard">Gas Tomza</a><strong>Solicitudes de trabajadores</strong><a href="/admin/carnets-trabajadores">Accesos y carnets</a></header><main>
<nav><a href="/dashboard">Inicio</a><a href="/solicitar-ingreso">Formulario de solicitud</a><a href="/admin/carnets-trabajadores">Carnets PDF</a><a href="/logout">Cerrar sesión</a></nav>
<h1>Solicitudes de ingreso</h1>
<% if (mensaje) { %><p role="status" class="aviso"><%= mensaje %></p><% } %>
<form method="get" class="filtro"><label for="estado">Estado</label><select name="estado" id="estado"><% ['PENDIENTE','APROBADA','RECHAZADA'].forEach(e => { %><option <%= estado === e ? 'selected' : '' %>><%= e %></option><% }); %></select><button type="submit">Filtrar</button></form>
<p>Se muestran hasta 200 solicitudes. Verifique la identidad, el puesto y la sede antes de asignar permisos.</p>
<% if (!solicitudes.length) { %><p>Sin solicitudes en este estado.</p><% } %>
<% solicitudes.forEach(s => { %><section class="solicitud">
<div class="titulo"><h2><%= s.nombre_completo %></h2><strong><%= s.estado %></strong></div>
<dl><dt>Cédula</dt><dd><%= s.cedula %></dd><dt>Puesto solicitado</dt><dd><%= s.puesto %></dd><dt>Sede declarada</dt><dd><%= s.sede %></dd><dt>Recibida</dt><dd><%= new Date(s.creado_en).toLocaleString('es-CR', { timeZone:'America/Costa_Rica' }) %></dd></dl>
<% if (s.estado === 'PENDIENTE') { %>
<form method="post" action="/admin/solicitudes-trabajadores/<%= s.id %>"><input type="hidden" name="accion" value="aprobar">
<div class="campos"><div><label for="codigo-<%= s.id %>">Código de trabajador / PIN</label><input id="codigo-<%= s.id %>" name="codigo_trabajador" inputmode="numeric" pattern="[0-9]{1,30}" maxlength="30" required></div>
<div><label for="perfiles-<%= s.id %>">Perfiles de acceso autorizados</label><select id="perfiles-<%= s.id %>" name="usuario_ids" multiple size="5" required><% perfiles.forEach(p => { %><option value="<%= p.id %>"><%= p.usuario %> · <%= p.nombre || p.rol %> · <%= p.sede || 'Sin sede' %></option><% }); %></select></div></div>
<label class="confirmacion"><input type="checkbox" name="identidad_verificada" value="1" required> Verifiqué la identidad, el puesto y que los perfiles corresponden a la sede y funciones autorizadas.</label>
<button type="submit">Aprobar y crear acceso y carnet</button></form>
<details><summary>Rechazar solicitud</summary><form method="post" action="/admin/solicitudes-trabajadores/<%= s.id %>"><input type="hidden" name="accion" value="rechazar"><label for="motivo-<%= s.id %>">Motivo</label><textarea id="motivo-<%= s.id %>" name="motivo" minlength="5" maxlength="500" required></textarea><button type="submit" class="peligro">Rechazar</button></form></details>
<% } else { %><p><%= s.motivo || 'Revisión completada.' %><% if (s.codigo_trabajador) { %> · Código: <%= s.codigo_trabajador %><% } %></p><% } %></section><% }); %>
</main></body></html>
