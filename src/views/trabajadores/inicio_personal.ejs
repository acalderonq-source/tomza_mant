<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mis accesos | Gas Tomza</title><link rel="stylesheet" href="/css/solicitudes-trabajadores.css"></head><body><header><strong>Gas Tomza · Mis accesos</strong><nav><a href="/inicio">Ir a inicio</a><a href="/logout">Salir</a></nav></header><main><h1><%= user.nombre %></h1><p><%= config.departamento.replace(/_/g,' ') %><%= config.unidad==='CAJAS'?' · CAJAS':'' %> · Sede laboral: <%= config.sede %></p><% if(!modulos.length){ %><p>No hay módulos operativos habilitados para esta cuenta.</p><% } %><% modulos.forEach(m=>{ %><section><h2><a href="<%= m.url %>"><%= m.nombre %></a></h2><p><%= m.permiso || (config.permisos[m.id]==='LECTURA'?'Consultar':'Gestionar') %></p></section><% }); %></main></body></html>
