<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agenda</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @media (max-width: 768px) {
      .table thead { display: none; }
      .table, .table tbody, .table tr, .table td {
        display: block;
        width: 100%;
      }
      .table tr {
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem;
        background: white;
      }
      .table td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border: none;
        border-bottom: 1px solid #eee;
      }
      .table td::before {
        content: attr(data-label);
        position: absolute;
        left: 1rem;
        width: 45%;
        font-weight: bold;
        text-align: left;
      }
    }
  </style>
</head>
<body class="bg-dark text-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand fw-bold">
    <img src="https://www.tomzasureste.com/img/grp_tomza.png" height="28">
    Gas Tomza
  </span>

  <% if (user.rol === 'ADMIN') { %>
    <form method="POST" action="/admin/regenerar-agenda" class="d-inline">
      <button class="btn btn-outline-warning btn-sm">🔁 Regenerar agenda</button>
    </form>
  <% } %>

  <span class="me-3">
    <%= user.nombre || user.usuario %> (<%= user.rol %>)
  </span>

  <a href="/logout" class="btn btn-warning btn-sm">Salir</a>
</nav>

<div class="container mt-4">

  <!-- Selector de sede -->
  <div class="mb-3">
    <label class="fw-bold text-warning">📍 Filtrar por sede:</label>
    <div class="d-flex flex-wrap gap-2 mt-1">
      <% if (user.rol === 'ADMIN') { %>
        <form method="POST" action="/cambiar-sede" class="d-inline">
          <button class="btn btn-sm <%= sedeSeleccionada === 'TODAS' ? 'btn-warning' : 'btn-outline-light' %>" name="sede" value="TODAS">TODAS</button>
        </form>
      <% } %>

      <% sedesPermitidas.forEach(sede => { %>
        <form method="POST" action="/cambiar-sede" class="d-inline">
          <button class="btn btn-sm <%= sedeSeleccionada === sede ? 'btn-warning' : 'btn-outline-light' %>" name="sede" value="<%= sede %>"><%= sede %></button>
        </form>
      <% }) %>
    </div>
  </div>

  <h4 class="text-warning mb-3">
    Agenda – <%= fecha.split("-").reverse().join("/") %>
    <% if (vista === "hoy") { %>
      <span class="badge bg-success ms-2">HOY</span>
    <% } %>
  </h4>

  <div class="mb-3">
    <a href="/agenda" class="btn btn-outline-warning btn-sm me-2">Hoy</a>
    <a href="/agenda/manana" class="btn btn-outline-warning btn-sm">Mañana</a>
  </div>

  <!-- Botón nuevo mantenimiento preventivo -->
  <% if (user && (user.rol === 'SUPERVISOR_PESADO' || user.rol === 'ADMIN' || user.rol === 'TALLER')) { %>
    <div class="mb-3">
      <a href="/agenda/nuevo" class="btn btn-warning">
        ➕ Nuevo mantenimiento preventivo
      </a>
    </div>
  <% } %>

  <div class="table-responsive">
    <table class="table table-light align-middle rounded overflow-hidden">
      <thead class="table-dark">
        <tr>
          <th>Placa</th>
          <th>Tipo</th>
          <th>Descripción / Plan</th>
          <th>Estado</th>
          <th>Sede</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% agenda.forEach(item => { %>
          <tr>
            <td data-label="Placa"><strong><%= item.placa %></strong></td>
            <td data-label="Tipo">
              <span class="badge bg-info">
                <%= item.tipo_registro %>
                <%= item.subtipo ? `(${item.subtipo})` : '' %>
              </span>
            </td>
            <td data-label="Descripción">
              <div class="bg-light rounded border small text-dark p-1" style="max-height: 80px; overflow-y: auto;">
                <%= item.descripcion || '—' %>
              </div>
            </td>
            <td data-label="Estado">
              <span class="badge bg-secondary"><%= item.estado %></span>
            </td>
            <td data-label="Sede"><%= item.sede %></td>
            <td data-label="Acciones" class="text-end">
              <% if (item.tipo_registro === 'PREVENTIVO') { %>
                <a href="/mantenimientos/<%= item.id %>" class="btn btn-warning btn-sm">Ver</a>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (agenda.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted">No hay registros para esta fecha y sede</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>