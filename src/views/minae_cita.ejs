<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Agendar cita MINAE</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f6f9; }
    .card { border: none; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .card-header { background: #1f2937; color: white; border-radius: 14px 14px 0 0; }
  </style>
</head>
<body>

<div class="container mt-5">
  <div class="card">
    <div class="card-header">
      <h3 class="mb-0">📅 Agendar cita para trámite <%= tramite.cr || tramite.id %></h3>
    </div>
    <div class="card-body">
      <form method="POST">
        <!-- Fecha -->
        <div class="mb-3">
          <label class="form-label fw-bold">Fecha de la cita</label>
          <input type="date" name="fecha_cita" class="form-control" value="<%= tramite.fecha_cita || '' %>" required>
        </div>

        <!-- Hora -->
        <div class="mb-3">
          <label class="form-label fw-bold">Hora</label>
          <input type="time" name="hora_cita" class="form-control" value="<%= tramite.hora_cita || '' %>" required>
        </div>

        <!-- Lugar -->
        <div class="mb-3">
          <label class="form-label fw-bold">Lugar</label>
          <input type="text" name="lugar_cita" class="form-control" placeholder="Ej: Sede MINAE San José" value="<%= tramite.lugar_cita || '' %>" required>
        </div>

        <!-- NUEVO: Correo del supervisor (obligatorio) -->
        <div class="mb-3">
          <label class="form-label fw-bold">Correo del supervisor</label>
          <input type="email" name="email_notificacion" class="form-control" placeholder="supervisor@tomza.com" value="<%= tramite.email_notificacion || '' %>" required>
          <div class="form-text text-muted">Se enviarán confirmación y recordatorios a esta dirección.</div>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <button type="submit" class="btn btn-success">💾 Guardar cita</button>
          <a href="/minae" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>

</body>
</html>