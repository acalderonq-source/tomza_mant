<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tomza | Mantenimientos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
</head>

<body>

<%
  const filtrosActuales = filtros || {};
  const hoy = new Date();
  hoy.setHours(0, 0, 0, 0);
  const total = mantenimientos.length;
  const cerrados = mantenimientos.filter(m => m.estado === 'CERRADO').length;
  const pendientes = mantenimientos.filter(m => m.estado !== 'CERRADO').length;
  const atrasados = mantenimientos.filter(m => {
    const fecha = m.fecha_programada ? new Date(m.fecha_programada) : null;
    if (!fecha) return false;
    fecha.setHours(0, 0, 0, 0);
    return m.estado !== 'CERRADO' && fecha < hoy;
  }).length;
  const programadosHoy = mantenimientos.filter(m => {
    const fecha = m.fecha_programada ? new Date(m.fecha_programada) : null;
    if (!fecha) return false;
    fecha.setHours(0, 0, 0, 0);
    return fecha.getTime() === hoy.getTime();
  }).length;
  const tipos = [...new Set(mantenimientos.map(m => m.tipo).filter(Boolean))];
  const prioridades = ['ALTA', 'MEDIA', 'BAJA'];
  const puedeReprogramarLista = typeof puedeReprogramar !== 'undefined' ? puedeReprogramar : ['ADMIN','TALLER'].includes(user.rol);
  const paramsRetorno = new URLSearchParams();
  if (filtrosActuales.filtro) paramsRetorno.set('filtro', filtrosActuales.filtro);
  if (filtrosActuales.placa) paramsRetorno.set('placa', filtrosActuales.placa);
  if (filtrosActuales.tipo) paramsRetorno.set('tipo', filtrosActuales.tipo);
  if (filtrosActuales.prioridad) paramsRetorno.set('prioridad', filtrosActuales.prioridad);
  if (filtrosActuales.mecanico_id) paramsRetorno.set('mecanico_id', filtrosActuales.mecanico_id);
  if (filtrosActuales.fecha_desde) paramsRetorno.set('fecha_desde', filtrosActuales.fecha_desde);
  if (filtrosActuales.fecha_hasta) paramsRetorno.set('fecha_hasta', filtrosActuales.fecha_hasta);
  const returnToMantenimientos = '/mantenimientos' + (paramsRetorno.toString() ? `?${paramsRetorno.toString()}` : '');
%>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-tools"></i> Tomza - Mantenimientos</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/dashboard" class="btn btn-sm btn-outline-light ms-2">Dashboard</a>
    <a href="/logout" class="btn btn-warning btn-sm ms-2">Salir</a>
  </div>
</nav>

<div class="container-fluid py-4">
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="page-heading">
    <div>
      <h1 class="page-title">Mantenimientos preventivos</h1>
      <p class="page-subtitle">Sede: <strong><%= sedeSeleccionada %></strong>. Controla planificación, ejecución y pendientes.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/mantenimientos/dashboard" class="btn btn-primary btn-sm"><i class="bi bi-bar-chart-line"></i> Dashboard IA</a>
      <% if (user.rol === 'MECANICO') { %>
        <a href="/mantenimientos/correctivos/nuevo" class="btn btn-danger btn-sm"><i class="bi bi-plus-circle"></i> Nuevo correctivo</a>
      <% } %>
      <a href="/reportes-supervisores" class="btn btn-outline-primary btn-sm"><i class="bi bi-clipboard-pulse"></i> Reportes supervisores</a>
      <a href="/mantenimientos/correctivos" class="btn btn-outline-danger btn-sm"><i class="bi bi-wrench-adjustable"></i> Correctivos</a>
      <% if (user.rol === 'ADMIN') { %>
        <a href="/mantenimientos/exportar" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Exportar</a>
      <% } %>
    </div>
  </div>

  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Total</div>
      <div class="summary-value"><%= total %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Pendientes</div>
      <div class="summary-value"><%= pendientes %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Atrasados</div>
      <div class="summary-value"><%= atrasados %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Programados hoy</div>
      <div class="summary-value"><%= programadosHoy %></div>
    </div>
  </div>

  <div class="filters-card">
    <form method="GET" action="/mantenimientos" class="row g-3">
      <div class="col-md-2">
        <label class="form-label small">Estado</label>
        <select name="filtro" class="form-select form-select-sm">
          <option value="" <%= !filtrosActuales.filtro ? 'selected' : '' %>>Todos</option>
          <option value="pendientes" <%= filtrosActuales.filtro === 'pendientes' ? 'selected' : '' %>>Pendientes</option>
          <option value="realizados" <%= filtrosActuales.filtro === 'realizados' ? 'selected' : '' %>>Realizados</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Placa</label>
        <input type="text" name="placa" class="form-control form-control-sm" value="<%= filtrosActuales.placa || '' %>" placeholder="Ej: CL1234">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Tipo</label>
        <input type="text" name="tipo" class="form-control form-control-sm" value="<%= filtrosActuales.tipo || '' %>" placeholder="Tipo">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Prioridad</label>
        <select name="prioridad" class="form-select form-select-sm">
          <option value="">Todas</option>
          <% prioridades.forEach(p => { %>
            <option value="<%= p %>" <%= filtrosActuales.prioridad === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Mecánico</label>
        <select name="mecanico_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% (mecanicos || []).forEach(m => { %>
            <option value="<%= m.id %>" <%= String(filtrosActuales.mecanico_id || '') === String(m.id) ? 'selected' : '' %>><%= m.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-dark btn-sm w-100"><i class="bi bi-funnel"></i> Filtrar</button>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <a href="/mantenimientos" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </div>

  <div class="surface-card">
    <div class="d-flex justify-content-between align-items-center p-3 border-bottom flex-wrap gap-2">
      <div>
        <h2 class="page-title fs-5">Listado</h2>
        <p class="page-subtitle"><%= cerrados %> cerrados · <%= pendientes %> pendientes</p>
      </div>
      <% if (puedeReprogramarLista) { %>
        <form method="POST" action="/mantenimientos/reprogramar" id="formReprogramarMasivo" class="d-flex gap-2 flex-wrap align-items-end">
          <input type="hidden" name="return_to" value="<%= returnToMantenimientos %>">
          <div>
            <label class="form-label small mb-1">Nueva fecha</label>
            <input type="date" name="nueva_fecha" class="form-control form-control-sm" required>
          </div>
          <button class="btn btn-sm btn-warning" id="btnReprogramarSeleccionados" disabled>
            <i class="bi bi-calendar2-week"></i> Reprogramar seleccionados
          </button>
        </form>
      <% } %>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <% if (puedeReprogramarLista) { %>
              <th style="width: 42px;"><input type="checkbox" id="seleccionarReprogramar"></th>
            <% } %>
            <th>N° Mant.</th>
            <th>Placa</th>
            <th>Sede</th>
            <th>Tipo</th>
            <th>Fecha</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Mecánicos</th>
            <th>Ejecución</th>
            <th>Pendiente</th>
            <th class="text-end">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (mantenimientos.length === 0) { %>
            <tr><td colspan="<%= puedeReprogramarLista ? 12 : 11 %>" class="empty-state">No hay mantenimientos con los filtros seleccionados.</td></tr>
          <% } %>

          <% mantenimientos.forEach(m => { %>
            <%
              const fecha = m.fecha_programada ? new Date(m.fecha_programada) : null;
              if (fecha) fecha.setHours(0, 0, 0, 0);
              const esAtrasado = fecha && m.estado !== 'CERRADO' && fecha < hoy;
              const esHoy = fecha && fecha.getTime() === hoy.getTime();
            %>
            <tr>
              <% if (puedeReprogramarLista) { %>
                <td data-label="Sel." class="text-center">
                  <% if (m.estado !== 'CERRADO') { %>
                    <input type="checkbox" name="mantenimientos_ids" value="<%= m.id %>" class="check-reprogramar" form="formReprogramarMasivo">
                  <% } %>
                </td>
              <% } %>
              <td data-label="N° Mant."><strong><%= m.numero_mantenimiento || ('MANT-' + m.id) %></strong></td>
              <td data-label="Placa"><strong><%= m.placa %></strong></td>
              <td data-label="Sede"><%= m.sede %></td>
              <td data-label="Tipo"><%= m.tipo %></td>
              <td data-label="Fecha">
                <%= m.fecha_formato %>
                <% if (esAtrasado) { %><span class="badge badge-late ms-1">Atrasado</span><% } %>
                <% if (esHoy) { %><span class="badge badge-today ms-1">Hoy</span><% } %>
              </td>
              <td data-label="Prioridad"><span class="badge badge-priority"><%= m.prioridad || 'MEDIA' %></span></td>
              <td data-label="Estado">
                <span class="badge <%= m.estado === 'CERRADO' ? 'badge-closed' : 'badge-open' %>"><%= m.estado %></span>
              </td>
              <td data-label="Mecánicos"><%= m.mecanicos || '—' %></td>
              <td data-label="Ejecución" class="text-cell"><%= m.estado === 'CERRADO' ? (m.ejecucion || '—') : 'Pendiente' %></td>
              <td data-label="Pendiente" class="text-cell"><%= m.estado === 'CERRADO' ? (m.pendiente || '—') : '—' %></td>
              <td data-label="Acción" class="text-end">
                <div class="dropdown">
                  <button class="btn btn-sm btn-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Acciones</button>
                  <div class="dropdown-menu dropdown-menu-end action-menu p-2">
                    <a href="/mantenimientos/<%= m.id %>" class="dropdown-item"><i class="bi bi-folder2-open me-1"></i> Abrir detalle</a>
                    <% if (m.estado !== 'CERRADO') { %>
                      <% if (puedeReprogramarLista) { %>
                        <button type="button" class="dropdown-item text-warning" data-bs-toggle="modal" data-bs-target="#reprogramar-<%= m.id %>">
                          <i class="bi bi-calendar2-week me-1"></i> Reprogramar
                        </button>
                      <% } %>
                      <a href="/mantenimientos/<%= m.id %>" class="dropdown-item text-success"><i class="bi bi-check-circle me-1"></i> Cerrar mantenimiento</a>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (puedeReprogramarLista) { %>
    <% mantenimientos.forEach(m => { %>
      <% if (m.estado !== 'CERRADO') { %>
        <div class="modal fade" id="reprogramar-<%= m.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <form method="POST" action="/mantenimientos/<%= m.id %>/reprogramar">
                <div class="modal-header">
                  <div>
                    <h5 class="modal-title"><i class="bi bi-calendar2-week me-1"></i> Reprogramar mantenimiento</h5>
                    <small class="text-muted"><%= m.placa %> · <%= m.sede %> · actual: <%= m.fecha_formato %></small>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <input type="hidden" name="return_to" value="<%= returnToMantenimientos %>">
                  <label class="form-label">Nueva fecha</label>
                  <input type="date" name="nueva_fecha" class="form-control" required>
                  <small class="text-muted">Solo cambia la fecha programada. No cierra ni modifica la ejecución.</small>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button class="btn btn-warning">Guardar fecha</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    <% }) %>
  <% } %>
</div>

<script>
  const checksReprogramar = document.querySelectorAll('.check-reprogramar');
  const seleccionarReprogramar = document.getElementById('seleccionarReprogramar');
  const btnReprogramarSeleccionados = document.getElementById('btnReprogramarSeleccionados');

  function actualizarReprogramacion() {
    if (!btnReprogramarSeleccionados) return;
    const seleccionados = Array.from(checksReprogramar).filter(cb => cb.checked).length;
    btnReprogramarSeleccionados.disabled = seleccionados === 0;
  }

  if (seleccionarReprogramar) {
    seleccionarReprogramar.addEventListener('change', () => {
      checksReprogramar.forEach(cb => { cb.checked = seleccionarReprogramar.checked; });
      actualizarReprogramacion();
    });
  }

  checksReprogramar.forEach(cb => {
    cb.addEventListener('change', actualizarReprogramacion);
  });

  actualizarReprogramacion();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
