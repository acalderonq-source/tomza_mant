<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Carnets de trabajadores | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background: #f3f6f9; color: #152238; }
    .page { max-width: 1200px; margin: 28px auto; padding: 0 18px; }
    .badge-card { width: 340px; min-height: 205px; border: 1px solid #cbd5e1; border-radius: 12px; background: white; overflow: hidden; }
    .badge-top { background: #12396a; color: white; padding: 9px 14px; font-weight: 700; letter-spacing: .04em; }
    .badge-content { display: grid; grid-template-columns: 106px 1fr 88px; gap: 10px; align-items: center; padding: 13px; }
    .worker-photo { width: 100px; height: 126px; object-fit: cover; border-radius: 6px; background: #e8edf3; }
    .worker-qr { width: 84px; height: 84px; }
    .worker-name { font-size: 16px; line-height: 1.2; font-weight: 700; overflow-wrap: anywhere; }
    .worker-code { color: #12396a; font-size: 21px; font-weight: 800; }
    .worker-profile { color: #64748b; font-size: 12px; }
    .card-actions { border-top: 1px solid #e5eaf0; padding: 9px 12px; }
    .worker-item { break-inside: avoid; }
    @media print {
      body { background: white; }
      .page { max-width: none; margin: 0; padding: 0; }
      .no-print { display: none !important; }
      .cards { display: grid !important; grid-template-columns: repeat(2, 340px); gap: 10mm; }
      .badge-card { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <main class="page">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4 no-print">
      <div><h1 class="h3 mb-1">Accesos y carnets de trabajadores</h1><p class="text-secondary mb-0">Cree accesos por cédula, cargue fotos y descargue los carnets en PDF.</p></div>
      <div class="d-flex gap-2"><a href="/admin/departamentos" class="btn btn-outline-primary">Accesos por área</a><a href="/dashboard" class="btn btn-outline-secondary">Volver</a><button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir carnets</button></div>
    </div>
    <% if (mensajeAcceso) { %><div class="alert alert-success no-print"><%= mensajeAcceso %></div><% } %>
    <% if (errorAcceso) { %><div class="alert alert-danger no-print"><%= errorAcceso %></div><% } %>
    <section class="card border-0 shadow-sm mb-4 no-print">
      <div class="card-body p-4">
        <h2 class="h5 mb-1">Crear acceso y carnet</h2>
        <p class="small text-secondary mb-3">La persona ingresará con su cédula y el código de trabajador como PIN. Los permisos serán los del perfil seleccionado.</p>
        <form method="post" action="/admin/carnets-trabajadores" class="row g-3">
          <div class="col-md-5"><label class="form-label" for="nuevo-nombre">Nombre completo</label><input class="form-control" id="nuevo-nombre" name="nombre" maxlength="150" required></div>
          <div class="col-md-3"><label class="form-label" for="nueva-cedula">Cédula</label><input class="form-control" id="nueva-cedula" name="cedula" inputmode="numeric" autocomplete="off" maxlength="15" placeholder="9 a 12 dígitos" required></div>
          <div class="col-md-2"><label class="form-label" for="nuevo-codigo">Código trabajador / PIN</label><input class="form-control" id="nuevo-codigo" name="codigo_trabajador" inputmode="numeric" pattern="[0-9]{1,30}" maxlength="30" required></div>
          <div class="col-md-2"><label class="form-label" for="nuevo-perfil">Puesto en carnet</label><input class="form-control" id="nuevo-perfil" name="perfil" maxlength="80" value="Trabajador"></div>
          <div class="col-12">
            <label class="form-label">Perfiles de acceso</label>
            <% if (!perfilesAcceso.length) { %><div class="alert alert-warning mb-0">No hay cuentas de perfil disponibles. Cree primero las cuentas base del sistema.</div><% } else { %>
              <div class="row g-2">
                <% perfilesAcceso.forEach(perfilAcceso => { %>
                  <div class="col-md-6 col-xl-4">
                    <label class="form-check border rounded p-2 ps-5 h-100">
                      <input class="form-check-input" type="checkbox" name="usuario_ids" value="<%= perfilAcceso.id %>">
                      <span class="form-check-label"><strong><%= perfilAcceso.nombre || perfilAcceso.usuario %></strong><span class="d-block small text-secondary"><%= perfilAcceso.usuario %> · <%= perfilAcceso.rol %><%= perfilAcceso.sede ? ` · ${perfilAcceso.sede}` : '' %></span></span>
                    </label>
                  </div>
                <% }) %>
              </div>
              <div class="form-text">Puede asignar varios perfiles; al ingresar, la persona elegirá cuál usar.</div>
            <% } %>
          </div>
          <div class="col-12 d-flex justify-content-end"><button class="btn btn-success fw-bold" <%= !perfilesAcceso.length ? 'disabled' : '' %>><i class="bi bi-person-plus me-1"></i> Crear acceso y carnet</button></div>
        </form>
      </div>
    </section>
    <div class="d-flex justify-content-between align-items-center mb-3 no-print"><h2 class="h5 mb-0">Carnets registrados</h2><span class="badge text-bg-secondary"><%= trabajadores.length %></span></div>
    <div class="cards d-flex flex-wrap gap-3">
      <% trabajadores.forEach(worker => { %>
        <article class="worker-item">
          <div class="badge-card">
            <div class="badge-top">GAS TOMZA · IDENTIFICACIÓN</div>
            <div class="badge-content">
              <% if (worker.tiene_foto) { %>
                <img class="worker-photo" src="/personal/carnet/<%= worker.qr_token %>/foto" alt="Fotografía de <%= worker.nombre %>">
              <% } else { %>
                <div class="worker-photo d-flex align-items-center justify-content-center text-secondary fs-1"><i class="bi bi-person-bounding-box"></i></div>
              <% } %>
              <div><div class="worker-name"><%= worker.nombre %></div><div class="worker-profile mt-1"><%= worker.perfil || 'Trabajador' %></div><div class="small mt-2">PIN / código de trabajador</div><div class="worker-code"><%= worker.codigo_trabajador || 'Pendiente' %></div></div>
              <img class="worker-qr" src="<%= worker.qr %>" alt="Código QR del carnet de <%= worker.nombre %>">
            </div>
            <div class="px-3 pb-2 small text-secondary">Escanee para verificar el carnet en el sistema</div>
          </div>
          <div class="card-actions no-print d-flex align-items-center justify-content-between gap-2">
            <span class="small photo-status" aria-live="polite"><%= worker.tiene_foto ? 'Foto cargada' : 'Falta fotografía' %></span>
            <div class="d-flex gap-1">
              <a class="btn btn-sm btn-outline-secondary" href="/admin/carnets-trabajadores/<%= worker.qr_token %>.pdf"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
              <label class="btn btn-sm btn-outline-primary mb-0"><i class="bi bi-camera"></i> <%= worker.tiene_foto ? 'Cambiar foto' : 'Cargar foto' %><input class="photo-input d-none" type="file" accept="image/jpeg,image/png,image/webp" data-token="<%= worker.qr_token %>"></label>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (!trabajadores.length) { %><div class="alert alert-info">No hay perfiles de trabajadores para generar.</div><% } %>
  </main>
  <script>
    document.querySelectorAll('.photo-input').forEach(input => input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      const item = input.closest('.worker-item');
      const status = item.querySelector('.photo-status');
      status.textContent = 'Procesando fotografía…';
      try {
        const image = await createBadgeImage(file);
        const response = await fetch(`/admin/carnets-trabajadores/${input.dataset.token}/foto`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ foto: image })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No se pudo guardar la fotografía.');
        status.textContent = 'Foto cargada';
        window.location.reload();
      } catch (error) {
        status.textContent = error.message;
      } finally {
        input.value = '';
      }
    }));
    async function createBadgeImage(file) {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(900 / bitmap.width, 1100 / bitmap.height, 1);
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      let quality = .86;
      let data = canvas.toDataURL('image/jpeg', quality);
      while (data.length > 650000 && quality > .45) {
        quality -= .1;
        data = canvas.toDataURL('image/jpeg', quality);
      }
      if (data.length > 650000) throw new Error('La imagen es demasiado grande. Elija otra foto.');
      return data;
    }
  </script>
</body>
</html>
