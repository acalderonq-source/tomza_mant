<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nueva revisión de ruta - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid #16a34a;
    }

    .shell {
      max-width: 960px;
    }

    .hero,
    .panel,
    .check-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .hero {
      padding: 1rem;
    }

    .page-title {
      font-size: 1.45rem;
      font-weight: 900;
      margin: 0;
    }

    .small-muted {
      color: var(--muted);
    }

    .form-label,
    .check-title {
      color: #334155;
      font-size: .84rem;
      font-weight: 850;
    }

    .checks-grid {
      display: grid;
      gap: .8rem;
    }

    .check-card {
      padding: .9rem;
    }

    .check-head {
      align-items: center;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
    }

    .estado-group {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
    }

    .estado-pill {
      border: 1px solid var(--line);
      border-radius: 999px;
      cursor: pointer;
      font-size: .82rem;
      font-weight: 850;
      padding: .4rem .65rem;
    }

    .estado-pill input {
      margin-right: .25rem;
    }

    .sticky-actions {
      background: rgba(243, 246, 250, .96);
      border-top: 1px solid var(--line);
      bottom: 0;
      padding: .8rem 0;
      position: sticky;
    }

    .photo-preview {
      border: 1px solid var(--line);
      border-radius: 10px;
      display: none;
      margin-top: .7rem;
      max-height: 220px;
      max-width: 100%;
      object-fit: cover;
    }

    .item-photo-row {
      border-top: 1px dashed var(--line);
      margin-top: .7rem;
      padding-top: .7rem;
    }

    @media (max-width: 680px) {
      .check-head {
        align-items: flex-start;
        flex-direction: column;
      }

      .estado-group,
      .estado-pill,
      .action-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-clipboard-check me-2"></i>Nueva revisión de ruta</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/revision-ruta" class="btn btn-secondary btn-sm rounded-pill px-3">Volver</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <h1 class="page-title">Revisión de camiones antes de salir</h1>
    <div class="small-muted">Todo inicia en Bien. Cambia solo lo que esté regular, mal o no aplique.</div>
  </section>

  <form method="POST" action="/revision-ruta" id="revisionForm">
    <section class="panel p-3 mb-3">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <label class="form-label">Unidad / placa</label>
          <select name="unidad_id" class="form-select" required>
            <option value="">Seleccione una unidad</option>
            <% unidades.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.placa %> · <%= u.sede %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label">Fecha</label>
          <input type="date" name="fecha" class="form-control" value="<%= hoy %>" required>
        </div>
        <div class="col-12 col-md-3">
          <label class="form-label">Turno</label>
          <select name="turno" class="form-select">
            <option value="Mañana">Mañana</option>
            <option value="Tarde">Tarde</option>
            <option value="Noche">Noche</option>
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Kilometraje</label>
          <input type="number" name="kilometraje" class="form-control" min="0" placeholder="Opcional">
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Apto para salir</label>
          <select name="apto_ruta" class="form-select" id="aptoRuta">
            <option value="1">Si</option>
            <option value="0">No</option>
          </select>
        </div>
      </div>
    </section>

    <section class="checks-grid">
      <% items.forEach(item => { %>
        <article class="check-card">
          <div class="check-head">
            <div class="check-title"><%= item.nombre %></div>
            <div class="estado-group">
              <label class="estado-pill">
                <input type="radio" name="estados[<%= item.clave %>]" value="BIEN" checked> Bien
              </label>
              <label class="estado-pill">
                <input type="radio" name="estados[<%= item.clave %>]" value="REGULAR"> Regular
              </label>
              <label class="estado-pill">
                <input type="radio" name="estados[<%= item.clave %>]" value="MAL" class="estado-mal"> Mal
              </label>
              <label class="estado-pill">
                <input type="radio" name="estados[<%= item.clave %>]" value="NO_APLICA"> No aplica
              </label>
            </div>
          </div>
          <textarea class="form-control mt-2" name="observaciones[<%= item.clave %>]" rows="2" placeholder="Observación de <%= item.nombre.toLowerCase() %>"></textarea>
          <div class="item-photo-row">
            <label class="form-label mb-1">Foto opcional de <%= item.nombre.toLowerCase() %></label>
            <input type="file" class="form-control item-photo-input" accept="image/*" capture="environment" data-clave="<%= item.clave %>">
            <input type="hidden" name="fotos_base64[<%= item.clave %>]" id="foto_base64_<%= item.clave %>">
            <input type="hidden" name="fotos_nombre[<%= item.clave %>]" id="foto_nombre_<%= item.clave %>">
            <input type="hidden" name="fotos_tipo[<%= item.clave %>]" id="foto_tipo_<%= item.clave %>">
            <img id="foto_preview_<%= item.clave %>" class="photo-preview" alt="Vista previa de <%= item.nombre %>">
          </div>
        </article>
      <% }) %>
    </section>

    <section class="panel p-3 mt-3">
      <label class="form-label">Observaciones generales</label>
      <textarea name="observaciones_generales" class="form-control" rows="3" placeholder="Detalle general de la salida, pendiente o instrucción..."></textarea>
    </section>

    <div class="sticky-actions mt-4">
      <div class="d-flex gap-2 justify-content-end flex-wrap">
        <a href="/revision-ruta" class="btn btn-outline-secondary action-btn">Cancelar</a>
        <button class="btn btn-success action-btn"><i class="bi bi-check-circle"></i> Guardar revisión</button>
      </div>
    </div>
  </form>
</main>

<script>
  const form = document.getElementById("revisionForm");
  const aptoRuta = document.getElementById("aptoRuta");

  form.addEventListener("change", () => {
    const tieneMal = Array.from(document.querySelectorAll(".estado-mal")).some(input => input.checked);
    if (tieneMal) {
      aptoRuta.value = "0";
    }
  });

  function limpiarFoto(clave) {
    document.getElementById(`foto_base64_${clave}`).value = "";
    document.getElementById(`foto_nombre_${clave}`).value = "";
    document.getElementById(`foto_tipo_${clave}`).value = "";
    document.getElementById(`foto_preview_${clave}`).style.display = "none";
  }

  function cargarFotoItem(input) {
    const clave = input.dataset.clave;
    const file = input.files && input.files[0];
    if (!file) {
      limpiarFoto(clave);
      return;
    }

    if (!file.type.startsWith("image/")) {
      alert("Seleccione una imagen válida.");
      input.value = "";
      limpiarFoto(clave);
      return;
    }

    const reader = new FileReader();
    reader.onload = event => {
      const img = new Image();
      img.onload = () => {
        const maxSize = 1000;
        let width = img.width;
        let height = img.height;

        if (width > height && width > maxSize) {
          height = Math.round((height * maxSize) / width);
          width = maxSize;
        } else if (height > maxSize) {
          width = Math.round((width * maxSize) / height);
          height = maxSize;
        }

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, width, height);

        const dataUrl = canvas.toDataURL("image/jpeg", 0.7);
        document.getElementById(`foto_base64_${clave}`).value = dataUrl;
        document.getElementById(`foto_nombre_${clave}`).value = file.name || `foto_${clave}.jpg`;
        document.getElementById(`foto_tipo_${clave}`).value = "image/jpeg";
        const preview = document.getElementById(`foto_preview_${clave}`);
        preview.src = dataUrl;
        preview.style.display = "block";
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  }

  document.querySelectorAll(".item-photo-input").forEach(input => {
    input.addEventListener("change", () => cargarFotoItem(input));
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
