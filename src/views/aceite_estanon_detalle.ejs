<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Detalle de estañón | Control de aceite</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root { color-scheme: light; --ink:#172033; --muted:#64748b; --line:#dbe4ef; --navy:#102d59; --blue:#1768d2; }
    body { margin:0; background:#f3f6fa; color:var(--ink); font:15px "Segoe UI",Arial,sans-serif; }
    .topbar { background:var(--navy); color:#fff; }
    .page { max-width:1440px; }
    .panel,.metric { background:#fff; border:1px solid var(--line); border-radius:8px; }
    .panel-head { border-bottom:1px solid var(--line); padding:16px 18px; }
    .metric { padding:16px; height:100%; }
    .metric-label { color:var(--muted); font-size:.75rem; font-weight:800; text-transform:uppercase; }
    .metric-value { margin-top:5px; font-size:1.35rem; font-weight:850; color:var(--navy); }
    .muted { color:var(--muted); }
    .table th { color:#53647a; background:#f8fafc; font-size:.72rem; text-transform:uppercase; white-space:nowrap; }
    .table td { vertical-align:middle; }
    .nowrap { white-space:nowrap; }
    @media (max-width:700px) { .metric-value { font-size:1.12rem; } }
  </style>
</head>
<body>
  <header class="topbar py-3">
    <div class="container-fluid page d-flex align-items-center justify-content-between gap-3">
      <div>
        <div class="small opacity-75">Control de aceite / detalle individual</div>
        <h1 class="h4 fw-bold mb-0">Estañón #<%= estanon.id %></h1>
      </div>
      <a class="btn btn-sm btn-light" href="/aceite"><i class="bi bi-arrow-left me-1"></i>Volver a estañones</a>
    </div>
  </header>

  <main class="container-fluid page py-4">
    <section class="panel mb-3">
      <div class="panel-head d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
          <h2 class="h5 fw-bold mb-1"><%= estanon.descripcion || 'Estañón de aceite' %></h2>
          <div class="muted"><%= etiquetaSede(estanon.sede) %> · Compra: <%= estanon.fecha_compra_formato %><% if (estanon.orden_compra_numero) { %> · Orden <%= estanon.orden_compra_numero %><% } %></div>
        </div>
        <span class="badge <%= estanon.estado === 'ACTIVO' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= Number(estanon.litros_restantes || 0) <= 0.001 ? 'AGOTADO' : estanon.estado %></span>
      </div>
      <div class="p-3 p-lg-4">
        <div class="row g-3">
          <div class="col-6 col-lg-3"><div class="metric"><div class="metric-label">Costo de compra</div><div class="metric-value">₡<%= Number(estanon.monto_total || 0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></div></div></div>
          <div class="col-6 col-lg-3"><div class="metric"><div class="metric-label">Aceite consumido</div><div class="metric-value"><%= Number(estanon.litros_consumidos || 0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %> L</div><div class="small muted"><%= (Number(estanon.litros_consumidos || 0) / galonALitros).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %> gal</div></div></div>
          <div class="col-6 col-lg-3"><div class="metric"><div class="metric-label">Gasto consumido estimado</div><div class="metric-value"><%= gastoConsumido === null ? 'Sin costo' : `₡${Number(gastoConsumido).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2})}` %></div><div class="small muted"><%= costoPorLitro === null ? 'Registre costo para estimarlo' : `₡${Number(costoPorLitro).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2})} por litro` %></div></div></div>
          <div class="col-6 col-lg-3"><div class="metric"><div class="metric-label">Saldo disponible</div><div class="metric-value"><%= Number(estanon.litros_restantes || 0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %> L</div><div class="small muted"><%= (Number(estanon.litros_restantes || 0) / galonALitros).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %> gal · <%= Number(estanon.cantidad_salidas || 0) %> rebajos</div></div></div>
        </div>
      </div>
    </section>

    <section class="panel mb-3">
      <div class="panel-head d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div><h2 class="h6 fw-bold mb-1">Consumo por placa o uso general</h2><div class="small muted">El gasto se distribuye según el costo unitario del aceite registrado en la compra.</div></div>
        <span class="badge text-bg-light"><%= destinos.length %> destino(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Placa / destino</th><th class="text-end">Rebajos</th><th class="text-end">Litros</th><th class="text-end">Galones</th><th class="text-end">Gasto estimado</th></tr></thead>
          <tbody>
            <% if (!destinos.length) { %><tr><td colspan="5" class="text-center muted py-4">Este estañón todavía no registra consumos.</td></tr><% } %>
            <% destinos.forEach(destino => { %>
              <tr><td class="fw-semibold"><%= destino.placa %></td><td class="text-end"><%= destino.movimientos %></td><td class="text-end"><%= Number(destino.litros).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td><td class="text-end"><%= (Number(destino.litros) / galonALitros).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td><td class="text-end fw-bold"><%= costoPorLitro === null ? 'Sin costo' : `₡${Number(destino.gasto).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2})}` %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div><h2 class="h6 fw-bold mb-1">Movimientos del estañón</h2><div class="small muted">Entradas de compra y cada salida registrada.</div></div>
        <span class="badge text-bg-light"><%= movimientos.length %> movimiento(s)</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Placa / destino</th><th>Detalle</th><th class="text-end">Litros</th><th class="text-end">Galones</th><th class="text-end">Gasto estimado</th><th>Registrado por</th></tr></thead>
          <tbody>
            <% if (!movimientos.length) { %><tr><td colspan="8" class="text-center muted py-4">Sin movimientos registrados.</td></tr><% } %>
            <% movimientos.forEach(movimiento => { %>
              <tr>
                <td class="nowrap"><%= movimiento.fecha_formato %></td>
                <td><span class="badge <%= movimiento.tipo === 'ENTRADA' ? 'text-bg-primary' : movimiento.tipo === 'SALIDA' ? 'text-bg-warning' : 'text-bg-secondary' %>"><%= movimiento.tipo %></span></td>
                <td><%= movimiento.placa || (movimiento.tipo === 'ENTRADA' ? etiquetaSede(movimiento.sede) : 'Uso general / sin placa') %></td>
                <td><%= movimiento.descripcion || (movimiento.cambio_aceite_id ? `Cambio de aceite #${movimiento.cambio_aceite_id}` : 'Sin detalle') %><% if (movimiento.km_actual) { %><div class="small muted"><%= Number(movimiento.km_actual).toLocaleString('es-CR') %> km</div><% } %></td>
                <td class="text-end"><%= Number(movimiento.litros || 0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
                <td class="text-end"><%= (Number(movimiento.litros || 0) / galonALitros).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
                <td class="text-end"><%= movimiento.tipo !== 'SALIDA' || movimiento.gasto_estimado === null ? '—' : `₡${Number(movimiento.gasto_estimado).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2})}` %></td>
                <td><%= movimiento.usuario_nombre || 'Sistema' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
