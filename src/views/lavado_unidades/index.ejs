<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lavado de unidades</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background:#eef2f7; color:#0f172a; font-family:"Segoe UI", Roboto, Arial, sans-serif; }
    .topbar { background:#101827; border-bottom:3px solid #0ea5e9; }
    .shell { max-width:1400px; }
    .hero, .panel, .wash-card { background:#fff; border:1px solid #dbe3ef; border-radius:10px; }
    .hero { padding:1rem; }
    .page-title { font-size:1.45rem; font-weight:900; margin:0; }
    .small-muted { color:#64748b; }
    .form-label { color:#334155; font-size:.82rem; font-weight:850; }
    .wash-grid { display:grid; gap:.85rem; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); }
    .wash-card { overflow:hidden; }
    .wash-head { align-items:center; border-bottom:1px solid #e6edf6; display:flex; gap:.75rem; justify-content:space-between; padding:.8rem .9rem; }
    .wash-number { color:#0f172a; font-size:.98rem; font-weight:950; }
    .wash-plate { color:#0b3b82; font-size:1.25rem; font-weight:950; line-height:1.1; }
    .wash-body { padding:.9rem; }
    .cover-photo { border-radius:10px; height:170px; object-fit:cover; width:100%; }
    .photo-strip { display:grid; gap:.4rem; grid-template-columns:repeat(5, 1fr); margin-top:.55rem; }
    .photo-mini { border:1px solid #dbe3ef; border-radius:8px; height:58px; object-fit:cover; width:100%; }
    .photo-label { color:#64748b; font-size:.66rem; font-weight:800; margin-top:.2rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .empty-state { color:#64748b; font-weight:800; padding:1.5rem; text-align:center; }
    @media (max-width:680px) { .wash-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-droplet me-2"></i>Lavado de unidades</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="text-white small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Órdenes de lavado</h1>
        <div class="small-muted">Registro fotográfico por unidad: adelante, lados, atrás y cabina.</div>
      </div>
      <% if (puedeCrear) { %>
        <a href="/lavado-unidades/nuevo" class="btn btn-primary rounded-pill fw-bold"><i class="bi bi-plus-circle me-1"></i>Nuevo lavado</a>
      <% } %>
    </div>
  </section>

  <% if (success) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
  <% } %>

  <section class="panel p-3 mb-3">
    <form method="GET" action="/lavado-unidades" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Placa</label>
        <input type="text" name="placa" class="form-control form-control-sm" value="<%= filtros.placa || '' %>" placeholder="Buscar placa">
      </div>
      <div class="col-md-2">
        <button class="btn btn-dark btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
      </div>
      <div class="col-md-1">
        <a href="/lavado-unidades" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </section>

  <% if (!lavados.length) { %>
    <section class="panel empty-state">No hay órdenes de lavado con los filtros seleccionados.</section>
  <% } else { %>
    <section class="wash-grid">
      <% lavados.forEach(lavado => { %>
        <% const fotos = fotosPorLavado[lavado.id] || []; %>
        <article class="wash-card">
          <div class="wash-head">
            <div>
              <div class="wash-number"><%= lavado.numero_lavado %></div>
              <div class="small-muted"><%= lavado.fecha_formato %> · <%= lavado.sede %></div>
            </div>
            <span class="badge text-bg-info"><%= lavado.fotos_total %> fotos</span>
          </div>
          <div class="wash-body">
            <div class="wash-plate"><%= lavado.placa %></div>
            <div class="small-muted mb-2">Registrado por <%= lavado.creado_por_nombre || 'Taller' %> · <%= lavado.creado_formato %></div>
            <% if (lavado.foto_portada) { %>
              <img class="cover-photo" src="<%= lavado.foto_portada %>" alt="Foto de lavado <%= lavado.placa %>">
            <% } %>
            <div class="photo-strip">
              <% fotos.forEach(foto => { %>
                <div>
                  <img class="photo-mini" src="<%= foto.foto_base64 %>" alt="<%= foto.angulo_nombre %>">
                  <div class="photo-label"><%= foto.angulo_nombre %></div>
                </div>
              <% }) %>
            </div>
            <% if (lavado.observaciones) { %>
              <div class="alert alert-light border mt-3 mb-0"><%= lavado.observaciones %></div>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
