<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registrar lavado semanal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root { --navy:#0d2d62; --ink:#10213d; --muted:#60708a; --line:#d9e2ef; --page:#edf2f8; --green:#138a5b; }
    body { background:var(--page); color:var(--ink); font-family:"Segoe UI", Roboto, Arial, sans-serif; }
    .topbar { background:#0b1830; border-bottom:3px solid #199ed8; }
    .shell { max-width:1120px; }
    .hero, .panel, .photo-card { background:#fff; border:1px solid var(--line); border-radius:8px; }
    .hero { padding:1rem 1.1rem; }
    .eyebrow { color:#087f62; font-size:.72rem; font-weight:900; text-transform:uppercase; }
    .page-title { font-size:1.5rem; font-weight:950; margin:.15rem 0; }
    .small-muted { color:var(--muted); font-size:.84rem; }
    .context-grid { display:grid; gap:.65rem; grid-template-columns:repeat(3, minmax(0,1fr)); margin-top:.8rem; }
    .context-item { background:#f5f8fc; border:1px solid #e2e9f2; border-radius:6px; padding:.55rem .7rem; }
    .context-label { color:var(--muted); font-size:.66rem; font-weight:900; text-transform:uppercase; }
    .context-value { font-size:.86rem; font-weight:850; }
    .form-label, .photo-title { color:#34445f; font-size:.78rem; font-weight:900; text-transform:uppercase; }
    .photo-grid { display:grid; gap:.8rem; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); }
    .photo-card { overflow:hidden; }
    .photo-head { align-items:center; border-bottom:1px solid #e5ebf3; display:flex; gap:.6rem; padding:.7rem .8rem; }
    .photo-number { align-items:center; background:var(--navy); border-radius:999px; color:#fff; display:flex; flex:0 0 28px; font-size:.76rem; font-weight:950; height:28px; justify-content:center; width:28px; }
    .photo-body { padding:.8rem; }
    .photo-preview-wrap { background:#f1f5f9; border:1px dashed #aab8ca; border-radius:6px; display:none; margin-top:.65rem; overflow:hidden; position:relative; }
    .photo-preview { aspect-ratio:4/3; display:block; object-fit:cover; width:100%; }
    .photo-ready { background:var(--green); border-radius:999px; color:#fff; display:none; font-size:.7rem; font-weight:900; padding:.25rem .5rem; position:absolute; right:.45rem; top:.45rem; }
    .requirement { color:var(--muted); font-size:.73rem; margin-top:.45rem; }
    .sticky-actions { background:rgba(237,242,248,.96); border-top:1px solid var(--line); bottom:0; padding:.85rem 0; position:sticky; z-index:10; }
    .counter { color:var(--muted); font-size:.8rem; font-weight:800; }
    .counter strong { color:var(--navy); }
    @media (max-width:700px) {
      .context-grid { grid-template-columns:1fr; }
      .photo-grid { grid-template-columns:1fr; }
      .action-btn { width:100%; }
      .page-title { font-size:1.3rem; }
    }
  </style>
</head>
<body>
<%
  const queryString = values => Object.entries(values)
    .filter(([, value]) => value !== undefined && value !== null && value !== '')
    .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
    .join('&');
  const volverHref = `/lavado-unidades?${queryString({ semana, sede: filtros.sede, segmento: filtros.segmento })}`;
  const unidadesJson = JSON.stringify(unidades).replace(/</g, '\\u003c');
%>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-camera me-2"></i>Registrar lavado</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="text-white small"><%= user.nombre || user.usuario %> · <%= user.rol %></span>
    <a href="<%= volverHref %>" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Volver</a>
  </div>
</nav>

<main class="container-fluid shell py-3 py-lg-4">
  <section class="hero mb-3">
    <div class="eyebrow">Evidencia fotográfica obligatoria</div>
    <h1 class="page-title">Nuevo lavado de unidad</h1>
    <div class="small-muted">La placa desaparecerá de pendientes al guardar las cinco fotografías.</div>
    <div class="context-grid">
      <div class="context-item"><div class="context-label">Semana</div><div class="context-value"><%= semana %> · <%= etiquetaPeriodo %></div></div>
      <div class="context-item"><div class="context-label">CEDIS</div><div class="context-value"><%= filtros.sede === 'TODAS' ? 'Todas las autorizadas' : filtros.sede %></div></div>
      <div class="context-item"><div class="context-label">Segmento</div><div class="context-value"><%= filtros.segmento === 'TODOS' ? 'Todos' : filtros.segmento %></div></div>
    </div>
  </section>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
  <% } %>
  <% if (!puedeRegistrarSemana) { %>
    <div class="alert alert-warning"><i class="bi bi-calendar-x me-1"></i>No se pueden registrar lavados en una semana futura.</div>
  <% } else if (!unidades.length) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>Todas las unidades de esta selección ya tienen lavado registrado esta semana.</div>
  <% } %>

  <form method="POST" action="/lavado-unidades" id="lavadoForm">
    <input type="hidden" name="semana_retorno" value="<%= semana %>">
    <input type="hidden" name="sede_retorno" value="<%= filtros.sede %>">
    <input type="hidden" name="segmento_retorno" value="<%= filtros.segmento %>">

    <section class="panel p-3 mb-3">
      <div class="row g-3">
        <div class="col-12 col-md-7">
          <label class="form-label">Unidad / placa pendiente</label>
          <div data-placa-search data-placa-mode="unidad" data-placa-target="#unidadLavadoId" data-placa-source="#unidadesLavadoData">
            <input type="text" class="form-control form-control-lg" data-placa-input data-placa-autocomplete placeholder="Escriba la placa" required <%= !puedeRegistrarSemana || !unidades.length ? 'disabled' : '' %>>
            <input type="hidden" name="unidad_id" id="unidadLavadoId" required>
            <div data-placa-results></div>
            <div data-placa-selected></div>
          </div>
          <div class="small-muted mt-1"><%= unidades.length %> unidad(es) pendiente(s) disponibles en esta selección.</div>
        </div>
        <div class="col-12 col-md-5">
          <label class="form-label">Fecha real del lavado</label>
          <input type="date" name="fecha" class="form-control form-control-lg" value="<%= fechaPredeterminada %>" min="<%= fechaMinima %>" max="<%= fechaMaxima %>" required <%= !puedeRegistrarSemana ? 'disabled' : '' %>>
        </div>
        <div class="col-12">
          <label class="form-label">Observaciones</label>
          <textarea name="observaciones" class="form-control" rows="2" maxlength="1000" placeholder="Detalle del lavado o condición encontrada en la unidad"></textarea>
        </div>
      </div>
    </section>

    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
      <h2 class="fs-6 fw-bold mb-0">Fotografías requeridas</h2>
      <div class="counter"><strong id="photoCount">0</strong> de <%= fotos.length %> listas</div>
    </div>

    <section class="photo-grid">
      <% fotos.forEach((foto, index) => { %>
        <article class="photo-card">
          <div class="photo-head">
            <span class="photo-number"><%= index + 1 %></span>
            <div class="photo-title"><%= foto.nombre %></div>
          </div>
          <div class="photo-body">
            <input type="file" class="form-control lavado-photo-input" accept="image/*" capture="environment" data-clave="<%= foto.clave %>" required <%= !puedeRegistrarSemana ? 'disabled' : '' %>>
            <input type="hidden" name="fotos_base64[<%= foto.clave %>]" id="foto_base64_<%= foto.clave %>">
            <input type="hidden" name="fotos_nombre[<%= foto.clave %>]" id="foto_nombre_<%= foto.clave %>">
            <input type="hidden" name="fotos_tipo[<%= foto.clave %>]" id="foto_tipo_<%= foto.clave %>">
            <div id="foto_wrap_<%= foto.clave %>" class="photo-preview-wrap">
              <img id="foto_preview_<%= foto.clave %>" class="photo-preview" alt="Vista previa de <%= foto.nombre %>">
              <span id="foto_ready_<%= foto.clave %>" class="photo-ready"><i class="bi bi-check-circle me-1"></i>Lista</span>
            </div>
            <div class="requirement">Use una fotografía nueva, clara y correspondiente a este ángulo.</div>
          </div>
        </article>
      <% }) %>
    </section>

    <div class="sticky-actions mt-4">
      <div class="d-flex gap-2 justify-content-end flex-wrap">
        <a href="<%= volverHref %>" class="btn btn-outline-secondary action-btn">Cancelar</a>
        <button id="submitButton" class="btn btn-primary action-btn" <%= !puedeRegistrarSemana || !unidades.length ? 'disabled' : '' %>><i class="bi bi-save me-1"></i>Guardar lavado semanal</button>
      </div>
    </div>
  </form>
</main>

<script type="application/json" id="unidadesLavadoData"><%- unidadesJson %></script>
<script>
  const form = document.getElementById("lavadoForm");
  const submitButton = document.getElementById("submitButton");
  const photoCount = document.getElementById("photoCount");

  function actualizarContador() {
    const listas = [...document.querySelectorAll("[id^='foto_base64_']")].filter(input => input.value).length;
    photoCount.textContent = listas;
  }

  function limpiarFoto(clave) {
    document.getElementById(`foto_base64_${clave}`).value = "";
    document.getElementById(`foto_nombre_${clave}`).value = "";
    document.getElementById(`foto_tipo_${clave}`).value = "";
    const preview = document.getElementById(`foto_preview_${clave}`);
    preview.removeAttribute("src");
    document.getElementById(`foto_wrap_${clave}`).style.display = "none";
    document.getElementById(`foto_ready_${clave}`).style.display = "none";
    actualizarContador();
  }

  function cargarFoto(input) {
    const clave = input.dataset.clave;
    const file = input.files && input.files[0];
    if (!file) return limpiarFoto(clave);
    if (!file.type.startsWith("image/")) {
      alert("Seleccione una imagen válida.");
      input.value = "";
      return limpiarFoto(clave);
    }

    const reader = new FileReader();
    reader.onload = event => {
      const img = new Image();
      img.onload = () => {
        const maxSize = 1100;
        let width = img.width;
        let height = img.height;
        if (width > height && width > maxSize) {
          height = Math.round((height * maxSize) / width);
          width = maxSize;
        } else if (height > maxSize) {
          width = Math.round((width * maxSize) / height);
          height = maxSize;
        }

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const context = canvas.getContext("2d");
        context.drawImage(img, 0, 0, width, height);

        const dataUrl = canvas.toDataURL("image/jpeg", 0.7);
        document.getElementById(`foto_base64_${clave}`).value = dataUrl;
        document.getElementById(`foto_nombre_${clave}`).value = file.name || `lavado_${clave}.jpg`;
        document.getElementById(`foto_tipo_${clave}`).value = "image/jpeg";
        document.getElementById(`foto_preview_${clave}`).src = dataUrl;
        document.getElementById(`foto_wrap_${clave}`).style.display = "block";
        document.getElementById(`foto_ready_${clave}`).style.display = "inline-flex";
        actualizarContador();
      };
      img.onerror = () => {
        alert("No fue posible leer esa imagen.");
        input.value = "";
        limpiarFoto(clave);
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  }

  document.querySelectorAll(".lavado-photo-input").forEach(input => {
    input.addEventListener("change", () => cargarFoto(input));
  });

  form.addEventListener("submit", event => {
    const unidadId = document.getElementById("unidadLavadoId").value;
    const faltantes = [...document.querySelectorAll("[id^='foto_base64_']")].filter(input => !input.value);
    if (!unidadId || faltantes.length) {
      event.preventDefault();
      alert(!unidadId ? "Seleccione una placa pendiente de la lista." : "Debe subir las cinco fotografías antes de guardar.");
      return;
    }
    submitButton.disabled = true;
    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando evidencia...';
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
