<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gas Tomza | Inicio empresarial</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="/css/inicio-empresa.css?v=1"><script src="/js/inicio-empresa.js?v=1" defer></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/css/sedes-mapa.css?v=2">
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" defer></script>
<script src="/js/sedes-mapa.js?v=2" defer></script></head>
<body class="inicio-empresa">
<a class="skip-link" href="#contenido">Ir al contenido</a>
<aside class="empresa-menu" id="departamentos-menu">
<a class="empresa-logo" href="<%= user ? '/inicio' : '/' %>" aria-label="Gas Tomza, inicio"><img src="/img/logo_tomza.jpg" alt="Gas Tomza"><span>SISTEMA EMPRESARIAL</span></a>
<p class="menu-caption">DEPARTAMENTOS</p>
<nav aria-label="Departamentos"><a class="menu-inicio" href="<%= user ? '/inicio' : '/' %>" aria-current="page"><i class="bi bi-house-door-fill" aria-hidden="true"></i><span>Inicio</span></a>
<% departamentos.forEach(d=>{ %><div class="department-entry" data-name="<%= d.nombre %>">
<% if(user && d.permitido){ %><form method="post" action="/departamento/activo"><input type="hidden" name="departamento" value="<%= d.key %>"><button type="submit" class="department-link"><i class="bi <%= d.icono %>" aria-hidden="true"></i><span><%= d.nombre %></span><i class="bi bi-chevron-right trail" aria-hidden="true"></i></button></form>
<% }else if(!user){ %><a class="department-link" href="/login?departamento=<%= d.key %>&amp;next=<%= encodeURIComponent(next || '/inicio') %>"><i class="bi <%= d.icono %>" aria-hidden="true"></i><span><%= d.nombre %></span><i class="bi bi-chevron-right trail" aria-hidden="true"></i></a>
<% }else{ %><button type="button" class="department-link" disabled title="Sin acceso asignado"><i class="bi <%= d.icono %>" aria-hidden="true"></i><span><%= d.nombre %></span><i class="bi bi-lock trail" aria-hidden="true"></i><span class="sr-only">Sin acceso asignado</span></button><% } %>
</div><% }); %></nav>
<p class="menu-empty" hidden>No hay departamentos con ese nombre.</p>
<footer class="menu-footer"><% if(user){ %><a href="/logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Cerrar sesión</a><% }else{ %><a href="/solicitar-ingreso"><i class="bi bi-person-plus" aria-hidden="true"></i>Solicitar ingreso</a><a href="/portal-proveedores/login"><i class="bi bi-building" aria-hidden="true"></i>Portal de proveedores</a><% } %></footer>
</aside>
<div class="empresa-workspace"><header class="empresa-topbar"><button type="button" class="menu-toggle" aria-controls="departamentos-menu" aria-expanded="false" aria-label="Abrir departamentos"><i class="bi bi-list" aria-hidden="true"></i></button>
<strong>Sistema de Gestión Empresarial</strong><div class="empresa-search"><i class="bi bi-search" aria-hidden="true"></i><label class="sr-only" for="buscar-departamento">Buscar departamento</label><input type="search" id="buscar-departamento" placeholder="Buscar departamento…" autocomplete="off"></div>
<div class="empresa-account"><i class="bi bi-person-circle" aria-hidden="true"></i><span><%= user ? user.nombre || user.usuario : 'Acceso interno' %><small><%= user ? user.rol.replace(/_/g,' ') : 'Gas Tomza' %></small></span></div></header>
<main id="contenido"><section class="empresa-welcome"><div class="welcome-copy"><p class="eyebrow">GAS TOMZA</p><h1>Bienvenido al <br>sistema empresarial</h1><p class="welcome-subtitle"><%= user ? 'Seleccioná un departamento para comenzar.' : 'Seleccioná tu departamento para iniciar sesión.' %></p><div class="welcome-rule"></div>
<% if(user){ %><div class="welcome-identity"><span class="identity-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span><div><strong><%= user.nombre || user.usuario %></strong><span><%= departamentos.filter(d=>d.permitido).length %> departamento(s) autorizado(s)</span></div></div><% } %>
</div>
<section class="sedes-panel" aria-labelledby="sedes-titulo">
<header class="sedes-header"><div><p class="eyebrow">PRESENCIA NACIONAL</p><h2 id="sedes-titulo">Conectados en Costa Rica</h2></div><span class="sedes-count"><span></span>1 sede</span></header>
<div class="sedes-map-stage">
<div id="sedes-mapa" aria-label="Mapa interactivo de sedes de Gas Tomza en Costa Rica"></div>
<button type="button" id="mapa-pais" class="mapa-country" title="Ver Costa Rica completa" aria-label="Ver Costa Rica" disabled><i class="bi bi-globe-americas" aria-hidden="true"></i>Costa Rica<i class="bi bi-arrows-angle-expand" aria-hidden="true"></i></button>
<div class="mapa-zoom" aria-label="Controles del mapa"><button type="button" id="mapa-acercar" title="Acercar mapa" aria-label="Acercar mapa" disabled><i class="bi bi-plus-lg" aria-hidden="true"></i></button><button type="button" id="mapa-alejar" title="Alejar mapa" aria-label="Alejar mapa" disabled><i class="bi bi-dash-lg" aria-hidden="true"></i></button></div>
</div>
<p id="mapa-estado" class="mapa-estado" role="status">Cargando mapa…</p>
<footer class="sedes-footer"><button type="button" id="mapa-cartago" title="Centrar sede Cartago" disabled><span class="sede-symbol"><i class="bi bi-buildings" aria-hidden="true"></i></span><span><small>SEDE GAS TOMZA</small><strong>Cartago</strong><span class="sede-company">Gas Tomza de Costa Rica S.A.</span></span></button>
<a href="https://www.bing.com/maps?cp=9.877662658691406~-83.94295501708984&amp;lvl=16&amp;sp=point.9.877662658691406_-83.94295501708984_Gas%20Tomza%20Cartago" target="_blank" rel="noopener noreferrer">Ver ubicación <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></footer>
<noscript><p>Active JavaScript para usar el mapa interactivo. Puede abrir la ubicación con el enlace anterior.</p></noscript>
</section>
</section><footer class="welcome-footer"><span></span>Gestión integrada en un solo lugar</footer></main></div>
</body></html>
