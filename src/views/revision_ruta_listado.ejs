<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Revisión de salida a ruta - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --card: #fff;
      --ink: #111827;
      --muted: #64748b;
      --line: #dbe3ef;
      --dark: #111827;
      --green: #16a34a;
      --red: #dc2626;
      --amber: #d97706;
      --blue: #2563eb;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .topbar {
      background: var(--dark);
      border-bottom: 3px solid var(--green);
    }

    .shell {
      max-width: 1180px;
    }

    .hero,
    .panel,
    .revision-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .hero {
      padding: 1rem;
    }

    .page-title {
      font-size: 1.45rem;
      font-weight: 900;
      margin: 0;
    }

    .small-muted {
      color: var(--muted);
    }

    .summary-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .summary-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: .9rem;
    }

    .summary-label {
      color: var(--muted);
      font-size: .75rem;
      font-weight: 850;
      text-transform: uppercase;
    }

    .summary-value {
      font-size: 1.65rem;
      font-weight: 900;
      line-height: 1.1;
      margin-top: .2rem;
    }

    .revision-list {
      display: grid;
      gap: .8rem;
    }

    .revision-card {
      padding: 1rem;
    }

    .revision-head {
      align-items: flex-start;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
    }

    .plate {
      font-size: 1.08rem;
      font-weight: 900;
    }

    .quick-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: .85rem;
    }

    .quick-box {
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: .65rem;
    }

    .quick-label {
      color: #52637a;
      font-size: .7rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .quick-value {
      font-weight: 850;
      margin-top: .15rem;
    }

    .status-pill {
      border-radius: 999px;
      font-weight: 900;
      padding: .45rem .7rem;
      white-space: nowrap;
    }

    .status-ok { background: #dcfce7; color: #166534; }
    .status-bad { background: #fee2e2; color: #991b1b; }
    .badge-BIEN { background: #dcfce7; color: #166534; }
    .badge-REGULAR { background: #fef3c7; color: #92400e; }
    .badge-MAL { background: #fee2e2; color: #991b1b; }
    .badge-NO_APLICA { background: #e5e7eb; color: #374151; }

    .detail-row {
      border-top: 1px solid #edf2f7;
      display: grid;
      gap: .7rem;
      grid-template-columns: 220px 110px 1fr;
      padding: .65rem 0;
    }

    .empty-state {
      color: var(--muted);
      font-weight: 750;
      padding: 2rem;
      text-align: center;
    }

    .revision-photo {
      border: 1px solid var(--line);
      border-radius: 10px;
      margin-top: .85rem;
      max-height: 260px;
      max-width: 100%;
      object-fit: cover;
    }

    .detail-photo {
      border: 1px solid var(--line);
      border-radius: 8px;
      display: block;
      margin-top: .4rem;
      max-height: 180px;
      max-width: 100%;
      object-fit: cover;
    }

    @media (max-width: 820px) {
      .summary-grid,
      .quick-grid {
        grid-template-columns: 1fr 1fr;
      }

      .detail-row {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .summary-grid,
      .quick-grid {
        grid-template-columns: 1fr;
      }

      .revision-head {
        flex-direction: column;
      }

      .btn-mobile {
        width: 100%;
      }
    }
  </style>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-clipboard-check me-2"></i>Salida a ruta</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/dashboard" class="btn btn-warning btn-sm rounded-pill px-3">Dashboard</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Revisión de camiones antes de ruta</h1>
        <div class="small-muted">Historial diario por placa, sede, responsable y puntos revisados.</div>
      </div>
      <% if (puedeCrear) { %>
        <a href="/revision-ruta/nuevo" class="btn btn-success rounded-pill px-3 btn-mobile">
          <i class="bi bi-plus-circle"></i> Nueva revisión
        </a>
      <% } %>
    </div>
  </section>

  <section class="summary-grid mb-3">
    <div class="summary-card">
      <div class="summary-label">Revisiones</div>
      <div class="summary-value"><%= resumen.total %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Aptas</div>
      <div class="summary-value text-success"><%= resumen.aptas %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">No aptas</div>
      <div class="summary-value text-danger"><%= resumen.noAptas %></div>
    </div>
  </section>

  <section class="panel p-3 mb-3">
    <form method="GET" action="/revision-ruta" class="row g-2 align-items-end">
      <div class="col-12 col-md-3">
        <label class="form-label fw-bold">Fecha</label>
        <input type="date" class="form-control" name="fecha" value="<%= filtros.fecha || '' %>">
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label fw-bold">Placa</label>
        <input class="form-control" name="placa" value="<%= filtros.placa || '' %>" placeholder="Buscar placa">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label fw-bold">Estado</label>
        <select class="form-select" name="estado">
          <option value="">Todos</option>
          <option value="apto" <%= filtros.estado === 'apto' ? 'selected' : '' %>>Apto para ruta</option>
          <option value="no_apto" <%= filtros.estado === 'no_apto' ? 'selected' : '' %>>No apto</option>
        </select>
      </div>
      <div class="col-12 col-md-2 d-grid">
        <button class="btn btn-dark"><i class="bi bi-funnel"></i> Filtrar</button>
      </div>
      <% if (filtros.placa || filtros.estado) { %>
        <div class="col-12">
          <a href="/revision-ruta?fecha=<%= filtros.fecha || '' %>" class="btn btn-sm btn-outline-secondary">Limpiar placa/estado</a>
        </div>
      <% } %>
    </form>
  </section>

  <section class="revision-list">
    <% if (!revisiones.length) { %>
      <div class="panel empty-state">No hay revisiones registradas para estos filtros.</div>
    <% } %>

    <% revisiones.forEach(r => { %>
      <article class="revision-card">
        <div class="revision-head">
          <div>
            <div class="plate"><%= r.placa %></div>
            <div class="small-muted"><%= r.sede %> · <%= r.fecha_formato %> · <%= r.creado_por_nombre || 'Usuario' %></div>
          </div>
          <span class="status-pill <%= Number(r.apto_ruta) === 1 ? 'status-ok' : 'status-bad' %>">
            <%= Number(r.apto_ruta) === 1 ? 'Apto para ruta' : 'No apto' %>
          </span>
        </div>

        <div class="quick-grid">
          <div class="quick-box">
            <div class="quick-label">Turno</div>
            <div class="quick-value"><%= r.turno || '-' %></div>
          </div>
          <div class="quick-box">
            <div class="quick-label">Kilometraje</div>
            <div class="quick-value"><%= r.kilometraje || '-' %></div>
          </div>
          <div class="quick-box">
          <div class="quick-label">Puntos mal</div>
            <div class="quick-value text-danger"><%= r.malos || 0 %></div>
          </div>
          <div class="quick-box">
            <div class="quick-label">Regulares</div>
            <div class="quick-value text-warning"><%= r.regulares || 0 %></div>
          </div>
        </div>

        <% if (r.observaciones_generales) { %>
          <div class="alert alert-light border mt-3 mb-0"><strong>Observación:</strong> <%= r.observaciones_generales %></div>
        <% } %>

        <% if (r.foto_base64) { %>
          <div>
            <img class="revision-photo" src="<%= r.foto_base64 %>" alt="Foto de la revisión <%= r.placa %>">
          </div>
        <% } %>

        <div class="mt-3">
          <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#detalle_<%= r.id %>">
            Ver detalle
          </button>
        </div>

        <div class="collapse mt-2" id="detalle_<%= r.id %>">
          <% (detallesPorRevision[r.id] || []).forEach(d => { %>
            <div class="detail-row">
              <div class="fw-bold"><%= d.item_nombre %></div>
              <div><span class="badge badge-<%= d.estado %>"><%= etiquetaEstado(d.estado) %></span></div>
              <div class="small-muted">
                <%= d.observacion || '-' %>
                <% if (d.foto_base64) { %>
                  <img class="detail-photo" src="<%= d.foto_base64 %>" alt="Foto de <%= d.item_nombre %>">
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </article>
    <% }) %>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
