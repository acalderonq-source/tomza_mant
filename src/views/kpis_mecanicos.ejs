<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>KPIs de Mecánicos</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza | KPIs de Mecánicos</span>
  <div class="text-white">
    <%= user.usuario %> (ADMIN)
    <a href="/dashboard" class="btn btn-warning btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">

  <h4 class="mb-3">📊 Productividad por Mecánico</h4>

  <!-- FILTRO DE FECHAS -->
  <form class="row g-2 mb-3" method="GET" action="/kpis/mecanicos">
    <div class="col-12 col-md-3">
      <label class="form-label">Desde</label>
      <input type="date" name="desde" value="<%= desde || '' %>" class="form-control" required>
    </div>
    <div class="col-12 col-md-3">
      <label class="form-label">Hasta</label>
      <input type="date" name="hasta" value="<%= hasta || '' %>" class="form-control" required>
    </div>
    <div class="col-12 col-md-3">
      <label class="form-label">Sede</label>
      <input type="text" class="form-control" value="<%= sede %>" disabled>
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end">
      <button class="btn btn-primary w-100">Filtrar</button>
    </div>
  </form>

  <!-- TABLA KPI -->
  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Mecánico</th>
          <th>Preventivos</th>
          <th>Correctivos</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% if (!totales || totales.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center text-muted">
              No hay datos para el rango seleccionado
            </td>
          </tr>
        <% } %>

        <% totales.forEach(row => { %>
          <tr>
            <td><strong><%= row.mecanico %></strong></td>
            <td class="text-center"><%= row.preventivos || 0 %></td>
            <td class="text-center"><%= row.correctivos || 0 %></td>
            <td class="text-center">
              <span class="badge bg-success fs-6">
                <%= row.total_trabajos || 0 %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- LEYENDA -->
  <div class="alert alert-secondary mt-3 small">
    • Preventivos: mantenimientos cerrados en el rango de fechas  
    • Correctivos: trabajos correctivos creados en el rango  
    • Total: suma de ambos  
  </div>

</div>

</body>
</html>
