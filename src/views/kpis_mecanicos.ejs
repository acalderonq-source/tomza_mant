<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KPIs de Mecánicos - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #eef3f9;
      --card: #fff;
      --dark: #0f1b2d;
      --blue: #123f86;
      --red: #e2252a;
      --muted: #667085;
      --line: #d9e2ef;
      --ink: #0b1728;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .92rem;
    }

    .topbar {
      background: linear-gradient(120deg, #102d62 0%, #123f86 58%, #f3b20b 58%, #f3b20b 68%, #e2252a 68%, #b8183d 100%);
      border-bottom: 4px solid #f3b20b;
      color: #fff;
    }

    .shell { max-width: 1560px; margin: 0 auto; }

    .hero {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: 0 18px 45px rgba(15, 27, 45, .08);
      padding: 1rem;
    }

    .hero-title {
      font-size: 1.6rem;
      font-weight: 950;
      letter-spacing: .01em;
      margin: 0;
    }

    .hero-subtitle { color: var(--muted); margin: .15rem 0 0; }

    .filter-card,
    .kpi-card,
    .panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      box-shadow: 0 12px 28px rgba(15, 27, 45, .06);
    }

    .filter-card { padding: .9rem; }

    .form-label {
      color: #344054;
      font-size: .72rem;
      font-weight: 850;
      letter-spacing: .02em;
      text-transform: uppercase;
    }

    .kpi-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .kpi-card {
      border-top: 4px solid var(--blue);
      padding: .85rem;
    }

    .kpi-label {
      color: var(--muted);
      font-size: .72rem;
      font-weight: 850;
      text-transform: uppercase;
    }

    .kpi-value {
      font-size: 1.55rem;
      font-weight: 950;
      line-height: 1.1;
      margin-top: .15rem;
    }

    .kpi-foot {
      color: var(--muted);
      font-size: .78rem;
      margin-top: .2rem;
    }

    .panel-header {
      align-items: center;
      background: #123f86;
      border-radius: 12px 12px 0 0;
      color: #fff;
      display: flex;
      justify-content: space-between;
      padding: .75rem .9rem;
    }

    .panel-title {
      font-size: 1rem;
      font-weight: 950;
      margin: 0;
    }

    .panel-body { padding: .9rem; }

    .family-grid {
      display: grid;
      gap: .7rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .family-card {
      border: 1px solid var(--line);
      border-left: 5px solid var(--family-color, #64748b);
      border-radius: 10px;
      padding: .7rem;
    }

    .family-name { font-weight: 900; }
    .family-meta { color: var(--muted); font-size: .8rem; }

    .specialty-pill {
      background: #eaf1ff;
      border: 1px solid #c7d7fe;
      border-radius: 999px;
      color: #123f86;
      display: inline-flex;
      font-size: .76rem;
      font-weight: 850;
      padding: .25rem .55rem;
    }

    .work-chip {
      background: #f6f8fb;
      border: 1px solid var(--line);
      border-radius: 8px;
      display: inline-flex;
      font-size: .78rem;
      margin: .12rem .15rem .12rem 0;
      padding: .22rem .45rem;
    }

    .table thead th {
      background: #102d62;
      color: #fff;
      font-size: .74rem;
      letter-spacing: .02em;
      text-transform: uppercase;
    }

    .table td { vertical-align: middle; }

    .progress {
      background: #edf2f7;
      height: 10px;
    }

    .empty-state {
      border: 1px dashed #b8c4d6;
      border-radius: 12px;
      color: var(--muted);
      padding: 1.5rem;
      text-align: center;
    }

    @media (max-width: 1100px) {
      .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .family-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 700px) {
      .kpi-grid, .family-grid { grid-template-columns: 1fr; }
      .hero-title { font-size: 1.25rem; }
    }
  </style>
</head>
<body>
<%
  const rows = Array.isArray(totales) ? totales : [];
  const dataResumen = resumen || {};
  const dataFamilias = Array.isArray(familias) ? familias : [];
  const nf = value => Number(value || 0).toLocaleString('es-CR');
%>

<nav class="topbar px-3 py-2">
  <div class="shell d-flex justify-content-between align-items-center gap-2 flex-wrap">
    <div class="fw-bold"><i class="bi bi-speedometer2 me-2"></i>KPIs de Mecánicos</div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="small"><%= user.usuario %> · <%= user.rol %></span>
      <a href="/mantenimientos/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Dashboard mantenimientos</a>
      <a href="/dashboard" class="btn btn-warning btn-sm rounded-pill px-3">Inicio</a>
    </div>
  </div>
</nav>

<main class="container-fluid shell py-3">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="hero-title">Productividad y especialidad del taller</h1>
        <p class="hero-subtitle">Mide preventivos, correctivos y el tipo de trabajo donde más participa cada mecánico.</p>
      </div>
      <div class="text-end">
        <div class="form-label mb-1">Sede actual</div>
        <div class="fw-black fs-5"><%= sedeTexto || sede || 'Todas' %></div>
      </div>
    </div>
  </section>

  <section class="filter-card mb-3">
    <form class="row g-3 align-items-end" method="GET" action="/kpis/mecanicos">
      <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="<%= desde || '' %>" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="<%= hasta || '' %>" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label">Sede</label>
        <input type="text" class="form-control" value="<%= sedeTexto || sede || 'Todas' %>" disabled>
      </div>
      <div class="col-md-3 d-grid">
        <button class="btn btn-primary fw-bold">Filtrar KPIs</button>
      </div>
    </form>
  </section>

  <section class="kpi-grid mb-3">
    <div class="kpi-card">
      <div class="kpi-label">Trabajos totales</div>
      <div class="kpi-value"><%= nf(dataResumen.totalTrabajos) %></div>
      <div class="kpi-foot">Preventivos + correctivos</div>
    </div>
    <div class="kpi-card" style="border-top-color:#16a34a">
      <div class="kpi-label">Preventivos cerrados</div>
      <div class="kpi-value"><%= nf(dataResumen.totalPreventivos) %></div>
      <div class="kpi-foot">Mantenimientos finalizados</div>
    </div>
    <div class="kpi-card" style="border-top-color:#dc2626">
      <div class="kpi-label">Correctivos</div>
      <div class="kpi-value"><%= nf(dataResumen.totalCorrectivos) %></div>
      <div class="kpi-foot">Trabajos registrados</div>
    </div>
    <div class="kpi-card" style="border-top-color:#7c3aed">
      <div class="kpi-label">Mecánicos activos</div>
      <div class="kpi-value"><%= nf(dataResumen.mecanicosActivos) %></div>
      <div class="kpi-foot">Con trabajo en el rango</div>
    </div>
    <div class="kpi-card" style="border-top-color:#f3b20b">
      <div class="kpi-label">Promedio por mecánico</div>
      <div class="kpi-value"><%= nf(dataResumen.promedioPorMecanico) %></div>
      <div class="kpi-foot"><%= nf(dataResumen.duplicadosOmitidos) %> repetido(s) omitido(s)</div>
    </div>
  </section>

  <section class="panel mb-3">
    <div class="panel-header">
      <h2 class="panel-title">Distribución por especialidad</h2>
      <span class="badge bg-light text-dark">Sin repetir reportes exactos</span>
    </div>
    <div class="panel-body">
      <% if (!dataFamilias.length) { %>
        <div class="empty-state">No hay trabajos para analizar en ese rango.</div>
      <% } else { %>
        <div class="family-grid">
          <% dataFamilias.forEach(f => { %>
            <div class="family-card" style="--family-color:<%= f.color %>">
              <div class="d-flex justify-content-between gap-2">
                <div class="family-name"><%= f.nombre %></div>
                <strong><%= nf(f.total) %></strong>
              </div>
              <div class="family-meta"><%= f.porcentaje %>% de los trabajos del periodo</div>
              <div class="progress mt-2">
                <div class="progress-bar" style="width:<%= f.porcentaje %>%; background:<%= f.color %>"></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Especialidad de cada mecánico</h2>
      <span class="badge bg-light text-dark"><%= nf(rows.length) %> mecánico(s)</span>
    </div>
    <div class="panel-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Mecánico</th>
              <th>Sede</th>
              <th class="text-center">Preventivos</th>
              <th class="text-center">Correctivos</th>
              <th class="text-center">Total</th>
              <th>Especialidad principal</th>
              <th>Trabajos más repetidos</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">No hay datos para el rango seleccionado.</td>
              </tr>
            <% } %>
            <% rows.forEach(row => { %>
              <tr>
                <td>
                  <strong><%= row.mecanico %></strong>
                  <div class="text-muted small"><%= row.especialidad_porcentaje %>% concentrado en su especialidad</div>
                </td>
                <td><%= row.sede || '-' %></td>
                <td class="text-center"><span class="badge bg-success"><%= nf(row.preventivos) %></span></td>
                <td class="text-center"><span class="badge bg-danger"><%= nf(row.correctivos) %></span></td>
                <td class="text-center"><span class="badge bg-dark fs-6"><%= nf(row.total_trabajos) %></span></td>
                <td>
                  <span class="specialty-pill"><%= row.especialidad %></span>
                  <div class="mt-2">
                    <% (row.especialidades || []).forEach(esp => { %>
                      <span class="work-chip"><%= esp.nombre %>: <strong class="ms-1"><%= nf(esp.total) %></strong></span>
                    <% }) %>
                  </div>
                </td>
                <td>
                  <% (row.trabajos_frecuentes || []).forEach(trabajo => { %>
                    <span class="work-chip"><%= trabajo.nombre %> <strong class="ms-1">(<%= nf(trabajo.total) %>)</strong></span>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>
</body>
</html>
