<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>KPIs de Mecánicos</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

.kpi-card{
border-left:6px solid #0d6efd;
}

.kpi-number{
font-size:26px;
font-weight:bold;
}

</style>

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">

<span class="navbar-brand">
Tomza | KPIs de Mecánicos
</span>

<div class="text-white">
<%= user.usuario %> (ADMIN)
<a href="/dashboard" class="btn btn-warning btn-sm ms-2">Volver</a>
</div>

</nav>

<div class="container mt-4">

<h4 class="mb-3">📊 Productividad por Mecánico</h4>

<form class="row g-2 mb-4" method="GET" action="/kpis/mecanicos">

<div class="col-md-3">
<label class="form-label">Desde</label>
<input type="date" name="desde" value="<%= desde || '' %>" class="form-control" required>
</div>

<div class="col-md-3">
<label class="form-label">Hasta</label>
<input type="date" name="hasta" value="<%= hasta || '' %>" class="form-control" required>
</div>

<div class="col-md-3">
<label class="form-label">Sede</label>
<input type="text" class="form-control" value="<%= sede %>" disabled>
</div>

<div class="col-md-3 d-flex align-items-end">
<button class="btn btn-primary w-100">Filtrar</button>
</div>

</form>

<%
let totalPreventivos = 0
let totalCorrectivos = 0
let totalTrabajos = 0

totales.forEach(t=>{
totalPreventivos += t.preventivos || 0
totalCorrectivos += t.correctivos || 0
totalTrabajos += t.total_trabajos || 0
})

let top = totales[0]
%>

<div class="row mb-4">

<div class="col-md-3">
<div class="card shadow-sm p-3 kpi-card">
<div class="text-muted">Preventivos</div>
<div class="kpi-number text-primary"><%= totalPreventivos %></div>
</div>
</div>

<div class="col-md-3">
<div class="card shadow-sm p-3 kpi-card">
<div class="text-muted">Correctivos</div>
<div class="kpi-number text-danger"><%= totalCorrectivos %></div>
</div>
</div>

<div class="col-md-3">
<div class="card shadow-sm p-3 kpi-card">
<div class="text-muted">Trabajos Totales</div>
<div class="kpi-number text-success"><%= totalTrabajos %></div>
</div>
</div>

<div class="col-md-3">
<div class="card shadow-sm p-3 kpi-card">
<div class="text-muted">Top Mecánico</div>
<div class="kpi-number">
<%= top ? top.mecanico : '-' %>
</div>
</div>
</div>

</div>

<div class="table-responsive">

<table class="table table-bordered table-hover align-middle">

<thead class="table-dark">
<tr>
<th>Mecánico</th>
<th>Preventivos</th>
<th>Correctivos</th>
<th>Total</th>
<th style="width:300px">Eficiencia</th>
</tr>
</thead>

<tbody>

<% if (!totales || totales.length === 0) { %>

<tr>
<td colspan="5" class="text-center text-muted">
No hay datos para el rango seleccionado
</td>
</tr>

<% } %>

<%
let totalGeneral = totales.reduce((sum,m)=>sum+(m.total_trabajos||0),0)
%>

<% totales.forEach(row=>{

let eficiencia = totalGeneral
? ((row.total_trabajos / totalGeneral)*100).toFixed(1)
: 0

%>

<tr>

<td>
<strong><%= row.mecanico %></strong>
</td>

<td class="text-center">
<span class="badge bg-primary">
<%= row.preventivos || 0 %>
</span>
</td>

<td class="text-center">
<span class="badge bg-danger">
<%= row.correctivos || 0 %>
</span>
</td>

<td class="text-center">
<span class="badge bg-success fs-6">
<%= row.total_trabajos || 0 %>
</span>
</td>

<td>

<div class="progress">

<div
class="progress-bar bg-success"
role="progressbar"
data-width="<%= eficiencia %>">

<%= eficiencia %>%

</div>

</div>

</td>

</tr>

<% }) %>

</tbody>
</table>

</div>

<div class="alert alert-secondary mt-3 small">

• Preventivos = mantenimientos cerrados en el rango de fechas  
• Correctivos = correctivos registrados  
• Total = suma de trabajos  
• Eficiencia = porcentaje de participación del mecánico

</div>

</div>

<script>

document.querySelectorAll(".progress-bar").forEach(bar=>{
const width = bar.dataset.width
bar.style.width = width + "%"
})

</script>

</body>
</html>