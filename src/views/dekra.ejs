<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Control DEKRA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-warning">Control DEKRA</h3>

    <div>
      <% if (user.rol !== 'SUPERVISOR' && user.rol !== 'SUPERVISOR_PESADO') { %>
        <a href="/dekra/nuevo" class="btn btn-warning">➕ Nuevo registro</a>
      <% } %>

      <a href="/dashboard" class="btn btn-secondary">Volver</a>
    </div>
  </div>

  <!-- FILTROS -->
  <form method="GET" action="/dekra" class="row g-2 mb-3">

    <div class="col-md-3">
      <select name="mes" class="form-select">
        <option value="">Todos los meses</option>
        <option value="ENE-JUL" <%= mesSeleccionado === 'ENE-JUL' ? 'selected' : '' %>>ENE-JUL</option>
        <option value="FEB-AGO" <%= mesSeleccionado === 'FEB-AGO' ? 'selected' : '' %>>FEB-AGO</option>
        <option value="MAR-SET" <%= mesSeleccionado === 'MAR-SET' ? 'selected' : '' %>>MAR-SET</option>
        <option value="ABR-OCT" <%= mesSeleccionado === 'ABR-OCT' ? 'selected' : '' %>>ABR-OCT</option>
        <option value="MAY-NOV" <%= mesSeleccionado === 'MAY-NOV' ? 'selected' : '' %>>MAY-NOV</option>
      </select>
    </div>

    <div class="col-md-3">
      <select name="negocio" class="form-select">
        <option value="">Todos los negocios</option>
        <option value="CILINDROS" <%= negocioSeleccionado === 'CILINDROS' ? 'selected' : '' %>>CILINDROS</option>
        <option value="GRANEL" <%= negocioSeleccionado === 'GRANEL' ? 'selected' : '' %>>GRANEL</option>
      </select>
    </div>

    <div class="col-md-2">
      <button class="btn btn-outline-warning w-100">Filtrar</button>
    </div>

  </form>

  <!-- TABLA -->
  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle bg-white">

      <thead class="table-dark">
        <tr>
          <th>Placa</th>
          <th>Sede</th>
          <th>Mes</th>
          <th>Negocio</th>
          <th>Estado</th>
          <th>Observación</th>
          <th style="width: 260px;">Acciones</th>
        </tr>
      </thead>

      <tbody>

        <% registros.forEach(r => { %>

          <tr class="
            <%= r.estado === 'REALIZADO' ? 'table-success' : '' %>
            <%= r.estado === 'NO_REALIZADO' ? 'table-danger' : '' %>
            <%= r.estado === 'PENDIENTE' ? 'table-warning' : '' %>
          ">

            <td><strong><%= r.placa %></strong></td>

            <td><%= r.sede %></td>

            <td><%= r.mes %></td>

            <td>
              <span class="badge <%= r.negocio === 'GRANEL' ? 'bg-danger' : 'bg-primary' %>">
                <%= r.negocio %>
              </span>
            </td>

            <!-- ESTADO BONITO -->
            <td>
              <% if (r.estado === 'REALIZADO') { %>
                <span class="badge bg-success">✔ Pasó</span>
              <% } else if (r.estado === 'NO_REALIZADO') { %>
                <span class="badge bg-danger">✖ No pasó</span>
              <% } else { %>
                <span class="badge bg-warning text-dark">Pendiente</span>
              <% } %>
            </td>

            <td><%= r.observacion || '—' %></td>

            <td>

              <!-- 🔒 SOLO ADMIN Y MECÁNICO PUEDEN VER -->
              <% if (user.rol !== 'SUPERVISOR' && user.rol !== 'SUPERVISOR_PESADO') { %>

                <div class="d-flex gap-2 flex-wrap">

                  <!-- YA PASÓ -->
                  <form method="POST" action="/dekra/<%= r.id %>/realizado">
                    <button class="btn btn-success btn-sm">✔ Pasó</button>
                  </form>

                  <!-- NO PUDO -->
                  <button
                    class="btn btn-danger btn-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#obs-<%= r.id %>">
                    ✖ No pudo ir
                  </button>

                </div>

                <!-- FORM OBSERVACION -->
                <div class="collapse mt-2" id="obs-<%= r.id %>">
                  <form method="POST" action="/dekra/<%= r.id %>/no-realizado">
                    <textarea name="observacion" class="form-control mb-2" rows="2"
                      placeholder="Ej: motor malo, frenos, falta repuesto..." required></textarea>
                    <button class="btn btn-danger btn-sm">Guardar motivo</button>
                  </form>
                </div>

              <% } else { %>

                <!-- 👀 SOLO VER -->
                <span class="text-muted">Solo visualización</span>

              <% } %>

            </td>

          </tr>

        <% }) %>

        <% if (registros.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center">No hay registros DEKRA</td>
          </tr>
        <% } %>

      </tbody>

    </table>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>