<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Nuevo Correctivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f4f6f9;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }
    .table td, .table th {
      vertical-align: middle;
    }
    textarea {
      resize: none;
    }
    .titulo-seccion {
      font-weight: 700;
      color: #1f2937;
    }
    .table thead th {
      background: #1f2937;
      color: white;
      border-color: #1f2937;
    }
    .mec-label {
      font-weight: 600;
      color: #111827;
    }
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .table thead {
        display: none;
      }
      .table, .table tbody, .table tr, .table td {
        display: block;
        width: 100%;
      }
      .table tr {
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem;
        background: white;
      }
      .table td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border: none;
        border-bottom: 1px solid #eee;
      }
      .table td::before {
        content: attr(data-label);
        position: absolute;
        left: 1rem;
        width: 45%;
        font-weight: bold;
        text-align: left;
      }
      .btn-sm {
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">🔧 Tomza - Nuevo Correctivo</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos" class="btn btn-secondary btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">
  <div class="card p-3 p-md-4">
    <form id="formCorrectivo" method="POST" action="/mantenimientos/correctivos">

      <!-- UNIDAD -->
      <div class="mb-4">
        <label class="form-label fw-bold">🚛 Unidad</label>
        <select name="unidad_id" class="form-select" required>
          <% unidades.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.placa %></option>
          <% }) %>
        </select>
      </div>

      <!-- EJECUCIÓN POR MECÁNICO -->
      <div class="mb-4">
        <h4 class="titulo-seccion">🔧 Ejecución por mecánico</h4>
        <div class="alert alert-primary mt-3">
          Seleccione los mecánicos que trabajaron y detalle qué realizó cada uno.
        </div>
        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead>
              <tr>
                <th style="width:70px;" class="text-center">✔</th>
                <th style="width:280px;">Mecánico</th>
                <th>Trabajo realizado</th>
                <th>Repuestos usados</th>
              </tr>
            </thead>
            <tbody>
              <% mecanicos.forEach(m => { %>
                <tr>
                  <td class="text-center" data-label="Seleccionar">
                    <input class="form-check-input mec-check" type="checkbox" name="mecanicos[]" value="<%= m.id %>" id="mec_<%= m.id %>">
                  </td>
                  <td data-label="Mecánico">
                    <label class="mec-label" for="mec_<%= m.id %>"><%= m.nombre %></label>
                  </td>
                  <td data-label="Trabajo realizado">
                    <textarea name="trabajos[<%= m.id %>]" class="form-control trabajo-text" rows="2" placeholder="Detalle del trabajo realizado"></textarea>
                  </td>
                  <td data-label="Repuestos usados">
                    <input type="text" name="repuestos[<%= m.id %>]" class="form-control" placeholder="Ej: coolant, abrazaderas, manguera">
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- PENDIENTE GENERAL -->
      <div class="mb-4">
        <label class="form-label fw-bold">⚠ Pendiente general</label>
        <textarea name="pendiente" class="form-control" rows="4" placeholder="Pendientes del vehículo..."></textarea>
      </div>

      <!-- BOTONES -->
      <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-success">💾 Guardar Correctivo</button>
        <a href="/mantenimientos" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('formCorrectivo');
    form.addEventListener('submit', function(e) {
      const checks = document.querySelectorAll('.mec-check');
      const algunoSeleccionado = Array.from(checks).some(cb => cb.checked);
      if (!algunoSeleccionado) {
        e.preventDefault();
        alert('Debe seleccionar al menos un mecánico.');
        return;
      }
      const trabajos = document.querySelectorAll('.trabajo-text');
      let tieneTrabajo = false;
      trabajos.forEach(t => {
        if (t.value && t.value.trim().length > 0) {
          tieneTrabajo = true;
        }
      });
      if (!tieneTrabajo) {
        e.preventDefault();
        alert('Debe escribir al menos un trabajo.');
        return;
      }
    });
  });
</script>

</body>
</html>