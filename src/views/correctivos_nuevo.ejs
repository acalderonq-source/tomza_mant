<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nuevo Correctivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
  <style>
    textarea { resize: vertical; }
  </style>
</head>
<body>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-plus-circle"></i> Nuevo correctivo</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos" class="btn btn-outline-light btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Registrar correctivo</h1>
      <p class="page-subtitle">Selecciona la unidad, mecánicos participantes, trabajos y repuestos utilizados.</p>
    </div>
  </div>

  <div class="surface-card p-3 p-md-4">
    <form id="formCorrectivo" method="POST" action="/mantenimientos/correctivos">
      <div class="row g-3 mb-4">
        <div class="col-md-5">
          <label class="form-label">Unidad</label>
          <select name="unidad_id" class="form-select" required>
            <option value="">Seleccione una unidad</option>
            <% unidades.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.placa %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-7">
          <div class="detail-item h-100">
            <div class="detail-label">Instrucción</div>
            <div class="detail-value">Marca los mecánicos que participaron y escribe al menos un trabajo realizado.</div>
          </div>
        </div>
      </div>

      <h2 class="page-title fs-5 mb-3"><i class="bi bi-person-gear"></i> Ejecución por mecánico</h2>
      <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th style="width:70px;" class="text-center">Seleccionar</th>
              <th style="width:260px;">Mecánico</th>
              <th>Trabajo realizado</th>
              <th>Repuestos usados</th>
            </tr>
          </thead>
          <tbody>
            <% mecanicos.forEach(m => { %>
              <tr>
                <td class="text-center" data-label="Seleccionar">
                  <input class="form-check-input mec-check" type="checkbox" name="mecanicos[]" value="<%= m.id %>" id="mec_<%= m.id %>">
                </td>
                <td data-label="Mecánico">
                  <label class="fw-bold" for="mec_<%= m.id %>"><%= m.nombre %></label>
                </td>
                <td data-label="Trabajo realizado">
                  <textarea name="trabajos[<%= m.id %>]" class="form-control trabajo-text" rows="2" placeholder="Detalle del trabajo realizado"></textarea>
                </td>
                <td data-label="Repuestos usados">
                  <input type="text" name="repuestos[<%= m.id %>]" class="form-control" placeholder="Ej: abrazaderas, manguera">
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="mb-4">
        <label class="form-label">Pendiente general</label>
        <textarea name="pendiente" class="form-control" rows="4" placeholder="Pendientes del vehículo..."></textarea>
      </div>

      <div class="d-flex flex-column flex-sm-row gap-2">
        <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar correctivo</button>
        <a href="/mantenimientos" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('formCorrectivo');
    form.addEventListener('submit', function(e) {
      const checks = document.querySelectorAll('.mec-check');
      const algunoSeleccionado = Array.from(checks).some(cb => cb.checked);
      if (!algunoSeleccionado) {
        e.preventDefault();
        alert('Debe seleccionar al menos un mecánico.');
        return;
      }
      const trabajos = document.querySelectorAll('.trabajo-text');
      let tieneTrabajo = false;
      trabajos.forEach(t => {
        if (t.value && t.value.trim().length > 0) {
          tieneTrabajo = true;
        }
      });
      if (!tieneTrabajo) {
        e.preventDefault();
        alert('Debe escribir al menos un trabajo.');
      }
    });
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
