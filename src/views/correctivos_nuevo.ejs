<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Correctivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza - Nuevo Correctivo</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos" class="btn btn-secondary btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">

  <div class="card p-3">
    <form method="POST" action="/mantenimientos/correctivos">
      
      <label class="form-label">Placa</label>
      <select name="unidad_id" class="form-select" required>
        <% unidades.forEach(u => { %>
          <option value="<%= u.id %>"><%= u.placa %></option>
        <% }) %>
      </select>

      <label class="form-label mt-3">Mecánicos que realizaron el trabajo</label>

      <div class="row">
        <% mecanicos.forEach(m => { %>
          <div class="col-12 col-md-6">
            <div class="form-check">
              <input
                class="form-check-input"
                type="checkbox"
                name="mecanicos[]"
                value="<%= m.id %>"
                id="mec_<%= m.id %>"
              >
              <label class="form-check-label" for="mec_<%= m.id %>">
                <%= m.nombre %>
              </label>
            </div>
          </div>
        <% }) %>
      </div>

      <label class="form-label mt-3">Trabajo realizado</label>
      <textarea name="trabajo_realizado" class="form-control" rows="4" required></textarea>

      <label class="form-label mt-3">Pendiente</label>
      <textarea name="pendiente" class="form-control" rows="3"></textarea>

      <button class="btn btn-danger mt-3">Guardar Correctivo</button>

    </form>
  </div>

</div>

<script>
  document.querySelector("form").addEventListener("submit", function(e) {
    const checkboxes = document.querySelectorAll("input[name='mecanicos[]']");
    const algunoSeleccionado = Array.from(checkboxes).some(cb => cb.checked);

    if (!algunoSeleccionado) {
      e.preventDefault();
      alert("Debe seleccionar al menos un mecánico.");
    }
  });
</script>

</body>
</html>