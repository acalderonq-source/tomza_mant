<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Cambios de Aceite</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza | Cambios de Aceite</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/dashboard" class="btn btn-warning btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">

  <% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
    <a href="/aceite/nuevo" class="btn btn-success mb-3">
      ➕ Registrar cambio de aceite
    </a>
  <% } %>

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Fecha</th>
          <th>Placa</th>
          <th>KM actual</th>
          <th>Galones</th>
          <th>Próximo cambio</th>
          <th>Mecánico</th>
          <th>Obs.</th>
        </tr>
      </thead>
      <tbody>
        <% if (cambios.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center">No hay registros</td>
          </tr>
        <% } %>

        <% cambios.forEach(c => { %>
          <tr>
            <td><%= c.fecha_formato %></td>
            <td><strong><%= c.placa %></strong></td>
            <td><%= c.km_actual %></td>
            <td><%= c.galones %></td>
            <td><%= c.proximo_km %></td>
            <td><%= c.mecanico %></td>
            <td><%= c.observaciones || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>
</body>
</html>
