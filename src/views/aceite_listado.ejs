<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Control de Aceites</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --blue: #0b3b82;
      --dark: #071735;
      --line: #d8e2f0;
      --soft: #f4f7fb;
      --ink: #14213d;
      --muted: #61718b;
      --green: #0f766e;
      --amber: #eab308;
      --red: #dc2626;
    }
    body {
      background: linear-gradient(135deg, #eef4fb, #dfe9f6);
      color: var(--ink);
      font-family: "Segoe UI", Arial, sans-serif;
      min-height: 100vh;
    }
    .navbar-aceite {
      background: linear-gradient(120deg, #071735, #0b3b82 70%, #0f766e);
      box-shadow: 0 12px 26px rgba(7, 23, 53, .18);
    }
    .page-shell {
      max-width: 1440px;
    }
    .hero {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      box-shadow: 0 14px 28px rgba(20, 33, 61, .08);
      padding: 1.1rem;
    }
    .hero h1 {
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 950;
      letter-spacing: -.02em;
      margin: 0;
    }
    .hero-copy {
      color: var(--muted);
      font-weight: 700;
      margin: .2rem 0 0;
    }
    .kpi-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .kpi-card,
    .panel,
    .drum-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      box-shadow: 0 12px 24px rgba(20, 33, 61, .07);
    }
    .kpi-card {
      padding: .9rem 1rem;
    }
    .kpi-label {
      color: var(--muted);
      font-size: .76rem;
      font-weight: 900;
      text-transform: uppercase;
    }
    .kpi-value {
      color: var(--dark);
      font-size: 1.55rem;
      font-weight: 950;
      line-height: 1;
      margin-top: .35rem;
    }
    .panel {
      overflow: hidden;
    }
    .panel-head {
      align-items: center;
      background: linear-gradient(90deg, #0b3b82, #071735);
      color: #fff;
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: .85rem 1rem;
    }
    .panel-title {
      font-size: 1rem;
      font-weight: 950;
      margin: 0;
    }
    .panel-copy {
      color: rgba(255,255,255,.78);
      font-size: .78rem;
      font-weight: 700;
      margin: .1rem 0 0;
    }
    .drum-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      padding: 1rem;
    }
    .drum-card {
      display: grid;
      gap: .75rem;
      grid-template-columns: 150px minmax(0, 1fr);
      padding: 1rem;
      position: relative;
    }
    .drum-card.low {
      border-color: #f59e0b;
      box-shadow: 0 12px 24px rgba(245, 158, 11, .14);
    }
    .drum-card.empty {
      border-color: #ef4444;
      opacity: .86;
    }
    .drum-visual {
      align-items: center;
      background: radial-gradient(circle at 50% 18%, rgba(255,255,255,.9), transparent 34%), linear-gradient(180deg, #eef4fb, #dbe7f4);
      border: 1px solid #cbd8ea;
      border-radius: 14px;
      display: flex;
      height: 210px;
      justify-content: center;
      overflow: hidden;
      position: relative;
      width: 136px;
    }
    .drum-visual::before {
      content: "";
      background: radial-gradient(ellipse at center, rgba(15,23,42,.18), transparent 68%);
      bottom: 8px;
      height: 20px;
      left: 20px;
      position: absolute;
      right: 20px;
      z-index: 0;
    }
    .barrel-shell {
      background: linear-gradient(90deg, #aeb8c6 0%, #f8fafc 28%, #dbe3ee 52%, #f8fafc 70%, #8d99a8 100%);
      border: 2px solid #64748b;
      border-radius: 46% 46% 12px 12px / 14px 14px 12px 12px;
      box-shadow: inset 12px 0 20px rgba(15,23,42,.18), inset -10px 0 18px rgba(15,23,42,.12), 0 14px 18px rgba(15,23,42,.16);
      height: 170px;
      overflow: hidden;
      position: absolute;
      top: 18px;
      width: 94px;
      z-index: 1;
    }
    .barrel-shell::before,
    .barrel-shell::after {
      background: linear-gradient(90deg, #95a2b3, #ffffff 45%, #8793a4);
      border: 2px solid #64748b;
      border-left: 0;
      border-right: 0;
      content: "";
      height: 20px;
      left: 0;
      position: absolute;
      right: 0;
      z-index: 4;
    }
    .barrel-shell::before { top: 14px; }
    .barrel-shell::after { top: 78px; }
    .barrel-level {
      background: linear-gradient(180deg, rgba(250,204,21,.7), rgba(217,119,6,.84));
      border-top: 2px solid rgba(120,53,15,.35);
      bottom: 0;
      height: var(--nivel);
      left: 0;
      position: absolute;
      right: 0;
      transition: height .35s ease;
      z-index: 2;
    }
    .barrel-shine {
      background: linear-gradient(90deg, rgba(255,255,255,.42), transparent 38%, rgba(255,255,255,.18) 55%, transparent 82%);
      inset: 0;
      position: absolute;
      z-index: 5;
    }
    .drum-level-mark,
    .drum-level-current {
      background: #ef4444;
      border-radius: 999px;
      box-shadow: 0 2px 5px rgba(127,29,29,.35);
      height: 5px;
      left: 16px;
      position: absolute;
      right: 16px;
      z-index: 7;
    }
    .drum-level-mark.mark-25 { bottom: 25%; }
    .drum-level-mark.mark-50 { bottom: 50%; }
    .drum-level-mark.mark-75 { bottom: 75%; }
    .drum-level-current {
      background: #dc2626;
      border: 1px solid rgba(255,255,255,.92);
      height: 7px;
      left: 8px;
      right: 8px;
      top: var(--nivel-top);
      transform: translateY(-50%);
      transition: top .35s ease;
    }
    .drum-label {
      background: rgba(255,255,255,.88);
      border: 1px solid #d8e2f0;
      border-radius: 999px;
      bottom: 8px;
      color: #0f172a;
      font-size: .62rem;
      font-weight: 950;
      left: 50%;
      line-height: 1.1;
      position: absolute;
      text-align: center;
      text-transform: uppercase;
      transform: translateX(-50%);
      width: 74px;
      z-index: 8;
    }
    .drum-title {
      font-size: 1.05rem;
      font-weight: 950;
    }
    .drum-liters {
      color: var(--dark);
      font-size: 1.75rem;
      font-weight: 950;
      line-height: 1;
      margin-top: .3rem;
    }
    .progress {
      background: #e5eaf3;
      height: .55rem;
    }
    .progress-bar {
      background: linear-gradient(90deg, #0f766e, #22c55e);
    }
    .progress-bar.low {
      background: linear-gradient(90deg, #f59e0b, #facc15);
    }
    .progress-bar.empty {
      background: #dc2626;
    }
    .muted {
      color: var(--muted);
    }
    .table th {
      color: #334155;
      font-size: .72rem;
      text-transform: uppercase;
    }
    .table td {
      vertical-align: middle;
    }
    .badge-soft {
      border-radius: 999px;
      font-weight: 850;
      padding: .32rem .55rem;
    }
    .badge-entrada {
      background: #dcfce7;
      color: #166534;
    }
    .badge-salida {
      background: #fee2e2;
      color: #991b1b;
    }
    .badge-inventario {
      border-radius: 999px;
      display: inline-flex;
      font-size: .7rem;
      font-weight: 900;
      padding: .28rem .5rem;
      white-space: nowrap;
    }
    .badge-rebajado {
      background: #dcfce7;
      color: #166534;
    }
    .badge-pendiente {
      background: #fef3c7;
      color: #92400e;
    }
    .form-card {
      background: #f8fafc;
      border: 1px solid #d8e2f0;
      border-radius: 10px;
      padding: 1rem;
    }
    @media (max-width: 900px) {
      .kpi-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 640px) {
      .kpi-grid,
      .drum-card {
        grid-template-columns: 1fr;
      }
      .drum-visual {
        margin: 0 auto;
      }
    }
  </style>
</head>
<body>
<%
  const factorGalon = Number(galonALitros || 3.78541);
  const formatoGalones = value => Number(value || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const litrosAGalones = value => Number(value || 0) / factorGalon;
  const porcentajeEstanon = item => {
    const capacidad = Number(item.litros_capacidad || capacidadEstandar || 208.2);
    const restantes = Number(item.litros_restantes || 0);
    if (!capacidad) return 0;
    return Math.max(0, Math.min(100, (restantes / capacidad) * 100));
  };
  const estadoClase = item => {
    const porcentaje = porcentajeEstanon(item);
    if (porcentaje <= 0.1 || item.estado === 'AGOTADO') return 'empty';
    if (porcentaje <= 20) return 'low';
    return '';
  };
%>

<nav class="navbar navbar-dark navbar-aceite px-3">
  <span class="navbar-brand fw-bold"><i class="bi bi-droplet-half me-1"></i> Control de aceites</span>
  <div class="d-flex align-items-center gap-2 text-white flex-wrap">
    <span class="small fw-bold"><%= user.usuario %> (<%= user.rol %>)</span>
    <a href="/dashboard" class="btn btn-light btn-sm fw-bold">Volver</a>
  </div>
</nav>

<main class="container-fluid page-shell py-4">
  <% if (success) { %>
    <div class="alert alert-success fw-bold"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger fw-bold"><%= error %></div>
  <% } %>

  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <div class="text-uppercase fw-black small text-success">Inventario por sede</div>
        <h1>Aceite por estañón</h1>
        <p class="hero-copy">Cada estañón representa <strong><%= formatoGalones(capacidadEstandarGalones || 55) %> galones</strong>. Cada cambio rebaja galones del estañón activo de la sede.</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if (puedeGestionar) { %>
          <a href="/aceite/nuevo" class="btn btn-success fw-bold"><i class="bi bi-tools"></i> Registrar cambio</a>
          <button class="btn btn-primary fw-bold" data-bs-toggle="collapse" data-bs-target="#formEstanon"><i class="bi bi-plus-circle"></i> Agregar estañón</button>
        <% } %>
      </div>
    </div>
  </section>

  <% if (puedeGestionar) { %>
    <section class="collapse mb-3" id="formEstanon">
      <div class="form-card">
        <form method="POST" action="/aceite/estanones" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label fw-bold">Sede</label>
            <select name="sede" class="form-select" required>
              <option value="">Seleccione</option>
              <% sedesGestion.forEach(sede => { %>
                <option value="<%= sede %>"><%= etiquetaSede(sede) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Fecha de compra</label>
            <input type="date" name="fecha_compra" class="form-control" value="<%= fechaHoy %>" required>
            <div class="form-text fw-semibold">Si es fecha anterior, rebaja cambios desde ese día.</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Descripción</label>
            <input type="text" name="descripcion" class="form-control" value="Estañón de aceite 55 galones">
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Capacidad galones</label>
            <input type="number" step="0.01" name="galones_capacidad" class="form-control" value="<%= capacidadEstandarGalones || 55 %>">
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">Galones iniciales</label>
            <input type="number" step="0.01" name="galones_iniciales" class="form-control" value="<%= capacidadEstandarGalones || 55 %>">
          </div>
          <div class="col-12">
            <button class="btn btn-primary fw-bold"><i class="bi bi-save"></i> Guardar estañón</button>
          </div>
        </form>
      </div>
    </section>
  <% } %>

  <section class="kpi-grid mb-3">
    <div class="kpi-card">
      <div class="kpi-label">Galones disponibles</div>
      <div class="kpi-value"><%= formatoGalones(litrosAGalones(resumen.restantes)) %> gal</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Capacidad registrada</div>
      <div class="kpi-value"><%= formatoGalones(litrosAGalones(resumen.capacidad)) %> gal</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Estañones activos</div>
      <div class="kpi-value"><%= Number(resumen.activos || 0).toLocaleString('es-CR') %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Alertas bajo 20%</div>
      <div class="kpi-value"><%= Number(resumen.bajos || 0).toLocaleString('es-CR') %></div>
    </div>
  </section>

  <section class="panel mb-3">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Aceite disponible por sede</h2>
        <p class="panel-copy">La imagen del estañón baja conforme se registran cambios de aceite.</p>
      </div>
    </div>

    <% if (!estanones.length) { %>
      <div class="p-4 text-center muted fw-bold">Todavía no hay estañones registrados.</div>
    <% } else { %>
      <div class="drum-grid">
        <% estanones.forEach(item => {
          const porcentaje = porcentajeEstanon(item);
          const nivelTop = Math.max(4, Math.min(166, 170 - (porcentaje * 1.7)));
          const clase = estadoClase(item);
        %>
          <article class="drum-card <%= clase %>">
            <div class="drum-visual" style="--nivel:<%= porcentaje.toFixed(2) %>%; --nivel-top:<%= nivelTop.toFixed(1) %>px">
              <div class="barrel-shell" aria-hidden="true">
                <div class="barrel-level"></div>
                <span class="drum-level-mark mark-75"></span>
                <span class="drum-level-mark mark-50"></span>
                <span class="drum-level-mark mark-25"></span>
                <span class="drum-level-current"></span>
                <div class="barrel-shine"></div>
              </div>
              <div class="drum-label">Aceite<br>55 gal</div>
            </div>
            <div>
              <div class="d-flex justify-content-between gap-2">
                <div>
                  <div class="drum-title"><%= etiquetaSede(item.sede) %></div>
                  <div class="small muted"><%= item.descripcion || 'Estañón de aceite' %></div>
                </div>
                <span class="badge text-bg-light"><%= item.estado %></span>
              </div>
              <div class="drum-liters"><%= formatoGalones(litrosAGalones(item.litros_restantes)) %> gal</div>
              <div class="small muted mt-1">de <%= formatoGalones(litrosAGalones(item.litros_capacidad)) %> gal · comprado <%= item.fecha_compra_formato %></div>
              <div class="progress mt-3">
                <div class="progress-bar <%= clase %>" style="width:<%= porcentaje.toFixed(2) %>%"></div>
              </div>
              <div class="d-flex justify-content-between small fw-bold mt-2">
                <span><%= porcentaje.toFixed(0) %>% disponible</span>
                <span><%= formatoGalones(litrosAGalones(item.litros_consumidos)) %> gal consumidos</span>
              </div>
              <div class="small muted mt-2"><%= Number(item.salidas || 0).toLocaleString('es-CR') %> rebajo(s) registrados</div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <div class="row g-3">
    <div class="col-lg-7">
      <section class="panel h-100">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">Últimos cambios de aceite</h2>
            <p class="panel-copy">Cada registro descuenta galones de la sede de la unidad.</p>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Placa</th>
                <th>Sede</th>
                <th>KM</th>
                <th>Galones</th>
                <th>Inventario</th>
                <th>Próximo</th>
                <th>Mecánico</th>
              </tr>
            </thead>
            <tbody>
              <% if (!cambios.length) { %>
                <tr><td colspan="8" class="text-center muted fw-bold py-4">No hay registros</td></tr>
              <% } %>
              <% cambios.forEach(c => { %>
                <%
                  const galonesRebajados = litrosAGalones(c.litros_rebajados || 0);
                  const cambioRebajado = Number(c.litros_rebajados || 0) > 0.001;
                %>
                <tr>
                  <td><%= c.fecha_formato %></td>
                  <td><strong><%= c.placa %></strong><div class="small muted"><%= c.observaciones || '' %></div></td>
                  <td><%= etiquetaSede(c.sede) %></td>
                  <td><%= Number(c.km_actual || 0).toLocaleString('es-CR') %></td>
                  <td><strong><%= formatoGalones(c.galones_usados || litrosAGalones(c.litros_usados)) %> gal</strong></td>
                  <td>
                    <% if (cambioRebajado) { %>
                      <span class="badge-inventario badge-rebajado">Rebajado <%= formatoGalones(galonesRebajados) %> gal</span>
                    <% } else { %>
                      <span class="badge-inventario badge-pendiente">Sin rebajo</span>
                    <% } %>
                  </td>
                  <td><%= Number(c.proximo_km || 0).toLocaleString('es-CR') %></td>
                  <td><%= c.mecanico || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="col-lg-5">
      <section class="panel h-100">
        <div class="panel-head">
          <div>
            <h2 class="panel-title">Movimientos de aceite</h2>
            <p class="panel-copy">Entradas de estañón y salidas por cambios.</p>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Sede</th>
                <th>Detalle</th>
                <th>Galones</th>
              </tr>
            </thead>
            <tbody>
              <% if (!movimientos.length) { %>
                <tr><td colspan="5" class="text-center muted fw-bold py-4">Sin movimientos</td></tr>
              <% } %>
              <% movimientos.forEach(m => { %>
                <tr>
                  <td><%= m.fecha_formato %></td>
                  <td><span class="badge-soft <%= m.tipo === 'ENTRADA' ? 'badge-entrada' : 'badge-salida' %>"><%= m.tipo %></span></td>
                  <td><%= etiquetaSede(m.sede) %></td>
                  <td><strong><%= m.placa || '' %></strong><div class="small muted"><%= m.descripcion || '—' %></div></td>
                  <td><strong><%= formatoGalones(litrosAGalones(m.litros)) %> gal</strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/loading-guard.js"></script>
</body>
</html>
