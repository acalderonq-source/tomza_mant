<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Detalle Orden Motor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f3f6fa; color: #111827; font-family: "Segoe UI", Roboto, Arial, sans-serif; }
    .topbar { background: #111827; border-bottom: 3px solid #dc2626; }
    .shell { max-width: 980px; }
    .panel { background: #fff; border: 1px solid #dbe3ef; border-radius: 10px; }
    .label { color: #64748b; font-size: .75rem; font-weight: 900; text-transform: uppercase; }
    .value { font-weight: 800; }
    .table thead th { background: #f8fafc; color: #475569; font-size: .75rem; font-weight: 900; text-transform: uppercase; }
  </style>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-gear-wide-connected me-2"></i>Detalle Orden Motor</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/ordenes-motor" class="btn btn-outline-light btn-sm rounded-pill px-3">Volver</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="panel p-3 mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
      <div>
        <h1 class="h4 fw-black mb-1"><%= orden.numero %></h1>
        <div class="text-muted small">Orden motor separada del presupuesto normal de compras.</div>
      </div>
      <div class="d-flex gap-2">
        <a href="/ordenes-motor/<%= orden.id %>/editar" class="btn btn-outline-primary btn-sm">Editar</a>
        <form method="POST" action="/ordenes-motor/<%= orden.id %>/estado">
          <input type="hidden" name="estado" value="RECIBIDA_TOTAL">
          <button class="btn btn-success btn-sm">Marcar recibida</button>
        </form>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-md-3"><div class="label">Fecha</div><div class="value"><%= new Date(orden.fecha).toLocaleDateString('es-CR') %></div></div>
      <div class="col-md-4"><div class="label">Proveedor</div><div class="value"><%= orden.proveedor_nombre || '-' %></div></div>
      <div class="col-md-2"><div class="label">Placa</div><div class="value"><%= orden.placa_unidad || '-' %></div></div>
      <div class="col-md-2"><div class="label">Tipo</div><div class="value"><%= orden.tipo_mantenimiento || 'CORRECTIVO' %></div></div>
      <div class="col-md-3"><div class="label">Motor</div><div class="value"><%= orden.motor || '-' %></div></div>
      <div class="col-md-3"><div class="label">Estado</div><div class="value"><%= orden.estado.replace('_', ' ') %></div></div>
      <div class="col-md-3"><div class="label">Moneda</div><div class="value"><%= orden.moneda %></div></div>
      <div class="col-md-3"><div class="label">Total</div><div class="value">₡<%= Number(orden.total || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 }) %></div></div>
    </div>

    <% if (orden.observaciones) { %>
      <div class="alert alert-light border mt-3 mb-0"><strong>Observaciones:</strong> <%= orden.observaciones %></div>
    <% } %>
  </section>

  <section class="panel">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th>Descripción</th>
            <th class="text-center">Cantidad</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% lineas.forEach(linea => { %>
            <tr>
              <td><%= linea.descripcion %></td>
              <td class="text-center"><%= Number(linea.cantidad || 0).toLocaleString('es-CR') %></td>
              <td class="text-end">₡<%= Number(linea.precio_unitario || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 }) %></td>
              <td class="text-end">₡<%= Number(linea.subtotal || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
