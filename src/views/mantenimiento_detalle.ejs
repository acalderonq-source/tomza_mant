<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mantenimiento - <%= mantenimiento.placa %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
  <style>
    .plan-red {
      color: #dc2626;
      font-weight: 900;
    }

    .plan-editor {
      background: #fff;
      border: 1px solid #cfd9e8;
      border-radius: 10px;
      min-height: 190px;
      outline: none;
      padding: .75rem;
      white-space: pre-wrap;
    }

    .plan-editor:focus {
      border-color: #0d6efd;
      box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
    }

    .plan-toolbar {
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
      margin-bottom: .6rem;
    }
  </style>
</head>

<body>
<%
  const renderPlanHtml = (value) => {
    const raw = String(value || '').trim();
    if (!raw) return 'No definido';
    const openToken = '__PLAN_RED_OPEN__';
    const closeToken = '__PLAN_RED_CLOSE__';
    const escaped = raw
      .replace(/<span\s+class=["']plan-red["'][^>]*>/gi, openToken)
      .replace(/<\/span>/gi, closeToken)
      .replace(/<[^>]*>/g, '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replaceAll(openToken, '<span class="plan-red">')
      .replaceAll(closeToken, '</span>')
      .replace(/\n/g, '<br>');
    return escaped;
  };
%>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-tools"></i> Tomza - Taller</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="text-white small"><%= user.usuario %> (<%= user.rol %>)</span>
    <a href="/mantenimientos" class="btn btn-outline-light btn-sm">Mantenimientos</a>
    <a href="/agenda" class="btn btn-secondary btn-sm">Agenda</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Mantenimiento <%= mantenimiento.placa %></h1>
      <p class="page-subtitle">Planificación, mecánicos asignados y cierre del trabajo.</p>
    </div>
    <span class="badge <%= mantenimiento.estado === 'CERRADO' ? 'badge-closed' : 'badge-open' %>"><%= mantenimiento.estado %></span>
  </div>

  <div class="surface-card p-3 mb-3">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-label">N° mantenimiento</div>
        <div class="detail-value"><%= mantenimiento.numero_mantenimiento || ('MANT-' + mantenimiento.id) %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Placa</div>
        <div class="detail-value"><%= mantenimiento.placa %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Sede</div>
        <div class="detail-value"><%= mantenimiento.sede %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Tipo</div>
        <div class="detail-value"><%= mantenimiento.tipo %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Prioridad</div>
        <div class="detail-value"><span class="badge badge-priority"><%= mantenimiento.prioridad || 'MEDIA' %></span></div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="page-title fs-5 mb-3"><i class="bi bi-clipboard-check"></i> Plan del taller</h2>

          <% if (['ADMIN','TALLER'].includes(user.rol)) { %>
            <form method="POST" action="/mantenimientos/<%= mantenimiento.id %>/plan" id="formPlanTaller">
              <div class="plan-toolbar">
                <button type="button" class="btn btn-outline-danger btn-sm" id="btnPlanRojo">
                  <i class="bi bi-brush"></i> Marcar rojo
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPlanNormal">
                  Quitar rojo
                </button>
              </div>
              <div id="planEditor" class="plan-editor mb-3" contenteditable="true"><%- renderPlanHtml(mantenimiento.plan) %></div>
              <input type="hidden" name="plan" id="planInput">
              <button class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Guardar plan</button>
            </form>
          <% } else { %>
            <div class="detail-item">
              <div class="detail-value"><%- renderPlanHtml(mantenimiento.plan) %></div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card">
        <div class="card-body">
          <h2 class="page-title fs-5 mb-3"><i class="bi bi-person-gear"></i> Ejecución</h2>

          <% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
            <form method="POST" action="/mantenimientos/<%= mantenimiento.id %>/ejecucion" id="formEjecucion">
              <label class="form-label">Mecánicos que trabajaron</label>
              <div class="mechanic-grid mb-3">
                <% mecanicos.forEach(m => { %>
                  <label class="mechanic-check" for="mec_<%= m.id %>">
                    <input
                      class="form-check-input me-2"
                      type="checkbox"
                      name="mecanicos[]"
                      value="<%= m.id %>"
                      id="mec_<%= m.id %>"
                      <%= mecanicosAsignados.some(a => String(a.id) === String(m.id)) ? 'checked' : '' %>
                    >
                    <%= m.nombre %>
                  </label>
                <% }) %>
              </div>

              <div class="mb-3">
                <label class="form-label">Trabajos realizados</label>
                <textarea name="ejecucion" class="form-control" rows="5" required><%= mantenimiento.ejecucion || '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Pendiente</label>
                <textarea name="pendiente" class="form-control" rows="3"><%= mantenimiento.pendiente || '' %></textarea>
              </div>

              <button class="btn btn-success"><i class="bi bi-check2-circle"></i> Guardar y cerrar mantenimiento</button>
            </form>
          <% } else { %>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-label">Mecánicos</div>
                <div class="detail-value"><%= mecanicosAsignados.map(m => m.nombre).join(', ') || '—' %></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Trabajos realizados</div>
                <div class="detail-value"><%= mantenimiento.ejecucion || '—' %></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Pendiente</div>
                <div class="detail-value"><%= mantenimiento.pendiente || '—' %></div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const formPlan = document.getElementById("formPlanTaller");
  const planEditor = document.getElementById("planEditor");
  const planInput = document.getElementById("planInput");
  const btnPlanRojo = document.getElementById("btnPlanRojo");
  const btnPlanNormal = document.getElementById("btnPlanNormal");

  function focusPlanEditor() {
    if (planEditor) planEditor.focus();
  }

  function selectionDentroPlan() {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0 || !planEditor) return null;
    const range = selection.getRangeAt(0);
    const container = range.commonAncestorContainer.nodeType === Node.TEXT_NODE
      ? range.commonAncestorContainer.parentNode
      : range.commonAncestorContainer;
    if (!planEditor.contains(container)) return null;
    return { selection, range };
  }

  function unwrapNode(node) {
    const parent = node.parentNode;
    while (node.firstChild) parent.insertBefore(node.firstChild, node);
    parent.removeChild(node);
  }

  if (btnPlanRojo && planEditor) {
    btnPlanRojo.addEventListener("click", () => {
      focusPlanEditor();
      const current = selectionDentroPlan();
      if (!current || current.selection.isCollapsed) {
        alert("Seleccione la palabra o frase que quiere marcar en rojo.");
        return;
      }

      const texto = current.selection.toString();
      const span = document.createElement("span");
      span.className = "plan-red";
      span.textContent = texto;
      current.range.deleteContents();
      current.range.insertNode(span);
      current.selection.removeAllRanges();
    });
  }

  if (btnPlanNormal && planEditor) {
    btnPlanNormal.addEventListener("click", () => {
      focusPlanEditor();
      const current = selectionDentroPlan();
      if (!current) return;
      const node = current.range.commonAncestorContainer.nodeType === Node.TEXT_NODE
        ? current.range.commonAncestorContainer.parentNode
        : current.range.commonAncestorContainer;
      const marcado = node.closest ? node.closest(".plan-red") : null;
      if (marcado && planEditor.contains(marcado)) unwrapNode(marcado);
    });
  }

  if (planEditor) {
    planEditor.addEventListener("paste", (event) => {
      event.preventDefault();
      const text = (event.clipboardData || window.clipboardData).getData("text/plain");
      document.execCommand("insertText", false, text);
    });
  }

  function normalizarPlanHtml(html) {
    const wrapper = document.createElement("div");
    wrapper.innerHTML = html || "";

    wrapper.querySelectorAll("*").forEach((node) => {
      const color = String(node.style?.color || "").toLowerCase();
      const colorAttr = String(node.getAttribute("color") || "").toLowerCase();
      const colorTexto = `${color} ${colorAttr}`;
      const esRojo = colorTexto.includes("220") || colorTexto.includes("dc2626") || colorTexto.includes("red") || colorTexto.includes("rgb(220, 38, 38)");

      if (esRojo) {
        const span = document.createElement("span");
        span.className = "plan-red";
        span.textContent = node.textContent || "";
        node.replaceWith(span);
      } else if (node.tagName !== "BR") {
        node.replaceWith(document.createTextNode(node.textContent || ""));
      }
    });

    return wrapper.innerHTML;
  }

  if (formPlan && planEditor && planInput) {
    formPlan.addEventListener("submit", function(e) {
      const texto = planEditor.innerText.trim();
      if (!texto) {
        e.preventDefault();
        alert("Debe escribir el plan del taller.");
        planEditor.focus();
        return;
      }

      planInput.value = normalizarPlanHtml(planEditor.innerHTML);
    });
  }

  const form = document.getElementById("formEjecucion");

  if (form) {
    form.addEventListener("submit", function(e) {
      const checkboxes = document.querySelectorAll("input[name='mecanicos[]']");
      const seleccionado = Array.from(checkboxes).some(cb => cb.checked);

      if (!seleccionado) {
        e.preventDefault();
        alert("Debe seleccionar al menos un mecánico antes de cerrar.");
      }
    });
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
