<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mantenimiento - <%= mantenimiento.placa %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
</head>

<body>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-tools"></i> Tomza - Taller</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="text-white small"><%= user.usuario %> (<%= user.rol %>)</span>
    <a href="/mantenimientos" class="btn btn-outline-light btn-sm">Mantenimientos</a>
    <a href="/agenda" class="btn btn-secondary btn-sm">Agenda</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Mantenimiento <%= mantenimiento.placa %></h1>
      <p class="page-subtitle">Planificación, mecánicos asignados y cierre del trabajo.</p>
    </div>
    <span class="badge <%= mantenimiento.estado === 'CERRADO' ? 'badge-closed' : 'badge-open' %>"><%= mantenimiento.estado %></span>
  </div>

  <div class="surface-card p-3 mb-3">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-label">Placa</div>
        <div class="detail-value"><%= mantenimiento.placa %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Sede</div>
        <div class="detail-value"><%= mantenimiento.sede %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Tipo</div>
        <div class="detail-value"><%= mantenimiento.tipo %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Prioridad</div>
        <div class="detail-value"><span class="badge badge-priority"><%= mantenimiento.prioridad || 'MEDIA' %></span></div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="page-title fs-5 mb-3"><i class="bi bi-clipboard-check"></i> Plan del taller</h2>

          <% if (['ADMIN','TALLER'].includes(user.rol)) { %>
            <form method="POST" action="/mantenimientos/<%= mantenimiento.id %>/plan">
              <textarea name="plan" class="form-control mb-3" rows="8" required><%= mantenimiento.plan || '' %></textarea>
              <button class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Guardar plan</button>
            </form>
          <% } else { %>
            <div class="detail-item">
              <div class="detail-value"><%= mantenimiento.plan || 'No definido' %></div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card">
        <div class="card-body">
          <h2 class="page-title fs-5 mb-3"><i class="bi bi-person-gear"></i> Ejecución</h2>

          <% if (['ADMIN','MECANICO'].includes(user.rol)) { %>
            <form method="POST" action="/mantenimientos/<%= mantenimiento.id %>/ejecucion" id="formEjecucion">
              <label class="form-label">Mecánicos que trabajaron</label>
              <div class="mechanic-grid mb-3">
                <% mecanicos.forEach(m => { %>
                  <label class="mechanic-check" for="mec_<%= m.id %>">
                    <input
                      class="form-check-input me-2"
                      type="checkbox"
                      name="mecanicos[]"
                      value="<%= m.id %>"
                      id="mec_<%= m.id %>"
                      <%= mecanicosAsignados.some(a => String(a.id) === String(m.id)) ? 'checked' : '' %>
                    >
                    <%= m.nombre %>
                  </label>
                <% }) %>
              </div>

              <div class="mb-3">
                <label class="form-label">Trabajos realizados</label>
                <textarea name="ejecucion" class="form-control" rows="5" required><%= mantenimiento.ejecucion || '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">Pendiente</label>
                <textarea name="pendiente" class="form-control" rows="3"><%= mantenimiento.pendiente || '' %></textarea>
              </div>

              <button class="btn btn-success"><i class="bi bi-check2-circle"></i> Guardar y cerrar mantenimiento</button>
            </form>
          <% } else { %>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-label">Mecánicos</div>
                <div class="detail-value"><%= mecanicosAsignados.map(m => m.nombre).join(', ') || '—' %></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Trabajos realizados</div>
                <div class="detail-value"><%= mantenimiento.ejecucion || '—' %></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Pendiente</div>
                <div class="detail-value"><%= mantenimiento.pendiente || '—' %></div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById("formEjecucion");

  if (form) {
    form.addEventListener("submit", function(e) {
      const checkboxes = document.querySelectorAll("input[name='mecanicos[]']");
      const seleccionado = Array.from(checkboxes).some(cb => cb.checked);

      if (!seleccionado) {
        e.preventDefault();
        alert("Debe seleccionar al menos un mecánico antes de cerrar.");
      }
    });
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
