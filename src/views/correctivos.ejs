<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Correctivos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
</head>
<body>

<%
  const reportes = Array.isArray(reportesPendientes) ? reportesPendientes : [];
  const conPendiente = correctivos.filter(c => c.pendiente).length;
  const conMecanico = correctivos.filter(c => c.mecanicos && c.mecanicos !== '—').length;
  const placasUnicas = new Set(correctivos.map(c => c.placa)).size;
%>

<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-wrench-adjustable"></i> Tomza - Correctivos</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos" class="btn btn-outline-light btn-sm ms-2">Preventivos</a>
  </div>
</nav>

<div class="container py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Historial de correctivos</h1>
      <p class="page-subtitle">Trabajos no programados, repuestos y seguimiento por unidad.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/mantenimientos/dashboard" class="btn btn-primary btn-sm"><i class="bi bi-bar-chart-line"></i> Dashboard IA</a>
      <a href="/reportes-supervisores" class="btn btn-outline-primary btn-sm"><i class="bi bi-clipboard-pulse"></i> Reportes supervisores</a>
      <% if (['MECANICO','ADMIN','TALLER'].includes(user.rol)) { %>
        <a href="/mantenimientos/correctivos/nuevo" class="btn btn-danger btn-sm"><i class="bi bi-plus-circle"></i> Nuevo mantenimiento</a>
      <% } %>
    </div>
  </div>

  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-label">Correctivos</div>
      <div class="summary-value"><%= correctivos.length %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Con pendiente</div>
      <div class="summary-value"><%= conPendiente %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Con mecánico</div>
      <div class="summary-value"><%= conMecanico %></div>
    </div>
    <div class="summary-card">
      <div class="summary-label">Unidades</div>
      <div class="summary-value"><%= placasUnicas %></div>
    </div>
  </div>

  <% if (['MECANICO','ADMIN','TALLER'].includes(user.rol)) { %>
    <div class="surface-card mb-3">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div>
          <h2 class="page-title fs-5">Reportes pendientes de supervisores</h2>
          <p class="page-subtitle">Seleccione un reporte para completar el correctivo y moverlo al historial.</p>
        </div>
        <span class="badge text-bg-dark"><%= reportes.length %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Placa</th>
              <th>Tipo</th>
              <th>Sede</th>
              <th>Reporte</th>
              <th>Supervisor</th>
              <th>Fecha</th>
              <th class="text-end">Acción</th>
            </tr>
          </thead>
          <tbody>
            <% if (!reportes.length) { %>
              <tr><td colspan="7" class="empty-state">No hay reportes pendientes para completar.</td></tr>
            <% } %>
            <% reportes.forEach(r => { %>
              <tr>
                <td data-label="Placa"><strong><%= r.placa %></strong></td>
                <td data-label="Tipo"><span class="badge text-bg-light"><%= r.tipo_mantenimiento || 'CORRECTIVO' %></span></td>
                <td data-label="Sede"><%= r.sede %></td>
                <td data-label="Reporte" class="text-cell">
                  <% if (r.importante) { %><span class="badge text-bg-danger me-1">Importante</span><% } %>
                  <span class="<%= r.importante ? 'text-danger fw-bold' : '' %>"><%= r.descripcion_limpia || r.descripcion_original %></span>
                </td>
                <td data-label="Supervisor"><%= r.supervisor_nombre || '—' %></td>
                <td data-label="Fecha"><%= r.fecha_reporte ? new Date(r.fecha_reporte).toLocaleDateString('es-CR') : '—' %></td>
                <td data-label="Acción" class="text-end">
                  <a href="/mantenimientos/correctivos/nuevo?reporte_id=<%= r.id %>" class="btn btn-sm btn-success">
                    <i class="bi bi-check-circle"></i> Completar
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="surface-card">
    <div class="p-3 border-bottom">
      <h2 class="page-title fs-5">Listado</h2>
      <p class="page-subtitle">Ordenado por fecha más reciente.</p>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Placa</th>
            <th>Tipo</th>
            <th>Trabajo realizado</th>
            <th>Pendiente</th>
            <th>Mecánico(s)</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (correctivos.length === 0) { %>
            <tr><td colspan="7" class="empty-state">No hay correctivos registrados.</td></tr>
          <% } else { %>
            <% correctivos.forEach(c => { %>
              <tr>
                <td data-label="Fecha"><%= c.fecha_formato %></td>
                <td data-label="Placa"><strong><%= c.placa %></strong></td>
                <td data-label="Tipo"><span class="badge text-bg-light"><%= c.tipo_mantenimiento || 'CORRECTIVO' %></span></td>
                <td data-label="Trabajo realizado" class="text-cell"><%= c.trabajo_realizado %></td>
                <td data-label="Pendiente" class="text-cell">
                  <% if (c.pendiente) { %>
                    <span class="badge badge-today me-1">Pendiente</span><%= c.pendiente %>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td data-label="Mecánico(s)"><%= c.mecanicos %></td>
                <td data-label="Acciones" class="text-end">
                  <a href="/mantenimientos/correctivos/<%= c.id %>/agregar" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle"></i> Agregar más
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
