<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Correctivos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark px-3">
  <span class="navbar-brand">Tomza - Correctivos</span>
  <div class="text-white">
    <%= user.usuario %> (<%= user.rol %>)
    <a href="/mantenimientos" class="btn btn-secondary btn-sm ms-2">Volver</a>
  </div>
</nav>

<div class="container mt-4">

  <h4 class="mb-3">📕 Historial de Correctivos</h4>

  <table class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th>Fecha</th>
        <th>Placa</th>
        <th>Trabajo realizado</th>
        <th>Pendiente</th>
        <th>Mecánico</th>
      </tr>
    </thead>
    <tbody>
      <% if (correctivos.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center">No hay correctivos</td>
        </tr>
      <% } %>

      <% correctivos.forEach(c => { %>
        <tr>
          <td><%= c.fecha_formato %></td>
          <td><strong><%= c.placa %></strong></td>
          <td><%= c.trabajo_realizado %></td>
          <td><%= c.pendiente || '—' %></td>
          <td><%= c.mecanicos %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>
</body>
</html>
