<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Órdenes Motor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f3f6fa; color: #111827; font-family: "Segoe UI", Roboto, Arial, sans-serif; }
    .topbar { background: #111827; border-bottom: 3px solid #dc2626; }
    .shell { max-width: 1180px; }
    .hero, .panel, .stat-card { background: #fff; border: 1px solid #dbe3ef; border-radius: 10px; }
    .hero { padding: 1rem; }
    .page-title { font-size: 1.45rem; font-weight: 900; margin: 0; }
    .small-muted { color: #64748b; }
    .stat-grid { display: grid; gap: .75rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stat-card { padding: .9rem; }
    .stat-label { color: #64748b; font-size: .75rem; font-weight: 900; text-transform: uppercase; }
    .stat-value { font-size: 1.5rem; font-weight: 900; }
    .table thead th { background: #f8fafc; color: #475569; font-size: .75rem; font-weight: 900; text-transform: uppercase; }
    @media (max-width: 760px) { .stat-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(ordenes) ? ordenes : [];
  const filtrosActuales = filtros || {};
  const total = Number(totalFiltrado || 0);
  const abiertas = lista.filter(o => !['RECIBIDA_TOTAL', 'ANULADA'].includes(o.estado)).length;
%>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-gear-wide-connected me-2"></i>Órdenes Motor</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Dashboard</a>
  </div>
</nav>

<main class="container-fluid shell py-4">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Órdenes Motor</h1>
        <div class="small-muted">Presupuesto separado. Estas órdenes no entran en el gasto normal de compras.</div>
      </div>
      <a href="/ordenes-motor/nueva" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Nueva orden motor</a>
    </div>
  </section>

  <section class="panel p-3 mb-3">
    <form method="GET" action="/ordenes-motor" class="row g-2">
      <div class="col-md-3">
        <label class="form-label small fw-bold">Proveedor</label>
        <select name="proveedor_id" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% proveedores.forEach(p => { %>
            <option value="<%= p.id %>" <%= filtrosActuales.proveedor_id == p.id ? 'selected' : '' %>><%= p.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Desde</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Hasta</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtrosActuales.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Placa</label>
        <input type="text" name="placa_unidad" class="form-control form-control-sm text-uppercase" value="<%= filtrosActuales.placa_unidad || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-bold">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estados.forEach(est => { %>
            <option value="<%= est %>" <%= filtrosActuales.estado === est ? 'selected' : '' %>><%= est.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end">
        <button class="btn btn-dark btn-sm w-100">Filtrar</button>
      </div>
    </form>
  </section>

  <section class="stat-grid mb-3">
    <div class="stat-card"><div class="stat-label">Órdenes motor</div><div class="stat-value"><%= lista.length %></div></div>
    <div class="stat-card"><div class="stat-label">Abiertas</div><div class="stat-value"><%= abiertas %></div></div>
    <div class="stat-card"><div class="stat-label">Total filtrado</div><div class="stat-value">₡<%= total.toLocaleString('es-CR', { maximumFractionDigits: 0 }) %></div></div>
  </section>

  <section class="panel">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th>Número</th>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th>Placa</th>
            <th>Motor</th>
            <th>Total</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (!lista.length) { %>
            <tr><td colspan="8" class="text-center text-muted py-4 fw-bold">No hay órdenes motor.</td></tr>
          <% } %>
          <% lista.forEach(orden => { %>
            <tr>
              <td><strong><%= orden.numero %></strong></td>
              <td><%= new Date(orden.fecha).toLocaleDateString('es-CR') %></td>
              <td><%= orden.proveedor_nombre || '-' %></td>
              <td><%= orden.placa_unidad || '-' %></td>
              <td><%= orden.motor || '-' %></td>
              <td>₡<%= Number(orden.total || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 }) %></td>
              <td><span class="badge text-bg-<%= orden.estado === 'RECIBIDA_TOTAL' ? 'success' : orden.estado === 'ANULADA' ? 'danger' : 'warning' %>"><%= orden.estado.replace('_', ' ') %></span></td>
              <td class="text-end">
                <a href="/ordenes-motor/<%= orden.id %>" class="btn btn-sm btn-outline-dark">Ver</a>
                <a href="/ordenes-motor/<%= orden.id %>/pdf" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf"></i></a>
                <a href="/ordenes-motor/<%= orden.id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
                <form method="POST" action="/ordenes-motor/<%= orden.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar esta orden motor?');">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
