<template id="linea-template">
  <div class="line-row">
    <div class="row g-2 align-items-end">
      <div class="col-md-7">
        <label class="form-label">Artículo</label>
        <div class="articulo-picker">
          <input class="form-control articulo-search mb-1" type="search" placeholder="Buscar por código, nombre, marca, categoría o ubicación" autocomplete="off">
          <select class="form-select articulo-select" name="articulo_id" required>
            <option value="">Seleccione</option>
            <% articulosDisponibles.forEach(a => { %>
              <option value="<%= a.id %>" data-search="<%= [
                a.codigo_taller,
                a.codigo,
                a.nombre,
                a.categoria,
                a.marca,
                a.numero_parte,
                a.tipo_unidad,
                a.ubicacion,
                grupoTexto(a.grupo_bodega),
                origenTexto(a.origen_inventario)
              ].filter(Boolean).join(' ') %>" data-codigo-proveedor="<%= a.codigo || '' %>"><%= a.codigo_taller || '----' %> · Prov. <%= a.codigo || 'Sin código' %> · <%= a.nombre %> · <%= grupoTexto(a.grupo_bodega) %> · <%= origenTexto(a.origen_inventario) %> · Stock <%= fmt(a.stock_actual) %> <%= a.unidad_medida %> · <%= a.ubicacion || 'Sin ubicación' %></option>
            <% }) %>
          </select>
          <div class="articulo-search-status mt-1">Escriba para filtrar el listado.</div>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label">Sale de</label>
        <select class="form-select" name="origen_salida">
          <option value="">Según artículo</option>
          <option value="PROPIO">Nuestro</option>
          <option value="CONSIGNACION">Consignación</option>
        </select>
      </div>
      <div class="col-md-2"><label class="form-label">Cantidad</label><input class="form-control" type="number" step="0.01" min="0.01" name="cantidad" value="1" required></div>
      <div class="col-md-1 d-grid"><label class="form-label">&nbsp;</label><button type="button" class="btn btn-outline-danger remove-linea"><i class="bi bi-x"></i></button></div>
    </div>
  </div>
</template>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const normalizarEntradaPlaca = value => String(value || '').trim().toUpperCase().replace(/\s+/g, '');

  const seleccionarPlaca = (input, placa) => {
    input.value = placa;
    input.dataset.placaValidada = normalizarEntradaPlaca(placa);
    input.setCustomValidity('');
    const lista = input.closest('.placa-picker')?.querySelector('.placa-options');
    if (lista) lista.hidden = true;
    input.setAttribute('aria-expanded', 'false');
  };

  const prepararBuscadorPlaca = (input, index) => {
    const picker = document.createElement('div');
    picker.className = 'placa-picker';
    input.parentNode.insertBefore(picker, input);
    picker.appendChild(input);
    const lista = document.createElement('div');
    lista.className = 'placa-options';
    lista.id = `placa-opciones-${index}`;
    lista.setAttribute('role', 'listbox');
    lista.hidden = true;
    picker.appendChild(lista);
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-controls', lista.id);
    input.setAttribute('aria-expanded', 'false');

    let timer;
    let consultaId = 0;
    let botones = [];
    let activo = -1;
    const cerrar = () => {
      lista.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    };
    const mostrar = unidades => {
      lista.replaceChildren();
      botones = [];
      activo = -1;
      if (!unidades.length) {
        const vacio = document.createElement('div');
        vacio.className = 'placa-empty';
        vacio.textContent = 'No hay placas activas que coincidan.';
        lista.appendChild(vacio);
      }
      unidades.forEach((unidad, itemIndex) => {
        const opcion = document.createElement('button');
        opcion.type = 'button';
        opcion.className = 'placa-option';
        opcion.id = `${lista.id}-${itemIndex}`;
        opcion.setAttribute('role', 'option');
        const titulo = document.createElement('strong');
        titulo.textContent = unidad.placa;
        const detalle = document.createElement('small');
        detalle.textContent = [unidad.sede, unidad.marca, unidad.modelo].filter(Boolean).join(' · ');
        opcion.append(titulo, detalle);
        opcion.addEventListener('pointerdown', event => event.preventDefault());
        opcion.addEventListener('click', () => { seleccionarPlaca(input, unidad.placa); cerrar(); });
        lista.appendChild(opcion);
        botones.push(opcion);
      });
      lista.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };
    const consultar = async () => {
      const q = input.value.trim();
      const actual = ++consultaId;
      if (!q) return cerrar();
      try {
        const respuesta = await fetch(`/bodega/api/placas?q=${encodeURIComponent(q)}`, { headers: { Accept: 'application/json' } });
        if (!respuesta.ok) throw new Error('No se pudieron consultar las placas.');
        const unidades = await respuesta.json();
        if (actual === consultaId && input.value.trim() === q) mostrar(unidades);
      } catch (error) {
        if (actual === consultaId) {
          mostrar([]);
          lista.querySelector('.placa-empty').textContent = error.message;
        }
      }
    };
    input.addEventListener('input', () => {
      input.value = input.value.toUpperCase();
      input.dataset.placaValidada = '';
      input.setCustomValidity(input.value.trim() ? 'Seleccione una placa de la lista.' : '');
      cerrar();
      clearTimeout(timer);
      timer = setTimeout(consultar, 180);
    });
    input.addEventListener('focus', () => { if (input.value && !input.dataset.placaValidada) consultar(); });
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') return cerrar();
      if (lista.hidden || !botones.length) return;
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        activo = (activo + (event.key === 'ArrowDown' ? 1 : -1) + botones.length) % botones.length;
        botones.forEach((boton, i) => boton.classList.toggle('active', i === activo));
        input.setAttribute('aria-activedescendant', botones[activo].id);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        botones[activo >= 0 ? activo : 0].click();
      }
    });
    input.addEventListener('blur', () => setTimeout(cerrar, 150));
    input.form?.addEventListener('submit', event => {
      if (!input.value.trim() && !input.required) return;
      if (input.dataset.placaValidada !== normalizarEntradaPlaca(input.value)) {
        event.preventDefault();
        input.setCustomValidity('Seleccione una placa de la lista.');
        input.reportValidity();
        input.focus();
      }
    });
  };

  document.querySelectorAll('.placa-search').forEach(prepararBuscadorPlaca);

  const normalizarBusquedaArticulo = (value) => String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();

  const escaparHtml = (value) => String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');

  const actualizarFiltroArticulo = (picker) => {
    const input = picker.querySelector('.articulo-search');
    const select = picker.querySelector('.articulo-select');
    const status = picker.querySelector('.articulo-search-status');
    if (!input || !select) return;

    const query = normalizarBusquedaArticulo(input.value.trim());
    let visibles = 0;

    Array.from(select.options).forEach((option, index) => {
      if (index === 0) {
        option.hidden = false;
        option.disabled = false;
        return;
      }

      const text = normalizarBusquedaArticulo(`${option.dataset.search || ''} ${option.textContent || ''}`);
      const visible = !query || text.includes(query);
      option.hidden = !visible;
      option.disabled = !visible;
      if (visible) visibles += 1;
    });

    const selected = select.selectedOptions[0];
    if (selected?.disabled) select.value = '';
    if (status) {
      status.textContent = query
        ? `${visibles} artículo(s) encontrados.`
        : 'Escriba para filtrar el listado.';
    }
  };

  const prepararBuscadorArticulo = (picker) => {
    if (!picker || picker.dataset.ready === '1') return;
    const input = picker.querySelector('.articulo-search');
    const select = picker.querySelector('.articulo-select');
    const status = picker.querySelector('.articulo-search-status');
    if (!input || !select) return;

    picker.dataset.ready = '1';
    input.addEventListener('input', () => actualizarFiltroArticulo(picker));
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      const firstVisible = Array.from(select.options).find(option => option.value && !option.disabled && !option.hidden);
      if (firstVisible) {
        select.value = firstVisible.value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
    select.addEventListener('change', () => {
      const option = select.selectedOptions[0];
      if (status) status.textContent = option?.value
        ? (option.hasAttribute('data-codigo-proveedor') ? `Código proveedor: ${option.dataset.codigoProveedor || 'Sin código'}` : 'Artículo seleccionado.')
        : 'Seleccione un artículo.';
    });
    actualizarFiltroArticulo(picker);
  };

  document.querySelectorAll('.articulo-picker').forEach(prepararBuscadorArticulo);

  document.getElementById('add-linea')?.addEventListener('click', () => {
    const template = document.getElementById('linea-template');
    const target = document.getElementById('lineas-entrega');
    if (!template || !target) return;
    const fragment = template.content.cloneNode(true);
    const nuevaLinea = fragment.querySelector('.line-row');
    target.appendChild(fragment);
    nuevaLinea?.querySelectorAll('.articulo-picker').forEach(prepararBuscadorArticulo);
  });

  document.addEventListener('click', (event) => {
    const button = event.target.closest('.remove-linea');
    if (!button) return;
    button.closest('.line-row')?.remove();
  });

  let consultaCompatibilidad = null;
  const placaCompatible = document.getElementById('placa-compatible');
  const servicioCompatible = document.getElementById('servicio-compatible');
  const resultadoCompatible = document.getElementById('resultado-compatible');
  const unidadCompatible = document.getElementById('unidad-compatible');
  const mensajeCompatible = document.getElementById('mensaje-compatible');
  const cargarDespacho = document.getElementById('cargar-despacho');

  const productosCompatiblesVisibles = () => {
    const servicio = servicioCompatible?.value || '';
    return (consultaCompatibilidad?.productos || []).filter(item => !servicio || item.tipo_servicio === servicio);
  };

  const renderCompatibilidad = () => {
    if (!resultadoCompatible || !consultaCompatibilidad) return;
    const productos = productosCompatiblesVisibles();
    const tbody = resultadoCompatible.querySelector('tbody');
    tbody.innerHTML = '';

    productos.forEach(item => {
      const stock = Number(item.stock_actual || 0);
      const cantidad = Number(item.cantidad_recomendada || 1);
      const disponible = stock >= cantidad;
      const confianza = String(item.nivel_confianza || 'MANUAL').toUpperCase();
      const seleccionAutomatica = disponible && confianza !== 'PROBABLE';
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><input class="form-check-input compatible-check" type="checkbox" data-articulo-id="${item.articulo_id}" data-cantidad="${cantidad}" data-origen="${item.origen_inventario || ''}" ${seleccionAutomatica ? 'checked' : ''} ${disponible ? '' : 'disabled'}></td>
        <td><strong>${escaparHtml(item.nombre)}</strong><div class="small text-muted">${escaparHtml(item.tipo_servicio)}${item.observacion ? ` · ${escaparHtml(item.observacion)}` : ''}</div><span class="badge ${confianza === 'PROBABLE' ? 'text-bg-warning' : 'text-bg-success'}">${escaparHtml(confianza)}</span>${item.criterio_compatibilidad ? `<div class="small text-muted">${escaparHtml(item.criterio_compatibilidad)}</div>` : ''}</td>
        <td><span class="code-badge">${escaparHtml(item.codigo_taller || '----')}</span><div class="small text-muted">${escaparHtml(item.codigo || 'Sin código proveedor')}</div></td>
        <td class="fw-bold ${disponible ? 'text-success' : 'text-danger'}">${stock.toLocaleString('es-CR')} ${item.unidad_medida || ''}</td>
        <td>${escaparHtml(item.ubicacion || 'Sin ubicación')}</td>
        <td><input class="form-control form-control-sm compatible-cantidad" type="number" min="0.01" step="0.01" value="${cantidad}" ${disponible ? '' : 'disabled'}></td>`;
      tbody.appendChild(row);
    });

    resultadoCompatible.classList.toggle('d-none', productos.length === 0);
    mensajeCompatible.textContent = productos.length
      ? `${productos.length} repuesto(s) compatibles. Los productos sin existencia no se pueden despachar.`
      : 'No hay repuestos registrados para este tipo de trabajo.';
    cargarDespacho.disabled = !productos.some(item => Number(item.stock_actual || 0) >= Number(item.cantidad_recomendada || 1));
  };

  const buscarCompatibilidad = async () => {
    const placa = String(placaCompatible?.value || '').trim().toUpperCase();
    if (!placa) {
      placaCompatible.setCustomValidity('Seleccione una placa de la lista.');
      placaCompatible.reportValidity();
      placaCompatible.focus();
      return;
    }
    if (placaCompatible.dataset.placaValidada !== normalizarEntradaPlaca(placa)) {
      placaCompatible.setCustomValidity('Seleccione una placa de la lista.');
      placaCompatible.reportValidity();
      placaCompatible.focus();
      return;
    }
    consultaCompatibilidad = null;
    resultadoCompatible?.classList.add('d-none');
    unidadCompatible?.classList.add('d-none');
    cargarDespacho.disabled = true;
    mensajeCompatible.textContent = 'Consultando unidad y compatibilidades...';
    try {
      const response = await fetch(`/bodega/api/compatibilidad/${encodeURIComponent(placa)}`, { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'No se pudo consultar la placa.');
      consultaCompatibilidad = data;
      const u = data.unidad;
      unidadCompatible.innerHTML = `<strong>${escaparHtml(u.placa)}</strong> · ${escaparHtml(u.marca || 'Sin marca')} ${escaparHtml(u.modelo || 'Sin modelo')} · ${escaparHtml(u.anio || 'Sin año')} · Motor: ${escaparHtml(u.motor || data.configuracion?.motor || 'sin especificar')} · Sede: ${escaparHtml(u.sede || 'sin sede')}`;
      unidadCompatible.classList.remove('d-none');
      servicioCompatible.innerHTML = '<option value="">Todos los compatibles</option>' + (data.servicios || []).map(servicio => `<option value="${escaparHtml(servicio)}">${escaparHtml(servicio)}</option>`).join('');
      servicioCompatible.disabled = !(data.servicios || []).length;
      if ((data.servicios || []).length) servicioCompatible.value = data.servicios[0];
      if (!data.configuracion) {
        mensajeCompatible.innerHTML = `Esta unidad todavía no tiene configuración. <a href="/bodega/compatibilidad" class="fw-bold">Configurar repuestos</a>`;
        return;
      }
      renderCompatibilidad();
    } catch (error) {
      mensajeCompatible.textContent = error.message;
    }
  };

  document.getElementById('buscar-compatible')?.addEventListener('click', buscarCompatibilidad);
  placaCompatible?.addEventListener('keydown', event => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    buscarCompatibilidad();
  });
  servicioCompatible?.addEventListener('change', renderCompatibilidad);

  cargarDespacho?.addEventListener('click', () => {
    const seleccionados = Array.from(resultadoCompatible?.querySelectorAll('.compatible-check:checked') || []).map(check => {
      const row = check.closest('tr');
      return {
        articuloId: check.dataset.articuloId,
        cantidad: row.querySelector('.compatible-cantidad')?.value || check.dataset.cantidad || '1',
        origen: check.dataset.origen || ''
      };
    });
    if (!seleccionados.length) return;

    const target = document.getElementById('lineas-entrega');
    const template = document.getElementById('linea-template');
    const primera = target?.querySelector('.line-row');
    if (!target || !template || !primera) return;
    Array.from(target.querySelectorAll('.line-row')).slice(1).forEach(row => row.remove());

    seleccionados.forEach((item, index) => {
      let linea = primera;
      if (index > 0) {
        const fragment = template.content.cloneNode(true);
        linea = fragment.querySelector('.line-row');
        target.appendChild(fragment);
        linea.querySelectorAll('.articulo-picker').forEach(prepararBuscadorArticulo);
      }
      const select = linea.querySelector('[name="articulo_id"]');
      const cantidad = linea.querySelector('[name="cantidad"]');
      const origen = linea.querySelector('[name="origen_salida"]');
      select.value = item.articuloId;
      cantidad.value = item.cantidad;
      origen.value = item.origen;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    });

    seleccionarPlaca(document.getElementById('placa-entrega'), consultaCompatibilidad.unidad.placa);
    document.getElementById('form-entrega')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
</body>
</html>
