<details class="small mt-2"><summary>Detalle de artículos y recepción</summary><table class="table table-sm"><thead><tr><th>Artículo XML</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>IVA %</th></tr></thead><tbody><% for(const l of o.factura.electronica.lineas||[]){ %><tr><td><%= l.codigo %> · <%= l.descripcion %></td><td><%= l.cantidad %></td><td><%= l.precio_unitario %></td><td><%= l.descuento %></td><td><%= l.iva %></td></tr><% } %></tbody></table><% if(o.control.orden?.length){ %><table class="table table-sm"><thead><tr><th>Artículo OC</th><th>Ordenado</th><th>Recibido</th><th>Precio</th></tr></thead><tbody><% for(const l of o.control.orden){ %><tr><td><%= l.codigo %> · <%= l.descripcion %></td><td><%= l.cantidad %></td><td><%= l.recibida %></td><td><%= l.precio_unitario %></td></tr><% } %></tbody></table><% } %>
<% if(puedeRecibir&&o.orden_compra?.origen==='COMPRAS'&&o.control.orden?.some(l=>l.recibida<l.cantidad)){ %><form data-portal-api="<%= url %>/recepcion"><label>Referencia de entrega<input class="form-control form-control-sm" name="referencia" maxlength="100" required></label><% o.control.orden.forEach((l,i)=>{ %><label><%= l.codigo %> · pendiente <%= Number(l.cantidad)-Number(l.recibida) %><input class="form-control form-control-sm" name="cantidad_<%= l.id??i %>" type="number" min="0" max="<%= Math.max(0,Number(l.cantidad)-Number(l.recibida)) %>" step="0.001" value="0" required></label><% }) %><button class="btn btn-sm btn-primary mt-2">Confirmar cantidades recibidas</button></form><% } %>
<% if(o.orden_compra?.origen==='PROVEEDURIA'&&!o.control.recepcion){ %><a href="<%= o.orden_compra.url %>">Registrar recepción en la orden</a><% } %></details>