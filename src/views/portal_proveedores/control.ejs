<details class="small mt-2"><summary>Comparación con la orden de compra</summary><table class="table table-sm"><thead><tr><th>Artículo XML</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>IVA %</th></tr></thead><tbody><% for(const l of o.factura.electronica.lineas||[]){ %><tr><td><%= l.codigo %> · <%= l.descripcion %></td><td><%= l.cantidad %></td><td><%= l.precio_unitario %></td><td><%= l.descuento %></td><td><%= l.iva %></td></tr><% } %></tbody></table><% if(o.control.orden?.length){ %><table class="table table-sm"><thead><tr><th>Artículo OC</th><th>Ordenado</th><th>Precio</th></tr></thead><tbody><% for(const l of o.control.orden){ %><tr><td><%= l.codigo %> · <%= l.descripcion %></td><td><%= l.cantidad %></td><td><%= l.precio_unitario %></td></tr><% } %></tbody></table><% } %></details>
