<section class="card p-3 mt-3"><h2 class="h5">Facturas vinculadas a esta OC</h2><p class="small text-secondary">Puede vincular varias facturas. Cada una conserva su revisión, vencimiento y pagos; el monto acumulado no puede superar la orden.</p>
<% if(typeof puedeVincular!=='undefined'&&puedeVincular){ %><form data-api="<%= urlVincular %>" class="d-flex align-items-end gap-2 flex-wrap mb-3"><div data-form-status role="alert" hidden></div><label class="flex-grow-1">Factura recibida sin OC<select name="factura_id" class="form-select" required><option value="">Seleccione la factura</option><% facturasDisponibles.forEach(r=>{ %><option value="<%= r.id %>"><%= r.datos.factura.numero %> · <%= r.datos.proveedor %> · <%= r.datos.moneda %> <%= Number(r.datos.factura.total).toFixed(2) %></option><% }) %></select></label><button class="btn btn-outline-primary">Vincular factura</button><a class="btn btn-outline-dark" href="/proveeduria/portal-proveedores/facturas">Ver facturas recibidas</a></form><% } %>
<% if(!facturasPortal.length){ %><p class="text-secondary mb-0">No hay facturas del portal enlazadas a esta orden.</p><% }else{ %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Factura</th><th>Proveedor</th><th>Hacienda</th><th>Revisión interna</th><th>Vencimiento</th><th>Total</th><th>Pagado</th><th>Documentos</th></tr></thead><tbody><% facturasPortal.forEach(row=>{const d=row.datos,f=d.factura; %><tr><td><%= f.numero %></td><td><%= d.proveedor %></td><td><%= f.electronica.hacienda.estado %></td><td><%= f.estado %></td><td><%= f.fecha_vencimiento||'Pendiente' %></td><td><%= Number(f.total).toLocaleString('es-CR',{style:'currency',currency:d.moneda}) %></td><td><%= (d.pagos||[]).reduce((s,p)=>s+Number(p.monto),0).toFixed(2) %></td><td><a href="/proveeduria/portal-proveedores/facturas/<%= row.id %>/archivo/xml">XML</a> · <a href="/proveeduria/portal-proveedores/facturas/<%= row.id %>/archivo/pdf">PDF</a> · <a href="/proveeduria/portal-proveedores/facturas">Revisar en Contabilidad</a></td></tr><% }) %></tbody></table></div><% } %></section>
