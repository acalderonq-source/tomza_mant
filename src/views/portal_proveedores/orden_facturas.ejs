<section class="card p-3 mt-3"><h2 class="h5">Facturas del portal vinculadas a esta OC</h2><% if(!facturasPortal.length){ %><p class="text-secondary mb-0">No hay facturas del portal enlazadas a esta orden.</p><% }else{ %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Factura</th><th>Proveedor</th><th>Hacienda</th><th>Revisión interna</th><th>Total</th><th>Documentos</th></tr></thead><tbody><% facturasPortal.forEach(row=>{const d=row.datos,f=d.factura; %><tr><td><%= f.numero %></td><td><%= d.proveedor %></td><td><%= f.electronica.hacienda.estado %></td><td><%= f.estado %></td><td><%= Number(f.total).toLocaleString('es-CR',{style:'currency',currency:d.moneda}) %></td><td><a href="/proveeduria/portal-proveedores/facturas/<%= row.id %>/archivo/xml">XML</a> · <a href="/proveeduria/portal-proveedores/facturas/<%= row.id %>/archivo/pdf">PDF</a> · <a href="/proveeduria/portal-proveedores/facturas">Revisar en Contabilidad</a></td></tr><% }) %></tbody></table></div><% } %></section>
