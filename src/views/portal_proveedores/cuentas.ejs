<%- include('header',{titulo:'Cuentas de proveedores'}) %>
<header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><p><a href="/administracion">Administración</a> / Portal de proveedores</p><h1>Cuentas de proveedores</h1><p class="text-secondary">Cada proveedor ingresa con su correo y contraseña para gestionar todas sus facturas.</p><a href="/portal-proveedores/login" target="_blank" rel="noopener">Abrir ingreso de proveedores</a> · <a href="/proveeduria/portal-proveedores/facturas">Ver facturas recibidas</a></div></header>
<% if(puedeGestion){ %><div class="row g-4 mb-4"><section class="col-lg-7"><div class="card p-4 h-100"><h2 class="h4">Crear acceso de proveedor</h2><form data-portal-api="/administracion/portal-proveedores/cuentas" class="row g-3"><div class="col-12"><label class="form-label" for="proveedor">Proveedor registrado</label><select name="proveedor_id" id="proveedor" class="form-select" required><option value="">Seleccione un proveedor</option><% proveedores.forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Cédula del emisor<input name="cedula" class="form-control" pattern="[0-9]{9,12}" required></label></div><div class="col-md-6"><label class="form-label">Correo de ingreso<input name="email" class="form-control" type="email" required maxlength="254"></label></div><div class="col-md-8"><label class="form-label">Contraseña inicial<input name="password" class="form-control" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label></div><div class="col-md-4"><label class="form-label">Días de crédito<input name="plazo_dias" class="form-control" type="number" min="0" max="3650" value="30" required></label></div><div><button class="btn btn-primary">Crear cuenta</button></div></form><p class="small text-secondary mt-3 mb-0">Comparta el enlace de ingreso y las credenciales con el proveedor. La contraseña se almacena cifrada mediante hash; el proveedor puede cambiarla en su portal.</p></div></section>
<section class="col-lg-5"><div class="card p-4 h-100"><h2 class="h4">Empresas receptoras</h2><p class="small text-secondary">Solo se reciben facturas emitidas a estas cédulas.</p><form data-portal-api="/administracion/portal-proveedores/receptores"><label class="form-label">Cédula de la empresa<input class="form-control" name="cedula" pattern="[0-9]{9,12}" required></label><label class="form-label">Razón social<input class="form-control" name="nombre" required maxlength="255"></label><label class="form-label">Estado<select class="form-select" name="activo"><option value="1">Habilitada</option><option value="0">Deshabilitada</option></select></label><div><button class="btn btn-outline-primary">Guardar empresa</button></div></form><ul class="mt-3"><% receptores.forEach(r=>{ %><li><%= r.nombre %> · <%= r.cedula %> · <%= r.activo?'Habilitada':'Deshabilitada' %></li><% }) %></ul></div></section></div><% } %>
<section class="card p-4"><h2 class="h4">Accesos registrados</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Proveedor</th><th>Cédula</th><th>Correo</th><th>Crédito</th><th>Estado</th><% if(puedeGestion){ %><th>Acciones</th><% } %></tr></thead><tbody><% if(!cuentas.length){ %><tr><td colspan="6" class="text-secondary p-4">Todavía no hay cuentas de proveedores.</td></tr><% } %><% cuentas.forEach(c=>{ %><tr><td><%= c.nombre %></td><td><%= c.cedula %></td><td><%= c.email %></td><td><%= c.plazo_dias %> días</td><td><%= c.activo?'Activa':'Deshabilitada' %></td><% if(puedeGestion){ %><td><form data-portal-api="/administracion/portal-proveedores/cuentas/<%= c.id %>"><input type="hidden" name="accion" value="<%= c.activo?'desactivar':'activar' %>"><button class="btn btn-sm btn-outline-secondary"><%= c.activo?'Deshabilitar':'Habilitar' %></button></form><details class="mt-2"><summary>Restablecer contraseña</summary><form data-portal-api="/administracion/portal-proveedores/cuentas/<%= c.id %>"><input type="hidden" name="accion" value="password"><label class="small">Nueva contraseña<input class="form-control" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><button class="btn btn-sm btn-primary mt-2">Restablecer</button></form></details></td><% } %></tr><% }) %></tbody></table></div></section></main><script src="/js/portal-proveedores.js" defer></script></body></html>
