<%- include('header',{titulo:'Solicitudes de acceso'}) %>
<header class="mb-4"><p><a href="/administracion">Administración</a> / <a href="/administracion/portal-proveedores">Portal de proveedores</a></p><h1>Solicitudes de acceso</h1><p>Revisá la identidad fiscal y confirmá el correo con el proveedor antes de aprobar. Los datos recibidos todavía no están verificados.</p><p><strong><%= solicitudes.filter(s=>s.estado==='PENDIENTE').length %> pendientes</strong> · <a href="/portal-proveedores/solicitar-acceso" target="_blank" rel="noopener">Abrir formulario público</a></p></header>
<% if(!solicitudes.length){ %><div class="card p-4">Todavía no hay solicitudes.</div><% } %>
<% solicitudes.forEach(s=>{ %><section class="card p-4 mb-3"><div class="d-flex justify-content-between gap-3"><h2 class="h5"><%= s.razon_social %></h2><strong><%= s.estado %></strong></div><dl class="row"><dt class="col-sm-3">Cédula fiscal</dt><dd class="col-sm-9"><%= s.cedula %></dd><dt class="col-sm-3">Correo de ingreso</dt><dd class="col-sm-9"><%= s.email %></dd><dt class="col-sm-3">Contacto y teléfono</dt><dd class="col-sm-9"><%= s.contacto %> · <%= s.telefono %></dd><dt class="col-sm-3">Dirección</dt><dd class="col-sm-9"><%= s.direccion %></dd><dt class="col-sm-3">Recibida</dt><dd class="col-sm-9"><%= new Date(s.creado_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %></dd></dl>
<% if(s.estado==='PENDIENTE'){ %><form data-portal-api="/administracion/portal-proveedores/solicitudes/<%= s.id %>" class="row g-3"><input type="hidden" name="accion" value="aprobar"><div class="col-md-6"><label class="form-label">Proveedor del catálogo<select name="proveedor_id" class="form-select" required><option value="">Seleccione después de verificar</option><option value="nuevo">Registrar con la razón social solicitada</option><% proveedores.forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %></option><% }) %></select></label></div><div class="col-md-4"><label class="form-label">Contraseña inicial<input class="form-control" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128"></label></div><div class="col-md-2"><label class="form-label">Días de crédito<input class="form-control" name="plazo_dias" type="number" value="30" min="0" max="3650" required></label></div><div class="col-12"><p class="small text-secondary">Al aprobar se crea el acceso. Compartí con el proveedor el enlace, su correo de ingreso y la contraseña inicial por un canal verificado.</p><button class="btn btn-primary">Aprobar y crear acceso</button></div></form>
<details class="mt-3"><summary>Rechazar solicitud</summary><form data-portal-api="/administracion/portal-proveedores/solicitudes/<%= s.id %>" class="mt-2"><input type="hidden" name="accion" value="rechazar"><label class="form-label">Motivo<input class="form-control" name="motivo" required minlength="5" maxlength="500"></label><div><button class="btn btn-outline-danger">Rechazar</button></div></form></details>
<% }else{ %><p class="mb-0"><%= s.motivo||'Revisión completada' %><% if(s.cuenta_id){ %> · Acceso registrado #<%= s.cuenta_id %><% } %></p><% } %></section><% }) %>
</main><script src="/js/portal-proveedores.js" defer></script></body></html>
