<%- include('header',{titulo:'Facturas del portal'}) %>
<header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="text-primary fw-semibold">CONTABILIDAD · PROVEEDORES</span><h1 class="mt-2">Facturas recibidas y cuentas por pagar</h1><p class="text-secondary">El sistema cruza automáticamente proveedor, artículos, precios, impuestos y cantidades disponibles con las órdenes de Proveeduría y Taller / Compras. Revise las excepciones y apruebe las facturas aceptadas por Hacienda.</p></div><% if(typeof puedeAdministracion!=='undefined'&&puedeAdministracion){ %><a href="/administracion/portal-proveedores" class="btn btn-outline-primary align-self-start">Administrar portal de proveedores</a><% } %></header>
<%- include('taller_pendientes',{interno:true}) %>
<div class="row g-3 mb-4"><% for(const moneda of ['CRC','USD']){const total=docs.filter(d=>d.datos.moneda===moneda&&d.datos.factura.cuenta_por_pagar).reduce((n,d)=>n+Math.max(0,saldo(d.datos).saldo),0); %><div class="col-md-6"><div class="card p-3"><span class="text-secondary">Cuentas por pagar · <%= moneda %></span><strong class="fs-3"><%= total.toLocaleString('es-CR',{style:'currency',currency:moneda}) %></strong></div></div><% } %></div>
<% if(typeof seguimiento==='function'){const ss=docs.map(r=>seguimiento(r.datos)); %>
<section class="row g-3 mb-4" aria-label="Pendientes de atención"><% for(const [titulo,valor] of [['Facturas vencidas',ss.filter(s=>s.vencida).length],['Plazos de revisión vencidos',ss.filter(s=>s.atrasada).length],['Por vencer en 7 días',ss.filter(s=>s.proxima).length],['Sin orden vinculada',docs.filter(r=>!r.datos.orden_compra).length],...(docs.some(r=>r.aceptacionTomza)?[['Sin aceptación de Tomza (Creatica)',docs.filter(r=>r.aceptacionTomza&&r.aceptacionTomza.pendiente).length]]:[])]){ %><article class="col-md-3"><div class="card p-3"><span class="text-secondary"><%= titulo %></span><strong class="fs-3"><%= valor %></strong></div></article><% } %></section>
<p class="text-secondary small">Las facturas vencidas y las revisiones atrasadas aparecen primero. Los montos se mantienen separados por moneda.</p><% } %>
<% if(typeof seguimiento==='function'){const grupos=new Map();for(const r of docs){const seg=seguimiento(r.datos);if(seg.estado==='Pagada')continue;const nombre=seg.responsable;const g=grupos.get(nombre)||{cantidad:0,atrasadas:0,CRC:0,USD:0};g.cantidad++;if(seg.atrasada||seg.vencida)g.atrasadas++;if(['CRC','USD'].includes(r.datos.moneda))g[r.datos.moneda]+=Math.max(0,saldo(r.datos).saldo);grupos.set(nombre,g);} %>
<details class="card p-3 mb-4"><summary class="fw-semibold">Carga de trabajo por responsable</summary><div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Responsable</th><th>Pendientes</th><th>Atrasadas</th><th>Saldo de documentos CRC</th><th>Saldo de documentos USD</th></tr></thead><tbody><% for(const [nombre,g] of grupos){ %><tr><td><%= nombre %></td><td><%= g.cantidad %></td><td><%= g.atrasadas %></td><td><%= g.CRC.toLocaleString('es-CR',{style:'currency',currency:'CRC'}) %></td><td><%= g.USD.toLocaleString('es-CR',{style:'currency',currency:'USD'}) %></td></tr><% } %></tbody></table></div><p class="small text-secondary mb-0">Incluye documentos en revisión y devolución; las cuentas por pagar aprobadas se muestran por separado arriba.</p></details><% } %>
<%- include('empresas_filtro',{docs,saldo}) %>
<section class="card p-4"><div class="d-flex flex-wrap gap-2 mb-3"><button class="btn btn-outline-primary active" data-filter-state="todas">Todas</button><button class="btn btn-outline-danger" data-filter-state="excepciones">Excepciones (<%= docs.filter(d=>excepciones(d.datos).length).length %>)</button><button class="btn btn-outline-danger" data-filter-state="vencidas">Vencidas</button><button class="btn btn-outline-danger" data-filter-state="atrasadas">Revisión atrasada</button><button class="btn btn-outline-primary" data-filter-state="sin-orden">Sin OC</button><% if(docs.some(r=>r.aceptacionTomza)){ %><button class="btn btn-outline-danger" data-filter-state="sin-aceptacion">Sin aceptación Creatica (<%= docs.filter(r=>r.aceptacionTomza&&r.aceptacionTomza.pendiente).length %>)</button><% } %><button class="btn btn-outline-primary" data-filter-state="devuelta">Correcciones</button><button class="btn btn-outline-primary" data-filter-state="pendiente">En revisión</button><button class="btn btn-outline-primary" data-filter-state="programada">Pagos programados</button><button class="btn btn-outline-primary" data-filter-state="pagada">Pagadas</button></div><% if(typeof responsables!=='undefined'){ %><label class="mb-3">Responsable<select class="form-select" data-responsable-filtro><option value="">Todos</option><option value="sin-asignar">Sin asignar</option><% for(const r of responsables){ %><option value="<%= r.id %>"><%= r.username %></option><% } %></select></label><% } %><label>Buscar proveedor, factura o estado<input class="form-control" data-buscar type="search" placeholder="Escriba para filtrar"></label><%- include('tabla',{docs,saldo,excepciones,interno:true,puedeContabilidad}) %></section></main><script src="/js/portal-proveedores.js" defer></script></body></html>
