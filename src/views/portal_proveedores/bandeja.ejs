<%- include('header',{titulo:'Facturas del portal'}) %>
<header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="text-primary fw-semibold">CONTABILIDAD · PROVEEDORES</span><h1 class="mt-2">Facturas recibidas y cuentas por pagar</h1><p class="text-secondary">El sistema cruza automáticamente proveedor, moneda y total con las órdenes de Proveeduría y Taller / Compras. Revise las excepciones y apruebe las facturas aceptadas por Hacienda.</p></div><% if(typeof puedeAdministracion!=='undefined'&&puedeAdministracion){ %><a href="/administracion/portal-proveedores" class="btn btn-outline-primary align-self-start">Administrar portal de proveedores</a><% } %></header>
<div class="row g-3 mb-4"><% for(const moneda of ['CRC','USD']){const total=docs.filter(d=>d.datos.moneda===moneda&&d.datos.factura.cuenta_por_pagar).reduce((n,d)=>n+Math.max(0,saldo(d.datos).saldo),0); %><div class="col-md-6"><div class="card p-3"><span class="text-secondary">Cuentas por pagar · <%= moneda %></span><strong class="fs-3"><%= total.toLocaleString('es-CR',{style:'currency',currency:moneda}) %></strong></div></div><% } %></div>
<section class="card p-4"><label>Buscar proveedor, factura o estado<input class="form-control" data-buscar type="search" placeholder="Escriba para filtrar"></label><%- include('tabla',{docs,saldo,interno:true,puedeContabilidad}) %></section></main><script src="/js/portal-proveedores.js" defer></script></body></html>
