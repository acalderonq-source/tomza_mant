<form data-portal-api="<%= url %>/notas-credito"><label class="small">XML nota de crédito<input class="form-control form-control-sm" type="file" accept=".xml" data-portal-xml required></label><label class="small">PDF nota de crédito<input class="form-control form-control-sm" type="file" accept=".pdf" data-portal-archivo required></label><p class="small text-secondary">Debe referenciar la clave de esta factura. Hacienda se verifica automáticamente.</p><button class="btn btn-sm btn-outline-primary">Subir nota de crédito</button></form>