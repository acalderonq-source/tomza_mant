<div class="table-responsive mt-3"><table class="table align-middle portal-table"><thead><tr><th><%= interno?'Proveedor / factura':'Factura / empresa receptora' %></th><th>Orden de compra</th><th>Emisión / vencimiento</th><th>Hacienda</th><th>Revisión interna</th><th>Total / saldo</th><th>Archivos y pagos</th><% if(interno){ %><th>Revisión</th><% } %></tr></thead><tbody>
<% if(!docs.length){ %><tr><td colspan="<%= interno?8:7 %>" class="text-center text-secondary py-5"><div class="invoice-empty-icon" aria-hidden="true">▤</div><strong>Todavía no hay facturas cargadas.</strong><div class="small">Presente su primera factura con el XML y el PDF para comenzar.</div></td></tr><% } %>
<% for(const row of docs){const o=row.datos,f=o.factura,s=saldo(o),h=f.electronica.hacienda,base=interno?'/proveeduria/portal-proveedores':'/portal-proveedores',url=base+'/facturas/'+row.id,alertas=typeof excepciones==='function'?excepciones(o):[],moneda=n=>Number(n).toLocaleString('es-CR',{style:'currency',currency:o.moneda}); %>
<tr data-factura data-excepcion="<%= alertas.length?'1':'0' %>" data-invoice-state="<%= f.estado==='RECHAZADA_INTERNA'?'devuelta':f.cuenta_por_pagar?(s.saldo<=0?'pagada':o.programacion?'programada':'aprobada'):'pendiente' %>"><td><strong><%= interno?o.proveedor:o.razon_social %></strong><div class="small"><%= f.numero %></div><div class="small text-secondary">#<%= row.id %></div></td><td><% if(o.orden_compra){ %><% if(interno){ %><a href="<%= o.orden_compra.url %>"><%= o.orden_compra.numero %></a><% }else{ %><strong><%= o.orden_compra.numero %></strong><% } %><% if(o.orden_compra.automatico){ %><div class="small text-success">Enlace automático</div><% } %><div class="small"><%= o.orden_compra.origen==='COMPRAS'?'Taller / Compras':'Proveeduría' %></div><% }else{ %><span class="text-secondary">Sin orden vinculada</span><% if(o.cruce_automatico){ %><div class="small"><%= o.cruce_automatico.estado==='VARIAS_COINCIDENCIAS'?'Varias OC compatibles: requiere revisión':o.cruce_automatico.estado==='SIN_COINCIDENCIA'?'No hay una OC compatible con proveedor y artículos':'Cruce pendiente de revisión' %></div><% } %><% } %><% if(interno&&!o.pagos.length&&(f.estado==='PENDIENTE'||(f.estado==='CONCILIADA'&&!o.orden_compra))){ %><details class="mb-2"><summary><%= o.orden_compra?'Cambiar orden':'Enlazar orden de compra' %></summary><form data-portal-api="<%= url %>/orden"><label class="small">Módulo<select class="form-select form-select-sm" name="origen" required><option value="PROVEEDURIA">Proveeduría (PR-)</option><option value="COMPRAS">Taller / Compras</option></select></label><label class="small">Número de OC<input class="form-control form-control-sm" name="referencia" placeholder="PR-4 o 2026-2389" required maxlength="80"></label><button class="btn btn-sm btn-outline-primary mt-2">Guardar enlace</button></form></details><% } %><% if(interno&&o.control){ %><%- include('control',{o,url}) %><% } %></td><td><%= f.electronica.fecha.slice(0,10) %><div class="small text-secondary">Vence: <%= f.fecha_vencimiento %></div></td><td><span class="badge <%= h.estado==='ACEPTADA'?'text-bg-success':h.estado==='RECHAZADA'?'text-bg-danger':'text-bg-warning' %>"><%= h.estado %></span><div class="small text-secondary"><%= h.detalle %></div><% if(h.ambiente==='sandbox'){ %><div class="text-danger small">Ambiente de pruebas</div><% } %></td><td><span class="badge <%= f.cuenta_por_pagar?'text-bg-primary':f.estado==='RECHAZADA_INTERNA'?'text-bg-danger':'text-bg-secondary' %>"><%= f.cuenta_por_pagar?(s.saldo<=0?'Pagada':o.programacion?'Pago programado':s.pagos>0?'Pago parcial':'Aprobada'):f.estado==='RECHAZADA_INTERNA'?'Devuelta':'Pendiente de revisión' %></span><div class="small"><%= f.motivo||'' %></div><% if(o.programacion){ %><div class="small">Pago: <%= o.programacion.fecha %> · <%= moneda(o.programacion.monto) %></div><% } %><details class="small mt-2"><summary>Seguimiento y controles</summary><div>Factura cargada: <%= f.subida_en?.slice(0,10)||'Registrada' %></div><div>Hacienda: <%= h.estado %></div><div>Revisión: <%= f.estado %></div><% for(const evento of o.eventos||[]){ %><div><%= evento.fecha.slice(0,10) %> · <%= ({aprobar:'Aprobada',pago:'Pago registrado',programar:'Pago programado','cancelar-programacion':'Programación cancelada',rechazar:'Devuelta',orden:'OC enlazada',recepcion:'Entrega recibida','aplicar-nota':'Nota de crédito aplicada',hacienda:'Hacienda consultada'})[evento.accion]||evento.accion %></div><% } %><% for(const alerta of alertas){ %><div class="text-danger">• <%= alerta %></div><% } %></details></td><td><strong><%= moneda(f.total) %></strong><div class="small">Saldo: <%= moneda(s.saldo) %></div><% if(s.creditos){ %><div class="small">Notas de crédito: <%= moneda(s.creditos) %></div><% } %></td><td><a href="<%= url %>/archivo/xml">XML</a> · <a href="<%= url %>/archivo/pdf">PDF</a><% o.pagos.forEach((p,i)=>{ %><div class="small"><a href="<%= url %>/archivo/pago/<%= i %>">Pago <%= p.referencia %></a> · <%= moneda(p.monto) %> · <%= p.fecha %></div><% }) %>
<% if(!interno){ %><details><summary>Agregar nota de crédito</summary><%- include('nota_form',{url}) %></details><% } %>
<% (o.notas_credito||[]).forEach((n,i)=>{ %><div class="small mt-2">NC <%= n.consecutivo %> · <%= moneda(n.total) %> · <%= n.aplicada?'Aplicada':n.hacienda.estado %> <a href="<%= url %>/archivo/nota-xml/<%= i %>">XML</a> · <a href="<%= url %>/archivo/nota-pdf/<%= i %>">PDF</a><% if(interno&&puedeContabilidad&&!n.aplicada&&n.hacienda.estado==='ACEPTADA'&&n.hacienda.ambiente==='produccion'){ %><form data-portal-api="<%= url %>/aplicar-nota"><input type="hidden" name="clave" value="<%= n.clave %>"><button class="btn btn-sm btn-outline-primary">Aplicar al saldo</button></form><% } %></div><% }) %></td>
<% if(interno){ %><td><form data-portal-api="<%= url %>/hacienda"><button class="btn btn-sm btn-outline-primary mb-2">Consultar Hacienda</button></form>
<% if(puedeContabilidad&&f.estado==='PENDIENTE'){ %><form data-portal-api="<%= url %>/aprobar"><button class="btn btn-sm btn-success mb-2" <%= h.estado==='ACEPTADA'&&h.ambiente==='produccion'&&o.control?.diferencias.length===0?'':'disabled' %>>Aprobar cuenta por pagar</button></form><details><summary>Devolver factura</summary><form data-portal-api="<%= url %>/rechazar"><label class="small">Motivo<input name="motivo" class="form-control form-control-sm" required maxlength="1000"></label><button class="btn btn-sm btn-outline-danger mt-2">Devolver</button></form></details><% } %>
<% if(puedeContabilidad){ %><details><summary>Agregar nota de crédito</summary><%- include('nota_form',{url}) %></details><% } %>
<% if(puedeContabilidad&&f.cuenta_por_pagar&&s.saldo>0){ %><% if(o.control?.diferencias.length){ %><p class="small text-danger">Pago bloqueado: revise las diferencias con la OC.</p><% } %><details><summary>Programar pago</summary><form data-portal-api="<%= url %>/programar"><fieldset <%= o.control?.diferencias.length===0?'':'disabled' %>><label class="small">Fecha<input class="form-control form-control-sm" type="date" name="fecha" required></label><label class="small">Monto<input class="form-control form-control-sm" type="number" step="0.01" min="0.01" max="<%= s.saldo %>" name="monto" required></label><button class="btn btn-sm btn-outline-primary">Programar</button></fieldset></form></details><% if(o.programacion){ %><form data-portal-api="<%= url %>/cancelar-programacion"><button class="btn btn-sm btn-outline-secondary">Cancelar programación</button></form><% } %><details><summary>Registrar pago</summary><form data-portal-api="<%= url %>/pago"><fieldset <%= o.control?.diferencias.length===0?'':'disabled' %>><label class="small">Referencia<input class="form-control form-control-sm" name="referencia" required maxlength="100"></label><label class="small">Monto<input class="form-control form-control-sm" name="monto" type="number" step="0.01" min="0.01" max="<%= s.saldo %>" required></label><label class="small">Fecha<input class="form-control form-control-sm" name="fecha" type="date" required></label><label class="small">Comprobante<input class="form-control form-control-sm" data-portal-archivo type="file" accept=".pdf,.png,.jpg,.jpeg" required></label><button class="btn btn-sm btn-primary mt-2">Guardar pago</button></fieldset></form></details><% } %></td><% } %></tr><% } %>
</tbody></table></div><p data-sin-resultados hidden class="text-secondary">No hay facturas que coincidan con la búsqueda.</p>
