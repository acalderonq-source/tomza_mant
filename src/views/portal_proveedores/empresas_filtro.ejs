<% if(typeof empresaFactura==='function'){const empresas=[...new Set(docs.map(r=>empresaFactura(r.datos)))].sort(); %>
<section class="card p-3 mb-3 mt-3" aria-label="Separación por empresa receptora"><label class="form-label">Empresa receptora<select class="form-select" data-empresa-filtro><option value="">Todas las empresas</option><% for(const empresa of empresas){ %><option value="<%= empresa %>"><%= empresa %></option><% } %></select></label>
<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Empresa</th><th>Facturas</th><th>Por pagar CRC</th><th>Por pagar USD</th></tr></thead><tbody><% for(const empresa of empresas){const filas=docs.filter(r=>empresaFactura(r.datos)===empresa); %><tr><td><strong><%= empresa %></strong></td><td><%= filas.length %></td><% for(const moneda of ['CRC','USD']){const total=filas.filter(r=>r.datos.moneda===moneda&&r.datos.factura.cuenta_por_pagar).reduce((n,r)=>n+Math.max(0,saldo(r.datos).saldo),0); %><td><%= total.toLocaleString('es-CR',{style:'currency',currency:moneda}) %></td><% } %></tr><% } %><% if(!empresas.length){ %><tr><td colspan="4" class="text-secondary">Las facturas se separarán automáticamente por empresa al cargarse.</td></tr><% } %></tbody></table></div></section><% } %>
