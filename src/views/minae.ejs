<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Control MINAE</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

<div class="container mt-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="text-warning fw-bold">🏛️ Control MINAE</h2>
      <div class="text-secondary">Sede actual: <strong><%= sedeSeleccionada %></strong></div>
    </div>
    <div>
      <a href="/minae/nuevo" class="btn btn-warning">➕ Nuevo trámite</a>
      <a href="/dashboard" class="btn btn-secondary">Volver</a>
    </div>
  </div>

  <!-- FILTROS -->
  <form method="GET" action="/minae" class="row g-2 mb-4">
    <div class="col-md-2">
      <input type="month" name="fecha" class="form-control" value="<%= fechaSeleccionada || '' %>">
    </div>
    <div class="col-md-2">
      <select name="negocio" class="form-select">
        <option value="">Todos los negocios</option>
        <option value="CILINDRERO">CILINDRERO</option>
        <option value="GRANEL">GRANEL</option>
        <option value="TRANSPORTADORA">TRANSPORTADORA</option>
        <option value="TECNICOS">TECNICOS</option>
        <option value="TALLER">TALLER</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="sede" class="form-select">
        <option value="">Todas las sedes</option>
        <option value="Cartago">Cartago</option>
        <option value="Guapiles">Guápiles</option>
        <option value="La Cruz">La Cruz</option>
        <option value="Perez Zeledon">Pérez Zeledón</option>
        <option value="Rio Claro">Río Claro</option>
        <option value="San Carlos">San Carlos</option>
        <option value="Nicoya">Nicoya</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="estado" class="form-select">
        <option value="">Todos los estados</option>
        <option value="PENDIENTE">PENDIENTE</option>
        <option value="EN PROCESO">EN PROCESO</option>
        <option value="FINALIZADO">FINALIZADO</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="cita" class="form-select">
        <option value="">Todas las citas</option>
        <option value="1">Con cita</option>
        <option value="0">Sin cita</option>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-warning w-100">Filtrar</button>
    </div>
  </form>

  <!-- TABLA -->
  <div class="table-responsive">
    <table class="table table-dark table-hover table-bordered align-middle">
      <thead class="table-warning text-dark">
        <tr>
          <th>Placa</th>
          <th>Tipo</th>
          <th>CR#</th>
          <th>Estado</th>
          <th>Vencimiento</th>
          <th>Empresa</th>
          <th>Lugar</th>
          <th>Hora</th>
          <th>OT</th>
          <th>Acciones</th>   <!-- NUEVA COLUMNA -->
        </tr>
      </thead>
      <tbody>
        <% tramites.forEach(t => { %>
          <%
            let color = '';
            if (t.vencimiento) {
              const hoy = new Date();
              const vence = new Date(t.vencimiento);
              const diferencia = Math.ceil((vence - hoy) / (1000 * 60 * 60 * 24));
              if (diferencia < 0) color = 'table-danger';
              else if (diferencia <= 15) color = 'table-warning';
              else color = 'table-success';
            }
          %>
          <tr class="<%= color %>">
            <td><strong><%= t.placa %></strong></td>
            <td><%= t.tipo || '-' %></td>
            <td><%= t.cr || '-' %></td>
            <td><%= t.estado || '-' %></td>
            <td><% if (t.vencimiento) { %><%= new Date(t.vencimiento).toLocaleDateString('es-CR') %><% } else { %>-<% } %></td>
            <td><%= t.empresa || '-' %></td>
            <td><%= t.lugar || '-' %></td>
            <td><%= t.hora || '-' %></td>
            <td><%= t.ot || '-' %></td>
            <td>
              <a href="/minae/<%= t.id %>/cita" class="btn btn-sm btn-outline-info">
                📅 <%= t.tiene_cita ? 'Editar cita' : 'Agregar cita' %>
              </a>
            </td>
          </tr>
        <% }) %>
        <% if (tramites.length === 0) { %>
          <tr><td colspan="10" class="text-center">No hay trámites registrados</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

</body>
</html>