<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Control MINAE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @media (max-width: 768px) {
      .table thead { display: none; }
      .table, .table tbody, .table tr, .table td {
        display: block;
        width: 100%;
      }
      .table tr {
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem;
        background: white;
        color: black;
      }
      .table td {
        text-align: right;
        padding-left: 50%;
        position: relative;
        border: none;
        border-bottom: 1px solid #eee;
      }
      .table td::before {
        content: attr(data-label);
        position: absolute;
        left: 1rem;
        width: 45%;
        font-weight: bold;
        text-align: left;
      }
    }
  </style>
</head>
<body class="bg-dark text-light">

<div class="container mt-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="text-warning fw-bold">🏛️ Control MINAE</h2>
      <div class="text-secondary">Sede actual: <strong><%= sedeSeleccionada %></strong></div>
    </div>
    <div>
      <a href="/minae/nuevo" class="btn btn-warning">➕ Nuevo trámite</a>
      <a href="/dashboard" class="btn btn-secondary">Volver</a>
    </div>
  </div>

  <!-- FILTROS -->
  <form method="GET" action="/minae" class="row g-2 mb-4">
    <div class="col-md-2">
      <input type="month" name="fecha" class="form-control" value="<%= fechaSeleccionada || '' %>">
    </div>
    <div class="col-md-2">
      <select name="negocio" class="form-select">
        <option value="">Todos los negocios</option>
        <option value="CILINDRERO">CILINDRERO</option>
        <option value="GRANEL">GRANEL</option>
        <option value="TRANSPORTADORA">TRANSPORTADORA</option>
        <option value="TECNICOS">TECNICOS</option>
        <option value="TALLER">TALLER</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="sede" class="form-select">
        <option value="">Todas las sedes</option>
        <option value="Cartago">Cartago</option>
        <option value="Guapiles">Guápiles</option>
        <option value="La Cruz">La Cruz</option>
        <option value="Perez Zeledon">Pérez Zeledón</option>
        <option value="Rio Claro">Río Claro</option>
        <option value="San Carlos">San Carlos</option>
        <option value="Nicoya">Nicoya</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="estado" class="form-select">
        <option value="">Todos los estados</option>
        <option value="PENDIENTE">PENDIENTE</option>
        <option value="EN PROCESO">EN PROCESO</option>
        <option value="FINALIZADO">FINALIZADO</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="cita" class="form-select">
        <option value="">Todas las citas</option>
        <option value="1">Con cita</option>
        <option value="0">Sin cita</option>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-warning w-100">Filtrar</button>
    </div>
  </form>

  <!-- TABLA -->
  <div class="table-responsive">
    <table class="table table-dark table-hover table-bordered align-middle">
      <thead class="table-warning text-dark">
        <tr>
          <th>Placa</th>
          <th>Tipo</th>
          <th>CR#</th>
          <th>Estado</th>
          <th>Vencimiento</th>
          <th>Empresa</th>
          <th>Lugar</th>
          <th>Hora</th>
          <th>OT</th>
          <th>Fecha cita</th>
          <th>Hora cita</th>
          <th>Lugar cita</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% tramites.forEach(t => { 
          let color = '';
          if (t.vencimiento) {
            const hoy = new Date();
            const vence = new Date(t.vencimiento);
            const dif = Math.ceil((vence - hoy) / (1000 * 60 * 60 * 24));
            if (dif < 0) color = 'table-danger';
            else if (dif <= 15) color = 'table-warning';
            else color = 'table-success';
          }
        %>
          <tr class="<%= color %>">
            <td data-label="Placa"><strong><%= t.placa %></strong></td>
            <td data-label="Tipo"><%= t.tipo || '-' %></td>
            <td data-label="CR#"><%= t.cr || '-' %></td>
            <td data-label="Estado"><%= t.estado || '-' %></td>
            <td data-label="Vencimiento"><%= t.vencimiento ? new Date(t.vencimiento).toLocaleDateString('es-CR') : '-' %></td>
            <td data-label="Empresa"><%= t.empresa || '-' %></td>
            <td data-label="Lugar"><%= t.lugar || '-' %></td>
            <td data-label="Hora"><%= t.hora || '-' %></td>
            <td data-label="OT"><%= t.ot || '-' %></td>
            <td data-label="Fecha cita"><%= t.fecha_cita ? new Date(t.fecha_cita).toLocaleDateString('es-CR') : '—' %></td>
            <td data-label="Hora cita"><%= t.hora_cita || '—' %></td>
            <td data-label="Lugar cita"><%= t.lugar_cita || '—' %></td>
            <td data-label="Acciones">
              <a href="/minae/<%= t.id %>/cita" class="btn btn-sm btn-outline-info">
                📅 <%= t.tiene_cita ? 'Editar cita' : 'Agregar cita' %>
              </a>
            </td>
          </tr>
        <% }) %>
        <% if (tramites.length === 0) { %>
          <tr>
            <td colspan="13" class="text-center">No hay trámites registrados</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>