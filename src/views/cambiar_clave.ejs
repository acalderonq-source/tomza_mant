<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const esPin = typeof modo !== 'undefined' && modo === 'pin'; %>
  <title><%= esPin ? 'Crear PIN personal' : 'Actualizar contraseña' %> | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <main class="login-shell">
    <section class="login-card">
      <div class="login-card-header">
        <% if (esPin) { %>
        <h1 class="login-title">Cree su PIN personal</h1>
        <p class="login-subtitle">El código impreso en su carnet solo sirve para el primer ingreso. Elija un PIN de 6 a 12 números que solo usted conozca.</p>
        <% } else { %>
        <h1 class="login-title">Actualice su contraseña</h1>
        <p class="login-subtitle">Por seguridad, debe cambiar la contraseña temporal para continuar.</p>
        <% } %>
      </div>
      <div class="login-card-body">
        <% if (error) { %><div class="alert alert-danger rounded-4"><%= error %></div><% } %>
        <form method="POST" action="/cambiar-clave" class="d-grid gap-3">
          <% if (esPin) { %>
          <div>
            <label class="form-label" for="password">Nuevo PIN</label>
            <input class="form-control" id="password" name="password" type="password" inputmode="numeric" pattern="[0-9]{6,12}" minlength="6" maxlength="12" autocomplete="new-password" required>
          </div>
          <div>
            <label class="form-label" for="confirmar">Confirmar PIN</label>
            <input class="form-control" id="confirmar" name="confirmar" type="password" inputmode="numeric" pattern="[0-9]{6,12}" minlength="6" maxlength="12" autocomplete="new-password" required>
          </div>
          <button class="btn btn-login" type="submit">Guardar PIN</button>
          <% } else { %>
          <div>
            <label class="form-label" for="password">Nueva contraseña</label>
            <input class="form-control" id="password" name="password" type="password" minlength="12" autocomplete="new-password" required>
          </div>
          <div>
            <label class="form-label" for="confirmar">Confirmar contraseña</label>
            <input class="form-control" id="confirmar" name="confirmar" type="password" minlength="12" autocomplete="new-password" required>
          </div>
          <button class="btn btn-login" type="submit">Guardar contraseña</button>
          <% } %>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
