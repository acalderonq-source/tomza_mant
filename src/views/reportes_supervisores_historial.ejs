<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Historial de reportes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/mantenimientos.css">
  <style>
    .history-card { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; padding: 1rem; margin-bottom: .8rem; }
    .meta { color: #64748b; font-size: .82rem; }
  </style>
</head>
<body>
<nav class="navbar navbar-dark px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-clock-history"></i> Historial de reportes</span>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="text-white small"><%= user.usuario %> (<%= user.rol %>)</span>
    <a href="/reportes-supervisores" class="btn btn-outline-light btn-sm">Pendientes</a>
    <a href="/dashboard" class="btn btn-secondary btn-sm">Dashboard</a>
  </div>
</nav>

<main class="container-fluid py-4">
  <div class="page-heading">
    <div>
      <h1 class="page-title">Historial</h1>
      <p class="page-subtitle">Reportes cerrados por correctivo sugerido o cierre manual.</p>
    </div>
  </div>

  <section class="filters-card">
    <form method="GET" action="/reportes-supervisores/historial" class="row g-3">
      <div class="col-md-3">
        <label class="form-label small">Sede</label>
        <input type="text" name="sede" class="form-control form-control-sm" value="<%= filtros.sede || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small">Placa</label>
        <input type="text" name="placa" class="form-control form-control-sm text-uppercase" value="<%= filtros.placa || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Desde cierre</label>
        <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small">Hasta cierre</label>
        <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
      </div>
      <div class="col-md-2 d-flex align-items-end gap-2">
        <button class="btn btn-dark btn-sm flex-fill">Filtrar</button>
        <a href="/reportes-supervisores/historial" class="btn btn-secondary btn-sm flex-fill">Limpiar</a>
      </div>
    </form>
  </section>

  <section class="mt-3">
    <% if (!reportes.length) { %>
      <div class="empty-state">No hay reportes en historial con los filtros seleccionados.</div>
    <% } %>

    <% reportes.forEach(r => { %>
      <article class="history-card">
        <div class="d-flex justify-content-between gap-3 flex-wrap">
          <div>
            <h2 class="h6 fw-bold mb-1"><%= r.placa %> · <%= r.sede %></h2>
            <div class="meta">
              Reportado: <%= r.fecha_reporte ? new Date(r.fecha_reporte).toLocaleDateString('es-CR') : '—' %> ·
              Cerrado: <%= r.fecha_cierre ? new Date(r.fecha_cierre).toLocaleString('es-CR') : '—' %> ·
              Por: <%= r.cerrado_por_usuario || '—' %>
            </div>
          </div>
          <span class="badge <%= r.estado === 'DESCARTADO' ? 'text-bg-secondary' : 'text-bg-success' %>"><%= r.estado %></span>
        </div>

        <div class="row g-3 mt-2">
          <div class="col-lg-4">
            <div class="meta">Reporte</div>
            <div><%= r.descripcion_limpia || r.descripcion_original %></div>
          </div>
          <div class="col-lg-4">
            <div class="meta">Correctivo / motivo</div>
            <div><%= r.trabajo_realizado || r.cierre_motivo || 'Cierre manual' %></div>
          </div>
          <div class="col-lg-4">
            <div class="meta">Cierre</div>
            <div><%= r.cierre_motivo || '—' %></div>
            <% if (r.cierre_confianza !== null && r.cierre_confianza !== undefined) { %>
              <div class="meta">Confianza IA: <%= Math.round(Number(r.cierre_confianza || 0) * 100) %>%</div>
            <% } %>
            <% if (puedeEditar) { %>
              <form method="POST" action="/reportes-supervisores/<%= r.id %>/reabrir" class="mt-2">
                <button class="btn btn-outline-warning btn-sm" onclick="return confirm('¿Reabrir este reporte?')">Reabrir</button>
              </form>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
