<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Carnet de trabajador | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { min-height: 100vh; display: grid; place-items: center; padding: 20px; background: #edf2f7; color: #152238; }
    .badge { width: min(100%, 390px); overflow: hidden; border: 1px solid #cbd5e1; border-radius: 14px; background: white; box-shadow: 0 10px 30px #10243a18; }
    .badge-head { background: #12396a; color: white; padding: 14px 18px; font-weight: 800; letter-spacing: .04em; }
    .badge-main { padding: 18px; display: grid; grid-template-columns: 118px 1fr; gap: 16px; align-items: center; }
    .photo { width: 118px; height: 148px; object-fit: cover; border-radius: 8px; background: #e8edf3; }
    .name { font-size: 19px; line-height: 1.2; font-weight: 800; overflow-wrap: anywhere; }
    .code { font-size: 24px; color: #12396a; font-weight: 800; }
    .qr-wrap { padding: 0 18px 18px; display: flex; gap: 14px; align-items: center; color: #64748b; font-size: 13px; }
    .qr { width: 104px; height: 104px; }
    @media print { body { background: white; padding: 0; } .badge { box-shadow: none; } }
  </style>
</head>
<body>
  <article class="badge">
    <div class="badge-head">GAS TOMZA · IDENTIFICACIÓN</div>
    <div class="badge-main">
      <% if (worker.tiene_foto) { %><img class="photo" src="/personal/carnet/<%= worker.qr_token %>/foto" alt="Fotografía de <%= worker.nombre %>"><% } else { %><div class="photo d-grid text-secondary fs-1" style="place-items:center"><i class="bi bi-person-bounding-box"></i></div><% } %>
      <div><div class="name"><%= worker.nombre %></div><div class="text-secondary small mt-1"><%= worker.perfil || 'Trabajador' %></div><div class="small mt-3">PIN inicial / código de trabajador</div><div class="code"><%= worker.codigo_trabajador || 'Pendiente' %></div></div>
    </div>
    <div class="qr-wrap"><img class="qr" src="<%= worker.qr %>" alt="Código QR"><span>Carnet verificado por el sistema interno de Gas Tomza.</span></div>
  </article>
</body>
</html>
