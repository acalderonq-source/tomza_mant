<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= tipo === 'varadas' ? 'Unidades varadas' : 'Unidades comodín' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #eef2f7; color: #0f172a; font-family: "Segoe UI", Roboto, Arial, sans-serif; }
    .navbar { background: #101827; border-bottom: 3px solid #2563eb; }
    .shell { max-width: 1200px; }
    .page-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .page-head h1 { font-size: 1.5rem; font-weight: 800; margin: 0; }
    .sede-section { background: #fff; border: 1px solid #dbe3ef; border-radius: 8px; margin-bottom: 1rem; overflow: hidden; }
    .sede-head { align-items: center; background: #102a56; color: #fff; display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 1rem; }
    .sede-head h2 { font-size: 1rem; font-weight: 800; margin: 0; }
    .table { margin: 0; }
    .table th { background: #f8fafc; color: #475569; font-size: .75rem; text-transform: uppercase; }
    .table td { vertical-align: middle; }
    .empty-state { background: #fff; border: 1px solid #dbe3ef; border-radius: 8px; color: #64748b; padding: 2rem; text-align: center; }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark px-3 py-2">
    <span class="navbar-brand fw-semibold"><i class="bi bi-truck-front me-1"></i> Unidades</span>
    <a href="/unidades" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Volver a unidades</a>
  </nav>
  <main class="container-fluid shell py-4">
    <div class="page-head mb-3">
      <div>
        <h1><%= tipo === 'varadas' ? 'Unidades varadas' : 'Unidades comodín' %></h1>
        <div class="text-muted">Agrupadas por sede</div>
      </div>
      <span class="badge text-bg-dark fs-6"><%= total %> unidad<%= total === 1 ? '' : 'es' %></span>
    </div>

    <% if (!grupos.length) { %>
      <div class="empty-state">No hay unidades <%= tipo === 'varadas' ? 'varadas' : 'comodín' %> registradas.</div>
    <% } %>
    <% grupos.forEach(grupo => { %>
      <section class="sede-section">
        <div class="sede-head">
          <h2><%= grupo.sede %></h2>
          <span class="badge text-bg-light"><%= grupo.unidades.length %></span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Placa</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
                <% if (tipo === 'varadas') { %><th>Razón de varada</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% grupo.unidades.forEach(unidad => { %>
                <tr>
                  <td class="fw-bold"><%= unidad.placa %></td>
                  <td><%= unidad.marca || '—' %></td>
                  <td><%= unidad.modelo || '—' %></td>
                  <td><%= unidad.anio || '—' %></td>
                  <% if (tipo === 'varadas') { %><td><%= unidad.razon_varada || 'Sin razón registrada' %></td><% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% }) %>
  </main>
</body>
</html>
