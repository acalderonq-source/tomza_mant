<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ciberseguridad · Gas Tomza</title><link rel="stylesheet" href="/css/ciberseguridad.css"><script src="/js/ciberseguridad.js" defer></script></head>
<body><div class="cyber-shell">
<nav class="topbar"><a href="/administracion">← Administración</a><span>GAS TOMZA <b>/</b> SECURITY CENTER</span><span><%= user.usuario %></span></nav>
<header class="hero"><div><p class="eyebrow">[ CENTRO DE CONTROL / ADMINISTRACIÓN ]</p><h1>Ciber<span>seguridad</span><span class="cursor" aria-hidden="true">_</span></h1><p class="subtitle">Visibilidad de amenazas, incidentes y respuesta de la empresa.</p></div><div class="mode"><span class="dot"></span> ENTORNO DEMOSTRATIVO</div></header>
<aside class="demo-notice"><strong>DATOS DE EJEMPLO</strong><span>Simulación del 21 de setiembre al 20 de octubre de 2026. Este panel no está conectado a herramientas de monitoreo ni representa ataques reales.</span></aside>
<section class="toolbar" aria-label="Filtros del panel"><div><label for="periodo">Período</label><select id="periodo"><option value="7">Últimos 7 días de la muestra</option><option value="14">Últimos 14 días de la muestra</option><option value="30" selected>Últimos 30 días de la muestra</option></select></div><div><label for="gravedad">Gravedad</label><select id="gravedad"><option>Todas</option><option>Crítica</option><option>Alta</option><option>Media</option><option>Baja</option></select></div><button id="exportar" type="button" disabled>↓ Descargar CSV de ejemplo</button><p id="estado" role="status" aria-live="polite">Cargando muestra…</p></section>
<main id="panel" aria-busy="true">
<section class="metrics" aria-label="Indicadores"><article><p>ATAQUES DETECTADOS</p><strong id="total">—</strong><small>Eventos en el período filtrado</small></article><article><p>ATAQUES BLOQUEADOS</p><strong id="bloqueados">—</strong><small id="porcentaje">—</small></article><article class="warning"><p>EN INVESTIGACIÓN</p><strong id="pendientes">—</strong><small>Incidentes pendientes de revisión</small></article><article class="danger"><p>GRAVEDAD CRÍTICA</p><strong id="criticos">—</strong><small>Incluye bloqueados y contenidos</small></article></section>
<section class="charts"><article class="card"><div class="card-title"><div><p class="eyebrow">01 / ACTIVIDAD</p><h2>Tendencia de ataques</h2></div><span class="chip">MUESTRA</span></div><div class="legend"><span>● Detectados</span><span>● Bloqueados</span></div><div id="tendencia" class="trend"></div><p id="rango" class="muted"></p></article><article class="card"><div class="card-title"><div><p class="eyebrow">02 / VECTORES</p><h2>Tipos de ataque</h2></div></div><div id="tipos" class="types"></div></article></section>
<section class="card incidents"><div class="card-title"><div><p class="eyebrow">03 / BITÁCORA DE EJEMPLO</p><h2>Registro de incidentes</h2></div><span id="conteo" class="chip">—</span></div><p class="muted">IP de documentación y equipos ficticios. Horas de Costa Rica (UTC−6).</p><div class="table-scroll"><table><thead><tr><th scope="col">Incidente / fecha</th><th scope="col">Tipo</th><th scope="col">Origen</th><th scope="col">Equipo / área</th><th scope="col">Gravedad</th><th scope="col">Estado</th></tr></thead><tbody id="incidentes"></tbody></table></div><div class="pagination"><button id="anterior" type="button">← Anterior</button><span id="pagina"></span><button id="siguiente" type="button">Siguiente →</button></div></section>
</main><footer>TOMZA / CYBERSECURITY · DEMOSTRACIÓN PARA ADMINISTRACIÓN <span>Sin conexión a monitoreo real</span></footer>
</div></body></html>
