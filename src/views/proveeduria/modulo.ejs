<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= titulo %> · Proveeduría</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><%- include('../partials/ordenes_styles') %><link href="/css/compras.css" rel="stylesheet"><link href="/css/proveeduria-modulos.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-dark bg-dark px-3 py-2"><span class="navbar-brand fw-semibold">Gas Tomza · Proveeduría</span><div class="text-white d-flex gap-2 align-items-center"><span><%= user.usuario %></span><a href="/proveeduria" class="btn btn-sm btn-outline-light">Inicio</a></div></nav>
<main class="container py-4"><div class="page-heading"><div><h1 class="page-title"><%= titulo %></h1><p class="page-subtitle">Departamento de Proveeduría<% if(modulo!=='detalle'){ %> · Sede: <%= sedeActual %><% } %></p></div><a class="btn btn-secondary btn-sm" href="<%= modulo==='detalle'?'/proveeduria/ordenes':'/proveeduria' %>">Volver</a></div>
<% if(modulo === 'facturas'){ %><%- include('../partials/contabilidad_departamento', { documento: 'facturas', departamentoConsulta: 'PROVEEDURIA' }) %>
<% } %>
<% if(puedeContabilidad){ %><a class="btn btn-primary mb-3" href="/proveeduria/cuentas-por-pagar">Cuentas por pagar</a><% } %><div id="resultado" role="status" aria-live="polite"></div>
<% if(modulo==='detalle'){ %><%- include('orden_detalle') %>
<% }else if(modulo==='salidas'){ %><div class="mb-3"><a class="btn btn-dark btn-sm" href="/proveeduria/solicitudes">Alistar desde solicitudes</a></div><%- include('salidas_listado') %><% if(!docs.some(d=>d.tipo==='salida')){ %><div class="card-modern p-4 text-center text-muted">No hay salidas registradas. Aliste una solicitud cuando su compra esté recibida.</div><% } %>
<% }else if(modulo==='conciliacion'){ %><%- include('conciliacion_listado') %><%- include('estados_listado') %>
<% }else if(modulo==='avisos'){ %><section id="Alertas" class="card-modern p-4"><h2 class="h5">Avisos de Proveeduría</h2><div id="nuevas-alertas" role="status" aria-live="polite"></div><% if(!alertas.length){ %><p class="text-muted mb-0">No hay alertas recientes.</p><% } %><% alertas.forEach(a=>{ %><p class="border-bottom py-3 mb-0"><i class="bi bi-bell me-2"></i><%= a.mensaje %></p><% }) %></section>
<% }else{const esPago=modulo==='pagos',ordenes=docs.filter(d=>d.tipo==='oc'&&(esPago||d.datos.factura||d.datos.facturas_vinculadas?.length)); %>
<div class="card-modern"><div class="card-header-modern"><%= esPago?'Pagos por orden de compra':'Facturas recibidas de proveedores' %></div><div class="table-responsive"><table class="table table-ordenes"><thead><tr><th>OC</th><th>Proveedor</th><th>Sede</th><th>Factura</th><th>Estado de factura</th><th><%= esPago?'Pagado':'Total factura' %></th><% if(esPago){ %><th>Saldo pendiente / a favor</th><% } %><th class="text-end">Acciones</th></tr></thead><tbody>
<% if(!ordenes.length){ %><tr><td colspan="8" class="text-center text-muted py-4"><%= esPago?'No hay órdenes para consultar pagos.':'No hay facturas cargadas por los proveedores.' %></td></tr><% } %>
<% ordenes.forEach(d=>{const o=d.datos,s=saldo(o),moneda=n=>Number(n||0).toLocaleString('es-CR',{style:'currency',currency:o.moneda||'CRC'}); %><tr><td data-label="OC">PR-<%= d.id %></td><td data-label="Proveedor"><%= o.proveedor %></td><td data-label="Sede"><%= d.sede %></td><td data-label="Factura"><%= [o.factura,...(o.facturas_vinculadas||[]).map(d=>d.factura)].filter(Boolean).map(f=>f.numero).join(', ')||'Pendiente' %></td><td data-label="Estado"><span class="badge bg-secondary"><%= [o.factura,...(o.facturas_vinculadas||[]).map(d=>d.factura)].filter(Boolean).map(f=>f.estado).join(', ')||'Sin factura' %></span></td><td data-label="Monto"><%= moneda(esPago?s.pagos:s.facturado) %></td><% if(esPago){ %><td data-label="Saldo"><%= moneda(s.saldo) %></td><% } %><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/proveeduria/ordenes/<%= d.id %>#<%= esPago?'Pagos':'Factura' %>"><%= esPago?'Ver pagos y comprobantes':'Revisar factura' %></a></td></tr><% }) %>
</tbody></table></div></div><% } %>
</main><script id="prov-datos" type="application/json"><%- JSON.stringify({ultimaAlerta:alertas[0]?.id||0}).replace(/</g,'\\u003c') %></script><script src="/js/proveeduria.js" defer></script></body></html>
