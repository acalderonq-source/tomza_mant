<%
const pendientes=p=>!p.telefono||!p.correos?.length||!p.direccion||!p.condicion_pago;
const resumen={total:proveedores.length,contado:proveedores.filter(p=>p.condicion_pago==='CONTADO').length,credito:proveedores.filter(p=>p.condicion_pago==='CREDITO').length,pendientes:proveedores.filter(pendientes).length};
const iniciales=n=>n.split(/\s+/).filter(Boolean).slice(0,2).map(s=>s[0]).join('').toUpperCase();
%>
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Proveedores · Proveeduría</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><%- include('../partials/dashboard_styles') %><link href="/css/proveeduria-proveedores.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-dark topbar px-3 py-2"><a class="navbar-brand fw-semibold" href="/proveeduria"><span class="brand-box"><i class="bi bi-house"></i></span>Gas Tomza</a><a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/proveeduria"><i class="bi bi-arrow-left"></i> Volver al inicio</a></nav>
<main class="container-fluid shell supplier-shell"><div class="supplier-breadcrumb"><a href="/proveeduria">Proveeduría</a><i class="bi bi-chevron-right"></i><span>Directorio de proveedores</span></div>
<header class="supplier-heading"><div><div class="supplier-eyebrow">CONTACTOS Y COMPRAS</div><h1>Proveedores<span class="supplier-total"><%= resumen.total %></span></h1><p>Todo lo que necesita para contactar y comprar, en un solo lugar.</p><span class="visually-hidden"><%= proveedores.length %> proveedores registrados en Proveeduría.</span></div><a class="btn supplier-primary" href="/proveeduria/ordenes/nueva"><i class="bi bi-plus-lg"></i> Nueva orden de compra</a></header>
<section class="supplier-stats" aria-label="Resumen de proveedores"><% [['Proveedores registrados',resumen.total,'bi-buildings','blue','Todo el directorio'],['Pago de contado',resumen.contado,'bi-wallet2','green','Condición registrada'],['Pago a crédito',resumen.credito,'bi-calendar-check','violet','Plazo definido en cada OC'],['Datos pendientes',resumen.pendientes,'bi-clipboard-check','amber','Fichas por completar']].forEach(s=>{ %><article class="supplier-stat"><div><span class="supplier-stat-label"><%= s[0] %></span><strong><%= s[1] %></strong><span class="supplier-stat-note"><%= s[4] %></span></div><span class="supplier-stat-icon <%= s[3] %>"><i class="bi <%= s[2] %>"></i></span></article><% }) %></section>
<section class="supplier-directory" aria-label="Directorio de proveedores"><div class="supplier-tools"><div class="supplier-search"><i class="bi bi-search"></i><label class="visually-hidden" for="buscar">Buscar proveedor</label><input id="buscar" type="search" placeholder="Buscar por nombre, correo, teléfono o dirección…" autocomplete="off"></div><div class="supplier-filter" aria-label="Filtrar proveedores"><% [['todos','Todos',resumen.total],['CONTADO','Contado',resumen.contado],['CREDITO','Crédito',resumen.credito],['pendientes','Datos pendientes',resumen.pendientes]].forEach(([valor,label,n])=>{ %><button type="button" data-filtro="<%= valor %>" aria-pressed="<%= valor==='todos'?'true':'false' %>" class="<%= valor==='todos'?'active':'' %>"><%= label %><span><%= n %></span></button><% }) %></div></div>
<div class="supplier-list-caption"><div><span class="supplier-live-dot"></span><strong>Directorio de proveedores</strong></div><span id="cantidad-resultados" role="status" aria-live="polite"><%= resumen.total %> proveedores</span></div>
<table class="supplier-table"><thead><tr><th>Proveedor / razón social</th><th>Contacto</th><th>Condición de pago</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
<% proveedores.forEach((p,i)=>{const correos=p.correos||[],faltante=pendientes(p); %><tr data-proveedor data-pago="<%= p.condicion_pago||'' %>" data-pendiente="<%= faltante?'si':'no' %>" data-buscar="<%= [p.nombre,p.telefono,...correos,p.correo_original,p.direccion].filter(Boolean).join(' ') %>">
<td class="supplier-name-cell"><div class="supplier-identity"><span class="supplier-avatar avatar-<%= i%4 %>" aria-hidden="true"><%= iniciales(p.nombre) %></span><div><button class="supplier-name" type="button" data-ficha="<%= i %>" title="Ver ficha de <%= p.nombre %>"><%= p.nombre %></button><div class="supplier-address" title="<%= p.direccion||'' %>"><i class="bi bi-geo-alt"></i><%= p.direccion||'Dirección pendiente' %></div></div></div></td>
<td class="supplier-contact"><div class="supplier-phone"><i class="bi bi-telephone"></i><%= p.telefono||'Teléfono pendiente' %></div><% if(correos.length){ %><div class="supplier-email"><i class="bi bi-envelope"></i><a href="mailto:<%= correos[0] %>"><%= correos[0] %></a><% if(correos.length>1){ %><span class="supplier-extra">+<%= correos.length-1 %></span><% } %></div><% }else{ %><div class="supplier-missing"><i class="bi bi-exclamation-circle"></i><%= p.correo_original?'Correo por corregir':'Correo pendiente' %></div><% } %></td>
<td class="supplier-payment"><span class="supplier-badge <%= p.condicion_pago==='CONTADO'?'paid':p.condicion_pago==='CREDITO'?'credit':'unknown' %>"><span></span><%= p.condicion_pago==='CONTADO'?'Contado':p.condicion_pago==='CREDITO'?'Crédito':'Por definir' %></span><% if(p.condicion_pago==='CREDITO'){ %><small>Plazo por definir en la OC</small><% }else if(faltante){ %><small>Datos por completar</small><% } %></td>
<td class="supplier-actions"><button type="button" class="supplier-view" data-ficha="<%= i %>" aria-label="Ver ficha de <%= p.nombre %>">Ver ficha <i class="bi bi-arrow-up-right"></i></button></td></tr><% }) %>
</tbody></table><div id="sin-resultados" class="supplier-empty" <%= proveedores.length?'hidden':'' %>><span><i class="bi bi-search"></i></span><h2>No se encontraron proveedores</h2><p>Pruebe con otro nombre o cambie el filtro.</p><button type="button" id="limpiar-filtros">Limpiar búsqueda</button></div><footer class="supplier-directory-footer"><i class="bi bi-info-circle"></i>Los datos del proveedor se completan automáticamente al preparar una cotización u orden de compra.</footer></section>
<% proveedores.forEach((p,i)=>{ %><template id="ficha-<%= i %>"><div class="supplier-detail-heading"><span class="supplier-avatar avatar-<%= i%4 %>" aria-hidden="true"><%= iniciales(p.nombre) %></span><div><span class="supplier-eyebrow">FICHA DEL PROVEEDOR</span><h2 id="ficha-titulo"><%= p.nombre %></h2></div></div><div class="supplier-detail-grid"><section><span class="supplier-detail-label"><i class="bi bi-telephone"></i> Teléfono</span><p><%= p.telefono||'Pendiente de registrar' %></p></section><section><span class="supplier-detail-label"><i class="bi bi-wallet2"></i> Condición de pago</span><p><%= p.condicion_pago==='CREDITO'?'Crédito · plazo por definir':p.condicion_pago==='CONTADO'?'Contado':'Pendiente de registrar' %></p></section><section class="wide"><span class="supplier-detail-label"><i class="bi bi-envelope"></i> Correos electrónicos</span><% (p.correos||[]).forEach(c=>{ %><a class="supplier-detail-email" href="mailto:<%= c %>"><%= c %></a><% }) %><% if(!p.correos?.length){ %><p class="supplier-missing"><%= p.correo_original?'Por corregir: '+p.correo_original:'Pendiente de registrar' %></p><% } %></section><section class="wide"><span class="supplier-detail-label"><i class="bi bi-geo-alt"></i> Dirección exacta</span><p><%= p.direccion||'Pendiente de registrar' %></p></section></div><div class="supplier-detail-note"><i class="bi bi-info-circle"></i>Seleccione este proveedor en la cotización u OC para completar sus datos de contacto.</div></template><% }) %>
</main><dialog id="ficha-proveedor" class="supplier-dialog" aria-labelledby="ficha-titulo"><button id="cerrar-ficha" class="supplier-dialog-close" type="button" aria-label="Cerrar ficha"><i class="bi bi-x-lg"></i></button><div id="contenido-ficha"></div></dialog><script src="/js/proveeduria-proveedores.js" defer></script></body></html>
