<% const esSeguridadOcupacional = user.departamentoActivo === 'SEGURIDAD_OCUPACIONAL'; const esRecursosHumanos = user.departamentoActivo === 'RECURSOS_HUMANOS'; const esOperaciones = user.departamentoActivo === 'OPERACIONES'; const nombreDepartamento = esOperaciones ? 'Operaciones' : esRecursosHumanos ? 'Recursos Humanos' : esSeguridadOcupacional ? 'Seguridad Ocupacional' : user.departamentoActivo; const inicioDepartamento = esOperaciones ? '/operaciones' : esRecursosHumanos ? '/recursos-humanos' : esSeguridadOcupacional ? '/seguridad-ocupacional' : '/dashboard'; const tituloSolicitudes = (esSeguridadOcupacional || esRecursosHumanos || esOperaciones) ? 'Solicitud de suministros' : 'Mis solicitudes a Proveeduría'; %>
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= tituloSolicitudes %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/proveeduria.css" rel="stylesheet"><%- include('../partials/dashboard_styles') %></head><body><nav class="navbar navbar-dark topbar px-3 py-2"><a class="navbar-brand" href="<%= inicioDepartamento %>">Gas Tomza · <%= nombreDepartamento %></a><a href="<%= inicioDepartamento %>" class="btn btn-outline-light btn-sm">Volver a mi departamento</a></nav><main class="container-fluid shell py-3"><section class="simple-hero mb-3"><h1 class="page-title"><%= tituloSolicitudes %></h1><p class="page-subtitle">Solicitud → Cotización → Orden de compra → Entrega → Confirmación</p></section><div id="resultado" role="status" aria-live="polite"></div>
<section class="plain-card p-3 mb-3"><h2 class="section-title">Nueva solicitud · <%= nombreDepartamento %></h2><p class="small-muted">Departamento: <strong><%= nombreDepartamento %></strong> · Se registra automáticamente con su usuario.</p><form data-api="/proveeduria/solicitudes" data-solicitud-inventario><label>Sede de entrega<select class="form-select" name="sede" required><option value="">Seleccione la sede</option><% sedesPermitidas.forEach(s=>{ %><option value="<%= s %>" <%= s===sedeActual?'selected':'' %>><%= s %></option><% }) %></select></label><label>Motivo o uso de los productos<textarea class="form-control" name="motivo" maxlength="2000" rows="2"></textarea></label><p class="small-muted">Seleccione una categoría y después uno de sus productos existentes. El código se completa automáticamente. Puede agregar artículos de varias categorías. Los artículos de Compra por solicitud se compran para su pedido y no se registran en inventario.</p><p class="alert alert-info" data-catalogo-vacio role="status" hidden></p><div data-lineas data-sin-precios data-solicitante><div class="table-responsive"><table class="table prov-lineas align-middle"><thead><tr><th>Categoría</th><th>Producto a solicitar</th><th>Código automático</th><th>Cantidad</th><th></th></tr></thead><tbody></tbody></table></div><button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-agregar-articulo>Agregar artículo</button></div><button class="btn btn-primary">Enviar solicitud a Proveeduría</button></form></section>
<section class="plain-card p-3 mb-3"><h2 class="section-title">Seguimiento de mis pedidos</h2><% if(!docs.some(d=>d.tipo==='solicitud')){ %><p class="small-muted">Todavía no ha enviado solicitudes.</p><% } %><% docs.filter(d=>d.tipo==='solicitud').forEach(d=>{const salida=docs.find(s=>s.tipo==='salida'&&s.id===d.datos.salida_id); %><article class="border rounded p-3 mb-3"><div class="d-flex justify-content-between flex-wrap"><h3>Solicitud PR-<%= d.id %></h3><span class="badge text-bg-light"><%= d.datos.estado %></span></div><p><%= d.datos.departamento||user.departamentoActivo %> · <%= d.sede %> · <%= d.datos.solicitante||user.usuario %></p><p><%= d.datos.motivo||'' %></p><% agruparArticulos(d.datos.lineas).forEach(([categoria,lineas])=>{ %><div class="mt-2"><strong class="small"><%= categoria %></strong><% lineas.forEach(l=>{ %><div><%= l.cantidad %> × <%= l.descripcion %></div><% }) %></div><% }) %><% if(d.datos.oc_id){ %><p class="mt-2">Orden de compra PR-<%= d.datos.oc_id %></p><% } %><% if(salida?.datos.estado==='EN_CAMINO'){ %><form data-api="/proveeduria/salidas/<%= salida.id %>/aceptar" data-confirm="¿Ya recibió físicamente todos los productos de este pedido?" class="mt-3"><button class="btn btn-success">Confirmar que recibí los productos</button></form><% } %><% if(salida?.datos.aceptada_en){ %><p class="mt-2 text-success">Recepción confirmada el <%= new Date(salida.datos.aceptada_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %>.</p><% } %></article><% }) %></section>
<section id="Alertas" class="plain-card p-3"><h2 class="section-title">Avisos de mis pedidos</h2><div id="nuevas-alertas" role="status" aria-live="polite"></div><% alertas.forEach(a=>{ %><p><%= a.mensaje %></p><% }) %></section></main><script id="prov-datos" type="application/json"><%- JSON.stringify({ultimaAlerta:alertas[0]?.id||0,articulos,categorias}).replace(/</g,'\\u003c') %></script><script src="/js/proveeduria-solicitudes.js" defer></script><script src="/js/proveeduria.js" defer></script></body></html>
