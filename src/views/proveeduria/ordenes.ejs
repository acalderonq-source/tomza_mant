<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Órdenes de Compra · Proveeduría</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><%- include('../partials/ordenes_styles') %><link href="/css/compras.css" rel="stylesheet"></head><body><nav class="navbar navbar-dark bg-dark px-3 py-2"><span class="navbar-brand fw-semibold">Órdenes de Compra · Proveeduría</span><div class="text-white"><%= user.usuario %><a href="/proveeduria" class="btn btn-sm btn-outline-light ms-2">Inicio</a></div></nav><div class="container py-4">
<div class="page-heading"><div><h1 class="page-title">Órdenes de compra</h1><p class="page-subtitle">Departamento de Proveeduría · Consulta, factura y da seguimiento a las órdenes registradas.</p></div><div class="d-flex gap-2"><a href="/proveeduria" class="btn btn-secondary btn-sm">Inicio</a><% if(puedeGestion){ %><a href="/proveeduria/ordenes/nueva" class="btn btn-dark btn-sm"><i class="bi bi-plus-lg"></i> Nueva orden</a><% } %></div></div>
<%- include('../partials/contabilidad_departamento', { documento: 'ordenes', departamentoConsulta: 'PROVEEDURIA' }) %>
<form class="filtros-card" method="GET" action="/proveeduria/ordenes"><div class="row g-3"><div class="col-md-4"><label class="form-label">N.º PO, proveedor o sede</label><input name="buscar" class="form-control" value="<%= filtros.buscar %>"></div><div class="col-md-2"><label class="form-label">Estado</label><select name="estado" class="form-select"><option value="">Todos</option><% ['GENERADA','PARCIAL','RECIBIDA'].forEach(e=>{ %><option <%= filtros.estado===e?'selected':'' %>><%= e %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">Desde</label><input name="fecha_desde" type="date" class="form-control" value="<%= filtros.fecha_desde %>"></div><div class="col-md-2"><label class="form-label">Hasta</label><input name="fecha_hasta" type="date" class="form-control" value="<%= filtros.fecha_hasta %>"></div><div class="col-md-2 d-flex gap-2 align-items-end"><button class="btn btn-dark btn-filtrar">Filtrar</button><a href="/proveeduria/ordenes" class="btn btn-limpiar">Limpiar</a></div></div></form>
<div class="d-flex gap-3 flex-wrap mb-3"><span class="badge text-bg-light p-3">Órdenes: <%= ordenes.length %></span><span class="badge text-bg-light p-3">Facturadas: <%= ordenes.filter(r=>r.datos.factura||r.datos.facturas_vinculadas?.length).length %></span><span class="badge text-bg-light p-3">Recibidas: <%= ordenes.filter(r=>r.datos.estado==='RECIBIDA').length %></span></div>
<div class="card-modern"><div class="card-header-modern">Órdenes registradas</div><div class="table-responsive"><table class="table table-ordenes"><thead><tr><th>N.º PO</th><th>Fecha</th><th>Proveedor</th><th>Sede</th><th>Forma de pago</th><th>Total</th><th>Estado</th><th>Factura</th><th>Acciones</th></tr></thead><tbody><% if(!ordenes.length){ %><tr><td colspan="9" class="text-center py-4 text-muted">No hay órdenes registradas para estos filtros.</td></tr><% } %><% ordenes.forEach(r=>{const d=r.datos; %><tr><td data-label="N.º PO">PR-<%= r.id %></td><td data-label="Fecha"><%= new Date(r.creado_en).toLocaleDateString('es-CR',{timeZone:'America/Costa_Rica'}) %></td><td data-label="Proveedor"><%= d.proveedor %></td><td data-label="Sede"><%= r.sede %></td><td data-label="Forma de pago"><%= d.forma_pago||d.condicion %> <%= d.credito?d.credito+' días':'' %></td><td data-label="Total"><%= Number(d.total).toLocaleString('es-CR',{style:'currency',currency:d.moneda}) %></td><td data-label="Estado"><span class="badge badge-estado <%= d.estado==='RECIBIDA'?'bg-success':'bg-secondary' %>"><%= d.estado %></span></td><td data-label="Factura"><%= [d.factura,...(d.facturas_vinculadas||[]).map(d=>d.factura)].filter(Boolean).map(f=>f.numero).join(', ')||'Pendiente' %></td><td data-label="Acciones" class="acciones-col"><div class="d-flex gap-2 justify-content-end"><a class="btn btn-sm btn-outline-primary" target="_blank" href="/proveeduria/ordenes/<%= r.id %>/pdf"><i class="bi bi-file-pdf"></i> PDF</a><a class="btn btn-sm btn-outline-dark" href="/proveeduria/ordenes/<%= r.id %>">Detalle</a><a class="btn btn-sm btn-outline-success" href="/proveeduria/ordenes/<%= r.id %>/recepcion"><%= d.estado==='RECIBIDA'||!puedeGestion?'Recepción':'Recibir' %></a></div></td></tr><% }) %></tbody></table></div></div>
</div></body></html>
