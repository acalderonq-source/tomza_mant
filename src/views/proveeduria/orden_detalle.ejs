<% const d=row, o=d.datos, s=saldo(o),bloqueoOrden=motivoBloqueoOrden(o); %>
<% if(ordenActualizada){ %><div class="alert alert-success" role="status">Orden actualizada. Envíela nuevamente al proveedor; el enlace anterior quedó revocado.</div><% } %>
<article id="oc-<%= d.id %>" class="border rounded p-3 mb-3"><div class="d-flex justify-content-between flex-wrap"><h3>OC PR-<%= d.id %> · <%= o.proveedor %></h3><a class="btn btn-outline-dark" target="_blank" href="/proveeduria/ordenes/<%= d.id %>/pdf">Ver / imprimir OC</a></div><p><%= d.sede %> · <%= o.razon_social %> · <%= o.moneda %> <%= Number(o.total||0).toFixed(2) %> · <%= o.condicion %> <%= o.credito %> días · Plazo de entrega: <%= o.entrega %><% if(o.lugar_entrega){ %> · Entregar en: <%= o.lugar_entrega %><% } %> · <%= o.estado %></p>
<% if(puedeGestion){ %><div class="d-flex gap-2 flex-wrap mb-3"><% if(!bloqueoOrden){ %><a class="btn btn-outline-primary" href="/proveeduria/ordenes/<%= row.id %>/editar"><i class="bi bi-pencil"></i> Editar orden</a><form data-api="/proveeduria/ordenes/<%= row.id %>/eliminar" data-confirm="¿Eliminar la orden PR-<%= row.id %>? La solicitud quedará disponible para generar otra OC."><input type="hidden" name="version" value="<%= versionOrden(row) %>"><button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Eliminar orden</button></form><% }else{ %><p class="small text-muted mb-0">Edición y eliminación bloqueadas: <%= bloqueoOrden %>.</p><% } %></div><% } %>
<% if(o.precio_fijo){ %><span class="badge text-bg-info me-2">Precio fijo · sin cotización</span><% } %><% if(o.cotizacion_archivo){ %><a href="/proveeduria/adjunto/<%= d.id %>/cotizacion">Ver cotización adjunta</a><% } %><p><%= o.lineas.map(l=>`${l.cantidad} × ${l.descripcion}`).join(' · ') %></p><% if(o.enviada_en){ %><p>Último correo enviado: <%= o.enviada_en %></p><% } %>
<% if(o.editada_en&&o.enviada_en&&new Date(o.editada_en)>new Date(o.enviada_en)){ %><p class="text-warning-emphasis">Esta orden se modificó después del último envío. Envíela nuevamente al proveedor.</p><% } %>
<% if(puedeGestion){ %><div class="d-flex gap-2 flex-wrap"><form data-api="/proveeduria/ordenes/<%= d.id %>/enviar"><button class="btn btn-primary">Enviar OC al proveedor por correo</button></form><% if(o.estado!=='RECIBIDA'){ %><a class="btn btn-success" href="/proveeduria/ordenes/<%= d.id %>/recepcion">Registrar recepción de mercadería</a><% } %></div><% } %>
<% if(o.factura){const f=o.factura; %><div id="Factura" class="bg-light p-3 mt-3"><h4>Factura <%= f.numero %> · <%= f.estado %></h4><p>Hacienda: <strong><%= f.electronica?.hacienda?.estado || 'SIN VERIFICAR' %></strong> · <%= f.electronica?.hacienda?.detalle || 'Cargue el XML para verificar' %></p><p>Vencimiento: <%= f.fecha_vencimiento || 'Pendiente' %></p><% if(f.electronica){ %><a href="/proveeduria/adjunto/<%= d.id %>/xml">Descargar XML</a><% if(puedeGestion || puedeContabilidad){ %><form data-api="/proveeduria/ordenes/<%= d.id %>/hacienda"><button class="btn btn-outline-primary my-2">Consultar Hacienda</button></form><% } %><% } %><a href="/proveeduria/adjunto/<%= d.id %>/factura">Descargar factura</a><% if(f.diferencias.length){ %><div class="alert alert-warning"><%= f.diferencias.join(' · ') %></div><% } %><% if(f.motivo){ %><p>Devolución: <%= f.motivo %></p><% } %><div class="d-flex gap-2 flex-wrap mt-2">
<% if(puedeGestion && f.estado==='PENDIENTE'){ %><form data-api="/proveeduria/ordenes/<%= d.id %>/factura/aceptar"><button class="btn btn-success" <%= f.diferencias.length?'disabled':'' %>>Aceptar y pasar a Contabilidad</button></form><form data-api="/proveeduria/ordenes/<%= d.id %>/factura/devolver"><input required name="motivo" placeholder="Motivo de devolución"><button class="btn btn-outline-danger">Devolver</button></form><% } %>
<% if(puedeContabilidad && f.estado==='CONTABILIDAD'){ %><form data-api="/proveeduria/ordenes/<%= d.id %>/factura/conciliar"><button class="btn btn-success">Conciliar factura</button></form><form data-api="/proveeduria/ordenes/<%= d.id %>/factura/devolver-contabilidad"><input required name="motivo" placeholder="Motivo de devolución"><button class="btn btn-outline-danger">Devolver desde Contabilidad</button></form><% } %></div></div><% }else{ %><p class="mt-3 text-muted">Factura pendiente de carga por el proveedor.</p><% } %>
<div id="Pagos" class="mt-3"><h4>Pagos y comprobantes</h4><p>Pagado: <%= o.moneda %> <%= s.pagos.toFixed(2) %> · <%= s.saldo<0?'Saldo a favor':'Saldo pendiente' %>: <%= Math.abs(s.saldo).toFixed(2) %></p><% (o.pagos||[]).forEach((p,i)=>{ %><p><a href="/proveeduria/adjunto/<%= d.id %>/pago/<%= i %>"><%= p.referencia %></a> · <%= p.fecha %> · <%= o.moneda %> <%= p.monto %></p><% }) %>
<% if(puedeContabilidad && o.factura?.estado==='CONCILIADA'){ %><form data-api="/proveeduria/ordenes/<%= d.id %>/pagos" class="d-flex gap-2 flex-wrap"><input required name="referencia" placeholder="N.º comprobante"><input required name="monto" type="number" min="0.01" step="0.01" placeholder="Monto"><input required type="date" name="fecha"><input required data-archivo type="file" accept=".pdf,.png,.jpg,.jpeg"><button class="btn btn-primary">Registrar pago</button></form><% } %></div></article>
<% if(typeof facturasPortal!=='undefined'){ %><%- include('../portal_proveedores/orden_facturas',{facturasPortal}) %><% } %>
