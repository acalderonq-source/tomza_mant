<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cuentas por pagar · Contabilidad</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light">
<nav class="navbar navbar-dark bg-dark px-4"><span class="navbar-brand">Gas Tomza · Contabilidad</span><a class="btn btn-outline-light" href="/dashboard">Inicio</a></nav>
<main class="container-fluid p-4"><h1>Cuentas por pagar a proveedores</h1><a class="btn btn-outline-primary mb-3" href="/proveeduria/portal-proveedores/facturas">Revisar facturas del portal de proveedores</a><p>Las facturas requieren aceptación de Hacienda en producción y aprobación interna. Los pagos parciales actualizan el saldo.</p>
<% const hoy=new Date().toLocaleDateString('en-CA',{timeZone:'America/Costa_Rica'}); const cuentas=docs.filter(d=>d.datos.factura.cuenta_por_pagar && d.datos.factura.estado==='CONCILIADA'); %>
<div class="row mb-4"><% for(const moneda of ['CRC','USD']){const total=cuentas.filter(d=>d.datos.moneda===moneda).reduce((n,d)=>n+Math.max(0,saldo(d.datos).saldo),0); %><div class="col-sm-6"><div class="card p-3"><span>Saldo por pagar · <%= moneda %></span><strong class="fs-3"><%= total.toLocaleString('es-CR',{style:'currency',currency:moneda}) %></strong></div></div><% } %></div>
<div class="card table-responsive"><table class="table align-middle"><thead><tr><th>OC / sede</th><th>Proveedor / factura</th><th>Hacienda</th><th>Aprobación interna</th><th>Vencimiento</th><th>Total</th><th>Pagado</th><th>Saldo</th><th>Acción</th></tr></thead><tbody>
<% if(!docs.length){ %><tr><td colspan="9" class="text-center p-4">No hay facturas recibidas de proveedores.</td></tr><% } %>
<% for(const d of docs){const o=d.datos,f=o.factura,s=saldo(o),aprobada=f.cuenta_por_pagar&&f.estado==='CONCILIADA',dinero=n=>Number(n).toLocaleString('es-CR',{style:'currency',currency:o.moneda||'CRC'}); %>
<tr><td><%= d.tipo==='factura_portal'?'Portal #':'PR-' %><%= d.id %><br><small><%= d.sede %></small></td><td><%= o.proveedor %><br><small><%= f.numero %></small></td><td><%= f.electronica?.hacienda?.estado || 'SIN VERIFICAR' %><br><small><%= f.electronica?.hacienda?.ambiente || '' %></small></td><td><%= aprobada ? (s.saldo<=0?'Pagada':s.pagos>0?'Pago parcial':'Por pagar') : f.estado %></td><td><%= f.fecha_vencimiento || 'Pendiente' %><% if(aprobada&&s.saldo>0&&f.fecha_vencimiento<hoy){ %><span class="badge bg-danger">Vencida</span><% } %></td><td><%= dinero(s.facturado) %></td><td><%= dinero(s.pagos) %></td><td><%= dinero(s.saldo) %></td><td><a class="btn btn-outline-primary btn-sm" href="<%= d.tipo==='factura_portal'?'/proveeduria/portal-proveedores/facturas':'/proveeduria/ordenes/'+d.id %>">Revisar / pagar</a></td></tr>
<% } %></tbody></table></div></main></body></html>
