<section class="card p-4 my-4"><h2>Estados de cuenta de proveedores</h2><p>Comparación actualizada contra las facturas y los depósitos de cada OC. Los importes negativos indican saldo a favor.</p><% docs.filter(d=>d.tipo==='estado').forEach(d=>{const e=d.datos; %><article class="border rounded p-3 mb-3"><h3><%= e.proveedor %> · <%= e.fecha %> · <%= e.moneda %></h3><a href="/proveeduria/estados/<%= d.id %>/archivo">Descargar estado de cuenta</a><div class="table-responsive"><table class="table mt-3"><thead><tr><th>OC</th><th>Factura declarada</th><th>Depósitos declarados</th><th>Depósitos registrados</th><th>Saldo declarado</th><th>Saldo del sistema</th><th>Diferencia</th><th>Resultado</th></tr></thead><tbody><% conciliarEstado(e,ordenesConciliacion).forEach(p=>{ %><tr><td>PR-<%= p.oc_id %></td><td><%= p.factura %></td><td><%= p.depositos.toFixed(2) %></td><td><%= p.sistema?.pagos.toFixed(2) || '—' %></td><td><%= p.saldo.toFixed(2) %></td><td><%= p.sistema?.saldo.toFixed(2) || '—' %></td><td><%= p.diferencia?.toFixed(2) || '0.00' %></td><td><%= p.error || 'Conciliado' %></td></tr><% }) %></tbody></table></div></article><% }) %></section>
