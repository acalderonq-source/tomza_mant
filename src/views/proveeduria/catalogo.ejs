<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Productos · Proveeduría</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><%- include('../partials/dashboard_styles') %></head><body>
<nav class="navbar navbar-dark topbar px-3 py-2"><a class="navbar-brand" href="/proveeduria">Proveeduría · Productos</a><a class="btn btn-outline-light btn-sm" href="/proveeduria/inventario">Volver a inventario</a></nav>
<main class="container-fluid shell py-3"><section class="simple-hero mb-3"><h1 class="page-title">Administrar productos</h1><p class="page-subtitle">Productos disponibles para las solicitudes de los departamentos.</p></section>
<div id="resultado" role="status" aria-live="polite"></div>
<section class="plain-card p-3"><form class="row g-2 mb-3" method="get" action="/proveeduria/catalogo"><div class="col-md-6"><label for="buscar">Buscar producto</label><input class="form-control" id="buscar" name="q" value="<%= q %>" placeholder="Nombre o código"></div><div class="col-md-4"><label for="categoria">Categoría</label><select class="form-select" id="categoria" name="categoria"><option value="">Todas</option><% categorias.forEach(c=>{ %><option <%= c===categoria?'selected':'' %>><%= c %></option><% }) %></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Buscar</button></div></form>
<% if(puedeGestion){ %><p class="small text-muted">Eliminar retira el producto del inventario visible y de nuevas solicitudes. Conserva las existencias y el historial de los documentos ya registrados.</p><% } %>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Categoría</th><th>Origen</th><th>Existencia</th><% if(puedeGestion){ %><th>Acciones</th><% } %></tr></thead><tbody>
<% if(!articulos.length){ %><tr><td colspan="5">No hay productos con esos filtros.</td></tr><% } %>
<% articulos.forEach(a=>{ %><tr><td><strong><%= a.descripcion %></strong><div class="small text-muted"><%= a.codigo %></div></td><td><%= a.categoria %></td><td><%= a.origen==='INVENTARIO'?'Inventario':'Compra por solicitud' %></td><td><%= a.cantidad===null?'No aplica':Number(a.cantidad).toLocaleString('es-CR')+' '+a.unidad %></td><% if(puedeGestion){ %><td><form data-api="/proveeduria/catalogo/eliminar" data-confirm="¿Eliminar <%= a.descripcion %> (<%= a.codigo %>) del catálogo y del inventario visible? Se conservará su historial."><input type="hidden" name="codigo" value="<%= a.codigo %>"><button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button></form></td><% } %></tr><% }) %>
</tbody></table></div></section></main><script src="/js/proveeduria.js" defer></script></body></html>
