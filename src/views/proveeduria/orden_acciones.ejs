<% const bloqueo=motivoBloqueoOrden(r.datos); %>
<div class="dropdown"><button class="btn btn-dark btn-sm dropdown-toggle action-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Acciones</button><div class="dropdown-menu dropdown-menu-end acciones-menu p-2">
<a class="dropdown-item" href="/proveeduria/ordenes/<%= r.id %>"><i class="bi bi-eye"></i> Ver detalle</a><a class="dropdown-item" target="_blank" rel="noopener" href="/proveeduria/ordenes/<%= r.id %>/pdf"><i class="bi bi-file-pdf"></i> Descargar PDF</a><a class="dropdown-item" href="/proveeduria/ordenes/<%= r.id %>/recepcion"><i class="bi bi-box-arrow-in-down"></i> <%= r.datos.estado==='RECIBIDA'||!puedeGestion?'Ver recepción':'Recibir mercadería' %></a>
<% if(puedeGestion){ %><div class="dropdown-divider"></div><% if(!bloqueo){ %><a class="dropdown-item" href="/proveeduria/ordenes/<%= r.id %>/editar"><i class="bi bi-pencil"></i> Editar orden</a><form data-api="/proveeduria/ordenes/<%= r.id %>/eliminar" data-confirm="¿Eliminar la orden PR-<%= r.id %>? La solicitud quedará disponible para generar otra OC."><input type="hidden" name="version" value="<%= versionOrden(r) %>"><button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash"></i> Eliminar orden</button></form><% }else{ %><button class="dropdown-item" disabled><i class="bi bi-pencil"></i> Editar orden</button><button class="dropdown-item" disabled><i class="bi bi-trash"></i> Eliminar orden</button><p class="small text-muted px-2 mb-1 text-wrap"><%= bloqueo %>.</p><% } %><% } %>
</div></div>
