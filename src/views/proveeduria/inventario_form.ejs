<% const editar=modo==='editar'; %>
<form data-api="/proveeduria/inventario/<%= editar?'ficha':'articulos' %>" <%= editar?'id=ficha-form':'' %> class="row g-3">
<div class="col-12" data-form-status role="alert" hidden></div>
<% if(editar){ %><input type="hidden" name="sede"><input type="hidden" name="codigo"><% }else{ %><div class="col-md-3"><label class="form-label">Almacén<select class="form-select" name="sede" required><option value="">Seleccione</option><% sedesPermitidas.forEach(s=>{ %><option <%= filtros.sede===s?'selected':'' %>>General · todas las sedes</option><% }) %></select></label></div><div class="col-md-3"><label class="form-label">Código<input class="form-control" name="codigo" maxlength="80" placeholder="Automático si se deja vacío"></label></div><% } %>
<div class="<%= editar?'col-md-12':'col-md-6' %>"><label class="form-label">Nombre del artículo<input class="form-control" name="descripcion" maxlength="255" required></label></div>
<div class="col-md-3"><label class="form-label">Grupo<select name="grupo" class="form-select"><% GRUPOS.forEach(g=>{ %><option value="<%= g %>"><%= g==='SUMINISTRO'?'Suministros':'Inventario' %></option><% }) %></select></label></div><div class="col-md-3"><label class="form-label">Tipo<select name="tipo" class="form-select"><% TIPOS.forEach(t=>{ %><option <%= t==='OTRO'?'selected':'' %>><%= t %></option><% }) %></select></label></div><div class="col-md-3"><label class="form-label">Categoría<input name="categoria" class="form-control" maxlength="100" placeholder="Limpieza, oficina, seguridad…"></label></div><div class="col-md-3"><label class="form-label">Unidad de medida<input name="unidad" class="form-control" maxlength="30" value="UND" required></label></div>
<div class="col-md-3"><label class="form-label">Ubicación<input name="ubicacion" class="form-control" maxlength="120" placeholder="Estante A-03"></label></div><div class="col-md-3"><label class="form-label">Mínimo<input name="stock_minimo" class="form-control" type="number" min="0" step="0.001" value="0" required></label></div><div class="col-md-3"><label class="form-label">Máximo<input name="stock_maximo" class="form-control" type="number" min="0" step="0.001" value="0" required></label></div><div class="col-md-3"><label class="form-label">IVA %<input name="iva" class="form-control" type="number" min="0" max="100" step="0.01" value="13" required></label></div>
<div class="col-md-<%= editar?'12':'8' %>"><label class="form-label">Proveedor<input name="proveedor" class="form-control" list="proveedores-inventario" maxlength="255"></label></div><% if(!editar){ %><div class="col-md-4"><label class="form-label">Existencia inicial<input name="cantidad" class="form-control" type="number" min="0" step="0.001" value="0" required></label></div><% } %><div class="col-12"><button class="btn btn-primary fw-bold"><%= editar?'Guardar ficha':'Registrar artículo' %></button></div>
</form>
