<%
const fmt=n=>Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:3});
const stats={articulos:inventario.length,bajos:inventario.filter(a=>estadoStock(a)==='BAJO').length,agotados:inventario.filter(a=>estadoStock(a)==='AGOTADO').length,suministros:inventario.filter(a=>a.grupo==='SUMINISTRO').length};
const link=params=>'/proveeduria/inventario?'+new URLSearchParams({sede:filtros.sede,...params});
const exportar='/proveeduria/inventario/exportar.xlsx?'+new URLSearchParams({sede:filtros.sede,q:filtros.q,grupo:filtros.grupo,estado:filtros.estado});
const esMovimientos=filtros.pagina==='movimientos';
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Inventario Proveeduría · Gas Tomza</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><%- include('../partials/bodega_styles') %><link href="/css/proveeduria-inventario.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-dark topbar px-3 py-2"><span class="navbar-brand fw-semibold"><span class="brand-mark"><i class="bi bi-boxes"></i></span>Inventario Proveeduría</span><div class="d-flex align-items-center gap-2 text-white"><span class="small fw-bold"><%= user.usuario %></span><a href="/proveeduria" class="btn btn-outline-light btn-sm rounded-pill px-3">Inicio</a></div></nav>
<main class="container-fluid shell py-3"><section class="hero mb-3"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><div class="page-kicker">Proveeduría · Bodega · Inventario</div><h1 class="page-title"><%= esMovimientos?'Movimientos de inventario':'Centro de control de inventario' %></h1><p class="page-copy">Artículos, suministros, existencias por sede y movimientos de entradas y salidas.</p></div><span class="page-chip"><i class="bi bi-calendar3 me-1"></i><%= new Date().toLocaleDateString('es-CR',{timeZone:'America/Costa_Rica'}) %></span></div>
<form method="GET" action="/proveeduria/inventario" class="inventory-filters mt-3"><% if(esMovimientos){ %><input type="hidden" name="vista" value="movimientos"><% } %><label class="visually-hidden" for="buscar-inventario">Buscar artículos</label><input id="buscar-inventario" class="form-control" name="q" value="<%= filtros.q %>" placeholder="Buscar por código, artículo, categoría o ubicación…"><select name="sede" class="form-select" aria-label="Filtrar por sede"><option value="TODAS">Todas mis sedes</option><% sedesPermitidas.forEach(s=>{ %><option <%= filtros.sede===s?'selected':'' %>><%= s %></option><% }) %></select><% if(!esMovimientos){ %><select name="grupo" class="form-select" aria-label="Filtrar por grupo"><option value="">Todos los grupos</option><% GRUPOS.forEach(g=>{ %><option value="<%= g %>" <%= filtros.grupo===g?'selected':'' %>><%= g==='SUMINISTRO'?'Suministros':'Inventario' %></option><% }) %></select><select name="estado" class="form-select" aria-label="Filtrar por existencia"><option value="">Todas las existencias</option><% [['DISPONIBLE','Disponibles'],['BAJO','Stock bajo'],['AGOTADO','Agotados']].forEach(([v,n])=>{ %><option value="<%= v %>" <%= filtros.estado===v?'selected':'' %>><%= n %></option><% }) %></select><% } %><button class="btn btn-light fw-bold"><i class="bi bi-search"></i> Buscar</button><a class="btn btn-outline-light" href="<%= link(esMovimientos?{vista:'movimientos'}:{}) %>">Limpiar</a></form></section>
<div id="resultado" role="status" aria-live="polite"></div>
<nav class="module-tabs mb-3" aria-label="Secciones de inventario"><a class="module-tab <%= !esMovimientos&&!filtros.grupo?'active':'' %>" href="<%= link({}) %>">Inventario general</a><a class="module-tab <%= filtros.grupo==='SUMINISTRO'&&!esMovimientos?'active':'' %>" href="<%= link({grupo:'SUMINISTRO'}) %>">Suministros</a><a class="module-tab <%= esMovimientos?'active':'' %>" href="<%= link({vista:'movimientos'}) %>">Movimientos</a><a class="module-tab" href="/proveeduria/recepciones">Recepciones de OC</a><a class="module-tab" href="/proveeduria/solicitudes">Entregas a departamentos</a></nav>
<section class="kpi-grid mb-3" aria-label="Resumen de inventario"><% [['Artículos',stats.articulos,'Inventario del filtro actual','','bi-box-seam'],['Stock bajo',stats.bajos,'Alcanzaron el mínimo','is-warning','bi-exclamation-triangle'],['Agotados',stats.agotados,'Sin existencia disponible','is-danger','bi-x-octagon'],['Suministros',stats.suministros,'Artículos de consumo','is-success','bi-box2-heart']].forEach(k=>{ %><article class="kpi-card <%= k[3] %>"><div><div class="kpi-label"><%= k[0] %></div><div class="kpi-value"><%= k[1] %></div><div class="kpi-note"><%= k[2] %></div></div><span class="kpi-icon"><i class="bi <%= k[4] %>"></i></span></article><% }) %></section>
<% if(!esMovimientos){ %><section class="panel mb-3"><div class="panel-head flex-wrap"><div><h2 class="panel-title">Inventario general</h2><p class="panel-copy">Existencia actual, ubicación, mínimo y máximo por sede.</p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-sm btn-outline-success" href="<%= exportar %>"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</a><% if(puedeGestion){ %><a class="btn btn-sm btn-primary" href="#nuevo-articulo" id="abrir-nuevo"><i class="bi bi-plus-circle"></i> Nuevo artículo</a><% } %></div></div>
<% if(puedeGestion){ %><details class="panel-body" id="nuevo-articulo"><summary class="fw-bold mb-3">Registrar artículo y existencia inicial</summary><div class="form-card"><%- include('inventario_form',{modo:'nuevo'}) %></div></details><% } %>
<div class="table-responsive"><table class="table table-modern align-middle mb-0 inventory-table"><thead><tr><th>Código</th><th>Artículo</th><th>Sede</th><th>Tipo / grupo</th><th>Existencia</th><th>Estado</th><th>Ubicación</th><th>Mín. / máx.</th><th>Proveedor</th><% if(puedeGestion){ %><th>Acciones</th><% } %></tr></thead><tbody><% if(!inventario.length){ %><tr><td class="empty-row" colspan="10"><i class="bi bi-box-seam d-block fs-2 mb-2"></i>No hay artículos con estos filtros.<div class="small muted mt-1">Reciba una OC o registre la existencia inicial para comenzar.</div></td></tr><% } %><% inventario.forEach((a,i)=>{const estado=estadoStock(a); %><tr><td><span class="code-badge"><%= a.codigo %></span></td><td><strong><%= a.descripcion %></strong><div class="small muted"><%= a.categoria||'Sin categoría' %> · IVA <%= fmt(a.iva) %>%</div></td><td><%= a.sede %></td><td><span class="pill"><%= a.tipo %></span><div class="small muted"><%= a.grupo==='SUMINISTRO'?'Suministros':'Inventario' %></div></td><td class="money"><%= fmt(a.cantidad) %> <%= a.unidad %></td><td><span class="stock-badge <%= estado==='AGOTADO'?'stock-out':estado==='BAJO'?'stock-low':'stock-ok' %>"><%= estado==='AGOTADO'?'Agotado':estado==='BAJO'?'Stock bajo':'Disponible' %></span></td><td><%= a.ubicacion||'Por ubicar' %></td><td><%= fmt(a.stock_minimo) %> / <%= fmt(a.stock_maximo) %></td><td><%= a.proveedor||'Sin proveedor' %></td><% if(puedeGestion){ %><td><div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary" data-editar-articulo="<%= i %>">Ficha</button><button type="button" class="btn btn-sm btn-outline-dark" data-ajustar-articulo="<%= i %>">Ajustar</button></div></td><% } %></tr><% }) %></tbody></table></div></section>
<% }else{ %><section class="panel mb-3"><div class="panel-head"><div><h2 class="panel-title">Historial de entradas, salidas y ajustes</h2><p class="panel-copy">Últimos 200 movimientos registrados. Cada movimiento conserva el saldo anterior y el nuevo.</p></div></div><div class="table-responsive"><table class="table table-modern align-middle mb-0"><thead><tr><th>Fecha</th><th>Sede</th><th>Artículo</th><th>Movimiento</th><th>Cantidad</th><th>Anterior</th><th>Nuevo</th><th>Documento / motivo</th><th>Usuario</th></tr></thead><tbody><% if(!movimientos.length){ %><tr><td colspan="9" class="empty-row">Todavía no hay movimientos registrados para estos filtros.</td></tr><% } %><% movimientos.forEach(m=>{ %><tr><td><%= new Date(m.creado_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %></td><td><%= m.sede %></td><td><strong><%= m.descripcion %></strong><div class="small muted"><%= m.codigo %></div></td><td><span class="pill"><%= {ENTRADA_OC:'Entrada por OC',SALIDA_PEDIDO:'Salida por pedido',INICIAL:'Existencia inicial',AJUSTE:'Ajuste físico'}[m.tipo]||m.tipo %></span></td><td class="money <%= Number(m.cantidad)<0?'text-danger':'text-success' %>"><%= Number(m.cantidad)>0?'+':'' %><%= fmt(m.cantidad) %></td><td><%= fmt(m.existencia_anterior) %></td><td><%= fmt(m.existencia_nueva) %></td><td><%= m.motivo %><% if(m.documento_id){ %><div class="small muted">Documento PR-<%= m.documento_id %></div><% } %></td><td><%= m.usuario_id %></td></tr><% }) %></tbody></table></div></section><% } %>
<p class="small muted"><i class="bi bi-info-circle"></i> Las recepciones de OC suman inventario y las entregas a departamentos lo descuentan automáticamente.</p>
<datalist id="proveedores-inventario"><% proveedores.forEach(p=>{ %><option value="<%= p.nombre %>"></option><% }) %></datalist>
</main><% if(puedeGestion){ %><dialog class="inventory-dialog" id="editar-ficha"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="panel-title">Ficha del artículo</h2><button type="button" class="btn-close" data-cerrar-dialog aria-label="Cerrar"></button></div><p id="ficha-referencia" class="small muted"></p><%- include('inventario_form',{modo:'editar'}) %></dialog><dialog class="inventory-dialog inventory-adjust" id="ajustar-existencia"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="panel-title">Ajustar existencia física</h2><button type="button" class="btn-close" data-cerrar-dialog aria-label="Cerrar"></button></div><p id="ajuste-referencia"></p><form id="ajuste-form" data-api="/proveeduria/inventario/ajuste" data-confirm="¿Confirma el ajuste a la existencia física indicada? El cambio quedará registrado con su motivo."><div data-form-status role="alert" hidden></div><input type="hidden" name="sede"><input type="hidden" name="codigo"><label class="form-label d-block">Existencia contada<input class="form-control" type="number" min="0" step="0.001" name="cantidad" required></label><label class="form-label d-block mt-3">Motivo del ajuste<textarea class="form-control" name="motivo" maxlength="500" required rows="3"></textarea></label><button class="btn btn-primary mt-3">Guardar ajuste</button></form></dialog><% } %>
<script id="inventario-datos" type="application/json"><%- JSON.stringify(inventario).replace(/</g,'\\u003c') %></script><script src="/js/proveeduria.js" defer></script><script src="/js/proveeduria-inventario.js" defer></script></body></html>
