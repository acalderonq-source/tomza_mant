<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Precios fijos · Proveeduría</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><%- include('../partials/dashboard_styles') %><script src="/js/proveeduria-precio-fijo.js" defer></script></head><body>
<nav class="navbar navbar-dark topbar px-3 py-2"><a class="navbar-brand" href="/proveeduria">Proveeduría · Precios fijos</a><div class="d-flex gap-2"><a class="btn btn-warning btn-sm" href="/proveeduria/precio-fijo">Ir al carrito</a><a class="btn btn-outline-light btn-sm" href="/proveeduria">Volver</a></div></nav>
<main class="container-fluid shell py-3">
<section class="simple-hero mb-3"><h1 class="page-title">Precios fijos</h1><p class="page-subtitle">Asigne el proveedor a cada artículo con precio fijo. Solo los artículos con proveedor aparecen en el carrito y se compran sin cotización.</p></section>
<div id="resultado" role="status" aria-live="polite"></div>
<section class="plain-card p-3">
  <div class="row g-2 mb-3"><div class="col-md-6"><label for="pf-buscar">Buscar artículo</label><input class="form-control" id="pf-buscar" data-pf-buscar placeholder="Nombre del artículo"></div>
  <div class="col-md-3"><label for="pf-filtro">Mostrar</label><select class="form-select" id="pf-filtro" data-pf-filtro><option value="">Todos</option><option value="sin">Sin proveedor</option><option value="con">Con proveedor</option></select></div>
  <div class="col-md-3 d-flex align-items-end"><span class="small text-secondary"><%= articulos.filter(a => a.proveedor_clave && a.activo).length %> de <%= articulos.length %> artículos listos para el carrito</span></div></div>
  <datalist id="pf-proveedores"><% proveedores.forEach(p => { %><option value="<%= p.nombre %>" data-clave="<%= p.clave %>"></option><% }) %></datalist>
  <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Artículo</th><th>Proveedor</th><th>Precio unitario</th><th>IVA %</th><th>Moneda</th><th>Activo</th><th></th></tr></thead><tbody>
  <% articulos.forEach(a => { %>
    <tr data-pf-fila data-texto="<%= a.descripcion.toLowerCase() %>" data-con-proveedor="<%= a.proveedor_clave ? 1 : 0 %>">
      <td><%= a.descripcion %></td>
      <td><input class="form-control form-control-sm" list="pf-proveedores" data-pf-proveedor value="<%= a.proveedor %>" placeholder="Escriba o elija el proveedor" <%= puedeEditar ? '' : 'disabled' %>></td>
      <td><input class="form-control form-control-sm" type="number" step="0.0001" min="0.0001" data-pf-precio value="<%= a.precio_unitario %>" <%= puedeEditar ? '' : 'disabled' %>></td>
      <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" max="100" data-pf-iva value="<%= a.iva %>" <%= puedeEditar ? '' : 'disabled' %>></td>
      <td><select class="form-select form-select-sm" data-pf-moneda <%= puedeEditar ? '' : 'disabled' %>><% ['CRC','USD'].forEach(m => { %><option <%= a.moneda === m ? 'selected' : '' %>><%= m %></option><% }) %></select></td>
      <td><input class="form-check-input" type="checkbox" data-pf-activo <%= a.activo ? 'checked' : '' %> <%= puedeEditar ? '' : 'disabled' %> aria-label="Activo"></td>
      <td><% if (puedeEditar) { %><button class="btn btn-sm btn-primary" data-pf-guardar data-clave="<%= a.clave %>">Guardar</button><% } %></td>
    </tr>
  <% }) %>
  <% if (!articulos.length) { %><tr><td colspan="7">No hay artículos con precio en el catálogo.</td></tr><% } %>
  </tbody></table></div>
</section>
</main></body></html>
