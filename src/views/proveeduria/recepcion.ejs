<% const fmt=n=>Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:3});const abierta=resumen.estado!=='RECIBIDA'; %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recepción PR-<%= row.id %> · Proveeduría</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><%- include('../partials/bodega_styles') %><link href="/css/proveeduria-recepciones.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-dark topbar px-3 py-2"><span class="navbar-brand fw-semibold"><span class="brand-mark"><i class="bi bi-box-arrow-in-down"></i></span>Recepción de mercadería</span><a href="/proveeduria/recepciones" class="btn btn-outline-light btn-sm rounded-pill px-3">Volver a recepciones</a></nav>
<main class="container-fluid shell py-3"><section class="hero mb-3"><div class="d-flex justify-content-between align-items-start flex-wrap gap-3"><div><div class="page-kicker">Proveeduría · Orden de compra</div><h1 class="page-title">Recepción OC PR-<%= row.id %></h1><p class="page-copy"><%= row.datos.proveedor %></p></div><span class="receipt-state state-<%= resumen.estado.toLowerCase() %>"><%= {PENDIENTE:'Pendiente de recibir',PARCIAL:'Recepción parcial',RECIBIDA:'Recepción completa'}[resumen.estado] %></span></div><div class="receipt-meta"><div><span>Sede de ingreso</span><strong><%= row.sede %></strong></div><div><span>Plazo de entrega</span><strong><%= row.datos.entrega||'No indicado' %></strong></div><div><span>Solicitada el</span><strong><%= new Date(row.creado_en).toLocaleDateString('es-CR',{timeZone:'America/Costa_Rica'}) %></strong></div><div><span>Solicitud asociada</span><strong><%= row.datos.solicitud_id?'PR-'+row.datos.solicitud_id:'Compra directa' %></strong></div></div></section>
<div class="receipt-toolbar mb-3"><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="/proveeduria/ordenes/<%= row.id %>/pdf"><i class="bi bi-file-earmark-pdf"></i> Ver orden de compra</a><a class="btn btn-sm btn-outline-dark" href="/proveeduria/inventario?sede=<%= encodeURIComponent(row.sede) %>"><i class="bi bi-boxes"></i> Ver inventario</a><button type="button" class="btn btn-sm btn-outline-dark" id="imprimir-recepcion"><i class="bi bi-printer"></i> Imprimir detalle</button></div>
<% if(!abierta){ %><div class="alert alert-success"><i class="bi bi-check2-circle"></i> La mercadería de esta OC está recibida completamente y registrada en inventario.</div><% } %>
<form id="recepcion-form" action="/proveeduria/ordenes/<%= row.id %>/recibir" method="POST">
<input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="version" value="<%= resumen.version %>">
<div class="receipt-layout"><section class="panel"><div class="panel-head flex-wrap gap-2"><div><h2 class="panel-title">Detalle de mercadería</h2><p class="panel-copy"><%= abierta&&puedeGestion?'Ingrese únicamente la cantidad que recibió físicamente en esta entrega.':'Cantidades ordenadas, recibidas y pendientes por artículo.' %></p></div><% if(abierta&&puedeGestion){ %><button class="btn btn-sm btn-outline-primary" type="button" id="completar-pendientes">Completar pendientes</button><% } %></div>
<div class="table-responsive"><table class="table table-modern align-middle mb-0 receipt-lines"><thead><tr><th>Artículo</th><th class="text-end">Ordenado</th><th class="text-end">Recibido</th><th class="text-end">Pendiente</th><% if(abierta&&puedeGestion){ %><th class="receipt-input-col">Recibir ahora</th><% } %></tr></thead><tbody><% resumen.lineas.forEach(l=>{ %><tr><td><span class="code-badge"><%= l.codigo %></span><strong class="d-block mt-1"><%= l.descripcion %></strong></td><td class="text-end money"><%= fmt(l.cantidad) %></td><td class="text-end money text-success"><%= fmt(l.recibida) %></td><td class="text-end money <%= l.pendiente?'text-warning-emphasis':'text-success' %>"><%= fmt(l.pendiente) %></td><% if(abierta&&puedeGestion){ %><td><input class="form-control receipt-quantity" type="number" min="0" max="<%= l.pendiente %>" step="0.001" value="0" data-codigo="<%= l.codigo %>" aria-label="Cantidad recibida de <%= l.descripcion %>" <%= !l.pendiente?'disabled':'' %> required></td><% } %></tr><% }) %></tbody></table></div></section>
<aside class="panel receipt-side"><div class="panel-head"><h2 class="panel-title"><%= abierta&&puedeGestion?'Registrar esta entrega':'Resumen de recepción' %></h2></div><div class="panel-body"><p class="small muted"><%= resumen.completas %> de <%= resumen.lineas.length %> artículos completos</p><div class="receipt-progress mb-3"><span style="width:<%= resumen.progreso %>%"></span></div>
<% if(abierta&&puedeGestion){ %><label class="form-label d-block" for="referencia">Factura, remisión o referencia <span class="text-danger">*</span></label><input id="referencia" name="referencia" class="form-control mb-3" maxlength="120" required placeholder="Ej. Remisión 00451"><label class="form-label d-block" for="observaciones">Observaciones</label><textarea id="observaciones" name="observaciones" class="form-control mb-3" rows="3" maxlength="500" placeholder="Estado de los productos, faltantes…"></textarea><p class="small muted">Recibe: <strong><%= user.nombre||user.usuario %></strong>. Se guardarán la fecha y hora actuales.</p><div id="recepcion-resultado" role="alert" aria-live="polite" hidden></div><label class="receipt-confirm mb-3"><input class="form-check-input" id="confirmar-mercaderia" type="checkbox" required><span>Confirmo que revisé y recibí las cantidades indicadas.</span></label><button type="submit" class="btn btn-primary w-100" id="guardar-recepcion"><i class="bi bi-check2-circle"></i> Confirmar e ingresar a inventario</button><p class="small muted mt-2 mb-0" id="resumen-entrega">Seleccione las cantidades para registrar la entrega.</p>
<% }else{ %><p class="small muted mb-0"><%= resumen.anterior?'Esta OC se recibió antes de habilitar el historial detallado. Se conserva su ingreso original.':abierta?'La recepción de mercadería la registra Proveeduría.':'Todas las cantidades de la OC fueron recibidas.' %></p><% } %>
</div></aside></div></form>
<section class="panel mt-3"><div class="panel-head"><div><h2 class="panel-title">Historial de recepciones</h2><p class="panel-copy">Cada entrega conserva su referencia, responsable y cantidades ingresadas.</p></div><span class="pill"><%= resumen.historial.length %> entregas</span></div><div class="panel-body"><% if(!resumen.historial.length){ %><p class="muted mb-0"><%= resumen.anterior?'Recepción completa registrada anteriormente.': 'Todavía no se han registrado entregas para esta OC.' %></p><% } %><% [...resumen.historial].reverse().forEach((r,i)=>{ %><article class="receipt-history"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h3>Entrega <%= resumen.historial.length-i %> · <%= r.referencia %></h3><p class="small muted"><%= new Date(r.fecha).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %> · Recibió <%= r.recibido_por||'Usuario '+r.usuario_id %></p></div><span class="receipt-state state-recibida">Ingresada a inventario</span></div><% if(r.observaciones){ %><p class="receipt-observations"><%= r.observaciones %></p><% } %><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Código</th><th>Artículo</th><th class="text-end">Cantidad recibida</th></tr></thead><tbody><% r.lineas.forEach(l=>{ %><tr><td><%= l.codigo %></td><td><%= l.descripcion %></td><td class="text-end money"><%= fmt(l.cantidad) %></td></tr><% }) %></tbody></table></div></article><% }) %></div></section>
<% if(row.datos.solicitud_id){ %><p class="small muted mt-3"><i class="bi bi-info-circle"></i> Al completar la OC, la solicitud quedará lista para alistar la entrega al departamento.</p><% } %>
</main><script src="/js/proveeduria-recepciones.js" defer></script></body></html>
