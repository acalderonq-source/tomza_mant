<% const sinOrden=docs.filter(d=>d.tipo==='factura_portal'&&!d.datos.orden_compra);const importadas=sinOrden.filter(d=>d.datos.importacion_estado_cuenta);const fuentes=new Map(importadas.map(d=>[d.datos.importacion_estado_cuenta.sha256,d.datos])); %>
<% for(const o of fuentes.values()){const i=o.importacion_estado_cuenta,r=i.resumen,usd=n=>Number(n).toLocaleString('es-CR',{style:'currency',currency:o.moneda}); %><div class="alert alert-warning mt-3"><strong><%= o.proveedor %> · Estado de cuenta al <%= i.corte %></strong><div><%= r.facturas %> facturas detalladas: <%= usd(r.total_facturas) %> de importe original y <%= usd(r.saldo_detallado) %> de saldo al corte.</div><% if(r.diferencia){ %><div>El resumen del archivo indica <%= usd(r.saldo_resumen) %>: diferencia sin detalle de <strong><%= usd(r.diferencia) %></strong>. Requiere revisión con el proveedor.</div><% } %><div>Pendientes de XML/PDF originales, vinculación a OC y revisión. Las aplicaciones anteriores informadas no son comprobantes de pago.</div></div><% } %>
<% if(sinOrden.length){ %><section class="card-modern mt-3"><div class="card-header-modern">Facturas pendientes de vincular a una orden de compra</div><div class="table-responsive"><table class="table table-ordenes"><thead><tr><th>Proveedor / factura</th><th>Detalle</th><th>Emisión / vencimiento</th><th>Importe original</th><th>Saldo pendiente</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% for(const row of sinOrden){const o=row.datos,f=o.factura,i=o.importacion_estado_cuenta,s=saldo(o),moneda=n=>Number(n).toLocaleString('es-CR',{style:'currency',currency:o.moneda}); %><tr><td><strong><%= o.proveedor %></strong><div>Factura <%= f.numero %></div><small><%= f.electronica?.consecutivo||'' %></small></td><td><%= i?.detalle||'' %></td><td><%= f.electronica?.fecha?.slice(0,10)||'Pendiente' %><div>Vence: <%= f.fecha_vencimiento||'Pendiente' %></div></td><td><%= moneda(s.facturado) %><% if(s.aplicaciones_anteriores){ %><div class="small text-muted">Aplicaciones anteriores según proveedor: <%= moneda(s.aplicaciones_anteriores) %></div><% } %></td><td><%= moneda(s.saldo) %><% if(i){ %><div class="small text-muted">Saldo al corte: <%= moneda(i.saldo_al_corte) %></div><% } %></td><td><%= f.estado %><% if(i){ %><div class="small text-muted">Importada de estado de cuenta</div><% } %></td><td><a class="btn btn-sm btn-outline-primary" href="/proveeduria/portal-proveedores/facturas#portal-factura-<%= row.id %>">Revisar</a><% if(i?.archivo){ %><a class="btn btn-sm btn-outline-secondary mt-1" href="/proveeduria/portal-proveedores/facturas/<%= row.id %>/archivo/estado">Estado de cuenta</a><% } %></td></tr><% } %></tbody></table></div></section><% } %>
