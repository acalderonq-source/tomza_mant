<section id="Solicitudes" class="card p-4 mb-4"><div class="d-flex justify-content-between flex-wrap"><h2>Solicitudes de los departamentos</h2><a class="btn btn-outline-primary btn-sm" href="/proveeduria/mis-solicitudes">Mis solicitudes</a></div><p>Bodega verifica las existencias y solicita a Proveeduría la compra de los faltantes. Proveeduría cotiza y genera la OC; Bodega recibe y entrega.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Solicitud</th><th>Departamento / solicitante</th><th>Sede</th><th>Productos</th><th>Estado</th><th>Gestionar</th></tr></thead><tbody><% if(!docs.some(d=>d.tipo==='solicitud')){ %><tr><td colspan="6" class="text-center text-muted">No hay solicitudes recibidas.</td></tr><% } %><% docs.filter(d=>d.tipo==='solicitud').forEach(d=>{const s=d.datos; %><tr id="solicitud-<%= d.id %>"><td>PR-<%= d.id %><% if(s.origen==='REPOSICION_STOCK'){ %><div class="small text-primary">Reposición de inventario</div><% } %></td><td><strong><%= s.departamento||'Sin departamento registrado' %><%= s.unidad==='CAJAS'?' · Cajas':'' %></strong><div><%= s.solicitante||'Usuario '+d.usuario_id %></div><small><%= s.motivo||'' %></small></td><td><%= d.sede %></td><td><% agruparArticulos(s.lineas).forEach(([categoria,lineas])=>{ %><div class="mb-2"><strong class="small"><%= categoria %></strong><% lineas.forEach(l=>{ %><div><%= l.cantidad %> × <%= l.descripcion %></div><%- include('existencia_solicitud',{revision:s.existencias,codigo:l.codigo}) %><% }) %></div><% }) %></td><td><%= s.estado==='PENDIENTE_BODEGA'?'Pendiente de Bodega':s.estado==='SOLICITUD_COMPRA'?'Compra solicitada a Proveeduría':s.estado %><%- include('compra_solicitud',{pedido:s}) %><%- include('rechazos_solicitud',{pedido:s}) %></td><td><% if(s.estado!=='RECHAZADA'&&s.requiere_revision_bodega&&!s.compra&&!s.salida_id&&!s.oc_id){ %><% if(typeof puedeBodega!=='undefined'&&puedeBodega){ %><form data-api="/proveeduria/solicitudes/<%= d.id %>/solicitar-compra" data-confirm="¿Enviar a Proveeduría la solicitud de compra por los faltantes?" class="mb-2"><button class="btn btn-primary btn-sm">Solicitar compra a Proveeduría</button></form><% }else{ %><p class="small text-muted">Bodega debe revisar las existencias y solicitar la compra.</p><% } %><% } %><% if(puedeGestion && !['RECHAZADA','REPOSICION_RECIBIDA'].includes(s.estado) && !s.oc_id && !s.salida_id && s.estado!=='LISTA_PARA_ENTREGA' && (!s.requiere_revision_bodega||s.compra)){ %><a class="btn btn-sm btn-outline-primary mb-2" href="/proveeduria/solicitudes/<%= d.id %>/cotizacion"><%= s.cotizacion?'Ver / ajustar cotización':'Preparar cotización' %></a><% if(s.cotizacion){ %><a class="btn btn-sm btn-dark mb-2" href="/proveeduria/ordenes/nueva?solicitud_id=<%= d.id %>">Generar OC desde cotización</a><% } %><% } %><% if(s.oc_id){ %><a class="btn btn-sm btn-outline-dark mb-2" href="/proveeduria/ordenes/<%= s.oc_id %>">Ver OC PR-<%= s.oc_id %></a><% } %><% if(puedeGestion && s.origen!=='REPOSICION_STOCK' && s.estado!=='RECHAZADA' && !s.salida_id && (s.estado==='LISTA_PARA_ENTREGA'||((typeof puedeBodega!=='undefined'&&puedeBodega)&&s.estado==='PENDIENTE_BODEGA')||(!s.departamento&&!s.oc_id))){ %><form data-api="/proveeduria/salidas"><input type="hidden" name="solicitud_id" value="<%= d.id %>"><button class="btn btn-outline-success btn-sm">Generar boleta de entrega</button></form><% } %><% if(s.salida_id){ %><a class="btn btn-sm btn-outline-primary" href="/proveeduria/salidas">Ver entrega</a><% } %><%- include('rechazar_pedido_form',{d,s}) %></td></tr><% }) %></tbody></table></div></section>
