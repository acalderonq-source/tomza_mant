<section id="Salidas" class="card p-4 mb-4"><h2>Boletas de entrega y salidas de productos</h2><% docs.filter(d=>d.tipo==='salida').forEach(d=>{ %><article class="border rounded p-3 mb-2"><strong>Boleta PR-<%= d.id %> · <%= d.datos.estado==='EN_CAMINO'?'Entregado · Pendiente de confirmación':d.datos.estado %></strong><p><%= d.datos.lineas.map(l=>`${l.cantidad} × ${l.descripcion}`).join(' · ') %></p><% if(d.datos.inventario_pendiente===true){ %><p class="small text-muted">Boleta preparada: todavía no se han descontado productos del inventario.</p><% } %><% if(d.datos.salida_registrada_en){ %><p class="small text-success">Salida registrada: <%= new Date(d.datos.salida_registrada_en).toLocaleString('es-CR',{timeZone:'America/Costa_Rica'}) %> · Responsable: <%= d.datos.entregado_por %></p><% } %><div class="d-flex gap-2"><a class="btn btn-outline-dark" target="_blank" href="/proveeduria/salidas/<%= d.id %>/imprimir">Formato para imprimir</a><% if(puedeGestion && d.datos.estado==='ALISTANDO'){ %><form data-api="/proveeduria/salidas/<%= d.id %>/enviar" data-confirm="¿Está entregando físicamente los productos? Se registrará su salida del inventario."><button class="btn btn-primary">Entregar y registrar salida</button></form><% } %><% if(d.usuario_id===user.id && d.datos.estado==='EN_CAMINO'){ %><form data-api="/proveeduria/salidas/<%= d.id %>/aceptar" data-confirm="¿Ya recibió físicamente todos los artículos?"><button class="btn btn-success">Confirmar recibido</button></form><% } %></div><% if(d.datos.aceptada_en){ %><p>Confirmado por usuario <%= d.usuario_id %> el <%= d.datos.aceptada_en %></p><% } %></article><% }) %></section>