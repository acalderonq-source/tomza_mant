<section id="Salidas" class="card p-4 mb-4"><h2>Salidas y confirmación de entrega</h2><% docs.filter(d=>d.tipo==='salida').forEach(d=>{ %><article class="border rounded p-3 mb-2"><strong>Salida PR-<%= d.id %> · <%= d.datos.estado %></strong><p><%= d.datos.lineas.map(l=>`${l.cantidad} × ${l.descripcion}`).join(' · ') %></p><div class="d-flex gap-2"><a class="btn btn-outline-dark" target="_blank" href="/proveeduria/salidas/<%= d.id %>/imprimir">Formato para imprimir</a><% if(puedeGestion && d.datos.estado==='ALISTANDO'){ %><form data-api="/proveeduria/salidas/<%= d.id %>/enviar"><button class="btn btn-primary">Enviar y alertar al solicitante</button></form><% } %><% if(d.usuario_id===user.id && d.datos.estado==='EN_CAMINO'){ %><form data-api="/proveeduria/salidas/<%= d.id %>/aceptar" data-confirm="¿Ya recibió físicamente todos los artículos?"><button class="btn btn-success">Confirmar recibido</button></form><% } %></div><% if(d.datos.aceptada_en){ %><p>Confirmado por usuario <%= d.usuario_id %> el <%= d.datos.aceptada_en %></p><% } %></article><% }) %></section>