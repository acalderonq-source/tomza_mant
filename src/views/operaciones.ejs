<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Operaciones | Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('partials/dashboard_styles') %>
</head>
<body>
<nav class="navbar navbar-dark topbar px-3 py-2">
  <a class="navbar-brand" href="/operaciones">Gas Tomza · Operaciones</a>
  <div class="d-flex align-items-center gap-2 text-white">
    <span class="small"><%= user.nombre || user.usuario %></span>
    <a href="/inicio" class="btn btn-outline-light btn-sm">Ir a inicio</a>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>
<main class="container-fluid shell py-2">
  <section class="simple-hero mb-2">
    <h1 class="page-title">Operaciones</h1>
    <div class="page-subtitle">Departamento: <strong>Operaciones</strong> · Sede: <strong><%= user.sede || 'Sin sede asignada' %></strong> · <%= new Date().toLocaleDateString('es-CR', {timeZone:'America/Costa_Rica'}) %></div>
  </section>
  <section class="mb-2">
    <h2 class="section-title legacy-modules-title">Módulos</h2>
    <div class="module-grid">
      <% if(puedeReportes){ %><a href="/reportes-supervisores" class="module-card">
        <span class="module-icon icon-red"><i class="bi bi-tools"></i></span>
        <div><div class="module-title">Reportes de Taller</div><p class="module-copy">Reporte fallas o mantenimientos de las unidades de Técnicos y consulte su atención por Taller.</p></div>
      </a><% } %>
      <% if(puedeUnidades){ %><a href="#unidades-operaciones" class="module-card">
        <span class="module-icon icon-blue"><i class="bi bi-truck"></i></span>
        <div><div class="module-title">Unidades de Operaciones</div><p class="module-copy">Consulte las unidades registradas como Técnicos y seleccione la placa que necesita reportar.</p></div>
      </a><% } %>
      <% if(puedeSuministros){ %><a href="/proveeduria/mis-solicitudes" class="module-card">
        <span class="module-icon icon-blue"><i class="bi bi-cart-plus"></i></span>
        <div><div class="module-title">Solicitud de suministros</div><p class="module-copy">Solicite materiales y suministros a Proveeduría. Consulte sus pedidos y confirme la entrega.</p></div>
      </a><% } %>
    </div>
  </section>
  <% if(puedeUnidades){ %><section id="unidades-operaciones" class="plain-card p-3 mt-3">
    <h2 class="section-title">Unidades de Operaciones · Técnicos</h2>
    <p class="small-muted">Unidades activas registradas como Técnicos.</p>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Placa</th><% if(puedeCrearReporte){ %><th>Reportar</th><% } %></tr></thead><tbody>
    <% if(!unidades.length){ %><tr><td colspan="2" class="text-muted">No hay unidades activas registradas como Técnicos.</td></tr><% } %>
    <% unidades.forEach(u=>{ %><tr><td><strong><%= u.placa %></strong></td><% if(puedeCrearReporte){ %><td><a class="btn btn-outline-primary btn-sm" href="/reportes-supervisores?unidad_id=<%= u.id %>#nuevo-reporte">Crear reporte de Taller</a></td><% } %></tr><% }) %>
    </tbody></table></div>
  </section><% } %>
</main>
</body>
</html>
