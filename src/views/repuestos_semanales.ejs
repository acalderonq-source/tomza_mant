<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="application/json" id="unidadesSemanalData"><%- JSON.stringify(unidadesLista.map(unidad => ({ placa: unidad.placa, sede: unidad.sede || '' }))) %></script>
<script type="application/json" id="sedesSemanalData"><%- JSON.stringify(Object.fromEntries(sedesLista.map(sede => [sede, mostrarSede(sede)]))) %></script>
<script type="application/json" id="pedidoCedisData"><%- JSON.stringify(pedidoSeleccionData) %></script>
<script>
  const SEDE_RECOPE_LIMON = '<%= sedeRecope %>';
  const SEDE_RECOPE_ORIGEN = '<%= sedeRecopeOrigen %>';
  const unidadesSemanal = (() => {
    try { return JSON.parse(document.getElementById('unidadesSemanalData')?.textContent || '[]'); }
    catch (_) { return []; }
  })();
  const sedesSemanal = (() => {
    try { return JSON.parse(document.getElementById('sedesSemanalData')?.textContent || '{}'); }
    catch (_) { return {}; }
  })();
  const pedidosCedis = (() => {
    try { return JSON.parse(document.getElementById('pedidoCedisData')?.textContent || '[]'); }
    catch (_) { return []; }
  })();

  function limpiarPlacaVista(value) {
    return String(value || '').trim().toUpperCase().replace(/\s+/g, '').replace(/-/g, '');
  }

  function candidatosPlaca(value) {
    const clean = limpiarPlacaVista(value);
    if (!clean) return [];
    const candidatos = new Set([clean]);
    const soloNumeros = clean.replace(/\D/g, '');
    if (soloNumeros && soloNumeros === clean) {
      candidatos.add(`C${soloNumeros}`);
      candidatos.add(`CL${soloNumeros}`);
      candidatos.add(`S${soloNumeros}`);
    }
    return [...candidatos];
  }

  function buscarUnidadPorPlaca(value) {
    const candidatos = candidatosPlaca(value);
    return unidadesSemanal.find(item => candidatos.includes(limpiarPlacaVista(item.placa)));
  }

  function textoSede(sede) {
    return sedesSemanal[sede] || sede || '';
  }

  function grupoSedeEspecial(value) {
    const clean = String(value || '').trim().toUpperCase().replace(/[_\s]+/g, '-');
    return ['GENERALES-LIMON', 'MUEBLE-LIMON'].includes(clean) ? SEDE_RECOPE_LIMON : '';
  }

  function sedeDestinoVista(unidad, sedeDefault = '') {
    if (sedeDefault === SEDE_RECOPE_LIMON && unidad?.sede === SEDE_RECOPE_ORIGEN) {
      return SEDE_RECOPE_LIMON;
    }
    return unidad?.sede || '';
  }

  function aplicarSedeAutomatica(placaInput, sedeHidden, sedeTexto, sedeDefault = '') {
    const sedeGrupo = grupoSedeEspecial(placaInput?.value);
    if (sedeGrupo) {
      if (sedeHidden) sedeHidden.value = sedeGrupo;
      if (sedeTexto) sedeTexto.value = textoSede(sedeGrupo);
      return;
    }

    const unidad = buscarUnidadPorPlaca(placaInput?.value);
    if (unidad) {
      const sedeDestino = sedeDestinoVista(unidad, sedeDefault);
      if (sedeHidden) sedeHidden.value = sedeDestino;
      if (sedeTexto) sedeTexto.value = textoSede(sedeDestino);
      return;
    }

    if (!/\d/.test(String(placaInput?.value || '')) && sedeDefault) {
      if (sedeHidden) sedeHidden.value = sedeDefault;
      if (sedeTexto) sedeTexto.value = textoSede(sedeDefault);
    }
  }

  const placaNueva = document.getElementById('placaNuevaSemanal');
  const sedeNueva = document.getElementById('sedeNuevaSemanal');
  const sedeNuevaTexto = document.getElementById('sedeNuevaSemanalTexto');
  ['input', 'change'].forEach(eventName => {
    placaNueva?.addEventListener(eventName, () => aplicarSedeAutomatica(placaNueva, sedeNueva, sedeNuevaTexto, '<%= filtros.sede || '' %>'));
  });

  const placaEditar = document.getElementById('placaEditarSemanal');
  const sedeEditar = document.getElementById('sedeEditarSemanal');
  const sedeEditarTexto = document.getElementById('sedeEditarSemanalTexto');
  ['input', 'change'].forEach(eventName => {
    placaEditar?.addEventListener(eventName, () => aplicarSedeAutomatica(placaEditar, sedeEditar, sedeEditarTexto, sedeEditar?.value || '<%= filtros.sede || '' %>'));
  });

  document.querySelectorAll('.js-editar-semanal').forEach(button => {
    button.addEventListener('click', () => {
      const form = document.getElementById('editarSemanalForm');
      const estado = document.getElementById('estadoEditarSemanal');
      const fecha = document.getElementById('fechaEditarSemanal');
      if (!form) return;
      form.action = `/repuestos-semanales/${button.dataset.id}/editar`;
      if (fecha) fecha.value = button.dataset.fecha || '<%= filtros.fecha || fechaSemanaNueva %>';
      if (placaEditar) placaEditar.value = button.dataset.placa || '';
      if (sedeEditar) sedeEditar.value = button.dataset.sede || '';
      if (sedeEditarTexto) sedeEditarTexto.value = textoSede(button.dataset.sede);
      if (estado) estado.value = button.dataset.estado || 'PENDIENTE';
      const solicitud = document.getElementById('solicitudEditarSemanal');
      if (solicitud) solicitud.value = button.dataset.solicitud || '';
    });
  });

  document.querySelectorAll('.js-marcar-rojo').forEach(button => {
    button.addEventListener('click', () => {
      const form = document.getElementById('marcadoRojoForm');
      const resumen = document.getElementById('marcadoRojoResumen');
      if (!form) return;
      form.action = `/repuestos-semanales/${button.dataset.id}/marcado`;
      if (resumen) resumen.textContent = `${button.dataset.placa || ''} · ${button.dataset.solicitud || 'Solicitud'}`;
      const item = pedidosCedis.find(pedido => String(pedido.id) === String(button.dataset.id));
      renderMarcadoRojoOpciones(item || {
        id: button.dataset.id,
        placa: button.dataset.placa,
        solicitud: button.dataset.solicitud,
        partes: [{ index: 0, texto: button.dataset.solicitud || 'Repuesto', marcado: Boolean(button.dataset.marcado), noCompra: false }]
      });
    });
  });

  const pedidoSedeSelect = document.getElementById('pedidoSedeSelect');
  const pedidoSedeTitulo = document.getElementById('pedidoSedeTitulo');
  const pedidoSedeButtons = document.querySelectorAll('.js-pedido-sede');
  const pedidoLista = document.getElementById('pedidoCedisLista');
  const pedidoForm = document.getElementById('pedidoCedisForm');
  const pedidoMarcarTodos = document.getElementById('pedidoMarcarTodos');
  const pedidoLimpiar = document.getElementById('pedidoLimpiar');

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function textoComparableCliente(value) {
    return String(value || '')
      .trim()
      .toUpperCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[_\s]+/g, '-');
  }

  function renderMarcadoRojoOpciones(item) {
    const contenedor = document.getElementById('marcadoRojoOpciones');
    if (!contenedor) return;

    const partes = Array.isArray(item?.partes) && item.partes.length
      ? item.partes
      : [{ index: 0, texto: item?.solicitud || 'Repuesto', marcado: false, noCompra: item?.estado === 'NO_COMPRA' }];

    contenedor.innerHTML = partes.map((parte, index) => {
      const texto = parte.texto || 'Repuesto';
      const value = escapeHtml(texto);
      const rojoId = `marcadoRojo_${item.id}_${index}`;
      const noCompraId = `noCompra_${item.id}_${index}`;
      const noCompraChecked = parte.noCompra || item.estado === 'NO_COMPRA';

      return `
        <div class="mark-option">
          <div class="mark-option-title">${escapeHtml(texto)}</div>
          <div class="d-flex gap-3 flex-wrap">
            <div class="form-check">
              <input class="form-check-input js-mark-red-check" type="checkbox" id="${rojoId}" name="marcado_rojo_items" value="${value}" ${parte.marcado && !noCompraChecked ? 'checked' : ''}>
              <label class="form-check-label fw-bold text-danger" for="${rojoId}">Rojo / va llegando</label>
            </div>
            <div class="form-check">
              <input class="form-check-input js-no-compra-check" type="checkbox" id="${noCompraId}" name="no_compra_items" value="${value}" ${noCompraChecked ? 'checked' : ''}>
              <label class="form-check-label fw-bold text-secondary" for="${noCompraId}">No se compra</label>
            </div>
          </div>
        </div>
      `;
    }).join('');

    contenedor.querySelectorAll('.js-no-compra-check').forEach(input => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        const rojo = input.closest('.mark-option')?.querySelector('.js-mark-red-check');
        if (rojo) rojo.checked = false;
      });
    });

    contenedor.querySelectorAll('.js-mark-red-check').forEach(input => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        const noCompra = input.closest('.mark-option')?.querySelector('.js-no-compra-check');
        if (noCompra) noCompra.checked = false;
      });
    });
  }

  function pedidosVisibles() {
    const sede = pedidoSedeSelect?.value || '';
    return pedidosCedis.filter(item => item.sede === sede);
  }

  function nombreSedePedido(sede) {
    const item = pedidosCedis.find(pedido => pedido.sede === sede);
    return item?.sedeTexto || sede || '';
  }

  function activarSedePedido(sede) {
    if (pedidoSedeSelect) pedidoSedeSelect.value = sede || '';
    pedidoSedeButtons.forEach(button => {
      button.classList.toggle('is-active', button.dataset.sede === sede);
    });
    if (pedidoSedeTitulo) {
      pedidoSedeTitulo.textContent = sede ? nombreSedePedido(sede) : 'Seleccione una sede';
    }
    renderPedidosCedis();
  }

  function renderPedidosCedis() {
    if (!pedidoLista) return;
    const sede = pedidoSedeSelect?.value || '';

    if (!sede) {
      pedidoLista.innerHTML = '<div class="pedido-empty">Seleccione una sede para ver los pedidos.</div>';
      return;
    }

    const items = pedidosVisibles();
    if (!items.length) {
      pedidoLista.innerHTML = '<div class="pedido-empty">No hay pedidos para esa sede con los filtros actuales.</div>';
      return;
    }

    pedidoLista.innerHTML = items.map(item => {
      const partes = Array.isArray(item.partes) && item.partes.length
        ? item.partes
        : [{ index: 0, texto: item.solicitud || item.marcado_rojo || 'Repuesto' }];
      const disabled = item.excluido ? 'disabled' : '';
      const checked = item.excluido ? '' : 'checked';

      return partes.map(parte => `
        <label class="pedido-item ${item.excluido || parte.noCompra ? 'is-excluded' : ''}">
          <input class="form-check-input pedido-check" type="checkbox" name="pedido_items" value="${item.id}:${parte.index}" ${parte.noCompra ? '' : checked} ${parte.noCompra ? 'disabled' : disabled}>
          <div class="pedido-plate">${escapeHtml(item.placa)}</div>
          <div>
            <div class="pedido-text fw-bold">${escapeHtml(parte.texto)}</div>
            <div class="text-muted small mt-1">
              ${escapeHtml(item.sedeTexto || item.sede)} · solicitud #${escapeHtml(item.id)}
            </div>
          </div>
          <span class="pedido-status ${item.excluido || parte.noCompra ? 'bg-secondary text-white' : 'bg-light text-dark'}">${escapeHtml(parte.noCompra ? 'No se compra' : item.excluido ? 'Fuera del pedido' : (item.estado || 'Pendiente'))}</span>
        </label>
      `).join('');
    }).join('');
  }

  pedidoSedeButtons.forEach(button => {
    button.addEventListener('click', () => activarSedePedido(button.dataset.sede || ''));
  });

  pedidoMarcarTodos?.addEventListener('click', () => {
    pedidoLista?.querySelectorAll('.pedido-check:not(:disabled)').forEach(input => { input.checked = true; });
  });

  pedidoLimpiar?.addEventListener('click', () => {
    pedidoLista?.querySelectorAll('.pedido-check:not(:disabled)').forEach(input => { input.checked = false; });
  });

  pedidoForm?.addEventListener('submit', event => {
    if (!pedidoSedeSelect?.value) {
      event.preventDefault();
      alert('Seleccione una sede para generar el pedido.');
      return;
    }

    const seleccionados = pedidoLista?.querySelectorAll('.pedido-check:checked:not(:disabled)').length || 0;
    if (!seleccionados) {
      event.preventDefault();
      alert('Seleccione al menos un repuesto para generar el pedido.');
    }
  });

  document.getElementById('pedidoCedisModal')?.addEventListener('shown.bs.modal', () => {
    activarSedePedido(pedidoSedeSelect?.value || '');
  });
</script>
</body>
</html>
