<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Repuestos semanales - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #eef4f8;
      --dark: #10213f;
      --head: #0f6684;
      --sede: #9fc5e8;
      --line: #111827;
      --red: #e11d2e;
      --soft: #f8fbff;
      --stripe: #d8f0f8;
    }

    body {
      background: var(--bg);
      color: #0f172a;
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .9rem;
    }

    .topbar {
      background: #111827;
      border-bottom: 3px solid #e2232a;
    }

    .shell { max-width: 1500px; }

    .hero {
      background: linear-gradient(135deg, #10213f, #0f6684 70%, #e2232a);
      border-radius: 12px;
      color: #fff;
      padding: 1rem;
    }

    .page-title {
      font-size: 1.35rem;
      font-weight: 950;
      margin: 0;
    }

    .panel {
      background: #fff;
      border: 1px solid #d7e4ee;
      border-radius: 12px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
      overflow: hidden;
    }

    .filters {
      display: grid;
      gap: .7rem;
      grid-template-columns: 170px 190px 180px 1fr auto auto;
      padding: .85rem 1rem;
    }

    .filters label,
    .modal label {
      color: #334155;
      font-size: .68rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .summary-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .summary-card {
      background: #fff;
      border: 1px solid #d7e4ee;
      border-radius: 10px;
      padding: .85rem;
    }

    .summary-label {
      color: #64748b;
      font-size: .7rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .summary-value {
      font-size: 1.55rem;
      font-weight: 950;
      line-height: 1;
      margin-top: .15rem;
    }

    .sheet-wrap {
      background: #fff;
      overflow: auto;
    }

    .sheet-table {
      border-collapse: collapse;
      min-width: 1040px;
      width: 100%;
    }

    .sheet-table th,
    .sheet-table td {
      border: 1px solid var(--line);
      padding: .36rem .5rem;
      vertical-align: middle;
    }

    .sheet-table th {
      background: var(--head);
      color: #fff;
      font-size: .72rem;
      font-weight: 950;
      text-align: center;
      text-transform: uppercase;
    }

    .sede-row td {
      background: var(--sede) !important;
      color: #000;
      font-weight: 950;
      text-align: center;
      text-transform: uppercase;
    }

    .sheet-table tbody tr.item-row:nth-child(odd) td { background: var(--stripe); }
    .sheet-table tbody tr.item-row:nth-child(even) td { background: var(--soft); }

    .placa-cell {
      font-weight: 950;
      text-align: center;
      white-space: nowrap;
      width: 120px;
    }

    .solicitud-cell { min-width: 420px; }

    .rojo-cell {
      color: var(--red);
      font-weight: 900;
      min-width: 320px;
      white-space: pre-wrap;
    }

    .empty-red { color: #94a3b8; font-weight: 700; }

    .estado-badge {
      border-radius: 999px;
      display: inline-block;
      font-size: .7rem;
      font-weight: 900;
      padding: .25rem .55rem;
      white-space: nowrap;
    }

    .estado-pendiente { background: #e5e7eb; color: #111827; }
    .estado-llegando { background: #fee2e2; color: #b91c1c; }
    .estado-completo { background: #dcfce7; color: #166534; }

    .actions-grid {
      display: grid;
      gap: .25rem;
      grid-template-columns: 1fr;
      min-width: 180px;
    }

    .modal-content {
      border: 0;
      border-radius: 16px;
      overflow: hidden;
    }

    .modal-header {
      background: linear-gradient(135deg, #10213f, #0f6684);
      color: #fff;
    }

    .modal-header .btn-close {
      filter: invert(1);
      opacity: .95;
    }

    .form-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .span-2 { grid-column: 1 / -1; }

    @media (max-width: 980px) {
      .filters,
      .summary-grid,
      .form-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 640px) {
      .filters,
      .summary-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .sheet-table,
      .sheet-table tbody,
      .sheet-table tr,
      .sheet-table td {
        display: block;
        min-width: 0;
        width: 100%;
      }

      .sheet-table thead { display: none; }

      .sheet-table tr.item-row {
        border: 1px solid #d7e4ee;
        border-radius: 12px;
        margin: .75rem;
        overflow: hidden;
      }

      .sheet-table td {
        display: grid;
        gap: .6rem;
        grid-template-columns: 40% minmax(0, 1fr);
        text-align: left;
      }

      .sheet-table td::before {
        color: #475569;
        content: attr(data-label);
        font-size: .7rem;
        font-weight: 900;
        text-transform: uppercase;
      }

      .sede-row td {
        display: block;
        text-align: center;
      }

      .sede-row td::before {
        content: "";
        display: none;
      }

      .modal-dialog {
        margin: 0;
        max-width: 100%;
      }

      .modal-content {
        border-radius: 0;
        min-height: 100vh;
      }
    }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(solicitudes) ? solicitudes : [];
  const sedesLista = Array.isArray(sedes) ? sedes : [];
  const unidadesLista = Array.isArray(unidades) ? unidades : [];
  const mostrarSede = typeof etiquetaSede === 'function' ? etiquetaSede : (sede) => sede;
  const estadoTexto = typeof etiquetaEstadoSemanal === 'function' ? etiquetaEstadoSemanal : (estado) => estado;
  const estadoClase = estado => String(estado || '').toLowerCase();
  const fechaSemanaNueva = (typeof fechaProximaSemana !== 'undefined' && fechaProximaSemana) || filtros.fecha || fechaHoy;
  const textoSeguroData = value => String(value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const pedidoPdfParams = new URLSearchParams();
  ['fecha', 'sede', 'placa', 'estado'].forEach(key => {
    if (filtros[key]) pedidoPdfParams.set(key, filtros[key]);
  });
  const pedidoPdfUrl = `/repuestos-semanales/pedido-cedis.pdf${pedidoPdfParams.toString() ? `?${pedidoPdfParams.toString()}` : ''}`;
%>

<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-calendar-week me-2"></i>Repuestos semanales</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/repuestos" class="btn btn-outline-light btn-sm rounded-pill px-3">Solicitud de repuestos</a>
    <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Dashboard</a>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>

<main class="container-fluid shell py-3">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Repuestos semanales</h1>
        <div class="opacity-75">Formato semanal por sede. Lo marcado en rojo representa lo que va llegando.</div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="<%= pedidoPdfUrl %>" class="btn btn-light btn-sm rounded-pill fw-bold px-3">
          <i class="bi bi-file-earmark-pdf"></i> Descargar pedido
        </a>
        <% if (puedeGestionar) { %>
          <button type="button" class="btn btn-warning btn-sm rounded-pill fw-bold px-3" data-bs-toggle="modal" data-bs-target="#nuevoSemanalModal">
            <i class="bi bi-plus-circle"></i> Agregar repuesto
          </button>
        <% } %>
      </div>
    </div>
  </section>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <section class="summary-grid mb-3">
    <div class="summary-card"><div class="summary-label">Total</div><div class="summary-value"><%= resumen.total || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">Pendientes</div><div class="summary-value"><%= resumen.PENDIENTE || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">Marcados rojo</div><div class="summary-value text-danger"><%= resumen.marcados || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">Completos</div><div class="summary-value"><%= resumen.COMPLETO || 0 %></div></div>
  </section>

  <section class="panel mb-3">
    <form method="GET" action="/repuestos-semanales" class="filters">
      <div>
        <label class="form-label mb-1">Semana destino</label>
        <input type="date" name="fecha" class="form-control form-control-sm" value="<%= filtros.fecha || fechaHoy %>">
      </div>
      <div>
        <label class="form-label mb-1">Sede</label>
        <select name="sede" class="form-select form-select-sm">
          <option value="">Todas permitidas</option>
          <% sedesLista.forEach(sede => { %>
            <option value="<%= sede %>" <%= filtros.sede === sede ? 'selected' : '' %>><%= mostrarSede(sede) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estados.forEach(estado => { %>
            <option value="<%= estado %>" <%= filtros.estado === estado ? 'selected' : '' %>><%= estadoTexto(estado) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Placa / grupo</label>
        <input type="text" name="placa" class="form-control form-control-sm text-uppercase" value="<%= filtros.placa || '' %>" placeholder="C164415, GENERALES, MUEBLE...">
      </div>
      <div class="d-flex align-items-end">
        <button class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i> Filtrar</button>
      </div>
      <div class="d-flex align-items-end">
        <a href="/repuestos-semanales" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </section>

  <section class="panel">
    <% if (!lista.length) { %>
      <div class="text-center text-muted fw-bold p-4">No hay repuestos semanales con los filtros seleccionados.</div>
    <% } else { %>
      <div class="sheet-wrap">
        <table class="sheet-table">
          <thead>
            <tr>
              <th>Placa</th>
              <th>Solicitud de repuestos</th>
              <th>Va llegando</th>
              <th>Estado</th>
              <th>Creado por</th>
              <% if (puedeGestionar) { %><th>Acciones</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% let grupoAnterior = ''; %>
            <% lista.forEach(item => { %>
              <%
                const grupoActual = `${item.fecha_formato || ''}|${item.sede || ''}`;
                const columnas = puedeGestionar ? 6 : 5;
              %>
              <% if (grupoActual !== grupoAnterior) { grupoAnterior = grupoActual; %>
                <tr class="sede-row">
                  <td colspan="<%= columnas %>"><%= item.fecha_formato || '-' %> · <%= mostrarSede(item.sede) %></td>
                </tr>
              <% } %>
              <tr class="item-row">
                <td data-label="Placa" class="placa-cell"><%= item.placa %></td>
                <td data-label="Solicitud" class="solicitud-cell"><%= item.solicitud %></td>
                <td data-label="Va llegando" class="rojo-cell">
                  <% if (item.marcado_rojo) { %>
                    <%= item.marcado_rojo %>
                  <% } else { %>
                    <span class="empty-red">-</span>
                  <% } %>
                </td>
                <td data-label="Estado" class="text-center">
                  <span class="estado-badge estado-<%= estadoClase(item.estado) %>"><%= estadoTexto(item.estado) %></span>
                </td>
                <td data-label="Creado por"><%= item.creado_por_usuario || '-' %></td>
                <% if (puedeGestionar) { %>
                  <td data-label="Acciones">
                    <div class="actions-grid">
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-primary js-editar-semanal"
                        data-bs-toggle="modal"
                        data-bs-target="#editarSemanalModal"
                        data-id="<%= item.id %>"
                        data-fecha="<%= item.fecha_iso || '' %>"
                        data-placa="<%= item.placa %>"
                        data-sede="<%= item.sede || '' %>"
                        data-estado="<%= item.estado || 'PENDIENTE' %>"
                        data-solicitud="<%- textoSeguroData(item.solicitud) %>"
                        data-marcado="<%- textoSeguroData(item.marcado_rojo) %>">
                        <i class="bi bi-pencil-square"></i> Editar
                      </button>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-danger js-marcar-rojo"
                        data-bs-toggle="modal"
                        data-bs-target="#marcadoRojoModal"
                        data-id="<%= item.id %>"
                        data-placa="<%= item.placa %>"
                        data-solicitud="<%- textoSeguroData(item.solicitud) %>"
                        data-marcado="<%- textoSeguroData(item.marcado_rojo) %>">
                        <i class="bi bi-highlighter"></i> Marcar rojo
                      </button>
                      <form method="POST" action="/repuestos-semanales/<%= item.id %>/estado">
                        <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
                        <input type="hidden" name="sede" value="<%= filtros.sede || '' %>">
                        <input type="hidden" name="placa" value="<%= filtros.placa || '' %>">
                        <select name="estado" class="form-select form-select-sm mb-1">
                          <% estados.forEach(estado => { %>
                            <option value="<%= estado %>" <%= item.estado === estado ? 'selected' : '' %>><%= estadoTexto(estado) %></option>
                          <% }) %>
                        </select>
                        <button class="btn btn-sm btn-dark w-100"><i class="bi bi-save"></i> Guardar estado</button>
                      </form>
                      <form method="POST" action="/repuestos-semanales/<%= item.id %>/eliminar" onsubmit="return confirm('¿Eliminar este repuesto semanal?')">
                        <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
                        <input type="hidden" name="sede" value="<%= filtros.sede || '' %>">
                        <input type="hidden" name="placa" value="<%= filtros.placa || '' %>">
                        <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Eliminar</button>
                      </form>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<% if (puedeGestionar) { %>
  <div class="modal fade" id="nuevoSemanalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <form method="POST" action="/repuestos-semanales">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold mb-0"><i class="bi bi-calendar-plus me-1"></i> Agregar repuesto semanal</h5>
              <div class="small opacity-75">Puede usar placa normal o grupos como GENERALES, MUEBLE, LLANTAS.</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <div class="form-grid">
              <div class="span-2 alert alert-warning mb-0 py-2">
                <strong>Pedido CEDIS:</strong> MUEBLE y GENERAL-TALLER quedan en pantalla, pero no salen en la descarga del pedido.
              </div>
              <div>
                <label class="form-label mb-1">Semana destino</label>
                <input type="date" name="fecha" class="form-control" value="<%= fechaSemanaNueva %>" required>
              </div>
              <div>
                <label class="form-label mb-1">Sede automática</label>
                <input type="hidden" name="sede" id="sedeNuevaSemanal" value="<%= filtros.sede || '' %>">
                <input type="text" id="sedeNuevaSemanalTexto" class="form-control" value="<%= filtros.sede ? mostrarSede(filtros.sede) : '' %>" placeholder="Se llena al seleccionar la placa" readonly>
                <div class="form-text">Si usa GENERALES, MUEBLE o LLANTAS, primero filtre la sede arriba y luego agregue.</div>
              </div>
              <div>
                <label class="form-label mb-1">Placa / grupo</label>
                <input type="text" name="placa" id="placaNuevaSemanal" class="form-control text-uppercase" list="placasSemanalesList" placeholder="C164415, GENERALES, MUEBLE..." required>
                <datalist id="placasSemanalesList">
                  <% unidadesLista.forEach(unidad => { %>
                    <option value="<%= unidad.placa %>" data-sede="<%= unidad.sede || '' %>"><%= unidad.placa %> · <%= mostrarSede(unidad.sede) %></option>
                  <% }) %>
                  <option value="GENERALES">GENERALES</option>
                  <option value="GENERAL-TALLER">GENERAL-TALLER</option>
                  <option value="MUEBLE">MUEBLE</option>
                  <option value="LLANTAS">LLANTAS</option>
                  <option value="SUMINISTRO LIMPIEZA">SUMINISTRO LIMPIEZA</option>
                </datalist>
              </div>
              <div>
                <label class="form-label mb-1">Estado</label>
                <select name="estado" class="form-select">
                  <% estados.forEach(estado => { %>
                    <option value="<%= estado %>"><%= estadoTexto(estado) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="span-2">
                <label class="form-label mb-1">Solicitud de repuestos</label>
                <textarea name="solicitud" class="form-control" rows="3" placeholder="Ej: filtros de aceite, diesel, aire" required></textarea>
              </div>
              <div class="span-2">
                <label class="form-label mb-1">Va llegando / marcar rojo</label>
                <textarea name="marcado_rojo" class="form-control" rows="2" placeholder="Opcional. Ej: filtro de aceite, escobillas"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-dark"><i class="bi bi-save"></i> Guardar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editarSemanalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <form method="POST" id="editarSemanalForm">
          <input type="hidden" name="sede" id="sedeEditarSemanal" value="">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold mb-0"><i class="bi bi-pencil-square me-1"></i> Editar repuesto semanal</h5>
              <div class="small opacity-75">La sede se actualiza automáticamente si cambia la placa.</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <div class="form-grid">
              <div>
                <label class="form-label mb-1">Semana destino</label>
                <input type="date" name="fecha" id="fechaEditarSemanal" class="form-control" required>
              </div>
              <div>
                <label class="form-label mb-1">Placa / grupo</label>
                <input type="text" name="placa" id="placaEditarSemanal" class="form-control text-uppercase" list="placasSemanalesList" required>
              </div>
              <div>
                <label class="form-label mb-1">Sede automática</label>
                <input type="text" id="sedeEditarSemanalTexto" class="form-control" readonly>
              </div>
              <div>
                <label class="form-label mb-1">Estado</label>
                <select name="estado" id="estadoEditarSemanal" class="form-select">
                  <% estados.forEach(estado => { %>
                    <option value="<%= estado %>"><%= estadoTexto(estado) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="span-2">
                <label class="form-label mb-1">Solicitud de repuestos</label>
                <textarea name="solicitud" id="solicitudEditarSemanal" class="form-control" rows="3" required></textarea>
              </div>
              <div class="span-2">
                <label class="form-label mb-1">Va llegando / marcar rojo</label>
                <textarea name="marcado_rojo" id="marcadoEditarSemanal" class="form-control" rows="2"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-dark"><i class="bi bi-save"></i> Guardar cambios</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="marcadoRojoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" id="marcadoRojoForm">
          <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
          <input type="hidden" name="sede" value="<%= filtros.sede || '' %>">
          <input type="hidden" name="placa" value="<%= filtros.placa || '' %>">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold mb-0"><i class="bi bi-highlighter me-1"></i> Marcar en rojo</h5>
              <div class="small opacity-75" id="marcadoRojoResumen">Escriba lo que va llegando.</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <label class="form-label fw-bold">Texto rojo</label>
            <textarea name="marcado_rojo" id="marcadoRojoInput" class="form-control" rows="4" placeholder="Ej: escobillas, pintura blanca, filtro de aceite"></textarea>
            <div class="form-text">Si lo deja en blanco, se quita el marcado rojo.</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button class="btn btn-danger"><i class="bi bi-save"></i> Guardar marcado</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="application/json" id="unidadesSemanalData"><%- JSON.stringify(unidadesLista.map(unidad => ({ placa: unidad.placa, sede: unidad.sede || '' }))) %></script>
<script type="application/json" id="sedesSemanalData"><%- JSON.stringify(Object.fromEntries(sedesLista.map(sede => [sede, mostrarSede(sede)]))) %></script>
<script>
  const unidadesSemanal = (() => {
    try { return JSON.parse(document.getElementById('unidadesSemanalData')?.textContent || '[]'); }
    catch (_) { return []; }
  })();
  const sedesSemanal = (() => {
    try { return JSON.parse(document.getElementById('sedesSemanalData')?.textContent || '{}'); }
    catch (_) { return {}; }
  })();

  function limpiarPlacaVista(value) {
    return String(value || '').trim().toUpperCase().replace(/\s+/g, '').replace(/-/g, '');
  }

  function candidatosPlaca(value) {
    const clean = limpiarPlacaVista(value);
    if (!clean) return [];
    const candidatos = new Set([clean]);
    const soloNumeros = clean.replace(/\D/g, '');
    if (soloNumeros && soloNumeros === clean) {
      candidatos.add(`C${soloNumeros}`);
      candidatos.add(`CL${soloNumeros}`);
      candidatos.add(`S${soloNumeros}`);
    }
    return [...candidatos];
  }

  function buscarUnidadPorPlaca(value) {
    const candidatos = candidatosPlaca(value);
    return unidadesSemanal.find(item => candidatos.includes(limpiarPlacaVista(item.placa)));
  }

  function textoSede(sede) {
    return sedesSemanal[sede] || sede || '';
  }

  function aplicarSedeAutomatica(placaInput, sedeHidden, sedeTexto, sedeDefault = '') {
    const unidad = buscarUnidadPorPlaca(placaInput?.value);
    if (unidad) {
      if (sedeHidden) sedeHidden.value = unidad.sede || '';
      if (sedeTexto) sedeTexto.value = textoSede(unidad.sede);
      return;
    }

    if (!/\d/.test(String(placaInput?.value || '')) && sedeDefault) {
      if (sedeHidden) sedeHidden.value = sedeDefault;
      if (sedeTexto) sedeTexto.value = textoSede(sedeDefault);
    }
  }

  const placaNueva = document.getElementById('placaNuevaSemanal');
  const sedeNueva = document.getElementById('sedeNuevaSemanal');
  const sedeNuevaTexto = document.getElementById('sedeNuevaSemanalTexto');
  ['input', 'change'].forEach(eventName => {
    placaNueva?.addEventListener(eventName, () => aplicarSedeAutomatica(placaNueva, sedeNueva, sedeNuevaTexto, '<%= filtros.sede || '' %>'));
  });

  const placaEditar = document.getElementById('placaEditarSemanal');
  const sedeEditar = document.getElementById('sedeEditarSemanal');
  const sedeEditarTexto = document.getElementById('sedeEditarSemanalTexto');
  ['input', 'change'].forEach(eventName => {
    placaEditar?.addEventListener(eventName, () => aplicarSedeAutomatica(placaEditar, sedeEditar, sedeEditarTexto, sedeEditar?.value || '<%= filtros.sede || '' %>'));
  });

  document.querySelectorAll('.js-editar-semanal').forEach(button => {
    button.addEventListener('click', () => {
      const form = document.getElementById('editarSemanalForm');
      const estado = document.getElementById('estadoEditarSemanal');
      const fecha = document.getElementById('fechaEditarSemanal');
      if (!form) return;
      form.action = `/repuestos-semanales/${button.dataset.id}/editar`;
      if (fecha) fecha.value = button.dataset.fecha || '<%= filtros.fecha || fechaSemanaNueva %>';
      if (placaEditar) placaEditar.value = button.dataset.placa || '';
      if (sedeEditar) sedeEditar.value = button.dataset.sede || '';
      if (sedeEditarTexto) sedeEditarTexto.value = textoSede(button.dataset.sede);
      if (estado) estado.value = button.dataset.estado || 'PENDIENTE';
      const solicitud = document.getElementById('solicitudEditarSemanal');
      const marcado = document.getElementById('marcadoEditarSemanal');
      if (solicitud) solicitud.value = button.dataset.solicitud || '';
      if (marcado) marcado.value = button.dataset.marcado || '';
    });
  });

  document.querySelectorAll('.js-marcar-rojo').forEach(button => {
    button.addEventListener('click', () => {
      const form = document.getElementById('marcadoRojoForm');
      const input = document.getElementById('marcadoRojoInput');
      const resumen = document.getElementById('marcadoRojoResumen');
      if (!form) return;
      form.action = `/repuestos-semanales/${button.dataset.id}/marcado`;
      if (input) input.value = button.dataset.marcado || '';
      if (resumen) resumen.textContent = `${button.dataset.placa || ''} · ${button.dataset.solicitud || 'Solicitud'}`;
    });
  });
</script>
</body>
</html>
