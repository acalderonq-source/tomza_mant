<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Repuestos semanales - Gas Tomza</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --bg: #eef4f8;
      --dark: #10213f;
      --head: #0f6684;
      --sede: #9fc5e8;
      --line: #111827;
      --red: #e11d2e;
      --soft: #f8fbff;
      --stripe: #d8f0f8;
    }

    body {
      background: var(--bg);
      color: #0f172a;
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      font-size: .9rem;
    }

    .topbar {
      background: #111827;
      border-bottom: 3px solid #e2232a;
    }

    .shell { max-width: 1500px; }

    .hero {
      background: linear-gradient(135deg, #10213f, #0f6684 70%, #e2232a);
      border-radius: 12px;
      color: #fff;
      padding: 1rem;
    }

    .page-title {
      font-size: 1.35rem;
      font-weight: 950;
      margin: 0;
    }

    .panel {
      background: #fff;
      border: 1px solid #d7e4ee;
      border-radius: 12px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
      overflow: hidden;
    }

    .filters {
      display: grid;
      gap: .7rem;
      grid-template-columns: 170px 190px 180px 1fr auto auto;
      padding: .85rem 1rem;
    }

    .filters label,
    .modal label {
      color: #334155;
      font-size: .68rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .summary-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .summary-card {
      background: #fff;
      border: 1px solid #d7e4ee;
      border-radius: 10px;
      padding: .85rem;
    }

    .summary-label {
      color: #64748b;
      font-size: .7rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .summary-value {
      font-size: 1.55rem;
      font-weight: 950;
      line-height: 1;
      margin-top: .15rem;
    }

    .sheet-wrap {
      background: #fff;
      overflow: auto;
    }

    .sheet-table {
      border-collapse: collapse;
      min-width: 1040px;
      width: 100%;
    }

    .sheet-table th,
    .sheet-table td {
      border: 1px solid var(--line);
      padding: .36rem .5rem;
      vertical-align: middle;
    }

    .sheet-table th {
      background: var(--head);
      color: #fff;
      font-size: .72rem;
      font-weight: 950;
      text-align: center;
      text-transform: uppercase;
    }

    .sede-row td {
      background: var(--sede) !important;
      color: #000;
      font-weight: 950;
      text-align: center;
      text-transform: uppercase;
    }

    .sheet-table tbody tr.item-row:nth-child(odd) td { background: var(--stripe); }
    .sheet-table tbody tr.item-row:nth-child(even) td { background: var(--soft); }

    .placa-cell {
      font-weight: 950;
      text-align: center;
      white-space: nowrap;
      width: 120px;
    }

    .semana-cell {
      color: #334155;
      font-size: .78rem;
      font-weight: 900;
      text-align: center;
      white-space: nowrap;
      width: 120px;
    }

    .week-box {
      background: #fff8db;
      border: 2px solid #f59e0b;
      border-radius: 12px;
      padding: .75rem;
    }

    .week-box input {
      border-color: #f59e0b;
      font-size: 1rem;
      font-weight: 800;
      height: 44px;
    }

    .pedido-toolbar {
      align-items: center;
      background: #f8fafc;
      border: 1px solid #dbe3ef;
      border-radius: 12px;
      display: grid;
      gap: .75rem;
      grid-template-columns: 1fr auto auto;
      padding: .85rem;
    }

    .pedido-sedes-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      margin-bottom: .85rem;
    }

    .pedido-sede-card {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(15, 23, 42, .05);
      color: #0f172a;
      padding: .75rem;
      text-align: left;
      transition: .15s ease;
      width: 100%;
    }

    .pedido-sede-card:hover,
    .pedido-sede-card.is-active {
      border-color: #0f6684;
      box-shadow: 0 10px 24px rgba(15, 102, 132, .15);
      transform: translateY(-1px);
    }

    .pedido-sede-title {
      font-weight: 950;
      line-height: 1.1;
    }

    .pedido-sede-meta {
      color: #64748b;
      font-size: .78rem;
      font-weight: 800;
      margin-top: .25rem;
    }

    .pedido-list {
      display: grid;
      gap: .55rem;
      margin-top: .85rem;
      max-height: 52vh;
      overflow: auto;
      padding-right: .25rem;
    }

    .pedido-item {
      align-items: flex-start;
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 12px;
      display: grid;
      gap: .65rem;
      grid-template-columns: auto 120px minmax(0, 1fr) auto;
      padding: .7rem;
    }

    .pedido-item.is-excluded {
      background: #f1f5f9;
      color: #64748b;
    }

    .pedido-plate {
      color: #0f172a;
      font-weight: 950;
      white-space: nowrap;
    }

    .pedido-text {
      font-size: .86rem;
      line-height: 1.25;
    }

    .pedido-status {
      border-radius: 999px;
      font-size: .68rem;
      font-weight: 900;
      padding: .28rem .5rem;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .pedido-empty {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      color: #64748b;
      font-weight: 800;
      padding: 1rem;
      text-align: center;
    }

    .solicitud-cell { min-width: 420px; }

    .rojo-cell {
      color: var(--red);
      font-weight: 900;
      min-width: 320px;
      white-space: pre-wrap;
    }

    .empty-red { color: #94a3b8; font-weight: 700; }

    .no-compra-text {
      color: #64748b;
      display: block;
      font-weight: 900;
      margin-top: .25rem;
    }

    .item-row.is-no-compra td {
      background: #f1f5f9 !important;
      color: #64748b;
    }

    .estado-badge {
      border-radius: 999px;
      display: inline-block;
      font-size: .7rem;
      font-weight: 900;
      padding: .25rem .55rem;
      white-space: nowrap;
    }

    .estado-pendiente { background: #e5e7eb; color: #111827; }
    .estado-llegando { background: #fee2e2; color: #b91c1c; }
    .estado-no_compra { background: #e2e8f0; color: #475569; }
    .estado-completo { background: #dcfce7; color: #166534; }

    .actions-grid {
      display: grid;
      gap: .25rem;
      grid-template-columns: 1fr;
      min-width: 180px;
    }

    .modal-content {
      border: 0;
      border-radius: 16px;
      overflow: hidden;
    }

    .modal-header {
      background: linear-gradient(135deg, #10213f, #0f6684);
      color: #fff;
    }

    .modal-header .btn-close {
      filter: invert(1);
      opacity: .95;
    }

    .form-grid {
      display: grid;
      gap: .75rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .span-2 { grid-column: 1 / -1; }

    .mark-options {
      display: grid;
      gap: .65rem;
      max-height: 48vh;
      overflow: auto;
      padding-right: .25rem;
    }

    .mark-option {
      background: #fff;
      border: 1px solid #dbe3ef;
      border-radius: 12px;
      padding: .75rem;
    }

    .mark-option-title {
      font-weight: 950;
      line-height: 1.25;
      margin-bottom: .55rem;
    }

    @media (max-width: 980px) {
      .filters,
      .summary-grid,
      .form-grid {
        grid-template-columns: 1fr 1fr;
      }

      .pedido-toolbar,
      .pedido-item {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .filters,
      .summary-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .sheet-table,
      .sheet-table tbody,
      .sheet-table tr,
      .sheet-table td {
        display: block;
        min-width: 0;
        width: 100%;
      }

      .sheet-table thead { display: none; }

      .sheet-table tr.item-row {
        border: 1px solid #d7e4ee;
        border-radius: 12px;
        margin: .75rem;
        overflow: hidden;
      }

      .sheet-table td {
        display: grid;
        gap: .6rem;
        grid-template-columns: 40% minmax(0, 1fr);
        text-align: left;
      }

      .sheet-table td::before {
        color: #475569;
        content: attr(data-label);
        font-size: .7rem;
        font-weight: 900;
        text-transform: uppercase;
      }

      .sede-row td {
        display: block;
        text-align: center;
      }

      .sede-row td::before {
        content: "";
        display: none;
      }

      .modal-dialog {
        margin: 0;
        max-width: 100%;
      }

      .modal-content {
        border-radius: 0;
        min-height: 100vh;
      }
    }
  </style>
</head>
<body>
<%
  const lista = Array.isArray(solicitudes) ? solicitudes : [];
  const sedesLista = Array.isArray(sedes) ? sedes : [];
  const unidadesLista = Array.isArray(unidades) ? unidades : [];
  const sedeRecope = typeof sedeRecopeLimon !== 'undefined' ? sedeRecopeLimon : 'RECOPE_LIMON';
  const sedeRecopeOrigen = typeof sedeRecopeUnidades !== 'undefined' ? sedeRecopeUnidades : 'Transportadora';
  const mostrarSede = typeof etiquetaSede === 'function' ? etiquetaSede : (sede) => sede;
  const estadoTexto = typeof etiquetaEstadoSemanal === 'function' ? etiquetaEstadoSemanal : (estado) => estado;
  const estadoClase = estado => String(estado || '').toLowerCase();
  const fechaSemanaNueva = (typeof fechaProximaSemana !== 'undefined' && fechaProximaSemana) || filtros.fecha || fechaHoy;
  const textoSeguroData = value => String(value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const textoComparableVista = value => String(value || '').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[_\s]+/g, '-');
  const textoSetVista = value => new Set(String(value || '').split(/\r?\n|,+/g).map(textoComparableVista).filter(Boolean));
  const dividirPedidoVista = item => {
    if (typeof dividirRepuestosSeleccionables === 'function') {
      return dividirRepuestosSeleccionables(item).filter(Boolean);
    }
    const texto = String(item.marcado_rojo || item.solicitud || '').trim();
    return texto ? [texto] : [''];
  };
  const esExcluidoPedidoVista = item => {
    const placa = textoComparableVista(item.placa);
    const sede = textoComparableVista(item.sede);
    const solicitud = textoComparableVista(item.solicitud);
    const marcado = textoComparableVista(item.marcado_rojo);
    const noCompra = textoComparableVista(item.no_compra);
    return ['MUEBLE', 'GENERAL-TALLER', 'GENERALES-TALLER'].includes(placa) ||
      ['MUEBLE', 'GENERAL-TALLER', 'GENERALES-TALLER'].includes(sede) ||
      item.estado === 'NO_COMPRA' ||
      solicitud.includes('MUEBLE') ||
      solicitud.includes('GENERAL-TALLER') ||
      solicitud.includes('GENERALES-TALLER') ||
      marcado.includes('MUEBLE') ||
      marcado.includes('GENERAL-TALLER') ||
      marcado.includes('GENERALES-TALLER') ||
      noCompra.includes('MUEBLE') ||
      noCompra.includes('GENERAL-TALLER') ||
      noCompra.includes('GENERALES-TALLER');
  };
  const sedesConPedido = [...new Set(lista.map(item => item.sede).filter(Boolean))];
  const pedidoSeleccionData = lista.map(item => {
    const marcadoSet = textoSetVista(item.marcado_rojo);
    const noCompraSet = textoSetVista(item.no_compra);
    return {
      id: item.id,
      sede: item.sede || '',
      sedeTexto: mostrarSede(item.sede),
      placa: item.placa || '',
      solicitud: item.solicitud || '',
      marcado_rojo: item.marcado_rojo || '',
      no_compra: item.no_compra || '',
      estado: item.estado || '',
      fecha: item.fecha_iso || '',
      partes: dividirPedidoVista(item).map((texto, index) => ({
        index,
        texto,
        marcado: marcadoSet.has(textoComparableVista(texto)),
        noCompra: noCompraSet.has(textoComparableVista(texto))
      })),
      excluido: esExcluidoPedidoVista(item)
    };
  });
  const pedidoPdfParams = new URLSearchParams();
  ['fecha', 'sede', 'placa', 'estado'].forEach(key => {
    if (filtros[key]) pedidoPdfParams.set(key, filtros[key]);
  });
  const pedidoPdfUrl = `/repuestos-semanales/pedido-cedis.pdf${pedidoPdfParams.toString() ? `?${pedidoPdfParams.toString()}` : ''}`;
%>

<nav class="navbar navbar-dark topbar px-3 py-2">
  <span class="navbar-brand fw-semibold"><i class="bi bi-calendar-week me-2"></i>Repuestos semanales</span>
  <div class="text-white d-flex align-items-center gap-2 flex-wrap">
    <span class="small"><%= user.usuario %> · <%= user.rol %></span>
    <a href="/repuestos" class="btn btn-outline-light btn-sm rounded-pill px-3">Solicitud de repuestos</a>
    <a href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3">Dashboard</a>
    <a href="/logout" class="btn btn-warning btn-sm rounded-pill px-3">Salir</a>
  </div>
</nav>

<main class="container-fluid shell py-3">
  <section class="hero mb-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h1 class="page-title">Repuestos semanales</h1>
        <div class="opacity-75">Formato semanal por sede. Lo marcado en rojo representa lo que va llegando.</div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-light btn-sm rounded-pill fw-bold px-3" data-bs-toggle="modal" data-bs-target="#pedidoCedisModal">
          <i class="bi bi-file-earmark-pdf"></i> Descargar pedido
        </button>
        <% if (puedeGestionar) { %>
          <button type="button" class="btn btn-warning btn-sm rounded-pill fw-bold px-3" data-bs-toggle="modal" data-bs-target="#nuevoSemanalModal">
            <i class="bi bi-plus-circle"></i> Agregar con semana
          </button>
        <% } %>
      </div>
    </div>
  </section>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <section class="summary-grid mb-3">
    <div class="summary-card"><div class="summary-label">Total</div><div class="summary-value"><%= resumen.total || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">Pendientes</div><div class="summary-value"><%= resumen.PENDIENTE || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">Marcados rojo</div><div class="summary-value text-danger"><%= resumen.marcados || 0 %></div></div>
    <div class="summary-card"><div class="summary-label">No se compra</div><div class="summary-value text-secondary"><%= (resumen.NO_COMPRA || 0) + (resumen.noCompraItems || 0) %></div></div>
    <div class="summary-card"><div class="summary-label">Completos</div><div class="summary-value"><%= resumen.COMPLETO || 0 %></div></div>
  </section>

  <section class="panel mb-3">
    <form method="GET" action="/repuestos-semanales" class="filters">
      <div>
        <label class="form-label mb-1">Semana destino</label>
        <input type="date" name="fecha" class="form-control form-control-sm" value="<%= filtros.fecha || fechaHoy %>">
      </div>
      <div>
        <label class="form-label mb-1">Sede</label>
        <select name="sede" class="form-select form-select-sm">
          <option value="">Todas permitidas</option>
          <% sedesLista.forEach(sede => { %>
            <option value="<%= sede %>" <%= filtros.sede === sede ? 'selected' : '' %>><%= mostrarSede(sede) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Estado</label>
        <select name="estado" class="form-select form-select-sm">
          <option value="">Todos</option>
          <% estados.forEach(estado => { %>
            <option value="<%= estado %>" <%= filtros.estado === estado ? 'selected' : '' %>><%= estadoTexto(estado) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label mb-1">Placa / grupo</label>
        <input type="text" name="placa" class="form-control form-control-sm text-uppercase" value="<%= filtros.placa || '' %>" placeholder="C164415, GENERALES, MUEBLE...">
      </div>
      <div class="d-flex align-items-end">
        <button class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i> Filtrar</button>
      </div>
      <div class="d-flex align-items-end">
        <a href="/repuestos-semanales" class="btn btn-secondary btn-sm w-100">Limpiar</a>
      </div>
    </form>
  </section>

  <section class="panel">
    <% if (!lista.length) { %>
      <div class="text-center text-muted fw-bold p-4">No hay repuestos semanales con los filtros seleccionados.</div>
    <% } else { %>
      <div class="sheet-wrap">
        <table class="sheet-table">
          <thead>
            <tr>
              <th>Placa</th>
              <th>Semana</th>
              <th>Solicitud de repuestos</th>
              <th>Va llegando / no compra</th>
              <th>Estado</th>
              <th>Creado por</th>
              <% if (puedeGestionar) { %><th>Acciones</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% let grupoAnterior = ''; %>
            <% lista.forEach(item => { %>
              <%
                const grupoActual = `${item.fecha_formato || ''}|${item.sede || ''}`;
                const columnas = puedeGestionar ? 7 : 6;
              %>
              <% if (grupoActual !== grupoAnterior) { grupoAnterior = grupoActual; %>
                <tr class="sede-row">
                  <td colspan="<%= columnas %>"><%= item.fecha_formato || '-' %> · <%= mostrarSede(item.sede) %></td>
                </tr>
              <% } %>
              <tr class="item-row <%= item.estado === 'NO_COMPRA' ? 'is-no-compra' : '' %>">
                <td data-label="Placa" class="placa-cell"><%= item.placa %></td>
                <td data-label="Semana" class="semana-cell"><%= item.fecha_formato || '-' %></td>
                <td data-label="Solicitud" class="solicitud-cell"><%= item.solicitud %></td>
                <td data-label="Va llegando / no compra" class="rojo-cell">
                  <% if (item.marcado_rojo) { %>
                    <%= item.marcado_rojo %>
                  <% } else { %>
                    <span class="empty-red">-</span>
                  <% } %>
                  <% if (item.no_compra) { %>
                    <span class="no-compra-text">No se compra: <%= item.no_compra %></span>
                  <% } %>
                </td>
                <td data-label="Estado" class="text-center">
                  <span class="estado-badge estado-<%= estadoClase(item.estado) %>"><%= estadoTexto(item.estado) %></span>
                </td>
                <td data-label="Creado por"><%= item.creado_por_usuario || '-' %></td>
                <% if (puedeGestionar) { %>
                  <td data-label="Acciones">
                    <div class="actions-grid">
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-primary js-editar-semanal"
                        data-bs-toggle="modal"
                        data-bs-target="#editarSemanalModal"
                        data-id="<%= item.id %>"
                        data-fecha="<%= item.fecha_iso || '' %>"
                        data-placa="<%= item.placa %>"
                        data-sede="<%= item.sede || '' %>"
                        data-estado="<%= item.estado || 'PENDIENTE' %>"
                        data-solicitud="<%- textoSeguroData(item.solicitud) %>"
                        data-marcado="<%- textoSeguroData(item.marcado_rojo) %>">
                        <i class="bi bi-pencil-square"></i> Editar
                      </button>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-danger js-marcar-rojo"
                        data-bs-toggle="modal"
                        data-bs-target="#marcadoRojoModal"
                        data-id="<%= item.id %>"
                        data-placa="<%= item.placa %>"
                        data-solicitud="<%- textoSeguroData(item.solicitud) %>"
                        data-marcado="<%- textoSeguroData(item.marcado_rojo) %>"
                        data-no-compra="<%- textoSeguroData(item.no_compra) %>">
                        <i class="bi bi-highlighter"></i> Marcar / no compra
                      </button>
                      <form method="POST" action="/repuestos-semanales/<%= item.id %>/estado">
                        <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
                        <input type="hidden" name="sede" value="<%= filtros.sede || '' %>">
                        <input type="hidden" name="placa" value="<%= filtros.placa || '' %>">
                        <select name="estado" class="form-select form-select-sm mb-1">
                          <% estados.forEach(estado => { %>
                            <option value="<%= estado %>" <%= item.estado === estado ? 'selected' : '' %>><%= estadoTexto(estado) %></option>
                          <% }) %>
                        </select>
                        <button class="btn btn-sm btn-dark w-100"><i class="bi bi-save"></i> Guardar estado</button>
                      </form>
                      <form method="POST" action="/repuestos-semanales/<%= item.id %>/eliminar" onsubmit="return confirm('¿Eliminar este repuesto semanal?')">
                        <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
                        <input type="hidden" name="sede" value="<%= filtros.sede || '' %>">
                        <input type="hidden" name="placa" value="<%= filtros.placa || '' %>">
                        <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Eliminar</button>
                      </form>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<div class="modal fade" id="pedidoCedisModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <form method="GET" action="/repuestos-semanales/pedido-cedis.pdf" id="pedidoCedisForm">
        <input type="hidden" name="fecha" value="<%= filtros.fecha || '' %>">
        <input type="hidden" name="sede" id="pedidoSedeSelect" value="<%= filtros.sede || (sedesConPedido.length === 1 ? sedesConPedido[0] : '') %>">
        <div class="modal-header">
          <div>
            <h5 class="modal-title fw-bold mb-0"><i class="bi bi-file-earmark-pdf me-1"></i> Descargar pedido CEDIS</h5>
            <div class="small opacity-75">Elija una sede y marque solo los repuestos que van en el pedido.</div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div class="pedido-sedes-grid">
            <% sedesConPedido.forEach(sede => { %>
              <%
                const itemsSede = lista.filter(item => item.sede === sede);
                const incluidosSede = itemsSede
                  .filter(item => !esExcluidoPedidoVista(item))
                  .reduce((total, item) => {
                    const noCompraSet = textoSetVista(item.no_compra);
                    return total + dividirPedidoVista(item).filter(parte => !noCompraSet.has(textoComparableVista(parte))).length;
                  }, 0);
                const activaSede = (filtros.sede || (sedesConPedido.length === 1 ? sedesConPedido[0] : '')) === sede;
              %>
              <button
                type="button"
                class="pedido-sede-card js-pedido-sede <%= activaSede ? 'is-active' : '' %>"
                data-sede="<%= sede %>">
                <div class="pedido-sede-title"><%= mostrarSede(sede) %></div>
                <div class="pedido-sede-meta"><%= incluidosSede %> para descargar · <%= itemsSede.length %> total</div>
              </button>
            <% }) %>
          </div>

          <div class="pedido-toolbar">
            <div>
              <label class="form-label mb-1">Pedido seleccionado</label>
              <div class="fw-bold" id="pedidoSedeTitulo">Seleccione una sede</div>
              <div class="text-muted small">Abajo puede quitar del PDF lo que no desea cotizar.</div>
            </div>
            <button type="button" class="btn btn-outline-dark btn-sm" id="pedidoMarcarTodos">Marcar todo</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="pedidoLimpiar">Limpiar</button>
          </div>

          <div class="alert alert-warning py-2 my-3">
            <strong>Importante:</strong> MUEBLE y GENERAL-TALLER quedan fuera del PDF aunque aparezcan en pantalla.
          </div>

          <div id="pedidoCedisLista" class="pedido-list">
            <div class="pedido-empty">Seleccione una sede para ver los pedidos.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-dark" id="pedidoGenerarBtn">
            <i class="bi bi-download me-1"></i> Generar pedido seleccionado
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

